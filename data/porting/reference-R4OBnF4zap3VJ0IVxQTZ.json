{"title":"Mrs.Pumpkin의 우스꽝스러운 꿈","artist":"하치","sourceId":"reference:R4OBnF4zap3VJ0IVxQTZ","sourceHash":"1a8ce3c055d5a45a7c6ab293758b66556708ca71379347ffa64c2388fd8d7a1b","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":17.88,"end":20.88,"text":"ジャカランダ咲いた 無礼を酌み交う演説会","translation":"","kind":"lyric"},{"id":"2","start":22.29,"end":25.29,"text":"何処へ行こうか？ 愉快に泣いた歌","translation":"","kind":"lyric"},{"id":"3","start":30.68,"end":33.68,"text":"ジャックは笑った 「異端な感情置いといて」","translation":"","kind":"lyric"},{"id":"4","start":34.72,"end":37.72,"text":"チョコレート頂戴 下賤に泣いた歌","translation":"","kind":"lyric"},{"id":"5","start":39.12,"end":42.12,"text":"カカシがふらり 咽んで揺れた","translation":"","kind":"lyric"},{"id":"6","start":43.38,"end":46.38,"text":"食わず嫌いは カボチャのパイ","translation":"","kind":"lyric"},{"id":"7","start":49.38,"end":52.38,"text":"ねぇ ラルラルラ 私と踊ろうか","translation":"","kind":"lyric"},{"id":"8","start":53.4,"end":56.1,"text":"まだ眠る お月様","translation":"","kind":"lyric"},{"id":"9","start":56.1,"end":57.96,"text":"\"「呼んだ？呼んだ？」と蕪頭\"","translation":"","kind":"lyric"},{"id":"10","start":57.96,"end":60.96,"text":"ほら 棺は何処にも無くなった","translation":"","kind":"lyric"},{"id":"11","start":61.83,"end":64.83,"text":"つまらないや","translation":"","kind":"lyric"},{"id":"12","start":77.36,"end":80.36,"text":"でっち上げられた 魔法に敏感 鉄塔と","translation":"","kind":"lyric"},{"id":"13","start":81.52,"end":84.52,"text":"魔女は高架下 眩んだ様だった","translation":"","kind":"lyric"},{"id":"14","start":85.85,"end":88.85,"text":"ジャックは気取った 「卑猥な感情持っといて！」","translation":"","kind":"lyric"},{"id":"15","start":89.75,"end":92.75,"text":"マンダラゲ咲いた 怨んだ様だった","translation":"","kind":"lyric"},{"id":"16","start":94.68,"end":97.68,"text":"山羊が何か企んで","translation":"","kind":"lyric"},{"id":"17","start":98.47,"end":101.47,"text":"\"「受け入れろ、受け入れろ」\"","translation":"","kind":"lyric"},{"id":"18","start":102.75999999999999,"end":105.75999999999999,"text":"電車を待つ","translation":"","kind":"lyric"},{"id":"19","start":107.47,"end":110.47,"text":"手を繋ごう 二つは許された","translation":"","kind":"lyric"},{"id":"20","start":111.16,"end":113.82,"text":"巡りつく 管の中","translation":"","kind":"lyric"},{"id":"21","start":113.82,"end":115.61,"text":"\"劣性優性死屍累々？\"","translation":"","kind":"lyric"},{"id":"22","start":115.61,"end":118.61,"text":"即売会 群んだ 蟻の中","translation":"","kind":"lyric"},{"id":"23","start":119.65,"end":122.65,"text":"まだ眠る お月様","translation":"","kind":"lyric"},{"id":"24","start":166.74,"end":169.74,"text":"「ああ！ミセスパンプキン！お迎えに上がりました！」","translation":"","kind":"lyric"},{"id":"25","start":173.07999999999998,"end":176.07999999999998,"text":"この夜はいつの間に 夢を壊したのだろう？","translation":"","kind":"lyric"},{"id":"26","start":192.25,"end":195.25,"text":"まだここで 踊っていたいのよ！","translation":"","kind":"lyric"},{"id":"27","start":195.99,"end":198.52,"text":"夢のような 錯乱を","translation":"","kind":"lyric"},{"id":"28","start":198.52,"end":200.78,"text":"\"劣性劣性馬鹿溜り\"","translation":"","kind":"lyric"},{"id":"29","start":200.78,"end":203.78,"text":"吐き出した快楽と 火が燈る ランタンは","translation":"","kind":"lyric"},{"id":"30","start":208.82999999999998,"end":211.82999999999998,"text":"ねぇ ラルラルラ 私と踊ろうか","translation":"","kind":"lyric"},{"id":"31","start":212.88,"end":215.45,"text":"返事なんか 来る筈も","translation":"","kind":"lyric"},{"id":"32","start":215.45,"end":217.32999999999998,"text":"\"「残念！無念！」と蕪頭\"","translation":"","kind":"lyric"},{"id":"33","start":217.32999999999998,"end":220.32999999999998,"text":"ほら 棺は何処にも無くなった","translation":"","kind":"lyric"},{"id":"34","start":221.37,"end":224.37,"text":"つまらないや","translation":"","kind":"lyric"},{"id":"35","start":224.47,"end":227.47,"text":"沈み込んだ 泥の中","translation":"","kind":"lyric"},{"id":"36","start":228.75,"end":231.75,"text":"朝を待った 藪の中","translation":"","kind":"lyric"},{"id":"37","start":234.26,"end":237.26,"text":"電車の中","translation":"","kind":"lyric"},{"id":"38","start":241.96,"end":244.96,"text":