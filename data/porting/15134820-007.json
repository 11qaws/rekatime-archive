{"title":"무의식 레퀴엠","artist":"森羅万象 feat. あよ","date":"2026-09-10","sourceId":"15134820:007","sourceHash":"5f8bd1bd6b1a48fa91bf1528565a635dc9cfa52fc9d6ea56649e59879aac3a0e","duration":260.4,"cues":[{"id":"1","start":20.534,"end":23.1,"text":"午前二時 点滅 水銀燈","translation":"새벽 두 시 깜박이는 수은등","kind":"lyric"},{"id":"2","start":23.1,"end":25.1,"text":"仄暗い交差点","translation":"어스레한 교차로","kind":"lyric"},{"id":"3","start":25.1,"end":28.44,"text":"後ろの正面から 聴こえる声","translation":"바로 뒤에서 들려오는 목소리","kind":"lyric"},{"id":"4","start":28.76,"end":31.1,"text":"誰かが嘯うそぶいていた","translation":"누군가 모른 척 떠들고 있었어","kind":"lyric"},{"id":"5","start":31.16,"end":33.58,"text":"噂話に","translation":"소문 이야기에 따르면","kind":"lyric"},{"id":"6","start":33.92,"end":36.94,"text":"曰く、そいつは","translation":"그것은 말이야","kind":"lyric"},{"id":"7","start":36.94,"end":38.7,"text":"ひっそりと立っていた","translation":"조용히 서 있었대","kind":"lyric"},{"id":"8","start":38.7,"end":45.46,"text":"無機質プッシュ音そっと谺こだまする","translation":"무기질적인 버튼 소리가 조용히 메아리쳐","kind":"lyric"},{"id":"9","start":45.46,"end":47.38,"text":"後には戻れないよ","translation":"이제 뒤로는 돌아갈 수 없어","kind":"lyric"},{"id":"10","start":47.38,"end":50.27,"text":"繋ぐ先に待つ天国か地獄","translation":"전화선 끝에 기다리는 건 천국일까 지옥일까","kind":"lyric"},{"id":"11","start":50.27,"end":56.8,"text":"こんばんは、ねぇ、知ってる？","translation":"안녕하세요 저기 그거 알아요","kind":"lyric"},{"id":"12","start":56.8,"end":58.86,"text":"見て見て あなたのそばで","translation":"봐 봐 네 곁에서","kind":"lyric"},{"id":"13","start":58.86,"end":61.22,"text":"誰かが覗いているよ","translation":"누군가 들여다보고 있어","kind":"lyric"},{"id":"14","start":61.22,"end":64.42,"text":"トラウマの雨を降らし、ポトリ","translation":"트라우마의 비를 내리고 똑","kind":"lyric"},{"id":"15","start":64.42,"end":66.46,"text":"今日も一羽だけ煮えていく はぁ","translation":"오늘도 새 한 마리만 삶아져 가 하아","kind":"lyric"},{"id":"16","start":76.53,"end":78.37,"text":"はじめまして こんばんは","translation":"처음 뵙겠습니다 안녕하세요","kind":"lyric"},{"id":"17","start":78.37,"end":80.02,"text":"あなたは雨ですか？","translation":"그쪽에는 비가 오나요","kind":"lyric"},{"id":"18","start":80.02,"end":83.4,"text":"隠れんぼしたのよ イタズラ","translation":"숨바꼭질을 했어 장난이야","kind":"lyric"},{"id":"19","start":83.84,"end":85.8,"text":"今 あなたの近く","translation":"지금 네 가까이로","kind":"lyric"},{"id":"20","start":85.8,"end":87.02,"text":"会いに行くから","translation":"만나러 갈 테니까","kind":"lyric"},{"id":"21","start":87.02,"end":89.82,"text":"隣の隣","translation":"바로 옆의 옆","kind":"lyric"},{"id":"22","start":91.3,"end":94.04,"text":"そう誰が作った","translation":"그래 누가 만들었지","kind":"lyric"},{"id":"23","start":94.04,"end":96.66,"text":"噂話に","translation":"소문 이야기에 따르면","kind":"lyric"},{"id":"24","start":96.66,"end":99.28,"text":"曰く、そいつは","translation":"그것은 말이야","kind":"lyric"},{"id":"25","start":99.28,"end":102.56,"text":"後ろの正面に嗤う それは？","translation":"바로 뒤에서 비웃는 그것은 누구","kind":"lyric"},{"id":"26","start":102.56,"end":104.6,"text":"(聴いてもっと鎮魂歌レクイエム)","translation":"더 들어 봐 진혼곡을","kind":"lyric"},{"id":"27","start":104.6,"end":109.3,"text":"(確かな存在は？受話器越しの境界)","translation":"확실한 존재는 수화기 너머의 경계에 있을까","kind":"lyric"},{"id":"28","start":109.3,"end":112.52,"text":"どこにもなくてそこにある","translation":"어디에도 없으면서 바로 거기에 있어","kind":"lyric"},{"id":"29","start":112.52,"end":114.24,"text":"幻視する世界","translation":"환시와 말의 죽음이 만든 세계","kind":"lyric"},{"id":"30","start":115.42,"end":117.9,"text":"私のこと、気付いてくれた？","translation":"나를 알아차려 줬니","kind":"lyric"},{"id":"31","start":117.9,"end":120.06,"text":"ガチャガチャ ノブ廻す音","translation":"덜컹덜컹 문손잡이 돌리는 소리","kind":"lyric"},{"id":"32","start":120.06,"end":123.74,"text":"真夜中二時のヒメゴト","translation":"한밤중 두 시의 비밀","kind":"lyric"},{"id":"33","start":123.74,"end":125.86,"text":"影すら見えない足音が","translation":"그림자조차 보이지 않는 발소리","kind":"lyric"},{"id":"34","start":125.86,"end":129.14,"text":"ここには来れない二羽がなく","translation":"이곳에는 올 수 없는 두 마리 새가 울고","kind":"lyric"},{"id":"35","start":129.14,"end":130.76,"text":"潰れてた 顔見てたって","translation":"짓이겨진 얼굴을 보고 있어도","kind":"lyric"},{"id":"36","start":130.76,"end":133.54,"text":"誰もかも連なって","translation":"누구나 줄지어 서서","kind":"lyric"},{"id":"37","start":133.76,"end":136.42,"text":"頭から割れ割れ","translation":"머리부터 갈라져 갈라져","kind":"lyric"},{"id":"38","start":136.42,"end":138.2,"text":"這って伝うの赤信号","translation":"기어가며 전해지는 빨간 신호","kind":"lyric"},{"id":"39","start":138.2,"end":140.28,"text":"ここから ここまで","translation":"여기에서 여기까지","kind":"lyric"},{"id":"40","start":140.28,"end":142.98,"text":"どこかの 迷い道通りゃんせ","translation":"어딘가 헤매는 길을 지나가세요","kind":"lyric"},{"id":"41","start":142.98,"end":145.38,"text":"天神さま言いました","translation":"천신님이 말했어","kind":"lyric"},{"id":"42","start":145.38,"end":148.22,"text":"帰りは剥がれます けれど","translation":"돌아가는 길에는 벗겨질 테지만","kind":"lyric"},{"id":"43","start":148.22,"end":151.28,"text":"平気平気平気平気","translation":"괜찮아 괜찮아 괜찮아 괜찮아","kind":"lyric"},{"id":"44","start":151.28,"end":152.98,"text":"ちぎれ、ちぎる","translation":"찢어지고 찢어 너와","kind":"lyric"},{"id":"45","start":152.98,"end":154.74,"text":"きみときみも","translation":"너도","kind":"lyric"},{"id":"46","start":154.74,"end":157.0,"text":"まじる、あかい","translation":"섞여 붉게","kind":"lyric"},{"id":"47","start":157.0,"end":158.24,"text":"あかい、無駄骨よ","translation":"붉게 모두 헛수고야","kind":"lyric"},{"id":"48","start":158.24,"end":159.74,"text":"せかい、ひとり","translation":"세계에 홀로","kind":"lyric"},{"id":"49","start":159.74,"end":162.2,"text":"あなた、わたし","translation":"너와 나","kind":"lyric"},{"id":"50","start":162.2,"end":164.26,"text":"ゆめも、ついに","translation":"꿈도 마침내","kind":"lyric"},{"id":"51","start":164.26,"end":165.0,"text":"おわり、いたい","translation":"끝나 아파","kind":"lyric"},{"id":"52","start":165.0,"end":168.7,"text":"いたい、いたイ","translation":"아파 아파 아파","kind":"lyric"},{"id":"53","start":192.84,"end":195.74,"text":"ただただ 生まれた時に","translation":"그저 태어났을 때부터","kind":"lyric"},{"id":"54","start":195.74,"end":199.1,"text":"持った瑕きずついた心","translation":"지니고 있던 상처 난 마음","kind":"lyric"},{"id":"55","start":199.1,"end":200.1,"text":"誰かを傷つけただけなの","translation":"누군가를 상처 입혔을 뿐이야","kind":"lyric"},{"id":"56","start":200.1,"end":204.78,"text":"イノセント こんな目に遭うのか？なんて","translation":"죄 없는 내가 왜 이런 일을 당하냐고","kind":"lyric"},{"id":"57","start":204.78,"end":210.62,"text":"わからないのならばふるえて眠りなさい","translation":"모르겠다면 떨면서 잠드세요","kind":"lyric"},{"id":"58","start":213.52,"end":217.62,"text":"ねぇ、私、今、あなたの...","translation":"있잖아 나 지금 네","kind":"lyric"},{"id":"59","start":218.2,"end":220.32,"text":"嗚呼 ばらばら 體からだと魂こころ","translation":"아 산산이 흩어진 몸과 혼","kind":"lyric"},{"id":"60","start":220.32,"end":222.82,"text":"元には戻れぬ命","translation":"원래대로 돌아갈 수 없는 생명","kind":"lyric"},{"id":"61","start":222.82,"end":225.74,"text":"あなたはいつまで夢見てるの？","translation":"너는 언제까지 꿈꾸고 있을 거야","kind":"lyric"},{"id":"62","start":225.74,"end":227.88,"text":"不公平面相対性","translation":"불공평과 공평은 상대적","kind":"lyric"},{"id":"63","start":227.88,"end":230.26,"text":"もしもし 私はメリー","translation":"여보세요 나는 메리","kind":"lyric"},{"id":"64","start":230.66,"end":234.22,"text":"嘘のような本当は","translation":"거짓말 같은 진실을","kind":"lyric"},{"id":"65","start":234.22,"end":235.42,"text":"バッドエンド 決めつけないでよ","translation":"배드 엔드라고 단정 짓지 마","kind":"lyric"},{"id":"66","start":235.42,"end":237.44,"text":"今日も一羽だけ消えていく","translation":"오늘도 새 한 마리만 사라져 가","kind":"lyric"},{"id":"67","start":237.44,"end":240.28,"text":"今日も甘々に贄ていく","translation":"오늘도 달콤하게 삶아 제물로 바쳐져 가","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}