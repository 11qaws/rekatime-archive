{"title":"Snowman","artist":"Sia","sourceId":"reference:szsTmalhtPtfJG2ZslnL","sourceHash":"08ae1f6e76f3e9e570d4ffdc06e67870d0a725a31cfa434a92a26574b20e204a","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":6.19,"end":9.190000000000001,"text":"Don't cry, snowman, not in front of me","translation":"","kind":"lyric"},{"id":"2","start":10.33,"end":13.33,"text":"Who'll catch your tears if you can't catch me, darling","translation":"","kind":"lyric"},{"id":"3","start":15.2,"end":18.2,"text":"If you can't catch me, darling","translation":"","kind":"lyric"},{"id":"4","start":19.76,"end":22.76,"text":"Don't cry, snowman, don't leave me this way","translation":"","kind":"lyric"},{"id":"5","start":24.19,"end":27.19,"text":"A puddle of water can't hold me close, baby","translation":"","kind":"lyric"},{"id":"6","start":28.97,"end":31.97,"text":"Can't hold me close, baby","translation":"","kind":"lyric"},{"id":"7","start":34.29,"end":37.29,"text":"I want you to know that I'm never leaving","translation":"","kind":"lyric"},{"id":"8","start":37.74,"end":40.74,"text":"'Cause I'm Mrs. Snow, 'til death we'll be freezing","translation":"","kind":"lyric"},{"id":"9","start":41.0,"end":44.0,"text":"Yeah, you are my home, my home for all seasons","translation":"","kind":"lyric"},{"id":"10","start":44.51,"end":47.51,"text":"So come on, let's go","translation":"","kind":"lyric"},{"id":"11","start":48.19,"end":51.19,"text":"Let's go below zero and hide from the sun","translation":"","kind":"lyric"},{"id":"12","start":51.51,"end":54.51,"text":"I love you forever where we'll have some fun","translation":"","kind":"lyric"},{"id":"13","start":54.82,"end":57.82,"text":"Yes, let's hit the North Pole and live happily","translation":"","kind":"lyric"},{"id":"14","start":58.2,"end":61.2,"text":"Please don't cry no tears now, it's Christmas, baby","translation":"","kind":"lyric"},{"id":"15","start":61.73,"end":64.72999999999999,"text":"My snowman and me","translation":"","kind":"lyric"},{"id":"16","start":68.55,"end":71.55,"text":"My snowman and me","translation":"","kind":"lyric"},{"id":"17","start":74.7,"end":77.7,"text":"Baby","translation":"","kind":"lyric"},{"id":"18","start":81.62,"end":84.62,"text":"Don't cry, snowman, don't you fear the sun","translation":"","kind":"lyric"},{"id":"19","start":85.82,"end":88.82,"text":"Who'll carry me without legs to run, honey","translation":"","kind":"lyric"},{"id":"20","start":90.55,"end":93.55,"text":"Without legs to run, honey","translation":"","kind":"lyric"},{"id":"21","start":95.32,"end":98.32,"text":"Don't cry, snowman, don't you shed a tear","translation":"","kind":"lyric"},{"id":"22","start":99.56,"end":102.56,"text":"Who'll hear my secrets if you don't have ears, baby","translation":"","kind":"lyric"},{"id":"23","start":104.6,"end":107.6,"text":"If you don't have ears, baby","translation":"","kind":"lyric"},{"id":"24","start":109.89,"end":112.89,"text":"I want you to know that I'm never leaving","translation":"","kind":"lyric"},{"id":"25","start":113.15,"end":116.15,"text":"'Cause I'm Mrs. Snow, 'til death we'll be freezing","translation":"","kind":"lyric"},{"id":"26","start":116.68,"end":119.68,"text":"Yeah, you are my home, my home for all seasons","translation":"","kind":"lyric"},{"id":"27","start":120.19,"end":123.19,"text":"So come on, let's go","translation":"","kind":"lyric"},{"id":"28","start":123.65,"end":126.65,"text":"Let's go below zero and hide from the sun","translation":"","kind":"lyric"},{"id":"29","start":126.84,"end":129.84,"text":"I love you forever where we'll have some fun","translation":"","kind":"lyric"},{"id":"30","start":130.34,"end":133.34,"text":"Yes, let's hit the North Pole and live happily","translation":"","kind":"lyric"},{"id":"31","start":133.74,"end":136.74,"text":"Please don't cry no tears now, it's Christmas, baby","translation":"","kind":"lyric"},{"id":"32","start":137.14,"end":140.14,"text":"My snowman and me","translation":"","kind":"lyric"},{"id":"33","start":144.18,"end":147.18,"text":"My snowman and me","translation":"","kind":"lyric"},{"id":"34","start":150.24,"end":153.24,"text":"Baby","translation":"","kind":"lyric"}],"candidates":[]}