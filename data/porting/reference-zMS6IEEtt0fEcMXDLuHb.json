ranslation":"","kind":"lyric"},{"id":"18","start":81.87,"end":89.25,"text":"電子音で伝えるよ","translation":"","kind":"lyric"},{"id":"19","start":89.25,"end":92.92,"text":"好きになる事 理屈なんかじゃなくて","translation":"","kind":"lyric"},{"id":"20","start":92.92,"end":96.62,"text":"「こじつけ」なんて いらないんじゃない？","translation":"","kind":"lyric"},{"id":"21","start":96.62,"end":100.58,"text":"時代のせいと 諦めたらそこまで","translation":"","kind":"lyric"},{"id":"22","start":100.58,"end":104.39,"text":"踏み出さなくちゃ 何も始まらない","translation":"","kind":"lyric"},{"id":"23","start":104.39,"end":108.0,"text":"「ゴメンね夜遅く 寝るところだったでしょ？」","translation":"","kind":"lyric"},{"id":"24","start":108.0,"end":111.72999999999999,"text":"「驚いた 私もかけようとしてた」","translation":"","kind":"lyric"},{"id":"25","start":111.72999999999999,"end":115.66,"text":"心の裏側をくすぐられてるような","translation":"","kind":"lyric"},{"id":"26","start":115.66,"end":119.46000000000001,"text":"惹かれあう2人に 幸せな音を","translation":"","kind":"lyric"},{"id":"27","start":119.46000000000001,"end":122.89,"text":"ハッピーシンセサイザ ほらね 楽しくなるよ","translation":"","kind":"lyric"},{"id":"28","start":122.89,"end":126.92,"text":"涙拭うメロディ 奏でるよ","translation":"","kind":"lyric"},{"id":"29","start":126.92,"end":130.58,"text":"強がらなくたっていいんじゃない？ 別に","translation":"","kind":"lyric"},{"id":"30","start":130.58,"end":134.68,"text":"自分に素直になればいい","translation":"","kind":"lyric"},{"id":"31","start":134.68,"end":138.46,"text":"何の取り柄も無い 僕に唯一つ","translation":"","kind":"lyric"},{"id":"32","start":138.46,"end":142.23,"text":"少しだけど 出来る事","translation":"","kind":"lyric"},{"id":"33","start":142.23,"end":146.03,"text":"ちょっと照れるような 単純な気持ち","translation":"","kind":"lyric"},{"id":"34","start":146.03,"end":166.64,"text":"電子音で伝えるよ","translation":"","kind":"lyric"},{"id":"35","start":166.64,"end":170.27,"text":"ハッピーシンセサイザ 君の 胸の奥まで","translation":"","kind":"lyric"},{"id":"36","start":170.27,"end":174.15,"text":"届くようなメロディ 奏でるよ","translation":"","kind":"lyric"},{"id":"37","start":174.15,"end":177.89,"text":"つまらない「たてまえ」や ヤな事全部","translation":"",