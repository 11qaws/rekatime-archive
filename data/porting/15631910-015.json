{"title":"HAMELN","artist":"하츠키 유라","date":"2026-10-11","sourceId":"15631910:015","sourceHash":"b5450cd61f2e5eca1cf5b42c551372ab9a5bf9154eb82b5d534ecb187e219111","duration":218.2,"cues":[{"id":"1","start":12.162687000000005,"end":15.442686999998841,"text":"軽やかに響く笛が","translation":"경쾌하게 울리는 피리 소리","kind":"lyric"},{"id":"2","start":15.50268700000015,"end":18.922686999998405,"text":"窓の外の闇に浮かぶ","translation":"창밖 어둠 위로 떠올라","kind":"lyric"},{"id":"3","start":19.682687000000442,"end":23.58268699999826,"text":"どうか連れ去って行って","translation":"부디 나를 데려가 줘","kind":"lyric"},{"id":"4","start":23.64268699999957,"end":26.14268699999957,"text":"冥府への道でも構わない","translation":"저승으로 가는 길이어도 좋아","kind":"lyric"},{"id":"5","start":26.20268700000088,"end":30.722687000001315,"text":"冷たいこの部屋の中","translation":"얼어붙은 이 방 안에서","kind":"lyric"},{"id":"6","start":30.782686999998987,"end":34.02268700000059,"text":"拭えない孤毒　死が香りだす","translation":"지워지지 않는 고독의 독 죽음이 향기를 피워","kind":"lyric"},{"id":"7","start":34.08268699999826,"end":37.52268700000059,"text":"二つ目の星は語る","translation":"두 번째 별이 말해","kind":"lyric"},{"id":"8","start":37.58268699999826,"end":43.58268699999826,"text":"「光望めば目が眩む…」","translation":"빛을 원하면 눈이 멀어","kind":"lyric"},{"id":"9","start":45.042687000001024,"end":48.56268700000146,"text":"ハーメルンが奏でる魅惑の音色が","translation":"하멜른이 연주하는 매혹의 음색이","kind":"lyric"},{"id":"10","start":48.62268699999913,"end":52.222687000001315,"text":"私の理性を乱し快楽へ誘う","translation":"이성을 흐트러뜨려 쾌락으로 이끌어","kind":"lyric"},{"id":"11","start":52.28268699999899,"end":55.943686999999045,"text":"刻まれた爪痕に歪んだとしても","translation":"새겨진 손톱자국에 몸이 일그러져도","kind":"lyric"},{"id":"12","start":56.003687000000355,"end":62.003687000000355,"text":"恍惚の中で愚かな生贄となる","translation":"황홀 속에서 어리석은 제물이 돼","kind":"lyric"},{"id":"13","start":87.6026869999987,"end":91.14868700000079,"text":"薔薇のアーチを抜けたら","translation":"장미 아치를 빠져나오면","kind":"lyric"},{"id":"14","start":91.20868699999846,"end":94.89568700000018,"text":"小高い丘　灯る炎","translation":"나지막한 언덕에 타오르는 불꽃","kind":"lyric"},{"id":"15","start":94.95568700000149,"end":98.39168699999937,"text":"傷ついた足に触れて","translation":"상처 입은 발에 손을 대고","kind":"lyric"},{"id":"16","start":98.45168700000067,"end":102.2976869999984,"text":"口付けた場所から溢れる火","translation":"입 맞춘 자리에서 불길이 넘쳐나","kind":"lyric"},{"id":"17","start":102.35768699999971,"end":105.89468699999998,"text":"遠のく意識の中","translation":"아득해지는 의식 속","kind":"lyric"},{"id":"18","start":105.95468700000129,"end":109.69068699999843,"text":"拭えない熱に　支配されて行く","translation":"가시지 않는 열기에 지배당해 가","kind":"lyric"},{"id":"19","start":109.75068699999974,"end":112.85768699999971,"text":"双子の月は語る","translation":"쌍둥이 달이 말해","kind":"lyric"},{"id":"20","start":112.91768700000102,"end":118.91768700000102,"text":"「諍えぬ魔はそばにある…」","translation":"거스를 수 없는 마가 곁에 있어","kind":"lyric"},{"id":"21","start":120.51968699999998,"end":124.16568700000062,"text":"ハーメルンが奏でる哀婉の音色が","translation":"하멜른이 연주하는 애절한 음색이","kind":"lyric"},{"id":"22","start":124.22568699999829,"end":127.96268699999928,"text":"優しい不安を纏い　闇を漂う","translation":"부드러운 불안을 걸치고 어둠을 떠돌아","kind":"lyric"},{"id":"23","start":128.0226870000006,"end":131.56868699999904,"text":"切り裂かれた肌から零れる雫を","translation":"찢긴 살갗에서 떨어지는 물방울을","kind":"lyric"},{"id":"24","start":131.62868700000035,"end":137.62868700000035,"text":"金色の瞳　絡む指　悪魔が踊る","translation":"금빛 눈동자 뒤얽힌 손가락 악마가 춤춘다","kind":"lyric"},{"id":"25","start":150.4696870000007,"end":153.55668700000024,"text":"冷たいこの夜の中","translation":"얼어붙은 이 밤 속에서","kind":"lyric"},{"id":"26","start":153.6166869999979,"end":157.57268699999986,"text":"拭えない孤毒　死が溢れ出す","translation":"지워지지 않는 고독의 독 죽음이 넘쳐나","kind":"lyric"},{"id":"27","start":157.63268700000117,"end":160.9696870000007,"text":"囁いた貴方の声","translation":"속삭이던 너의 목소리","kind":"lyric"},{"id":"28","start":161.02968699999838,"end":167.02968699999838,"text":"「光望めば闇を呼ぶ…」","translation":"빛을 원하면 어둠을 불러","kind":"lyric"},{"id":"29","start":168.5916870000001,"end":172.12868700000035,"text":"ハーメルンが奏でる魅惑の音色が","translation":"하멜른이 연주하는 매혹의 음색이","kind":"lyric"},{"id":"30","start":172.18868699999803,"end":175.97468699999808,"text":"私の理性を乱し熱を与える","translation":"이성을 흐트러뜨려 열기를 불어넣어","kind":"lyric"},{"id":"31","start":176.0346869999994,"end":179.52068700000018,"text":"刻まれた刻印が痛んだとしても","translation":"새겨진 각인이 욱신거려도","kind":"lyric"},{"id":"32","start":179.5806870000015,"end":183.3676869999981,"text":"恍惚の中で愚かな生贄となる","translation":"황홀 속에서 어리석은 제물이 돼","kind":"lyric"},{"id":"33","start":183.42768699999942,"end":186.6636870000002,"text":"ハーメルンが奏でる哀婉の音色が","translation":"하멜른이 연주하는 애절한 음색이","kind":"lyric"},{"id":"34","start":186.72368700000152,"end":190.75968699999794,"text":"優しい不安を纏い　闇を漂う","translation":"부드러운 불안을 걸치고 어둠을 떠돌아","kind":"lyric"},{"id":"35","start":190.81968699999925,"end":194.2166870000001,"text":"咲いた薔薇　ベルベットの声を捧げて","translation":"피어난 장미 벨벳 같은 목소리를 바치며","kind":"lyric"},{"id":"36","start":194.2766870000014,"end":200.2766870000014,"text":"金色の瞳　跳ねる指　私は踊る","translation":"금빛 눈동자 튀어 오르는 손가락 나는 춤춘다","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}