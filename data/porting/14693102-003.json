":"lyric"},{"id":"18","start":111.78,"end":115.62,"text":"愛をひとつまたね またね","translation":"사랑 하나 다음에 만나 다음에 만나","kind":"lyric"},{"id":"19","start":115.62,"end":119.26,"text":"夜に咲く温度と灯るまで","translation":"밤에 피는 온기가 불을 밝힐 때까지","kind":"lyric"},{"id":"20","start":119.26,"end":122.92,"text":"呼吸ひとつ生きる 生きる","translation":"숨 한번 살아가 살아가","kind":"lyric"},{"id":"21","start":122.92,"end":126.62,"text":"優しい日々の横で泣かぬように","translation":"다정한 나날 곁에서 울지 않도록","kind":"lyric"},{"id":"22","start":126.62,"end":130.8,"text":"愛をひとつまたね またね 嗚呼","translation":"사랑 하나 다음에 만나 다음에 만나","kind":"lyric"},{"id":"23","start":133.94,"end":137.78,"text":"愛をひとつまたね またね","translation":"사랑 하나 다음에 만나 다음에 만나","kind":"lyric"},{"id":"24","start":137.78,"end":141.8,"text":"優しい日々の横で笑うように 嗚呼","translation":"다정한 나날 곁에서 웃을 수 있도록","kind":"lyric"},{"id":"25","start":142.42,"end":143.78,"text":"吐き出す気持ちは簡単で","translation":"마음을 토해 내는 건 쉬운데","kind":"lyric"},{"id":"26","start":143.78,"end":144.9,"text":"でも生きるの難易度高すぎて","translation":"살아가는 난이도는 너무 높아서","kind":"lyric"},{"id":"27","start":145.48,"end":149.14,"text":"どうにも解けない問いだらけ 嗚呼","translation":"도무지 풀 수 없는 질문투성이","kind":"lyric"},{"id":"28","start":149.42,"end":151.12,"text":"さっぱりきっかり前向いて","translation":"말끔히 딱 잘라 앞을 보고","kind":"lyric"},{"id":"29","start":151.12,"end":152.96,"text":"なんてしなくて良いから抱きしめて","translation":"그러지 않아도 되니까 안아 줘","kind":"lyric"},{"id":"30","start":152.96,"end":156.62,"text":"愛をひとつまたね またね","translation":"사랑 하나 다음에 만나 다음에 만나","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}