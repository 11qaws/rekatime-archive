{"title":"엘프","artist":"테니오하","sourceId":"reference:vqlykfsilvbtqz6CuwBn","sourceHash":"3ed3a466fa90d151c2d155362edac4ce72e51b68469214ae1a1ef674d81266a5","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":0.75,"end":3.75,"text":"走りなさい　疾く　もっと疾く　哀しみに追いつかれないように","translation":"","kind":"lyric"},{"id":"2","start":12.69,"end":15.69,"text":"探しなさい　明かりの灯る道を　それはそれは眩いでしょう","translation":"","kind":"lyric"},{"id":"3","start":26.11,"end":29.11,"text":"挑みなさい　君の美しさや尊さを傷つけるモノに","translation":"","kind":"lyric"},{"id":"4","start":38.09,"end":41.09,"text":"眠りなさい　疲れたら眠りなさい　神話を持たないあの星座のように","translation":"","kind":"lyric"},{"id":"5","start":50.6,"end":53.6,"text":"手を離した後　君は気づくだろう　指の形　体温","translation":"","kind":"lyric"},{"id":"6","start":59.89,"end":62.89,"text":"その名残が胸を刺す","translation":"","kind":"lyric"},{"id":"7","start":67.84,"end":70.84,"text":"忘れたことも忘れてしまえ　哀しみも温もりも消えてしまえ","translation":"","kind":"lyric"},{"id":"8","start":80.18,"end":83.18,"text":"されど　今も耳に残るは　固く再会をうような","translation":"","kind":"lyric"},{"id":"9","start":91.99,"end":94.92,"text":"「さようなら」","translation":"","kind":"lyric"},{"id":"10","start":94.92,"end":97.75999999999999,"text":"Adieu Adieu","translation":"","kind":"lyric"},{"id":"11","start":97.75999999999999,"end":100.75999999999999,"text":"Love You And you？","translation":"","kind":"lyric"},{"id":"12","start":104.25999999999999,"end":107.25999999999999,"text":"踊りなさい　誰に笑われても　淡雪を払う枝のように","translation":"","kind":"lyric"},{"id":"13","start":116.07,"end":119.07,"text":"叫びなさい　心から叫びなさい　ここに確かにいたんだと響かせて","translation":"","kind":"lyric"},{"id":"14","start":128.56,"end":131.56,"text":"行合いの空に遠花火が滲む","translation":"","kind":"lyric"},{"id":"15","start":134.56,"end":137.56,"text":"帰るべき家を探す　長い長い旅路を行くなら","translation":"","kind":"lyric"},{"id":"16","start":145.9,"end":148.9,"text":"高らか鳴らせ　その心臓は最後の一打ちまで君の物だ","translation":"","kind":"lyric"},{"id":"17","start":158.18,"end":161.18,"text":"涙涙　溢れるがいい　降る雫が君の森を育てるだろう","translation":"","kind":"lyric"},{"id":"18","start":182.04,"end":185.04,"text":"それは千年のホームシックでした　無限さえも数え終えて","translation":"","kind":"lyric"},{"id":"19","start":194.31,"end":197.31,"text":"怪物のような世界の隅っこで戦い続ける人","translation":"","kind":"lyric"},{"id":"20","start":203.61,"end":206.61,"text":"君はエルフ　エルフ","translation":"","kind":"lyric"},{"id":"21","start":207.37,"end":210.37,"text":"(愛しき)旅は続く","translation":"","kind":"lyric"},{"id":"22","start":213.37,"end":216.37,"text":"忘れたことも忘れてしまえ　哀しみも温もりも消えちまえ","translation":"","kind":"lyric"},{"id":"23","start":225.26,"end":228.26,"text":"されど今も今も耳に残るは　固く再会を希うような","translation":"","kind":"lyric"},{"id":"24","start":237.55,"end":240.32,"text":"「さようなら」","translation":"","kind":"lyric"},{"id":"25","start":240.32,"end":243.32,"text":"Adieu Adieu","translation":"","kind":"lyric"},{"id":"26","start":243.33,"end":246.32,"text":"Love You And you？","translation":"","kind":"lyric"},{"id":"27","start":246.32,"end":249.32,"text":"Adieu Adieu","translation":"","kind":"lyric"}],"candidates":[]}