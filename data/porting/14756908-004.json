{"title":"물거품","artist":"ヨルシカ","date":"2026-08-18","sourceId":"14756908:004","sourceHash":"83d55d05b9201ae977b456bd05889332bf0bfd667bea61749e43e23e6a7f6bb1","duration":309.9,"cues":[{"id":"1","start":15.66,"end":18.78,"text":"あぁどうしようもないほどに","translation":"아아 어쩔 도리가 없을 만큼","kind":"lyric"},{"id":"2","start":18.78,"end":20.96,"text":"私に蠢く獣","translation":"내 안에서 꿈틀대는 짐승","kind":"lyric"},{"id":"3","start":22.28,"end":28.9,"text":"水面浮かんで浮かんでは消える あぶく","translation":"수면에 떠올랐다 사라지는 물거품","kind":"lyric"},{"id":"4","start":33.64,"end":35.94,"text":"あぁどうしようもなく悲しい","translation":"아아 어쩔 도리 없이 슬퍼","kind":"lyric"},{"id":"5","start":36.0,"end":38.6,"text":"私を動かす獣","translation":"나를 움직이는 짐승","kind":"lyric"},{"id":"6","start":39.98,"end":43.4,"text":"トートロジー握った手のあぶく","translation":"동어반복을 움켜쥔 손의 물거품","kind":"lyric"},{"id":"7","start":44.81,"end":47.92,"text":"過ぎ去る雲を思うより","translation":"흘러가는 구름을 생각하기보다","kind":"lyric"},{"id":"8","start":47.92,"end":50.26,"text":"遥かへ遠吠え","translation":"아득한 곳으로 울부짖어","kind":"lyric"},{"id":"9","start":50.26,"end":53.74,"text":"息継ぐ暇もないほど","translation":"숨 돌릴 틈도 없을 만큼","kind":"lyric"},{"id":"10","start":53.74,"end":56.34,"text":"苦しいあれで","translation":"괴로운 그것으로","kind":"lyric"},{"id":"11","start":57.73,"end":60.52,"text":"悠々悠々夢を焼け","translation":"유유히 유유히 꿈을 불태워","kind":"lyric"},{"id":"12","start":60.52,"end":63.72,"text":"魂の白い白い色で","translation":"영혼의 새하얀 빛깔로","kind":"lyric"},{"id":"13","start":64.0,"end":69.4,"text":"喜びの火に火をつけたいだけ","translation":"기쁨의 불에 불을 붙이고 싶을 뿐","kind":"lyric"},{"id":"14","start":69.46,"end":72.14,"text":"想像は少しの泡銭","translation":"상상은 조금의 뜬돈","kind":"lyric"},{"id":"15","start":72.14,"end":75.54,"text":"冷めない言葉の両手で","translation":"식지 않는 말의 두 손으로","kind":"lyric"},{"id":"16","start":75.92,"end":79.82,"text":"燃え尽きないものを数えて","translation":"다 타지 않는 것들을 세어","kind":"lyric"},{"id":"17","start":80.44,"end":82.62,"text":"掬いたいだけ","translation":"건져 올리고 싶을 뿐","kind":"lyric"},{"id":"18","start":93.42,"end":96.32,"text":"さぁ 銘々ご覧遊べ","translation":"자 각자 마음껏 구경해","kind":"lyric"},{"id":"19","start":96.32,"end":98.52,"text":"私の乾いた獣","translation":"나의 메마른 짐승","kind":"lyric"},{"id":"20","start":99.66,"end":103.5,"text":"ふつふつ怒った音を鳴らして","translation":"부글부글 성난 소리를 울리며","kind":"lyric"},{"id":"21","start":105.26,"end":107.9,"text":"あぁろうそくの火を消して","translation":"아아 촛불을 꺼 버리고","kind":"lyric"},{"id":"22","start":107.9,"end":110.42,"text":"私に残ったものは","translation":"내게 남은 것은","kind":"lyric"},{"id":"23","start":111.7,"end":115.2,"text":"滑稽なペダンチスムだけ","translation":"우스운 현학뿐","kind":"lyric"},{"id":"24","start":116.44,"end":119.6,"text":"過ぎ去る雲にどうして","translation":"흘러가는 구름에 어째서","kind":"lyric"},{"id":"25","start":119.6,"end":122.06,"text":"私は遠吠え","translation":"나는 울부짖어","kind":"lyric"},{"id":"26","start":122.56,"end":125.44,"text":"悲しむ暇もないほど","translation":"슬퍼할 틈도 없을 만큼","kind":"lyric"},{"id":"27","start":125.44,"end":128.16,"text":"悲しいあれで","translation":"슬픈 그것으로","kind":"lyric"},{"id":"28","start":129.16,"end":131.98,"text":"想想想像で一つだけ","translation":"상상 상상 상상으로 하나만","kind":"lyric"},{"id":"29","start":131.98,"end":135.34,"text":"寂しい私に太陽を","translation":"외로운 나에게 태양을","kind":"lyric"},{"id":"30","start":135.76,"end":140.84,"text":"喜びに火を、火をつけておくれ","translation":"기쁨에 불을 불을 붙여 줘","kind":"lyric"},{"id":"31","start":140.84,"end":143.82,"text":"焦燥も少しの泡銭","translation":"초조함도 조금의 뜬돈","kind":"lyric"},{"id":"32","start":143.82,"end":147.14,"text":"苦しい私の両手で","translation":"괴로운 나의 두 손으로","kind":"lyric"},{"id":"33","start":147.66,"end":151.5,"text":"燃え尽きないものを数えて","translation":"다 타지 않는 것들을 세어","kind":"lyric"},{"id":"34","start":152.7,"end":154.34,"text":"摘みたいだけ","translation":"따고 싶을 뿐","kind":"lyric"},{"id":"35","start":165.52,"end":168.54,"text":"半信半疑の満身創痍で尚","translation":"반신반의하며 만신창이인 채로도","kind":"lyric"},{"id":"36","start":168.54,"end":170.72,"text":"太陽が欲しい","translation":"태양을 원해","kind":"lyric"},{"id":"37","start":171.14,"end":173.86,"text":"だからもっと私に火をつけて","translation":"그러니 내게 더 불을 붙여","kind":"lyric"},{"id":"38","start":173.86,"end":175.38,"text":"吐き出して","translation":"토해 내","kind":"lyric"},{"id":"39","start":176.98,"end":182.46,"text":"超能力でも創作物でも現実逃避でもいい","translation":"초능력이든 창작물이든 현실 도피든 좋아","kind":"lyric"},{"id":"40","start":182.8,"end":185.6,"text":"もっと私に火をつけて","translation":"내게 더 불을 붙여","kind":"lyric"},{"id":"41","start":185.6,"end":188.04,"text":"私を震わせて","translation":"나를 떨게 해","kind":"lyric"},{"id":"42","start":199.28,"end":202.48,"text":"夕夕夕夕夕、目を焼け","translation":"저녁 저녁 저녁 저녁 저녁 눈을 태워","kind":"lyric"},{"id":"43","start":202.48,"end":205.28,"text":"魂の白い白い色で","translation":"영혼의 새하얀 빛깔로","kind":"lyric"},{"id":"44","start":206.02,"end":211.14,"text":"喜びの火に火をつけたいだけ","translation":"기쁨의 불에 불을 붙이고 싶을 뿐","kind":"lyric"},{"id":"45","start":211.14,"end":214.12,"text":"想像の頭上の上を行け","translation":"상상의 머리 위보다 더 높이 가","kind":"lyric"},{"id":"46","start":214.12,"end":217.1,"text":"冷めない言葉の両手で","translation":"식지 않는 말의 두 손으로","kind":"lyric"},{"id":"47","start":217.1,"end":222.26,"text":"燃え尽きたものも全て","translation":"다 타 버린 것까지 모두","kind":"lyric"},{"id":"48","start":222.56,"end":224.54,"text":"掬いたいだけ","translation":"건져 올리고 싶을 뿐","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}