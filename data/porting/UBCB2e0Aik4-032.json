{"title":"수직낙하","artist":"傘村トータ","date":"2026-07-20","sourceId":"UBCB2e0Aik4:032","sourceHash":"f34d661879acadaf34f96db2ff73c90e2ed6732e7f9220b88ed472688f8f0d02","duration":270.85,"cues":[{"id":"1","start":3.51,"end":7.32,"text":"あなたは言うんだ","translation":"넌 말해","kind":"lyric"},{"id":"2","start":7.32,"end":11.4,"text":"「ひとりでいたいんだ」","translation":"혼자 있고 싶어","kind":"lyric"},{"id":"3","start":12.0,"end":16.0,"text":"馬鹿みたいに泣きながら","translation":"바보처럼 울면서","kind":"lyric"},{"id":"4","start":16.0,"end":19.86,"text":"そう言うんだ","translation":"그렇게 말해","kind":"lyric"},{"id":"5","start":19.86,"end":23.0,"text":"放っておいたら","translation":"내버려 두면","kind":"lyric"},{"id":"6","start":23.1,"end":26.6,"text":"壊れてしまうでしょう？","translation":"부서져 버리겠지","kind":"lyric"},{"id":"7","start":27.28,"end":31.58,"text":"あなたを生かすためだけに","translation":"너를 살리기 위해서만","kind":"lyric"},{"id":"8","start":31.58,"end":34.42,"text":"私はいるんだよ","translation":"나는 있는 거야","kind":"lyric"},{"id":"9","start":35.48,"end":39.18,"text":"放り投げられた光を掴んで","translation":"내던져진 빛을 붙잡아","kind":"lyric"},{"id":"10","start":39.18,"end":43.74,"text":"あなたの心臓に戻すから","translation":"네 심장에 돌려놓을 테니까","kind":"lyric"},{"id":"11","start":43.84,"end":47.88,"text":"星々の間を器用にも縫って","translation":"별들 사이를 능숙하게 꿰매고","kind":"lyric"},{"id":"12","start":47.88,"end":53.7,"text":"真っ直ぐ落ちていかないで","translation":"똑바로 떨어져 가지 마","kind":"lyric"},{"id":"13","start":54.58,"end":57.44,"text":"花びらを重ねて","translation":"꽃잎을 겹쳐","kind":"lyric"},{"id":"14","start":58.26,"end":61.84,"text":"あなたを受け止めようとする","translation":"너를 받아 내려 해","kind":"lyric"},{"id":"15","start":61.84,"end":69.62,"text":"私の腕は何度も折れていたの","translation":"내 두 팔은 몇 번이고 부러졌어","kind":"lyric"},{"id":"16","start":69.62,"end":76.64,"text":"あなたの心の脆い糸が","translation":"네 마음의 여린 실이","kind":"lyric"},{"id":"17","start":77.26,"end":83.75,"text":"ミサンガだったら幸せかな","translation":"미산가라면 행복할까","kind":"lyric"},{"id":"18","start":83.75,"end":88.02,"text":"あなたは言うんだ","translation":"넌 말해","kind":"lyric"},{"id":"19","start":88.02,"end":91.72,"text":"「二人でいたいんだ」","translation":"둘이 있고 싶어","kind":"lyric"},{"id":"20","start":92.64,"end":96.44,"text":"馬鹿みたいに泣きながら","translation":"바보처럼 울면서","kind":"lyric"},{"id":"21","start":96.44,"end":99.74,"text":"そう言うんだ","translation":"그렇게 말해","kind":"lyric"},{"id":"22","start":99.74,"end":103.56,"text":"放っておいたら","translation":"내버려 두면","kind":"lyric"},{"id":"23","start":103.56,"end":107.78,"text":"壊れてしまうだろう？","translation":"부서져 버리잖아","kind":"lyric"},{"id":"24","start":108.0,"end":112.08,"text":"あなたを生かすためだけに","translation":"너를 살리기 위해서만","kind":"lyric"},{"id":"25","start":112.08,"end":114.92,"text":"僕はいるんだよ","translation":"난 있는 거야","kind":"lyric"},{"id":"26","start":115.94,"end":119.64,"text":"集め損なった光を拾って","translation":"미처 모으지 못한 빛을 주워","kind":"lyric"},{"id":"27","start":119.64,"end":123.84,"text":"あなたの心臓に戻すから","translation":"네 심장에 돌려놓을 테니까","kind":"lyric"},{"id":"28","start":123.84,"end":128.3,"text":"星々の間を器用にも縫って","translation":"별들 사이를 능숙하게 꿰매고","kind":"lyric"},{"id":"29","start":128.3,"end":133.66,"text":"真っ直ぐ落ちてることに気付いて","translation":"똑바로 떨어지고 있단 걸 알아차려","kind":"lyric"},{"id":"30","start":134.0,"end":137.46,"text":"花びらを避けて","translation":"꽃잎을 피해","kind":"lyric"},{"id":"31","start":138.25,"end":142.54,"text":"あなたを引き寄せようとする","translation":"너를 끌어당기려 해","kind":"lyric"},{"id":"32","start":142.54,"end":150.02,"text":"僕の身体は何度も砕けている","translation":"내 몸은 몇 번이고 부서지고 있어","kind":"lyric"},{"id":"33","start":150.02,"end":156.82,"text":"あなたの心の脆い糸は","translation":"네 마음의 여린 실은","kind":"lyric"},{"id":"34","start":156.82,"end":163.64,"text":"切れても願いなんて叶わない","translation":"끊어져도 소원 따윈 이루어지지 않아","kind":"lyric"},{"id":"35","start":165.54,"end":169.68,"text":"(落ちていく) 伸ばす 手は 空を掴む","translation":"떨어져 가 / 뻗은 손은 허공을 붙잡아","kind":"lyric"},{"id":"36","start":169.68,"end":172.96,"text":"(落ちていく) 竦む 足は 空を蹴る","translation":"떨어져 가 / 움츠린 발은 허공을 걷어차","kind":"lyric"},{"id":"37","start":172.96,"end":177.1,"text":"(あなたはどこ) 声は聞こえて 何も見えない","translation":"넌 어디에 / 목소리는 들리는데 아무것도 보이지 않아","kind":"lyric"},{"id":"38","start":177.1,"end":181.1,"text":"垂らされている 糸に気づく","translation":"늘어뜨려진 실을 알아차려","kind":"lyric"},{"id":"39","start":181.1,"end":184.46,"text":"「あなたが掴んで」","translation":"네가 붙잡아 줘","kind":"lyric"},{"id":"40","start":184.46,"end":188.16,"text":"私(僕)は落ちる","translation":"나는 떨어져","kind":"lyric"},{"id":"41","start":188.16,"end":191.78,"text":"花びらの隙間を","translation":"꽃잎 틈새로","kind":"lyric"},{"id":"42","start":191.78,"end":196.14,"text":"二人は落ちていく","translation":"두 사람은 떨어져 가","kind":"lyric"},{"id":"43","start":196.58,"end":203.78,"text":"心は何度も崩れている","translation":"마음은 몇 번이고 무너지고 있어","kind":"lyric"},{"id":"44","start":203.78,"end":210.54,"text":"やっと繋げた手を離すくらいなら","translation":"겨우 맞잡은 손을 놓을 바엔","kind":"lyric"},{"id":"45","start":212.06,"end":217.74,"text":"願いなんて叶わなくて構わない","translation":"소원 따윈 이뤄지지 않아도 괜찮아","kind":"lyric"},{"id":"46","start":217.74,"end":226.12,"text":"あなたがそこに居れば、僕らは","translation":"네가 거기 있다면 우리는","kind":"lyric"},{"id":"47","start":226.72,"end":228.94,"text":"僕らは","translation":"우리는","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}