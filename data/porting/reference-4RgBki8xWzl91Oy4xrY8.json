{"title":"BLOODY STREAM","artist":"오오모리 토시유키","sourceId":"reference:4RgBki8xWzl91Oy4xrY8","sourceHash":"df5737d049a910954014c7c400eb879ac5f51bcc20eed93fab0062a7bb1456c1","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":36112965,"cues":[{"id":"1","start":7.21,"end":21.84,"text":"静寂の底から 目覚めるその柱たち 時を越え","translation":"","kind":"lyric"},{"id":"2","start":21.84,"end":36.68,"text":"深紅の血潮が 立ち上がる勇気を 惹きあわせる","translation":"","kind":"lyric"},{"id":"3","start":36.68,"end":44.3,"text":"受け継ぐ愛を 宿命と呼ぶなら","translation":"","kind":"lyric"},{"id":"4","start":44.3,"end":52.28,"text":"微笑む目で 次の手を","translation":"","kind":"lyric"},{"id":"5","start":52.28,"end":57.28,"text":"闇を欺いて 刹那を躱して","translation":"","kind":"lyric"},{"id":"6","start":57.28,"end":61.05,"text":"刃すり抜け奴らの間隙を突け","translation":"","kind":"lyric"},{"id":"7","start":61.05,"end":68.25,"text":"つらぬいた信念が 未来を拓く","translation":"","kind":"lyric"},{"id":"8","start":68.25,"end":71.89,"text":"Like a bloody storm 熱くlike a bloody stone","translation":"","kind":"lyric"},{"id":"9","start":71.89,"end":75.44,"text":"血脈に刻まれた因縁に","translation":"","kind":"lyric"},{"id":"10","start":75.44,"end":86.49,"text":"浮き上がる消えない誇りの絆 握りしめて","translation":"","kind":"lyric"},{"id":"11","start":118.11,"end":130.18,"text":"漲る力に 打ち付ける鼓動は証 友の声","translation":"","kind":"lyric"},{"id":"12","start":132.89,"end":142.2,"text":"滲んだ痛みと 今生き抜く意味を 交わしながら","translation":"","kind":"lyric"},{"id":"13","start":147.75,"end":155.12,"text":"お前の意志が 夜明けを導く","translation":"","kind":"lyric"},{"id":"14","start":155.12,"end":162.93,"text":"目映いほどの 気高さで","translation":"","kind":"lyric"},{"id":"15","start":162.93,"end":167.94,"text":"光射す丘へ 灼熱の空へ","translation":"","kind":"lyric"},{"id":"16","start":167.94,"end":171.88,"text":"魂がぶつかりあう旅路へ","translation":"","kind":"lyric"},{"id":"17","start":171.88,"end":180.74,"text":"悲しみに塗られた 未来を救え","translation":"","kind":"lyric"},{"id":"18","start":180.74,"end":184.48,"text":"Like a bloody soul 燃やせ like a bloody star","translation":"","kind":"lyric"},{"id":"19","start":184.48,"end":188.14,"text":"炎裂き風を断ちその先へ","translation":"","kind":"lyric"},{"id":"20","start":188.14,"end":200.14,"text":"怖れずに何も躊躇わず進め 流れの中","translation":"","kind":"lyric"},{"id":"21","start":200.14,"end":214.6,"text":"共鳴する 運命の波紋 胸に","translation":"","kind":"lyric"},{"id":"22","start":217.79,"end":222.69,"text":"闇を欺いて 刹那を躱して","translation":"","kind":"lyric"},{"id":"23","start":222.69,"end":226.45,"text":"刃すり抜け奴らの間隙を突け","translation":"","kind":"lyric"},{"id":"24","start":226.45,"end":233.34,"text":"つらぬいた信念が 未来を拓く","translation":"","kind":"lyric"},{"id":"25","start":235.74,"end":239.11,"text":"Like a bloody storm 熱くlike a bloody stone","translation":"","kind":"lyric"},{"id":"26","start":239.11,"end":242.83,"text":"血脈に刻まれた因縁に","translation":"","kind":"lyric"},{"id":"27","start":242.83,"end":249.4,"text":"浮き上がる消えない誇りの絆 握りしめて","translation":"","kind":"lyric"}],"candidates":[]}