:110.7,"end":116.43,"text":"満たされないと泣いているのは","translation":"","kind":"lyric"},{"id":"19","start":116.43,"end":123.43,"text":"きっと満たされたいと願うから","translation":"","kind":"lyric"},{"id":"20","start":145.01,"end":150.81,"text":"僕が死のうと思ったのは","translation":"","kind":"lyric"},{"id":"21","start":150.81,"end":156.38,"text":"靴紐がほどけたから","translation":"","kind":"lyric"},{"id":"22","start":156.38,"end":162.2,"text":"結び直すのは苦手なんだよ","translation":"","kind":"lyric"},{"id":"23","start":162.2,"end":168.15,"text":"人との繋がりもまた然り","translation":"","kind":"lyric"},{"id":"24","start":168.15,"end":173.55,"text":"僕が死のうと思ったのは","translation":"","kind":"lyric"},{"id":"25","start":173.55,"end":179.35,"text":"少年が僕を見つめていたから","translation":"","kind":"lyric"},{"id":"26","start":179.35,"end":185.15,"text":"ベッドの上で土下座してるよ","translation":"","kind":"lyric"},{"id":"27","start":185.15,"end":191.38,"text":"あの日の僕にごめんなさいと","translation":"","kind":"lyric"},{"id":"28","start":191.38,"end":196.92000000000002,"text":"パソコンの薄明かり 上階の部屋の生活音","translation":"","kind":"lyric"},{"id":"29","start":196.92000000000002,"end":199.62,"text":"インターフォンのチャイムの音","translation":"","kind":"lyric"},{"id":"30","start":199.62,"end":202.73,"text":"耳を塞ぐ鳥籠の少年","translation":"","kind":"lyric"},{"id":"31","start":202.73,"end":205.48,"text":"見えない敵と戦ってる","translation":"","kind":"lyric"},{"id":"32","start":205.48,"end":208.32999999999998,"text":"六畳一間のドンキホーテ","translation":"","kind":"lyric"},{"id":"33","start":208.32999999999998,"end":216.4,"text":"ゴールはどうせ醜いものさ","translation":"","kind":"lyric"},{"id":"34","start":216.4,"end":222.82,"text":"僕が死のうと思ったのは","translation":"","kind":"lyric"},{"id":"35","start":222.82,"end":228.03,"text":"冷たい人と言われたから","translation":"","kind":"lyric"},{"id":"36","start":228.03,"end":233.57999999999998,"text":"愛されたいと泣いているのは","translation":"","kind":"lyric"},{"id":"37","start":233.57999999999998,"end":239.57999999999998,"text":"人の温もりをしってしまったから","translation":"","kind":"lyric"},{"id":"38","start":262.27,"end":267.85,"text":"僕が死のうと思ったのは","translation":"","kind":"lyric"},{"id":"39","start":267.85,"end":273.69,"text":"あなたが綺麗に笑うから","translation":"","kind":"lyric"},{"id":"40","start":273.69,"end":279.34000000000003,"text":"死ぬことばかり考えてしまうのは","translation":"","kind":"lyric"},{"id":"41","start":279.34000000000003,"end":285.27,"text":"きっと生きることに真面目すぎるから","translation":"","kind":"lyric"},{"id":"42","start":285.27,"end":290.86,"text":"僕が死のうと思ったのは","translation":"","kind":"lyric"},{"id":"43","start":290.86,"end":296.55,"text":"まだあなたに出会えてなかったから","translation":"","kind":"lyric"},{"id":"44","start":296.55,"end":302.43,"text":"あなたのような人が生まれた","translation":"","kind":"lyric"},{"id":"45","start":302.43,"end":307.86,"text":"世界を少し好きになったよ","translation":"","kind":"lyric"},{"id":"46","start":307.86,"end":313.64,"text":"あなたのような人が生きてる","translation":"","kind":"lyric"},{"id":"47","start":313.64,"end":317.01,"text":"世界に少し期待するよ","translation":"","kind":"lyric"}],"candidates":[]}