{"originalLanguage":"ja","title":"세븐틴","artist":"YOASOBI","date":"2026-07-29","sourceId":"ZFMg5irJJU8:012","sourceHash":"403560e4330979f949006c8fddc51d9524516cacd795b7710837cac19ad69954","duration":161.22,"cues":[{"id":"1","start":4.9,"end":6.9,"text":"鏡写しかのような","translation":"거울에 비친 듯","kind":"lyric"},{"id":"2","start":6.9,"end":8.14,"text":"瓜二つの世界に","translation":"꼭 닮은 두 세계에","kind":"lyric"},{"id":"3","start":8.14,"end":10.82,"text":"それぞれ生まれた二人の私","translation":"저마다 태어난 두 명의 나","kind":"lyric"},{"id":"4","start":10.82,"end":13.56,"text":"在るべき場所が違ったか","translation":"있어야 할 곳이 달랐던 걸까","kind":"lyric"},{"id":"5","start":13.56,"end":15.0,"text":"神様が間違ったか","translation":"신이 잘못한 걸까","kind":"lyric"},{"id":"6","start":15.0,"end":19.02,"text":"同じ姿形中身は真反対","translation":"같은 모습과 형태 속은 정반대","kind":"lyric"},{"id":"7","start":24.71,"end":27.02,"text":"違和感はどうやら","translation":"위화감은 아무래도","kind":"lyric"},{"id":"8","start":27.02,"end":28.7,"text":"ずっと前に育ってた","translation":"아주 오래전부터 자라 있었어","kind":"lyric"},{"id":"9","start":28.7,"end":31.84,"text":"パパもママも大事に思ってる","translation":"아빠도 엄마도 소중히 여겨","kind":"lyric"},{"id":"10","start":31.96,"end":34.14,"text":"だけど私はどうやら","translation":"하지만 나는 아무래도","kind":"lyric"},{"id":"11","start":34.14,"end":35.48,"text":"此処じゃ私じゃないから","translation":"여기선 내가 아니니까","kind":"lyric"},{"id":"12","start":35.48,"end":38.72,"text":"赤は赤に黒は黒に戻るの","translation":"빨강은 빨강으로 검정은 검정으로 돌아가","kind":"lyric"},{"id":"13","start":38.72,"end":42.46,"text":"次元を隔てた向こう側の世界じゃ","translation":"차원을 사이에 둔 저편 세계에선","kind":"lyric"},{"id":"14","start":42.46,"end":45.9,"text":"今日だって残酷な悪魔が鳴いている","translation":"오늘도 잔혹한 악마가 울고 있어","kind":"lyric"},{"id":"15","start":46.22,"end":49.32,"text":"あっちの私は怖がりで泣き虫なの","translation":"저쪽의 나는 겁 많고 울보야","kind":"lyric"},{"id":"16","start":49.32,"end":52.38,"text":"見て見ぬ振りできないから","translation":"못 본 척할 수 없으니까","kind":"lyric"},{"id":"17","start":53.86,"end":54.72,"text":"これじゃ","translation":"이래선","kind":"lyric"},{"id":"18","start":54.72,"end":57.42,"text":"ハッピーエンドとはいかない","translation":"해피 엔드가 될 수 없어","kind":"lyric"},{"id":"19","start":57.42,"end":60.88,"text":"それじゃ救いに行くね世界","translation":"그럼 구하러 갈게 세계를","kind":"lyric"},{"id":"20","start":61.02,"end":64.66,"text":"こんな乱暴な私を許して","translation":"이렇게 난폭한 나를 용서해","kind":"lyric"},{"id":"21","start":64.66,"end":67.38,"text":"きっとやり遂げるから","translation":"반드시 해낼 테니까","kind":"lyric"},{"id":"22","start":67.38,"end":70.85,"text":"これはバッドエンドなんかじゃない","translation":"이건 배드 엔드 따위가 아니야","kind":"lyric"},{"id":"23","start":70.85,"end":74.59,"text":"どこに居たとしても私は","translation":"어디에 있더라도 나는","kind":"lyric"},{"id":"24","start":74.59,"end":78.62,"text":"そう世界で一人のオリジナル","translation":"그래 이 세상에 하나뿐인 오리지널","kind":"lyric"},{"id":"25","start":78.62,"end":84.42,"text":"誇らしく思ってくれたら嬉しいな","translation":"자랑스럽게 여겨 준다면 기쁠 거야","kind":"lyric"},{"id":"26","start":89.72,"end":92.5,"text":"境界の線で切り分けた","translation":"경계선으로 갈라놓은","kind":"lyric"},{"id":"27","start":92.5,"end":94.22,"text":"こちら側の世界じゃ","translation":"이쪽 세계에선","kind":"lyric"},{"id":"28","start":94.22,"end":97.5,"text":"今日だって呑気な天使があくびする","translation":"오늘도 태평한 천사가 하품해","kind":"lyric"},{"id":"29","start":97.78,"end":99.6,"text":"気付いてしまった悪は","translation":"알아 버린 악은","kind":"lyric"},{"id":"30","start":99.6,"end":100.92,"text":"見逃せないから","translation":"눈감아 줄 수 없으니까","kind":"lyric"},{"id":"31","start":100.92,"end":104.22,"text":"帰り道を交換しよう","translation":"돌아갈 길을 바꾸자","kind":"lyric"},{"id":"32","start":105.66,"end":108.62,"text":"私が希望になるの","translation":"내가 희망이 될게","kind":"lyric"},{"id":"33","start":108.62,"end":112.5,"text":"お別れは少し寂しいけれど","translation":"이별은 조금 쓸쓸하지만","kind":"lyric"},{"id":"34","start":112.5,"end":116.34,"text":"いつか目尻に作った傷も","translation":"언젠가 눈가에 생긴 상처도","kind":"lyric"},{"id":"35","start":116.42,"end":120.46,"text":"理不尽に立ち向かった証だから","translation":"부조리에 맞선 증거니까","kind":"lyric"},{"id":"36","start":122.58,"end":126.14,"text":"いつかハッピーエンドになるまで","translation":"언젠가 해피 엔드가 될 때까지","kind":"lyric"},{"id":"37","start":126.14,"end":129.66,"text":"世界を相手に戦うの","translation":"세계를 상대로 싸울 거야","kind":"lyric"},{"id":"38","start":129.66,"end":133.22,"text":"こんな乱暴な私をずっと","translation":"이렇게 난폭한 나를 줄곧","kind":"lyric"},{"id":"39","start":133.22,"end":136.18,"text":"愛してくれてありがとう","translation":"사랑해 줘서 고마워","kind":"lyric"},{"id":"40","start":136.3,"end":139.7,"text":"これはバッドエンドなんかじゃない","translation":"이건 배드 엔드 따위가 아니야","kind":"lyric"},{"id":"41","start":139.7,"end":143.32,"text":"どこに居たとしても私は","translation":"어디에 있더라도 나는","kind":"lyric"},{"id":"42","start":143.32,"end":147.58,"text":"あなたの唯一無二のオリジナル","translation":"너만의 둘도 없는 오리지널","kind":"lyric"},{"id":"43","start":147.58,"end":149.96,"text":"誇らしく生きるよ","translation":"자랑스럽게 살아갈게","kind":"lyric"},{"id":"44","start":149.96,"end":153.26,"text":"さあ在るべき場所に帰ろう","translation":"자 이제 있어야 할 곳으로 돌아가자","kind":"lyric"},{"id":"45","start":153.26,"end":157.14,"text":"さよならを告げたセブンティーン","translation":"작별을 고한 세븐틴","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}