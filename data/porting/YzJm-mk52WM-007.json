{"title":"Rubia","artist":"Zhou Shen & HOYO-MiX","date":"2026-07-14","sourceId":"YzJm-mk52WM:007","sourceHash":"c5c972123920d289507c1aae19af99ee4bb77f325915b2087d4c572ff065973a","duration":197.02,"cues":[{"id":"1","start":12.147687,"end":16.06861,"text":"Life blooms like a flower","translation":"삶은 꽃처럼 피어나","kind":"lyric"},{"id":"2","start":16.06861,"end":19.565866,"text":"Far away or by the road","translation":"멀리서든 길가에서든","kind":"lyric"},{"id":"3","start":19.565866,"end":22.612,"text":"Waiting for the one","translation":"그 한 사람을 기다려","kind":"lyric"},{"id":"4","start":22.612,"end":25.659,"text":"To find the way back home","translation":"집으로 돌아갈 길을 찾게","kind":"lyric"},{"id":"5","start":25.659,"end":28.057,"text":"Rain falls a thousand times","translation":"비는 천 번이나 내려","kind":"lyric"},{"id":"6","start":28.057,"end":30.894975,"text":"No footprints of come-and-go","translation":"오간 발자국은 없어","kind":"lyric"},{"id":"7","start":30.894975,"end":34.332,"text":"You who once went by","translation":"한때 스쳐 간 너는","kind":"lyric"},{"id":"8","start":34.332,"end":37.429847,"text":"Where will you belong?","translation":"어디에 머물까","kind":"lyric"},{"id":"9","start":37.429847,"end":40.507,"text":"I feel your sigh and breath","translation":"네 한숨과 숨결이 느껴져","kind":"lyric"},{"id":"10","start":40.507,"end":45.663,"text":"In the last blow of wind","translation":"마지막 바람결에","kind":"lyric"},{"id":"11","start":45.663,"end":49.2,"text":"Not yet for the story on the last page","translation":"마지막 페이지의 이야긴 아직","kind":"lyric"},{"id":"12","start":49.200611,"end":52.398,"text":"It's not the end","translation":"끝이 아니야","kind":"lyric"},{"id":"13","start":52.398,"end":56.394965,"text":"Life blooms like a flower","translation":"삶은 꽃처럼 피어나","kind":"lyric"},{"id":"14","start":56.394965,"end":59.592,"text":"Far away or by the road","translation":"멀리서든 길가에서든","kind":"lyric"},{"id":"15","start":59.592,"end":62.809,"text":"Waiting for the one","translation":"그 한 사람을 기다려","kind":"lyric"},{"id":"16","start":62.809931,"end":66.387,"text":"To find the way back home","translation":"집으로 돌아갈 길을 찾게","kind":"lyric"},{"id":"17","start":66.387,"end":69.784,"text":"Time flows across the world","translation":"시간은 세상을 가로질러 흘러","kind":"lyric"},{"id":"18","start":69.784,"end":74.230969,"text":"There is always a longer way to go","translation":"가야 할 길은 늘 더 멀어","kind":"lyric"},{"id":"19","start":74.230969,"end":76.928852,"text":"'Til I reach your arms","translation":"네 품에 닿을 때까지","kind":"lyric"},{"id":"20","start":76.928852,"end":81.155535,"text":"A madder there for you","translation":"너를 위한 꼭두서니가 있어","kind":"lyric"},{"id":"21","start":81.155535,"end":84.36,"text":"Up against the stream","translation":"물결을 거슬러","kind":"lyric"},{"id":"22","start":84.36,"end":87.77,"text":"Waterways will join as one","translation":"물길은 하나로 만나","kind":"lyric"},{"id":"23","start":87.77,"end":91.236,"text":"Tracing to the source","translation":"근원을 따라가며","kind":"lyric"},{"id":"24","start":91.25,"end":93.54,"text":"No more strayed or lost","translation":"더는 헤매거나 길 잃지 않아","kind":"lyric"},{"id":"25","start":93.54,"end":97.116,"text":"You will see petals fly","translation":"꽃잎이 흩날리는 걸 보게 될 거야","kind":"lyric"},{"id":"26","start":97.116,"end":101.239774,"text":"When lament becomes carol","translation":"애도가 노래가 될 때","kind":"lyric"},{"id":"27","start":101.239774,"end":104.627,"text":"Could you please hear my voice","translation":"내 목소리를 들어줄래","kind":"lyric"},{"id":"28","start":104.627,"end":108.464,"text":"That hungers for a duo?","translation":"함께 부를 이를 갈망해","kind":"lyric"},{"id":"29","start":108.464,"end":112.321,"text":"Life blooms like a flower","translation":"삶은 꽃처럼 피어나","kind":"lyric"},{"id":"30","start":112.321,"end":116.627699,"text":"Far away or by the road","translation":"멀리서든 길가에서든","kind":"lyric"},{"id":"31","start":116.627699,"end":119.075778,"text":"Waiting for the one","translation":"그 한 사람을 기다려","kind":"lyric"},{"id":"32","start":119.075778,"end":122.603,"text":"To find the way back home","translation":"집으로 돌아갈 길을 찾게","kind":"lyric"},{"id":"33","start":122.603,"end":126.27,"text":"Time flows across the world","translation":"시간은 세상을 가로질러 흘러","kind":"lyric"},{"id":"34","start":126.27,"end":131.046,"text":"There is always a longer way to go","translation":"가야 할 길은 늘 더 멀어","kind":"lyric"},{"id":"35","start":131.046,"end":133.474,"text":"'Til I reach your arms","translation":"네 품에 닿을 때까지","kind":"lyric"},{"id":"36","start":133.474,"end":136.172,"text":"A madder there for you","translation":"너를 위한 꼭두서니가 있어","kind":"lyric"},{"id":"37","start":163.051,"end":166.628,"text":"Life blooms like a flower","translation":"삶은 꽃처럼 피어나","kind":"lyric"},{"id":"38","start":166.628,"end":170.325,"text":"Far away or by the road","translation":"멀리서든 길가에서든","kind":"lyric"},{"id":"39","start":170.325561,"end":173.702911,"text":"Waiting for the one","translation":"그 한 사람을 기다려","kind":"lyric"},{"id":"40","start":173.702911,"end":177.16,"text":"To find the way back home","translation":"집으로 돌아갈 길을 찾게","kind":"lyric"},{"id":"41","start":177.16,"end":180.737,"text":"Time flows across the world","translation":"시간은 세상을 가로질러 흘러","kind":"lyric"},{"id":"42","start":180.737,"end":185.13394,"text":"There is always a longer way to go","translation":"가야 할 길은 늘 더 멀어","kind":"lyric"},{"id":"43","start":185.13394,"end":187.831823,"text":"'Til I reach your arms","translation":"네 품에 닿을 때까지","kind":"lyric"},{"id":"44","start":187.831823,"end":192.688,"text":"A madder there for you","translation":"너를 위한 꼭두서니가 있어","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}