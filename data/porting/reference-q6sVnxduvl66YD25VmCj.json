{"title":"Happy","artist":"NeverShoutNever","sourceId":"reference:q6sVnxduvl66YD25VmCj","sourceHash":"0833d4febcdbe99798cda37ad8a978160f5182605ea83635b07e0287d85a6b19","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":0.51,"end":3.51,"text":"You make me happy, whether you know it or not","translation":"","kind":"lyric"},{"id":"2","start":4.47,"end":7.47,"text":"We should be happy, that's what I said from the start","translation":"","kind":"lyric"},{"id":"3","start":8.31,"end":11.31,"text":"I am so happy, knowing you are the one","translation":"","kind":"lyric"},{"id":"4","start":12.25,"end":15.25,"text":"That I want for the rest of my days","translation":"","kind":"lyric"},{"id":"5","start":17.14,"end":20.14,"text":"For the rest of my days","translation":"","kind":"lyric"},{"id":"6","start":21.65,"end":24.65,"text":"You're all of my days","translation":"","kind":"lyric"},{"id":"7","start":26.57,"end":28.57,"text":"You're lookin' so cool, you're lookin' so fly","translation":"","kind":"lyric"},{"id":"8","start":28.57,"end":30.94,"text":"I can't deny that when I'm staring","translation":"","kind":"lyric"},{"id":"9","start":30.94,"end":32.98,"text":"You down, right dead in the eye","translation":"","kind":"lyric"},{"id":"10","start":32.98,"end":35.37,"text":"I wanna try to be the person you want","translation":"","kind":"lyric"},{"id":"11","start":35.37,"end":36.38,"text":"The person you need","translation":"","kind":"lyric"},{"id":"12","start":36.38,"end":37.83,"text":"It's hard to conceive","translation":"","kind":"lyric"},{"id":"13","start":37.83,"end":40.83,"text":"That somebody like you could be with","translation":"","kind":"lyric"},{"id":"14","start":41.43,"end":44.28,"text":"Someone like me","translation":"","kind":"lyric"},{"id":"15","start":44.28,"end":47.28,"text":"I'm happy knowing that you are mine","translation":"","kind":"lyric"},{"id":"16","start":48.16,"end":51.16,"text":"The grass is greener on the other side","translation":"","kind":"lyric"},{"id":"17","start":52.12,"end":55.12,"text":"The more I think, the more I wish","translation":"","kind":"lyric"},{"id":"18","start":55.57,"end":58.57,"text":"That we could lay here for hours, and just-a reminisce","translation":"","kind":"lyric"},{"id":"19","start":59.42,"end":62.42,"text":"Uh, oh-oh","translation":"","kind":"lyric"},{"id":"20","start":63.96,"end":64.9,"text":"You're lookin' so fresh","translation":"","kind":"lyric"},{"id":"21","start":64.9,"end":66.07,"text":"It's catching my eye","translation":"","kind":"lyric"},{"id":"22","start":66.07,"end":68.84,"text":"Why, oh why, did I not see this before","translation":"","kind":"lyric"},{"id":"23","start":68.84,"end":71.26,"text":"The girl I adore was right in front of me?","translation":"","kind":"lyric"},{"id":"24","start":71.26,"end":74.26,"text":"And now I'll take a step back and look in your eye","translation":"","kind":"lyric"},{"id":"25","start":74.26,"end":77.26,"text":"And ask why it took so long to see","translation":"","kind":"lyric"},{"id":"26","start":78.61,"end":81.6,"text":"We're meant to be","translation":"","kind":"lyric"},{"id":"27","start":81.6,"end":84.6,"text":"I'm happy knowing that you are mine","translation":"","kind":"lyric"},{"id":"28","start":85.53,"end":88.53,"text":"The grass is greener on the other side","translation":"","kind":"lyric"},{"id":"29","start":89.42,"end":92.42,"text":"The more I think, the more I wish","translation":"","kind":"lyric"},{"id":"30","start":92.97,"end":95.97,"text":"That we could lay here for hours and just a reminisce","translation":"","kind":"lyric"},{"id":"31","start":97.02000000000001,"end":100.02000000000001,"text":"On the good, the bad, the ugly","translation":"","kind":"lyric"},{"id":"32","start":101.22999999999999,"end":104.22999999999999,"text":"The smiles, the laughs, the funny","translation":"","kind":"lyric"},{"id":"33","start":105.24000000000001,"end":108.24000000000001,"text":"Or all the things we put each other through","translation":"","kind":"lyric"},{"id":"34","start":110.22999999999999,"end":113.22999999999999,"text":"It's for you, for you, for you","translation":"","kind":"lyric"},{"id":"35","start":116.59,"end":119.59,"text":"You make me happy, whether you know it or not","translation":"","kind":"lyric"},{"id":"36","start":120.49,"end":123.49,"text":"We should be happy, that's what I said from the start","translation":"","kind":"lyric"},{"id":"37","start":124.49,"end":127.49,"text":"I am so happy, knowing you are the one","translation":"","kind":"lyric"},{"id":"38","start":128.26,"end":131.26,"text":"That I want for the rest of my days","translation":"","kind":"lyric"},{"id":"39","start":133.16,"end":136.16,"text":"For the rest of my days","translation":"","kind":"lyric"},{"id":"40","start":138.63,"end":141.63,"text":"I'm happy knowing that you are mine","translation":"","kind":"lyric"},{"id":"41","start":142.54,"end":145.54,"text":"The grass is greener on the other side","translation":"","kind":"lyric"},{"id":"42","start":146.54,"end":149.54,"text":"The more I think, the more I wish","translation":"","kind":"lyric"},{"id":"43","start":149.92000000000002,"end":152.92000000000002,"text":"That we could lay here for hours and just a reminisce","translation":"","kind":"lyric"},{"id":"44","start":153.97,"end":156.97,"text":"Uh, oh-oh","translation":"","kind":"lyric"}],"candidates":[]}