"end":131.26,"text":"人が 人が 足りない","translation":"","kind":"lyric"},{"id":"19","start":131.26,"end":137.57,"text":"クラスの誰にも負けないキレイないい子でしょう（ねえ）","translation":"","kind":"lyric"},{"id":"20","start":137.57,"end":140.41,"text":"あの子よりもどの子よりも","translation":"","kind":"lyric"},{"id":"21","start":140.41,"end":143.98,"text":"誰も彼も私を見てよ","translation":"","kind":"lyric"},{"id":"22","start":143.98,"end":149.95,"text":"体育館裏 あなたに告白を","translation":"","kind":"lyric"},{"id":"23","start":149.95,"end":152.81,"text":"嘘みたいでしょ","translation":"","kind":"lyric"},{"id":"24","start":152.81,"end":159.43,"text":"あなたが好きなの 汚いあなたが","translation":"","kind":"lyric"},{"id":"25","start":159.43,"end":163.91,"text":"愛して 愛して 愛して","translation":"","kind":"lyric"},{"id":"26","start":163.91,"end":171.97,"text":"全部あげる あなたに あなたに 全部背負ってもらうよ","translation":"","kind":"lyric"},{"id":"27","start":171.97,"end":184.29,"text":"足りない あなたが 足りない 離さないよ 嗚呼 ごめんなさい","translation":"","kind":"lyric"},{"id":"28","start":184.29,"end":189.19,"text":"愛して 愛して 愛して","translation":"","kind":"lyric"},{"id":"29","start":189.19,"end":196.99,"text":"もっともっと 愛して 愛して 狂おしいほどに","translation":"","kind":"lyric"},{"id":"30","start":196.99,"end":231.42000000000002,"text":"苦しい 離さない 苦しい もっともっと ねえ 幸せなの 嗚呼","translation":"","kind":"lyric"},{"id":"31","start":231.42000000000002,"end":243.63,"text":"幸せなの 嗚呼","translation":"","kind":"lyric"}],"candidates":[]}