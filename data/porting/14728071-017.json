{"title":"아이돌","artist":"YOASOBI","date":"2026-08-16","sourceId":"14728071:017","sourceHash":"893ba8dd048841e3f4f982f15d3de37a8b1810791aab0b00bb6ec19e17721f86","duration":219.8,"cues":[{"id":"1","start":6.0,"end":8.58,"text":"無敵の笑顔で荒らすメディア","translation":"무적의 미소로 미디어를 휩쓸어","kind":"lyric"},{"id":"2","start":8.58,"end":11.46,"text":"知りたいその秘密ミステリアス","translation":"알고 싶은 그 비밀은 미스터리","kind":"lyric"},{"id":"3","start":11.52,"end":14.78,"text":"抜けてるとこさえ彼女のエリア","translation":"허술한 구석마저 그녀의 영역","kind":"lyric"},{"id":"4","start":14.84,"end":17.18,"text":"完璧で嘘つきな君は","translation":"완벽하면서 거짓말쟁이인 너는","kind":"lyric"},{"id":"5","start":17.24,"end":19.92,"text":"天才的なアイドル様","translation":"천재적인 아이돌님","kind":"lyric"},{"id":"6","start":20.1,"end":22.08,"text":"(You're my savior, my saving grace)","translation":"넌 나의 구원자 나의 구원의 은총","kind":"lyric"},{"id":"7","start":22.08,"end":24.16,"text":"今日何食べた？","translation":"오늘 뭐 먹었어","kind":"lyric"},{"id":"8","start":24.22,"end":25.66,"text":"好きな本は？","translation":"좋아하는 책은","kind":"lyric"},{"id":"9","start":25.72,"end":28.58,"text":"遊びに行くならどこに行くの？","translation":"놀러 간다면 어디로 가","kind":"lyric"},{"id":"10","start":28.58,"end":29.96,"text":"何も食べてない","translation":"아무것도 안 먹었어","kind":"lyric"},{"id":"11","start":29.96,"end":31.38,"text":"それは内緒","translation":"그건 비밀이야","kind":"lyric"},{"id":"12","start":31.38,"end":34.18,"text":"何を聞かれても のらりくらり","translation":"뭘 물어봐도 요리조리","kind":"lyric"},{"id":"13","start":34.18,"end":35.56,"text":"そう 淡々と","translation":"그래 담담하게","kind":"lyric"},{"id":"14","start":35.56,"end":36.98,"text":"だけど燦々と","translation":"하지만 찬란하게","kind":"lyric"},{"id":"15","start":36.98,"end":39.9,"text":"見えそうで見えない秘密は蜜の味","translation":"보일 듯 보이지 않는 비밀은 꿀맛","kind":"lyric"},{"id":"16","start":39.9,"end":41.652,"text":"あれもないないない","translation":"저것도 없어 없어 없어","kind":"lyric"},{"id":"17","start":41.652,"end":43.02,"text":"これもないないない","translation":"이것도 없어 없어 없어","kind":"lyric"},{"id":"18","start":43.02,"end":43.94,"text":"好きなタイプは？","translation":"좋아하는 타입은","kind":"lyric"},{"id":"19","start":43.94,"end":45.04,"text":"相手は？","translation":"상대는","kind":"lyric"},{"id":"20","start":45.04,"end":46.277,"text":"さあ 答えて","translation":"자 대답해","kind":"lyric"},{"id":"21","start":46.277,"end":51.6,"text":"「誰かを好きになることなんて私分からなくてさ」","translation":"누군가를 좋아한다는 건 난 모르겠어서 말이야","kind":"lyric"},{"id":"22","start":51.6,"end":54.24,"text":"嘘か本当か知り得ない","translation":"거짓인지 진실인지 알 길 없어","kind":"lyric"},{"id":"23","start":54.24,"end":57.9,"text":"そんな言葉にまた一人堕ちる","translation":"그런 말에 또 한 사람이 빠져","kind":"lyric"},{"id":"24","start":57.9,"end":60.36,"text":"また好きにさせる","translation":"또 좋아하게 만들어","kind":"lyric"},{"id":"25","start":60.36,"end":62.86,"text":"誰もが目を奪われてく","translation":"누구나 넋을 잃어 가","kind":"lyric"},{"id":"26","start":62.86,"end":67.64,"text":"君は完璧で究極のアイドル","translation":"넌 완벽하고 궁극적인 아이돌","kind":"lyric"},{"id":"27","start":67.64,"end":68.74,"text":"金輪際現れない","translation":"앞으로 두 번 다시 나타나지 않을","kind":"lyric"},{"id":"28","start":68.74,"end":71.76,"text":"一番星の生まれ変わり あぁ","translation":"가장 빛나는 별의 환생 아아","kind":"lyric"},{"id":"29","start":71.76,"end":73.74,"text":"その笑顔で","translation":"그 미소로","kind":"lyric"},{"id":"30","start":73.74,"end":75.22,"text":"愛してるで","translation":"사랑해라는 말로","kind":"lyric"},{"id":"31","start":75.22,"end":78.02,"text":"誰も彼も虜にしていく","translation":"누구든 사로잡아 가","kind":"lyric"},{"id":"32","start":78.02,"end":79.5,"text":"その瞳が","translation":"그 눈동자가","kind":"lyric"},{"id":"33","start":79.5,"end":81.54,"text":"その言葉が","translation":"그 말들이","kind":"lyric"},{"id":"34","start":81.54,"end":83.68,"text":"嘘でも それは完全なアイ","translation":"거짓이어도 그건 완전한 아이","kind":"lyric"},{"id":"35","start":84.16,"end":86.96,"text":"はいはい あの子は特別です","translation":"그래 그래 저 애는 특별하죠","kind":"lyric"},{"id":"36","start":87.04,"end":89.26,"text":"我々はハナからおまけです","translation":"우리는 애초부터 덤이죠","kind":"lyric"},{"id":"37","start":89.26,"end":93.18,"text":"お星さまの引き立て役Bです","translation":"별님을 돋보이게 하는 조연 B죠","kind":"lyric"},{"id":"38","start":93.18,"end":95.6,"text":"全てがあの子のお陰なわけない","translation":"모든 게 저 애 덕분일 리 없어","kind":"lyric"},{"id":"39","start":95.6,"end":96.56,"text":"洒落臭い","translation":"같잖아","kind":"lyric"},{"id":"40","start":96.62,"end":98.58,"text":"妬み 嫉妬なんてないわけがない","translation":"부러움 질투가 없을 리 없어","kind":"lyric"},{"id":"41","start":98.64,"end":99.58,"text":"これはネタじゃない","translation":"이건 농담이 아니야","kind":"lyric"},{"id":"42","start":99.62,"end":100.64,"text":"からこそ許せない","translation":"그렇기에 용서 못 해","kind":"lyric"},{"id":"43","start":100.64,"end":102.76,"text":"完璧じゃない君じゃ許せない","translation":"완벽하지 않은 너라면 용서 못 해","kind":"lyric"},{"id":"44","start":102.76,"end":103.88,"text":"自分を許せない","translation":"나 자신을 용서 못 해","kind":"lyric"},{"id":"45","start":103.88,"end":106.42,"text":"誰よりも強い君以外は認めない","translation":"누구보다 강한 너 말고는 인정 못 해","kind":"lyric"},{"id":"46","start":106.42,"end":109.1,"text":"誰もが信じ崇めてる","translation":"누구나 믿고 떠받들어","kind":"lyric"},{"id":"47","start":109.1,"end":112.6,"text":"まさに最強で無敵のアイドル","translation":"그야말로 최강 무적의 아이돌","kind":"lyric"},{"id":"48","start":112.6,"end":115.141,"text":"弱点なんて見当たらない","translation":"약점 따윈 보이지 않아","kind":"lyric"},{"id":"49","start":115.141,"end":118.06,"text":"一番星を宿してる","translation":"가장 빛나는 별을 품고 있어","kind":"lyric"},{"id":"50","start":118.52,"end":121.26,"text":"弱いとこなんて見せちゃダメダメ","translation":"약한 모습 따윈 보이면 안 돼 안 돼","kind":"lyric"},{"id":"51","start":121.26,"end":125.26,"text":"知りたくないとこは見せずに","translation":"알고 싶지 않은 모습은 보이지 말고","kind":"lyric"},{"id":"52","start":125.26,"end":126.24,"text":"唯一無二じゃなくちゃイヤイヤ","translation":"유일무이가 아니면 싫어 싫어","kind":"lyric"},{"id":"53","start":126.24,"end":130.14,"text":"それこそ本物のアイ","translation":"그게 진짜 아이","kind":"lyric"},{"id":"54","start":130.58,"end":133.04,"text":"得意の笑顔で沸かすメディア","translation":"특기인 미소로 들끓게 하는 미디어","kind":"lyric"},{"id":"55","start":133.04,"end":136.4,"text":"隠しきる この秘密だけは","translation":"끝까지 숨겨 내 이 비밀만은","kind":"lyric"},{"id":"56","start":136.4,"end":140.52,"text":"愛してるって嘘で積むキャリア","translation":"사랑해라는 거짓으로 쌓은 경력","kind":"lyric"},{"id":"57","start":140.52,"end":142.54,"text":"これこそ私なりの愛だ","translation":"이것이 나만의 사랑이야","kind":"lyric"},{"id":"58","start":142.54,"end":145.86,"text":"流れる汗も綺麗なアクア","translation":"흐르는 땀도 맑은 아쿠아","kind":"lyric"},{"id":"59","start":145.86,"end":149.1,"text":"ルビーを隠したこの瞼","translation":"루비를 감춘 이 눈꺼풀","kind":"lyric"},{"id":"60","start":149.1,"end":152.64,"text":"歌い 踊り 舞う私はマリア","translation":"노래하고 춤추며 날아오르는 나는 마리아","kind":"lyric"},{"id":"61","start":152.86,"end":155.82,"text":"そう 嘘はとびきりの愛だ","translation":"그래 거짓말은 가장 특별한 사랑이야","kind":"lyric"},{"id":"62","start":156.58,"end":159.76,"text":"誰かに愛されたことも","translation":"누군가에게 사랑받은 적도","kind":"lyric"},{"id":"63","start":159.84,"end":163.26,"text":"誰かのこと愛したこともない","translation":"누군가를 사랑한 적도 없어","kind":"lyric"},{"id":"64","start":163.32,"end":168.7,"text":"そんな私の嘘がいつか本当になること","translation":"그런 내 거짓말이 언젠가 진실이 되기를","kind":"lyric"},{"id":"65","start":168.76,"end":170.16,"text":"（信じてる）","translation":"믿고 있어","kind":"lyric"},{"id":"66","start":170.16,"end":173.34,"text":"いつかきっと全部手に入れる","translation":"언젠가 반드시 전부 손에 넣을 거야","kind":"lyric"},{"id":"67","start":173.34,"end":176.78,"text":"私はそう 欲張りなアイドル","translation":"나는 그래 욕심 많은 아이돌","kind":"lyric"},{"id":"68","start":176.78,"end":179.0,"text":"等身大でみんなのこと","translation":"있는 그대로 모두를","kind":"lyric"},{"id":"69","start":179.06,"end":181.94,"text":"ちゃんと愛したいから","translation":"제대로 사랑하고 싶으니까","kind":"lyric"},{"id":"70","start":182.0,"end":183.94,"text":"今日も嘘をつくの","translation":"오늘도 거짓말을 해","kind":"lyric"},{"id":"71","start":183.94,"end":188.5,"text":"この言葉がいつか本当になる日を願って","translation":"이 말이 언젠가 진실이 될 날을 바라며","kind":"lyric"},{"id":"72","start":188.5,"end":194.32,"text":"それでもまだ君と君にだけは言えずにいたけど","translation":"그래도 아직 너와 너에게만은 말하지 못했지만","kind":"lyric"},{"id":"73","start":194.34,"end":195.48,"text":"あぁ やっと言えた","translation":"아아 드디어 말했어","kind":"lyric"},{"id":"74","start":195.48,"end":198.32,"text":"これは絶対嘘じゃない","translation":"이건 절대 거짓말이 아니야","kind":"lyric"},{"id":"75","start":198.32,"end":199.68,"text":"愛してる","translation":"사랑해","kind":"lyric"},{"id":"76","start":211.42,"end":216.14,"text":"(You're my savior, my true savior, my saving grace)","translation":"넌 나의 구원자 나의 참된 구원자 나의 구원의 은총","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}