{"title":"Do You Want to Build a Snowman","artist":"Frozen","sourceId":"reference:Ub3RsJVH5vCaJFS2Ag73","sourceHash":"45b26dfba843f7332b8cf777b85cc6730718e1877e456d55474fd1a71ee2d0dc","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":3.38,"end":6.38,"text":"Elsa?","translation":"","kind":"lyric"},{"id":"2","start":7.05,"end":10.05,"text":"Do you wanna build a snowman?","translation":"","kind":"lyric"},{"id":"3","start":10.43,"end":13.43,"text":"Come on let's go and play","translation":"","kind":"lyric"},{"id":"4","start":13.73,"end":15.98,"text":"I never see you any more","translation":"","kind":"lyric"},{"id":"5","start":15.98,"end":17.15,"text":"Come out the door","translation":"","kind":"lyric"},{"id":"6","start":17.15,"end":20.15,"text":"It's like you've gone away!","translation":"","kind":"lyric"},{"id":"7","start":20.25,"end":22.67,"text":"We used to be best buddies","translation":"","kind":"lyric"},{"id":"8","start":22.67,"end":24.32,"text":"And now we're not","translation":"","kind":"lyric"},{"id":"9","start":24.32,"end":27.32,"text":"I wish you would tell me why","translation":"","kind":"lyric"},{"id":"10","start":28.21,"end":31.21,"text":"Do you wanna build a snowman?","translation":"","kind":"lyric"},{"id":"11","start":31.21,"end":33.24,"text":"It doesn't have to be a snowman","translation":"","kind":"lyric"},{"id":"12","start":33.24,"end":35.76,"text":"(Go away, Anna!)","translation":"","kind":"lyric"},{"id":"13","start":35.76,"end":38.76,"text":"Okay, bye","translation":"","kind":"lyric"},{"id":"14","start":54.82,"end":57.72,"text":"Do you wanna build a snowman?","translation":"","kind":"lyric"},{"id":"15","start":57.72,"end":60.72,"text":"Or ride our bike around the halls?","translation":"","kind":"lyric"},{"id":"16","start":60.83,"end":63.11,"text":"I think some company is overdue","translation":"","kind":"lyric"},{"id":"17","start":63.11,"end":66.11,"text":"I've started talking to the pictures on the walls!","translation":"","kind":"lyric"},{"id":"18","start":66.17,"end":67.22,"text":"Hang in there, Joan!","translation":"","kind":"lyric"},{"id":"19","start":67.22,"end":69.23,"text":"It gets a little lonely","translation":"","kind":"lyric"},{"id":"20","start":69.23,"end":70.93,"text":"All these empty rooms","translation":"","kind":"lyric"},{"id":"21","start":70.93,"end":73.93,"text":"Just watching the hours tick by","translation":"","kind":"lyric"},{"id":"22","start":143.48,"end":145.35,"text":"Elsa?","translation":"","kind":"lyric"},{"id":"23","start":145.35,"end":148.35,"text":"Please, I know you're in there","translation":"","kind":"lyric"},{"id":"24","start":149.0,"end":152.0,"text":"People are asking where you've been","translation":"","kind":"lyric"},{"id":"25","start":153.04,"end":156.04,"text":"They say, \"Have courage\", and I'm trying to","translation":"","kind":"lyric"},{"id":"26","start":156.59,"end":158.57,"text":"I'm right out here for you","translation":"","kind":"lyric"},{"id":"27","start":158.57,"end":161.57,"text":"Just let me in","translation":"","kind":"lyric"},{"id":"28","start":161.78,"end":164.18,"text":"We only have each other","translation":"","kind":"lyric"},{"id":"29","start":164.18,"end":166.5,"text":"It's just you and me","translation":"","kind":"lyric"},{"id":"30","start":166.5,"end":169.5,"text":"What are we gonna do?","translation":"","kind":"lyric"},{"id":"31","start":174.53,"end":177.53,"text":"Do you wanna build a snowman?","translation":"","kind":"lyric"}],"candidates":[]}