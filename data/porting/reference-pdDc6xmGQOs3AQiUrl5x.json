{"title":"생명에게 미움받고 있어","artist":"칸자키이오리","sourceId":"reference:pdDc6xmGQOs3AQiUrl5x","sourceHash":"4868a254b5a26607ffe5d3da5384b6fedc1d36b40c3ef0be63ee30db29960878","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":20550996,"cues":[{"id":"1","start":20.19,"end":22.06,"text":"「死にたいなんて言うなよ」","translation":"","kind":"lyric"},{"id":"2","start":22.06,"end":24.48,"text":"「諦めないで生きろよ」","translation":"","kind":"lyric"},{"id":"3","start":24.48,"end":28.77,"text":"そんな歌が正しいなんて馬鹿げてるよな","translation":"","kind":"lyric"},{"id":"4","start":28.77,"end":31.62,"text":"実際自分は死んでもよくて","translation":"","kind":"lyric"},{"id":"5","start":31.62,"end":33.92,"text":"周りが死んだら悲しくて","translation":"","kind":"lyric"},{"id":"6","start":33.92,"end":39.07,"text":"「それが嫌だから」っていうエゴなんです","translation":"","kind":"lyric"},{"id":"7","start":39.07,"end":41.36,"text":"他人が生きてもどうでもよくて","translation":"","kind":"lyric"},{"id":"8","start":41.36,"end":43.74,"text":"誰かを嫌うこともファッションで","translation":"","kind":"lyric"},{"id":"9","start":43.74,"end":46.26,"text":"それでも「平和に生きよう」なんて","translation":"","kind":"lyric"},{"id":"10","start":46.26,"end":48.51,"text":"素敵なことでしょう","translation":"","kind":"lyric"},{"id":"11","start":48.51,"end":51.06,"text":"画面の先では誰かが死んで","translation":"","kind":"lyric"},{"id":"12","start":51.06,"end":53.38,"text":"それを嘆いて誰かが歌って","translation":"","kind":"lyric"},{"id":"13","start":53.38,"end":57.86,"text":"それに感化された少年がナイフを持って走った","translation":"","kind":"lyric"},{"id":"14","start":57.86,"end":60.25,"text":"僕らは命に嫌われている","translation":"","kind":"lyric"},{"id":"15","start":60.25,"end":62.63,"text":"価値観もエゴも押し付けて","translation":"","kind":"lyric"},{"id":"16","start":62.63,"end":65.24,"text":"いつも誰かを殺したい歌を","translation":"","kind":"lyric"},{"id":"17","start":65.24,"end":67.01,"text":"簡単に電波で流した","translation":"","kind":"lyric"},{"id":"18","start":67.01,"end":69.98,"text":"僕らは命に嫌われている","translation":"","kind":"lyric"},{"id":"19","start":69.98,"end":72.34,"text":"軽々しく死にたいだとか","translation":"","kind":"lyric"},{"id":"20","start":72.34,"end":86.99,"text":"軽々しく命を見てる 僕らは命に嫌われている","translation":"","kind":"lyric"},{"id":"21","start":86.99,"end":91.83,"text":"お金がないので今日も 一日中惰眠を謳歌する","translation":"","kind":"lyric"},{"id":"22","start":91.83,"end":94.28,"text":"生きる意味なんて見出せず","translation":"","kind":"lyric"},{"id":"23","start":94.28,"end":96.61,"text":"無駄を自覚して息をする","translation":"","kind":"lyric"},{"id":"24","start":96.61,"end":101.25999999999999,"text":"「寂しい」なんて言葉でこの傷が表せていいものか","translation":"","kind":"lyric"},{"id":"25","start":101.25999999999999,"end":106.05,"text":"そんな意地ばかり抱え今日も一人ベッドに眠る","translation":"","kind":"lyric"},{"id":"26","start":106.05,"end":110.96000000000001,"text":"少年だった僕たちはいつか青年に変わっていく","translation":"","kind":"lyric"},{"id":"27","start":110.96000000000001,"end":113.32,"text":"年老いていつか枯れ葉のように","translation":"","kind":"lyric"},{"id":"28","start":113.32,"end":115.75,"text":"誰にも知られず朽ちていく","translation":"","kind":"lyric"},{"id":"29","start":115.75,"end":118.22999999999999,"text":"不死身の身体を手に入れて","translation":"","kind":"lyric"},{"id":"30","start":118.22999999999999,"end":120.52,"text":"一生死なずに生きていく","translation":"","kind":"lyric"},{"id":"31","start":120.52,"end":125.34,"text":"そんなSFを妄想してる","translation":"","kind":"lyric"},{"id":"32","start":125.34,"end":127.7,"text":"自分が死んでもどうでもよくて","translation":"","kind":"lyric"},{"id":"33","start":127.7,"end":130.1,"text":"それでも周りに生きて欲しくて","translation":"","kind":"lyric"},{"id":"34","start":130.1,"end":135.11,"text":"矛盾を抱えて生きてくなんて怒られてしまう","translation":"","kind":"lyric"},{"id":"35","start":135.11,"end":137.52,"text":"「正しいものは正しくいなさい」","translation":"","kind":"lyric"},{"id":"36","start":137.52,"end":139.73,"text":"「死にたくないなら生きていなさい」","translation":"","kind":"lyric"},{"id":"37","start":139.73,"end":142.19,"text":"悲しくなるならそれでもいいなら","translation":"","kind":"lyric"},{"id":"38","start":142.19,"end":144.48,"text":"ずっと一人で笑えよ","translation":"","kind":"lyric"},{"id":"39","start":144.48,"end":146.77,"text":"僕らは命に嫌われている","translation":"","kind":"lyric"},{"id":"40","start":146.77,"end":149.26,"text":"幸福の意味すらわからず","translation":"","kind":"lyric"},{"id":"41","start":149.26,"end":151.5,"text":"産まれた環境ばかり憎んで","translation":"","kind":"lyric"},{"id":"42","start":151.5,"end":153.82999999999998,"text":"簡単に過去ばかり呪う","translation":"","kind":"lyric"},{"id":"43","start":153.82999999999998,"end":156.54,"text":"僕らは命に嫌われている","translation":"","kind":"lyric"},{"id":"44","start":156.54,"end":158.66,"text":"さよならばかりが好きすぎて","translation":"","kind":"lyric"},{"id":"45","start":158.66,"end":173.19,"text":"本当の別れなど知らない 僕らは命に嫌われている","translation":"","kind":"lyric"},{"id":"46","start":173.19,"end":178.07999999999998,"text":"幸福も別れも愛情も友情も","translation":"","kind":"lyric"},{"id":"47","start":178.07999999999998,"end":183.2,"text":"滑稽な夢の戯れで全部カネで買える代物","translation":"","kind":"lyric"},{"id":"48","start":183.2,"end":185.79,"text":"明日死んでしまうかもしれない","translation":"","kind":"lyric"},{"id":"49","start":185.79,"end":187.86,"text":"すべて無駄になるかもしれない","translation":"","kind":"lyric"},{"id":"50","start":187.86,"end":190.24,"text":"朝も 夜も 春も 秋も","translation":"","kind":"lyric"},{"id":"51","start":190.24,"end":192.59,"text":"変わらず誰かがどこかで死ぬ","translation":"","kind":"lyric"},{"id":"52","start":192.59,"end":195.09,"text":"夢も明日も何もいらない","translation":"","kind":"lyric"},{"id":"53","start":195.09,"end":197.43,"text":"君が生きていたならそれでいい","translation":"","kind":"lyric"},{"id":"54","start":197.43,"end":202.4,"text":"そうだ 本当はそういうことが歌いたい","translation":"","kind":"lyric"},{"id":"55","start":202.4,"end":204.56,"text":"命に嫌われている","translation":"","kind":"lyric"},{"id":"56","start":204.56,"end":206.89,"text":"結局いつかは死んでいく","translation":"","kind":"lyric"},{"id":"57","start":206.89,"end":211.67000000000002,"text":"君だって僕だっていつかは枯れ葉のように朽ちてく","translation":"","kind":"lyric"},{"id":"58","start":211.67000000000002,"end":213.99,"text":"それでも僕らは必死に生きて","translation":"","kind":"lyric"},{"id":"59","start":213.99,"end":216.54,"text":"命を必死に抱えて生きて","translation":"","kind":"lyric"},{"id":"60","start":216.54,"end":219.0,"text":"殺して あがいて 笑って 抱えて","translation":"","kind":"lyric"},{"id":"61","start":219.0,"end":223.91,"text":"生きて 生きて 生きて 生きて 生きろ","translation":"","kind":"lyric"}],"candidates":[]}