{"title":"FPS","artist":"마후마후","sourceId":"reference:r93JuB3CGo8UPpq9R0QO","sourceHash":"5570feb81bca694da439ed57c0446d8acf8f98052ee3c04848ec5821f0d21856","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":20.03,"end":23.03,"text":"超常現象 天地崩壊のサバイバー スナイパー","translation":"","kind":"lyric"},{"id":"2","start":24.27,"end":26.86,"text":"集う群衆 上空 短期決戦だ","translation":"","kind":"lyric"},{"id":"3","start":26.86,"end":28.95,"text":"「このドア開かない」","translation":"","kind":"lyric"},{"id":"4","start":28.95,"end":31.95,"text":"AR 散弾銃で撃ち抜いて 索敵 クリアリング","translation":"","kind":"lyric"},{"id":"5","start":33.73,"end":36.73,"text":"これが正真正銘強者決定戦","translation":"","kind":"lyric"},{"id":"6","start":36.95,"end":38.74,"text":"「待って銃がリロードしない」","translation":"","kind":"lyric"},{"id":"7","start":38.74,"end":41.6,"text":"現実境界縮小（ぱん！ぱん！）","translation":"","kind":"lyric"},{"id":"8","start":41.6,"end":43.86,"text":"不健康が４倍スコ（ぱん！ぱん！）","translation":"","kind":"lyric"},{"id":"9","start":43.86,"end":45.97,"text":"腰痛用でしょ包帯（ぱん！ぱん！）","translation":"","kind":"lyric"},{"id":"10","start":45.97,"end":46.91,"text":"「くっ...！敵に囲まれた！」","translation":"","kind":"lyric"},{"id":"11","start":46.91,"end":47.78,"text":"「俺が全て撃ち抜く！」","translation":"","kind":"lyric"},{"id":"12","start":47.78,"end":50.45,"text":"駆け抜けろ 泥だらけになって","translation":"","kind":"lyric"},{"id":"13","start":50.45,"end":53.31,"text":"ヘッドショット寸前の人生","translation":"","kind":"lyric"},{"id":"14","start":53.31,"end":55.33,"text":"この傷も この絶望だって","translation":"","kind":"lyric"},{"id":"15","start":55.33,"end":58.01,"text":"ともに生きて来たんだよ","translation":"","kind":"lyric"},{"id":"16","start":58.01,"end":60.37,"text":"手を挙げろ すでに捉えてんだ","translation":"","kind":"lyric"},{"id":"17","start":60.37,"end":62.79,"text":"その額も その未来も","translation":"","kind":"lyric"},{"id":"18","start":62.79,"end":65.78999999999999,"text":"全て撃ち抜いて FPS","translation":"","kind":"lyric"},{"id":"19","start":74.99,"end":76.28999999999999,"text":"ノーキルノーライフ","translation":"","kind":"lyric"},{"id":"20","start":76.28999999999999,"end":78.62,"text":"ちょっと物騒な武装が似合いだ","translation":"","kind":"lyric"},{"id":"21","start":78.62,"end":81.62,"text":"もはや単純明快 do or dieなんだ","translation":"","kind":"lyric"},{"id":"22","start":91.23,"end":93.88,"text":"この未来に答えなどない","translation":"","kind":"lyric"},{"id":"23","start":93.88,"end":96.75,"text":"ぶっちゃけ高所恐怖症（きょうふしょう！）","translation":"","kind":"lyric"},{"id":"24","start":96.75,"end":98.64,"text":"人生回線不安定（どうしよう！）","translation":"","kind":"lyric"},{"id":"25","start":98.64,"end":101.5,"text":"１００人も知り合いいねぇ（どうしよう！？）","translation":"","kind":"lyric"},{"id":"26","start":101.5,"end":102.59,"text":"「一気にいくぜ！」","translation":"","kind":"lyric"},{"id":"27","start":102.59,"end":103.22,"text":"「あとは任せましたー！」","translation":"","kind":"lyric"},{"id":"28","start":103.22,"end":104.97999999999999,"text":"ひざまずけ 下々の世界よ","translation":"","kind":"lyric"},{"id":"29","start":104.97999999999999,"end":107.97999999999999,"text":"この威厳に震えちゃいねえか","translation":"","kind":"lyric"},{"id":"30","start":108.45,"end":110.22,"text":"その夢も その心臓だって","translation":"","kind":"lyric"},{"id":"31","start":110.22,"end":113.22,"text":"俺の右手次第だぞ","translation":"","kind":"lyric"},{"id":"32","start":132.11,"end":135.11,"text":"ホント役に立たねえな ごめんなさいー 喧嘩してる場合か","translation":"","kind":"lyric"},{"id":"33","start":135.92,"end":138.92,"text":"残りあと4人 高地と同じ数だ","translation":"","kind":"lyric"},{"id":"34","start":139.2,"end":141.07,"text":"敵に見つかってる 伏せろ！","translation":"","kind":"lyric"},{"id":"35","start":141.07,"end":143.55,"text":"腹を合わせてやるしかない 見つけたぞ！","translation":"","kind":"lyric"},{"id":"36","start":143.55,"end":145.24,"text":"サクバは右 サグレバは左！","translation":"","kind":"lyric"},{"id":"37","start":145.24,"end":148.24,"text":"マクは俺と一緒に来い！よっしゃー！","translation":"","kind":"lyric"},{"id":"38","start":149.81,"end":151.65,"text":"駆け抜けろ 泥だらけになって","translation":"","kind":"lyric"},{"id":"39","start":151.65,"end":154.0,"text":"ヘッドショット寸前の人生","translation":"","kind":"lyric"},{"id":"40","start":154.0,"end":156.38,"text":"擦りむいて ズタボロに転んで","translation":"","kind":"lyric"},{"id":"41","start":156.38,"end":159.06,"text":"君と生きていたいんだよ","translation":"","kind":"lyric"},{"id":"42","start":159.06,"end":161.18,"text":"ボクの背はどの戦場だって","translation":"","kind":"lyric"},{"id":"43","start":161.18,"end":163.45,"text":"君にだったら預けれる","translation":"","kind":"lyric"},{"id":"44","start":163.45,"end":166.18,"text":"全て撃ち抜いて FPS","translation":"","kind":"lyric"},{"id":"45","start":166.18,"end":169.18,"text":"最終戦だ!!!","translation":"","kind":"lyric"}],"candidates":[]}