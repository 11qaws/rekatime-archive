{"title":"Mela!","artist":"녹황색사회","sourceId":"reference:QFkrdyOAkcnmqN15h9uo","sourceHash":"1d8f44a5f7264b42ca3df2f49657282c4cc8550fbfda135f6fedf2987f3ed534","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":21601140,"cues":[{"id":"1","start":0.63,"end":2.21,"text":"今なんじゃない?","translation":"","kind":"lyric"},{"id":"2","start":2.21,"end":4.09,"text":"メラメラとたぎれ","translation":"","kind":"lyric"},{"id":"3","start":4.09,"end":7.37,"text":"眠っているだけの正義","translation":"","kind":"lyric"},{"id":"4","start":7.37,"end":15.35,"text":"こんな僕も君のヒーローになりたいのさ (ooh whoa)","translation":"","kind":"lyric"},{"id":"5","start":15.35,"end":17.87,"text":"La la la, la la la","translation":"","kind":"lyric"},{"id":"6","start":17.87,"end":21.42,"text":"La la la la, la la la, la la la","translation":"","kind":"lyric"},{"id":"7","start":21.42,"end":24.88,"text":"La la la, la la la, la la la","translation":"","kind":"lyric"},{"id":"8","start":24.88,"end":29.23,"text":"La la la la, la la la, la la la","translation":"","kind":"lyric"},{"id":"9","start":29.23,"end":36.14,"text":"かっこいい君には 僕じゃ頼りないのかなんて","translation":"","kind":"lyric"},{"id":"10","start":36.14,"end":43.14,"text":"そりゃそうだよな だって今もこうして迷ってる","translation":"","kind":"lyric"},{"id":"11","start":43.14,"end":46.51,"text":"(La la la, la la la) 手を取ってくれないか","translation":"","kind":"lyric"},{"id":"12","start":46.51,"end":50.05,"text":"(La la la, la la la) ギブとテイクさ","translation":"","kind":"lyric"},{"id":"13","start":50.05,"end":56.41,"text":"(La la la, la la la) 君が僕のヒーローだったように","translation":"","kind":"lyric"},{"id":"14","start":56.41,"end":57.9,"text":"今なんじゃない?","translation":"","kind":"lyric"},{"id":"15","start":57.9,"end":59.78,"text":"メラメラとたぎる","translation":"","kind":"lyric"},{"id":"16","start":59.78,"end":63.32,"text":"こんな僕にも潜む正義が","translation":"","kind":"lyric"},{"id":"17","start":63.32,"end":66.73,"text":"どうしようもない衝動に駆られて","translation":"","kind":"lyric"},{"id":"18","start":66.73,"end":70.23,"text":"ほら気付けば手を握っている","translation":"","kind":"lyric"},{"id":"19","start":70.23,"end":71.51,"text":"いったいぜんたい","translation":"","kind":"lyric"},{"id":"20","start":71.51,"end":77.01,"text":"そんなに荷物を背負い込んでどこへ行くの","translation":"","kind":"lyric"},{"id":"21","start":77.01,"end":84.86,"text":"ねえねえ待って僕にちょっと預けてみては?","translation":"","kind":"lyric"},{"id":"22","start":98.72999999999999,"end":102.14,"text":"信じてばかりの僕と","translation":"","kind":"lyric"},{"id":"23","start":102.14,"end":105.68,"text":"信じることが怖い君と","translation":"","kind":"lyric"},{"id":"24","start":105.68,"end":109.18,"text":"どちらが正しいのかなんて","translation":"","kind":"lyric"},{"id":"25","start":109.18,"end":112.72,"text":"誰にも分からないさ","translation":"","kind":"lyric"},{"id":"26","start":112.72,"end":116.3,"text":"(La la la, la la la) 僕らだけの世界","translation":"","kind":"lyric"},{"id":"27","start":116.3,"end":119.67,"text":"(La la la, la la la) ギブとテイクさ","translation":"","kind":"lyric"},{"id":"28","start":119.67,"end":130.3,"text":"(La la la, la la la) 補い合えた暁には同じ夢を見たい","translation":"","kind":"lyric"},{"id":"29","start":141.15,"end":145.43,"text":"君はかっこいいと苦しめて","translation":"","kind":"lyric"},{"id":"30","start":145.43,"end":148.59,"text":"ひとりぼっちにさせたのは","translation":"","kind":"lyric"},{"id":"31","start":148.59,"end":155.2,"text":"少し僕のせいなんだよな ごめんね","translation":"","kind":"lyric"},{"id":"32","start":155.2,"end":158.91,"text":"だけど見るべきはリアルだ","translation":"","kind":"lyric"},{"id":"33","start":158.91,"end":162.84,"text":"今こそ僕が救けるんだ","translation":"","kind":"lyric"},{"id":"34","start":162.84,"end":170.14,"text":"抱えないで信じて頼ってほしいんだ","translation":"","kind":"lyric"},{"id":"35","start":172.91,"end":174.36,"text":"今なんじゃない?","translation":"","kind":"lyric"},{"id":"36","start":174.36,"end":176.28,"text":"メラメラとたぎる","translation":"","kind":"lyric"},{"id":"37","start":176.28,"end":179.74,"text":"こんな僕にも眠る正義が","translation":"","ki