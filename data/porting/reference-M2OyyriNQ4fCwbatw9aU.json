{"title":"되풀이 한 방울 (어레인지)","artist":"네코무시","sourceId":"reference:M2OyyriNQ4fCwbatw9aU","sourceHash":"96d7da2747a3b145c116943cc5f1f009a2bcf87c10cb9b15061d09eab2452750","performanceStatus":"no_performance_record","timingMethod":"reference_lyric_character_matching","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":7.61,"end":10.61,"text":"都合よく映されてた錯覚","translation":"","kind":"lyric"},{"id":"2","start":10.61,"end":13.18,"text":"意味を失った言葉と自覚","translation":"","kind":"lyric"},{"id":"3","start":13.18,"end":15.1,"text":"ぽっかり空いたこの穴は二度と","translation":"","kind":"lyric"},{"id":"4","start":15.1,"end":17.25,"text":"返してと泣き迷った路頭","translation":"","kind":"lyric"},{"id":"5","start":17.25,"end":18.95,"text":"もういらないの ここに居られないの","translation":"","kind":"lyric"},{"id":"6","start":18.95,"end":21.35,"text":"取り替えられない壊れた本のページ","translation":"","kind":"lyric"},{"id":"7","start":21.35,"end":26.58,"text":"裏も表も綺麗な棘 揺れ動く","translation":"","kind":"lyric"},{"id":"8","start":26.58,"end":31.42,"text":"ずっとずっと続けばいいな","translation":"","kind":"lyric"},{"id":"9","start":31.42,"end":35.02,"text":"進む先の甘い幻想","translation":"","kind":"lyric"},{"id":"10","start":35.02,"end":39.03,"text":"ガラス越しの微かな光","translation":"","kind":"lyric"},{"id":"11","start":39.03,"end":43.28,"text":"絡まって溶ける吐息","translation":"","kind":"lyric"},{"id":"12","start":43.28,"end":47.23,"text":"深い深い眠りに落ちた","translation":"","kind":"lyric"},{"id":"13","start":47.23,"end":51.3,"text":"腕の中で描き続けた","translation":"","kind":"lyric"},{"id":"14","start":51.3,"end":55.42,"text":"これが最初で最後の夢","translation":"","kind":"lyric"},{"id":"15","start":55.42,"end":59.93,"text":"無くなった私の場所 だって","translation":"","kind":"lyric"},{"id":"16","start":59.93,"end":63.98,"text":"信じてたんだ本気で 疑うなんて嫌で","translation":"","kind":"lyric"},{"id":"17","start":63.98,"end":68.17,"text":"離れていくような気がしたんだ だけど","translation":"","kind":"lyric"},{"id":"18","start":68.17,"end":72.15,"text":"初めから全部嘘 近付いてなんかない","translation":"","kind":"lyric"},{"id":"19","start":72.15,"end":75.59,"text":"こんなに舞い上がって馬鹿みたい","translation":"","kind":"lyric"},{"id":"20","start":75.59,"end":79.63,"text":"愛してる そう伝えたのは","translation":"","kind":"lyric"},{"id":"21","start":79.63,"end":83.97,"text":"釣り上げるためのエサですか","translation":"","kind":"lyric"},{"id":"22","start":83.97,"end":87.76,"text":"玩具箱の中 詰められて","translation":"","kind":"lyric"},{"id":"23","start":87.76,"end":92.05,"text":"飽きたら捨てられるんですか","translation":"","kind":"lyric"},{"id":"24","start":92.05,"end":94.33,"text":"フェイント 表は特別待遇","translation":"","kind":"lyric"},{"id":"25","start":94.33,"end":96.45,"text":"ひっくり返せば 利己主義態度","translation":"","kind":"lyric"},{"id":"26","start":96.45,"end":98.53999999999999,"text":"代わりはいくらでもいたんだって","translation":"","kind":"lyric"},{"id":"27","start":98.53999999999999,"end":100.4,"text":"気付かれた人形は即退場","translation":"","kind":"lyric"},{"id":"28","start":100.4,"end":102.46000000000001,"text":"戻れないよ 遠ざけたいよ","translation":"","kind":"lyric"},{"id":"29","start":102.46000000000001,"end":104.77000000000001,"text":"植え付けられた枯れない濁った表紙","translation":"","kind":"lyric"},{"id":"30","start":104.77000000000001,"end":110.18,"text":"定められた負のパスワード 染み渡る","translation":"","kind":"lyric"},{"id":"31","start":110.18,"end":114.35,"text":"芯の傷と赤い涙痕","translation":"","kind":"lyric"},{"id":"32","start":114.35,"end":118.41,"text":"根から咲いた毒の花びら","translation":"","kind":"lyric"},{"id":"33","start":118.41,"end":122.83,"text":"摘んでみても限りは無くて","translation":"","kind":"lyric"},{"id":"34","start":122.83,"end":126.31,"text":"浴びた薬副作用 どうして","translation":"","kind":"lyric"},{"id":"35","start":126.31,"end":131.17,"text":"嘘でいいことだけは願わずに鳴き出した","translation":"","kind":"lyric"},{"id":"36","start":131.17,"end":135.39,"text":"転がされた姿は本当なの 私","translation":"","kind":"lyric"},{"id":"37","start":135.39,"end":139.29,"text":"繰り返しの一粒 消耗品扱い","translation":"","kind":"lyric"},{"id":"38","start":139.29,"end":142.7,"text":"こんなに踊らされて馬鹿みたい","translation":"","kind":"lyric"},{"id":"39","start":142.7,"end":146.62,"text":"愛してる そう伝えたのは","translation":"","kind":"lyric"},{"id":"40","start":146.62,"end":150.93,"text":"飼い慣らすためのエサですか","translation":"","kind":"lyric"},{"id":"41","start":150.93,"end":154.99,"text":"散々遊んだ その後は","translation":"","kind":"lyric"},{"id":"42","start":154.99,"end":166.05,"text":"捨てることすら忘れるんですか","translation":"","kind":"lyric"},{"id":"43","start":166.05,"end":170.54,"text":"そんな軽いフレーズなんだね","translation":"","kind":"lyric"},{"id":"44","start":170.54,"end":174.6,"text":"便利な道具だったんだね","translation":"","kind":"lyric"},{"id":"45","start":174.6,"end":178.09,"text":"どんなに後悔したって","translation":"","kind":"lyric"},{"id":"46","start":178.09,"end":184.32,"text":"もう元には戻らない","translation":"","kind":"lyric"},{"id":"47","start":184.32,"end":188.18,"text":"愛してる そう伝えたのは","translation":"","kind":"lyric"},{"id":"48","start":188.18,"end":192.25,"text":"釣り上げるためのエサでした","translation":"","kind":"lyric"},{"id":"49","start":192.25,"end":196.22,"text":"中身なんかどうでもよくて","translation":"","kind":"lyric"},{"id":"50","start":196.22,"end":200.31,"text":"新しいものが欲しかっただけ","translation":"","kind":"lyric"},{"id":"51","start":200.31,"end":204.32,"text":"愛してる そう伝えたのは","translation":"","kind":"lyric"},{"id":"52","start":204.32,"end":208.59,"text":"飼い慣らすためのエサでした","translation":"","kind":"lyric"},{"id":"53","start":208.59,"end":212.87,"text":"あなたにとっては遊びでも","translation":"","kind":"lyric"},{"id":"54","start":212.87,"end":217.45,"text":"私は一生背負い続ける","translation":"","kind":"lyric"},{"id":"55","start":217.45,"end":219.14,"text":"都合よく映されてた錯覚","translation":"","kind":"lyric"},{"id":"56","start":219.14,"end":221.21,"text":"意味を失った言葉と自覚","translation":"","kind":"lyric"},{"id":"57","start":221.21,"end":223.15,"text":"ぽっかり空いたこの穴は二度と","translation":"","kind":"lyric"},{"id":"58","start":223.15,"end":225.1,"text":"返してと泣き迷った路頭","translation":"","kind":"lyric"},{"id":"59","start":225.1,"end":227.28,"text":"焼き付くフィルム 暴れるヴァイラス","translation":"","kind":"lyric"},{"id":"60","start":227.28,"end":229.36,"text":"温かい温度がすぐ怖くなるんだ","translation":"","kind":"lyric"},{"id":"61","start":229.36,"end":233.54,"text":"曇った色間違い探し もう嫌だ","translation":"","kind":"lyric"},{"id":"62","start":233.54,"end":235.38,"text":"フェイント 表は特別待遇","translation":"","kind":"lyric"},{"id":"63","start":235.38,"end":237.42000000000002,"text":"ひっくり返せば 利己主義態度","translation":"","kind":"lyric"},{"id":"64","start":237.42000000000002,"end":239.35,"text":"代わりはいくらでもいたんだって","translation":"","kind":"lyric"},{"id":"65","start":239.35,"end":241.36,"text":"気付かれた人形は即退場","translation":"","kind":"lyric"},{"id":"66","start":241.36,"end":243.51,"text":"冷たいまま回らなくなった","translation":"","kind":"lyric"},{"id":"67","start":243.51,"end":245.65,"text":"焦がれ狂い狂った真っ直ぐな曲線","translation":"","kind":"lyric"},{"id":"68","start":245.65,"end":250.03,"text":"まだ打つ波の扉開けて さようなら","translation":"","kind":"lyric"}],"candidates":[]}