{"title":"In Hell We Live, Lament","artist":"Mili","sourceId":"reference:Mi9R2WaPiwsa6hrfDrx1","sourceHash":"fdd04859ba86018461f68ce7d500ddd06e4e2497a5457c1ab7fa967e57d981e0","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":34307640,"cues":[{"id":"1","start":23.67,"end":27.32,"text":"I walked down a path","translation":"","kind":"lyric"},{"id":"2","start":27.32,"end":31.02,"text":"Leading to the past","translation":"","kind":"lyric"},{"id":"3","start":31.02,"end":35.07,"text":"Stole from the tree's hands","translation":"","kind":"lyric"},{"id":"4","start":35.07,"end":39.07,"text":"A regretter's friend; The forbidden fruit","translation":"","kind":"lyric"},{"id":"5","start":39.07,"end":40.75,"text":"I bite off the skin","translation":"","kind":"lyric"},{"id":"6","start":40.75,"end":43.36,"text":"Chewing on its tender flesh","translation":"","kind":"lyric"},{"id":"7","start":43.36,"end":46.71,"text":"Quaff down its lukewarm puss","translation":"","kind":"lyric"},{"id":"8","start":46.71,"end":50.46,"text":"You've became the \"me\" who you despised","translation":"","kind":"lyric"},{"id":"9","start":50.46,"end":54.42,"text":"We've swallowed the time, let us rewind","translation":"","kind":"lyric"},{"id":"10","start":57.18,"end":57.96,"text":"Lament!","translation":"","kind":"lyric"},{"id":"11","start":57.96,"end":59.65,"text":"If you wanted me to speak","translation":"","kind":"lyric"},{"id":"12","start":59.65,"end":61.63,"text":"If you wanted me to think","translation":"","kind":"lyric"},{"id":"13","start":61.63,"end":65.94,"text":"If you wanted me to carry on our dreams","translation":"","kind":"lyric"},{"id":"14","start":65.94,"end":67.2,"text":"Each loop we live through","translation":"","kind":"lyric"},{"id":"15","start":67.2,"end":68.18,"text":"Each loop we live through","translation":"","kind":"lyric"},{"id":"16","start":68.18,"end":69.53999999999999,"text":"The standards inside me","translation":"","kind":"lyric"},{"id":"17","start":69.53999999999999,"end":71.69,"text":"The line I drew for me","translation":"","kind":"lyric"},{"id":"18","start":71.69,"end":72.84,"text":"Lowers to the earth","translation":"","kind":"lyric"},{"id":"19","start":72.84,"end":73.18,"text":"Lament!","translation":"","kind":"lyric"},{"id":"20","start":73.18,"end":74.81,"text":"Why'd you make my voice stutter?","translation":"","kind":"lyric"},{"id":"21","start":74.81,"end":76.96000000000001,"text":"Why do truths never matter?","translation":"","kind":"lyric"},{"id":"22","start":76.96000000000001,"end":81.25,"text":"Why'd you curse me with \"You're a natural born genius\"?","translation":"","kind":"lyric"},{"id":"23","start":81.25,"end":83.76,"text":"Endless inferno (Inferno)","translation":"","kind":"lyric"},{"id":"24","start":83.76,"end":85.42,"text":"Counter-clock we rose","translation":"","kind":"lyric"},{"id":"25","start":85.42,"end":88.95,"text":"Counter-clock we reload","translation":"","kind":"lyric"},{"id":"26","start":88.95,"end":92.63,"text":"Tick tick tock","translation":"","kind":"lyric"},{"id":"27","start":92.63,"end":96.62,"text":"Replayed thoughts","translation":"","kind":"lyric"},{"id":"28","start":96.62,"end":100.84,"text":"Forget me not","translation":"","kind":"lyric"},{"id":"29","start":100.84,"end":104.4,"text":"I'm inside the empathic light","translation":"","kind":"lyric"},{"id":"30","start":104.4,"end":106.1,"text":"I bite off your skin","translation":"","kind":"lyric"},{"id":"31","start":106.1,"end":110.00999999999999,"text":"Exposing the angels on your ribs","translation":"","kind":"lyric"},{"id":"32","start":110.00999999999999,"end":111.92,"text":"They stare at us","translation":"","kind":"lyric"},{"id":"33","start":111.92,"end":115.63,"text":"\"Hello, how may I help you today?\"","translation":"","kind":"lyric"},{"id":"34","start":115.63,"end":119.89,"text":"\"Please, a one-way ticket to heaven\"","translation":"","kind":"lyric"},{"id":"35","start":119.89,"end":123.58,"text":"Buckled up on velvet seats","translation":"","kind":"lyric"},{"id":"36","start":123.58,"end":127.27,"text":"Sceneries were passing by","translation":"","kind":"lyric"},{"id":"37","start":127.27,"end":131.35,"text":"Not so different from our hell","translation":"","kind":"lyric"},{"id":"38","start":131.35,"end":135.3,"text":"Not so different from our home","translation":"","kind":"lyric"},{"id":"39","start":135.3,"end":139.32999999999998,"text":"Then I realized someone's heaven","translation":"","kind":"lyric"},{"id":"40","start":139.32999999999998,"end":142.74,"text":"Could be the source of my torment","translation":"","kind":"lyric"},{"id":"41","start":142.74,"end":146.47,"text":"Life is allowing yourself","translation":"","kind":"lyric"},{"id":"42","start":146.47,"end":152.29,"text":"Allowing yourself to step on fire (Life is to consume)","translation":"","kind":"lyric"},{"id":"43","start":152.29,"end":155.88,"text":"Shed tears on bloodied routes (Life is to become food for each other)","translation":"","kind":"lyric"},{"id":"44","start":155.88,"end":158.9,"text":"(No matter evil or good)","translation":"","kind":"lyric"},{"id":"45","start":158.9,"end":161.89,"text":"Eternally in hell we live... (Life is fairness, life is inequality)","translation":"","kind":"lyric"},{"id":"46","start":161.89,"end":163.76,"text":"(Life is in the motion...)","translation":"","kind":"lyric"},{"id":"47","start":163.76,"end":166.84,"text":"By default","translation":"","kind":"lyric"},{"id":"48","start":166.84,"end":167.49,"text":"Lament!","translation":"","kind":"lyric"},{"id":"49","start":167.49,"end":169.19,"text":"If you wanted me to live","translation":"","kind":"lyric"},{"id":"50","start":169.19,"end":171.23,"text":"If you want me to forgive","translation":"","kind":"lyric"},{"id":"51","start":171.23,"end":174.9,"text":"If you want us to pretend like we're civilized humans","translation":"","kind":"lyric"},{"id":"52","start":174.9,"end":176.16,"text":"Each loop we die through","translation":"","kind":"lyric"},{"id":"53","start":176.16,"end":177.49,"text":"Each loop we die through","translation":"","kind":"lyric"},{"id":"54","start":177.49,"end":179.17000000000002,"text":"The justice inside me","translation":"","kind":"lyric"},{"id":"55","start":179.17000000000002,"end":181.19,"text":"The ego fending me","translation":"","kind":"lyric"},{"id":"56","start":181.19,"end":182.24,"text":"Rationalize my sin","translation":"","kind":"lyric"},{"id":"57","start":182.24,"end":182.8,"text":"Lament!","translation":"","kind":"lyric"},{"id":"58","start":182.8,"end":184.21,"text":"Why do deaths end my torture?","translation":"","kind":"lyric"},{"id":"59","start":184.21,"end":186.29,"text":"Why can't anyone feel my hurt?","translation":"","kind":"lyric"},{"id":"60","start":186.29,"end":190.51,"text":"Why'd you crown the most violent to be champions?","translation":"","kind":"lyric"},{"id":"61","start":190.51,"end":193.12,"text":"In this inferno (Inferno)","translation":"","kind":"lyric"},{"id":"62","start":193.12,"end":194.7,"text":"We built for ourselves","translation":"","kind":"lyric"},{"id":"63","start":194.7,"end":196.41,"text":"(Reviving) each other in this hell","translation":"","kind":"lyric"}],"candidates":[]}