{"title":"무의식 레퀴엠","artist":"삼라만상","sourceId":"reference:yXe8M90jGYRM2MDETk1H","sourceHash":"4d803b8f731b9b9850f0769c40960a69a8ed559e05e63f2056716e35b04cd1cd","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":9543006,"cues":[{"id":"1","start":35.93,"end":38.64,"text":"午前二時 点滅 水銀燈","translation":"","kind":"lyric"},{"id":"2","start":38.64,"end":40.78,"text":"仄暗い交差点","translation":"","kind":"lyric"},{"id":"3","start":40.78,"end":45.45,"text":"後ろの正面から 聴こえる声","translation":"","kind":"lyric"},{"id":"4","start":45.45,"end":47.89,"text":"誰かが嘯うそぶいていた","translation":"","kind":"lyric"},{"id":"5","start":47.89,"end":50.54,"text":"噂話に","translation":"","kind":"lyric"},{"id":"6","start":50.54,"end":53.39,"text":"曰く、そいつは","translation":"","kind":"lyric"},{"id":"7","start":53.39,"end":55.77,"text":"ひっそりと立っていた","translation":"","kind":"lyric"},{"id":"8","start":55.77,"end":60.38,"text":"無機質プッシュ音そっと谺こだまする","translation":"","kind":"lyric"},{"id":"9","start":60.38,"end":64.18,"text":"後には戻れないよ","translation":"","kind":"lyric"},{"id":"10","start":64.18,"end":70.9,"text":"繋ぐ先に待つ天国か地獄","translation":"","kind":"lyric"},{"id":"11","start":70.9,"end":73.34,"text":"こんばんは、ねぇ、知ってる？","translation":"","kind":"lyric"},{"id":"12","start":73.34,"end":75.47,"text":"見て見て あなたのそばで","translation":"","kind":"lyric"},{"id":"13","start":75.47,"end":77.86,"text":"誰かが覗いているよ","translation":"","kind":"lyric"},{"id":"14","start":77.86,"end":80.56,"text":"トラウマの雨を降らし、ポトリ","translation":"","kind":"lyric"},{"id":"15","start":80.56,"end":84.42,"text":"今日も一羽だけ煮えていく はぁ","translation":"","kind":"lyric"},{"id":"16","start":92.71000000000001,"end":94.84,"text":"はじめまして こんばんは","translation":"","kind":"lyric"},{"id":"17","start":94.84,"end":96.62,"text":"あなたは雨ですか？","translation":"","kind":"lyric"},{"id":"18","start":96.62,"end":100.17,"text":"隠れんぼしたのよ イタズラ","translation":"","kind":"lyric"},{"id":"19","start":100.17,"end":102.61,"text":"今 あなたの近く","translation":"","kind":"lyric"},{"id":"20","start":102.61,"end":104.05,"text":"会いに行くから","translation":"","kind":"lyric"},{"id":"21","start":104.05,"end":107.68,"text":"隣の隣","translation":"","kind":"lyric"},{"id":"22","start":107.68,"end":110.03,"text":"そう誰が作った","translation":"","kind":"lyric"},{"id":"23","start":110.03,"end":112.78999999999999,"text":"噂話に","translation":"","kind":"lyric"},{"id":"24","start":112.78999999999999,"end":115.15,"text":"曰く、そいつは","translation":"","kind":"lyric"},{"id":"25","start":115.15,"end":118.86,"text":"後ろの正面に嗤う それは？","translation":"","kind":"lyric"},{"id":"26","start":118.86,"end":121.11,"text":"(聴いてもっと鎮魂歌レクイエム)","translation":"","kind":"lyric"},{"id":"27","start":121.11,"end":126.38,"text":"(確かな存在は？受話器越しの境界)","translation":"","kind":"lyric"},{"id":"28","start":126.38,"end":128.87,"text":"どこにもなくてそこにある","translation":"","kind":"lyric"},{"id":"29","start":128.87,"end":132.7,"text":"幻視する世界","translation":"","kind":"lyric"},{"id":"30","start":132.7,"end":135.01,"text":"私のこと、気付いてくれた？","translation":"","kind":"lyric"},{"id":"31","start":135.01,"end":137.11,"text":"ガチャガチャ ノブ廻す音","translation":"","kind":"lyric"},{"id":"32","start":137.11,"end":139.72,"text":"真夜中二時のヒメゴト","translation":"","kind":"lyric"},{"id":"33","start":139.72,"end":142.19,"text":"影すら見えない足音が","translation":"","kind":"lyric"},{"id":"34","start":142.19,"end":145.06,"text":"ここには来れない二羽がなく","translation":"","kind":"lyric"},{"id":"35","start":145.06,"end":147.92000000000002,"text":"潰れてた 顔見てたって","translation":"","kind":"lyric"},{"id":"36","start":147.92000000000002,"end":150.03,"text":"誰もかも連なって","translation":"","kind":"lyric"},{"id":"37","start":150.03,"end":152.65,"text":"頭から割れ割れ","translation":"","kind":"lyric"},{"id":"38","start":152.65,"end":155.41,"text":"這って伝うの赤信号","translation":"","kind":"lyric"},{"id":"39","start":155.41,"end":157.31,"text":"ここから ここまで","translation":"","kind":"lyric"},{"id":"40","start":157.31,"end":160.04,"text":"どこかの 迷い道通りゃんせ","translation":"","kind":"lyric"},{"id":"41","start":160.04,"end":162.31,"text":"天神さま言いました","translation":"","kind":"lyric"},{"id":"42","start":162.31,"end":165.24,"text":"帰りは剥がれます けれど","translation":"","kind":"lyric"},{"id":"43","start":165.24,"end":167.62,"text":"平気平気平気平気","translation":"","kind":"lyric"},{"id":"44","start":167.62,"end":169.27,"text":"ちぎれ、ちぎる","translation":"","kind":"lyric"},{"id":"45","start":169.27,"end":171.01,"text":"きみときみも","translation":"","kind":"lyric"},{"id":"46","start":171.01,"end":173.13,"text":"まじる、あかい","translation":"","kind":"lyric"},{"id":"47","start":173.13,"end":174.72,"text":"あかい、無駄骨よ","translation":"","kind":"lyric"},{"id":"48","start":174.72,"end":176.53,"text":"せかい、ひとり","translation":"","kind":"lyric"},{"id":"49","start":176.53,"end":178.11,"text":"あなた、わたし","translation":"","kind":"lyric"},{"id":"50","start":178.11,"end":180.04,"text":"ゆめも、ついに","translation":"","kind":"lyric"},{"id":"51","start":180.04,"end":183.38,"text":"おわり、いたい","translation":"","kind":"lyric"},{"id":"52","start":183.38,"end":187.79,"text":"いたい、いたイ","translation":"","kind":"lyric"},{"id":"53","start":209.8,"end":211.98,"text":"ただただ 生まれた時に","translation":"","kind":"lyric"},{"id":"54","start":211.98,"end":214.38,"text":"持った瑕きずついた心","translation":"","kind":"lyric"},{"id":"55","start":214.38,"end":216.75,"text":"誰かを傷つけただけなの","translation":"","kind":"lyric"},{"id":"56","start":216.75,"end":221.64,"text":"イノセント こんな目に遭うのか？なんて","translation":"","kind":"lyric"},{"id":"57","start":221.64,"end":228.29,"text":"わからないのならばふるえて眠りなさい","translation":"","kind":"lyric"},{"id":"58","start":228.29,"end":234.54,"text":"ねぇ、私、今、あなたの...","translation":"","kind":"lyric"},{"id":"59","start":234.54,"end":237.21,"text":"嗚呼 ばらばら 體からだと魂こころ","translation":"","kind":"lyric"},{"id":"60","start":237.21,"end":239.39,"text":"元には戻れぬ命","translation":"","kind":"lyric"},{"id":"61","start":239.39,"end":241.85,"text":"あなたはいつまで夢見てるの？","translation":"","kind":"lyric"},{"id":"62","start":241.85,"end":244.62,"text":"不公平面相対性","translation":"","kind":"lyric"},{"id":"63","start":244.62,"end":247.02,"text":"もしもし 私はメリー","translation":"","kind":"lyric"},{"id":"64","start":247.02,"end":249.14,"text":"嘘のような本当は","translation":"","kind":"lyric"},{"id":"65","start":249.14,"end":251.88,"text":"バッドエンド 決めつけないでよ","translation":"","kind":"lyric"},{"id":"66","start":251.88,"end":254.14,"text":"今日も一羽だけ消えていく","translation":"","kind":"lyric"},{"id":"67","start":254.14,"end":257.28,"text":"今日も甘々に贄ていく","translation":"","kind":"lyric"}],"candidates":[]}