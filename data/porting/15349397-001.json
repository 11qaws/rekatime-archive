{"title":"Speechless","artist":"Naomi Scott","date":"2026-09-23","sourceId":"15349397:001","sourceHash":"ccb4dd146704d44eaff33f6e23dff42a983db4b4ad75aae5eac517a17e07c5bd","duration":194.60000000000036,"cues":[{"id":"1","start":12.521482,"end":14.306787,"text":"Here comes a wave","translation":"파도가 밀려와","kind":"lyric"},{"id":"2","start":14.381202,"end":16.235,"text":"Meant to wash me away","translation":"날 쓸어 가려 해","kind":"lyric"},{"id":"3","start":16.3909,"end":19.585,"text":"A tide that is taking me under","translation":"날 삼켜 버릴 거센 물결","kind":"lyric"},{"id":"4","start":19.940366,"end":21.790085,"text":"Swallowing sand","translation":"모래를 삼키고","kind":"lyric"},{"id":"5","start":21.810085,"end":23.655,"text":"Left with nothing to say","translation":"아무 말도 못 한 채","kind":"lyric"},{"id":"6","start":24.099741,"end":28.055,"text":"My voice drowned out in the thunder","translation":"천둥에 내 목소린 잠겨","kind":"lyric"},{"id":"7","start":28.719046,"end":31.465,"text":"But I won't cry","translation":"하지만 난 울지 않아","kind":"lyric"},{"id":"8","start":31.738592,"end":36.185,"text":"And I won't start to crumble","translation":"그리고 무너지지 않아","kind":"lyric"},{"id":"9","start":36.427887,"end":39.125,"text":"Whenever they try","translation":"그들이 언제나","kind":"lyric"},{"id":"10","start":39.347448,"end":43.632179,"text":"To shut me or cut me down","translation":"날 막고 꺾으려 해도","kind":"lyric"},{"id":"11","start":43.91676,"end":47.075,"text":"I won't be silenced","translation":"난 침묵하지 않아","kind":"lyric"},{"id":"12","start":47.186269,"end":50.755,"text":"You can't keep me quiet","translation":"날 잠재울 수 없어","kind":"lyric"},{"id":"13","start":50.945703,"end":54.278272,"text":"Won't tremble when you try it","translation":"네가 해 봐도 떨지 않아","kind":"lyric"},{"id":"14","start":54.35519,"end":59.592085,"text":"All I know is I won't go speechless","translation":"내가 아는 건 난 침묵하지 않는단 것","kind":"lyric"},{"id":"15","start":60.2743,"end":62.654707,"text":"'Cause I'll breathe","translation":"난 숨을 쉴 테니","kind":"lyric"},{"id":"16","start":62.823917,"end":66.115,"text":"When they try to suffocate me","translation":"날 질식시키려 해도","kind":"lyric"},{"id":"17","start":66.333389,"end":69.784978,"text":"Don't you underestimate me","translation":"나를 얕보지 마","kind":"lyric"},{"id":"18","start":69.862858,"end":75.813874,"text":"'Cause I know that I won't go speechless","translation":"난 침묵하지 않을 걸 아니까","kind":"lyric"},{"id":"19","start":75.921947,"end":78.041625,"text":"Written in stone","translation":"돌에 새겨진","kind":"lyric"},{"id":"20","start":78.061625,"end":79.935,"text":"Every rule, every word","translation":"모든 규칙 모든 말","kind":"lyric"},{"id":"21","start":80.041327,"end":83.475,"text":"Centuries old and unbending","translation":"수백 년 묵어 굽히지 않아","kind":"lyric"},{"id":"22","start":83.690778,"end":85.357063,"text":"Stay in your place","translation":"네 자릴 지켜","kind":"lyric"},{"id":"23","start":85.430517,"end":87.435,"text":"Better seen and not heard","translation":"보이되 말은 하지 마","kind":"lyric"},{"id":"24","start":87.650183,"end":91.319628,"text":"But now that story is ending","translation":"하지만 이제 그 이야긴 끝나","kind":"lyric"},{"id":"25","start":91.339628,"end":93.243953,"text":"'Cause I","translation":"왜냐면 난","kind":"lyric"},{"id":"26","start":93.449311,"end":97.705,"text":"I cannot start to crumble","translation":"난 무너지지 않아","kind":"lyric"},{"id":"27","start":97.828652,"end":100.295,"text":"So come on and try","translation":"그러니 어디 해 봐","kind":"lyric"},{"id":"28","start":100.458257,"end":105.365,"text":"Try to shut me and cut me down","translation":"날 막고 꺾어 보려 해","kind":"lyric"},{"id":"29","start":105.497499,"end":108.385,"text":"I won't be silenced","translation":"난 침묵하지 않아","kind":"lyric"},{"id":"30","start":108.61703,"end":112.068619,"text":"You can't keep me quiet","translation":"날 잠재울 수 없어","kind":"lyric"},{"id":"31","start":112.296476,"end":115.629045,"text":"Won't tremble when you try it","translation":"네가 해 봐도 떨지 않아","kind":"lyric"},{"id":"32","start":115.79595,"end":119.815,"text":"All I know is I won't go speechless","translation":"내가 아는 건 난 침묵하지 않는단 것","kind":"lyric"},{"id":"33","start":119.965323,"end":121.512587,"text":"Speechless","translation":"침묵하지 않아","kind":"lyric"},{"id":"34","start":121.655069,"end":123.797435,"text":"Let the storm in","translation":"폭풍을 들여보내","kind":"lyric"},{"id":"35","start":124.004715,"end":127.337284,"text":"I cannot be broken","translation":"난 부서지지 않아","kind":"lyric"},{"id":"36","start":127.454197,"end":130.786766,"text":"No, I won't live unspoken","translation":"아니 말 못 한 채 살진 않아","kind":"lyric"},{"id":"37","start":130.82369,"end":136.179604,"text":"'Cause I know that I won't go speechless","translation":"난 침묵하지 않을 걸 아니까","kind":"lyric"},{"id":"38","start":136.312864,"end":139.764454,"text":"Try to lock me in this cage","translation":"날 이 우리에 가둬 봐","kind":"lyric"},{"id":"39","start":139.862331,"end":144.245,"text":"I won't just lay me down and die","translation":"그냥 쓰러져 죽진 않아","kind":"lyric"},{"id":"40","start":144.431643,"end":147.407151,"text":"I will take these broken wings","translation":"이 부러진 날개를 펼쳐","kind":"lyric"},{"id":"41","start":147.441191,"end":151.805,"text":"And watch me burn across the sky","translation":"하늘을 가로질러 타오를 거야","kind":"lyric"},{"id":"42","start":152.050497,"end":155.369995,"text":"Hear the echoes saying I","translation":"메아리쳐 난 말해","kind":"lyric"},{"id":"43","start":155.389995,"end":159.655,"text":"Won't be silenced","translation":"난 침묵하지 않아","kind":"lyric"},{"id":"44","start":159.959308,"end":165.077182,"text":"Though you want to see me tremble when you try it","translation":"네가 해 봐도 날 떨게 할 순 없어","kind":"lyric"},{"id":"45","start":165.098535,"end":169.264246,"text":"All I know is I won't go speechless","translation":"내가 아는 건 난 침묵하지 않는단 것","kind":"lyric"},{"id":"46","start":169.347896,"end":171.22761,"text":"Speechless","translation":"침묵하지 않아","kind":"lyric"},{"id":"47","start":171.24761,"end":173.389976,"text":"'Cause I'll breathe","translation":"난 숨을 쉴 테니","kind":"lyric"},{"id":"48","start":173.497272,"end":176.710821,"text":"When they try to suffocate me","translation":"날 질식시키려 해도","kind":"lyric"},{"id":"49","start":176.896761,"end":180.22933,"text":"Don't you underestimate me","translation":"나를 얕보지 마","kind":"lyric"},{"id":"50","start":180.35624,"end":184.402931,"text":"'Cause I know that I won't go speechless","translation":"난 침묵하지 않을 걸 아니까","kind":"lyric"},{"id":"51","start":184.445625,"end":188.016235,"text":"All I know is I won't go speechless","translation":"내가 아는 건 난 침묵하지 않는단 것","kind":"lyric"},{"id":"52","start":188.315043,"end":191.14,"text":"Speechless","translation":"침묵하지 않아","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}