{"originalLanguage":"ja","title":"물거품","artist":"ヨルシカ","date":"2026-10-01","sourceId":"15474204:002","sourceHash":"a82f007bef7c2c1c9b5b297684926f721e27433ea2f7598da29369bcda49b56f","duration":239.70000000000027,"cues":[{"id":"1","start":16.663205,"end":19.498767,"text":"あぁどうしようもないほどに","translation":"아아 어쩔 도리가 없을 만큼","kind":"lyric"},{"id":"2","start":19.53321,"end":23.10053,"text":"私に蠢く獣","translation":"내 안에서 꿈틀대는 짐승","kind":"lyric"},{"id":"3","start":23.143217,"end":29.729039,"text":"水面浮かんで浮かんでは消える あぶく","translation":"수면에 떠올랐다 사라지는 물거품","kind":"lyric"},{"id":"4","start":34.263239,"end":37.003245,"text":"あぁどうしようもなく悲しい","translation":"아아 어쩔 도리 없이 슬퍼","kind":"lyric"},{"id":"5","start":37.023245,"end":40.455,"text":"私を動かす獣","translation":"나를 움직이는 짐승","kind":"lyric"},{"id":"6","start":40.843252,"end":44.065,"text":"トートロジー握った手のあぶく","translation":"동어반복을 움켜쥔 손의 물거품","kind":"lyric"},{"id":"7","start":45.633262,"end":48.560293,"text":"過ぎ去る雲を思うより","translation":"흘러가는 구름을 생각하기보다","kind":"lyric"},{"id":"8","start":48.723268,"end":51.363273,"text":"遥かへ遠吠え","translation":"아득한 곳으로 울부짖어","kind":"lyric"},{"id":"9","start":51.383273,"end":54.493244,"text":"息継ぐ暇もないほど","translation":"숨 돌릴 틈도 없을 만큼","kind":"lyric"},{"id":"10","start":54.533279,"end":58.283539,"text":"苦しいあれで","translation":"괴로운 그것으로","kind":"lyric"},{"id":"11","start":58.373287,"end":61.117379,"text":"悠々悠々夢を焼け","translation":"유유히 유유히 꿈을 불태워","kind":"lyric"},{"id":"12","start":61.143292,"end":64.7933,"text":"魂の白い白い色で","translation":"영혼의 새하얀 빛깔로","kind":"lyric"},{"id":"13","start":64.8133,"end":69.935605,"text":"喜びの火に火をつけたいだけ","translation":"기쁨의 불에 불을 붙이고 싶을 뿐","kind":"lyric"},{"id":"14","start":69.97331,"end":72.808872,"text":"想像は少しの泡銭","translation":"상상은 조금의 뜬돈","kind":"lyric"},{"id":"15","start":72.863315,"end":76.235,"text":"冷めない言葉の両手で","translation":"식지 않는 말의 두 손으로","kind":"lyric"},{"id":"16","start":76.503323,"end":81.442689,"text":"燃え尽きないものを数えて","translation":"다 타지 않는 것들을 세어","kind":"lyric"},{"id":"17","start":81.633333,"end":83.14,"text":"掬いたいだけ","translation":"건져 올리고 싶을 뿐","kind":"lyric"},{"id":"18","start":94.193357,"end":97.120389,"text":"さぁ 銘々ご覧遊べ","translation":"자 각자 마음껏 구경해","kind":"lyric"},{"id":"19","start":97.173363,"end":100.008925,"text":"私の乾いた獣","translation":"나의 메마른 짐승","kind":"lyric"},{"id":"20","start":100.66337,"end":104.23069,"text":"ふつふつ怒った音を鳴らして","translation":"부글부글 성난 소리를 울리며","kind":"lyric"},{"id":"21","start":105.973381,"end":108.717473,"text":"あぁろうそくの火を消して","translation":"아아 촛불을 꺼 버리고","kind":"lyric"},{"id":"22","start":108.753386,"end":111.588948,"text":"私に残ったものは","translation":"내게 남은 것은","kind":"lyric"},{"id":"23","start":113.113395,"end":115.705,"text":"滑稽なペダンチスムだけ","translation":"우스운 현학뿐","kind":"lyric"},{"id":"24","start":117.303403,"end":120.321905,"text":"過ぎ去る雲にどうして","translation":"흘러가는 구름에 어째서","kind":"lyric"},{"id":"25","start":120.423409,"end":123.076032,"text":"私は遠吠え","translation":"나는 울부짖어","kind":"lyric"},{"id":"26","start":123.163415,"end":126.181916,"text":"悲しむ暇もないほど","translation":"슬퍼할 틈도 없을 만큼","kind":"lyric"},{"id":"27","start":126.223421,"end":129.97368,"text":"悲しいあれで","translation":"슬픈 그것으로","kind":"lyric"},{"id":"28","start":130.083428,"end":132.823434,"text":"想想想像で一つだけ","translation":"상상 상상 상상으로 하나만","kind":"lyric"},{"id":"29","start":132.843434,"end":136.375,"text":"寂しい私に太陽を","translation":"외로운 나에게 태양을","kind":"lyric"},{"id":"30","start":136.533441,"end":141.564277,"text":"喜びに火を、火をつけておくれ","translation":"기쁨에 불을 불을 붙여 줘","kind":"lyric"},{"id":"31","start":141.613451,"end":144.540483,"text":"焦燥も少しの泡銭","translation":"초조함도 조금의 뜬돈","kind":"lyric"},{"id":"32","start":144.563457,"end":147.915,"text":"苦しい私の両手で","translation":"괴로운 나의 두 손으로","kind":"lyric"},{"id":"33","start":148.183464,"end":152.695,"text":"燃え尽きないものを数えて","translation":"다 타지 않는 것들을 세어","kind":"lyric"},{"id":"34","start":153.383474,"end":154.825,"text":"摘みたいだけ","translation":"따고 싶을 뿐","kind":"lyric"},{"id":"35","start":166.2935,"end":169.58641,"text":"半信半疑の満身創痍で尚","translation":"반신반의하며 만신창이인 채로도","kind":"lyric"},{"id":"36","start":169.633506,"end":171.295,"text":"太陽が欲しい","translation":"태양을 원해","kind":"lyric"},{"id":"37","start":171.63351,"end":174.652012,"text":"だからもっと私に火をつけて","translation":"그러니 내게 더 불을 붙여","kind":"lyric"},{"id":"38","start":174.713516,"end":178.006427,"text":"吐き出して","translation":"토해 내","kind":"lyric"},{"id":"39","start":178.043523,"end":183.475,"text":"超能力でも創作物でも現実逃避でもいい","translation":"초능력이든 창작물이든 현실 도피든 좋아","kind":"lyric"},{"id":"40","start":183.823534,"end":186.345,"text":"もっと私に火をつけて","translation":"내게 더 불을 붙여","kind":"lyric"},{"id":"41","start":186.523539,"end":189.99939,"text":"私を震わせて","translation":"나를 떨게 해","kind":"lyric"},{"id":"42","start":200.383567,"end":203.036189,"text":"夕夕夕夕夕、目を焼け","translation":"저녁 저녁 저녁 저녁 저녁 눈을 태워","kind":"lyric"},{"id":"43","start":203.073572,"end":206.415,"text":"魂の白い白い色で","translation":"영혼의 새하얀 빛깔로","kind":"lyric"},{"id":"44","start":206.643579,"end":211.843589,"text":"喜びの火に火をつけたいだけ","translation":"기쁨의 불에 불을 붙이고 싶을 뿐","kind":"lyric"},{"id":"45","start":211.863589,"end":214.699151,"text":"想像の頭上の上を行け","translation":"상상의 머리 위보다 더 높이 가","kind":"lyric"},{"id":"46","start":214.753595,"end":218.463603,"text":"冷めない言葉の両手で","translation":"식지 않는 말의 두 손으로","kind":"lyric"},{"id":"47","start":218.483603,"end":222.895,"text":"燃え尽きたものも全て","translation":"다 타 버린 것까지 모두","kind":"lyric"},{"id":"48","start":223.593613,"end":225.03,"text":"掬いたいだけ","translation":"건져 올리고 싶을 뿐","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}