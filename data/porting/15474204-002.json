{"title":"물거품","artist":"ヨルシカ","date":"2026-10-01","sourceId":"15474204:002","sourceHash":"ebb9be4f4ed9700eda2eacc7b7fe71586e05dc0a6af3290a8060b1d707c61701","duration":239.6,"cues":[{"id":"1","start":16.795,"end":19.503,"text":"あぁどうしようもないほどに","translation":"아아 어쩔 도리가 없을 만큼","kind":"lyric"},{"id":"2","start":19.563,"end":23.103,"text":"私に蠢く獣","translation":"내 안에서 꿈틀대는 짐승","kind":"lyric"},{"id":"3","start":23.163,"end":29.163,"text":"水面浮かんで浮かんでは消える あぶく","translation":"수면에 떠올랐다 사라지는 물거품","kind":"lyric"},{"id":"4","start":34.256,"end":36.44,"text":"あぁどうしようもなく悲しい","translation":"아아 어쩔 도리 없이 슬퍼","kind":"lyric"},{"id":"5","start":36.6,"end":38.4,"text":"私を動かす獣","translation":"나를 움직이는 짐승","kind":"lyric"},{"id":"6","start":38.465,"end":43.554,"text":"トートロジー握った手のあぶく","translation":"동어반복을 움켜쥔 손의 물거품","kind":"lyric"},{"id":"7","start":43.619,"end":46.878,"text":"過ぎ去る雲を思うより","translation":"흘러가는 구름을 생각하기보다","kind":"lyric"},{"id":"8","start":46.943,"end":49.741,"text":"遥かへ遠吠え","translation":"아득한 곳으로 울부짖어","kind":"lyric"},{"id":"9","start":49.806,"end":53.233,"text":"息継ぐ暇もないほど","translation":"숨 돌릴 틈도 없을 만큼","kind":"lyric"},{"id":"10","start":53.298,"end":57.101,"text":"苦しいあれで","translation":"괴로운 그것으로","kind":"lyric"},{"id":"11","start":57.166,"end":59.892,"text":"悠々悠々夢を焼け","translation":"유유히 유유히 꿈을 불태워","kind":"lyric"},{"id":"12","start":59.956,"end":63.588,"text":"魂の白い白い色で","translation":"영혼의 새하얀 빛깔로","kind":"lyric"},{"id":"13","start":63.653,"end":69.3,"text":"喜びの火に火をつけたいだけ","translation":"기쁨의 불에 불을 붙이고 싶을 뿐","kind":"lyric"},{"id":"14","start":69.3,"end":72.161,"text":"想像は少しの泡銭","translation":"상상은 조금의 뜬돈","kind":"lyric"},{"id":"15","start":72.22,"end":75.28,"text":"冷めない言葉の両手で","translation":"식지 않는 말의 두 손으로","kind":"lyric"},{"id":"16","start":75.96,"end":80.847,"text":"燃え尽きないものを数えて","translation":"다 타지 않는 것들을 세어","kind":"lyric"},{"id":"17","start":80.904,"end":86.538,"text":"掬いたいだけ","translation":"건져 올리고 싶을 뿐","kind":"lyric"},{"id":"18","start":93.007,"end":95.822,"text":"さぁ 銘々ご覧遊べ","translation":"자 각자 마음껏 구경해","kind":"lyric"},{"id":"19","start":95.879,"end":98.78,"text":"私の乾いた獣","translation":"나의 메마른 짐승","kind":"lyric"},{"id":"20","start":98.836,"end":103.28,"text":"ふつふつ怒った音を鳴らして","translation":"부글부글 성난 소리를 울리며","kind":"lyric"},{"id":"21","start":103.393,"end":108.02,"text":"あぁろうそくの火を消して","translation":"아아 촛불을 꺼 버리고","kind":"lyric"},{"id":"22","start":108.16,"end":110.24,"text":"私に残ったものは","translation":"내게 남은 것은","kind":"lyric"},{"id":"23","start":110.329,"end":116.271,"text":"滑稽なペダンチスムだけ","translation":"우스운 현학뿐","kind":"lyric"},{"id":"24","start":116.36,"end":119.74,"text":"過ぎ去る雲にどうして","translation":"흘러가는 구름에 어째서","kind":"lyric"},{"id":"25","start":119.801,"end":122.441,"text":"私は遠吠え","translation":"나는 울부짖어","kind":"lyric"},{"id":"26","start":122.502,"end":125.681,"text":"悲しむ暇もないほど","translation":"슬퍼할 틈도 없을 만큼","kind":"lyric"},{"id":"27","start":125.742,"end":129.584,"text":"悲しいあれで","translation":"슬픈 그것으로","kind":"lyric"},{"id":"28","start":129.645,"end":132.374,"text":"想想想像で一つだけ","translation":"상상 상상 상상으로 하나만","kind":"lyric"},{"id":"29","start":132.435,"end":135.979,"text":"寂しい私に太陽を","translation":"외로운 나에게 태양을","kind":"lyric"},{"id":"30","start":136.04,"end":141.043,"text":"喜びに火を、火をつけておくれ","translation":"기쁨에 불을 불을 붙여 줘","kind":"lyric"},{"id":"31","start":141.101,"end":143.983,"text":"焦燥も少しの泡銭","translation":"초조함도 조금의 뜬돈","kind":"lyric"},{"id":"32","start":144.04,"end":147.04,"text":"苦しい私の両手で","translation":"괴로운 나의 두 손으로","kind":"lyric"},{"id":"33","start":147.04,"end":152.205,"text":"燃え尽きないものを数えて","translation":"다 타지 않는 것들을 세어","kind":"lyric"},{"id":"34","start":152.265,"end":158.266,"text":"摘みたいだけ","translation":"따고 싶을 뿐","kind":"lyric"},{"id":"35","start":165.235,"end":168.531,"text":"半信半疑の満身創痍で尚","translation":"반신반의하며 만신창이인 채로도","kind":"lyric"},{"id":"36","start":168.591,"end":170.54,"text":"太陽が欲しい","translation":"태양을 원해","kind":"lyric"},{"id":"37","start":170.6,"end":174.02,"text":"だからもっと私に火をつけて","translation":"그러니 내게 더 불을 붙여","kind":"lyric"},{"id":"38","start":174.076,"end":177.231,"text":"吐き出して","translation":"토해 내","kind":"lyric"},{"id":"39","start":177.287,"end":182.804,"text":"超能力でも創作物でも現実逃避でもいい","translation":"초능력이든 창작물이든 현실 도피든 좋아","kind":"lyric"},{"id":"40","start":182.86,"end":185.72,"text":"もっと私に火をつけて","translation":"내게 더 불을 붙여","kind":"lyric"},{"id":"41","start":185.72,"end":187.98,"text":"私を震わせて","translation":"나를 떨게 해","kind":"lyric"},{"id":"42","start":198.143,"end":201.439,"text":"夕夕夕夕夕、目を焼け","translation":"저녁 저녁 저녁 저녁 저녁 눈을 태워","kind":"lyric"},{"id":"43","start":201.511,"end":205.358,"text":"魂の白い白い色で","translation":"영혼의 새하얀 빛깔로","kind":"lyric"},{"id":"44","start":205.43,"end":211.28,"text":"喜びの火に火をつけたいだけ","translation":"기쁨의 불에 불을 붙이고 싶을 뿐","kind":"lyric"},{"id":"45","start":211.339,"end":214.101,"text":"想像の頭上の上を行け","translation":"상상의 머리 위보다 더 높이 가","kind":"lyric"},{"id":"46","start":214.16,"end":217.18,"text":"冷めない言葉の両手で","translation":"식지 않는 말의 두 손으로","kind":"lyric"},{"id":"47","start":217.94,"end":222.18,"text":"燃え尽きたものも全て","translation":"다 타 버린 것까지 모두","kind":"lyric"},{"id":"48","start":222.92,"end":224.48,"text":"掬いたいだけ","translation":"건져 올리고 싶을 뿐","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}