{"title":"Love Is an Open Door","artist":"Frozen","sourceId":"reference:JmfdPVrhWbBxG51WXMAw","sourceHash":"8df73cbd38cd4e2224321fde1775bfb14e989c2b4abf23f9afed628692648b7a","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":33751985,"cues":[{"id":"1","start":5.72,"end":9.23,"text":"Anna: Okay, can I just, say something crazy?","translation":"","kind":"lyric"},{"id":"2","start":9.23,"end":10.23,"text":"Hans: I love crazy!","translation":"","kind":"lyric"},{"id":"3","start":10.23,"end":13.88,"text":"Anna: All my life has been a series of doors in my face","translation":"","kind":"lyric"},{"id":"4","start":13.88,"end":17.75,"text":"And then suddenly I bumped into you","translation":"","kind":"lyric"},{"id":"5","start":17.75,"end":19.09,"text":"I was thinking the same thing! 'Cause, like","translation":"","kind":"lyric"},{"id":"6","start":19.09,"end":23.34,"text":"I've been searching my whole life to find my own place","translation":"","kind":"lyric"},{"id":"7","start":23.34,"end":28.29,"text":"And maybe it's the party talking or the chocolate fondue","translation":"","kind":"lyric"},{"id":"8","start":28.29,"end":29.27,"text":"But with you","translation":"","kind":"lyric"},{"id":"9","start":29.27,"end":30.28,"text":"But with you","translation":"","kind":"lyric"},{"id":"10","start":30.28,"end":31.78,"text":"I found my place","translation":"","kind":"lyric"},{"id":"11","start":31.78,"end":33.3,"text":"I see your face","translation":"","kind":"lyric"},{"id":"12","start":33.3,"end":36.93,"text":"And it's nothing like I've ever known before","translation":"","kind":"lyric"},{"id":"13","start":36.93,"end":41.77,"text":"Love is an open door","translation":"","kind":"lyric"},{"id":"14","start":41.77,"end":46.96,"text":"Love is an open door","translation":"","kind":"lyric"},{"id":"15","start":46.96,"end":48.46,"text":"Love is an open door","translation":"","kind":"lyric"},{"id":"16","start":48.46,"end":49.21,"text":"With you","translation":"","kind":"lyric"},{"id":"17","start":49.21,"end":49.94,"text":"With you","translation":"","kind":"lyric"},{"id":"18","start":49.94,"end":50.82,"text":"With you","translation":"","kind":"lyric"},{"id":"19","start":50.82,"end":51.67,"text":"With you","translation":"","kind":"lyric"},{"id":"20","start":51.67,"end":62.41,"text":"Love is an open door","translation":"","kind":"lyric"},{"id":"21","start":62.41,"end":63.15,"text":"I mean it's crazy","translation":"","kind":"lyric"},{"id":"22","start":63.15,"end":63.68,"text":"What?","translation":"","kind":"lyric"},{"id":"23","start":63.68,"end":64.63,"text":"We finish each other's","translation":"","kind":"lyric"},{"id":"24","start":64.63,"end":65.59,"text":"Sandwiches","translation":"","kind":"lyric"},{"id":"25","start":65.59,"end":66.75,"text":"That's what I was gonna say!","translation":"","kind":"lyric"},{"id":"26","start":66.75,"end":68.06,"text":"I've never met someone","translation":"","kind":"lyric"},{"id":"27","start":68.06,"end":70.21000000000001,"text":"Who thinks so much like me","translation":"","kind":"lyric"},{"id":"28","start":70.21000000000001,"end":72.08,"text":"Jinx! Jinx again!","translation":"","kind":"lyric"},{"id":"29","start":72.08,"end":73.77,"text":"Our mental synchronization","translation":"","kind":"lyric"},{"id":"30","start":73.77,"end":76.59,"text":"Can have but one explanation","translation":"","kind":"lyric"},{"id":"31","start":76.59,"end":77.31,"text":"You","translation":"","kind":"lyric"},{"id":"32","start":77.31,"end":78.0,"text":"And I","translation":"","kind":"lyric"},{"id":"33","start":78.0,"end":78.62,"text":"Were","translation":"","kind":"lyric"},{"id":"34","start":78.62,"end":79.28999999999999,"text":"Just","translation":"","kind":"lyric"},{"id":"35","start":79.28999999999999,"end":81.56,"text":"Meant to be","translation":"","kind":"lyric"},{"id":"36","start":81.56,"end":83.22,"text":"Say goodbye","translation":"","kind":"lyric"},{"id":"37","start":83.22,"end":83.83,"text":"Say goodbye","translation":"","kind":"lyric"},{"id":"38","start":83.83,"end":86.05,"text":"To the pain of the past","translation":"","kind":"lyric"},{"id":"39","start":86.05,"end":90.0,"text":"We don't have to feel it any more","translation":"","kind":"lyric"},{"id":"40","start":90.0,"end":94.81,"text":"Love is an open door","translation":"","kind":"lyric"},{"id":"41","start":94.81,"end":99.44,"text":"Love is an open door","translation":"","kind":"lyric"},{"id":"42","start":99.44,"end":101.3,"text":"Life can be so much more","translation":"","kind":"lyric"},{"id":"43","start":101.3,"end":102.34,"text":"With you","translation":"","kind":"lyric"},{"id":"44","start":102.34,"end":103.12,"text":"With you","translation":"","kind":"lyric"},{"id":"45","start":103.12,"end":103.97,"text":"With you","translation":"","kind":"lyric"},{"id":"46","start":103.97,"end":104.50999999999999,"text":"With you","translation":"","kind":"lyric"},{"id":"47","start":104.50999999999999,"end":110.63,"text":"Love is an open door","translation":"","kind":"lyric"},{"id":"48","start":110.63,"end":113.22,"text":"Can I say something crazy? Will you marry me?","translation":"","kind":"lyric"},{"id":"49","start":113.22,"end":119.72999999999999,"text":"Can I say something even crazier? Yes!","translation":"","kind":"lyric"}],"candidates":[]}