{"originalLanguage":"ja","title":"서방님과 러브러브 러브송","artist":"フェンリース(CV:釘宮理恵)","date":"2026-07-20","sourceId":"UBCB2e0Aik4:042","sourceHash":"e5ce34b9f31d975844829d4a5c53ed7b42464c536172202a61f6cc7047e8c44d","duration":179.1,"cues":[{"id":"1","start":10.181931,"end":16.084743,"text":"誰にでも優しくしないで でもそこが好き！","translation":"누구에게나 다정하게 굴지 마 그래도 그게 좋아","kind":"lyric"},{"id":"2","start":16.084743,"end":19.786506,"text":"胸がキュンキュン お耳ピコピコ","translation":"가슴이 두근두근 귀가 쫑긋쫑긋","kind":"lyric"},{"id":"3","start":19.786506,"end":22.847964,"text":"側にいさせて","translation":"곁에 있게 해줘","kind":"lyric"},{"id":"4","start":22.847964,"end":25.709,"text":"「旦那様」キュンキュン","translation":"서방님 두근두근","kind":"lyric"},{"id":"5","start":25.709,"end":28.59,"text":"「旦那様」ピコピコ","translation":"서방님 쫑긋쫑긋","kind":"lyric"},{"id":"6","start":28.5907,"end":31.632,"text":"「旦那様」キュンキュン","translation":"서방님 두근두근","kind":"lyric"},{"id":"7","start":31.632,"end":34.333,"text":"「旦那様」ピコピコ","translation":"서방님 쫑긋쫑긋","kind":"lyric"},{"id":"8","start":34.333,"end":37.194,"text":"ダメよ 分かってても","translation":"안 돼 알고 있어도","kind":"lyric"},{"id":"9","start":37.194799,"end":40.436,"text":"ダメよ ヤキモチ焼いちゃう","translation":"안 돼 질투가 나버려","kind":"lyric"},{"id":"10","start":40.436,"end":42.997,"text":"ダメよ 渡さないわ","translation":"안 돼 누구에게도 안 줘","kind":"lyric"},{"id":"11","start":42.997563,"end":45.69885,"text":"ダメよ ラブラブだから","translation":"안 돼 러브러브니까","kind":"lyric"},{"id":"12","start":45.69885,"end":51.621671,"text":"運命って世界も越えちゃうのかしら？","translation":"운명이란 세상도 뛰어넘을 수 있을까","kind":"lyric"},{"id":"13","start":51.621671,"end":55.183,"text":"心に決めたの","translation":"마음속으로 정했어","kind":"lyric"},{"id":"14","start":55.183,"end":59.565,"text":"あなた（あなた）あなた（あなた）だけよ","translation":"당신 당신 당신 당신뿐이야","kind":"lyric"},{"id":"15","start":59.565,"end":65.948,"text":"誰とでも仲良くしないで でもそこが好き！","translation":"누구와도 사이좋게 지내지 마 그래도 그게 좋아","kind":"lyric"},{"id":"16","start":66.498758,"end":69.19,"text":"胸がキュンキュン お耳ピコピコ","translation":"가슴이 두근두근 귀가 쫑긋쫑긋","kind":"lyric"},{"id":"17","start":69.19,"end":71.591,"text":"私だけ見て","translation":"나만 봐줘","kind":"lyric"},{"id":"18","start":71.881,"end":77.754,"text":"旦那様こんなに夢中よんー全部好き！","translation":"서방님 이렇게 푹 빠졌어 전부 좋아","kind":"lyric"},{"id":"19","start":78.234,"end":80.935,"text":"ほっぺデレデレ 尻尾プンプン","translation":"볼은 헤실헤실 꼬리는 씩씩","kind":"lyric"},{"id":"20","start":80.935636,"end":83.257,"text":"どんな時でも","translation":"어느 때라도","kind":"lyric"},{"id":"21","start":84.377,"end":86.238,"text":"側にいさせて","translation":"곁에 있게 해줘","kind":"lyric"},{"id":"22","start":87.748881,"end":92.120964,"text":"わたし 妻なので 妻なので","translation":"나 아내니까 아내니까","kind":"lyric"},{"id":"23","start":92.120964,"end":95.122,"text":"そうよ 妻ですの 妻ですの","translation":"그래요 아내랍니다 아내랍니다","kind":"lyric"},{"id":"24","start":95.122,"end":98.063,"text":"もっと 妻として 妻として","translation":"더욱 아내로서 아내로서","kind":"lyric"},{"id":"25","start":98.063795,"end":100.945,"text":"あなた 笑顔にしてみせる","translation":"당신을 웃게 해 보일게","kind":"lyric"},{"id":"26","start":101.845596,"end":107.548,"text":"だからちょっと愛が重くてもいいでしょ？","translation":"그러니 사랑이 조금 무거워도 괜찮지","kind":"lyric"},{"id":"27","start":108.448742,"end":110.489714,"text":"何でもしちゃうの","translation":"뭐든 해 버릴 거야","kind":"lyric"},{"id":"28","start":110.489714,"end":112.540691,"text":"あなた（あなた）あなた（あなた）だけよ","translation":"당신 당신 당신 당신뿐이야","kind":"lyric"},{"id":"29","start":112.540691,"end":122.355,"text":"誰にでも優しくしないで 拗ねちゃうかもよ","translation":"누구에게나 다정하게 굴지 마 삐질지도 몰라","kind":"lyric"},{"id":"30","start":122.355,"end":126.297,"text":"胸がチクチク お耳垂れちゃう","translation":"가슴이 콕콕 귀가 축 처져","kind":"lyric"},{"id":"31","start":126.367,"end":128.028,"text":"もっと構って","translation":"좀 더 신경 써줘","kind":"lyric"},{"id":"32","start":128.028,"end":134.521,"text":"だけどそのお人好しさえも 結局ね 好き！","translation":"하지만 그 상냥함마저도 결국은 좋아","kind":"lyric"},{"id":"33","start":134.521,"end":137.562,"text":"やっぱキュンキュン お耳ピコピコ","translation":"역시 두근두근 귀가 쫑긋쫑긋","kind":"lyric"},{"id":"34","start":137.562611,"end":140.084,"text":"そのままでいて","translation":"그대로 있어줘","kind":"lyric"},{"id":"35","start":140.383955,"end":146.027,"text":"誓います 一生一緒よんーずっと好き！","translation":"맹세할게 평생 함께야 계속 좋아","kind":"lyric"},{"id":"36","start":146.246748,"end":149.588,"text":"何があっても どんな場所でも","translation":"무슨 일이 있어도 어느 곳에 있어도","kind":"lyric"},{"id":"37","start":149.868,"end":151.669,"text":"側にいさせて","translation":"곁에 있게 해줘","kind":"lyric"},{"id":"38","start":151.869,"end":155.411,"text":"たまにはゆっくりデートしましょ","translation":"가끔은 느긋하게 데이트해요","kind":"lyric"},{"id":"39","start":158.272,"end":159.373,"text":"ココロふにゃふにゃ不意にドキドキ","translation":"마음이 흐물흐물 문득 두근두근","kind":"lyric"},{"id":"40","start":159.373,"end":163.114783,"text":"あなたがいれば","translation":"당신이 있으면","kind":"lyric"},{"id":"41","start":163.114783,"end":165.575955,"text":"いつも幸せ","translation":"언제나 행복해","kind":"lyric"},{"id":"42","start":165.575955,"end":165.896,"text":"「ぎゅっ！」","translation":"꼬옥","kind":"lyric"},{"id":"43","start":165.896,"end":169.767952,"text":"ラブラブ・ラブソング","translation":"러브러브 러브송","kind":"lyric"},{"id":"44","start":169.767952,"end":172.729,"text":"ラブラブ・ラブソング","translation":"러브러브 러브송","kind":"lyric"},{"id":"45","start":172.729,"end":175.981,"text":"ラブラブ・ラブソング","translation":"러브러브 러브송","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}