{"title":"Mushrooms","artist":"Mili","sourceId":"reference:Cy9oWQYMXapnxG29MBMu","sourceHash":"89dee2095ab4b893e9a91eb20f3da3bc5932a6859f4f87b106bdf45f371daffd","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":6.07,"end":9.07,"text":"Felixe huoven neen tur agarica","translation":"","kind":"lyric"},{"id":"2","start":10.47,"end":13.47,"text":"Tallus tallus ne","translation":"","kind":"lyric"},{"id":"3","start":13.68,"end":16.68,"text":"Cibum hex a tallus","translation":"","kind":"lyric"},{"id":"4","start":16.73,"end":19.73,"text":"Cibum agarica","translation":"","kind":"lyric"},{"id":"5","start":21.33,"end":24.33,"text":"Feathers, stabbed by my own words","translation":"","kind":"lyric"},{"id":"6","start":24.78,"end":27.78,"text":"I can fly no more","translation":"","kind":"lyric"},{"id":"7","start":31.36,"end":34.36,"text":"All the mushrooms looked at me","translation":"","kind":"lyric"},{"id":"8","start":34.82,"end":37.82,"text":"Looked at me","translation":"","kind":"lyric"},{"id":"9","start":38.07,"end":41.02,"text":"All the mushrooms surround me","translation":"","kind":"lyric"},{"id":"10","start":41.02,"end":44.02,"text":"Surround me","translation":"","kind":"lyric"},{"id":"11","start":44.06,"end":47.06,"text":"All the mushrooms looked at me","translation":"","kind":"lyric"},{"id":"12","start":47.1,"end":50.1,"text":"Looked at me","translation":"","kind":"lyric"},{"id":"13","start":50.27,"end":53.27,"text":"All the mushrooms surround me","translation":"","kind":"lyric"},{"id":"14","start":53.43,"end":55.96,"text":"Surround me","translation":"","kind":"lyric"},{"id":"15","start":55.96,"end":58.96,"text":"I've walked across the witch's scalp","translation":"","kind":"lyric"},{"id":"16","start":61.46,"end":64.46000000000001,"text":"Pulled out her follicles","translation":"","kind":"lyric"},{"id":"17","start":65.11,"end":66.69,"text":"I'm a raging bird","translation":"","kind":"lyric"},{"id":"18","start":66.69,"end":68.83,"text":"Pecked off layers of their stems","translation":"","kind":"lyric"},{"id":"19","start":68.83,"end":70.42,"text":"Won't let them see my tears","translation":"","kind":"lyric"},{"id":"20","start":70.42,"end":72.97,"text":"Won't let them taste my fear","translation":"","kind":"lyric"},{"id":"21","start":72.97,"end":75.32,"text":"Automated decapitation","translation":"","kind":"lyric"},{"id":"22","start":75.32,"end":76.73,"text":"Won't let them see my tears","translation":"","kind":"lyric"},{"id":"23","start":76.73,"end":78.44,"text":"Won't let them taste my fear","translation":"","kind":"lyric"},{"id":"24","start":78.44,"end":81.44,"text":"Lula lila dulalila dalila dulila","translation":"","kind":"lyric"},{"id":"25","start":84.53,"end":87.53,"text":"And I thought that this is the triumph","translation":"","kind":"lyric"},{"id":"26","start":90.59,"end":93.59,"text":"That I needed to move on","translation":"","kind":"lyric"},{"id":"27","start":96.89,"end":99.89,"text":"I've blamed everything on you","translation":"","kind":"lyric"},{"id":"28","start":101.28999999999999,"end":104.28999999999999,"text":"It's easy to just pretend","translation":"","kind":"lyric"},{"id":"29","start":108.25999999999999,"end":111.25999999999999,"text":"You gently peeled open the wings","translation":"","kind":"lyric"},{"id":"30","start":112.06,"end":115.06,"text":"Covering my humiliated face","translation":"","kind":"lyric"},{"id":"31","start":120.63,"end":123.63,"text":"I was so ashamed","translation":"","kind":"lyric"},{"id":"32","start":126.84,"end":128.44,"text":"The mushrooms spoke","translation":"","kind":"lyric"},{"id":"33","start":128.44,"end":130.43,"text":"I've sat here all my life","translation":"","kind":"lyric"},{"id":"34","start":130.43,"end":133.07,"text":"Feeling sorry for myself","translation":"","kind":"lyric"},{"id":"35","start":133.07,"end":134.48,"text":"And they spoke","translation":"","kind":"lyric"},{"id":"36","start":134.48,"end":136.5,"text":"Trampled used and dumped","translation":"","kind":"lyric"},{"id":"37","start":136.5,"end":139.14,"text":"Got no pride to push them down","translation":"","kind":"lyric"},{"id":"38","start":139.14,"end":142.0,"text":"Finding peace in her suffering","translation":"","kind":"lyric"},{"id":"39","start":142.0,"end":145.0,"text":"As I go up a place in the hierarchy","translation":"","kind":"lyric"},{"id":"40","start":145.77,"end":148.77,"text":"Since when have I, have I became me?","translation":"","kind":"lyric"},{"id":"41","start":152.16,"end":153.78,"text":"I gave up crying","translation":"","kind":"lyric"},{"id":"42","start":153.78,"end":155.47,"text":"I gave up waiting","translation":"","kind":"lyric"},{"id":"43","start":155.47,"end":158.32999999999998,"text":"I gave up dreaming optimistic dreams","translation":"","kind":"lyric"},{"id":"44","start":158.32999999999998,"end":161.32999999999998,"text":"Ripped out my feathers","translation":"","kind":"lyric"},{"id":"45","start":164.0,"end":166.93,"text":"Cracked up my beak","translation":"","kind":"lyric"},{"id":"46","start":166.93,"end":169.9,"text":"Freed my screams","translation":"","kind":"lyric"},{"id":"47","start":169.9,"end":172.9,"text":"Your spores cling onto my skin","translation":"","kind":"lyric"},{"id":"48","start":173.82,"end":176.82,"text":"Powdery snow cleared up my sins","translation":"","kind":"lyric"},{"id":"49","start":179.23,"end":182.23,"text":"Through my pores tiny fibers sprout out","translation":"","kind":"lyric"},{"id":"50","start":184.34,"end":187.34,"text":"Grow into stems and caps","translation":"","kind":"lyric"},{"id":"51","start":190.34,"end":193.34,"text":"All the mushrooms looked at me","translation":"","kind":"lyric"},{"id":"52","start":193.61,"end":196.56,"text":"Looked at me","translation":"","kind":"lyric"},{"id":"53","start":196.56,"end":199.56,"text":"All the mushrooms surround me","translation":"","kind":"lyric"},{"id":"54","start":199.57999999999998,"end":201.56,"text":"Surround me","translation":"","kind":"lyric"},{"id":"55","start":201.56,"end":203.09,"text":"Mushroom mushroom-shroom","translation":"","kind":"lyric"},{"id":"56","start":203.09,"end":205.17000000000002,"text":"Mushroom mushroom mushroom-shroom","translation":"","kind":"lyric"},{"id":"57","start":205.17000000000002,"end":206.15,"text":"Mushroom mu-mu-shroom-shroom","translation":"","kind":"lyric"},{"id":"58","start":206.15,"end":207.68,"text":"Lalalala ah","translation":"","kind":"lyric"},{"id":"59","start":207.68,"end":209.14,"text":"Mushroom mushroom-shroom","translation":"","kind":"lyric"},{"id":"60","start":209.14,"end":210.72,"text":"Mushroom mushroom mushroom-shroom","translation":"","kind":"lyric"},{"id":"61","start":210.72,"end":212.12,"text":"Mushroom mu-mu-shroom-shroom","translation":"","kind":"lyric"},{"id":"62","start":212.12,"end":214.07999999999998,"text":"Lalalalala","translation":"","kind":"lyric"},{"id":"63","start":214.07999999999998,"end":217.07999999999998,"text":"Nixia pundrun agarica","translation":"","kind":"lyric"}],"candidates":[]}