{"title":"성스러운 시인의 섬 -레스보스-","artist":"Sound Horizon","sourceId":"reference:Vg9vfn9L6CqvHgl7rx3Q","sourceHash":"b87fc7fcb0897514dae50e342f728fd98d7197397517a8bc473a7ed323cc081e","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":1.23,"end":4.23,"text":"「ソフィア先生、フィリスです","translation":"","kind":"lyric"},{"id":"2","start":4.99,"end":7.64,"text":"浜辺で少女が倒れていたので","translation":"","kind":"lyric"},{"id":"3","start":7.64,"end":9.9,"text":"介抱し、連れて参りました」","translation":"","kind":"lyric"},{"id":"4","start":9.9,"end":11.72,"text":"「お入りなさい」","translation":"","kind":"lyric"},{"id":"5","start":11.72,"end":14.72,"text":"「失礼します。さ、 アルテミシアさん」","translation":"","kind":"lyric"},{"id":"6","start":17.24,"end":18.58,"text":"「あ、はい」","translation":"","kind":"lyric"},{"id":"7","start":18.58,"end":21.58,"text":"【詩を詠む聖女: Σοφια】","translation":"","kind":"lyric"},{"id":"8","start":24.97,"end":27.97,"text":"嗚呼 哀しみは 海の色","translation":"","kind":"lyric"},{"id":"9","start":33.85,"end":36.85,"text":"蒼く 碧く","translation":"","kind":"lyric"},{"id":"10","start":39.6,"end":42.6,"text":"嗚呼 苦しみは 波の音","translation":"","kind":"lyric"},{"id":"11","start":47.54,"end":50.54,"text":"強く 弱く","translation":"","kind":"lyric"},{"id":"12","start":53.38,"end":56.38,"text":"少女の頬は 薔薇色に","translation":"","kind":"lyric"},{"id":"13","start":60.47,"end":63.47,"text":"輝きて 美しの","translation":"","kind":"lyric"},{"id":"14","start":66.76,"end":69.76,"text":"されど 若き蕾は","translation":"","kind":"lyric"},{"id":"15","start":70.93,"end":73.93,"text":"悲しみに 濡れて","translation":"","kind":"lyric"},{"id":"16","start":74.65,"end":77.65,"text":"未だ 開かず","translation":"","kind":"lyric"},{"id":"17","start":84.85,"end":87.85,"text":"閉ざした瞳は 対の闇","translation":"","kind":"lyric"},{"id":"18","start":93.5,"end":96.5,"text":"暗く 冥く","translation":"","kind":"lyric"},{"id":"19","start":98.97,"end":101.97,"text":"鎖ざした菫は 終の夢","translation":"","kind":"lyric"},{"id":"20","start":107.47999999999999,"end":110.47999999999999,"text":"甘く 苦く","translation":"","kind":"lyric"},{"id":"21","start":113.52000000000001,"end":116.52000000000001,"text":"何もない 場処だけれど","translation":"","kind":"lyric"},{"id":"22","start":120.38,"end":123.38,"text":"水と光 愛は満ち足りてよ","translation":"","kind":"lyric"},{"id":"23","start":126.95,"end":129.95,"text":"ようこそ此処は【詩人の島】(レスボス)","translation":"","kind":"lyric"},{"id":"24","start":131.01,"end":134.01,"text":"海原女神と 太陽神","translation":"","kind":"lyric"},{"id":"25","start":134.13,"end":137.13,"text":"腕白き 美女神の聖域","translation":"","kind":"lyric"},{"id":"26","start":165.81,"end":168.81,"text":"貴方が見て来たものも 嗚呼","translation":"","kind":"lyric"},{"id":"27","start":170.97,"end":173.97,"text":"世の真実","translation":"","kind":"lyric"},{"id":"28","start":174.99,"end":177.99,"text":"不条理ばかり訪れる 嗚於","translation":"","kind":"lyric"},{"id":"29","start":180.09,"end":182.69,"text":"嫌な現実","translation":"","kind":"lyric"},{"id":"30","start":182.69,"end":185.69,"text":"されど 世界は","translation":"","kind":"lyric"},{"id":"31","start":187.32,"end":190.32,"text":"其れだけではないのよ","translation":"","kind":"lyric"},{"id":"32","start":192.03,"end":195.03,"text":"ねぇ お嬢さん(ミーシャ) 宜しくて?","translation":"","kind":"lyric"},{"id":"33","start":201.19,"end":203.56,"text":"辛いし 痛いし 酷いし 嫌だと","translation":"","kind":"lyric"},{"id":"34","start":203.56,"end":205.44,"text":"泣き喚いてみても","translation":"","kind":"lyric"},{"id":"35","start":205.44,"end":207.8,"text":"運命の 白き糸を","translation":"","kind":"lyric"},{"id":"36","start":207.8,"end":210.3,"text":"人間は 紡げない","translation":"","kind":"lyric"},{"id":"37","start":210.3,"end":212.53,"text":"怖れず 揺るがず 妬まず 恨まず","translation":"","kind":"lyric"},{"id":"38","start":212.53,"end":214.57999999999998,"text":"誰よりも 強かに","translation":"","kind":"lyric"},{"id":"39","start":214.57999999999998,"end":216.86,"text":"美しく 世に咲き誇る","translation":"","kind":"lyric"},{"id":"40","start":216.86,"end":219.53,"text":"女に 成りなさい","translation":"","kind":"lyric"},{"id":"41","start":219.53,"end":222.53,"text":"【紡がれる縦糸】","translation":"","kind":"lyric"},{"id":"42","start":223.41,"end":226.41,"text":"【聖女は少女の不思議な力を見抜き】","translation":"","kind":"lyric"},{"id":"43","start":230.42000000000002,"end":233.42000000000002,"text":"【彼女が生きる道と術を示した】","translation":"","kind":"lyric"},{"id":"44","start":256.89,"end":259.89,"text":"【記憶の水底】","translation":"","kind":"lyric"},{"id":"45","start":260.48,"end":263.48,"text":"かつて (そうね) 烈しく (誰より)","translation":"","kind":"lyric"},{"id":"46","start":264.76,"end":267.76,"text":"愛した人がいたのよ (彼女にも)","translation":"","kind":"lyric"},{"id":"47","start":269.44,"end":272.44,"text":"されど (今は) 遠くへ (彼岸へ)","translation":"","kind":"lyric"},{"id":"48","start":274.11,"end":277.11,"text":"行ってしまったわ","translation":"","kind":"lyric"},{"id":"49","start":278.15999999999997,"end":281.15999999999997,"text":"愛とは 褥に 仕える為の 奴隷ではないわ","translation":"","kind":"lyric"},{"id":"50","start":282.71,"end":285.71,"text":"まして 子を孕む為の 道具ではない","translation":"","kind":"lyric"},{"id":"51","start":287.19,"end":288.47,"text":"嗚呼 天空を 大地を","translation":"","kind":"lyric"},{"id":"52","start":288.47,"end":289.48,"text":"海原を 人間を","translation":"","kind":"lyric"},{"id":"53","start":289.48,"end":291.74,"text":"己が 運命を愛し","translation":"","kind":"lyric"},{"id":"54","start":291.74,"end":293.78,"text":"哀しみさえ 糧に出来る","translation":"","kind":"lyric"},{"id":"55","start":293.78,"end":296.78,"text":"女に 成りなさい","translation":"","kind":"lyric"}],"candidates":[]}