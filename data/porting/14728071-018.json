{"originalLanguage":"ja","title":"괴물","artist":"YOASOBI","date":"2026-08-16","sourceId":"14728071:018","sourceHash":"e1ac8153992ce4357cdc46881a5b6ae2bce60f131d62edd7eacdc5d7e68da17b","duration":209.5,"cues":[{"id":"1","start":5.0,"end":8.88,"text":"あぁ素晴らしき世界に今日も乾杯","translation":"아아 멋진 세상에 오늘도 건배","kind":"lyric"},{"id":"2","start":8.88,"end":10.76,"text":"街に飛び交う笑い声も","translation":"거리에 오가는 웃음소리도","kind":"lyric"},{"id":"3","start":10.76,"end":14.24,"text":"見て見ぬフリしてるだけの作りもんさ","translation":"못 본 척할 뿐인 가짜야","kind":"lyric"},{"id":"4","start":15.0,"end":16.28,"text":"気が触れそうだ","translation":"정신이 나갈 것 같아","kind":"lyric"},{"id":"5","start":16.28,"end":19.26,"text":"クラクラするほどの良い匂いが","translation":"어질어질할 만큼 좋은 냄새가","kind":"lyric"},{"id":"6","start":19.26,"end":21.04,"text":"ツンと刺した鼻の奥","translation":"코끝 깊숙이 찔러 와","kind":"lyric"},{"id":"7","start":21.04,"end":23.6,"text":"目を覚ます本能のまま","translation":"깨어나는 본능 그대로","kind":"lyric"},{"id":"8","start":23.6,"end":25.6,"text":"今日は誰の番だ？","translation":"오늘은 누구 차례야","kind":"lyric"},{"id":"9","start":25.6,"end":30.28,"text":"この世界で何が出来るのか","translation":"이 세상에서 무엇을 할 수 있을까","kind":"lyric"},{"id":"10","start":30.28,"end":32.96,"text":"僕には何が出来るのか","translation":"나는 무엇을 할 수 있을까","kind":"lyric"},{"id":"11","start":32.96,"end":35.72,"text":"ただその真っ黒な目から","translation":"그저 그 새까만 눈에서","kind":"lyric"},{"id":"12","start":35.72,"end":38.8,"text":"涙零れ落ちないように","translation":"눈물이 흘러내리지 않도록","kind":"lyric"},{"id":"13","start":38.8,"end":41.96,"text":"あぁ願う未来に何度でもずっと","translation":"아아 바라는 미래에 몇 번이고 계속","kind":"lyric"},{"id":"14","start":42.02,"end":43.52,"text":"喰らい尽くす","translation":"모조리 먹어 치워","kind":"lyric"},{"id":"15","start":43.58,"end":47.12,"text":"この間違いだらけの世界の中","translation":"이 잘못투성이 세상 속에서","kind":"lyric"},{"id":"16","start":47.14,"end":50.34,"text":"君には笑ってほしいから","translation":"네가 웃어 주길 바라니까","kind":"lyric"},{"id":"17","start":51.0,"end":52.86,"text":"もう誰も傷付けない","translation":"이제 누구도 상처 입히지 않아","kind":"lyric"},{"id":"18","start":52.86,"end":55.4,"text":"強く強くなりたいんだよ","translation":"강하게 강하게 되고 싶어","kind":"lyric"},{"id":"19","start":55.4,"end":60.7,"text":"僕が僕でいられるように","translation":"내가 나로 있을 수 있도록","kind":"lyric"},{"id":"20","start":67.94,"end":70.12,"text":"素晴らしき世界は今日も安泰","translation":"멋진 세상은 오늘도 평안해","kind":"lyric"},{"id":"21","start":70.18,"end":73.16,"text":"街に渦巻く悪い話も","translation":"거리에 소용돌이치는 나쁜 이야기도","kind":"lyric"},{"id":"22","start":73.22,"end":76.38,"text":"知らない知らないフリして目を逸らした","translation":"몰라 모르는 척 눈을 돌렸어","kind":"lyric"},{"id":"23","start":77.0,"end":79.76,"text":"正気の沙汰じゃないな","translation":"정상적인 짓이 아니네","kind":"lyric"},{"id":"24","start":79.76,"end":81.38,"text":"真面目に着飾った行進","translation":"진지하게 차려입은 행진","kind":"lyric"},{"id":"25","start":81.42,"end":84.52,"text":"鳴らす足音が弾む行き先は","translation":"울리는 발소리가 들뜬 채 향하는 곳은","kind":"lyric"},{"id":"26","start":84.52,"end":88.06,"text":"消えない消えない味が染み付いている","translation":"사라지지 않는 맛이 배어 있는","kind":"lyric"},{"id":"27","start":88.4,"end":93.36,"text":"裏側の世界","translation":"이면의 세계","kind":"lyric"},{"id":"28","start":100.98,"end":103.54,"text":"清く正しく生きること","translation":"맑고 올바르게 사는 것","kind":"lyric"},{"id":"29","start":103.54,"end":106.38,"text":"誰も悲しませずに生きること","translation":"아무도 슬프게 하지 않고 사는 것","kind":"lyric"},{"id":"30","start":106.38,"end":109.16,"text":"はみ出さず真っ直ぐに生きること","translation":"벗어나지 않고 똑바로 사는 것","kind":"lyric"},{"id":"31","start":109.22,"end":112.52,"text":"それが間違わないで生きること？","translation":"그게 틀리지 않게 사는 것일까","kind":"lyric"},{"id":"32","start":112.52,"end":114.88,"text":"ありのまま生きることが正義か","translation":"있는 그대로 사는 것이 정의인가","kind":"lyric"},{"id":"33","start":114.92,"end":117.76,"text":"騙し騙し生きるのは正義か","translation":"속이고 속이며 사는 것이 정의인가","kind":"lyric"},{"id":"34","start":117.84,"end":120.5,"text":"僕の在るべき姿とはなんだ","translation":"내가 있어야 할 모습은 무엇이야","kind":"lyric"},{"id":"35","start":120.5,"end":123.18,"text":"本当の僕は何者なのか","translation":"진짜 나는 누구인 걸까","kind":"lyric"},{"id":"36","start":123.18,"end":124.78,"text":"教えてくれよ","translation":"알려 줘","kind":"lyric"},{"id":"37","start":128.12,"end":134.8,"text":"教えてくれよ","translation":"알려 줘","kind":"lyric"},{"id":"38","start":134.8,"end":135.18,"text":"今日も","translation":"오늘도","kind":"lyric"},{"id":"39","start":135.18,"end":137.76,"text":"答えのない世界の中で","translation":"답 없는 세상 속에서","kind":"lyric"},{"id":"40","start":137.76,"end":139.66,"text":"願ってるんだよ","translation":"바라고 있어","kind":"lyric"},{"id":"41","start":139.66,"end":141.08,"text":"不器用だけれど","translation":"서툴지만","kind":"lyric"},{"id":"42","start":141.14,"end":144.52,"text":"いつまでも君とただ","translation":"언제까지나 너와 그저","kind":"lyric"},{"id":"43","start":144.54,"end":146.5,"text":"笑っていたいから","translation":"함께 웃고 싶으니까","kind":"lyric"},{"id":"44","start":146.52,"end":148.78,"text":"あぁ跳ねる心臓が","translation":"아아 뛰는 심장이","kind":"lyric"},{"id":"45","start":148.86,"end":151.4,"text":"体揺らし叫ぶんだよ","translation":"몸을 흔들며 외쳐","kind":"lyric"},{"id":"46","start":151.46,"end":154.24,"text":"今こそ動き出せ","translation":"지금이야 움직여","kind":"lyric"},{"id":"47","start":154.56,"end":157.72,"text":"あぁ弱い自分を何度でもずっと","translation":"아아 나약한 자신을 몇 번이고 계속","kind":"lyric"},{"id":"48","start":157.72,"end":159.04,"text":"喰らい尽くす","translation":"모조리 먹어 치워","kind":"lyric"},{"id":"49","start":159.1,"end":162.82,"text":"この間違いだらけの世界の中","translation":"이 잘못투성이 세상 속에서","kind":"lyric"},{"id":"50","start":162.86,"end":166.12,"text":"君には笑ってほしいから","translation":"네가 웃어 주길 바라니까","kind":"lyric"},{"id":"51","start":166.18,"end":168.44,"text":"もう誰も泣かないよう","translation":"이제 누구도 울지 않도록","kind":"lyric"},{"id":"52","start":168.5,"end":171.2,"text":"強く強くなりたいんだよ","translation":"강하게 강하게 되고 싶어","kind":"lyric"},{"id":"53","start":171.26,"end":175.12,"text":"僕が僕でいられるように","translation":"내가 나로 있을 수 있도록","kind":"lyric"},{"id":"54","start":185.2,"end":188.32,"text":"ただ君を守るそのために","translation":"오직 너를 지키기 위해","kind":"lyric"},{"id":"55","start":188.32,"end":190.86,"text":"走る走る走るんだよ","translation":"달려 달려 달리는 거야","kind":"lyric"},{"id":"56","start":190.92,"end":194.56,"text":"僕の中の僕を超える","translation":"내 안의 나를 넘어서","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}