{"title":"Build Our Machine","artist":"Bendy and the Ink Machine","sourceId":"reference:l7Vx1NNED4u7hoIMwK9w","sourceHash":"88e1948332c59a7b744e914302e0ba6f0ca0ed30a629b6ca4e6f529b3b047b55","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":17768065,"cues":[{"id":"1","start":14.85,"end":16.35,"text":"They have sent you a letter","translation":"","kind":"lyric"},{"id":"2","start":16.35,"end":17.77,"text":"To come back home to play","translation":"","kind":"lyric"},{"id":"3","start":17.77,"end":18.62,"text":"But to your dismay","translation":"","kind":"lyric"},{"id":"4","start":18.62,"end":19.71,"text":"This isn't your day","translation":"","kind":"lyric"},{"id":"5","start":19.71,"end":22.01,"text":"For the happy fun time has begun to fade","translation":"","kind":"lyric"},{"id":"6","start":22.01,"end":25.44,"text":"Watch as we reanimate our corpses you abandoned","translation":"","kind":"lyric"},{"id":"7","start":25.44,"end":27.26,"text":"We're dismantled, we're mishandled","translation":"","kind":"lyric"},{"id":"8","start":27.26,"end":29.42,"text":"But we won't be skipped and swayed","translation":"","kind":"lyric"},{"id":"9","start":29.42,"end":30.72,"text":"Trapped within these walls","translation":"","kind":"lyric"},{"id":"10","start":30.72,"end":32.53,"text":"You left our souls to drip away","translation":"","kind":"lyric"},{"id":"11","start":32.53,"end":34.31,"text":"The ink decays, the walls at bay","translation":"","kind":"lyric"},{"id":"12","start":34.31,"end":36.17,"text":"But the reckoning has come today","translation":"","kind":"lyric"},{"id":"13","start":36.17,"end":36.82,"text":"You say","translation":"","kind":"lyric"},{"id":"14","start":36.82,"end":40.23,"text":"Boris has no guts 'cause you replaced it with mechanical strain","translation":"","kind":"lyric"},{"id":"15","start":40.23,"end":42.03,"text":"We've been tortured but we move forward","translation":"","kind":"lyric"},{"id":"16","start":42.03,"end":45.18,"text":"This disorder kills your day!","translation":"","kind":"lyric"},{"id":"17","start":45.18,"end":49.05,"text":"I am alive, immortalized","translation":"","kind":"lyric"},{"id":"18","start":49.05,"end":51.59,"text":"You're the creator, you traitor","translation":"","kind":"lyric"},{"id":"19","start":51.59,"end":56.04,"text":"Hey! There's no vaccine to cure our dirty needs","translation":"","kind":"lyric"},{"id":"20","start":56.04,"end":58.59,"text":"For now, you must build up our machine","translation":"","kind":"lyric"},{"id":"21","start":58.59,"end":64.57,"text":"You die tonight, tonight","translation":"","kind":"lyric"},{"id":"22","start":64.57,"end":65.88,"text":"Build up our machine","translation":"","kind":"lyric"},{"id":"23","start":65.88,"end":71.88,"text":"You die tonight, tonight","translation":"","kind":"lyric"},{"id":"24","start":71.88,"end":73.0,"text":"Build up our machine","translation":"","kind":"lyric"},{"id":"25","start":73.0,"end":77.53999999999999,"text":"You die tonight","translation":"","kind":"lyric"},{"id":"26","start":77.53999999999999,"end":80.47,"text":"So, you found all the pieces to initiate the pain","translation":"","kind":"lyric"},{"id":"27","start":80.47,"end":82.36,"text":"Our venom stains, the night remains","translation":"","kind":"lyric"},{"id":"28","start":82.36,"end":84.76,"text":"But the ending is always just the same, no gain","translation":"","kind":"lyric"},{"id":"29","start":84.76,"end":86.51,"text":"Nod your head to the beat of death","translation":"","kind":"lyric"},{"id":"30","start":86.51,"end":88.34,"text":"As you draw your last eternal breath","translation":"","kind":"lyric"},{"id":"31","start":88.34,"end":91.92,"text":"Sensations of an invasion start to course right through your veins","translation":"","kind":"lyric"},{"id":"32","start":91.92,"end":93.37,"text":"You say we have no brains","translation":"","kind":"lyric"},{"id":"33","start":93.37,"end":95.41,"text":"We're just cartoons for your portrayal","translation":"","kind":"lyric"},{"id":"34","start":95.41,"end":97.15,"text":"To tell some tale about a boat and sail","translation":"","kind":"lyric"},{"id":"35","start":97.15,"end":99.68,"text":"But sure, this inevitably unveils the fail","translation":"","kind":"lyric"},{"id":"36","start":99.68,"end":103.13,"text":"Splashes of eternal hate will flood the floor and clean your slate","translation":"","kind":"lyric"},{"id":"37","start":103.13,"end":104.99000000000001,"text":"Now, we're the tools and you're the fool","translation":"","kind":"lyric"},{"id":"38","start":104.99000000000001,"end":107.95,"text":"Our nightmare dominates!","translation":"","kind":"lyric"},{"id":"39","start":107.95,"end":111.86,"text":"I am alive, immortalized","translation":"","kind":"lyric"},{"id":"40","start":111.86,"end":114.41,"text":"You're the creator, you traitor","translation":"","kind":"lyric"},{"id":"41","start":114.41,"end":118.78,"text":"Hey! There's no vaccine to cure our dirty needs","translation":"","kind":"lyric"},{"id":"42","start":118.78,"end":121.07,"text":"For now, you must build up our machine","translation":"","kind":"lyric"},{"id":"43","start":121.07,"end":123.09,"text":"You die tonight","translation":"","kind":"lyric"},{"id":"44","start":123.09,"end":126.51,"text":"I am alive, immortalized","translation":"","kind":"lyric"},{"id":"45","start":126.51,"end":129.1,"text":"You're the creator, you traitor","translation":"","kind":"lyric"},{"id":"46","start":129.1,"end":133.52,"text":"Hey! There's no vaccine to cure our dirty needs","translation":"","kind":"lyric"},{"id":"47","start":133.52,"end":136.0,"text":"For now, you must build up our machine","translation":"","kind":"lyric"},{"id":"48","start":136.0,"end":141.97,"text":"You die tonight, tonight","translation":"","kind":"lyric"},{"id":"49","start":141.97,"end":143.12,"text":"Build up our machine","translation":"","kind":"lyric"},{"id":"50","start":143.12,"end":149.32999999999998,"text":"You die tonight, tonight","translation":"","kind":"lyric"},{"id":"51","start":149.32999999999998,"end":150.65,"text":"Build up our machine","translation":"","kind":"lyric"},{"id":"52","start":150.65,"end":152.1,"text":"You die tonight","translation":"","kind":"lyric"},{"id":"53","start":152.1,"end":153.71,"text":"I am aware","translation":"","kind":"lyric"},{"id":"54","start":153.71,"end":156.54,"text":"That your soul is now divine","translation":"","kind":"lyric"},{"id":"55","start":156.54,"end":159.3,"text":"We care to not toil with unbroken chains","translation":"","kind":"lyric"},{"id":"56","start":159.3,"end":165.54,"text":"So don't toil with ours like he did to our shining stars","translation":"","kind":"lyric"},{"id":"57","start":165.54,"end":167.52,"text":"So prepare for adventure","translation":"","kind":"lyric"},{"id":"58","start":167.52,"end":171.37,"text":"We're a whole new creature from the darkest side","translation":"","kind":"lyric"},{"id":"59","start":171.37,"end":174.11,"text":"You can't take away the pain we feel","translation":"","kind":"lyric"},{"id":"60","start":174.11,"end":178.43,"text":"Created as monsters that come to life!","translation":"","kind":"lyric"},{"id":"61","start":178.43,"end":180.92,"text":"(Come back to life)","translation":"","kind":"lyric"},{"id":"62","start":180.92,"end":182.53,"text":"So, you've come to the end now","translation":"","kind":"lyric"},{"id":"63","start":182.53,"end":183.91,"text":"Alive but dead inside","translation":"","kind":"lyric"},{"id":"64","start":183.91,"end":184.84,"text":"The heart beats loud","translation":"","kind":"lyric"},{"id":"65","start":184.84,"end":185.88,"text":"You've joined our crowd","translation":"","kind":"lyric"},{"id":"66","start":185.88,"end":188.0,"text":"We are but punished serpentines","translation":"","kind":"lyric"},{"id":"67","start":188.0,"end":189.48,"text":"Your life with him was fun","translation":"","kind":"lyric"},{"id":"68","start":189.48,"end":191.68,"text":"But now the terror's only just begun","translation":"","kind":"lyric"},{"id":"69","start":191.68,"end":193.55,"text":"Now come with me and you will see","translation":"","kind":"lyric"},{"id":"70","start":193.55,"end":196.74,"text":"We're a new-born cyanide!","translation":"","kind":"lyric"},{"id":"71","start":196.74,"end":200.29,"text":"I am alive, immortalized","translation":"","kind":"lyric"},{"id":"72","start":200.29,"end":203.04,"text":"You're the creator, you traitor","translation":"","kind":"lyric"},{"id":"73","start":203.04,"end":207.31,"text":"Hey! There's no vaccine to cure our dirty needs","translation":"","kind":"lyric"},{"id":"74","start":207.31,"end":209.79,"text":"For now you must build up our machine","translation":"","kind":"lyric"},{"id":"75","start":209.79,"end":211.65,"text":"You die tonight","translation":"","kind":"lyric"},{"id":"76","start":211.65,"end":215.22,"text":"I am alive, immortalized","translation":"","kind":"lyric"},{"id":"77","start":215.22,"end":217.82,"text":"You're the creator, you traitor","translation":"","kind":"lyric"},{"id":"78","start":217.82,"end":222.04,"text":"Hey! There's no vaccine to cure our dirty needs","translation":"","kind":"lyric"},{"id":"79","start":222.04,"end":224.38,"text":"For now you must build up our machine","translation":"","kind":"lyric"},{"id":"80","start":224.38,"end":230.64,"text":"You die tonight, tonight","translation":"","kind":"lyric"},{"id":"81","start":230.64,"end":231.88,"text":"Build up our machine","translation":"","kind":"lyric"},{"id":"82","start":231.88,"end":238.04,"text":"You die tonight, tonight!","translation":"","kind":"lyric"},{"id":"83","start":238.04,"end":239.34,"text":"Build up our machine","translation":"","kind":"lyric"},{"id":"84","start":239.34,"end":240.29,"text":"You die tonight","translation":"","kind":"lyric"}],"candidates":[]}