.97,"text":"あなたには (YES!)","translation":"","kind":"lyric"},{"id":"19","start":77.97,"end":80.97,"text":"ちゃんと見ていてくれるなら (エンジェル！)","translation":"","kind":"lyric"},{"id":"20","start":81.78999999999999,"end":83.2,"text":"やるよ多分 (ハイ！)","translation":"","kind":"lyric"},{"id":"21","start":83.2,"end":85.64,"text":"ダダダダ ダメ天使は","translation":"","kind":"lyric"},{"id":"22","start":85.64,"end":88.31,"text":"ダダダダ ダメですか？","translation":"","kind":"lyric"},{"id":"23","start":88.31,"end":91.08,"text":"だけどもあたしはいいか？","translation":"","kind":"lyric"},{"id":"24","start":91.08,"end":92.47,"text":"やんないじゃない","translation":"","kind":"lyric"},{"id":"25","start":92.47,"end":95.47,"text":"できないんだ！(ドヤ！)","translation":"","kind":"lyric"},{"id":"26","start":104.68,"end":107.17,"text":"テストで良い点とりたーい","translation":"","kind":"lyric"},{"id":"27","start":107.17,"end":109.93,"text":"でも頭がちっとも追いつかなーい","translation":"","kind":"lyric"},{"id":"28","start":109.93,"end":112.4,"text":"日曜日だって早起きしたい","translation":"","kind":"lyric"},{"id":"29","start":112.4,"end":115.22999999999999,"text":"深夜のネトゲがやめられない (ない！)","translation":"","kind":"lyric"},{"id":"30","start":115.22999999999999,"end":116.5,"text":"やる気がないとかそんなんじゃないんだ","translation":"","kind":"lyric"},{"id":"31","start":116.5,"end":117.82,"text":"やる気があってもできない仕様だ","translation":"","kind":"lyric"},{"id":"32","start":117.82,"end":119.34,"text":"しょうがないなって許してよ","translation":"","kind":"lyric"},{"id":"33","start":119.34,"end":120.65,"text":"エンジェルリングを頬張りながら","translation":"","kind":"lyric"},{"id":"34","start":120.65,"end":121.94,"text":"こんなあたしに誰がしたんだ","translation":"","kind":"lyric"},{"id":"35","start":121.94,"end":123.32,"text":"てかこんなあたしにあたしがしたのか","translation":"","kind":"lyric"},{"id":"36","start":123.32,"end":124.67,"text":"しょーがないなって許してよ","translation":"","kind":"lyric"},{"id":"37","start":124.67,"end":125.99,"text":"エンジェルリングを頬張りながら","translation":"","kind":"lyric"},{"id":"38","start":125.99,"end":128.99,"text":"天使の翼は使ってない 飛ぶの怖いから","translation":"","kind":"lyric"},{"id":"39","start":131.27,"end":133.9,"text":"本気をだしたら飛べますが","translation":"","kind":"lyric"},{"id":"40","start":133.9,"end":136.67000000000002,"text":"みたいな顔はしている","translation":"","kind":"lyric"},{"id":"41","start":136.67000000000002,"end":139.67000000000002,"text":"そんなハリボテの裏側に隠した愛の感情が","translation":"","kind":"lyric"},{"id":"42","start":141.86,"end":144.86,"text":"あなたに笑ってほしいの","translation":"","kind":"lyric"},{"id":"43","start":146.68,"end":149.68,"text":"ねえ ダメダメダメダメなあたしで... いいですか？","translation":"","kind":"lyric"},{"id":"44","start":152.25,"end":155.25,"text":"実際は一切の自信も無いような天使ですが","translation":"","kind":"lyric"},{"id":"45","start":158.02,"end":161.02,"text":"グルグルグルグルと巡る頭の中では","translation":"","kind":"lyric"},{"id":"46","start":163.42000000000002,"end":166.42000000000002,"text":"あなたのことばかり考えてるんだ！","translation":"","kind":"lyric"},{"id":"47","start":168.68,"end":171.68,"text":"ダメダメダメダメなあたしを (もっと！)","translation":"","kind":"lyric"},{"id":"48","start":172.57,"end":173.84,"text":"愛してよ (YES!)","translation":"","kind":"lyric"},{"id":"49","start":173.84,"end":176.84,"text":"もらった愛で飛ぼうと思うよ (エンジェル！)","translation":"","kind":"lyric"},{"id":"50","start":177.87,"end":179.36,"text":"天使だから (ハイ！)","translation":"","kind":"lyric"},{"id":"51","start":179.36,"end":182.36,"text":"ドキドキドキドキをあげるよ (もっと！)","translation":"","kind":"lyric"},{"id":"52","start":183.05,"end":184.4,"text":"あなたには (YES!)","translation":"","kind":"lyric"},{"id":"53","start":184.4,"end":187.4,"text":"もっと好きになってくれるなら (エンジェル！)","translation":"","kind":"lyric"},{"id":"54","start":188.27,"end":189.91,"text":"やるよ多分 (ハイ！)","translation":"","kind":"lyric"},{"id":"55","start":189.91,"end":192.68,"text":"ダダダダ ダメ天使は","translation":"","kind":"lyric"},{"id":"56","start":192.68,"end":195.03,"text":"ダダダダ ダメですか？","translation":"","kind":"lyric"},{"id":"57","start":195.03,"end":197.79,"text":"だけどもあたしはいいか？","translation":"","kind":"lyric"},{"id":"58","start":197.79,"end":199.01,"text":"やんないじゃない","translation":"","kind":"lyric"},{"id":"59