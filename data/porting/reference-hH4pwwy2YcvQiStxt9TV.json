{"title":"Mr. Music","artist":"레루리리, 론치노 페페","sourceId":"reference:hH4pwwy2YcvQiStxt9TV","sourceHash":"ce4a3c0e3e4f23b29c5285662c480fa46eaeb1408dbc5d4444a47976761db613","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":25084142,"cues":[{"id":"1","start":1.2,"end":5.33,"text":"Hey Mr. Music 強く抱いて","translation":"","kind":"lyric"},{"id":"2","start":5.33,"end":8.04,"text":"Hey Mr. Music...","translation":"","kind":"lyric"},{"id":"3","start":26.84,"end":34.64,"text":"この頃じゃ少しだけ心が拗ねている","translation":"","kind":"lyric"},{"id":"4","start":34.64,"end":42.0,"text":"熱い思いを閉じ込めて 進めなくなってる","translation":"","kind":"lyric"},{"id":"5","start":42.0,"end":50.09,"text":"あの頃は良かったと振り返ってばかりで","translation":"","kind":"lyric"},{"id":"6","start":50.09,"end":58.82,"text":"今日の喜びを探すこと 忘れてしまってる","translation":"","kind":"lyric"},{"id":"7","start":58.82,"end":62.68,"text":"なんとなく日々を重ねればほら","translation":"","kind":"lyric"},{"id":"8","start":62.68,"end":66.65,"text":"ちょっとずつ薄れてゆく本能","translation":"","kind":"lyric"},{"id":"9","start":66.65,"end":69.72,"text":"世知辛い 要らない 足りない","translation":"","kind":"lyric"},{"id":"10","start":69.72,"end":73.71000000000001,"text":"そんな僕じゃつまらない","translation":"","kind":"lyric"},{"id":"11","start":73.71000000000001,"end":77.62,"text":"Hey Mr. Music 強く抱いて","translation":"","kind":"lyric"},{"id":"12","start":77.62,"end":81.89,"text":"Hey Mr. Music 踊らせてよ","translation":"","kind":"lyric"},{"id":"13","start":81.89,"end":85.87,"text":"君がくれた温もりで","translation":"","kind":"lyric"},{"id":"14","start":85.87,"end":91.45,"text":"僕を包んで keep on groovin'","translation":"","kind":"lyric"},{"id":"15","start":91.45,"end":95.53999999999999,"text":"迷いも戸惑いも","translation":"","kind":"lyric"},{"id":"16","start":95.53999999999999,"end":99.21000000000001,"text":"ごまかしたままだから","translation":"","kind":"lyric"},{"id":"17","start":99.21000000000001,"end":103.75,"text":"胸の中パンクしそうなほど","translation":"","kind":"lyric"},{"id":"18","start":103.75,"end":108.0,"text":"溜まりに溜まってる","translation":"","kind":"lyric"},{"id":"19","start":108.0,"end":111.97999999999999,"text":"なんとなく長いものに巻かれて","translation":"","kind":"lyric"},{"id":"20","start":111.97999999999999,"end":115.86,"text":"ちょっとずつ磨り減ってく希望も","translation":"","kind":"lyric"},{"id":"21","start":115.86,"end":118.97999999999999,"text":"失くさない 消さない やめない","translation":"","kind":"lyric"},{"id":"22","start":118.97999999999999,"end":123.04,"text":"僕は僕をあきらめない","translation":"","kind":"lyric"},{"id":"23","start":123.04,"end":126.78,"text":"Hey Mr. Music 時を止めて","translation":"","kind":"lyric"},{"id":"24","start":126.78,"end":130.93,"text":"Hey Mr. Music 魔法をかけて","translation":"","kind":"lyric"},{"id":"25","start":130.93,"end":134.95,"text":"恋の始まりのように","translation":"","kind":"lyric"},{"id":"26","start":134.95,"end":139.29,"text":"夢を見せて keep on movin'","translation":"","kind":"lyric"},{"id":"27","start":170.16,"end":172.21,"text":"(Hey Mr. Music)","translation":"","kind":"lyric"},{"id":"28","start":172.21,"end":174.15,"text":"You've given me such a cool buzz","translation":"","kind":"lyric"},{"id":"29","start":174.15,"end":175.95,"text":"(Hey Mr. Music)","translation":"","kind":"lyric"},{"id":"30","start":175.95,"end":178.03,"text":"Livened up my boring days","translation":"","kind":"lyric"},{"id":"31","start":178.03,"end":179.88,"text":"(Hey Mr. Music)","translation":"","kind":"lyric"},{"id":"32","start":179.88,"end":182.04,"text":"C'mon, show me an even more wonderful world","translation":"","kind":"lyric"},{"id":"33","start":182.04,"end":183.89,"text":"(Hey Mr. Music)","translation":"","kind":"lyric"},{"id":"34","start":183.89,"end":185.92,"text":"With that fantastic magic of yours","translation":"","kind":"lyric"},{"id":"35","start":185.92,"end":189.94,"text":"Hey Mr. Music 結局ぼくらみんな","translation":"","kind":"lyric"},{"id":"36","start":189.94,"end":193.98,"text":"Hey Mr. Music 弱い生き物だから","translation":"","kind":"lyric"},{"id":"37","start":193.98,"end":197.55,"text":"Hey Mr. Music 涙を流すのさ","translation":"","kind":"lyric"},{"id":"38","start":197.55,"end":201.53,"text":"Hey Mr. Music","translation":"","kind":"lyric"},{"id":"39","start":201.53,"end":205.53,"text":"Hey Mr. Music 強く抱いて","translation":"","kind":"lyric"},{"id":"40","start":205.53,"end":209.88,"text":"Hey Mr. Music 踊らせてよ","translation":"","kind":"lyric"},{"id":"41","start":209.88,"end":213.85,"text":"君がくれた温もりで","translation":"","kind":"lyric"},{"id":"42","start":213.85,"end":217.35,"text":"僕を包んで keep on groovin'","translation":"","kind":"lyric"},{"id":"43","start":217.35,"end":221.27,"text":"Hey Mr. Music 時を止めて","translation":"","kind":"lyric"},{"id":"44","start":221.27,"end":225.52,"text":"Hey Mr. Music 魔法をかけて","translation":"","kind":"lyric"},{"id":"45","start":225.52,"end":229.51,"text":"恋の始まりのように","translation":"","kind":"lyric"},{"id":"46","start":229.51,"end":233.41,"text":"夢を見せて keep on movin'","translation":"","kind":"lyric"},{"id":"47","start":233.41,"end":237.24,"text":"君がくれた温もりで","translation":"","kind":"lyric"},{"id":"48","start":237.24,"end":246.66,"text":"僕を包んで keep on groovin'","translation":"","kind":"lyric"},{"id":"49","start":246.66,"end":249.02,"text":"「みすたーみゅーじっく！」","translation":"","kind":"lyric"}],"candidates":[]}