{"originalLanguage":"ja","title":"용사","artist":"YOASOBI","date":"2026-10-11","sourceId":"15631910:019","sourceHash":"8dfd1ab864a6d559ab754701024bb078789fa52d3aba0d4cf670fab0882c66d3","duration":194.4,"cues":[{"id":"1","start":0.97,"end":2.93,"text":"まるで御伽の話","translation":"마치 옛이야기 같은","kind":"lyric"},{"id":"2","start":2.99,"end":5.31,"text":"終わり迎えた証","translation":"끝을 맞았다는 증거","kind":"lyric"},{"id":"3","start":5.37,"end":7.87,"text":"長過ぎる旅路から","translation":"너무 길었던 여정에서","kind":"lyric"},{"id":"4","start":7.93,"end":9.81,"text":"切り出した一節","translation":"떼어 낸 한 구절","kind":"lyric"},{"id":"5","start":9.87,"end":12.45,"text":"それはかつてこの地に","translation":"그건 한때 이 땅에","kind":"lyric"},{"id":"6","start":12.51,"end":15.31,"text":"影を落とした悪を","translation":"그림자를 드리운 악을","kind":"lyric"},{"id":"7","start":15.37,"end":17.21,"text":"討ち取りし勇者との","translation":"쓰러뜨린 용사와의","kind":"lyric"},{"id":"8","start":17.27,"end":23.27,"text":"短い旅の記憶","translation":"짧은 여행의 기억","kind":"lyric"},{"id":"9","start":30.15,"end":32.03,"text":"物語は終わり","translation":"이야기는 끝나고","kind":"lyric"},{"id":"10","start":32.09,"end":34.33,"text":"勇者は眠りにつく","translation":"용사는 잠에 들어","kind":"lyric"},{"id":"11","start":34.39,"end":37.01,"text":"穏やかな日常を","translation":"평온한 일상을","kind":"lyric"},{"id":"12","start":37.07,"end":38.779,"text":"この地に残して","translation":"이 땅에 남긴 채","kind":"lyric"},{"id":"13","start":38.839,"end":41.175,"text":"時の流れは無情に","translation":"시간의 흐름은 무정하게","kind":"lyric"},{"id":"14","start":41.235,"end":43.44,"text":"人を忘れさせる","translation":"사람을 잊게 해","kind":"lyric"},{"id":"15","start":43.5,"end":46.483,"text":"そこに生きた軌跡も","translation":"그곳에 살았던 자취마저","kind":"lyric"},{"id":"16","start":46.543,"end":47.989,"text":"錆び付いていく","translation":"녹슬어 가","kind":"lyric"},{"id":"17","start":48.049,"end":50.022,"text":"それでも君の","translation":"그래도 너의","kind":"lyric"},{"id":"18","start":50.082,"end":52.256,"text":"言葉も願いも勇気も","translation":"말도 바람도 용기도","kind":"lyric"},{"id":"19","start":52.316,"end":55.552,"text":"今も確かに私の中で","translation":"지금도 분명 내 안에서","kind":"lyric"},{"id":"20","start":55.612,"end":58.443,"text":"生きている","translation":"살아 있어","kind":"lyric"},{"id":"21","start":58.503,"end":60.081,"text":"同じ途を選んだ","translation":"같은 길을 골랐어","kind":"lyric"},{"id":"22","start":60.141,"end":62.123,"text":"それだけだったはずなのに","translation":"그뿐이었을 텐데","kind":"lyric"},{"id":"23","start":62.183,"end":63.721,"text":"いつの間にかどうして","translation":"어느새 어째서","kind":"lyric"},{"id":"24","start":63.781,"end":68.401,"text":"頬を伝う涙の理由をもっと","translation":"뺨을 타고 흐르는 눈물의 이유를 더","kind":"lyric"},{"id":"25","start":68.461,"end":69.402,"text":"知りたいんだ","translation":"알고 싶어","kind":"lyric"},{"id":"26","start":69.462,"end":70.595,"text":"今更だって","translation":"이제 와서라도","kind":"lyric"},{"id":"27","start":70.655,"end":73.062,"text":"共に歩んだ旅路を辿れば","translation":"함께 걸었던 여정을 따라가면","kind":"lyric"},{"id":"28","start":73.122,"end":76.53,"text":"そこに君は居なくとも","translation":"그곳에 네가 없어도","kind":"lyric"},{"id":"29","start":76.59,"end":82.59,"text":"きっと見つけられる","translation":"분명 찾을 수 있어","kind":"lyric"},{"id":"30","start":87.842,"end":90.077,"text":"物語は続く","translation":"이야기는 이어져","kind":"lyric"},{"id":"31","start":90.137,"end":92.463,"text":"一人の旅へと発つ","translation":"혼자 하는 여행을 떠나","kind":"lyric"},{"id":"32","start":92.523,"end":94.222,"text":"立ち寄る街で出会う","translation":"들른 마을에서 만난","kind":"lyric"},{"id":"33","start":94.282,"end":96.831,"text":"人の記憶の中に残る君は","translation":"사람들의 기억 속에 남은 너는","kind":"lyric"},{"id":"34","start":96.891,"end":99.014,"text":"相も変わらずお人好しで","translation":"여전히 변함없는 좋은 사람이고","kind":"lyric"},{"id":"35","start":99.074,"end":101.512,"text":"格好つけてばかりだね","translation":"폼만 잡고 있네","kind":"lyric"},{"id":"36","start":101.572,"end":104.12,"text":"あちらこちらに作ったシンボルは","translation":"여기저기 만들어 둔 상징은","kind":"lyric"},{"id":"37","start":104.18,"end":105.782,"text":"勝ち取った平和の証","translation":"쟁취한 평화의 증거","kind":"lyric"},{"id":"38","start":105.842,"end":106.628,"text":"それすら","translation":"그것마저","kind":"lyric"},{"id":"39","start":106.688,"end":107.765,"text":"未来でいつか","translation":"미래에 언젠가","kind":"lyric"},{"id":"40","start":107.825,"end":110.273,"text":"私が一人にならないように","translation":"내가 혼자가 되지 않도록","kind":"lyric"},{"id":"41","start":110.333,"end":112.412,"text":"あの旅を思い出せるように","translation":"그 여행을 떠올릴 수 있도록","kind":"lyric"},{"id":"42","start":112.472,"end":118.472,"text":"残された目印","translation":"남겨 둔 이정표","kind":"lyric"},{"id":"43","start":124.361,"end":126.556,"text":"まるで御伽の話","translation":"마치 옛이야기 같은","kind":"lyric"},{"id":"44","start":126.616,"end":128.772,"text":"終わり迎えた証","translation":"끝을 맞았다는 증거","kind":"lyric"},{"id":"45","start":128.832,"end":131.144,"text":"私を変えた出会い","translation":"나를 바꾼 만남","kind":"lyric"},{"id":"46","start":131.204,"end":134.206,"text":"百分の一の旅路","translation":"백분의 일의 여정","kind":"lyric"},{"id":"47","start":134.266,"end":135.82,"text":"君の勇気をいつか","translation":"너의 용기를 언젠가","kind":"lyric"},{"id":"48","start":135.88,"end":137.057,"text":"風がさらって","translation":"바람이 휩쓸어","kind":"lyric"},{"id":"49","start":137.117,"end":139.68,"text":"誰の記憶から消えてしまっても","translation":"누구의 기억에서도 사라져 버려도","kind":"lyric"},{"id":"50","start":139.74,"end":143.99,"text":"私が未来に連れて行くから","translation":"내가 미래로 데려갈 테니까","kind":"lyric"},{"id":"51","start":144.05,"end":145.01,"text":"君の手を取った","translation":"네 손을 잡았던","kind":"lyric"},{"id":"52","start":145.07,"end":147.05,"text":"あの日全て始まった","translation":"그날 모든 게 시작됐어","kind":"lyric"},{"id":"53","start":147.11,"end":147.75,"text":"くだらなくて","translation":"시시하고","kind":"lyric"},{"id":"54","start":147.81,"end":150.61,"text":"思わずふっと笑ってしまうような","translation":"나도 모르게 피식 웃어 버릴 듯한","kind":"lyric"},{"id":"55","start":150.67,"end":154.84,"text":"ありふれた時間が今も眩しい","translation":"흔한 시간이 지금도 눈부셔","kind":"lyric"},{"id":"56","start":154.9,"end":155.74,"text":"知りたいんだ","translation":"알고 싶어","kind":"lyric"},{"id":"57","start":155.8,"end":156.9,"text":"今更だって","translation":"이제 와서라도","kind":"lyric"},{"id":"58","start":156.96,"end":159.28,"text":"振り返るとそこにはいつでも","translation":"돌아보면 그곳에는 언제나","kind":"lyric"},{"id":"59","start":159.34,"end":162.48,"text":"優しく微笑みかける","translation":"다정히 미소 짓는","kind":"lyric"},{"id":"60","start":162.54,"end":168.54,"text":"君がいるから","translation":"네가 있으니까","kind":"lyric"},{"id":"61","start":174.034,"end":176.099,"text":"新たな旅の始まりは","translation":"새로운 여행의 시작은","kind":"lyric"},{"id":"62","start":176.159,"end":179.176,"text":"君が守り抜いたこの地に","translation":"네가 끝까지 지켜 낸 이 땅에","kind":"lyric"},{"id":"63","start":179.236,"end":185.236,"text":"芽吹いた命と共に","translation":"싹튼 생명과 함께","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}