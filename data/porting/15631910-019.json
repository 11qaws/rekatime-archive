{"originalLanguage":"ja","title":"용사","artist":"YOASOBI","date":"2026-10-11","sourceId":"15631910:019","sourceHash":"6ad6611317df1fb71a606f55461274e1cf648d81deac9edbfb08e12cbc197b3b","duration":201.60000000000218,"cues":[{"id":"1","start":7.092914,"end":9.392962,"text":"まるで御伽の話","translation":"마치 옛이야기 같은","kind":"lyric"},{"id":"2","start":9.412962,"end":11.649126,"text":"終わり迎えた証","translation":"끝을 맞았다는 증거","kind":"lyric"},{"id":"3","start":11.673009,"end":14.322313,"text":"長過ぎる旅路から","translation":"너무 길었던 여정에서","kind":"lyric"},{"id":"4","start":14.593069,"end":16.082313,"text":"切り出した一節","translation":"떼어 낸 한 구절","kind":"lyric"},{"id":"5","start":16.313105,"end":18.422313,"text":"それはかつてこの地に","translation":"그건 한때 이 땅에","kind":"lyric"},{"id":"6","start":18.673154,"end":20.909318,"text":"影を落とした悪を","translation":"그림자를 드리운 악을","kind":"lyric"},{"id":"7","start":20.963201,"end":23.487903,"text":"討ち取りし勇者との","translation":"쓰러뜨린 용사와의","kind":"lyric"},{"id":"8","start":23.553255,"end":30.766688,"text":"短い旅の記憶","translation":"짧은 여행의 기억","kind":"lyric"},{"id":"9","start":35.963512,"end":37.992313,"text":"物語は終わり","translation":"이야기는 끝나고","kind":"lyric"},{"id":"10","start":38.25356,"end":40.489724,"text":"勇者は眠りにつく","translation":"용사는 잠에 들어","kind":"lyric"},{"id":"11","start":40.543607,"end":43.162313,"text":"穏やかな日常を","translation":"평온한 일상을","kind":"lyric"},{"id":"12","start":43.423667,"end":44.912313,"text":"この地に残して","translation":"이 땅에 남긴 채","kind":"lyric"},{"id":"13","start":45.173703,"end":47.523752,"text":"時の流れは無情に","translation":"시간의 흐름은 무정하게","kind":"lyric"},{"id":"14","start":47.543752,"end":49.522313,"text":"人を忘れさせる","translation":"사람을 잊게 해","kind":"lyric"},{"id":"15","start":49.783799,"end":52.741306,"text":"そこに生きた軌跡も","translation":"그곳에 살았던 자취마저","kind":"lyric"},{"id":"16","start":52.793861,"end":54.236548,"text":"錆び付いていく","translation":"녹슬어 가","kind":"lyric"},{"id":"17","start":54.283892,"end":55.952313,"text":"それでも君の","translation":"그래도 너의","kind":"lyric"},{"id":"18","start":56.293934,"end":58.457964,"text":"言葉も願いも勇気も","translation":"말도 바람도 용기도","kind":"lyric"},{"id":"19","start":58.503979,"end":61.744047,"text":"今も確かに私の中で","translation":"지금도 분명 내 안에서","kind":"lyric"},{"id":"20","start":61.764047,"end":64.577286,"text":"生きている","translation":"살아 있어","kind":"lyric"},{"id":"21","start":64.624106,"end":66.002313,"text":"同じ途を選んだ","translation":"같은 길을 골랐어","kind":"lyric"},{"id":"22","start":66.24414,"end":68.119632,"text":"それだけだったはずなのに","translation":"그뿐이었을 텐데","kind":"lyric"},{"id":"23","start":68.264182,"end":69.602313,"text":"いつの間にかどうして","translation":"어느새 어째서","kind":"lyric"},{"id":"24","start":69.844214,"end":74.45431,"text":"頬を伝う涙の理由をもっと","translation":"뺨을 타고 흐르는 눈물의 이유를 더","kind":"lyric"},{"id":"25","start":74.47431,"end":75.412057,"text":"知りたいんだ","translation":"알고 싶어","kind":"lyric"},{"id":"26","start":75.464331,"end":76.61848,"text":"今更だって","translation":"이제 와서라도","kind":"lyric"},{"id":"27","start":76.644355,"end":79.024788,"text":"共に歩んだ旅路を辿れば","translation":"함께 걸었던 여정을 따라가면","kind":"lyric"},{"id":"28","start":79.084406,"end":82.47472,"text":"そこに君は居なくとも","translation":"그곳에 네가 없어도","kind":"lyric"},{"id":"29","start":82.514477,"end":93.382313,"text":"きっと見つけられる","translation":"분명 찾을 수 있어","kind":"lyric"},{"id":"30","start":93.644708,"end":95.880872,"text":"物語は続く","translation":"이야기는 이어져","kind":"lyric"},{"id":"31","start":95.914755,"end":98.022313,"text":"一人の旅へと発つ","translation":"혼자 하는 여행을 떠나","kind":"lyric"},{"id":"32","start":98.274804,"end":99.692313,"text":"立ち寄る街で出会う","translation":"들른 마을에서 만난","kind":"lyric"},{"id":"33","start":100.01484,"end":102.539541,"text":"人の記憶の中に残る君は","translation":"사람들의 기억 속에 남은 너는","kind":"lyric"},{"id":"34","start":102.594893,"end":104.562313,"text":"相も変わらずお人好しで","translation":"여전히 변함없는 좋은 사람이고","kind":"lyric"},{"id":"35","start":104.754938,"end":106.922313,"text":"格好つけてばかりだね","translation":"폼만 잡고 있네","kind":"lyric"},{"id":"36","start":107.224989,"end":109.677557,"text":"あちらこちらに作ったシンボルは","translation":"여기저기 만들어 둔 상징은","kind":"lyric"},{"id":"37","start":109.805043,"end":111.342313,"text":"勝ち取った平和の証","translation":"쟁취한 평화의 증거","kind":"lyric"},{"id":"38","start":111.515078,"end":112.365096,"text":"それすら","translation":"그것마저","kind":"lyric"},{"id":"39","start":112.385096,"end":113.362313,"text":"未来でいつか","translation":"미래에 언젠가","kind":"lyric"},{"id":"40","start":113.55512,"end":116.079822,"text":"私が一人にならないように","translation":"내가 혼자가 되지 않도록","kind":"lyric"},{"id":"41","start":116.135174,"end":118.299204,"text":"あの旅を思い出せるように","translation":"그 여행을 떠올릴 수 있도록","kind":"lyric"},{"id":"42","start":118.33522,"end":125.548653,"text":"残された目印","translation":"남겨 둔 이정표","kind":"lyric"},{"id":"43","start":130.565473,"end":132.865521,"text":"まるで御伽の話","translation":"마치 옛이야기 같은","kind":"lyric"},{"id":"44","start":132.885521,"end":134.922313,"text":"終わり迎えた証","translation":"끝을 맞았다는 증거","kind":"lyric"},{"id":"45","start":135.165568,"end":137.282313,"text":"私を変えた出会い","translation":"나를 바꾼 만남","kind":"lyric"},{"id":"46","start":137.605619,"end":140.707395,"text":"百分の一の旅路","translation":"백분의 일의 여정","kind":"lyric"},{"id":"47","start":140.755684,"end":142.052313,"text":"君の勇気をいつか","translation":"너의 용기를 언젠가","kind":"lyric"},{"id":"48","start":142.415719,"end":143.312313,"text":"風がさらって","translation":"바람이 휩쓸어","kind":"lyric"},{"id":"49","start":143.575743,"end":146.015794,"text":"誰の記憶から消えてしまっても","translation":"누구의 기억에서도 사라져 버려도","kind":"lyric"},{"id":"50","start":146.035794,"end":149.845873,"text":"私が未来に連れて行くから","translation":"내가 미래로 데려갈 테니까","kind":"lyric"},{"id":"51","start":149.865873,"end":151.075899,"text":"君の手を取った","translation":"네 손을 잡았던","kind":"lyric"},{"id":"52","start":151.095899,"end":152.745933,"text":"あの日全て始まった","translation":"그날 모든 게 시작됐어","kind":"lyric"},{"id":"53","start":152.765933,"end":153.682313,"text":"くだらなくて","translation":"시시하고","kind":"lyric"},{"id":"54","start":153.945958,"end":156.376008,"text":"思わずふっと笑ってしまうような","translation":"나도 모르게 피식 웃어 버릴 듯한","kind":"lyric"},{"id":"55","start":156.396008,"end":161.006104,"text":"ありふれた時間が今も眩しい","translation":"흔한 시간이 지금도 눈부셔","kind":"lyric"},{"id":"56","start":161.026104,"end":161.963851,"text":"知りたいんだ","translation":"알고 싶어","kind":"lyric"},{"id":"57","start":162.016125,"end":162.902313,"text":"今更だって","translation":"이제 와서라도","kind":"lyric"},{"id":"58","start":163.166149,"end":165.586199,"text":"振り返るとそこにはいつでも","translation":"돌아보면 그곳에는 언제나","kind":"lyric"},{"id":"59","start":165.606199,"end":168.996513,"text":"優しく微笑みかける","translation":"다정히 미소 짓는","kind":"lyric"},{"id":"60","start":169.046271,"end":180.006498,"text":"君がいるから","translation":"네가 있으니까","kind":"lyric"},{"id":"61","start":180.026498,"end":182.118394,"text":"新たな旅の始まりは","translation":"새로운 여행의 시작은","kind":"lyric"},{"id":"62","start":182.146542,"end":185.176184,"text":"君が守り抜いたこの地に","translation":"네가 끝까지 지켜 낸 이 땅에","kind":"lyric"},{"id":"63","start":185.216606,"end":191.348024,"text":"芽吹いた命と共に","translation":"싹튼 생명과 함께","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}