{"title":"Mela!","artist":"緑黄色社会","date":"2026-07-28","sourceId":"14411850:013","sourceHash":"cac35ab09705019218f414e12e4639bd96d55466982224813675b7d7b615af55","duration":243.19999999999982,"cues":[{"id":"1","start":4.20741,"end":5.365,"text":"今なんじゃない?","translation":"지금 아니겠어","kind":"lyric"},{"id":"2","start":5.787394,"end":7.580622,"text":"メラメラとたぎれ","translation":"활활 끓어올라","kind":"lyric"},{"id":"3","start":7.667373,"end":10.835,"text":"眠っているだけの正義","translation":"그저 잠들어 있는 정의","kind":"lyric"},{"id":"4","start":10.947338,"end":18.881016,"text":"こんな僕も君のヒーローになりたいのさ (ooh whoa)","translation":"이런 나도 너의 영웅이 되고 싶어","kind":"lyric"},{"id":"5","start":18.927253,"end":20.945,"text":"La la la, la la la","translation":"라라라 라라라","kind":"lyric"},{"id":"6","start":21.447226,"end":24.977189,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"7","start":24.997189,"end":28.420625,"text":"La la la, la la la, la la la","translation":"라라라 라라라 라라라","kind":"lyric"},{"id":"8","start":28.457152,"end":31.015,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"9","start":32.807105,"end":39.219255,"text":"かっこいい君には 僕じゃ頼りないのかなんて","translation":"멋진 너에겐 내가 미덥지 않은 걸까","kind":"lyric"},{"id":"10","start":39.717032,"end":46.295,"text":"そりゃそうだよな だって今もこうして迷ってる","translation":"그렇겠지 지금도 이렇게 망설이고 있으니","kind":"lyric"},{"id":"11","start":46.716957,"end":50.066921,"text":"(La la la, la la la) 手を取ってくれないか","translation":"라라라 라라라 내 손을 잡아 주지 않을래","kind":"lyric"},{"id":"12","start":50.086921,"end":53.385,"text":"(La la la, la la la) ギブとテイクさ","translation":"라라라 라라라 기브 앤 테이크야","kind":"lyric"},{"id":"13","start":53.626883,"end":59.625,"text":"(La la la, la la la) 君が僕のヒーローだったように","translation":"라라라 라라라 네가 나의 영웅이었던 것처럼","kind":"lyric"},{"id":"14","start":59.986815,"end":61.399662,"text":"今なんじゃない?","translation":"지금 아니겠어","kind":"lyric"},{"id":"15","start":61.476799,"end":63.255,"text":"メラメラとたぎる","translation":"활활 끓어올라","kind":"lyric"},{"id":"16","start":63.356779,"end":66.725875,"text":"こんな僕にも潜む正義が","translation":"이런 내 안에도 숨어 있던 정의가","kind":"lyric"},{"id":"17","start":66.896741,"end":70.155,"text":"どうしようもない衝動に駆られて","translation":"어쩔 수 없는 충동에 이끌려","kind":"lyric"},{"id":"18","start":70.306705,"end":73.675,"text":"ほら気付けば手を握っている","translation":"봐 정신을 차리면 네 손을 잡고 있어","kind":"lyric"},{"id":"19","start":73.806668,"end":74.985,"text":"いったいぜんたい","translation":"대체 어쩌려고","kind":"lyric"},{"id":"20","start":75.086654,"end":80.385,"text":"そんなに荷物を背負い込んでどこへ行くの","translation":"그렇게 짐을 짊어지고 어디로 가는 거야","kind":"lyric"},{"id":"21","start":80.586595,"end":88.005,"text":"ねえねえ待って僕にちょっと預けてみては?","translation":"있지 잠깐 내게 조금 맡겨 보지 않을래","kind":"lyric"},{"id":"22","start":102.306364,"end":105.67546,"text":"信じてばかりの僕と","translation":"그저 믿기만 하는 나와","kind":"lyric"},{"id":"23","start":105.716327,"end":109.23629,"text":"信じることが怖い君と","translation":"믿는 것이 두려운 너","kind":"lyric"},{"id":"24","start":109.25629,"end":112.734066,"text":"どちらが正しいのかなんて","translation":"어느 쪽이 옳은지는","kind":"lyric"},{"id":"25","start":112.756252,"end":116.276214,"text":"誰にも分からないさ","translation":"아무도 몰라","kind":"lyric"},{"id":"26","start":116.296214,"end":119.856176,"text":"(La la la, la la la) 僕らだけの世界","translation":"라라라 라라라 우리만의 세계","kind":"lyric"},{"id":"27","start":119.876176,"end":123.22614,"text":"(La la la, la la la) ギブとテイクさ","translation":"라라라 라라라 기브 앤 테이크야","kind":"lyric"},{"id":"28","start":123.24614,"end":131.505859,"text":"(La la la, la la la) 補い合えた暁には同じ夢を見たい","translation":"라라라 라라라 서로 채워 주는 날엔 같은 꿈을 꾸고 싶어","kind":"lyric"},{"id":"29","start":144.725911,"end":148.915,"text":"君はかっこいいと苦しめて","translation":"너는 멋지다는 말로 괴롭히고","kind":"lyric"},{"id":"30","start":149.005865,"end":152.145832,"text":"ひとりぼっちにさせたのは","translation":"홀로 남겨 둔 건","kind":"lyric"},{"id":"31","start":152.165832,"end":158.615,"text":"少し僕のせいなんだよな ごめんね","translation":"조금은 내 탓이겠지 미안해","kind":"lyric"},{"id":"32","start":158.775761,"end":162.307878,"text":"だけど見るべきはリアルだ","translation":"하지만 봐야 할 건 현실이야","kind":"lyric"},{"id":"33","start":162.485722,"end":166.155,"text":"今こそ僕が救けるんだ","translation":"이제야말로 내가 구하는 거야","kind":"lyric"},{"id":"34","start":166.41568,"end":173.655,"text":"抱えないで信じて頼ってほしいんだ","translation":"혼자 안지 말고 믿고 기대 줬으면 해","kind":"lyric"},{"id":"35","start":176.485572,"end":177.898419,"text":"今なんじゃない?","translation":"지금 아니겠어","kind":"lyric"},{"id":"36","start":177.935557,"end":179.835536,"text":"メラメラとたぎる","translation":"활활 끓어올라","kind":"lyric"},{"id":"37","start":179.855536,"end":183.278972,"text":"こんな僕にも眠る正義が","translation":"이런 내 안에도 잠들어 있던 정의가","kind":"lyric"},{"id":"38","start":183.315499,"end":186.785462,"text":"どうしようもない衝動に駆られて","translation":"어쩔 수 없는 충동에 이끌려","kind":"lyric"},{"id":"39","start":186.805462,"end":190.174558,"text":"ほら気付けば手を握っている","translation":"봐 정신을 차리면 네 손을 잡고 있어","kind":"lyric"},{"id":"40","start":190.225426,"end":191.529592,"text":"ほっておけない","translation":"내버려 둘 수 없어","kind":"lyric"},{"id":"41","start":191.67541,"end":196.855,"text":"そんなに荷物を背負い込んでどこへ行くの","translation":"그렇게 짐을 짊어지고 어디로 가는 거야","kind":"lyric"},{"id":"42","start":197.055353,"end":203.576183,"text":"ほんのちょっと僕にちょっと預けてみては?","translation":"아주 조금 내게 조금 맡겨 보지 않을래","kind":"lyric"},{"id":"43","start":203.965279,"end":211.898956,"text":"こんな僕も君のヒーローになりたいのさ (ooh whoa)","translation":"이런 나도 너의 영웅이 되고 싶어","kind":"lyric"},{"id":"44","start":211.945194,"end":214.045,"text":"La la la, la la la","translation":"라라라 라라라","kind":"lyric"},{"id":"45","start":214.465167,"end":214.736868,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"46","start":218.045129,"end":220.755,"text":"La la la, la la la, la la la","translation":"라라라 라라라 라라라","kind":"lyric"},{"id":"47","start":221.415093,"end":225.125,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"48","start":225.765046,"end":227.705,"text":"La la la, la la la","translation":"라라라 라라라","kind":"lyric"},{"id":"49","start":228.285019,"end":231.165053,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"50","start":232.084979,"end":234.638971,"text":"La la la, la la la, la la la","translation":"라라라 라라라 라라라","kind":"lyric"},{"id":"51","start":235.284945,"end":237.458555,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}