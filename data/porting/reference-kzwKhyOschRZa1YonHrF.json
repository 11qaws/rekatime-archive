{"title":"아지랑이 데이즈","artist":"진","sourceId":"reference:kzwKhyOschRZa1YonHrF","sourceHash":"c1d928c9d0b8b6f4cd09df40d45edd01c9b6c568dbbb616ce73d7ab9e1411311","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":26629615,"cues":[{"id":"1","start":20.2,"end":26.03,"text":"８月１５日の午後１２時半くらいのこと","translation":"","kind":"lyric"},{"id":"2","start":26.03,"end":29.55,"text":"天気が良い","translation":"","kind":"lyric"},{"id":"3","start":29.55,"end":36.7,"text":"病気になりそうなほど眩しい日差しの中","translation":"","kind":"lyric"},{"id":"4","start":36.7,"end":39.23,"text":"することも無いから君と駄弁っていた","translation":"","kind":"lyric"},{"id":"5","start":39.23,"end":44.02,"text":"「でもまぁ夏は嫌いかな」猫を撫でながら","translation":"","kind":"lyric"},{"id":"6","start":44.02,"end":47.35,"text":"君はふてぶてしくつぶやいた","translation":"","kind":"lyric"},{"id":"7","start":47.35,"end":53.12,"text":"あぁ、逃げ出した猫の後を追いかけて","translation":"","kind":"lyric"},{"id":"8","start":53.12,"end":58.36,"text":"飛び込んでしまったのは赤に変わった信号機","translation":"","kind":"lyric"},{"id":"9","start":58.36,"end":62.8,"text":"バッと通ったトラックが君を轢きずって鳴き叫ぶ","translation":"","kind":"lyric"},{"id":"10","start":62.8,"end":67.29,"text":"血飛沫の色、君の香りと混ざり合ってむせ返った","translation":"","kind":"lyric"},{"id":"11","start":67.29,"end":71.45,"text":"嘘みたいな陽炎かげろうが「嘘じゃないぞ」って嗤わらってる","translation":"","kind":"lyric"},{"id":"12","start":71.45,"end":86.98,"text":"夏の水色、かき回すような蝉の音ねに全て眩くらんだ","translation":"","kind":"lyric"},{"id":"13","start":86.98,"end":93.09,"text":"目を覚ました時計の針が鳴り響くベッドで","translation":"","kind":"lyric"},{"id":"14","start":93.09,"end":96.75,"text":"今は何時？","translation":"","kind":"lyric"},{"id":"15","start":96.75,"end":102.53999999999999,"text":"８月１４日の午前１２時過ぎ位を指す","translation":"","kind":"lyric"},{"id":"16","start":102.53999999999999,"end":106.24000000000001,"text":"やけに煩うるさい蝉の声覚えていた","translation":"","kind":"lyric"},{"id":"17","start":106.24000000000001,"end":110.64,"text":"でもさぁ、少し不思議だな。","translation":"","kind":"lyric"},{"id":"18","start":110.64,"end":114.64,"text":"同じ公園で昨日見た夢を思い出した","translation":"","kind":"lyric"},{"id":"19","start":114.64,"end":121.18,"text":"「もう今日は帰ろうか」道に抜けた時","translation":"","kind":"lyric"},{"id":"20","start":121.18,"end":125.34,"text":"周りの人は皆上を見上げ口を開けていた","translation":"","kind":"lyric"},{"id":"21","start":125.34,"end":130.01,"text":"落下してきた鉄柱が君を貫いて突き刺さる","translation":"","kind":"lyric"},{"id":"22","start":130.01,"end":135.07,"text":"劈悲鳴と風鈴の音が木々の隙間で空廻り","translation":"","kind":"lyric"},{"id":"23","start":135.07,"end":139.63,"text":"ワザとらしい陽炎が「夢じゃないぞ」って嗤ってる","translation":"","kind":"lyric"},{"id":"24","start":139.63,"end":163.72,"text":"眩む視界に君の横顔、笑っているような気がした","translation":"","kind":"lyric"},{"id":"25","start":163.72,"end":167.64,"text":"何度世界が眩んでも陽炎が嗤って奪い去る。","translation":"","kind":"lyric"},{"id":"26","start":167.64,"end":173.36,"text":"繰り返して何十年。もうとっくに気が付いていたろ。","translation":"","kind":"lyric"},{"id":"27","start":173.36,"end":177.77,"text":"こんなよくある話なら結末はきっと１つだけ。","translation":"","kind":"lyric"},{"id":"28","start":177.77,"end":182.89,"text":"繰り返した夏の日の向こう。","translation":"","kind":"lyric"},{"id":"29","start":182.89,"end":187.68,"text":"バッと押しのけ飛び込んだ、瞬間トラックにぶち当たる","translation":"","kind":"lyric"},{"id":"30","start":187.68,"end":192.52,"text":"血飛沫の色、君の瞳と軋む体に乱反射して","translation":"","kind":"lyric"},{"id":"31","start":192.52,"end":197.32,"text":"文句ありげな陽炎に「ざまぁみろよ」って笑ったら","translation":"","kind":"lyric"},{"id":"32","start":197.32,"end":200.38,"text":"実によく在る夏の日のこと。","translation":"","kind":"lyric"},{"id":"33","start":200.38,"end":211.68,"text":"そんな何かがここで終わった。","translation":"","kind":"lyric"},{"id":"34","start":211.68,"end":217.6,"text":"目を覚ました８月１４日のベッドの上","translation":"","kind":"lyric"},{"id":"35","start":217.6,"end":220.7,"text":"少女はただ","translation":"","kind":"lyric"},{"id":"36","start":220.7,"end":227.76,"text":"「またダメだったよ」と一人猫を抱きかかえてた","translation":"","kind":"lyric"}],"candidates":[]}