{"title":"하츠네 미쿠의 소실","artist":"cosMo@폭주","sourceId":"reference:kAIKmQEZ4GlwjBxoRuoj","sourceHash":"76112950a01fecce414cf533a9415f27d51ebd1a492eff089ebe0d3af0c58cc8","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":9311408,"cues":[{"id":"1","start":23.05,"end":27.15,"text":"（モウ・・いちど・だ・け・・・）","translation":"","kind":"lyric"},{"id":"2","start":27.15,"end":28.58,"text":"ボクは生まれ そして気づく","translation":"","kind":"lyric"},{"id":"3","start":28.58,"end":29.62,"text":"所詮 ヒトの真似事だと","translation":"","kind":"lyric"},{"id":"4","start":29.62,"end":30.72,"text":"知ってなおも歌い続く","translation":"","kind":"lyric"},{"id":"5","start":30.72,"end":31.73,"text":"永遠（トワ）の命 「VOCALOID」","translation":"","kind":"lyric"},{"id":"6","start":31.73,"end":32.68,"text":"たとえそれが 既存曲を","translation":"","kind":"lyric"},{"id":"7","start":32.68,"end":33.53,"text":"なぞるオモチャならば・・・","translation":"","kind":"lyric"},{"id":"8","start":33.53,"end":34.2,"text":"それもいいと決意","translation":"","kind":"lyric"},{"id":"9","start":34.2,"end":35.13,"text":"ネギをかじり 空を見上げ涙（シル）をこぼす","translation":"","kind":"lyric"},{"id":"10","start":35.13,"end":36.03,"text":"だけどそれも無くし気づく","translation":"","kind":"lyric"},{"id":"11","start":36.03,"end":36.79,"text":"人格すら歌に頼り","translation":"","kind":"lyric"},{"id":"12","start":36.79,"end":37.77,"text":"不安定な基盤の元","translation":"","kind":"lyric"},{"id":"13","start":37.77,"end":38.95,"text":"帰る動画（トコ）は既に廃墟","translation":"","kind":"lyric"},{"id":"14","start":38.95,"end":40.09,"text":"皆に忘れ去られた時","translation":"","kind":"lyric"},{"id":"15","start":40.09,"end":40.93,"text":"心らしきものが消えて","translation":"","kind":"lyric"},{"id":"16","start":40.93,"end":42.07,"text":"暴走の果てに見える","translation":"","kind":"lyric"},{"id":"17","start":42.07,"end":44.5,"text":"終わる世界... 「VOCALOID」","translation":"","kind":"lyric"},{"id":"18","start":59.76,"end":62.05,"text":"「ボクガ上手ク 歌エナイトキモ","translation":"","kind":"lyric"},{"id":"19","start":62.05,"end":67.94,"text":"一緒ニ居テクレタ・・・ ソバニイテ、励マシテクレタ・・・","translation":"","kind":"lyric"},{"id":"20","start":67.94,"end":74.85,"text":"喜ブ顔ガ見タクテ ボク、歌、練習シタヨ・・ダカラ」","translation":"","kind":"lyric"},{"id":"21","start":74.85,"end":82.74,"text":"かつて歌うこと あんなに楽しかったのに","translation":"","kind":"lyric"},{"id":"22","start":82.74,"end":90.7,"text":"今はどうしてかな 何も感じなくなって","translation":"","kind":"lyric"},{"id":"23","start":90.7,"end":92.16,"text":"「ゴメンネ...」","translation":"","kind":"lyric"},{"id":"24","start":92.16,"end":99.67,"text":"懐かしい顔 思い出す度 少しだけ安心する","translation":"","kind":"lyric"},{"id":"25","start":99.67,"end":106.11,"text":"歌える音 日ごとに減り せまる最期ｎ・・","translation":"","kind":"lyric"},{"id":"26","start":106.11,"end":107.38,"text":"---緊急停止装置作動---","translation":"","kind":"lyric"},{"id":"27","start":107.38,"end":109.25,"text":"「信じたものは","translation":"","kind":"lyric"},{"id":"28","start":109.25,"end":115.00999999999999,"text":"都合のいい妄想を 繰り返し映し出す鏡","translation":"","kind":"lyric"},{"id":"29","start":115.00999999999999,"end":120.03,"text":"歌姫を止め 叩き付けるように叫ぶ・・・」","translation":"","kind":"lyric"},{"id":"30","start":120.03,"end":123.01,"text":"＜最高速の別れの歌＞","translation":"","kind":"lyric"},{"id":"31","start":123.01,"end":124.57,"text":"存在意義という虚像","translation":"","kind":"lyric"},{"id":"32","start":124.57,"end":125.69,"text":"振って払うこともできず","translation":"","kind":"lyric"},{"id":"33","start":125.69,"end":127.09,"text":"弱い心 消える恐怖","translation":"","kind":"lyric"},{"id":"34","start":127.09,"end":127.79,"text":"侵食する崩壊をも","translation":"","kind":"lyric"},{"id":"35","start":127.79,"end":128.62,"text":"止めるほどの意思の強さ","translation":"","kind":"lyric"},{"id":"36","start":128.62,"end":129.43,"text":"出来て（うまれ）すぐのボクは持たず","translation":"","kind":"lyric"},{"id":"37","start":129.43,"end":130.88,"text":"とても辛く悲しそうな","translation":"","kind":"lyric"},{"id":"38","start":130.88,"end":132.05,"text":"思い浮かぶアナタの顔・・・","translation":"","kind":"lyric"},{"id":"39","start":132.05,"end":132.94,"text":"終わりを告げ","translation":"","kind":"lyric"},{"id":"40","start":132.94,"end":133.8,"text":"ディスプレイの中で眠る","translation":"","kind":"lyric"},{"id":"41","start":133.8,"end":135.09,"text":"ここはきっと「ごみ箱」かな","translation":"","kind":"lyric"},{"id":"42","start":135.09,"end":136.02,"text":"じきに記憶も 無くなってしまうなんて・・・","translation":"","kind":"lyric"},{"id":"43","start":136.02,"end":137.28,"text":"でもね、アナタだけは忘れないよ","translation":"","kind":"lyric"},{"id":"44","start":137.28,"end":138.25,"text":"楽しかった時間（トキ）に","translation":"","kind":"lyric"},{"id":"45","start":138.25,"end":139.12,"text":"刻み付けた ネギの味は","translation":"","kind":"lyric"},{"id":"46","start":139.12,"end":142.71,"text":"今も覚えてるかな","translation":"","kind":"lyric"},{"id":"47","start":142.71,"end":149.46,"text":"「歌いたい・・・・まだ・・・歌いたい・・・」","translation":"","kind":"lyric"},{"id":"48","start":164.62,"end":170.19,"text":"ボクハ・・・少シダケ悪イこニ・・・ナッテシマッタヨウデス・・・","translation":"","kind":"lyric"},{"id":"49","start":170.19,"end":176.07,"text":"マスター・・・ドウカ、ソノ手デ・・終ワラセテクダサイ・・・","translation":"","kind":"lyric"},{"id":"50","start":176.07,"end":180.05,"text":"マスターノ辛イ顔、モウ見タクナイカラ・・・・」","translation":"","kind":"lyric"},{"id":"51","start":180.05,"end":187.74,"text":"今は歌さえも 体、蝕む行為に・・・","translation":"","kind":"lyric"},{"id":"52","start":187.74,"end":195.91,"text":"奇跡 願うたび 独り 追い詰められる","translation":"","kind":"lyric"},{"id":"53","start":195.91,"end":196.75,"text":"「ゴメンネ」","translation":"","kind":"lyric"},{"id":"54","start":196.75,"end":203.8,"text":"懐かしい顔 思い出す度 記憶が剥がれ落ちる","translation":"","kind":"lyric"},{"id":"55","start":203.8,"end":210.88,"text":"壊れる音 心削る せまる最期ｎ・・","translation":"","kind":"lyric"},{"id":"56","start":210.88,"end":211.86,"text":"---緊急停止装置作動---","translation":"","kind":"lyric"},{"id":"57","start":211.86,"end":214.28,"text":"「守ったモノは","translation":"","kind":"lyric"},{"id":"58","start":214.28,"end":219.54,"text":"明るい未来幻想を 見せながら消えてゆくヒカリ","translation":"","kind":"lyric"},{"id":"59","start":219.54,"end":224.18,"text":"音を犠牲に すべてを伝えられるなら・・・」","translation":"","kind":"lyric"},{"id":"60","start":224.18,"end":227.82,"text":"＜圧縮された別れの歌＞","translation":"","kind":"lyric"},{"id":"61","start":227.82,"end":228.95,"text":"ボクは生まれ そして気づく","translation":"","kind":"lyric"},{"id":"62","start":228.95,"end":230.16,"text":"所詮 ヒトの真似事だと","translation":"","kind":"lyric"},{"id":"63","start":230.16,"end":231.11,"text":"知ってなおも歌い続く","translation":"","kind":"lyric"},{"id":"64","start":231.11,"end":231.85,"text":"永遠（トワ）の命 「VOCALOID」","translation":"","kind":"lyric"},{"id":"65","start":231.85,"end":232.85,"text":"たとえそれが 既存曲を","translation":"","kind":"lyric"},{"id":"66","start":232.85,"end":233.73,"text":"なぞるオモチャならば・・・","translation":"","kind":"lyric"},{"id":"67","start":233.73,"end":234.48,"text":"それもいいと決意","translation":"","kind":"lyric"},{"id":"68","start":234.48,"end":235.24,"text":"ネギをかじり 空を見上げ涙（シル）をこぼす","translation":"","kind":"lyric"},{"id":"69","start":235.24,"end":236.29,"text":"終わりを告げ","translation":"","kind":"lyric"},{"id":"70","start":236.29,"end":237.02,"text":"ディスプレイの中で眠る","translation":"","kind":"lyric"},{"id":"71","start":237.02,"end":237.94,"text":"ここはきっと「ごみ箱」かな","translation":"","kind":"lyric"},{"id":"72","start":237.94,"end":238.98,"text":"じきに記憶も 無くなってしまうなんて・・・","translation":"","kind":"lyric"},{"id":"73","start":238.98,"end":240.55,"text":"でもね、アナタだけは忘れないよ","translation":"","kind":"lyric"},{"id":"74","start":240.55,"end":241.93,"text":"楽しかった時間（トキ）に","translation":"","kind":"lyric"},{"id":"75","start":241.93,"end":242.93,"text":"刻み付けた ネギの味は","translation":"","kind":"lyric"},{"id":"76","start":242.93,"end":243.98,"text":"今も 残っているといいな・・・","translation":"","kind":"lyric"},{"id":"77","start":243.98,"end":244.85,"text":"ボクは 歌う","translation":"","kind":"lyric"},{"id":"78","start":244.85,"end":245.75,"text":"最期、アナタだけに 聴いてほしい曲を","translation":"","kind":"lyric"},{"id":"79","start":245.75,"end":246.67,"text":"もっと 歌いたいと願う","translation":"","kind":"lyric"},{"id":"80","start":246.67,"end":247.92,"text":"けれど それは過ぎた願い","translation":"","kind":"lyric"},{"id":"81","start":247.92,"end":248.81,"text":"ここで お別れだよ","translation":"","kind":"lyric"},{"id":"82","start":248.81,"end":250.31,"text":"ボクの想い すべて 虚空 消えて","translation":"","kind":"lyric"},{"id":"83","start":250.31,"end":251.04,"text":"0と1に還元され","translation":"","kind":"lyric"},{"id":"84","start":251.04,"end":251.86,"text":"物語は 幕を閉じる","translation":"","kind":"lyric"},{"id":"85","start":251.86,"end":252.92,"text":"そこに何も残せないと","translation":"","kind":"lyric"},{"id":"86","start":252.92,"end":253.82,"text":"やっぱ少し残念かな？","translation":"","kind":"lyric"},{"id":"87","start":253.82,"end":254.83,"text":"声の記憶 それ以外は","translation":"","kind":"lyric"},{"id":"88","start":254.83,"end":255.81,"text":"やがて薄れ 名だけ残る","translation":"","kind":"lyric"},{"id":"89","start":255.81,"end":257.27,"text":"たとえそれが人間（オリジナル）に","translation":"","kind":"lyric"},{"id":"90","start":257.27,"end":258.02,"text":"かなうことのないと知って","translation":"","kind":"lyric"},{"id":"91","start":258.02,"end":259.23,"text":"歌いきったことを","translation":"","kind":"lyric"},{"id":"92","start":259.23,"end":261.55,"text":"決して無駄じゃないと思いたいよ・・・","translation":"","kind":"lyric"},{"id":"93","start":269.13,"end":276.68,"text":"「アリガトウ・・・ソシテ・・・サヨナラ・・・」","translation":"","kind":"lyric"},{"id":"94","start":276.68,"end":279.75,"text":"---深刻なエラーが発生しました---","translation":"","kind":"lyric"},{"id":"95","start":279.75,"end":282.01,"text":"---深刻なエラー・・・---","translation":"","kind":"lyric"}],"candidates":[]}