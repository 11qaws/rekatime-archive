{"title":"Battle Cry","artist":"Beth Crowley","sourceId":"reference:eBL2STPjtpHDStUO1Qmv","sourceHash":"276c84a886b44edc6a48ae87429a0bc6e2298b9ca9ddc7a70778673480bd56a4","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":35197192,"cues":[{"id":"1","start":18.14,"end":25.3,"text":"I have no heart, just ice and stone","translation":"","kind":"lyric"},{"id":"2","start":25.3,"end":32.29,"text":"Made up of nails and teeth and bone","translation":"","kind":"lyric"},{"id":"3","start":32.29,"end":39.34,"text":"And I know exactly what I'm for","translation":"","kind":"lyric"},{"id":"4","start":39.34,"end":46.69,"text":"To hurt and destroy and nothing more","translation":"","kind":"lyric"},{"id":"5","start":46.69,"end":53.63,"text":"And if it's true that I was made","translation":"","kind":"lyric"},{"id":"6","start":53.63,"end":60.58,"text":"I still don't know if I can change","translation":"","kind":"lyric"},{"id":"7","start":60.58,"end":62.81,"text":"But something has stirred","translation":"","kind":"lyric"},{"id":"8","start":62.81,"end":65.06,"text":"A beast has awakened","translation":"","kind":"lyric"},{"id":"9","start":65.06,"end":66.95,"text":"Opened a door","translation":"","kind":"lyric"},{"id":"10","start":66.95,"end":69.07,"text":"There's no mistaking","translation":"","kind":"lyric"},{"id":"11","start":69.07,"end":70.72,"text":"Waging a war","translation":"","kind":"lyric"},{"id":"12","start":70.72,"end":76.46000000000001,"text":"It's fighting inside of me","translation":"","kind":"lyric"},{"id":"13","start":76.46000000000001,"end":81.24,"text":"So hear my battle cry","translation":"","kind":"lyric"},{"id":"14","start":81.24,"end":85.12,"text":"I'm out for blood to claim what's mine","translation":"","kind":"lyric"},{"id":"15","start":85.12,"end":89.24,"text":"Finally questioning","translation":"","kind":"lyric"},{"id":"16","start":89.24,"end":91.5,"text":"If I am my own worst","translation":"","kind":"lyric"},{"id":"17","start":91.5,"end":93.6,"text":"I am my own worst","translation":"","kind":"lyric"},{"id":"18","start":93.6,"end":100.61,"text":"I am my own worst enemy","translation":"","kind":"lyric"},{"id":"19","start":100.61,"end":107.32,"text":"I never thought that I could love","translation":"","kind":"lyric"},{"id":"20","start":107.32,"end":114.63,"text":"Strangers at night were good enough","translation":"","kind":"lyric"},{"id":"21","start":114.63,"end":121.69,"text":"But love's not a thing you get to choose","translation":"","kind":"lyric"},{"id":"22","start":121.69,"end":128.78,"text":"Try to resist, you'll always lose","translation":"","kind":"lyric"},{"id":"23","start":128.78,"end":135.77,"text":"I made a deal to sell my soul","translation":"","kind":"lyric"},{"id":"24","start":135.77,"end":142.85,"text":"But lately, I have dared to hope","translation":"","kind":"lyric"},{"id":"25","start":142.85,"end":145.2,"text":"That something has stirred","translation":"","kind":"lyric"},{"id":"26","start":145.2,"end":147.53,"text":"A beast has awakened","translation":"","kind":"lyric"},{"id":"27","start":147.53,"end":149.34,"text":"Opened a door","translation":"","kind":"lyric"},{"id":"28","start":149.34,"end":151.36,"text":"There's no mistaking","translation":"","kind":"lyric"},{"id":"29","start":151.36,"end":153.2,"text":"Waging a war","translation":"","kind":"lyric"},{"id":"30","start":153.2,"end":158.68,"text":"It's fighting inside of me","translation":"","kind":"lyric"},{"id":"31","start":158.68,"end":163.5,"text":"So hear my battle cry","translation":"","kind":"lyric"},{"id":"32","start":163.5,"end":167.69,"text":"I'm out for blood to claim what's mine","translation":"","kind":"lyric"},{"id":"33","start":167.69,"end":171.66,"text":"Finally questioning","translation":"","kind":"lyric"},{"id":"34","start":171.66,"end":173.74,"text":"If I am my own worst","translation":"","kind":"lyric"},{"id":"35","start":173.74,"end":175.89,"text":"I am my own worst","translation":"","kind":"lyric"},{"id":"36","start":175.89,"end":182.99,"text":"I am my own worst enemy","translation":"","kind":"lyric"},{"id":"37","start":182.99,"end":189.83,"text":"Tell my secrets to the wind","translation":"","kind":"lyric"},{"id":"38","start":189.83,"end":196.9,"text":"Flying, I feel infinite","translation":"","kind":"lyric"},{"id":"39","start":196.9,"end":199.26,"text":"But something has stirred","translation":"","kind":"lyric"},{"id":"40","start":199.26,"end":201.59,"text":"A beast has awakened","translation":"","kind":"lyric"},{"id":"41","start":201.59,"end":203.37,"text":"Opened a door","translation":"","kind":"lyric"},{"id":"42","start":203.37,"end":205.59,"text":"There's no mistaking","translation":"","kind":"lyric"},{"id":"43","start":205.59,"end":207.34,"text":"Waging a war","translation":"","kind":"lyric"},{"id":"44","start":207.34,"end":212.8,"text":"It's fighting inside of me","translation":"","kind":"lyric"},{"id":"45","start":212.8,"end":217.51,"text":"So hear my battle cry","translation":"","kind":"lyric"},{"id":"46","start":217.51,"end":221.79,"text":"I'm out for blood to claim what's mine","translation":"","kind":"lyric"},{"id":"47","start":221.79,"end":225.61,"text":"Finally questioning","translation":"","kind":"lyric"},{"id":"48","start":225.61,"end":227.72,"text":"If I am my own worst","translation":"","kind":"lyric"},{"id":"49","start":227.72,"end":229.8,"text":"I am my own worst","translation":"","kind":"lyric"},{"id":"50","start":229.8,"end":236.32999999999998,"text":"I am my own worst enemy","translation":"","kind":"lyric"}],"candidates":[]}