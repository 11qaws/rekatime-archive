{"title":"It's a Dragon Party","artist":"히토시즈쿠x야마","sourceId":"reference:TE4Ac7vMDURbklDI9jcE","sourceHash":"a97daee53697daae8c157fe307fbc595ad2d6bb3e4e73ddc23018269beb99914","performanceStatus":"no_performance_record","timingMethod":"reference_lyric_character_matching","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":34.05,"end":38.62,"text":"人里離れた秘密の洞窟に","translation":"","kind":"lyric"},{"id":"2","start":38.62,"end":42.4,"text":"素敵なドラゴンが棲んでいた","translation":"","kind":"lyric"},{"id":"3","start":42.4,"end":46.15,"text":"光る宝を眺めながら 豪華な食事に舌鼓♪","translation":"","kind":"lyric"},{"id":"4","start":46.15,"end":49.41,"text":"たま〜に、お仕事するだけの……","translation":"","kind":"lyric"},{"id":"5","start":49.41,"end":52.47,"text":"……「気まぐれ・わがままライフ♪」は","translation":"","kind":"lyric"},{"id":"6","start":52.47,"end":54.91,"text":"ドラゴンの特権♪","translation":"","kind":"lyric"},{"id":"7","start":54.91,"end":58.16,"text":"金のアクセで派手にきめて","translation":"","kind":"lyric"},{"id":"8","start":58.16,"end":61.88,"text":"今日は、どこへ行こう？","translation":"","kind":"lyric"},{"id":"9","start":61.88,"end":65.0,"text":"輝く羽、広げ ご機嫌で進め♪","translation":"","kind":"lyric"},{"id":"10","start":65.0,"end":70.97,"text":"見渡す限りの世界へ","translation":"","kind":"lyric"},{"id":"11","start":70.97,"end":74.7,"text":"誰も邪魔できない 私だけの大空を","translation":"","kind":"lyric"},{"id":"12","start":74.7,"end":80.14,"text":"まっすぐに 駆け抜けてみせるよ♪","translation":"","kind":"lyric"},{"id":"13","start":87.63,"end":91.71000000000001,"text":"人の住む街まで「お散歩のお仕事」は","translation":"","kind":"lyric"},{"id":"14","start":91.71000000000001,"end":94.50999999999999,"text":"休み休みが ちょうどいい♪","translation":"","kind":"lyric"},{"id":"15","start":94.50999999999999,"end":99.68,"text":"週末の予定は？賑やかなパーティー♪","translation":"","kind":"lyric"},{"id":"16","start":99.68,"end":103.2,"text":"ナイトさんたちも 遊びにくる！？","translation":"","kind":"lyric"},{"id":"17","start":103.2,"end":106.75,"text":"大変！ 準備を急げ〜っ！","translation":"","kind":"lyric"},{"id":"18","start":106.75,"end":111.65,"text":"かわいく着飾って ご馳走並べて♪","translation":"","kind":"lyric"},{"id":"19","start":111.65,"end":115.95,"text":"心の限りで もてなそう","translation":"","kind":"lyric"},{"id":"20","start":115.95,"end":120.35,"text":"誰も彼もが 待ちに焦がれた宴を","translation":"","kind":"lyric"},{"id":"21","start":120.35,"end":125.4,"text":"さあ、早く 整えて待ちましょう♪","translation":"","kind":"lyric"},{"id":"22","start":140.28,"end":144.52,"text":"楽しいことばかりで 忘れてしまいそうね","translation":"","kind":"lyric"},{"id":"23","start":144.52,"end":149.02,"text":"たった一度限りの人生の","translation":"","kind":"lyric"},{"id":"24","start":149.02,"end":153.03,"text":"その煌めきを 花咲く時の剎那を","translation":"","kind":"lyric"},{"id":"25","start":153.03,"end":156.38,"text":"精一杯 樂しもう？","translation":"","kind":"lyric"},{"id":"26","start":156.38,"end":159.13,"text":"Welcome!! It’s a Dragon Party♪","translation":"","kind":"lyric"},{"id":"27","start":159.13,"end":161.0,"text":"派手に盛り上がれ♪","translation":"","kind":"lyric"},{"id":"28","start":161.0,"end":165.62,"text":"素晴らしい夜が明けるまで","translation":"","kind":"lyric"},{"id":"29","start":165.62,"end":171.23,"text":"誰も彼もが 予定調和な","translation":"","kind":"lyric"},{"id":"30","start":165.62,"end":171.23,"text":"台本の終幕を","translation":"","kind":"lyric"},{"id":"31","start":171.23,"end":173.18,"text":"駆け抜けて 魅せるわ♪","translation":"","kind":"lyric"},{"id":"32","start":173.18,"end":177.67000000000002,"text":"輝く羽、広げ ご機嫌で進め♪","translation":"","kind":"lyric"},{"id":"33","start":177.67000000000002,"end":181.65,"text":"誇らしい限りの自分へ","translation":"","kind":"lyric"},{"id":"34","start":181.65,"end":186.79,"text":"誰も邪魔できない","translation":"","kind":"lyric"},{"id":"35","start":181.65,"end":186.79,"text":"私だけの人生を","translation":"","kind":"lyric"},{"id":"36","start":186.79,"end":188.93,"text":"大切に刻みつけ","translation":"","kind":"lyric"},{"id":"37","start":188.93,"end":198.27,"text":"笑顔で まっすぐに 我が道を進もう♪","translation":"","kind":"lyric"},{"id":"38","start":198.27,"end":206.16,"text":"嗚呼…… あっという間ね","translation":"","