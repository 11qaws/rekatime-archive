{"title":"마법사 사라반트","artist":"Sound Horizon","sourceId":"reference:9NnjwGiJMYTtevxuD2fZ","sourceHash":"8f922f0faecf2df148180fbc6f13b1fff327fe7ee609feadee0a5a56add9cb80","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":6.54,"end":8.56,"text":"昔 あるところに","translation":"","kind":"lyric"},{"id":"2","start":8.56,"end":11.56,"text":"恋人を亡くした ひとりの魔法使いがいた","translation":"","kind":"lyric"},{"id":"3","start":12.22,"end":13.73,"text":"彼が 求めたのは","translation":"","kind":"lyric"},{"id":"4","start":13.73,"end":16.73,"text":"死者を甦らせる 禁断の秘法","translation":"","kind":"lyric"},{"id":"5","start":17.14,"end":19.61,"text":"領分を侵す者に 降りかかるのは","translation":"","kind":"lyric"},{"id":"6","start":19.61,"end":22.18,"text":"厄災のみと 識りながら","translation":"","kind":"lyric"},{"id":"7","start":22.18,"end":24.83,"text":"何故 人は求めるのか?","translation":"","kind":"lyric"},{"id":"8","start":24.83,"end":27.33,"text":"人智を超えた 魔神の力を...","translation":"","kind":"lyric"},{"id":"9","start":27.33,"end":30.33,"text":"吹き荒ぶ風は 砂を巻き上げて","translation":"","kind":"lyric"},{"id":"10","start":32.83,"end":35.83,"text":"若い旅人の 行く手を阻む","translation":"","kind":"lyric"},{"id":"11","start":38.28,"end":41.28,"text":"旅の道連れは 一頭の駱駝","translation":"","kind":"lyric"},{"id":"12","start":43.66,"end":46.66,"text":"砂丘を乗り越えて 街へと向かう...","translation":"","kind":"lyric"},{"id":"13","start":49.49,"end":52.49,"text":"「魔法のランプが 欲しくはないか?」","translation":"","kind":"lyric"},{"id":"14","start":54.54,"end":57.54,"text":"胡散臭い 髭の男が 囁いた","translation":"","kind":"lyric"},{"id":"15","start":60.49,"end":63.49,"text":"薄暗い 路地裏での 駆け引き","translation":"","kind":"lyric"},{"id":"16","start":65.38,"end":68.38,"text":"彼は 男が持ち出した 条件を飲んだ...","translation":"","kind":"lyric"},{"id":"17","start":71.39,"end":74.19,"text":"ランプを擦ると 魔神が現れ","translation":"","kind":"lyric"},{"id":"18","start":74.19,"end":76.9,"text":"3つの願いを 叶えてくれると言う","translation":"","kind":"lyric"},{"id":"19","start":76.9,"end":79.9,"text":"願い事を1つ譲る という条件で","translation":"","kind":"lyric"},{"id":"20","start":79.93,"end":82.68,"text":"彼は その在処を聞き出した","translation":"","kind":"lyric"},{"id":"21","start":82.68,"end":85.68,"text":"そのランプは 南西にある洞窟に 封印されているという","translation":"","kind":"lyric"},{"id":"22","start":87.36,"end":90.36,"text":"片足が悪いという 男の代わりに","translation":"","kind":"lyric"},{"id":"23","start":90.56,"end":93.02000000000001,"text":"彼は穴の中へと降りた...","translation":"","kind":"lyric"},{"id":"24","start":93.02000000000001,"end":96.02000000000001,"text":"砂漠の下には 大きな空洞","translation":"","kind":"lyric"},{"id":"25","start":98.55,"end":101.55,"text":"冷たい空気が 背筋を掠める","translation":"","kind":"lyric"},{"id":"26","start":104.02000000000001,"end":107.02000000000001,"text":"洞窟の奥には 妖しい祭壇","translation":"","kind":"lyric"},{"id":"27","start":109.47,"end":112.47,"text":"黄金のランプと 古びた絨毯","translation":"","kind":"lyric"},{"id":"28","start":114.82,"end":117.82,"text":"ランプを 手に取ると 洞窟が崩れた","translation":"","kind":"lyric"},{"id":"29","start":120.35,"end":123.08,"text":"「ランプを 早くこっちへよこせ！ 」","translation":"","kind":"lyric"},{"id":"30","start":123.08,"end":126.08,"text":"男が叫んだ...","translation":"","kind":"lyric"},{"id":"31","start":131.43,"end":134.43,"text":"「忘レモノハ アリマセンカ？ 」","translation":"","kind":"lyric"},{"id":"32","start":136.69,"end":139.69,"text":"暗い闇の中 懐かしい声を聴く","translation":"","kind":"lyric"},{"id":"33","start":144.95,"end":147.95,"text":"暖かな光 愛しい声を聴く","translation":"","kind":"lyric"},{"id":"34","start":153.16,"end":156.16,"text":"「貴方はまだ こっちへ 来てはいけないわ","translation":"","kind":"lyric"},{"id":"35","start":161.32,"end":164.32,"text":"遣り残したことが きっと あるはず... 」","translation":"","kind":"lyric"},{"id":"36","start":169.57999999999998,"end":172.57999999999998,"text":"暗い闇の中 懐かしい声が言う","translation":"","kind":"lyric"},{"id":"37","start":177.68,"end":180.68,"text":"暖かな光 愛しい声が言う","translation":"","kind":"lyric"},{"id":"38","start":185.8,"end":188.8,"text":"「失われたモノの為に 願うより","translation":"","kind":"lyric"},{"id":"39","start":194.01,"end":197.01,"text":"今 目の前にある モノを見つめて... 」","translation":"","kind":"lyric"},{"id":"40","start":220.61,"end":223.61,"text":"目醒めれば 砂が巻き上がる","translation":"","kind":"lyric"},{"id":"41","start":224.72,"end":227.72,"text":"砂丘の上で 抱かれていた","translation":"","kind":"lyric"},{"id":"42","start":228.79,"end":231.79,"text":"黒髪の 美しい少女","translation":"","kind":"lyric"},{"id":"43","start":232.97,"end":235.97,"text":"泣きながら 微笑んでいた","translation":"","kind":"lyric"},{"id":"44","start":236.82,"end":239.82,"text":"「古の 罪と罰の 輪舞曲","translation":"","kind":"lyric"},{"id":"45","start":240.93,"end":243.93,"text":"ランプに 閉じ込められていた","translation":"","kind":"lyric"},{"id":"46","start":245.15,"end":248.15,"text":"愚かな私を 出してくれた 御主人様","translation":"","kind":"lyric"},{"id":"47","start":249.21,"end":252.21,"text":"さぁ 願いをどうぞ、 叶えましょう」","translation":"","kind":"lyric"},{"id":"48","start":253.32,"end":256.32,"text":"3つの願い 全て叶えたら 少女は再び","translation":"","kind":"lyric"},{"id":"49","start":263.94,"end":266.94,"text":"唯 冷たい砂の下で","translation":"","kind":"lyric"},{"id":"50","start":268.61,"end":271.61,"text":"幾千の 孤独に震える...","translation":"","kind":"lyric"},{"id":"51","start":276.44,"end":279.44,"text":"そして 彼は願った...","translation":"","kind":"lyric"},{"id":"52","start":280.23,"end":283.23,"text":"吹き荒ぶ風は 砂を巻き上げて","translation":"","kind":"lyric"},{"id":"53","start":285.68,"end":288.68,"text":"若い旅人の 行く手を阻む","translation":"","kind":"lyric"},{"id":"54","start":291.12,"end":294.12,"text":"旅の道連れは 二頭の駱駝","translation":"","kind":"lyric"},{"id":"55","start":296.63,"end":299.63,"text":"長い黒髪の 少女が一人...","translation":"","kind":"lyric"}],"candidates":[]}