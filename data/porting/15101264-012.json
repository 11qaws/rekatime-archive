{"title":"야생화","artist":"박효신","date":"2026-09-08","sourceId":"15101264:012","sourceHash":"f43a70e5ec2d72ec977533ad34d673b70e95161855b1e73afb944e8982267d4e","duration":165.6,"cues":[{"id":"1","start":6.95,"end":12.943,"text":"차가운 바람에 숨어 있다","translation":"","kind":"lyric"},{"id":"2","start":13.52,"end":19.24,"text":"한줄기 햇살에 몸 녹이다","translation":"","kind":"lyric"},{"id":"3","start":20.04,"end":26.043,"text":"그렇게 너는 또 한번 내게 온다","translation":"","kind":"lyric"},{"id":"4","start":29.05,"end":35.199,"text":"좋았던 기억만","translation":"","kind":"lyric"},{"id":"5","start":35.91,"end":41.93,"text":"그리운 마음만","translation":"","kind":"lyric"},{"id":"6","start":42.33,"end":47.463,"text":"니가 떠나간 그 길 위에","translation":"","kind":"lyric"},{"id":"7","start":47.74,"end":53.09,"text":"이렇게 남아 서있다","translation":"","kind":"lyric"},{"id":"8","start":53.13,"end":58.25,"text":"잊혀질 만큼만","translation":"","kind":"lyric"},{"id":"9","start":58.29,"end":64.367,"text":"괜찮을 만큼만","translation":"","kind":"lyric"},{"id":"10","start":73.62,"end":79.615,"text":"눈물 머금고 기다린 떨림 끝에","translation":"","kind":"lyric"},{"id":"11","start":94.56,"end":100.749,"text":"다시 나를 피우리라","translation":"","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}