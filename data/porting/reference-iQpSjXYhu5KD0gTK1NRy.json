{"title":"전쟁의 계보","artist":"Sound Horizon","sourceId":"reference:iQpSjXYhu5KD0gTK1NRy","sourceHash":"9a97de8c6ccee6effc5d59dbbda5c98b8fe8e26cfc84bac28e80b53bb21626e4","performanceStatus":"no_performance_record","timingMethod":"reference_lyric_character_matching","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":1.05,"end":4.22,"text":"第4巻 27ページ","translation":"","kind":"lyric"},{"id":"2","start":4.22,"end":5.77,"text":"世界を救いし","translation":"","kind":"lyric"},{"id":"3","start":5.77,"end":8.09,"text":"隻腕の英雄亡き後","translation":"","kind":"lyric"},{"id":"4","start":8.09,"end":9.26,"text":"邪神が封印されし","translation":"","kind":"lyric"},{"id":"5","start":9.26,"end":11.39,"text":"地に街を築き","translation":"","kind":"lyric"},{"id":"6","start":11.39,"end":14.78,"text":"自らが結界の役割を果たし","translation":"","kind":"lyric"},{"id":"7","start":14.78,"end":18.16,"text":"永き平和への礎と成す","translation":"","kind":"lyric"},{"id":"8","start":18.16,"end":20.99,"text":"誇り高き右腕に刻まれし","translation":"","kind":"lyric"},{"id":"9","start":20.99,"end":21.94,"text":"雷の紋章","translation":"","kind":"lyric"},{"id":"10","start":21.94,"end":23.42,"text":"彼の者達の名は","translation":"","kind":"lyric"},{"id":"11","start":23.42,"end":25.42,"text":"雷神の民","translation":"","kind":"lyric"},{"id":"12","start":25.42,"end":26.79,"text":"伝承の謎","translation":"","kind":"lyric"},{"id":"13","start":26.79,"end":28.48,"text":"紋章の秘密","translation":"","kind":"lyric"},{"id":"14","start":28.48,"end":30.75,"text":"少年が描く軌跡","translation":"","kind":"lyric"},{"id":"15","start":30.75,"end":32.28,"text":"雷神の系譜","translation":"","kind":"lyric"},{"id":"16","start":40.07,"end":44.25,"text":"弱い者ほど徒党を組み","translation":"","kind":"lyric"},{"id":"17","start":44.25,"end":47.75,"text":"身代わりの羊を捜す","translation":"","kind":"lyric"},{"id":"18","start":47.75,"end":51.21,"text":"愛を知らない幼き日々は","translation":"","kind":"lyric"},{"id":"19","start":51.21,"end":54.07,"text":"灼けた石の痛み","translation":"","kind":"lyric"},{"id":"20","start":54.07,"end":58.22,"text":"ひとり唇噤んだまま","translation":"","kind":"lyric"},{"id":"21","start":58.22,"end":61.78,"text":"膝を抱えて耐えていた","translation":"","kind":"lyric"},{"id":"22","start":61.78,"end":65.44,"text":"雨も宿ればいづれ過ぎ去る","translation":"","kind":"lyric"},{"id":"23","start":65.44,"end":69.09,"text":"嵐もまた然り","translation":"","kind":"lyric"},{"id":"24","start":69.09,"end":72.01,"text":"されど輝やかざる紋章","translation":"","kind":"lyric"},{"id":"25","start":72.01,"end":76.03999999999999,"text":"本当の強さって何だろう?","translation":"","kind":"lyric"},{"id":"26","start":76.03999999999999,"end":78.43,"text":"差し出された少女の","translation":"","kind":"lyric"},{"id":"27","start":78.43,"end":80.22,"text":"小さな手が","translation":"","kind":"lyric"},{"id":"28","start":80.22,"end":87.27,"text":"とても大きく見えた","translation":"","kind":"lyric"},{"id":"29","start":87.27,"end":89.06,"text":"黙したまま","translation":"","kind":"lyric"},{"id":"30","start":89.06,"end":91.06,"text":"何も語らぬ","translation":"","kind":"lyric"},{"id":"31","start":91.06,"end":94.21000000000001,"text":"歴史の手の平の上で","translation":"","kind":"lyric"},{"id":"32","start":94.21000000000001,"end":96.27000000000001,"text":"出会ってしまった","translation":"","kind":"lyric"},{"id":"33","start":96.27000000000001,"end":99.63,"text":"少年と少女の物語","translation":"","kind":"lyric"},{"id":"34","start":99.63,"end":101.69,"text":"十年の歳月も","translation":"","kind":"lyric"},{"id":"35","start":101.69,"end":104.63,"text":"一閃の雷が如く","translation":"","kind":"lyric"},{"id":"36","start":104.63,"end":106.02000000000001,"text":"過ぎ去ってしまえば","translation":"","kind":"lyric"},{"id":"37","start":106.02000000000001,"end":108.37,"text":"刹那","translation":"","kind":"lyric"},{"id":"38","start":108.37,"end":110.5,"text":"今 黒の歴史が","translation":"","kind":"lyric"},{"id":"39","start":110.5,"end":113.11,"text":"再び動き出そうとしている","translation":"","kind":"lyric"},{"id":"40","start":113.11,"end":118.32,"text":"遠い空見上げて","translation":"","kind":"lyric"},{"id":"41","start":118.32,"end":123.83,"text":"この胸を焦がす","translation":"","kind":"lyric"},{"id":"42","start":123.83,"end":129.03,"text":"浮かぶのは彼女の","translation":"","kind":"lyric"},{"id":"43","start":129.03,"end":134.31,"text":"愛らしい笑顔だけ","translation":"","kind":"lyric"},{"id":"44","start":134.31,"end":137.09,"text":"適わぬ","translation":"","kind":"lyric"},{"id":"45","start":137.09,"end":139.67000000000002,"text":"想いと","translation":"","kind":"lyric"},{"id":"46","start":139.67000000000002,"end":145.06,"text":"識っていながら","translation":"","kind":"lyric"},{"id":"47","start":145.06,"end":145.65,"text":"麗しの","translation":"","kind":"lyric"},{"id":"48","start":145.65,"end":146.31,"text":"君は何故","translation":"","kind":"lyric"},{"id":"49","start":146.31,"end":146.88,"text":"一族の","translation":"","kind":"lyric"},{"id":"50","start":146.88,"end":147.61,"text":"長の娘","translation":"","kind":"lyric"},{"id":"51","start":147.61,"end":148.02,"text":"部族一","translation":"","kind":"lyric"},{"id":"52","start":148.02,"end":150.05,"text":"強き者の許へ","translation":"","kind":"lyric"},{"id":"53","start":150.05,"end":150.95,"text":"嫁ぐこと","translation":"","kind":"lyric"},{"id":"54","start":150.95,"end":151.62,"text":"定めしは","translation":"","kind":"lyric"},{"id":"55","start":151.62,"end":152.06,"text":"変えられぬ","translation":"","kind":"lyric"},{"id":"56","start":152.06,"end":155.07999999999998,"text":"民の掟","translation":"","kind":"lyric"},{"id":"57","start":155.07999999999998,"end":155.63,"text":"嗚呼...","translation":"","kind":"lyric"},{"id":"58","start":155.63,"end":156.37,"text":"雷無き","translation":"","kind":"lyric"},{"id":"59","start":156.37,"end":156.86,"text":"この腕じゃ","translation":"","kind":"lyric"},{"id":"60","start":156.86,"end":157.7,"text":"君のこと","translation":"","kind":"lyric"},{"id":"61","start":157.7,"end":158.03,"text":"護れない?","translation":"","kind":"lyric"},{"id":"62","start":158.03,"end":158.96,"text":"想いなら","translation":"","kind":"lyric"},{"id":"63","start":158.96,"end":160.67000000000002,"text":"誰にも負けないと","translation":"","kind":"lyric"},{"id":"64","start":160.67000000000002,"end":161.66,"text":"叫んでも","translation":"","kind":"lyric"},{"id":"65","start":161.66,"end":162.16,"text":"その言葉","translation":"","kind":"lyric"},{"id":"66","start":162.16,"end":162.9,"text":"虚しくも","translation":"","kind":"lyric"},{"id":"67","start":162.9,"end":166.68,"text":"風に消えた","translation":"","kind":"lyric"},{"id":"68","start":166.68,"end":169.13,"text":"期は満ちようとしていた","translation":"","kind":"lyric"},{"id":"69","start":169.13,"end":170.61,"text":"長の娘も","translation":"","kind":"lyric"},{"id":"70","start":170.61,"end":174.98,"text":"今年で婚礼を定められし齢十六","translation":"","kind":"lyric"},{"id":"71","start":174.98,"end":176.95,"text":"その誕生の日が差し迫り","translation":"","kind":"lyric"},{"id":"72","start":176.95,"end":178.43,"text":"一族の猛者達は","translation":"","kind":"lyric"},{"id":"73","start":178.43,"end":180.91,"text":"競って名乗りを上げた","translation":"","kind":"lyric"},{"id":"74","start":180.91,"end":182.95,"text":"期は満ちようとしていた","translation":"","kind":"lyric"},{"id":"75","start":182.95,"end":184.42,"text":"邪悪なる波動が","translation":"","kind":"lyric"},{"id":"76","start":184.42,"end":186.98,"text":"街全体を包み込み","translation":"","kind":"lyric"},{"id":"77","start":186.98,"end":189.11,"text":"空に立ち込めたる暗雲は","translation":"","kind":"lyric"},{"id":"78","start":189.11,"end":194.16,"text":"(三度目の嵐)の訪れを告げようとしていた...","translation":"","kind":"lyric"},{"id":"79","start":194.16,"end":198.79,"text":"「おぉ... 何ということじゃ","translation":"","kind":"lyric"},{"id":"80","start":198.79,"end":202.19,"text":"黒き法衣を纏いし者達の影が見える","translation":"","kind":"lyric"},{"id":"81","start":202.19,"end":203.47,"text":"予言書の使徒","translation":"","kind":"lyric"},{"id":"82","start":203.47,"end":206.4,"text":"奴らを封印の深奥へ行かせてはならん","translation":"","kind":"lyric"},{"id":"83","start":206.4,"end":208.93,"text":"邪神の封印を解こうとしておるのじゃ","translation":"","kind":"lyric"},{"id":"84","start":208.93,"end":211.12,"text":"いまや雷神様の血も薄れ","translation":"","kind":"lyric"},{"id":"85","start":211.12,"end":214.92000000000002,"text":"我らに扱えるは小さき雷のみ","translation":"","kind":"lyric"},{"id":"86","start":214.92000000000002,"end":216.78,"text":"あぁ恐ろしいや","translation":"","kind":"lyric"},{"id":"87","start":216.78,"end":219.71,"text":"天地を揺るがす強大な力じゃ","translation":"","kind":"lyric"},{"id":"88","start":219.71,"end":223.11,"text":"来るぞ... あぁ来るぞ...」","translation":"","kind":"lyric"},{"id":"89","start":284.46,"end":286.25,"text":"地を割る咆哮","translation":"","kind":"lyric"},{"id":"90","start":286.25,"end":287.95,"text":"天を裂く爪牙","translation":"","kind":"lyric"},{"id":"91","start":287.95,"end":289.95,"text":"烈火の如く燃えさかる","translation":"","kind":"lyric"},{"id":"92","start":289.95,"end":291.79,"text":"六対の翼","translation":"","kind":"lyric"},{"id":"93","start":291.79,"end":293.22,"text":"暗黒を宿した瞳に","translation":"","kind":"lyric"},{"id":"94","start":293.22,"end":295.23,"text":"魅いられただけで","translation":"","kind":"lyric"},{"id":"95","start":295.23,"end":296.24,"text":"勇猛なる戦士が","translation":"","kind":"lyric"},{"id":"96","start":296.24,"end":298.59000000000003,"text":"次々と倒れていった","translation":"","kind":"lyric"},{"id":"97","start":298.59000000000003,"end":301.54,"text":"嗚呼 人間とは神の前では","translation":"","kind":"lyric"},{"id":"98","start":301.54,"end":304.31,"text":"かくも無力なモノなのだろうか","translation":"","kind":"lyric"},{"id":"99","start":304.31,"end":305.83,"text":"誰もが深い絶望に","translation":"","kind":"lyric"},{"id":"100","start":305.83,"end":307.83,"text":"呑まれかけていたその瞬間","translation":"","kind":"lyric"},{"id":"101","start":307.83,"end":309.59,"text":"ひと際眩い閃光が","translation":"","kind":"lyric"},{"id":"102","start":309.59,"end":312.57,"text":"雷無き青年の体を貫いた","translation":"","kind":"lyric"},{"id":"103","start":312.57,"end":314.16,"text":"「覚醒めよ","translation":"","kind":"lyric"},{"id":"104","start":314.16,"end":316.9,"text":"勇敢なる右腕を持つ者よ","translation":"","kind":"lyric"},{"id":"105","start":316.9,"end":319.84,"text":"直系の雷を受け継ぎし者よ","translation":"","kind":"lyric"},{"id":"106","start":319.84,"end":323.78,"text":"かつて私は邪神を封印せし折","translation":"","kind":"lyric"},{"id":"107","start":323.78,"end":327.87,"text":"雷の槍を放ったが故 右腕を失った","translation":"","kind":"lyric"},{"id":"108","start":327.87,"end":330.46,"text":"今その雷を開放すれば、","translation":"","kind":"lyric"},{"id":"109","start":330.46,"end":331.73,"text":"右腕はおろか","translation":"","kind":"lyric"},{"id":"110","start":331.73,"end":334.45,"text":"全身が吹き飛ぶやも知れぬ","translation":"","kind":"lyric"},{"id":"111","start":334.45,"end":337.25,"text":"御主にその覚悟があるか?","translation":"","kind":"lyric"},{"id":"112","start":337.25,"end":339.40999999999997,"text":"...ならば今こそ覚醒めよ","translation":"","kind":"lyric"},{"id":"113","start":339.40999999999997,"end":341.76,"text":"雷神の右腕よ!」","translation":"","kind":"lyric"},{"id":"114","start":341.76,"end":345.07,"text":"「ひとりでは耐え切れぬ","translation":"","kind":"lyric"},{"id":"115","start":345.07,"end":348.51,"text":"雷でもきっと","translation":"","kind":"lyric"},{"id":"116","start":348.51,"end":352.08,"text":"ふたりなら大丈夫","translation":"","kind":"lyric"},{"id":"117","start":352.08,"end":355.35,"text":"私は信じる!」","translation":"","kind":"lyric"},{"id":"118","start":355.35,"end":362.32,"text":"暗雲を貫く雷","translation":"","kind":"lyric"},{"id":"119","start":362.32,"end":365.13,"text":"あの日出会った","translation":"","kind":"lyric"},{"id":"120","start":365.13,"end":369.32,"text":"少年と少女は","translation":"","kind":"lyric"},{"id":"121","start":369.32,"end":372.18,"text":"今... 二つの紋章","translation":"","kind":"lyric"},{"id":"122","start":372.18,"end":376.6,"text":"重ね合わせて","translation":"","kind":"lyric"},{"id":"123","start":376.6,"end":384.59,"text":"輝ける未来を紡ぐ","translation":"","kind":"lyric"},{"id":"124","start":403.7,"end":406.7,"text":"「...ちゃん... ねぇ... お婆ちゃん...","translation":"","kind":"lyric"},{"id":"125","start":406.7,"end":409.02,"text":"お婆ちゃんったらぁ」","translation":"","kind":"lyric"},{"id":"126","start":409.02,"end":410.34000000000003,"text":"「どうしたの?","translation":"","kind":"lyric"},{"id":"127","start":410.34000000000003,"end":413.39,"text":"それからお話どうなったの?」","translation":"","kind":"lyric"},{"id":"128","start":413.39,"end":417.65999999999997,"text":"「おぉ... そうだったねぇ ごめんよ」","translation":"","kind":"lyric"},{"id":"129","start":417.65999999999997,"end":422.44,"text":"「その後 雷神様が邪神をやっつけたんだよね? ね?」","translation":"","kind":"lyric"},{"id":"130","start":422.44,"end":425.6,"text":"「さて、どうだったかねぇ...","translation":"","kind":"lyric"},{"id":"131","start":425.6,"end":433.19,"text":"昔の話だからもう忘れちゃったねぇ...」","translation":"","kind":"lyric"},{"id":"132","start":433.19,"end":436.53,"text":"そう言って微笑んだ祖母の瞳は","translation":"","kind":"lyric"},{"id":"133","start":436.53,"end":439.78,"text":"とても優しい色をしていた","translation":"","kind":"lyric"},{"id":"134","start":439.78,"end":441.76,"text":"その時の事は","translation":"","kind":"lyric"},{"id":"135","start":441.76,"end":445.12,"text":"今でも印象深く覚えている","translation":"","kind":"lyric"},{"id":"136","start":445.12,"end":448.01,"text":"私は信じているのだ","translation":"","kind":"lyric"},{"id":"137","start":448.01,"end":453.93,"text":"雷神の系譜は途絶えていないのだと","translation":"","kind":"lyric"},{"id":"138","start":453.93,"end":458.19,"text":"受け継がれるモノ...","translation":"","kind":"lyric"},{"id":"139","start":458.19,"end":462.58,"text":"受け継がれざるモノ...","translation":"","kind":"lyric"},{"id":"140","start":462.58,"end":467.55,"text":"暗雲を貫く光を翼に受け...","translation":"","kind":"lyric"},{"id":"141","start":467.55,"end":471.44,"text":"その白鴉は羽ばたいて往く...","translation":"","kind":"lyric"}],"candidates":[]}