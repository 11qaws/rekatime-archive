{"title":"D/N/A","artist":"Azari","date":"2026-07-14","sourceId":"YzJm-mk52WM:025","sourceHash":"45084d200e5a05556480f9c2b1a11abb8c8d3ff458c56e588121b0e03cefa5bb","duration":141.52,"cues":[{"id":"1","start":19.46,"end":23.16,"text":"小石高く高く積み上げては","translation":"작은 돌을 높이 높이 쌓아 올리고는","kind":"lyric"},{"id":"2","start":23.16,"end":26.46,"text":"吹きさらす心は夕暮れ","translation":"비바람 맞는 마음은 저물녘","kind":"lyric"},{"id":"3","start":26.46,"end":28.02,"text":"いつか見つかると","translation":"언젠가 찾을 거라","kind":"lyric"},{"id":"4","start":28.02,"end":29.62,"text":"まだ見つかると","translation":"아직 찾을 거라","kind":"lyric"},{"id":"5","start":29.62,"end":32.74,"text":"白く、甘く、淡く","translation":"하얗게 달게 아련하게","kind":"lyric"},{"id":"6","start":32.74,"end":35.8,"text":"影踏み遊びばかりしてきました","translation":"그림자밟기 놀이만 해 왔습니다","kind":"lyric"},{"id":"7","start":35.8,"end":39.92,"text":"贖い足がかり探して","translation":"속죄할 발판을 찾아","kind":"lyric"},{"id":"8","start":39.92,"end":40.68,"text":"いつか見つけると","translation":"언젠가 찾아낼 거라","kind":"lyric"},{"id":"9","start":40.68,"end":42.38,"text":"まだ見つけると","translation":"아직 찾아낼 거라","kind":"lyric"},{"id":"10","start":42.38,"end":45.96,"text":"永く、脆く、遠く","translation":"오래도록 여리게 멀리","kind":"lyric"},{"id":"11","start":46.3,"end":49.22,"text":"鏡越し貴方と","translation":"거울 너머의 당신과","kind":"lyric"},{"id":"12","start":49.46,"end":53.22,"text":"瞳の奥の私と","translation":"눈동자 깊은 곳의 나와","kind":"lyric"},{"id":"13","start":53.67,"end":56.82,"text":"誰かの中の貴方は","translation":"누군가 안의 당신은","kind":"lyric"},{"id":"14","start":56.82,"end":60.0,"text":"欠片のままに夢を見る","translation":"조각인 채로 꿈을 꿔","kind":"lyric"},{"id":"15","start":60.0,"end":63.23,"text":"だってDNAじゃ騙れない","translation":"DNA로는 속일 수 없으니까","kind":"lyric"},{"id":"16","start":63.23,"end":66.46,"text":"この心は私の中","translation":"이 마음은 내 안에","kind":"lyric"},{"id":"17","start":66.46,"end":67.62,"text":"紅く","translation":"붉게","kind":"lyric"},{"id":"18","start":69.92,"end":70.8,"text":"紅く","translation":"붉게","kind":"lyric"},{"id":"19","start":72.34,"end":75.98,"text":"眠れない迷子の無いものねだりじゃない","translation":"잠들지 못한 미아의 헛된 욕심이 아니야","kind":"lyric"},{"id":"20","start":75.98,"end":79.2,"text":"この細胞は愛憎刻まれてる","translation":"이 세포에는 애증이 새겨져 있어","kind":"lyric"},{"id":"21","start":79.2,"end":80.76,"text":"まだ見つけるの","translation":"아직도 찾을 거야","kind":"lyric"},{"id":"22","start":80.76,"end":82.46,"text":"まだ見つけるの","translation":"아직도 찾을 거야","kind":"lyric"},{"id":"23","start":82.46,"end":85.6,"text":"言えなかった音は？","translation":"끝내 말하지 못한 소리는","kind":"lyric"},{"id":"24","start":85.6,"end":88.82,"text":"誰かの中の貴方は","translation":"누군가 안의 당신은","kind":"lyric"},{"id":"25","start":88.82,"end":92.02,"text":"繋がれたまま夢を見る","translation":"이어진 채로 꿈을 꿔","kind":"lyric"},{"id":"26","start":92.02,"end":95.28,"text":"だってDNAじゃ語れない","translation":"DNA로는 말할 수 없으니까","kind":"lyric"},{"id":"27","start":95.32,"end":98.44,"text":"この痛みも私の中","translation":"이 아픔도 내 안에","kind":"lyric"},{"id":"28","start":98.44,"end":99.56,"text":"紅く","translation":"붉게","kind":"lyric"},{"id":"29","start":101.02,"end":103.16,"text":"紅く","translation":"붉게","kind":"lyric"},{"id":"30","start":104.1,"end":107.88,"text":"鏡の形と","translation":"거울의 모습과","kind":"lyric"},{"id":"31","start":107.88,"end":111.22,"text":"逆さまなDNA","translation":"뒤집힌 DNA","kind":"lyric"},{"id":"32","start":111.22,"end":114.56,"text":"私の証と","translation":"나라는 증거와","kind":"lyric"},{"id":"33","start":114.56,"end":117.74,"text":"暖かなDNA","translation":"따스한 DNA","kind":"lyric"},{"id":"34","start":117.74,"end":121.1,"text":"鏡の形と","translation":"거울의 모습과","kind":"lyric"},{"id":"35","start":121.1,"end":124.21,"text":"逆さまなDNA","translation":"뒤집힌 DNA","kind":"lyric"},{"id":"36","start":124.21,"end":127.36,"text":"私の証と","translation":"나라는 증거와","kind":"lyric"},{"id":"37","start":127.36,"end":130.96,"text":"暖かなDNA","translation":"따스한 DNA","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}