{"originalLanguage":"ja","title":"악의 딸","artist":"悪ノP","date":"2026-09-04","sourceId":"15033796:011","sourceHash":"8eef1589809652c1399130a90e00c6a204fbcb73b1ae111ffcd8fadd0423a5b8","duration":283.58,"cues":[{"id":"1","start":4.19,"end":7.54,"text":"むかしむかしあるところに","translation":"옛날 옛적 어느 곳에","kind":"lyric"},{"id":"2","start":7.54,"end":10.98,"text":"悪逆非道の王国の","translation":"악랄하고 무도한 왕국의","kind":"lyric"},{"id":"3","start":10.98,"end":14.48,"text":"頂点に君臨するは","translation":"정점에 군림한 사람은","kind":"lyric"},{"id":"4","start":15.78,"end":18.22,"text":"齢十四の王女様","translation":"열네 살 왕녀님","kind":"lyric"},{"id":"5","start":19.12,"end":22.21,"text":"絢爛豪華な調度品","translation":"화려하고 호화로운 가구","kind":"lyric"},{"id":"6","start":22.21,"end":26.21,"text":"顔のよく似た召使","translation":"얼굴이 꼭 닮은 하인","kind":"lyric"},{"id":"7","start":26.21,"end":28.99,"text":"愛馬の名前はジョセフィーヌ","translation":"애마의 이름은 조세핀","kind":"lyric"},{"id":"8","start":28.99,"end":31.48,"text":"全てが全て彼女のもの","translation":"모든 것이 전부 그녀의 것","kind":"lyric"},{"id":"9","start":31.48,"end":35.44,"text":"お金が足りなくなったなら","translation":"돈이 부족해진다면","kind":"lyric"},{"id":"10","start":37.04,"end":38.5,"text":"愚民どもから搾りとれ","translation":"어리석은 백성에게서 쥐어짜라","kind":"lyric"},{"id":"11","start":38.5,"end":42.18,"text":"私に逆らう者たちは","translation":"내게 거역하는 자들은","kind":"lyric"},{"id":"12","start":42.82,"end":44.76,"text":"粛清してしまえ","translation":"모조리 숙청하라","kind":"lyric"},{"id":"13","start":45.8,"end":48.36,"text":"「さあ、ひざまずきなさい！」","translation":"자 무릎을 꿇어라","kind":"lyric"},{"id":"14","start":51.1,"end":53.8,"text":"悪の華 可憐に咲く","translation":"악의 꽃이 어여쁘게 피어","kind":"lyric"},{"id":"15","start":54.14,"end":57.38,"text":"鮮やかな彩りで","translation":"선명한 빛깔로","kind":"lyric"},{"id":"16","start":57.66,"end":59.12,"text":"周りの哀れな雑草は","translation":"주변의 가련한 잡초들은","kind":"lyric"},{"id":"17","start":61.02,"end":63.56,"text":"嗚呼 養分となり朽ちていく","translation":"아 양분이 되어 시들어 가","kind":"lyric"},{"id":"18","start":64.9,"end":66.38,"text":"暴君王女が恋するは","translation":"폭군 왕녀가 사랑한 사람은","kind":"lyric"},{"id":"19","start":66.38,"end":69.5,"text":"海の向こうの青い人","translation":"바다 건너 푸른 왕자","kind":"lyric"},{"id":"20","start":69.5,"end":72.96,"text":"だけども彼は隣国の","translation":"하지만 그는 이웃 나라의","kind":"lyric"},{"id":"21","start":72.96,"end":76.76,"text":"緑の女にひとめぼれ","translation":"초록의 여인에게 첫눈에 반했어","kind":"lyric"},{"id":"22","start":76.76,"end":79.38,"text":"嫉妬に狂った王女様","translation":"질투에 미친 왕녀님은","kind":"lyric"},{"id":"23","start":79.38,"end":82.64,"text":"ある日大臣を呼び出して","translation":"어느 날 대신을 불러내","kind":"lyric"},{"id":"24","start":82.64,"end":86.16,"text":"静かな声で言いました","translation":"조용한 목소리로 말했어","kind":"lyric"},{"id":"25","start":86.48,"end":89.46,"text":"「緑の国を滅ぼしなさい」","translation":"초록의 나라를 멸망시켜라","kind":"lyric"},{"id":"26","start":89.46,"end":92.5,"text":"幾多の家が焼き払われ","translation":"수많은 집이 불타고","kind":"lyric"},{"id":"27","start":92.5,"end":95.62,"text":"幾多の命が消えていく","translation":"수많은 생명이 사라져 가","kind":"lyric"},{"id":"28","start":95.62,"end":98.88,"text":"苦しむ人々の嘆きは","translation":"고통받는 사람들의 탄식은","kind":"lyric"},{"id":"29","start":98.88,"end":101.72,"text":"王女には届かない","translation":"왕녀에게 닿지 않아","kind":"lyric"},{"id":"30","start":102.6,"end":105.48,"text":"「あら、おやつの時間だわ」","translation":"어머 간식 시간이네","kind":"lyric"},{"id":"31","start":109.06,"end":110.22,"text":"悪の華 可憐に咲く","translation":"악의 꽃이 어여쁘게 피어","kind":"lyric"},{"id":"32","start":111.24,"end":113.66,"text":"狂おしい彩りで","translation":"광기 어린 빛깔로","kind":"lyric"},{"id":"33","start":114.66,"end":117.9,"text":"とても美しい花なのに","translation":"그토록 아름다운 꽃인데도","kind":"lyric"},{"id":"34","start":118.34,"end":120.7,"text":"嗚呼 棘が多すぎて触れない","translation":"아 가시가 너무 많아 만질 수 없어","kind":"lyric"},{"id":"35","start":127.66,"end":130.18,"text":"悪の王女を倒すべく","translation":"악의 왕녀를 쓰러뜨리려고","kind":"lyric"},{"id":"36","start":130.18,"end":134.12,"text":"ついに人々は立ち上がる","translation":"마침내 사람들이 일어났어","kind":"lyric"},{"id":"37","start":134.82,"end":136.7,"text":"烏合の彼らを率いるは","translation":"오합지졸인 그들을 이끄는 사람은","kind":"lyric"},{"id":"38","start":136.7,"end":140.24,"text":"赤き鎧の女剣士","translation":"붉은 갑옷의 여검사","kind":"lyric"},{"id":"39","start":140.72,"end":143.1,"text":"つもりにつもったその怒り","translation":"쌓이고 쌓인 그 분노가","kind":"lyric"},{"id":"40","start":143.1,"end":146.32,"text":"国全体を包み込んだ","translation":"나라 전체를 뒤덮었어","kind":"lyric"},{"id":"41","start":146.32,"end":149.28,"text":"長年の戦で疲れた","translation":"오랜 전쟁에 지쳐 버린","kind":"lyric"},{"id":"42","start":149.28,"end":152.84,"text":"兵士たちなど敵ではない","translation":"병사 따위는 상대가 되지 않아","kind":"lyric"},{"id":"43","start":152.9,"end":156.0,"text":"ついに王宮は囲まれて","translation":"마침내 왕궁이 포위되고","kind":"lyric"},{"id":"44","start":156.88,"end":159.16,"text":"家臣たちも逃げ出した","translation":"신하들도 달아났어","kind":"lyric"},{"id":"45","start":159.4,"end":161.88,"text":"可愛く可憐な王女様","translation":"사랑스럽고 어여쁜 왕녀님","kind":"lyric"},{"id":"46","start":161.88,"end":164.66,"text":"ついに捕らえられた","translation":"마침내 붙잡혔어","kind":"lyric"},{"id":"47","start":166.36,"end":168.38,"text":"「この 無礼者！」","translation":"이 무례한 자","kind":"lyric"},{"id":"48","start":170.48,"end":173.34,"text":"悪の華 可憐に咲く","translation":"악의 꽃이 어여쁘게 피어","kind":"lyric"},{"id":"49","start":178.24,"end":179.5,"text":"悲しげな彩りで","translation":"슬픈 빛깔로","kind":"lyric"},{"id":"50","start":180.4,"end":183.68,"text":"彼女のための楽園は","translation":"그녀를 위한 낙원은","kind":"lyric"},{"id":"51","start":184.32,"end":186.84,"text":"嗚呼 もろくもはかなく崩れてく","translation":"아 허망하고도 덧없이 무너져 가","kind":"lyric"},{"id":"52","start":188.2,"end":189.88,"text":"むかしむかしあるところに","translation":"옛날 옛적 어느 곳에","kind":"lyric"},{"id":"53","start":189.88,"end":192.76,"text":"悪逆非道の王国の","translation":"악랄하고 무도한 왕국의","kind":"lyric"},{"id":"54","start":192.82,"end":196.28,"text":"頂点に君臨してた","translation":"정점에 군림했던","kind":"lyric"},{"id":"55","start":198.16,"end":199.46,"text":"齢十四の王女様","translation":"열네 살 왕녀님","kind":"lyric"},{"id":"56","start":200.68,"end":204.0,"text":"処刑の時間は午後三時","translation":"처형 시간은 오후 세 시","kind":"lyric"},{"id":"57","start":204.0,"end":206.42,"text":"教会の鐘が鳴る時間","translation":"교회의 종이 울리는 시간","kind":"lyric"},{"id":"58","start":206.42,"end":209.88,"text":"王女と呼ばれたその人は","translation":"왕녀라 불린 그 사람은","kind":"lyric"},{"id":"59","start":209.88,"end":213.2,"text":"一人牢屋で何を思う","translation":"홀로 감옥에서 무슨 생각을 할까","kind":"lyric"},{"id":"60","start":213.2,"end":216.5,"text":"ついにその時はやってきて","translation":"마침내 그때가 찾아오고","kind":"lyric"},{"id":"61","start":216.64,"end":220.18,"text":"終わりを告げる鐘が鳴る","translation":"끝을 알리는 종이 울려","kind":"lyric"},{"id":"62","start":231.34,"end":233.92,"text":"彼女はこういった","translation":"그녀는 이렇게 말했어","kind":"lyric"},{"id":"63","start":235.62,"end":238.84,"text":"「あら、おやつの時間だわ」","translation":"어머 간식 시간이네","kind":"lyric"},{"id":"64","start":244.9,"end":246.38,"text":"悪の華 可憐に散る","translation":"악의 꽃이 어여쁘게 져","kind":"lyric"},{"id":"65","start":252.34,"end":258.78,"text":"鮮やかな彩りで","translation":"선명한 빛깔로","kind":"lyric"},{"id":"66","start":258.78,"end":263.58,"text":"のちの人々はこう語る","translation":"훗날 사람들은 이렇게 말했어","kind":"lyric"},{"id":"67","start":263.58,"end":268.98,"text":"嗚呼 彼女は正に悪ノ娘","translation":"아 그녀야말로 진정한 악의 딸","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}