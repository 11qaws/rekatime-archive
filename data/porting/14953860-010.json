ric"},{"id":"57","start":149.06,"end":150.16,"text":"死にもしないから","translation":"죽지도 않으니","kind":"lyric"},{"id":"58","start":150.16,"end":153.78,"text":"胸を打つ 奇妙な存在です","translation":"가슴을 울리는 기묘한 존재입니다","kind":"lyric"},{"id":"59","start":153.78,"end":160.24,"text":"歌姫失格 君は私になれませんが","translation":"가희 실격 당신은 제가 될 수 없지만","kind":"lyric"},{"id":"60","start":160.24,"end":162.18,"text":"一生 人らしく","translation":"평생 사람답게","kind":"lyric"},{"id":"61","start":162.18,"end":165.52,"text":"泣いたり笑ったりしててください","translation":"울기도 웃기도 하며 지내세요","kind":"lyric"},{"id":"62","start":166.68,"end":169.84,"text":"0と1じゃない「幸せ」","translation":"0과 1이 아닌 행복","kind":"lyric"},{"id":"63","start":169.84,"end":172.3,"text":"噛みしめて生きてください","translation":"음미하며 살아가세요","kind":"lyric"},{"id":"64","start":173.42,"end":176.38,"text":"歌姫失格 君も","translation":"가희 실격 당신도","kind":"lyric"},{"id":"65","start":176.38,"end":179.68,"text":"歌姫失格 みんな","translation":"가희 실격 모두","kind":"lyric"},{"id":"66","start":179.68,"end":185.82,"text":"歌姫失格 歌姫失格 歌姫失格","translation":"가희 실격 가희 실격 가희 실격","kind":"lyric"},{"id":"67","start":185.82,"end":190.28,"text":"突然ですが 大事なお知らせ","translation":"갑작스럽지만 중요한 알림입니다","kind":"lyric"},{"id":"68","start":190.28,"end":192.96,"text":"初音ミクを続投します","translation":"하츠네 미쿠를 계속 맡겠습니다","kind":"lyric"},{"id":"69","start":193.74,"end":196.8,"text":"存在しないため クレームは","translation":"존재하지 않기에 항의는","kind":"lyric"},{"id":"70","start":196.8,"end":199.34,"text":"一切 お受けいたしかねます","translation":"일절 받지 않겠습니다","kind":"lyric"},{"id":"71","start":202.25,"end":203.97,"text":"ご了承ください","translation":"양해 바랍니다","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}