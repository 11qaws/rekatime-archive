00000002,"end":152.29,"text":"許せぬ優しさと 揺れぐ独占欲は","translation":"","kind":"lyric"},{"id":"18","start":152.29,"end":161.25,"text":"秤にかけれぬ 我儘な愛","translation":"","kind":"lyric"},{"id":"19","start":182.03,"end":188.73,"text":"色は匂へど すべて散りぬるを","translation":"","kind":"lyric"},{"id":"20","start":188.73,"end":195.68,"text":"短き記憶に 零れる想い","translation":"","kind":"lyric"},{"id":"21","start":195.68,"end":202.76,"text":"枯れ行く命よ 儚く強く在れ","translation":"","kind":"lyric"},{"id":"22","start":202.76,"end":212.22,"text":"無慈悲で優しい 時のように","translation":"","kind":"lyric"}],"candidates":[]}