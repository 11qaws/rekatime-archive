{"title":"아아, 완벽한 고양이의 삶","artist":"Nem","sourceId":"reference:OW5l5VzV5U4p7rALt5rD","sourceHash":"62b99fcbe470aa131bc15a5521811a0c163558ba409a82f266162bfe001e8a59","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":27489761,"cues":[{"id":"1","start":10.73,"end":13.47,"text":"これは可愛いお嬢さん","translation":"","kind":"lyric"},{"id":"2","start":13.47,"end":15.87,"text":"真っ白な毛がとても素敵ね","translation":"","kind":"lyric"},{"id":"3","start":15.87,"end":18.3,"text":"こんな月が綺麗な夜は","translation":"","kind":"lyric"},{"id":"4","start":18.3,"end":20.72,"text":"僕と一緒に遊びませんか","translation":"","kind":"lyric"},{"id":"5","start":20.72,"end":25.59,"text":"ニャン生は一度きり","translation":"","kind":"lyric"},{"id":"6","start":25.59,"end":30.58,"text":"楽しむが勝ちなのです","translation":"","kind":"lyric"},{"id":"7","start":30.58,"end":35.47,"text":"あなたを縛る首輪は","translation":"","kind":"lyric"},{"id":"8","start":35.47,"end":40.44,"text":"噛み千切ってあげましょう","translation":"","kind":"lyric"},{"id":"9","start":40.44,"end":43.44,"text":"野良は最高ニャンニャンニャン","translation":"","kind":"lyric"},{"id":"10","start":43.44,"end":45.84,"text":"魚くすねて、ハト追いかけて","translation":"","kind":"lyric"},{"id":"11","start":45.84,"end":48.28,"text":"昼間は働く人間を","translation":"","kind":"lyric"},{"id":"12","start":48.28,"end":50.66,"text":"尻目に屋根の上で夢うつつ","translation":"","kind":"lyric"},{"id":"13","start":50.66,"end":53.09,"text":"あなたも自由にニャンニャンニャン","translation":"","kind":"lyric"},{"id":"14","start":53.09,"end":55.78,"text":"素敵な仲間も紹介しましょう","translation":"","kind":"lyric"},{"id":"15","start":55.78,"end":60.04,"text":"さあ、その窓を開いて","translation":"","kind":"lyric"},{"id":"16","start":60.04,"end":70.56,"text":"飛び出すのです！","translation":"","kind":"lyric"},{"id":"17","start":70.56,"end":73.1,"text":"これは気ままな野良猫さん","translation":"","kind":"lyric"},{"id":"18","start":73.1,"end":75.37,"text":"闇の中目だけが光ってる","translation":"","kind":"lyric"},{"id":"19","start":75.37,"end":77.78999999999999,"text":"随分口が上手だけど","translation":"","kind":"lyric"},{"id":"20","start":77.78999999999999,"end":80.42,"text":"私はバカな女じゃないわ","translation":"","kind":"lyric"},{"id":"21","start":80.42,"end":85.28,"text":"ニャン生は一度きり","translation":"","kind":"lyric"},{"id":"22","start":85.28,"end":90.0,"text":"だからこそ飼われるのよ","translation":"","kind":"lyric"},{"id":"23","start":90.0,"end":95.16,"text":"ブランド首輪の価値が","translation":"","kind":"lyric"},{"id":"24","start":95.16,"end":100.15,"text":"あなたには分かるかしら？","translation":"","kind":"lyric"},{"id":"25","start":100.15,"end":102.65,"text":"私は優雅よニャンニャンニャン","translation":"","kind":"lyric"},{"id":"26","start":102.65,"end":105.28,"text":"美味しい食事にふかふかベッド","translation":"","kind":"lyric"},{"id":"27","start":105.28,"end":107.47,"text":"水はちょっぴり苦手だけど","translation":"","kind":"lyric"},{"id":"28","start":107.47,"end":110.05,"text":"毎日シャワーだって浴びれるの","translation":"","kind":"lyric"},{"id":"29","start":110.05,"end":112.47,"text":"それに比べてニャンニャンニャン","translation":"","kind":"lyric"},{"id":"30","start":112.47,"end":115.17,"text":"あなたは誰に守ってもらうの？","translation":"","kind":"lyric"},{"id":"31","start":115.17,"end":119.47999999999999,"text":"明日車に轢かれるかも","translation":"","kind":"lyric"},{"id":"32","start":119.47999999999999,"end":129.74,"text":"知れないじゃない！","translation":"","kind":"lyric"},{"id":"33","start":129.74,"end":134.64,"text":"そんな強気なとこも素敵です","translation":"","kind":"lyric"},{"id":"34","start":134.64,"end":139.98,"text":"一層あなたを好きになりました","translation":"","kind":"lyric"},{"id":"35","start":139.98,"end":144.76,"text":"あら正直ね、でもそんなやり方じゃ","translation":"","kind":"lyric"},{"id":"36","start":144.76,"end":151.93,"text":"ココロ揺らがないわ","translation":"","kind":"lyric"},{"id":"37","start":151.93,"end":154.67000000000002,"text":"僕の夢はニャンニャンニャン","translation":"","kind":"lyric"},{"id":"38","start":154.67000000000002,"end":157.03,"text":"いつかはこの街を飛び出して","translation":"","kind":"lyric"},{"id":"39","start":157.03,"end":159.46,"text":"はるか北の国に旅して","translation":"","kind":"lyric"},{"id":"40","start":159.46,"end":162.1,"text":"オーロラをこの目で見ることです","translation":"","kind":"lyric"},{"id":"41","start":162.1,"end":164.88,"text":"そこにあなたがニャンニャンニャン","translation":"","kind":"lyric"},{"id":"42","start":164.88,"end":166.94,"text":"居てくれたらなんて素敵でしょう","translation":"","kind":"lyric"},{"id":"43","start":166.94,"end":171.77,"text":"だけどそれは叶わないらしい...","translation":"","kind":"lyric"},{"id":"44","start":171.77,"end":174.47,"text":"生き方はニャンニャンニャン","translation":"","kind":"lyric"},{"id":"45","start":174.47,"end":176.81,"text":"そう簡単には変えられないの","translation":"","kind":"lyric"},{"id":"46","start":176.81,"end":179.3,"text":"それに私を飼っている","translation":"","kind":"lyric"},{"id":"47","start":179.3,"end":181.64,"text":"女の子を一人にできないわ","translation":"","kind":"lyric"},{"id":"48","start":181.64,"end":184.62,"text":"話の途中よニャンニャンニャン","translation":"","kind":"lyric"},{"id":"49","start":184.62,"end":187.28,"text":"あらもう行っちゃうの？ねえちょっと！","translation":"","kind":"lyric"},{"id":"50","start":187.28,"end":191.82,"text":"明日もここに来ていいのよ","translation":"","kind":"lyric"},{"id":"51","start":191.82,"end":200.23,"text":"待ってるから...","translation":"","kind":"lyric"}],"candidates":[]}