{"title":"Empire","artist":"Beth Crowley","sourceId":"reference:updbiNuy1M6eF0ZRzRVa","sourceHash":"6d76730d40b5d9f8c4c26dfbb961f64186b36cefda230f0f8eb4904805757101","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":13.07,"end":16.07,"text":"I can hear the whispers in my sleep","translation":"","kind":"lyric"},{"id":"2","start":18.75,"end":21.75,"text":"The voices telling me this should be mine","translation":"","kind":"lyric"},{"id":"3","start":24.76,"end":26.5,"text":"You (you)","translation":"","kind":"lyric"},{"id":"4","start":26.5,"end":29.5,"text":"You claim you trust me (you claim you trust me)","translation":"","kind":"lyric"},{"id":"5","start":30.07,"end":33.07,"text":"You think I don't see the doubt behind your eyes","translation":"","kind":"lyric"},{"id":"6","start":35.13,"end":38.13,"text":"I'm gonna build me an empire","translation":"","kind":"lyric"},{"id":"7","start":39.0,"end":42.0,"text":"And it's lonely at the top","translation":"","kind":"lyric"},{"id":"8","start":42.17,"end":43.45,"text":"But madness and greatness","translation":"","kind":"lyric"},{"id":"9","start":43.45,"end":44.72,"text":"Can both share a face","translation":"","kind":"lyric"},{"id":"10","start":44.72,"end":47.72,"text":"And nobody will ever convince me to stop","translation":"","kind":"lyric"},{"id":"11","start":47.81,"end":50.81,"text":"It's my destiny (it's my destiny)","translation":"","kind":"lyric"},{"id":"12","start":50.85,"end":53.61,"text":"I was born to play this game","translation":"","kind":"lyric"},{"id":"13","start":53.61,"end":55.87,"text":"So fear me or love me","translation":"","kind":"lyric"},{"id":"14","start":55.87,"end":58.87,"text":"It's all the same","translation":"","kind":"lyric"},{"id":"15","start":59.81,"end":62.81,"text":"Try (try, try) to find a chain that I won't break (a chain that I won't break)","translation":"","kind":"lyric"},{"id":"16","start":65.56,"end":68.56,"text":"A price I wouldn't pay for what I want (for what I want)","translation":"","kind":"lyric"},{"id":"17","start":71.38,"end":74.38,"text":"So you can call me calculating (you can call me calculating)","translation":"","kind":"lyric"},{"id":"18","start":74.49,"end":77.49,"text":"You can say I've lost my mind (you can say I've lost my mind)","translation":"","kind":"lyric"},{"id":"19","start":77.57,"end":79.31,"text":"You can throw me to the wolves","translation":"","kind":"lyric"},{"id":"20","start":79.31,"end":81.74,"text":"I'll be alright","translation":"","kind":"lyric"},{"id":"21","start":81.74,"end":84.74,"text":"I'm gonna build me an empire","translation":"","kind":"lyric"},{"id":"22","start":85.81,"end":88.81,"text":"And it's lonely at the top","translation":"","kind":"lyric"},{"id":"23","start":88.91,"end":90.38,"text":"But madness and greatness","translation":"","kind":"lyric"},{"id":"24","start":90.38,"end":91.5,"text":"Can both share a face","translation":"","kind":"lyric"},{"id":"25","start":91.5,"end":94.5,"text":"And nobody will ever convince me to stop","translation":"","kind":"lyric"},{"id":"26","start":94.65,"end":97.55,"text":"It's my destiny (it's my destiny)","translation":"","kind":"lyric"},{"id":"27","start":97.55,"end":100.25,"text":"I was born to play this game","translation":"","kind":"lyric"},{"id":"28","start":100.25,"end":102.65,"text":"So fear me or love me","translation":"","kind":"lyric"},{"id":"29","start":102.65,"end":105.65,"text":"It's all the same (it's all the same, it's all the same...)","translation":"","kind":"lyric"},{"id":"30","start":109.78,"end":112.78,"text":"Just one word, I'll let the world burn","translation":"","kind":"lyric"},{"id":"31","start":121.22,"end":124.22,"text":"Just one word, I'll let the world burn","translation":"","kind":"lyric"},{"id":"32","start":155.02,"end":158.02,"text":"I'm gonna build me an empire","translation":"","ki