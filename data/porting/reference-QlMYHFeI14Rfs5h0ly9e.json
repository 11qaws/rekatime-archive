"kind":"lyric"},{"id":"101","start":472.47,"end":475.12,"text":"モリへ 至ル 井戸ノ 中デ","translation":"","kind":"lyric"},{"id":"102","start":475.12,"end":477.87,"text":"私ハ 殺意ヲ 唄ウ オ人形","translation":"","kind":"lyric"},{"id":"103","start":477.87,"end":480.49,"text":"イドへ 至ル 森ノ中デ","translation":"","kind":"lyric"},{"id":"104","start":480.49,"end":483.27,"text":"錏痾 蛙遭 嗟有 合或 吾会 在唖 逢娃 婀堊...","translation":"","kind":"lyric"},{"id":"105","start":483.27,"end":485.55,"text":"モリへ 至ル 井戸ノ 中デ","translation":"","kind":"lyric"},{"id":"106","start":485.55,"end":488.13,"text":"宵闇ニ 踊ル 深紅ト 漆黒ノ 影","translation":"","kind":"lyric"},{"id":"107","start":488.13,"end":490.85,"text":"イドへ 至ル 森ノ 中デ","translation":"","kind":"lyric"},{"id":"108","start":490.85,"end":493.4,"text":"人ヲ 殺メテ 未来 奪ッタ","translation":"","kind":"lyric"},{"id":"109","start":493.4,"end":496.4,"text":"奴ガ 裁カレズ 生キ延ビル ナド","translation":"","kind":"lyric"},{"id":"110","start":496.48,"end":499.48,"text":"赦シハ シナイ","translation":"","kind":"lyric"},{"id":"111","start":499.84,"end":502.84,"text":"【此の地平に宵闇が訪れた】","translation":"","kind":"lyric"},{"id":"112","start":503.29,"end":506.29,"text":"【終焉へと疾りだす】","translation":"","kind":"lyric"},{"id":"113","start":506.43,"end":509.43,"text":"【夜の復讐劇】","translation":"","kind":"lyric"},{"id":"114","start":510.38,"end":513.38,"text":"【第七の地平線】","translation":"","kind":"lyric"},{"id":"115","start":513.81,"end":516.26,"text":"月光に 照らされて","translation":"","kind":"lyric"},{"id":"116","start":516.26,"end":518.86,"text":"凶行へ 羽ばたいた","translation":"","kind":"lyric"},{"id":"117","start":518.86,"end":521.86,"text":"旋律が 絡み合う 夜に","translation":"","kind":"lyric"},{"id":"118","start":523.57,"end":526.52,"text":"嗚呼 復讐は 罪が故に","translation":"","kind":"lyric"},{"id":"119","start":526.52,"end":529.26,"text":"粛々と 受け入れ 給え","translation":"","kind":"lyric"},{"id":"120","start":529.26,"end":532.26,"text":"嘆いたところで もう手遅れさ","translation":"","kind":"lyric"},{"id":"121","start":533.23,"end":536.23,"text":"終に 宵闇の 此の楽団で","translation":"","kind":"lyric"},{"id":"122","start":536.83,"end":539.55,"text":"憾みを 唄いたいなら","translation":"","kind":"lyric"},{"id":"123","start":539.55,"end":542.55,"text":"屍揮者は 君の味方さ!","translation":"","kind":"lyric"},{"id":"124","start":542.9,"end":545.9,"text":"「さぁ、潔く死んでから出直してくれたまえ！」","translation":"","kind":"lyric"},{"id":"125","start":548.2,"end":550.21,"text":"「Sieben Sechs Funf Vier」","translation":"","kind":"lyric"},{"id":"126","start":550.21,"end":553.21,"text":"「Drei Zwei Eins Los!」","translation":"","kind":"lyric"},{"id":"127","start":553.23,"end":554.54,"text":"消える 影","translation":"","kind":"lyric"},{"id":"128","start":554.54,"end":556.1,"text":"腕を 伸ばせど","translation":"","kind":"lyric"},{"id":"129","start":556.1,"end":558.28,"text":"闇は 既に深く","translation":"","kind":"lyric"},{"id":"130","start":558.28,"end":559.57,"text":"お嬢さん (フロイライン)","translation":"","kind":"lyric"},{"id":"131","start":559.57,"end":561.36,"text":"君の輝き (ダイン シャイン)","translation":"","kind":"lyric"},{"id":"132","start":561.36,"end":563.61,"text":"在りし日々は 過去の 残照","translation":"","kind":"lyric"},{"id":"133","start":563.61,"end":566.23,"text":"生前に 夢見た 楽園","translation":"","kind":"lyric"},{"id":"134","start":566.23,"end":568.95,"text":"嗚呼 然れど 忘却","translation":"","kind":"lyric"},{"id":"135","start":568.95,"end":570.56,"text":"小さな川","translation":"","kind":"lyric"},{"id":"136","start":570.56,"end":571.1,"text":"緋い葡萄酒","translation":"","kind":"lyric"},{"id":"137","start":571.1,"end":574.1,"text":"乾かぬ間に 紡ぎなさい さぁ","translation":"","kind":"lyric"},{"id":"138","start":575.69,"end":578.69,"text":"死の歴史を!","translation":"","kind":"lyric"},{"id":"139","start":579.6,"end":582.1,"text":"「ウフフ！愛シテルワ、メル」","translation":"","kind":"lyric"},{"id":"140","start":582.1,"end":585.1,"text":"「ズットズーット 二人デ 復讐 シ続ケヨウネ」","translation":"","kind":"lyric"},{"id":"141","start":586.06,"end":589.06,"text":"「オ馬鹿サンノ 復讐ヲ 手伝ウ事 コソ、私達ノ 復讐」","translation":"","kind":"lyric"},{"id":"142","start":590.35,"end":593.35,"text":"「コレナラ、永遠ニ 続ケラレルワ」","translation":