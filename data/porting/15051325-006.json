{"originalLanguage":"ja","title":"점묘의 노래","artist":"Mrs. GREEN APPLE","date":"2026-09-05","sourceId":"15051325:006","sourceHash":"6615bbdc1c6ad50c03747503a64a0077e5ed08d2dfeb1cda7653f20a2e81b43c","duration":260.6,"cues":[{"id":"1","start":5.66,"end":12.537,"text":"貴方の声で解れてゆく","translation":"그대 목소리에 서서히 풀려 가","kind":"lyric"},{"id":"2","start":12.537,"end":19.374,"text":"忘れたくないと心が云う","translation":"잊고 싶지 않다고 마음이 말해","kind":"lyric"},{"id":"3","start":19.434,"end":25.072,"text":"思い出ばっか増えてゆく","translation":"추억만 늘어만 가","kind":"lyric"},{"id":"4","start":25.351,"end":30.929,"text":"ずっと側に居たい","translation":"줄곧 곁에 머물고 싶어","kind":"lyric"},{"id":"5","start":30.929,"end":35.807,"text":"泣き虫でもいいかな","translation":"울보여도 괜찮을까","kind":"lyric"},{"id":"6","start":37.226,"end":42.644,"text":"強がらないでいいよ","translation":"센 척하지 않아도 돼","kind":"lyric"},{"id":"7","start":43.543,"end":50.24,"text":"限りある恋だとしても","translation":"끝이 있는 사랑이라 해도","kind":"lyric"},{"id":"8","start":50.24,"end":55.078,"text":"出逢えて幸せです","translation":"그대를 만나 행복해요","kind":"lyric"},{"id":"9","start":56.517639,"end":59.196,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"10","start":59.196,"end":62.275,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"11","start":62.275,"end":68.572,"text":"続いて欲しいと願っている","translation":"이어지기를 바라고 있어","kind":"lyric"},{"id":"12","start":68.572,"end":75.049,"text":"手を取ることは出来ずとも","translation":"손을 잡지는 못하더라도","kind":"lyric"},{"id":"13","start":75.049,"end":81.847,"text":"私は貴方を好いている","translation":"나는 그대를 마음에 품고 있어","kind":"lyric"},{"id":"14","start":82.725996,"end":88.963,"text":"貴方の夢で心安らぐ","translation":"그대가 나오는 꿈에 마음이 놓여","kind":"lyric"},{"id":"15","start":89.243,"end":95.021,"text":"目覚めたくないと僕は云う","translation":"깨어나고 싶지 않다고 나는 말해","kind":"lyric"},{"id":"16","start":95.92,"end":100.977888,"text":"思い出ばっか増えてゆく","translation":"추억만 늘어만 가","kind":"lyric"},{"id":"17","start":100.977888,"end":108.335,"text":"明日も側に居たい","translation":"내일도 곁에 머물고 싶어","kind":"lyric"},{"id":"18","start":119.789531,"end":123.068,"text":"どこまでも","translation":"어디까지고","kind":"lyric"},{"id":"19","start":123.068,"end":126.266654,"text":"どこまでも","translation":"어디까지고","kind":"lyric"},{"id":"20","start":126.266654,"end":132.783759,"text":"鈍感な僕を叱って欲しい","translation":"무딘 나를 나무라 줬으면 해","kind":"lyric"},{"id":"21","start":132.783759,"end":139.24089,"text":"当たり前が壊れることに","translation":"당연하던 것이 무너지는 걸","kind":"lyric"},{"id":"22","start":139.24089,"end":144.918,"text":"気づけないくらいに子供だけど","translation":"알아차리지 못할 만큼 어리지만","kind":"lyric"},{"id":"23","start":144.918,"end":151.555,"text":"ちゃんと僕は貴方を好いている","translation":"그래도 나는 그대를 진심으로 좋아해","kind":"lyric"},{"id":"24","start":151.555,"end":165.989,"text":"私の (僕の) 時間が止まればいいのに","translation":"우리 둘의 시간이 멈추면 좋을 텐데","kind":"lyric"},{"id":"25","start":177.124,"end":181.122,"text":"ほらまた期待をしてしまう","translation":"봐 또 기대하고 말아","kind":"lyric"},{"id":"26","start":181.122,"end":183.861,"text":"グッと堪えてみるからさ","translation":"꾹 눌러 참아 볼 테니까","kind":"lyric"},{"id":"27","start":183.861,"end":185.88,"text":"もし溢れ出したら","translation":"만일 넘쳐 버린다면","kind":"lyric"},{"id":"28","start":185.88,"end":189.198697,"text":"瞳をちゃんと見てよ 見てよ 見て","translation":"내 눈을 제대로 바라봐 바라봐 봐","kind":"lyric"},{"id":"29","start":189.198697,"end":195.69581,"text":"貴方の影だけ伸びてゆく","translation":"그대 그림자만 길어져 가","kind":"lyric"},{"id":"30","start":195.69581,"end":199.754,"text":"消えてしまわないで","translation":"제발 사라지지 마","kind":"lyric"},{"id":"31","start":199.754,"end":206.051,"text":"ずっと この思いは変わらない","translation":"줄곧 이 마음은 변하지 않아","kind":"lyric"},{"id":"32","start":206.051,"end":208.68,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"33","start":208.68,"end":211.38684,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"34","start":211.38684,"end":217.924,"text":"続いて欲しいと願っている","translation":"이어지기를 바라고 있어","kind":"lyric"},{"id":"35","start":218.105855,"end":224.223,"text":"手を取ることは出来ずとも","translation":"손을 잡지는 못하더라도","kind":"lyric"},{"id":"36","start":224.223,"end":231.1,"text":"過ぎていく現在に抱きしめられている","translation":"흘러가는 지금에 품 안겨 있어","kind":"lyric"},{"id":"37","start":231.499905,"end":237.397,"text":"私の (僕の)","translation":"우리 둘의","kind":"lyric"},{"id":"38","start":237.517,"end":243.414,"text":"時間が止まればいいのに","translation":"시간이 멈추면 좋을 텐데","kind":"lyric"},{"id":"39","start":243.414612,"end":250.092,"text":"今日を噛み締めていよう","translation":"오늘을 마음 깊이 새기자","kind":"lyric"},{"id":"40","start":250.311548,"end":253.09,"text":"終わるな","translation":"끝나지 마","kind":"lyric"},{"id":"41","start":253.09,"end":256.429,"text":"夏よ、終わるな","translation":"여름아 끝나지 마","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}