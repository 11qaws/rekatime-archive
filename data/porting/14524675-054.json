{"originalLanguage":"ja","title":"연애 서큘레이션","artist":"花澤香菜","date":"2026-08-04","sourceId":"14524675:054","sourceHash":"b114e5c9a2a121f74d841f0ba68b507ba95a478f86d904a53534e66d41b5acfb","duration":265.66,"cues":[{"id":"1","start":12.682,"end":14.241,"text":"でも そんなんじゃ だめ","translation":"하지만 그런 걸론 안 돼","kind":"lyric"},{"id":"2","start":14.91,"end":16.320689337959998,"text":"もう そんなんじゃ ほら","translation":"이제 그런 걸론 봐","kind":"lyric"},{"id":"3","start":16.320689337959998,"end":18.44,"text":"心は進化するよ","translation":"마음은 진화해","kind":"lyric"},{"id":"4","start":18.77,"end":20.549,"text":"もっと もっと","translation":"좀 더 좀 더","kind":"lyric"},{"id":"5","start":36.151,"end":38.74983890232,"text":"言葉にすれば消えちゃう関係なら","translation":"말로 하면 사라질 관계라면","kind":"lyric"},{"id":"6","start":38.74983890232,"end":40.52897821714001,"text":"言葉を消せばいいやって","translation":"말을 없애면 된다고","kind":"lyric"},{"id":"7","start":40.52897821714001,"end":42.348,"text":"思ってた 恐れてた","translation":"생각했어 두려웠어","kind":"lyric"},{"id":"8","start":42.348,"end":44.327,"text":"だけど あれ? なんかちがうかも.","translation":"하지만 어라 뭔가 다를지도","kind":"lyric"},{"id":"9","start":44.327,"end":46.186,"text":"せんりのみちもいっぽから!","translation":"천 리 길도 한 걸음부터","kind":"lyric"},{"id":"10","start":46.186,"end":48.485,"text":"石のようにかたい そんな意志で","translation":"돌처럼 단단한 그런 의지로","kind":"lyric"},{"id":"11","start":48.485,"end":50.864,"text":"ちりもつもればやまとなでしこ?","translation":"티끌 모아 야마토 나데시코","kind":"lyric"},{"id":"12","start":51.323756082340005,"end":52.343,"text":"「し」抜きで いや 死ぬ気で!","translation":"시는 빼고 아니 죽을 각오로","kind":"lyric"},{"id":"13","start":52.343,"end":55.421773605240006,"text":"ふわふわり ふわふわる","translation":"사뿐사뿐 사뿐 떠올라","kind":"lyric"},{"id":"14","start":55.421773605240006,"end":57.74065181332001,"text":"あなたが 名前を呼ぶ","translation":"네가 이름을 불러","kind":"lyric"},{"id":"15","start":57.74065181332001,"end":58.74,"text":"それだけで","translation":"그것만으로","kind":"lyric"},{"id":"16","start":58.74,"end":60.259,"text":"宙へ浮かぶ","translation":"허공에 떠올라","kind":"lyric"},{"id":"17","start":61.6587563718,"end":63.5578376629,"text":"ふわふわる ふわふわり","translation":"사뿐 떠올라 사뿐사뿐","kind":"lyric"},{"id":"18","start":63.5578376629,"end":65.65682224780001,"text":"あなたが笑ってる","translation":"네가 웃고 있어","kind":"lyric"},{"id":"19","start":65.65682224780001,"end":66.736,"text":"それだけで","translation":"그것만으로","kind":"lyric"},{"id":"20","start":66.736,"end":68.395,"text":"笑顔になる","translation":"미소가 번져","kind":"lyric"},{"id":"21","start":68.675,"end":71.174,"text":"神様ありがとう","translation":"신이시여 고마워요","kind":"lyric"},{"id":"22","start":71.174,"end":76.052,"text":"運命のいたずらでも","translation":"운명의 장난이라 해도","kind":"lyric"},{"id":"23","start":76.47159044238,"end":80.07,"text":"めぐり逢えたことが","translation":"서로 만난 것이","kind":"lyric"},{"id":"24","start":80.66955961218001,"end":83.428,"text":"しあわせなの","translation":"행복인 걸","kind":"lyric"},{"id":"25","start":84.38776087686,"end":86.22687117982001,"text":"でも そんなんじゃ だめ","translation":"하지만 그런 걸론 안 돼","kind":"lyric"},{"id":"26","start":86.22687117982001,"end":88.26588477658,"text":"もう そんなんじゃ ほら","translation":"이제 그런 걸론 봐","kind":"lyric"},{"id":"27","start":88.26588477658,"end":90.365,"text":"心は進化するよ","translation":"마음은 진화해","kind":"lyric"},{"id":"28","start":90.82,"end":94.183,"text":"もっと もっと そう そんなんじゃ やだ","translation":"좀 더 좀 더 그래 그런 건 싫어","kind":"lyric"},{"id":"29","start":94.183,"end":96.082,"text":"ねぇ そんなんじゃ まだ","translation":"있지 그런 걸론 아직","kind":"lyric"},{"id":"30","start":96.082,"end":98.60088506604001,"text":"私のこと 見ててね","translation":"나를 바라봐 줘","kind":"lyric"},{"id":"31","start":98.60088506604001,"end":100.28,"text":"ずっと ずっと","translation":"계속 계속","kind":"lyric"},{"id":"32","start":115.85253932098,"end":118.171,"text":"私の中のあなたほど","translation":"내 안의 너만큼","kind":"lyric"},{"id":"33","start":118.171,"end":120.43,"text":"あなたの中の私の存在は","translation":"네 안에 있는 나라는 존재는","kind":"lyric"},{"id":"34","start":120.43,"end":122.789,"text":"まだまだ 大きくないことも","translation":"아직 그리 크지 않다는 것도","kind":"lyric"},{"id":"35","start":122.789,"end":124.208,"text":"わかってるけれど","translation":"알고 있지만","kind":"lyric"},{"id":"36","start":124.408,"end":126.307,"text":"今この同じ 瞬間","translation":"지금 이 같은 순간","kind":"lyric"},{"id":"37","start":126.307,"end":128.126,"text":"共有してる 時間","translation":"함께 나누는 시간","kind":"lyric"},{"id":"38","start":128.1266015603,"end":130.38550878024,"text":"ちりもつもればやまとなでしこ!","translation":"티끌 모아 야마토 나데시코","kind":"lyric"},{"id":"39","start":130.38550878024,"end":132.32457073010002,"text":"略して? ちりつもやまとなでこ!","translation":"줄이면 티끌 모아 야마토 나데코","kind":"lyric"},{"id":"40","start":132.32457073010002,"end":135.483,"text":"くらくらり くらくらる","translation":"아찔아찔 아찔해","kind":"lyric"},{"id":"41","start":135.483,"end":137.64199834518,"text":"あなたを見上げたら","translation":"너를 올려다보면","kind":"lyric"},{"id":"42","start":137.64199834518,"end":139.001,"text":"それだけで","translation":"그것만으로","kind":"lyric"},{"id":"43","start":139.001,"end":139.94088622388003,"text":"まぶしすぎて","translation":"너무 눈부셔서","kind":"lyric"},{"id":"44","start":139.94088622388003,"end":143.479,"text":"くらくらる くらくらり","translation":"아찔해 아찔아찔","kind":"lyric"},{"id":"45","start":143.479,"end":145.598,"text":"あなたを想っている","translation":"너를 생각하고 있어","kind":"lyric"},{"id":"46","start":145.598,"end":146.917,"text":"それだけで","translation":"그것만으로","kind":"lyric"},{"id":"47","start":146.91751117750002,"end":148.397,"text":"とけてしまう","translation":"녹아 버려","kind":"lyric"},{"id":"48","start":148.93653444488,"end":150.636,"text":"神様ありがとう","translation":"신이시여 고마워요","kind":"lyric"},{"id":"49","start":151.635,"end":156.033,"text":"運命のいたずらでも","translation":"운명의 장난이라 해도","kind":"lyric"},{"id":"50","start":157.13256949068,"end":160.031,"text":"めぐり逢えたことが","translation":"서로 만난 것이","kind":"lyric"},{"id":"51","start":160.6108868028,"end":163.27,"text":"しあわせなの","translation":"행복인 걸","kind":"lyric"},{"id":"52","start":164.009,"end":172.545,"text":"コイスル キセツハ ヨクバリ circulation","translation":"사랑하는 계절은 욕심쟁이 circulation","kind":"lyric"},{"id":"53","start":172.545,"end":180.561,"text":"コイスル キモチハ ヨクバリ circulation","translat