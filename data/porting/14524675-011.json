{"originalLanguage":"ja","title":"괴수의 꽃노래","artist":"Vaundy","date":"2026-08-04","sourceId":"14524675:011","sourceHash":"af3b6b1a5ff49db93568031f46ceb4549183d1f3b8a2e29550f8ccb8e61e17e9","duration":226.24,"cues":[{"id":"1","start":3.92,"end":7.58,"text":"思い出すのは君の歌","translation":"떠오르는 건 너의 노래","kind":"lyric"},{"id":"2","start":7.58,"end":10.54,"text":"会話よりも鮮明だ","translation":"대화보다도 선명해","kind":"lyric"},{"id":"3","start":10.54,"end":12.78,"text":"どこに行ってしまったの","translation":"어디로 가 버린 거야","kind":"lyric"},{"id":"4","start":12.78,"end":16.36,"text":"いつも探すんだよ","translation":"언제나 찾고 있어","kind":"lyric"},{"id":"5","start":16.36,"end":18.8,"text":"思い出すのは","translation":"떠오르는 건","kind":"lyric"},{"id":"6","start":18.8,"end":20.36,"text":"君の歌","translation":"너의 노래","kind":"lyric"},{"id":"7","start":20.36,"end":23.32,"text":"歌い笑う顔が鮮明だ","translation":"노래하며 웃는 얼굴이 선명해","kind":"lyric"},{"id":"8","start":23.32,"end":25.84,"text":"君に似合うんだよ","translation":"너에게 잘 어울려","kind":"lyric"},{"id":"9","start":25.84,"end":29.47,"text":"ずっと見ていたいよ","translation":"계속 보고 싶어","kind":"lyric"},{"id":"10","start":29.76,"end":32.88,"text":"でも最後に見たいのは","translation":"하지만 마지막으로 보고 싶은 건","kind":"lyric"},{"id":"11","start":32.88,"end":36.08,"text":"きっともう君の夢の中","translation":"분명 이제 네 꿈속에서","kind":"lyric"},{"id":"12","start":36.08,"end":37.18,"text":"もう一度","translation":"한 번 더","kind":"lyric"},{"id":"13","start":37.18,"end":40.44,"text":"また聞かせてくれよ","translation":"다시 들려줘","kind":"lyric"},{"id":"14","start":40.44,"end":41.82,"text":"聞きたいんだ","translation":"듣고 싶어","kind":"lyric"},{"id":"15","start":41.82,"end":43.14,"text":"もっと","translation":"더","kind":"lyric"},{"id":"16","start":43.14,"end":45.99,"text":"騒げ怪獣の歌","translation":"울려 퍼져라 괴수의 노래","kind":"lyric"},{"id":"17","start":46.88,"end":49.62,"text":"まだ消えない","translation":"아직 사라지지 않아","kind":"lyric"},{"id":"18","start":49.62,"end":52.83,"text":"夢の歌唱えて","translation":"꿈의 노래를 읊조리며","kind":"lyric"},{"id":"19","start":53.36,"end":55.96,"text":"君がいつも","translation":"네가 언제나","kind":"lyric"},{"id":"20","start":55.96,"end":59.28,"text":"歌う怪獣の歌","translation":"부르는 괴수의 노래","kind":"lyric"},{"id":"21","start":59.28,"end":62.36,"text":"まだ消えない","translation":"아직 사라지지 않아","kind":"lyric"},{"id":"22","start":62.36,"end":66.13,"text":"口ずさんでしまうよ","translation":"나도 모르게 흥얼거려","kind":"lyric"},{"id":"23","start":67.86,"end":69.96,"text":"思い出すのは","translation":"떠오르는 건","kind":"lyric"},{"id":"24","start":69.96,"end":71.52,"text":"君がいた","translation":"네가 있었어","kind":"lyric"},{"id":"25","start":71.52,"end":73.18,"text":"ギター持ってる","translation":"기타를 들고","kind":"lyric"},{"id":"26","start":73.18,"end":74.58,"text":"君がいた","translation":"네가 있었어","kind":"lyric"},{"id":"27","start":74.58,"end":76.92,"text":"忘れられないんだよ","translation":"잊을 수 없어","kind":"lyric"},{"id":"28","start":76.92,"end":80.5,"text":"だから僕が歌うよ","translation":"그러니 내가 노래할게","kind":"lyric"},{"id":"29","start":80.5,"end":84.14,"text":"でも最後に見たいのは","translation":"하지만 마지막으로 보고 싶은 건","kind":"lyric"},{"id":"30","start":84.14,"end":87.55,"text":"きっともう君の夢の中","translation":"분명 이제 네 꿈속에서","kind":"lyric"},{"id":"31","start":87.6,"end":88.46,"text":"もう一度","translation":"한 번 더","kind":"lyric"},{"id":"32","start":88.46,"end":91.62,"text":"また聞かせてくれよ","translation":"다시 들려줘","kind":"lyric"},{"id":"33","start":91.62,"end":93.0,"text":"聞きたいんだ","translation":"듣고 싶어","kind":"lyric"},{"id":"34","start":93.0,"end":94.4,"text":"もっと","translation":"더","kind":"lyric"},{"id":"35","start":94.4,"end":97.64,"text":"騒げ怪獣の歌","translation":"울려 퍼져라 괴수의 노래","kind":"lyric"},{"id":"36","start":97.64,"end":100.82,"text":"まだ消えない","translation":"아직 사라지지 않아","kind":"lyric"},{"id":"37","start":100.82,"end":104.01,"text":"夢の歌唱えて","translation":"꿈의 노래를 읊조리며","kind":"lyric"},{"id":"38","start":105.2,"end":107.18,"text":"君がいつも","translation":"네가 언제나","kind":"lyric"},{"id":"39","start":107.18,"end":110.34,"text":"歌う怪獣の歌","translation":"부르는 괴수의 노래","kind":"lyric"},{"id":"40","start":110.34,"end":113.99,"text":"まだ消えない","translation":"아직 사라지지