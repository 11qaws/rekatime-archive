{"title":"Choose me","artist":"햐다인","sourceId":"reference:k4tzqMvhypSvrEMeZAEd","sourceHash":"16016ff781192bea1d6b83781b8574b57f2dd85c1723744c348ad781b5a709f2","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":21436635,"cues":[{"id":"1","start":15.51,"end":19.66,"text":"恋をしちゃいけないってことは","translation":"","kind":"lyric"},{"id":"2","start":19.66,"end":22.95,"text":"初めから わかってたのに","translation":"","kind":"lyric"},{"id":"3","start":22.95,"end":27.36,"text":"逢えば逢うほどに 心 惹かれてゆく","translation":"","kind":"lyric"},{"id":"4","start":27.36,"end":30.92,"text":"自制心が 崩れ去ってゆく","translation":"","kind":"lyric"},{"id":"5","start":30.92,"end":35.05,"text":"友達の恋人ってことは","translation":"","kind":"lyric"},{"id":"6","start":35.05,"end":38.44,"text":"わかってるはず だったのに","translation":"","kind":"lyric"},{"id":"7","start":38.44,"end":42.72,"text":"世界の全てが あなたで埋もれてく","translation":"","kind":"lyric"},{"id":"8","start":42.72,"end":46.64,"text":"私は どうすればいいのだろう","translation":"","kind":"lyric"},{"id":"9","start":46.64,"end":48.9,"text":"私の奥に 誰を見てるの?","translation":"","kind":"lyric"},{"id":"10","start":48.9,"end":50.9,"text":"なんで 作り笑いを するの?","translation":"","kind":"lyric"},{"id":"11","start":50.9,"end":53.71,"text":"あなたの中から 私が 消えてゆく","translation":"","kind":"lyric"},{"id":"12","start":53.71,"end":57.62,"text":"全て失えば ラクになるのかな","translation":"","kind":"lyric"},{"id":"13","start":57.62,"end":61.43,"text":"罪も 傷も 汚れた感情も","translation":"","kind":"lyric"},{"id":"14","start":61.43,"end":63.29,"text":"ずっと そばにいたい","translation":"","kind":"lyric"},{"id":"15","start":63.29,"end":65.88,"text":"そばにいちゃいけないの?","translation":"","kind":"lyric"},{"id":"16","start":65.88,"end":69.17,"text":"どうして私じゃ ダメなんだろう","translation":"","kind":"lyric"},{"id":"17","start":69.17,"end":72.95,"text":"「あの日 出会わなきゃ よかった」だなんて","translation":"","kind":"lyric"},{"id":"18","start":72.95,"end":76.8,"text":"古臭い フレーズを 口にするけれど","translation":"","kind":"lyric"},{"id":"19","start":76.8,"end":78.63,"text":"誰のものでもいい","translation":"","kind":"lyric"},{"id":"20","start":78.63,"end":81.14,"text":"あなたを愛してる","translation":"","kind":"lyric"},{"id":"21","start":81.14,"end":83.26,"text":"誰にも渡さない","translation":"","kind":"lyric"},{"id":"22","start":83.26,"end":84.28999999999999,"text":"Choose me Choose me","translation":"","kind":"lyric"},{"id":"23","start":84.28999999999999,"end":85.28,"text":"Choose me Choose me","translation":"","kind":"lyric"},{"id":"24","start":85.28,"end":90.6,"text":"No,No...","translation":"","kind":"lyric"},{"id":"25","start":90.6,"end":92.49000000000001,"text":"こんなことになるはずじゃなかった","translation":"","kind":"lyric"},{"id":"26","start":92.49000000000001,"end":94.56,"text":"彼女に会わせるんじゃなかった","translation":"","kind":"lyric"},{"id":"27","start":94.56,"end":96.84,"text":"「もう逢うのはよそう」言い出したくても","translation":"","kind":"lyric"},{"id":"28","start":96.84,"end":98.39,"text":"I can't stop my love.","translation":"","kind":"lyric"},{"id":"29","start":98.39,"end":102.19,"text":"眠れないままに 夜がまた明けていく","translation":"","kind":"lyric"},{"id":"30","start":102.19,"end":103.22999999999999,"text":"Hey,choose me","translation":"","kind":"lyric"},{"id":"31","start":103.22999999999999,"end":104.2,"text":"Hey,choose me","translation":"","kind":"lyric"},{"id":"32","start":104.2,"end":105.75999999999999,"text":"No, I cannot choose one.","translation":"","kind":"lyric"},{"id":"33","start":105.75999999999999,"end":109.89,"text":"いつもどおり 二人でいたって","translation":"","kind":"lyric"},{"id":"34","start":109.89,"end":113.17,"text":"携帯ばかり 気にしてる","translation":"","kind":"lyric"},{"id":"35","start":113.17,"end":117.59,"text":"気づかないふりして 私は笑うけど","translation":"","kind":"lyric"},{"id":"36","start":117.59,"end":121.64,"text":"時限爆弾は 止まらないの","translation":"","kind":"lyric"},{"id":"37","start":121.64,"end":123.9,"text":"あなたの胸に 飛び込みたいよ","translation":"","kind":"lyric"},{"id":"38","start":123.9,"end":125.71,"text":"彼女を傷つけたくないよ","translation":"","kind":"lyric"},{"id":"39","start":125.71,"end":128.89,"text":"二つの感情が 私を壊してく","translation":"","kind":"lyric"},{"id":"40","start":128.89,"end":132.61,"text":"何をどうすれば 救われるのだろう","translation":"","kind":"lyric"},{"id":"41","start":132.61,"end":136.42000000000002,"text":"どこにいても 傷は癒せない","translation":"","kind":"lyric"},{"id":"42","start":136.42000000000002,"end":140.5,"text":"私の存在が あなたを苦しめる","translation":"","kind":"lyric"},{"id":"43","start":140.5,"end":143.93,"text":"憎しみが 心 染めてゆく","translation":"","kind":"lyric"},{"id":"44","start":143.93,"end":144.05,"text":"答えを出せずに さまよい続けてる","translation":"","kind":"lyric"},{"id":"45","start":144.05,"end":151.7,"text":"時のナイフが 傷を増やしてく","translation":"","kind":"lyric"},{"id":"46","start":151.7,"end":155.82,"text":"全てを奪いたい あやまちだとしても","translation":"","kind":"lyric"},{"id":"47","start":155.82,"end":158.12,"text":"あなたしかいらない","translation":"","kind":"lyric"},{"id":"48","start":158.12,"end":159.15,"text":"Choose me Choose me","translation":"","kind":"lyric"},{"id":"49","start":159.15,"end":159.92000000000002,"text":"Choose me Choose me","translation":"","kind":"lyric"},{"id":"50","start":159.92000000000002,"end":177.16,"text":"No,No...","translation":"","kind":"lyric"},{"id":"51","start":177.16,"end":179.2,"text":"I can't go back","translation":"","kind":"lyric"},{"id":"52","start":179.2,"end":181.29,"text":"I know love is passin' away.","translation":"","kind":"lyric"},{"id":"53","start":181.29,"end":183.05,"text":"Where should I go?","translation":"","kind":"lyric"},{"id":"54","start":183.05,"end":184.38,"text":"Ah...","translation":"","kind":"lyric"},{"id":"55","start":184.38,"end":188.09,"text":"全て失えば ラクになるのかな","translation":"","kind":"lyric"},{"id":"56","start":188.09,"end":191.95,"text":"罪も 傷も 汚れた感情も","translation":"","kind":"lyric"},{"id":"57","start":191.95,"end":193.74,"text":"ずっと そばにいたい","translation":"","kind":"lyric"},{"id":"58","start":193.74,"end":196.34,"text":"そばにいちゃいけないの?","translation":"","kind":"lyric"},{"id":"59","start":196.34,"end":200.64,"text":"どうして私じゃ ダメなんだろう","translation":"","kind":"lyric"},{"id":"60","start":200.64,"end":201.64,"text":"Choose me, please","translation":"","kind":"lyric"},{"id":"61","start":201.64,"end":205.57999999999998,"text":"「あの日 出会わなきゃ よかった」だなんて","translation":"","kind":"lyric"},{"id":"62","start":205.57999999999998,"end":209.14,"text":"古臭い フレーズを 口にするけれど","translation":"","kind":"lyric"},{"id":"63","start":209.14,"end":211.11,"text":"誰のものでもいい","translation":"","kind":"lyric"},{"id":"64","start":211.11,"end":213.57,"text":"あなたを愛してる","translation":"","kind":"lyric"},{"id":"65","start":213.57,"end":215.72,"text":"誰にも渡さない","translation":"","kind":"lyric"},{"id":"66","start":215.72,"end":216.52,"text":"Choose me Choose me","translation":"","kind":"lyric"},{"id":"67","start":216.52,"end":217.64,"text":"Choose me Choose me","translation":"","kind":"lyric"},{"id":"68","start":217.64,"end":233.06,"text":"No,No...","translation":"","kind":"lyric"},{"id":"69","start":233.06,"end":235.07,"text":"Cannot choose one...","translation":"","kind":"lyric"}],"candidates":[]}