{"title":"새벽과 반딧불이","artist":"n-buna","sourceId":"reference:yns1rwZPYRmnCpl1GxXh","sourceHash":"38db27355a7d257bd7bf25626a164a9d014521515fd9d6316458ba68c8fee080","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":9565740,"cues":[{"id":"1","start":36.79,"end":42.76,"text":"淡い月に見とれてしまうから","translation":"","kind":"lyric"},{"id":"2","start":42.76,"end":48.72,"text":"暗い足元も見えずに","translation":"","kind":"lyric"},{"id":"3","start":48.72,"end":54.83,"text":"転んだことに気がつけないまま","translation":"","kind":"lyric"},{"id":"4","start":54.83,"end":60.41,"text":"遠い夜の星が滲む","translation":"","kind":"lyric"},{"id":"5","start":72.56,"end":78.7,"text":"したいことが見つけられないから","translation":"","kind":"lyric"},{"id":"6","start":78.7,"end":84.81,"text":"急いだ振り 俯くまま","translation":"","kind":"lyric"},{"id":"7","start":84.81,"end":90.84,"text":"転んだ後に笑われてるのも","translation":"","kind":"lyric"},{"id":"8","start":90.84,"end":96.2,"text":"気づかない振りをするのだ","translation":"","kind":"lyric"},{"id":"9","start":96.2,"end":102.74000000000001,"text":"形のない歌で朝を描いたまま","translation":"","kind":"lyric"},{"id":"10","start":102.74000000000001,"end":107.92,"text":"浅い浅い夏の向こうに","translation":"","kind":"lyric"},{"id":"11","start":107.92,"end":114.97,"text":"冷たくない君の手のひらが見えた","translation":"","kind":"lyric"},{"id":"12","start":114.97,"end":120.63,"text":"淡い空 明けの蛍","translation":"","kind":"lyric"},{"id":"13","start":132.71,"end":138.63,"text":"自分がただの染みに見えるほど","translation":"","kind":"lyric"},{"id":"14","start":138.63,"end":144.72,"text":"嫌いなものが増えたので","translation":"","kind":"lyric"},{"id":"15","start":144.72,"end":150.73,"text":"地球の裏側へ飛びたいのだ","translation":"","kind":"lyric"},{"id":"16","start":150.73,"end":156.81,"text":"無人の駅に届くまで","translation":"","kind":"lyric"},{"id":"17","start":156.81,"end":162.04,"text":"昨日の僕に出会うまで","translation":"","kind":"lyric"},{"id":"18","start":162.04,"end":168.68,"text":"胸が痛いから下を向くたびに","translation":"","kind":"lyric"},{"id":"19","start":168.68,"end":174.0,"text":"君がまた遠くを征くんだ","translation":"","kind":"lyric"},{"id":"20","start":174.0,"end":179.18,"text":"夢を見たい僕らを汚せ","translation":"","kind":"lyric"},{"id":"21","start":179.18,"end":186.5,"text":"さらば 昨日夜に咲く火の花","translation":"","kind":"lyric"},{"id":"22","start":210.18,"end":218.09,"text":"水に映る花を 花を見ていた","translation":"","kind":"lyric"},{"id":"23","start":222.35,"end":237.14,"text":"水に霞む月を 月を見ていたから","translation":"","kind":"lyric"},{"id":"24","start":237.14,"end":243.79,"text":"夏が来ないままの空を描いたなら","translation":"","kind":"lyric"},{"id":"25","start":243.79,"end":249.24,"text":"君は僕を笑うだろうか","translation":"","kind":"lyric"},{"id":"26","start":249.24,"end":258.11,"text":"明け方の夢 浮かぶ月が見えた空","translation":"","kind":"lyric"},{"id":"27","start":258.11,"end":264.79,"text":"朝が来ないままで息が出来たなら","translation":"","kind":"lyric"},{"id":"28","start":264.79,"end":270.25,"text":"遠い遠い夏の向こうへ","translation":"","kind":"lyric"},{"id":"29","start":270.25,"end":276.82,"text":"冷たくない君の手のひらが見えた","translation":"","kind":"lyric"},{"id":"30","start":276.82,"end":282.95,"text":"淡い朝焼けの夜空","translation":"","kind":"lyric"},{"id":"31","start":294.12,"end":300.04,"text":"夏がこないままの街を今","translation":"","kind":"lyric"},{"id":"32","start":300.04,"end":304.44,"text":"あぁ 藍の色 夜明けと蛍","translation":"","kind":"lyric"}],"candidates":[]}