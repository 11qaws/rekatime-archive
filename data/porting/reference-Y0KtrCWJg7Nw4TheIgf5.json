{"title":"그저 네게 맑아라","artist":"요루시카","sourceId":"reference:Y0KtrCWJg7Nw4TheIgf5","sourceHash":"222f53c4d099d1cfae61ec7a30818c46b2f8dc8d1b8e41572f97eccedb1fb63b","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":34076437,"cues":[{"id":"1","start":0.03,"end":3.56,"text":"夜に浮かんでいた","translation":"","kind":"lyric"},{"id":"2","start":3.56,"end":7.35,"text":"海月のような月が爆ぜた","translation":"","kind":"lyric"},{"id":"3","start":7.35,"end":10.85,"text":"バス停の背を覗けば","translation":"","kind":"lyric"},{"id":"4","start":10.85,"end":16.52,"text":"あの夏の君が頭にいる","translation":"","kind":"lyric"},{"id":"5","start":20.5,"end":22.95,"text":"だけ","translation":"","kind":"lyric"},{"id":"6","start":27.56,"end":34.7,"text":"鳥居 乾いた雲 夏の匂いが頬を撫でる","translation":"","kind":"lyric"},{"id":"7","start":34.7,"end":41.59,"text":"大人になるまでほら、背伸びしたままで","translation":"","kind":"lyric"},{"id":"8","start":41.59,"end":48.06,"text":"遊び疲れたらバス停裏で空でも見よう","translation":"","kind":"lyric"},{"id":"9","start":48.06,"end":51.58,"text":"じきに夏が暮れても","translation":"","kind":"lyric"},{"id":"10","start":51.58,"end":55.77,"text":"きっときっと覚えてるから","translation":"","kind":"lyric"},{"id":"11","start":55.77,"end":59.02,"text":"追いつけないまま大人になって","translation":"","kind":"lyric"},{"id":"12","start":59.02,"end":62.32,"text":"君のポケットに夜が咲く","translation":"","kind":"lyric"},{"id":"13","start":62.32,"end":65.87,"text":"口に出せないなら僕は1人だ","translation":"","kind":"lyric"},{"id":"14","start":65.87,"end":72.56,"text":"それでいいからもう諦めてる","translation":"","kind":"lyric"},{"id":"15","start":72.56,"end":75.33,"text":"だけ","translation":"","kind":"lyric"},{"id":"16","start":86.03999999999999,"end":93.06,"text":"夏日 乾いた雲 山桜桃海 錆びた標識","translation":"","kind":"lyric"},{"id":"17","start":93.06,"end":99.81,"text":"記憶の中はいつも夏の匂いがする","translation":"","kind":"lyric"},{"id":"18","start":99.81,"end":103.25999999999999,"text":"写真なんて紙切れだ","translation":"","kind":"lyric"},{"id":"19","start":103.25999999999999,"end":106.58,"text":"思い出なんてただの塵だ","translation":"","kind":"lyric"},{"id":"20","start":106.58,"end":113.56,"text":"それがわからないから、口を噤んだまま","translation":"","kind":"lyric"},{"id":"21","start":113.56,"end":120.85,"text":"絶えず君のいこふ 記憶に夏野の石一つ","translation":"","kind":"lyric"},{"id":"22","start":120.85,"end":124.33,"text":"俯いたまま大人になって","translation":"","kind":"lyric"},{"id":"23","start":124.33,"end":127.24,"text":"追いつけない ただ君に晴れ","translation":"","kind":"lyric"},{"id":"24","start":127.24,"end":131.0,"text":"口に出せないまま坂を上った","translation":"","kind":"lyric"},{"id":"25","start":131.0,"end":137.36,"text":"僕らの影に夜が咲いていく","translation":"","kind":"lyric"},{"id":"26","start":151.78,"end":154.74,"text":"俯いたまま大人になった","translation":"","kind":"lyric"},{"id":"27","start":154.74,"end":158.09,"text":"君が思うまま手を叩け","translation":"","kind":"lyric"},{"id":"28","start":158.09,"end":161.73,"text":"陽の落ちる坂道を上って","translation":"","kind":"lyric"},{"id":"29","start":161.73,"end":165.07999999999998,"text":"僕らの影は","translation":"","kind":"lyric"},{"id":"30","start":165.07999999999998,"end":168.71,"text":"追いつけないまま大人になって","translation":"","kind":"lyric"},{"id":"31","start":168.71,"end":172.06,"text":"君のポケットに夜が咲く","translation":"","kind":"lyric"},{"id":"32","start":172.06,"end":175.75,"text":"口に出せなくても僕ら一つだ","translation":"","kind":"lyric"},{"id":"33","start":175.75,"end":179.06,"text":"それでいいだろう、もう","translation":"","kind":"lyric"},{"id":"34","start":179.06,"end":184.59,"text":"君の思い出を噛み締めてる","translation":"","kind":"lyric"},{"id":"35","start":188.72,"end":189.01,"text":"だけ","translation":"","kind":"lyric"}],"candidates":[]}