{"title":"Henceforth","artist":"Orangestar","sourceId":"reference:yGG5GSWcAqNfIfBwMH7l","sourceHash":"9925649352a91ea6b9ba9c8e1b8641f1344d3648962fa68cd700940972b85efa","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":20129637,"cues":[{"id":"1","start":0.29,"end":13.01,"text":"♪","translation":"","kind":"lyric"},{"id":"2","start":13.01,"end":15.78,"text":"あぁ 君はもういないから","translation":"","kind":"lyric"},{"id":"3","start":15.78,"end":19.05,"text":"私は一人歩いている","translation":"","kind":"lyric"},{"id":"4","start":19.05,"end":21.93,"text":"あぁ 腐るよりいいから","translation":"","kind":"lyric"},{"id":"5","start":21.93,"end":25.14,"text":"行くあてもなく歩いている","translation":"","kind":"lyric"},{"id":"6","start":25.14,"end":37.33,"text":"♪","translation":"","kind":"lyric"},{"id":"7","start":37.33,"end":40.1,"text":"あぁ これからはそうだな","translation":"","kind":"lyric"},{"id":"8","start":40.1,"end":43.33,"text":"何も求めずに生きていく","translation":"","kind":"lyric"},{"id":"9","start":43.33,"end":46.21,"text":"あぁ お金よりいいでしょ","translation":"","kind":"lyric"},{"id":"10","start":46.21,"end":49.41,"text":"これで何も失わないね","translation":"","kind":"lyric"},{"id":"11","start":49.41,"end":52.21,"text":"あぁ！ 泣くな空、心配ない！","translation":"","kind":"lyric"},{"id":"12","start":52.21,"end":55.53,"text":"終わりのない夜はないね","translation":"","kind":"lyric"},{"id":"13","start":55.53,"end":58.32,"text":"あぁ 闇はただ純粋で","translation":"","kind":"lyric"},{"id":"14","start":58.32,"end":61.64,"text":"恐れてしまう私が弱いだけ","translation":"","kind":"lyric"},{"id":"15","start":61.64,"end":64.45,"text":"あぁ! 夏を今もう一回","translation":"","kind":"lyric"},{"id":"16","start":64.45,"end":68.25,"text":"君がいなくても笑って迎えるから","translation":"","kind":"lyric"},{"id":"17","start":68.25,"end":73.81,"text":"だから今絶対に君も歩みを止めないで","translation":"","kind":"lyric"},{"id":"18","start":73.81,"end":76.57,"text":"あぁ! それだけの心臓が","transla