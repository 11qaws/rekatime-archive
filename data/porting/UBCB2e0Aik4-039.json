{"title":"Pretender","artist":"Official髭男dism","date":"2026-07-20","sourceId":"UBCB2e0Aik4:039","sourceHash":"fb961db495fc498fe06eb6c2d6728dd69671c5b1865476b2db6029b79f6f5dae","duration":320.06,"cues":[{"id":"1","start":35.82,"end":39.34,"text":"君とのラブストーリー","translation":"너와 나의 러브 스토리","kind":"lyric"},{"id":"2","start":39.34,"end":41.94,"text":"それは予想通り","translation":"그건 예상한 그대로","kind":"lyric"},{"id":"3","start":41.94,"end":45.82,"text":"いざ始まればひとり芝居だ","translation":"막상 시작하니 일인극이야","kind":"lyric"},{"id":"4","start":45.82,"end":48.62,"text":"ずっとそばにいたって","translation":"줄곧 곁에 있어도","kind":"lyric"},{"id":"5","start":48.62,"end":51.74,"text":"結局ただの観客だ","translation":"결국 그저 관객일 뿐","kind":"lyric"},{"id":"6","start":51.74,"end":55.0,"text":"感情のないアイムソーリー","translation":"감정 없는 아임 소리","kind":"lyric"},{"id":"7","start":55.0,"end":57.6,"text":"それはいつも通り","translation":"그건 언제나처럼","kind":"lyric"},{"id":"8","start":57.6,"end":61.38,"text":"慣れてしまえば悪くはないけど","translation":"익숙해지면 나쁘진 않지만","kind":"lyric"},{"id":"9","start":61.38,"end":65.1,"text":"君とのロマンスは人生柄","translation":"너와의 로맨스는 내 인생답게","kind":"lyric"},{"id":"10","start":65.46,"end":70.26,"text":"続きはしないことを知った","translation":"이어지지 않을 걸 알았어","kind":"lyric"},{"id":"11","start":72.04,"end":77.44,"text":"もっと違う設定で もっと違う関係で","translation":"좀 더 다른 설정으로 좀 더 다른 관계로","kind":"lyric"},{"id":"12","start":77.54,"end":82.32,"text":"出会える世界線 選べたらよかった","translation":"만날 세계선을 고를 수 있었다면 좋았을 텐데","kind":"lyric"},{"id":"13","start":82.32,"end":87.6,"text":"もっと違う性格で もっと違う価値観で","translation":"좀 더 다른 성격으로 좀 더 다른 가치관으로","kind":"lyric"},{"id":"14","start":87.6,"end":96.74,"text":"愛を伝えられたらいいな そう願っても無駄だから","translation":"사랑을 전할 수 있다면 좋겠어 그렇게 빌어도 소용없으니","kind":"lyric"},{"id":"15","start":97.67,"end":98.84,"text":"グッバイ","translation":"굿바이","kind":"lyric"},{"id":"16","start":98.84,"end":103.02,"text":"君の運命のヒトは僕じゃない","translation":"너의 운명의 사람은 내가 아니야","kind":"lyric"},{"id":"17","start":103.02,"end":109.26,"text":"辛いけど否めない でも離れ難いのさ","translation":"괴롭지만 부정할 수 없어 그래도 떠나긴 어려워","kind":"lyric"},{"id":"18","start":109.26,"end":115.38,"text":"その髪に触れただけで 痛いや","translation":"그 머리카락에 닿기만 해도 아파","kind":"lyric"},{"id":"19","start":115.38,"end":118.76,"text":"いやでも 甘いな いやいや","translation":"아니 하지만 달콤해 아니 아니야","kind":"lyric"},{"id":"20","start":118.76,"end":119.6,"text":"グッバイ","translation":"굿바이","kind":"lyric"},{"id":"21","start":119.6,"end":124.24,"text":"それじゃ僕にとって君は何？","translation":"그럼 내게 너는 무엇일까","kind":"lyric"},{"id":"22","start":124.44,"end":130.42,"text":"答えは分からない 分かりたくもないのさ","translation":"답은 몰라 알고 싶지도 않아","kind":"lyric"},{"id":"23","start":130.78,"end":138.2,"text":"たったひとつ確かなことがあるとするのならば","translation":"단 하나 확실한 게 있다면","kind":"lyric"},{"id":"24","start":138.7,"end":140.74,"text":"「君は綺麗だ」","translation":"너는 아름다워","kind":"lyric"},{"id":"25","start":145.6,"end":148.9,"text":"誰かが偉そうに","translation":"누군가 잘난 듯이","kind":"lyric"},{"id":"26","start":148.9,"end":151.18,"text":"語る恋愛の論理","translation":"말하는 연애의 논리","kind":"lyric"},{"id":"27","start":152.36,"end":155.26,"text":"何ひとつとしてピンとこなくて","translation":"어느 하나 와닿지 않아","kind":"lyric"},{"id":"28","start":155.26,"end":159.22,"text":"飛行機の窓から見下ろした","translation":"비행기 창문에서 내려다본","kind":"lyric"},{"id":"29","start":159.22,"end":164.2,"text":"知らない街の夜景みたいだ","translation":"모르는 도시의 야경 같아","kind":"lyric"},{"id":"30","start":166.0,"end":171.06,"text":"もっと違う設定で もっと違う関係で","translation":"좀 더 다른 설정으로 좀 더 다른 관계로","kind":"lyric"},{"id":"31","start":171.06,"end":176.34,"text":"出会える世界線 選べたらよかった","translation":"만날 세계선을 고를 수 있었다면 좋았을 텐데","kind":"lyric"},{"id":"32","start":176.34,"end":181.32,"text":"いたって純な心で 叶った恋を抱きしめて","translation":"더없이 순수한 마음으로 이루어진 사랑을 끌어안고","kind":"lyric"},{"id":"33","start":181.32,"end":185.86,"text":"「好きだ」とか無責任に言えたらいいな","translation":"좋아한다고 무책임하게 말할 수 있다면 좋겠어","kind":"lyric"},{"id":"34","start":186.26,"end":191.02,"text":"そう願っても虚しいのさ","translation":"그렇게 빌어도 허무할 뿐","kind":"lyric"},{"id":"35","start":191.54,"end":192.66,"text":"グッバイ","translation":"굿바이","kind":"lyric"},{"id":"36","start":192.66,"end":197.82,"text":"繋いだ手の向こうにエンドライン","translation":"맞잡은 손 너머에는 끝을 긋는 선","kind":"lyric"},{"id":"37","start":197.96,"end":203.04,"text":"引き伸ばすたびに 疼きだす未来には","translation":"미룰 때마다 욱신거리기 시작하는 미래에는","kind":"lyric"},{"id":"38","start":203.04,"end":208.24,"text":"君はいない その事実に Cry...","translation":"네가 없어 그 사실에 울어","kind":"lyric"},{"id":"39","start":209.64,"end":213.94,"text":"そりゃ苦しいよな","translation":"그야 괴롭겠지","kind":"lyric"},{"id":"40","start":230.82,"end":234.4,"text":"グッバイ","translation":"굿바이","kind":"lyric"},{"id":"41","start":234.4,"end":238.62,"text":"君の運命のヒトは僕じゃない","translation":"너의 운명의 사람은 내가 아니야","kind":"lyric"},{"id":"42","start":238.62,"end":244.92,"text":"辛いけど否めない でも離れ難いのさ","translation":"괴롭지만 부정할 수 없어 그래도 떠나긴 어려워","kind":"lyric"},{"id":"43","start":244.92,"end":250.82,"text":"その髪に触れただけで 痛いや","translation":"그 머리카락에 닿기만 해도 아파","kind":"lyric"},{"id":"44","start":250.82,"end":254.48,"text":"いやでも 甘いな いやいや","translation":"아니 하지만 달콤해 아니 아니야","kind":"lyric"},{"id":"45","start":254.48,"end":255.24,"text":"グッバイ","translation":"굿바이","kind":"lyric"},{"id":"46","start":255.24,"end":259.78,"text":"それじゃ僕にとって君は何？","translation":"그럼 내게 너는 무엇일까","kind":"lyric"},{"id":"47","start":260.06,"end":266.2,"text":"答えは分からない 分かりたくもないのさ","translation":"답은 몰라 알고 싶지도 않아","kind":"lyric"},{"id":"48","start":266.43,"end":273.82,"text":"たったひとつ確かなことがあるとするのならば","translation":"단 하나 확실한 게 있다면","kind":"lyric"},{"id":"49","start":273.88,"end":276.2,"text":"「君は綺麗だ」","translation":"너는 아름다워","kind":"lyric"},{"id":"50","start":276.2,"end":286.84,"text":"それもこれもロマンスの定めなら 悪くないよな","translation":"이것도 저것도 로맨스의 운명이라면 나쁘지 않지","kind":"lyric"},{"id":"51","start":287.28,"end":294.12,"text":"永遠も約束もないけれど","translation":"영원도 약속도 없지만","kind":"lyric"},{"id":"52","start":294.18,"end":297.36,"text":"「とても綺麗だ」","translation":"정말 아름다워","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}