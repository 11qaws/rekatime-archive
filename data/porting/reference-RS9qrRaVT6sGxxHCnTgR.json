{"title":"All Falls Down","artist":"Alan Walker","sourceId":"reference:RS9qrRaVT6sGxxHCnTgR","sourceHash":"4e794e7e82f7b0ae8ea55f5c9ffb4fdab6868c9e685a655fb6f255deb1f56427","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":37162337,"cues":[{"id":"1","start":0.13,"end":1.36,"text":"What's the trick?","translation":"","kind":"lyric"},{"id":"2","start":1.36,"end":2.96,"text":"I wish I knew","translation":"","kind":"lyric"},{"id":"3","start":2.96,"end":5.11,"text":"I'm so done with thinking through","translation":"","kind":"lyric"},{"id":"4","start":5.11,"end":7.79,"text":"All the things I could have been","translation":"","kind":"lyric"},{"id":"5","start":7.79,"end":9.93,"text":"And I know you want it too","translation":"","kind":"lyric"},{"id":"6","start":9.93,"end":12.82,"text":"All it takes is that one look at you","translation":"","kind":"lyric"},{"id":"7","start":12.82,"end":14.87,"text":"And I run right back to you","translation":"","kind":"lyric"},{"id":"8","start":14.87,"end":16.03,"text":"You cross the line","translation":"","kind":"lyric"},{"id":"9","start":16.03,"end":19.63,"text":"And it is time to say F Ü","translation":"","kind":"lyric"},{"id":"10","start":19.63,"end":22.44,"text":"What is the point in saying that","translation":"","kind":"lyric"},{"id":"11","start":22.44,"end":24.03,"text":"When you know how I will react?","translation":"","kind":"lyric"},{"id":"12","start":24.03,"end":26.79,"text":"You think you can just take it back","translation":"","kind":"lyric"},{"id":"13","start":26.79,"end":29.19,"text":"But shit just do not work like that","translation":"","kind":"lyric"},{"id":"14","start":29.19,"end":31.79,"text":"You're the drug that I'm addicted to","translation":"","kind":"lyric"},{"id":"15","start":31.79,"end":33.97,"text":"And I want you so bad","translation":"","kind":"lyric"},{"id":"16","start":33.97,"end":36.96,"text":"Guess I'm stuck with you","translation":"","kind":"lyric"},{"id":"17","start":36.96,"end":38.23,"text":"And that's that","translation":"","kind":"lyric"},{"id":"18","start":38.23,"end":42.04,"text":"'Cause when it all falls down","translation":"","kind":"lyric"},{"id":"19","start":42.04,"end":43.94,"text":"Then whatever","translation":"","kind":"lyric"},{"id":"20","start":43.94,"end":48.82,"text":"When it ዶ notwork out for the better","translation":"","kind":"lyric"},{"id":"21","start":48.82,"end":51.77,"text":"If it just ain't right","translation":"","kind":"lyric"},{"id":"22","start":51.77,"end":53.68,"text":"And it is time to say goodbye","translation":"","kind":"lyric"},{"id":"23","start":53.68,"end":56.2,"text":"When it all falls down","translation":"","kind":"lyric"},{"id":"24","start":56.2,"end":58.54,"text":"When it all falls down","translation":"","kind":"lyric"},{"id":"25","start":58.54,"end":63.2,"text":"I'll be fine","translation":"","kind":"lyric"},{"id":"26","start":63.2,"end":68.08,"text":"I will be fine","translation":"","kind":"lyric"},{"id":"27","start":68.08,"end":71.16,"text":"You're the drug that I'm addicted to","translation":"","kind":"lyric"},{"id":"28","start":71.16,"end":73.37,"text":"And I want you so bad","translation":"","kind":"lyric"},{"id":"29","start":73.37,"end":78.37,"text":"But I'll be fine","translation":"","kind":"lyric"},{"id":"30","start":78.37,"end":80.94,"text":"Why we fight? I don't know","translation":"","kind":"lyric"},{"id":"31","start":80.94,"end":83.2,"text":"We say what hurts the most","translation":"","kind":"lyric"},{"id":"32","start":83.2,"end":86.53,"text":"Oh, I tried staying cold","translation":"","kind":"lyric"},{"id":"33","start":86.53,"end":88.4,"text":"But you take it personal","translation":"","kind":"lyric"},{"id":"34","start":88.4,"end":91.52,"text":"All these firing shots and making ground","translation":"","kind":"lyric"},{"id":"35","start":91.52,"end":93.83,"text":"It's way too hard to cope","translation":"","kind":"lyric"},{"id":"36","start":93.83,"end":98.24000000000001,"text":"But I still can't let you go","translation":"","kind":"lyric"},{"id":"37","start":98.24000000000001,"end":101.14,"text":"'Cause when it all falls down","translation":"","kind":"lyric"},{"id":"38","start":101.14,"end":103.00999999999999,"text":"Then whatever","translation":"","kind":"lyric"},{"id":"39","start":103.00999999999999,"end":108.06,"text":"When it don't work out for the better","translation":"","kind":"lyric"},{"id":"40","start":108.06,"end":110.88,"text":"If it just ain't right","translation":"","kind":"lyric"},{"id":"41","start":110.88,"end":112.86,"text":"And it's time to say goodbye","translation":"","kind":"lyric"},{"id":"42","start":112.86,"end":115.69,"text":"When it all falls down","translation":"","kind":"lyric"},{"id":"43","start":115.69,"end":118.37,"text":"When it all falls down","translation":"","kind":"lyric"},{"id":"44","start":118.37,"end":122.75,"text":"I'll be fine","translation":"","kind":"lyric"},{"id":"45","start":122.75,"end":127.58,"text":"I'll be fine","translation":"","kind":"lyric"},{"id":"46","start":127.58,"end":131.04,"text":"You're the drug that I'm addicted to","translation":"","kind":"lyric"},{"id":"47","start":131.04,"end":132.92,"text":"And I want you so bad","translation":"","kind":"lyric"},{"id":"48","start":132.92,"end":138.13,"text":"But I'll be fine","translation":"","kind":"lyric"},{"id":"49","start":138.13,"end":139.78,"text":"I'll be fine, fine, fine","translation":"","kind":"lyric"},{"id":"50","start":139.78,"end":141.87,"text":"Fine, fine, fine, fine, fine","translation":"","kind":"lyric"},{"id":"51","start":141.87,"end":144.84,"text":"I'll be fine, fine, fine","translation":"","kind":"lyric"},{"id":"52","start":144.84,"end":147.06,"text":"Fine, fine, fine, fine, fine","translation":"","kind":"lyric"},{"id":"53","start":147.06,"end":149.75,"text":"I'll be fine, fine, fine","translation":"","kind":"lyric"},{"id":"54","start":149.75,"end":151.84,"text":"Fine, fine, fine, fine, fine","translation":"","kind":"lyric"},{"id":"55","start":151.84,"end":154.8,"text":"I'll be fine, fine, fine","translation":"","kind":"lyric"},{"id":"56","start":154.8,"end":156.37,"text":"Fine, fine, fine, fine, fine","translation":"","kind":"lyric"},{"id":"57","start":156.37,"end":159.41,"text":"'Cause when it all falls down","translation":"","kind":"lyric"},{"id":"58","start":159.41,"end":161.67000000000002,"text":"Then whatever (then whatever, babe)","translation":"","kind":"lyric"},{"id":"59","start":161.67000000000002,"end":166.43,"text":"When it don't work out for the better (for the better)","translation":"","kind":"lyric"},{"id":"60","start":166.43,"end":168.78,"text":"If it just ain't right","translation":"","kind":"lyric"},{"id":"61","start":168.78,"end":171.31,"text":"And it's time to say goodbye","translation":"","kind":"lyric"},{"id":"62","start":171.31,"end":174.24,"text":"When it all falls down (when it all, when it all)","translation":"","kind":"lyric"},{"id":"63","start":174.24,"end":176.52,"text":"When it all falls down (when it all falls down)","translation":"","kind":"lyric"},{"id":"64","start":176.52,"end":181.71,"text":"I'll be fine","translation":"","kind":"lyric"},{"id":"65","start":181.71,"end":185.96,"text":"(Fine, fine, fine) I'll be fine (I'll be fine)","translation":"","kind":"lyric"},{"id":"66","start":185.96,"end":191.06,"text":"You're the drug that I'm addicted to and I want you so bad","translation":"","kind":"lyric"},{"id":"67","start":191.06,"end":193.55,"text":"But I'll be fine (I'll be fine)","translation":"","kind":"lyric"},{"id":"68","start":193.55,"end":199.0,"text":"And that's that","translation":"","kind":"lyric"}],"candidates":[]}