{"title":"Viva La Vida","artist":"Coldplay","sourceId":"reference:UoLYcOMfVod7FGYUsms4","sourceHash":"c822b22ec99b83101fb68fc6d7e5960d2201e7e148eb75da3f6519a9d07e6a7d","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":36840358,"cues":[{"id":"1","start":13.06,"end":16.75,"text":"I used to rule the world","translation":"","kind":"lyric"},{"id":"2","start":16.75,"end":19.23,"text":"Seas would rise when I gave the word","translation":"","kind":"lyric"},{"id":"3","start":19.23,"end":23.55,"text":"Now in the morning, I sleep alone","translation":"","kind":"lyric"},{"id":"4","start":23.55,"end":29.02,"text":"Sweep the streets I used to own","translation":"","kind":"lyric"},{"id":"5","start":40.54,"end":44.6,"text":"I used to roll the dice","translation":"","kind":"lyric"},{"id":"6","start":44.6,"end":47.86,"text":"Feel the fear in my enemy's eyes","translation":"","kind":"lyric"},{"id":"7","start":47.86,"end":51.67,"text":"Listened as the crowd would sing","translation":"","kind":"lyric"},{"id":"8","start":51.67,"end":54.44,"text":"\"Now the old king is dead, long live the king\"","translation":"","kind":"lyric"},{"id":"9","start":54.51,"end":58.48,"text":"One minute I held the key","translation":"","kind":"lyric"},{"id":"10","start":58.48,"end":61.15,"text":"Next, the walls were closed on me","translation":"","kind":"lyric"},{"id":"11","start":61.15,"end":65.41,"text":"And I discovered that my castles stand","translation":"","kind":"lyric"},{"id":"12","start":65.41,"end":68.73,"text":"Upon pillars of salt and pillars of sand","translation":"","kind":"lyric"},{"id":"13","start":69.23,"end":73.11,"text":"I hear Jerusalem bells a-ringing","translation":"","kind":"lyric"},{"id":"14","start":73.11,"end":76.57,"text":"Roman cavalry choirs are singing","translation":"","kind":"lyric"},{"id":"15","start":76.57,"end":79.69,"text":"Be my mirror, my sword and shield","translation":"","kind":"lyric"},{"id":"16","start":79.69,"end":83.14,"text":"My missionaries in a foreign field","translation":"","kind":"lyric"},{"id":"17","start":83.49,"end":86.89,"text":"For some reason, I can't explain","translation":"","kind":"lyric"},{"id":"18","start":86.89,"end":89.52,"text":"Once you'd gone, there was never","translation":"","kind":"lyric"},{"id":"19","start":89.52,"end":93.22999999999999,"text":"Never an honest word","translation":"","kind":"lyric"},{"id":"20","start":93.22999999999999,"end":98.22,"text":"And that was when I ruled the world","translation":"","kind":"lyric"},{"id":"21","start":109.88,"end":114.05,"text":"It was a wicked and wild wind","translation":"","kind":"lyric"},{"id":"22","start":114.05,"end":116.74000000000001,"text":"Blew down the doors to let me in","translation":"","kind":"lyric"},{"id":"23","start":116.74000000000001,"end":121.1,"text":"Shattered windows and the sound of drums","translation":"","kind":"lyric"},{"id":"24","start":121.1,"end":124.22,"text":"People couldn't believe what I'd become","translation":"","kind":"lyric"},{"id":"25","start":124.29,"end":128.13,"text":"Revolutionaries wait","translation":"","kind":"lyric"},{"id":"26","start":128.13,"end":130.58,"text":"For my head on a silver plate","translation":"","kind":"lyric"},{"id":"27","start":130.58,"end":135.15,"text":"Just a puppet on a lonely string","translation":"","kind":"lyric"},{"id":"28","start":135.15,"end":138.22,"text":"Oh, who would ever want to be king?","translation":"","kind":"lyric"},{"id":"29","start":138.92000000000002,"end":142.52,"text":"I hear Jerusalem bells a-ringing","translation":"","kind":"lyric"},{"id":"30","start":142.52,"end":145.93,"text":"Roman cavalry choirs are singing","translation":"","kind":"lyric"},{"id":"31","start":145.93,"end":149.39,"text":"Be my mirror, my sword and shield","translation":"","kind":"lyric"},{"id":"32","start":149.39,"end":152.61,"text":"My missionaries in a foreign field","translation":"","kind":"lyric"},{"id":"33","start":152.87,"end":156.45,"text":"For some reason, I can't explain","translation":"","kind":"lyric"},{"id":"34","start":156.45,"end":159.64,"text":"I know Saint Peter won't call my name","translation":"","kind":"lyric"},{"id":"35","start":159.64,"end":162.71,"text":"Never an honest word","translation":"","kind":"lyric"},{"id":"36","start":162.71,"end":166.28,"text":"But that was when I ruled the world","translation":"","kind":"lyric"},{"id":"37","start":195.05,"end":198.1,"text":"Hear Jerusalem bells a-ringing","translation":"","kind":"lyric"},{"id":"38","start":198.1,"end":201.68,"text":"Roman cavalry choirs are singing","translation":"","kind":"lyric"},{"id":"39","start":201.68,"end":204.96,"text":"Be my mirror, my sword and shield","translation":"","kind":"lyric"},{"id":"40","start":204.96,"end":208.34,"text":"My missionaries in a foreign field","translation":"","kind":"lyric"},{"id":"41","start":208.57999999999998,"end":212.04,"text":"For some reason, I can't explain","translation":"","kind":"lyric"},{"id":"42","start":212.04,"end":215.18,"text":"I know Saint Peter won't call my name","translation":"","kind":"lyric"},{"id":"43","start":215.18,"end":218.42000000000002,"text":"Never an honest word","translation":"","kind":"lyric"},{"id":"44","start":218.42000000000002,"end":222.47,"text":"But that was when I ruled the world","translation":"","kind":"lyric"}],"candidates":[]}