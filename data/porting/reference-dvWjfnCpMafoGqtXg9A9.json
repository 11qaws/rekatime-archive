rt":32.16,"end":33.94,"text":"今すぐ始めよ!トレーニング! (イエス、マッスル!)","translation":"","kind":"lyric"},{"id":"20","start":33.94,"end":35.74,"text":"ヤバめの現実何とかなるはず","translation":"","kind":"lyric"},{"id":"21","start":35.74,"end":37.58,"text":"ダンベル両手にフリーウェイト! (ナイスマッチョ!)","translation":"","kind":"lyric"},{"id":"22","start":37.58,"end":39.26,"text":"焦りは禁物、無理しちゃ沈没","translation":"","kind":"lyric"},{"id":"23","start":39.26,"end":41.36,"text":"負荷のかけ方を調節!(そう、筋肉!)","translation":"","kind":"lyric"},{"id":"24","start":41.36,"end":43.45,"text":"限界10回ギリギリ全開!","translation":"","kind":"lyric"},{"id":"25","start":43.45,"end":44.81,"text":"3セットしたらオーライ! (ナイスポーズ!)","translation":"","kind":"lyric"},{"id":"26","start":44.81,"end":47.81,"text":"辛いこともある筋肉道(筋肉道)","translation":"","kind":"lyric"},{"id":"27","start":48.9,"end":51.9,"text":"モテモテボディがほしいの!","translation":"","kind":"lyric"},{"id":"28","start":52.14,"end":55.14,"text":"奇麗なワタシに大変身(大変身)","translation":"","kind":"lyric"},{"id":"29","start":55.41,"end":57.61,"text":"見てなさい!(さい?)さい!(さい??)","translation":"","kind":"lyric"},{"id":"30","start":57.61,"end":59.65,"text":"(はい、サイドチェストーーー!)","translation":"","kind":"lyric"},{"id":"31","start":59.65,"end":61.2,"text":"お願いマッスル","translation":"","kind":"lyric"},{"id":"32","start":61.2,"end":63.43,"text":"めっちゃモテたい","translation":"","kind":"lyric"},{"id":"33","start":63.43,"end":64.66,"text":"お願いマッスル","translation":"","kind":"lyric"},{"id":"34","start":64.66,"end":66.93,"text":"めっちゃ痩せたい、YES","translation":"","kind":"lyric"},{"id":"35","start":66.93,"end":68.49,"text":"お願いマッスル","translation":"","kind":"lyric"},{"id":"36","start":68.49,"end":70.52,"text":"めっちゃモテたいなら","translation":"","kind":"lyric"},{"id":"37","start":70.52,"end":71.2,"text":"ウー!(キレてるよ!)","translation":"","kind":"lyric"},{"id":"38","start":71.2,"end":72.24,"text":"ハー!(キレてるよ!)","translation":"","kind":"lyric"},{"id":"39","start":72.24,"end":74.67,"text":"筋肉にお願いだ!","translation":"","kind":"lyric"},{"id":"40","start":74.67,"end":77.47,"text":"レッグカール