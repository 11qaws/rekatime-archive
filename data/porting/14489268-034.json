{"title":"귀여워서 미안해","artist":"HoneyWorks","date":"2026-08-01","sourceId":"14489268:034","sourceHash":"d1864ac4a7530047f3d7067cf092a0f4c7560839bca3d7b1d3dfdc21788c2a3d","duration":232.36,"cues":[{"id":"1","start":17.07,"end":19.23,"text":"私が私の事を愛して","translation":"내가 나를 사랑하는 게","kind":"lyric"},{"id":"2","start":19.23,"end":22.57,"text":"何が悪いの？嫉妬でしょうか？","translation":"뭐가 잘못이야 질투라도 해","kind":"lyric"},{"id":"3","start":22.57,"end":25.27,"text":"痛いだとか変わってるとか","translation":"오글거린다느니 별나다느니","kind":"lyric"},{"id":"4","start":25.27,"end":28.23,"text":"届きませんね。そのリプライ","translation":"그런 답글은 닿지도 않네","kind":"lyric"},{"id":"5","start":28.23,"end":30.35,"text":"大好きなお洋服","translation":"정말 좋아하는 옷","kind":"lyric"},{"id":"6","start":30.35,"end":33.45,"text":"大好きなお化粧で","translation":"정말 좋아하는 화장으로","kind":"lyric"},{"id":"7","start":33.45,"end":38.36,"text":"お決まりのハーフツイン巻いて","translation":"늘 하던 하프 트윈테일로 머리를 말고","kind":"lyric"},{"id":"8","start":38.76,"end":40.44,"text":"お出かけしよ","translation":"나가 볼까","kind":"lyric"},{"id":"9","start":41.02,"end":43.0,"text":"日傘持って ぼっちだって","translation":"양산을 들고 혼자여도","kind":"lyric"},{"id":"10","start":43.0,"end":46.5,"text":"幸せだもん！","translation":"행복한걸","kind":"lyric"},{"id":"11","start":46.69,"end":48.86,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"12","start":48.86,"end":52.38,"text":"生まれてきちゃってごめん","translation":"태어나 버려서 미안해","kind":"lyric"},{"id":"13","start":52.65,"end":54.96,"text":"Chu！ あざとくてごめん","translation":"츄 앙큼해서 미안해","kind":"lyric"},{"id":"14","start":54.96,"end":58.4,"text":"気になっちゃうよね？ごめん","translation":"신경 쓰이지 미안해","kind":"lyric"},{"id":"15","start":59.27,"end":61.22,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"16","start":61.22,"end":64.38,"text":"努力しちゃっててごめん","translation":"노력해 버려서 미안해","kind":"lyric"},{"id":"17","start":64.4,"end":67.0,"text":"Chu！ 尊くてごめん","translation":"츄 존귀해서 미안해","kind":"lyric"},{"id":"18","start":67.0,"end":70.4,"text":"女子力高くてごめん","translation":"여자력이 넘쳐서 미안해","kind":"lyric"},{"id":"19","start":70.4,"end":75.1,"text":"ムカついちゃうよね？ざまあｗ","translation":"열받지 꼴좋다","kind":"lyric"},{"id":"20","start":85.83,"end":88.37,"text":"貴女は貴女の事だけどうぞ","translation":"넌 네 일이나 알아서 해","kind":"lyric"},{"id":"21","start":88.37,"end":91.73,"text":"私に干渉しないでください","translation":"나한테 참견하지 말아 줘","kind":"lyric"},{"id":"22","start":92.09,"end":94.27,"text":"類は友を呼ぶと言うけど…","translation":"끼리끼리 논다지만","kind":"lyric"},{"id":"23","start":94.27,"end":97.61,"text":"届きませんね。その陰口","translation":"그런 험담은 닿지도 않네","kind":"lyric"},{"id":"24","start":97.81,"end":99.73,"text":"重い厚底ブーツ","translation":"묵직한 통굽 부츠","kind":"lyric"},{"id":"25","start":100.31,"end":102.35,"text":"お気に入りのリュックで","translation":"아끼는 배낭을 메고","kind":"lyric"},{"id":"26","start":103.78,"end":106.88,"text":"崩せない前髪 くしでといて","translation":"흐트러지지 않는 앞머리를 빗으로 다듬고","kind":"lyric"},{"id":"27","start":106.88,"end":109.0,"text":"お出かけしよ","translation":"나가 볼까","kind":"lyric"},{"id":"28","start":109.0,"end":112.32,"text":"軽い女？ふざけんな","translation":"가벼운 여자라고 웃기지 마","kind":"lyric"},{"id":"29","start":112.94,"end":113.83,"text":"重すぎるっつーの！","translation":"너무 무겁다는 거야","kind":"lyric"},{"id":"30","start":113.83,"end":117.99,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"31","start":117.99,"end":120.66,"text":"この時代生きてごめん","translation":"이런 시대를 살아서 미안해","kind":"lyric"},{"id":"32","start":120.66,"end":124.15,"text":"Chu！ 目立っててごめん","translation":"츄 눈에 띄어서 미안해","kind":"lyric"},{"id":"33","start":124.15,"end":127.73,"text":"意識しちゃうよね？ごめん","translation":"의식하게 되지 미안해","kind":"lyric"},{"id":"34","start":127.73,"end":130.02,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"35","start":130.02,"end":133.38,"text":"自分磨きしてごめん","translation":"나를 가꿔서 미안해","kind":"lyric"},{"id":"36","start":134.42,"end":136.63,"text":"Chu！ ぶりっ子でごめん","translation":"츄 내숭 떨어서 미안해","kind":"lyric"},{"id":"37","start":136.81,"end":139.35,"text":"虜にしちゃってごめん","translation":"푹 빠뜨려서 미안해","kind":"lyric"},{"id":"38","start":140.49,"end":142.17,"text":"ムカついちゃうでしょ？ざまあｗ","translation":"열받지 꼴좋다","kind":"lyric"},{"id":"39","start":142.83,"end":144.15,"text":"趣味の違い","translation":"취향이 다르다고","kind":"lyric"},{"id":"40","start":144.35,"end":145.61,"text":"変わり者と","translation":"별종이라고","kind":"lyric"},{"id":"41","start":145.69,"end":147.87,"text":"バカにされても","translation":"비웃음 받아도","kind":"lyric"},{"id":"42","start":148.91,"end":149.57,"text":"曲げたくない","translation":"굽히고 싶지 않아","kind":"lyric"},{"id":"43","start":149.57,"end":151.11,"text":"怖くもない","translation":"무섭지도 않아","kind":"lyric"},{"id":"44","start":151.11,"end":153.31,"text":"あんたらごとき","translation":"너희 따위","kind":"lyric"},{"id":"45","start":153.31,"end":157.64,"text":"自分の味方は自分でありたい","translation":"내 편은 내가 되어 주고 싶어","kind":"lyric"},{"id":"46","start":157.64,"end":160.28,"text":"一番大切にしてあげたい","translation":"나를 가장 소중히 아껴 주고 싶어","kind":"lyric"},{"id":"47","start":160.28,"end":163.22,"text":"理不尽な我慢はさせたくない","translation":"부당한 참음은 시키고 싶지 않아","kind":"lyric"},{"id":"48","start":163.22,"end":166.64,"text":"“それが私”","translation":"그게 바로 나야","kind":"lyric"},{"id":"49","start":178.1,"end":181.06,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"50","start":181.06,"end":185.12,"text":"生まれてきちゃってごめん","translation":"태어나 버려서 미안해","kind":"lyric"},{"id":"51","start":185.22,"end":187.24,"text":"Chu！ あざとくてごめん","translation":"츄 앙큼해서 미안해","kind":"lyric"},{"id":"52","start":187.24,"end":192.64,"text":"人生楽しんでごめん","translation":"인생을 즐겨서 미안해","kind":"lyric"},{"id":"53","start":193.67,"end":195.43,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"54","start":195.43,"end":198.49,"text":"努力しちゃっててごめん","translation":"노력해 버려서 미안해","kind":"lyric"},{"id":"55","start":198.49,"end":201.55,"text":"Chu！ 尊くてごめん","translation":"츄 존귀해서 미안해","kind":"lyric"},{"id":"56","start":201.55,"end":204.27,"text":"女子力高くてごめん","translation":"여자력이 넘쳐서 미안해","kind":"lyric"},{"id":"57","start":204.27,"end":207.35,"text":"ムカついちゃうよね？ざまあｗ","translation":"열받지 꼴좋다","kind":"lyri