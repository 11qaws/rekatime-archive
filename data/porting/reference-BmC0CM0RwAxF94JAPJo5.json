{"title":"Dolls","artist":"Bella Poarch","sourceId":"reference:BmC0CM0RwAxF94JAPJo5","sourceHash":"0bd75bfbcaaaddb5bef78afd615c77f7cd9a8ac9af632986aceddd34a96ef265","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":8.34,"end":10.69,"text":"Oh, don't I look nice batting my eyes?","translation":"","kind":"lyric"},{"id":"2","start":10.69,"end":12.24,"text":"Isn't it pure perfection?","translation":"","kind":"lyric"},{"id":"3","start":12.24,"end":14.61,"text":"Cute, think I'm polite, stereotype","translation":"","kind":"lyric"},{"id":"4","start":14.61,"end":16.09,"text":"Got your full attention","translation":"","kind":"lyric"},{"id":"5","start":16.09,"end":18.05,"text":"Think that you can play with me?","translation":"","kind":"lyric"},{"id":"6","start":18.05,"end":20.02,"text":"You better watch your back","translation":"","kind":"lyric"},{"id":"7","start":20.02,"end":23.02,"text":"The last thing that you'll hear will be my laugh (yeah)","translation":"","kind":"lyric"},{"id":"8","start":23.72,"end":25.74,"text":"'Cause, baby, dolls kill","translation":"","kind":"lyric"},{"id":"9","start":25.74,"end":27.88,"text":"Don't provoke us or we will","translation":"","kind":"lyric"},{"id":"10","start":27.88,"end":29.74,"text":"Push you downhill","translation":"","kind":"lyric"},{"id":"11","start":29.74,"end":32.38,"text":"Might be pretty, but we're still","translation":"","kind":"lyric"},{"id":"12","start":32.38,"end":34.45,"text":"Bitter as much as we're sweet","translation":"","kind":"lyric"},{"id":"13","start":34.45,"end":35.95,"text":"Knife hidden under the sheets","translation":"","kind":"lyric"},{"id":"14","start":35.95,"end":37.99,"text":"Baby, dolls kill","translation":"","kind":"lyric"},{"id":"15","start":37.99,"end":40.99,"text":"Don't provoke us or we will (go)","translation":"","kind":"lyric"},{"id":"16","start":43.49,"end":46.49,"text":"-Voke us or we'll","translation":"","kind":"lyric"},{"id":"17","start":47.75,"end":50.75,"text":"Pretty, but we're (still)","translation":"","kind":"lyric"},{"id":"18","start":56.74,"end":58.21,"text":"Heels, made out of steel","translation":"","kind":"lyric"},{"id":"19","start":58.21,"end":60.93,"text":"How does it feel to bе walked all over?","translation":"","kind":"lyric"},{"id":"20","start":60.93,"end":63.56,"text":"Nails leaving a trail, got 'еm pigtails","translation":"","kind":"lyric"},{"id":"21","start":63.56,"end":65.05,"text":"Blood drips down your shoulder","translation":"","kind":"lyric"},{"id":"22","start":65.05,"end":67.05,"text":"Baby, there's power in numbers","translation":"","kind":"lyric"},{"id":"23","start":67.05,"end":68.9,"text":"Better warn all of your friends","translation":"","kind":"lyric"},{"id":"24","start":68.9,"end":70.86,"text":"You're down to less than an hour","translation":"","kind":"lyric"},{"id":"25","start":70.86,"end":72.91,"text":"We all know how this ends","translation":"","kind":"lyric"},{"id":"26","start":72.91,"end":74.69,"text":"Dolls kill","translation":"","kind":"lyric"},{"id":"27","start":74.69,"end":76.76,"text":"Don't provoke us or we will","translation":"","kind":"lyric"},{"id":"28","start":76.76,"end":78.58,"text":"Push you downhill","translation":"","kind":"lyric"},{"id":"29","start":78.58,"end":81.37,"text":"Might be pretty, but we're still","translation":"","kind":"lyric"},{"id":"30","start":81.37,"end":83.32,"text":"Bitter as much as we're sweet","translation":"","kind":"lyric"},{"id":"31","start":83.32,"end":84.62,"text":"Knife hidden under the sheets","translation":"","kind":"lyric"},{"id":"32","start":84.62,"end":86.87,"text":"Baby, dolls kill","translation":"","kind":"lyric"},{"id":"33","start":86.87,"end":89.87,"text":"Don't provoke us or we will (go)","translation":"","kind":"lyric"},{"id":"34","start":92.46000000000001,"end":95.46000000000001,"text":"-Voke us or we'll","transl