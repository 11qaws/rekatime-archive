{"title":"영웅 운명의 시","artist":"EGOIST","date":"2026-07-14","sourceId":"YzJm-mk52WM:038","sourceHash":"0ca5edc141960d5bbde736be63e24db4bb6fa8a1193163d06d61cf76a5fc6023","duration":279.08,"cues":[{"id":"1","start":4.62,"end":8.02,"text":"それは愚かなる名","translation":"그것은 어리석은 이름","kind":"lyric"},{"id":"2","start":8.02,"end":10.66,"text":"だが時は求む","translation":"그러나 시대는 원한다","kind":"lyric"},{"id":"3","start":10.66,"end":13.5,"text":"不屈の英雄","translation":"불굴의 영웅","kind":"lyric"},{"id":"4","start":13.5,"end":17.38,"text":"その物語を","translation":"그 이야기를","kind":"lyric"},{"id":"5","start":24.46,"end":29.37,"text":"Lead us Lord of light 我らを導き照らせ","translation":"Lead us Lord of light 우리를 이끌어 비춰 주소서","kind":"lyric"},{"id":"6","start":40.68,"end":42.13,"text":"小さく奏でた","translation":"작게 연주한","kind":"lyric"},{"id":"7","start":42.13,"end":45.15,"text":"愛は狭間を彷徨う","translation":"사랑은 틈새를 헤매고","kind":"lyric"},{"id":"8","start":45.15,"end":46.35,"text":"届かない","translation":"닿지 않는","kind":"lyric"},{"id":"9","start":46.35,"end":50.65,"text":"運命があざ笑う","translation":"운명이 비웃어","kind":"lyric"},{"id":"10","start":50.65,"end":53.15,"text":"隔てる世界を","translation":"가로막힌 세계를","kind":"lyric"},{"id":"11","start":53.15,"end":56.01,"text":"埋めてあなたに会いたい","translation":"메워 너를 만나고 싶어","kind":"lyric"},{"id":"12","start":56.01,"end":58.51,"text":"身を焦がすその愛が","translation":"몸을 태우는 그 사랑이","kind":"lyric"},{"id":"13","start":58.51,"end":61.49,"text":"分かつまで","translation":"갈라놓을 때까지","kind":"lyric"},{"id":"14","start":61.86,"end":63.98,"text":"人は叫んだ 正義を","translation":"사람들은 정의를 외쳤어","kind":"lyric"},{"id":"15","start":63.98,"end":66.66,"text":"その旗を高く掲げ","translation":"그 깃발을 높이 들어","kind":"lyric"},{"id":"16","start":66.66,"end":69.96,"text":"先人の上に立て","translation":"선인의 위에 서라","kind":"lyric"},{"id":"17","start":69.96,"end":74.67,"text":"闇を払い進め","translation":"어둠을 걷어 내고 나아가","kind":"lyric"},{"id":"18","start":74.67,"end":77.15,"text":"この身失うとも","translation":"이 몸을 잃더라도","kind":"lyric"},{"id":"19","start":77.15,"end":79.23,"text":"恐怖よ 平伏せ","translation":"두려움이여 엎드려라","kind":"lyric"},{"id":"20","start":80.17,"end":83.03,"text":"私が覇者となる","translation":"내가 지배자가 되리라","kind":"lyric"},{"id":"21","start":83.19,"end":85.42,"text":"生あらば進め","translation":"살아 있다면 나아가","kind":"lyric"},{"id":"22","start":85.42,"end":88.14,"text":"眼前の勝利を","translation":"눈앞의 승리를 향해","kind":"lyric"},{"id":"23","start":88.14,"end":90.8,"text":"暁旅立て","translation":"새벽에 길을 떠나라","kind":"lyric"},{"id":"24","start":90.8,"end":93.83,"text":"夜明けはもうすぐ","translation":"날이 곧 밝아 와","kind":"lyric"},{"id":"25","start":94.24,"end":99.82,"text":"This is our fate これは悲しき運命","translation":"This is our fate 이것은 슬픈 운명","kind":"lyric"},{"id":"26","start":116.84,"end":117.69,"text":"育み与える","translation":"키우고 내어 주며","kind":"lyric"},{"id":"27","start":117.69,"end":120.61,"text":"愛の花咲き知った","translation":"사랑의 꽃이 피어남을 알았어","kind":"lyric"},{"id":"28","start":120.61,"end":123.6,"text":"残された時はもう","translation":"남은 시간이 이제","kind":"lyric"},{"id":"29","start":123.6,"end":125.6,"text":"僅かと","translation":"얼마 없다는 걸","kind":"lyric"},{"id":"30","start":125.6,"end":129.05,"text":"悲しい世界に","translation":"슬픈 세상에","kind":"lyric"},{"id":"31","start":129.05,"end":131.79,"text":"願いを一つ祈る","translation":"소원 하나를 빌어","kind":"lyric"},{"id":"32","start":131.79,"end":133.21,"text":"愛してる","translation":"사랑해","kind":"lyric"},{"id":"33","start":133.21,"end":136.4,"text":"さよならのセレナーデ","translation":"작별의 세레나데","kind":"lyric"},{"id":"34","start":136.4,"end":139.19,"text":"人は選んだ 狂騒を","translation":"사람들은 광란을 택했어","kind":"lyric"},{"id":"35","start":139.19,"end":142.59,"text":"その旗を高く掲げ","translation":"그 깃발을 높이 들어","kind":"lyric"},{"id":"36","start":142.59,"end":146.2,"text":"他者の上に立て","translation":"타인의 위에 서라","kind":"lyric"},{"id":"37","start":146.2,"end":150.4,"text":"闇を払い進め","translation":"어둠을 걷어 내고 나아가","kind":"lyric"},{"id":"38","start":150.4,"end":153.96,"text":"多くを失うとも","translation":"많은 것을 잃더라도","kind":"lyric"},{"id":"39","start":154.54,"end":156.08,"text":"自由をこの手に","translation":"자유를 이 손에","kind":"lyric"},{"id":"40","start":156.11,"end":158.98,"text":"時代の覇者となる","translation":"시대의 지배자가 되리라","kind":"lyric"},{"id":"41","start":159.92,"end":162.28,"text":"鉄槌を下せ","translation":"철퇴를 내려쳐라","kind":"lyric"},{"id":"42","start":162.28,"end":163.08,"text":"妨げるものよ","translation":"가로막는 자여","kind":"lyric"},{"id":"43","start":164.14,"end":166.82,"text":"この空燃やして","translation":"이 하늘을 불태워","kind":"lyric"},{"id":"44","start":167.04,"end":169.8,"text":"二度と帰しはしない","translation":"두 번 다시 돌려보내지 않아","kind":"lyric"},{"id":"45","start":170.59,"end":175.18,"text":"This is our fate","translation":"This is our fate","kind":"lyric"},{"id":"46","start":175.18,"end":180.58,"text":"鳴り響く笛 勿忘の花よ","translation":"울려 퍼지는 피리 물망초 꽃이여","kind":"lyric"},{"id":"47","start":180.58,"end":186.0,"text":"こんなにも美しく咲き誇る","translation":"이토록 아름답게 만발해","kind":"lyric"},{"id":"48","start":186.0,"end":191.0,"text":"To give up who you are","translation":"너 자신을 포기하고","kind":"lyric"},{"id":"49","start":191.0,"end":194.95,"text":"and live without your faith","translation":"신념 없이 사는 것은","kind":"lyric"},{"id":"50","start":194.95,"end":196.78,"text":"is more regrettable than dying","translation":"죽는 것보다 더 후회스러워","kind":"lyric"},{"id":"51","start":196.78,"end":201.28,"text":"than dying so young","translation":"그토록 젊어 죽는 것보다","kind":"lyric"},{"id":"52","start":217.44,"end":218.63,"text":"人は語るだろう 信念を","translation":"사람들은 신념을 말하겠지","kind":"lyric"},{"id":"53","start":218.63,"end":220.97,"text":"その旗を高く掲げ","translation":"그 깃발을 높이 들어","kind":"lyric"},{"id":"54","start":221.21,"end":224.69,"text":"自ら奮い立て","translation":"스스로를 북돋아라","kind":"lyric"},{"id":"55","start":225.59,"end":228.73,"text":"闇を払い進め","translation":"어둠을 걷어 내고 나아가","kind":"lyric"},{"id":"56","start":229.26,"end":231.92,"text":"命運尽きるとも","translation":"운명이 다하더라도","kind":"lyric"},{"id":"57","start":231.92,"end":234.85,"text":"誰より気高く","translation":"누구보다 고결하게","kind":"lyric"},{"id":"58","start":234.85,"end":238.01,"text":"この名は汚さない","translation":"이 이름을 더럽히지 않아","kind":"lyric"},{"id":"59","start":238.4,"end":240.18,"text":"生あらば進め","translation":"살아 있다면 나아가","kind":"lyric"},{"id":"60","start":240.18,"end":242.72,"text":"眼前の勝利を","translation":"눈앞의 승리를 향해","kind":"lyric"},{"id":"61","start":242.72,"end":245.5,"text":"暁旅立て","translation":"새벽에 길을 떠나라","kind":"lyric"},{"id":"62","start":245.5,"end":248.44,"text":"夜明けはもうすぐ","translation":"날이 곧 밝아 와","kind":"lyric"},{"id":"63","start":248.49,"end":251.36,"text":"英雄に詩を","translation":"영웅에게 노래를","kind":"lyric"},{"id":"64","start":251.36,"end":253.62,"text":"多くを失うとも","translation":"많은 것을 잃더라도","kind":"lyric"},{"id":"65","start":253.62,"end":256.38,"text":"自由をこの手に","translation":"자유를 이 손에","kind":"lyric"},{"id":"66","start":256.38,"end":258.94,"text":"時代の覇者となる","translation":"시대의 지배자가 되리라","kind":"lyric"},{"id":"67","start":258.94,"end":261.7,"text":"残花枯れ落ちた","translation":"남은 꽃이 시들어 떨어져","kind":"lyric"},{"id":"68","start":261.7,"end":264.52,"text":"物語となり","translation":"이야기가 되고","kind":"lyric"},{"id":"69","start":264.52,"end":267.24,"text":"暁旅立つ","translation":"새벽에 길을 떠나","kind":"lyric"},{"id":"70","start":267.24,"end":270.48,"text":"あなたと共になる","translation":"너와 하나가 되어","kind":"lyric"},{"id":"71","start":270.48,"end":275.92,"text":"This is our fate","translation":"This is our fate","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}