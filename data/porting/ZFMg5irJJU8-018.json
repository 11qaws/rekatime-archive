{"title":"달을 보고 있었어","artist":"米津玄師","date":"2026-07-29","sourceId":"ZFMg5irJJU8:018","sourceHash":"8a63da046bfc8c747d3064e4439027c6ba2b64c2b9097c20ed370529823a8884","duration":233.76,"cues":[{"id":"1","start":5.1,"end":10.38,"text":"月明かり柳が揺れる","translation":"달빛에 버드나무가 흔들려","kind":"lyric"},{"id":"2","start":11.57,"end":13.83,"text":"わたしは路傍の礫","translation":"나는 길가의 돌멩이","kind":"lyric"},{"id":"3","start":14.17,"end":20.81,"text":"思い馳せるあなたの姿","translation":"마음에 그리는 너의 모습","kind":"lyric"},{"id":"4","start":22.75,"end":25.83,"text":"羊を数えるように","translation":"양을 세듯이","kind":"lyric"},{"id":"5","start":25.83,"end":32.06,"text":"別れゆく意味があるなら","translation":"헤어져 가는 데 의미가 있다면","kind":"lyric"},{"id":"6","start":32.06,"end":36.68,"text":"せめて悲しまないで","translation":"적어도 슬퍼하지 마","kind":"lyric"},{"id":"7","start":39.64,"end":43.54,"text":"沈黙から離れた空へ","translation":"침묵에서 벗어난 하늘로","kind":"lyric"},{"id":"8","start":45.1,"end":48.16,"text":"一筋の愛を込めて","translation":"한 줄기 사랑을 담아","kind":"lyric"},{"id":"9","start":48.16,"end":52.72,"text":"どんな夜だって","translation":"어떤 밤이라도","kind":"lyric"},{"id":"10","start":52.72,"end":55.44,"text":"失い続けたって","translation":"계속 잃는다 해도","kind":"lyric"},{"id":"11","start":55.44,"end":58.34,"text":"共に生きてきたろう","translation":"함께 살아왔잖아","kind":"lyric"},{"id":"12","start":58.36,"end":61.99,"text":"瞬くように","translation":"반짝이듯","kind":"lyric"},{"id":"13","start":65.51,"end":68.25,"text":"何かを求めて月を見ていた","translation":"무언가를 찾아 달을 보고 있었어","kind":"lyric"},{"id":"14","start":69.92,"end":73.74,"text":"嵐に怯えるわたしの前に","translation":"폭풍을 두려워하는 내 앞에","kind":"lyric"},{"id":"15","start":73.74,"end":78.92,"text":"現れたのがあなたでよかった","translation":"나타난 것이 너라서 다행이야","kind":"lyric"},{"id":"16","start":78.92,"end":85.3,"text":"まるで何もかもがなかったかのように","translation":"마치 모든 일이 없었던 것처럼","kind":"lyric"},{"id":"17","start":86.9,"end":92.6,"text":"この火は消えたりしない きっと","translation":"이 불은 꺼지지 않아 분명","kind":"lyric"},{"id":"18","start":107.85,"end":112.61,"text":"その窓を風が叩けば","translation":"그 창문을 바람이 두드리면","kind":"lyric"},{"id":"19","start":113.53,"end":116.17,"text":"僅かに開け放して","translation":"조금만 활짝 열어","kind":"lyric"},{"id":"20","start":116.17,"end":123.71,"text":"ただひとつ そうただひとつ","translation":"단 하나 그래 단 하나","kind":"lyric"},{"id":"21","start":123.71,"end":129.09,"text":"語り得ぬ声で叫ぶ","translation":"말로 다 할 수 없는 목소리로 외쳐","kind":"lyric"},{"id":"22","start":130.29,"end":132.69,"text":"生まれ変わったとして","translation":"다시 태어난다 해도","kind":"lyric"},{"id":"23","start":132.69,"end":135.45,"text":"思い出せなくたって","translation":"기억하지 못한다 해도","kind":"lyric"},{"id":"24","start":135.45,"end":138.65,"text":"見つけてみせるだろう","translation":"찾아내고 말겠지","kind":"lyric"},{"id":"25","start":138.65,"end":142.04,"text":"あなたの姿","translation":"너의 모습을","kind":"lyric"},{"id":"26","start":146.23,"end":147.91,"text":"全てを燃やして月を見ていた","translation":"모든 것을 태우며 달을 보고 있었어","kind":"lyric"},{"id":"27","start":147.91,"end":153.41,"text":"誰かがそれを憐れむとしても","translation":"누군가 그것을 가엾게 여긴다 해도","kind":"lyric"},{"id":"28","start":153.41,"end":158.25,"text":"あなたがいれば幸せだったんだ","translation":"네가 있어서 행복했어","kind":"lyric"},{"id":"29","start":160.45,"end":165.52,"text":"およそ正しくなどなかったとしても","translation":"전혀 옳지 않았다 해도","kind":"lyric"},{"id":"30","start":166.06,"end":169.04,"text":"消えたりしない","translation":"사라지지 않아","kind":"lyric"},{"id":"31","start":170.58,"end":173.06,"text":"名前を呼んで","translation":"이름을 불러 줘","kind":"lyric"},{"id":"32","start":173.06,"end":175.52,"text":"もう一度だけ","translation":"단 한 번만 더","kind":"lyric"},{"id":"33","start":175.52,"end":181.12,"text":"優しく包むその柔い声で","translation":"다정히 감싸는 그 부드러운 목소리로","kind":"lyric"},{"id":"34","start":181.12,"end":186.6,"text":"月を頼りに掴んだ枝が","translation":"달을 의지해 붙잡은 가지가","kind":"lyric"},{"id":"35","start":186.6,"end":188.96,"text":"あなただった","translation":"너였어","kind":"lyric"},{"id":"36","start":191.5,"end":194.56,"text":"あなただった","translation":"너였어","kind":"lyric"},{"id":"37","start":197.64,"end":203.1,"text":"何かを求めて月を見ていた","translation":"무언가를 찾아 달을 보고 있었어","kind":"lyric"},{"id":"38","start":203.1,"end":208.76,"text":"嵐に怯えるわたしの前に","translation":"폭풍을 두려워하는 내 앞에","kind":"lyric"},{"id":"39","start":208.76,"end":214.06,"text":"現れたのがあなたでよかった","translation":"나타난 것이 너라서 다행이야","kind":"lyric"},{"id":"40","start":214.06,"end":220.58,"text":"まるで何もかもがなかったかのように","translation":"마치 모든 일이 없었던 것처럼","kind":"lyric"},{"id":"41","start":221.24,"end":227.62,"text":"この火は消えたりしない きっと","translation":"이 불은 꺼지지 않아 분명","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}