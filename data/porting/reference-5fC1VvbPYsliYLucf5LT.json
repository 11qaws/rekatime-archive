{"title":"약혼전쟁 (어레인지)","artist":"Honeyworks","sourceId":"reference:5fC1VvbPYsliYLucf5LT","sourceHash":"93f6325ab6eeb7e6ff846ab0ca1e23a467a1a791b41b199da1fda13ed1ecc8cd","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":11.93,"end":14.93,"text":"姫と婚約できるという指輪は俺がいただいた","translation":"","kind":"lyric"},{"id":"2","start":15.63,"end":18.18,"text":"捕まえられるもんなら捕まえてみな！","translation":"","kind":"lyric"},{"id":"3","start":18.18,"end":20.95,"text":"次は姫を奪いに行く","translation":"","kind":"lyric"},{"id":"4","start":20.95,"end":23.95,"text":"王様、ダイヤの指輪が盗まれたようです","translation":"","kind":"lyric"},{"id":"5","start":26.85,"end":29.85,"text":"姫との婚約狙った者の犯行です","translation":"","kind":"lyric"},{"id":"6","start":31.17,"end":34.17,"text":"探偵、すぐに捕まえろ","translation":"","kind":"lyric"},{"id":"7","start":34.32,"end":36.91,"text":"大切な指輪","translation":"","kind":"lyric"},{"id":"8","start":36.91,"end":39.91,"text":"怪盗の仕業だ許さない","translation":"","kind":"lyric"},{"id":"9","start":41.91,"end":44.91,"text":"欲しいのはあなたの心さ","translation":"","kind":"lyric"},{"id":"10","start":46.94,"end":49.94,"text":"スリル触れさせてあげようか","translation":"","kind":"lyric"},{"id":"11","start":51.96,"end":54.96,"text":"足跡たどって突き止めた","translation":"","kind":"lyric"},{"id":"12","start":57.12,"end":58.22,"text":"アジトはここだ","translation":"","kind":"lyric"},{"id":"13","start":58.22,"end":61.22,"text":"捕らえた者に褒美をやろう","translation":"","kind":"lyric"},{"id":"14","start":62.23,"end":65.22999999999999,"text":"指輪で愛の約束","translation":"","kind":"lyric"},{"id":"15","start":67.31,"end":70.31,"text":"誰もが狙うクレオパトラ","translation":"","kind":"lyric"},{"id":"16","start":72.37,"end":73.62,"text":"まるで他人事","translation":"","kind":"lyric"},{"id":"17","start":73.62,"end":76.62,"text":"あなたの心はどこに？","translation":"","kind":"lyric"},{"id":"18","start":77.23,"end":79.73,"text":"お構いなしの闘い始まる","translation":"","kind":"lyric"},{"id":"19","start":79.73,"end":82.58,"text":"指輪をめぐって婚約戦争","translation":"","kind":"lyric"},{"id":"20","start":82.58,"end":85.58,"text":"由緒正しき人よ 期待しておるぞ","translation":"","kind":"lyric"},{"id":"21","start":97.75,"end":99.99000000000001,"text":"ずっと眺めることしかできなかった姫と","translation":"","kind":"lyric"},{"id":"22","start":99.99000000000001,"end":102.53999999999999,"text":"結婚できるチャンス？","translation":"","kind":"lyric"},{"id":"23","start":102.53999999999999,"end":105.53999999999999,"text":"なんとしてもこの手で捕まえてやる！","translation":"","kind":"lyric"},{"id":"24","start":107.09,"end":110.09,"text":"王様、いや、未来のお父さん 僕にお任せを","translation":"","kind":"lyric"},{"id":"25","start":112.87,"end":115.87,"text":"姫との婚約僕じゃダメですか？","translation":"","kind":"lyric"},{"id":"26","start":117.47999999999999,"end":120.47999999999999,"text":"探偵、そこまで言うならば行動で示せ","translation":"","kind":"lyric"},{"id":"27","start":122.78,"end":125.78,"text":"口だけのやつは許さない","translation":"","kind":"lyric"},{"id":"28","start":127.9,"end":130.9,"text":"恋の予告状受け取って？","translation":"","kind":"lyric"},{"id":"29","start":132.93,"end":135.93,"text":"愛に触れ感情揺らそうか","translation":"","kind":"lyric"},{"id":"30","start":137.87,"end":140.87,"text":"今日こそ手錠かけてやるぞ","translation":"","kind":"lyric"},{"id":"31","start":142.97,"end":145.36,"text":"不届き者よ分をわきまえよ","translation":"","kind":"lyric"},{"id":"32","start":145.36,"end":148.12,"text":"これで終わりだ","translation":"","kind":"lyric"},{"id":"33","start":148.12,"end":151.12,"text":"譲れぬ愛の結末","translation":"","kind":"lyric"},{"id":"34","start":153.04,"end":156.04,"text":"誰もが落ちるルクレツィア","translation":"","kind":"lyric"},{"id":"35","start":158.22,"end":159.57,"text":"まるで上の空","translation":"","kind":"lyric"},{"id":"36","start":159.57,"end":162.57,"text":"あなたの心はどこに？","translation":"","kind":"lyric"},{"id":"37","start":163.21,"end":165.75,"text":"命を懸けた闘いは続く","translation":"","kind":"lyric"},{"id":"38","start":165.75,"end":168.68,"text":"指輪をめぐって婚約戦争","translation":"","kind":"lyric"},{"id":"39","start":168.68,"end":171.68,"