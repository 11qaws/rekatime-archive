":71.83,"end":74.83,"text":"救いは無い","translation":"","kind":"lyric"},{"id":"20","start":76.98,"end":79.98,"text":"どこが痛い？","translation":"","kind":"lyric"},{"id":"21","start":82.06,"end":83.52,"text":"俺も痛い","translation":"","kind":"lyric"},{"id":"22","start":83.52,"end":84.57,"text":"誰も気づかねえよ","translation":"","kind":"lyric"},{"id":"23","start":84.57,"end":86.12,"text":"お前みたいなクズが一人消えて","translation":"","kind":"lyric"},{"id":"24","start":86.12,"end":88.66,"text":"席が一つ空いて別のクズが座る","translation":"","kind":"lyric"},{"id":"25","start":88.66,"end":89.4,"text":"どうせ変わらない","translation":"","kind":"lyric"},{"id":"26","start":89.4,"end":91.47,"text":"不条理 暴利 負けりゃゴミのように奉仕","translation":"","kind":"lyric"},{"id":"27","start":91.47,"end":92.72999999999999,"text":"そんなヤツを助けたい","translation":"","kind":"lyric"},{"id":"28","start":92.72999999999999,"end":93.46000000000001,"text":"訳じゃない","translation":"","kind":"lyric"},{"id":"29","start":93.46000000000001,"end":94.66,"text":"二人だけの話","translation":"","kind":"lyric"},{"id":"30","start":94.66,"end":95.81,"text":"あの時の仕返し","translation":"","kind":"lyric"},{"id":"31","start":95.81,"end":97.09,"text":"忘れたとか無し","translation":"","kind":"lyric"},{"id":"32","start":97.09,"end":99.83,"text":"復讐を果たし","translation":"","kind":"lyric"},{"id":"33","start":99.83,"end":100.82,"text":"朽ち果てていく","translation":"","kind":"lyric"},{"id":"34","start":100.82,"end":103.77000000000001,"text":"そう あの日の俺のように","translation":"","kind":"lyric"},{"id":"35","start":103.77000000000001,"end":105.32,"text":"親父の部屋から消えたハジキ","translation":"","kind":"lyric"},{"id":"36","start":105.32,"end":106.63,"text":"賭けでスッたマージン","translation":"","kind":"lyric"},{"id":"37","start":106.63,"end":109.14,"text":"泣いて何も言わぬ女の懐にチャージ","translation":"","kind":"lyric"},{"id":"38","start":109.14,"end":111.43,"text":"袖の下に 出所不明のマニー","translation":"","kind":"lyric"},{"id":"39","start":111.43,"end":113.99000000000001,"text":"保険屋もグルらしい","translation":"","kind":"lyric"},{"id":"40","start":113.99000000000001,"end"