{"title":"SNOBBISM","artist":"Neru","sourceId":"reference:ec3RmDRPmdplsCpPz8xV","sourceHash":"c0abb49ed9adfcb6c8a058b8e92512bcb4c5f2981628cb53b6880dbc2c825dc9","performanceStatus":"no_performance_record","timingMethod":"reference_lyric_character_matching","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":1.75,"end":5.83,"text":"あれこれ吐いてばら撒かないと寝られやしない","translation":"","kind":"lyric"},{"id":"2","start":5.83,"end":9.63,"text":"やり切れない血反吐をたんとぶちまけないと釈然としない","translation":"","kind":"lyric"},{"id":"3","start":9.63,"end":12.74,"text":"一生そうして 心臓を投げ合って","translation":"","kind":"lyric"},{"id":"4","start":12.74,"end":15.0,"text":"せせら笑うのが","translation":"","kind":"lyric"},{"id":"5","start":15.0,"end":26.3,"text":"この街の異様なモラリティーなんだ","translation":"","kind":"lyric"},{"id":"6","start":26.3,"end":31.41,"text":"セルフィーこそが全てなのと言う少女に","translation":"","kind":"lyric"},{"id":"7","start":31.41,"end":35.32,"text":"気まぐれな同情だとかサブカルチャーが着弾する","translation":"","kind":"lyric"},{"id":"8","start":35.32,"end":39.23,"text":"生憎の予報ですが本日、東京一体の空には","translation":"","kind":"lyric"},{"id":"9","start":39.23,"end":42.79,"text":"警報級の悪巧みが降る様です","translation":"","kind":"lyric"},{"id":"10","start":42.79,"end":47.28,"text":"白昼堂々 駅のホームでは沢山もの","translation":"","kind":"lyric"},{"id":"11","start":47.28,"end":51.07,"text":"現実感が彼の背中を線路内へ蹴落としてる","translation":"","kind":"lyric"},{"id":"12","start":51.07,"end":55.15,"text":"人一人の命がエンタメのように さも折り込みチラシみたいに","translation":"","kind":"lyric"},{"id":"13","start":55.15,"end":61.7,"text":"消しカスとなって浪費コンテンツの犠牲となる","translation":"","kind":"lyric"},{"id":"14","start":61.7,"end":67.03,"text":"さあ、喧嘩しようぜ 喧嘩しようぜ","translation":"","kind":"lyric"},{"id":"15","start":67.03,"end":70.94,"text":"インプレッション次第でミサイルをぶっ放して","translation":"","kind":"lyric"},{"id":"16","start":70.94,"end":73.36,"text":"さあ、喧嘩しようぜ 喧嘩しようぜ","translation":"","kind":"lyric"},{"id":"17","start":73.36,"end":80.19,"text":"正当性なんて後でテープでくっ付けろ","translation":"","kind":"lyric"},{"id":"18","start":80.19,"end":86.28,"text":"明日、世界が終わるだなんて法螺話に","translation":"","kind":"lyric"},{"id":"19","start":86.28,"end":90.1,"text":"そうだったらいいなと逆に願ってる希死念慮の時代","translation":"","kind":"lyric"},{"id":"20","start":90.1,"end":94.69,"text":"何不自由ない これ以上もないくらいの 豪勢な今世に","translation":"","kind":"lyric"},{"id":"21","start":94.69,"end":97.66,"text":"僕等は見えない何かを欲していた","translation":"","kind":"lyric"},{"id":"22","start":97.66,"end":102.44,"text":"何千回何万回 馬鹿の一つ覚えのように 後悔をすんのが","translation":"","kind":"lyric"},{"id":"23","start":102.44,"end":111.19,"text":"この街の面白いところなんだ","translation":"","kind":"lyric"},{"id":"24","start":111.19,"end":117.19,"text":"一体どうして 未来図ってマニュアル本には","translation":"","kind":"lyric"},{"id":"25","start":117.19,"end":121.03,"text":"最重要な術の導線設計がなされてないんだよ","translation":"","kind":"lyric"},{"id":"26","start":121.03,"end":125.7,"text":"だから人は野蛮な凶器を振るうし それは至極当然の道理","translation":"","kind":"lyric"},{"id":"27","start":125.7,"end":131.46,"text":"バグ塗れの人類のデバッグはいつ終わる","translation":"","kind":"lyric"},{"id":"28","start":131.46,"end":137.69,"text":"さあ、喧嘩しようぜ 喧嘩しようぜ","translation":"","kind":"lyric"},{"id":"29","start":137.69,"end":141.27,"text":"センセーションなんかを爆弾でぶち込んで","translation":"","kind":"lyric"},{"id":"30","start":141.27,"end":145.09,"text":"さあ、喧嘩しようぜ 喧嘩しようぜ","translation":"","kind":"lyric"},{"id":"31","start":145.09,"end":150.84,"text":"一切合切をかなぐり捨てて行こうぜ","translation":"","kind":"lyric"},{"id":"32","start":150.84,"end":155.8,"text":"失うもんはもう無いさ 愛される身分でもないな","translation":"","kind":"lyric"},{"id":"33","start":155.8,"end":159.42000000000002,"text":"終生に及んで致し方ない防衛線","translation":"","kind":"lyric"},{"id":"34","start":159.42000000000002,"end":162.09,"text":"幼さとかいう小銃を ただあくまで誇示する僕等","translation":"","kind":"lyric"},{"id":"35","start":162.09,"end":166.21,"text":"硝煙を燻した騒擾なんか 滑稽なショー同然だ","translation":"","kind":"lyric"},{"id":"36","start":166.21,"end":169.72,"text":"一生、ブラフを威すがいいさ","translation":"","kind":"lyric"},{"id":"37","start":169.72,"end":174.4,"text":"そのままお山の大将やったらいいさ","translation":"","kind":"lyric"},{"id":"38","start":174.4,"end":183.93,"text":"バラックの集落で被害者面して馬鹿騒ぎしようぜ","translation":"","kind":"lyric"},{"id":"39","start":183.93,"end":191.35,"text":"空っぽの分際で馬鹿騒ぎしようぜ","translation":"","kind":"lyric"},{"id":"40","start":191.35,"end":195.5,"text":"馬鹿騒ぎしようぜ","translation":"","kind":"lyric"}],"candidates":[]}