{"title":"라시사","artist":"오피셜히게단디즘","sourceId":"reference:MdDUYbM75liGDrF09aCs","sourceHash":"10f726b22a3f5a18e6dbbb6b8b53cfc4169557f0737c4d5359453cec9e9456cc","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":24959089,"cues":[{"id":"1","start":17.0,"end":22.81,"text":"誇るよ全部 僕が僕であるための要素を","translation":"","kind":"lyric"},{"id":"2","start":22.81,"end":28.72,"text":"好きだよ全部 君という僕の黒い部分も","translation":"","kind":"lyric"},{"id":"3","start":28.72,"end":34.55,"text":"恵まれなかった才能も 丈夫じゃない性格も","translation":"","kind":"lyric"},{"id":"4","start":34.55,"end":39.81,"text":"だけど大それた夢をちゃんと描く強かさも","translation":"","kind":"lyric"},{"id":"5","start":40.37,"end":45.94,"text":"焦るよいつも 足音の群衆が僕の努力を","translation":"","kind":"lyric"},{"id":"6","start":45.94,"end":51.96,"text":"引き裂いて何度 君という闇の世話になったろう","translation":"","kind":"lyric"},{"id":"7","start":51.96,"end":54.87,"text":"オンリーワンでもいいと","translation":"","kind":"lyric"},{"id":"8","start":54.87,"end":63.21,"text":"無理やりつけたアイマスクの奥で一睡もしやしない自分も見飽きたよ","translation":"","kind":"lyric"},{"id":"9","start":64.28,"end":67.47,"text":"「現実的、客観的に見れば","translation":"","kind":"lyric"},{"id":"10","start":67.47,"end":72.27,"text":"絶望的 絶対的1位はきっと取れないな」","translation":"","kind":"lyric"},{"id":"11","start":72.27,"end":76.12,"text":"分かってる 分かっちゃいるんだけど","translation":"","kind":"lyric"},{"id":"12","start":76.12,"end":81.24,"text":"圧倒的、直感的に僕は 納得出来ちゃいない","translation":"","kind":"lyric"},{"id":"13","start":81.24,"end":84.71000000000001,"text":"ああ なんでこんなにも面倒で","translation":"","kind":"lyric"},{"id":"14","start":84.71000000000001,"end":90.58,"text":"不適合な長所を宿してしまったんだろう","translation":"","kind":"lyric"},{"id":"15","start":93.58,"end":98.62,"text":"らしさ そんなものを抱えては","translation":"","kind":"lyric"},{"id":"16","start":98.62,"end":105.27000000000001,"text":"僕らは泣いてた 笑ってた 競い合ったまま","translation":"","kind":"lyric"},{"id":"17","start":105.27000000000001,"end":110.28999999999999,"text":"大好きな事に全て捧げては","translation":"","kind":"lyric"},{"id":"18","start":110.28999999999999,"end":114.41,"text":"何度も泣くんだ 笑うんだ","translation":"","kind":"lyric"},{"id":"19","start":114.41,"end":119.25,"text":"メチャクチャなペースで","translation":"","kind":"lyric"},{"id":"20","start":129.05,"end":134.48,"text":"何度勝っても それはそれで未来は苦しいもの","translation":"","kind":"lyric"},{"id":"21","start":134.48,"end":140.73,"text":"ああ まじでなんなの？ 負けて負けて負けまくった時ほど","translation":"","kind":"lyric"},{"id":"22","start":140.73,"end":146.55,"text":"思い出話が僕の歩みを遅めてしまうよ","translation":"","kind":"lyric"},{"id":"23","start":146.55,"end":151.76,"text":"過去の僕と君からの最低のプレゼント","translation":"","kind":"lyric"},{"id":"24","start":153.06,"end":156.09,"text":"打算的で消極的な面は","translation":"","kind":"lyric"},{"id":"25","start":156.09,"end":161.14,"text":"僕を守る絆創膏 怖くてきっと剥げないな","translation":"","kind":"lyric"},{"id":"26","start":161.14,"end":164.82,"text":"分かってる 分かっちゃいるんだけど","translation":"","kind":"lyric"},{"id":"27","start":164.82,"end":169.86,"text":"プライドは新品のままで白くふやけ痒がっている","translation":"","kind":"lyric"},{"id":"28","start":169.86,"end":173.52,"text":"ああ どちらも僕で君だから","translation":"","kind":"lyric"},{"id":"29","start":173.52,"end":179.36,"text":"どちらも本心だからたちが悪いよな","translation":"","kind":"lyric"},{"id":"30","start":199.52,"end":202.21,"text":"「始めたのが遅いから」","translation":"","kind":"lyric"},{"id":"31","start":202.21,"end":205.07999999999998,"text":"「世界はあまりにも広いから」","translation":"","kind":"lyric"},{"id":"32","start":205.07999999999998,"end":207.82,"text":"「天才はレベルが違うから」","translation":"","kind":"lyric"},{"id":"33","start":207.82,"end":210.43,"text":"「てかお前が楽しけりゃいいじゃん」","translation":"","kind":"lyric"},{"id":"34","start":210.43,"end":211.92000000000002,"text":"ああ うるさいな","translation":"","kind":"lyric"},{"id":"35","start":211.92000000000002,"end":216.35,"text":"それでもなんか君に負けてしまう日もあった","translation":"","kind":"lyric"},{"id":"36","start":216.35,"end":217.73,"text":"まあ そりゃそっか","translation":"","kind":"lyric"},{"id":"37","start":217.73,"end":221.91,"text":"ブレない芯や思想なんて僕らしくはないや","translation":"","kind":"lyric"},{"id":"38","start":221.91,"end":225.07,"text":"でも今の僕は もう限界だ","translation":"","kind":"lyric"},{"id":"39","start":225.07,"end":227.92000000000002,"text":"君の言いなりになってたまるか","translation":"","kind":"lyric"},{"id":"40","start":227.92000000000002,"end":230.15,"text":"僕はやっぱ (僕はやっぱ)","translation":"","kind":"lyric"},{"id":"41","start":230.15,"end":233.29,"text":"誰にも負けたくないんだ (負けたくないんだ)","translation":"","kind":"lyric"},{"id":"42","start":233.29,"end":236.3,"text":"そんな熱よどうか (熱よどうか)","translation":"","kind":"lyric"},{"id":"43","start":236.3,"end":241.98,"text":"消えてなくなるな！","translation":"","kind":"lyric"},{"id":"44","start":241.98,"end":246.81,"text":"らしさ そんなものを抱えては","translation":"","kind":"lyric"},{"id":"45","start":246.81,"end":253.55,"text":"僕らは泣いてた 笑ってた 競い合ったまま","translation":"","kind":"lyric"},{"id":"46","start":253.55,"end":258.65,"text":"大好きな事に全て捧げては","translation":"","kind":"lyric"},{"id":"47","start":258.65,"end":262.96,"text":"まだまだ泣くんだ 笑うんだ","translation":"","kind":"lyric"},{"id":"48","start":262.96,"end":268.1,"text":"位置についたなら さあ、本気で勝負だ","translation":"","kind":"lyric"},{"id":"49","start":268.1,"end":273.78,"text":"らしさ そんなものを抱えては","translation":"","kind":"lyric"},{"id":"50","start":273.78,"end":277.79,"text":"喜び悲しみ 不安期待 絶望絶頂","translation":"","kind":"lyric"},{"id":"51","start":277.79,"end":279.7,"text":"君と僕のものだよ全部","translation":"","kind":"lyric"},{"id":"52","start":279.7,"end":283.92,"text":"らしさ そんなものを抱えては","translation":"","kind":"lyric"},{"id":"53","start":283.92,"end":289.13,"text":"ああ 息絶えるまで泣くんだ 笑うんだ","translation":"","kind":"lyric"},{"id":"54","start":289.13,"end":291.47,"text":"「本当に良かった」","translation":"","kind":"lyric"},{"id":"55","start":291.47,"end":300.5,"text":"ああ 生きてて良かったな","translation":"","kind":"lyric"}],"candidates":[]}