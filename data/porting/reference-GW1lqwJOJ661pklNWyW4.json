{"title":"Prince Ali","artist":"Aladin","sourceId":"reference:GW1lqwJOJ661pklNWyW4","sourceHash":"800f89ad8315968c2edc3a7ddb83a95557a916bc9bca99f804a522ed0db132ab","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":33527085,"cues":[{"id":"1","start":13.89,"end":15.79,"text":"Make way","translation":"","kind":"lyric"},{"id":"2","start":15.79,"end":19.19,"text":"For Prince Ali!","translation":"","kind":"lyric"},{"id":"3","start":19.19,"end":21.26,"text":"Say: \"Hey!","translation":"","kind":"lyric"},{"id":"4","start":21.26,"end":24.86,"text":"It's Prince Ali!\"","translation":"","kind":"lyric"},{"id":"5","start":24.86,"end":27.33,"text":"Hey clear the way in the ol' bazaar","translation":"","kind":"lyric"},{"id":"6","start":27.33,"end":28.64,"text":"Hey you! Let us through-","translation":"","kind":"lyric"},{"id":"7","start":28.64,"end":29.74,"text":"It's a bright new star","translation":"","kind":"lyric"},{"id":"8","start":29.74,"end":35.02,"text":"Oh come be the first on your block to meet his eye!","translation":"","kind":"lyric"},{"id":"9","start":35.02,"end":36.37,"text":"Make way! Here he comes!","translation":"","kind":"lyric"},{"id":"10","start":36.37,"end":37.58,"text":"Ring bells! Bang the drums!","translation":"","kind":"lyric"},{"id":"11","start":37.58,"end":39.7,"text":"Ah! You're gonna love this guy!","translation":"","kind":"lyric"},{"id":"12","start":39.7,"end":44.54,"text":"Prince Ali - fabulous he - Ali Ababwa","translation":"","kind":"lyric"},{"id":"13","start":44.54,"end":46.8,"text":"Genuflect, show some respect:","translation":"","kind":"lyric"},{"id":"14","start":46.8,"end":49.87,"text":"Down on one knee.","translation":"","kind":"lyric"},{"id":"15","start":49.87,"end":51.96,"text":"Now try your best to stay calm","translation":"","kind":"lyric"},{"id":"16","start":51.96,"end":54.37,"text":"Brush off your sunday salaam","translation":"","kind":"lyric"},{"id":"17","start":54.37,"end":58.97,"text":"Then come and meet his spectacular coterie!","translation":"","kind":"lyric"},{"id":"18","start":58.97,"end":63.63,"text":"Prince Ali - mighty is he - Ali Ababwa","translation":"","kind":"lyric"},{"id":"19","start":63.63,"end":68.6,"text":"Strong as ten regular men definitely","translation":"","kind":"lyric"},{"id":"20","start":68.6,"end":70.84,"text":"He faced the galloping hordes!","translation":"","kind":"lyric"},{"id":"21","start":70.84,"end":73.1,"text":"A hundred bad guys with swords!","translation":"","kind":"lyric"},{"id":"22","start":73.1,"end":75.12,"text":"Who sent those goons to their lords?","translation":"","kind":"lyric"},{"id":"23","start":75.12,"end":77.03,"text":"Why- Prince Ali!","translation":"","kind":"lyric"},{"id":"24","start":77.03,"end":77.44,"text":"(Men)","translation":"","kind":"lyric"},{"id":"25","start":77.44,"end":80.75,"text":"He's got seventy-five golden camels","translation":"","kind":"lyric"},{"id":"26","start":80.75,"end":81.91,"text":"(Don't they look lovely June?)","translation":"","kind":"lyric"},{"id":"27","start":81.91,"end":82.46000000000001,"text":"(Girls)","translation":"","kind":"lyric"},{"id":"28","start":82.46000000000001,"end":85.08,"text":"Purple peacocks he's got fifty-three!","translation":"","kind":"lyric"},{"id":"29","start":85.08,"end":86.66,"text":"(Fabulous Harry, I love the feathers)","translation":"","kind":"lyric"},{"id":"30","start":86.66,"end":91.59,"text":"When it comes to exotic type mammals...","translation":"","kind":"lyric"},{"id":"31","start":91.59,"end":92.77000000000001,"text":"Has he gotta zoo-","translation":"","kind":"lyric"},{"id":"32","start":92.77000000000001,"end":93.65,"text":"I'm tellin' you!","translation":"","kind":"lyric"},{"id":"33","start":93.65,"end":95.88,"text":"It's a world class menagerie!","translation":"","kind":"lyric"},{"id":"34","start":95.88,"end":100.44,"text":"Prince Ali - handsome as he - Ali Ababwa","translation":"","kind":"lyric"},{"id":"35","start":100.44,"end":105.52000000000001,"text":"That physique! How can I speak? Weak at the knee...","translation":"","kind":"lyric"},{"id":"36","start":105.52000000000001,"end":107.62,"text":"Well get on out in that square","translation":"","kind":"lyric"},{"id":"37","start":107.62,"end":109.97999999999999,"text":"Adjust your veil and prepare","translation":"","kind":"lyric"},{"id":"38","start":109.97999999999999,"end":114.37,"text":"To gawk and grovel and stare at Prince Ali!","translation":"","kind":"lyric"},{"id":"39","start":114.37,"end":117.03999999999999,"text":"He's got ninety-five white Persian monkeys","translation":"","kind":"lyric"},{"id":"40","start":117.03999999999999,"end":118.06,"text":"He's got the monkeys!","translation":"","kind":"lyric"},{"id":"41","start":118.06,"end":118.75,"text":"Lets see the monkeys!","translation":"","kind":"lyric"},{"id":"42","start":118.75,"end":121.34,"text":"And to view them he charges no fee!","translation":"","kind":"lyric"},{"id":"43","start":121.34,"end":123.0,"text":"(He's generous! So generous!)","translation":"","kind":"lyric"},{"id":"44","start":123.0,"end":126.66,"text":"He's got slaves, he's got servants and flunkies.","translation":"","kind":"lyric"},{"id":"45","start":126.66,"end":127.61,"text":"Proud to work for him-","translation":"","kind":"lyric"},{"id":"46","start":127.61,"end":128.77,"text":"They bow to his whim-","translation":"","kind":"lyric"},{"id":"47","start":128.77,"end":129.53,"text":"Love serving him!","translation":"","kind":"lyric"},{"id":"48","start":129.53,"end":131.78,"text":"They're just lousy with loyalty","translation":"","kind":"lyric"},{"id":"49","start":131.78,"end":133.62,"text":"To Ali!","translation":"","kind":"lyric"},{"id":"50","start":133.62,"end":136.34,"text":"Prince Ali!","translation":"","kind":"lyric"},{"id":"51","start":136.34,"end":143.23,"text":"Prince Ali - glamorous he - Ali Ababwa!","translation":"","kind":"lyric"},{"id":"52","start":143.23,"end":147.62,"text":"Heard your princess was a sight lovely to see.","translation":"","kind":"lyric"},{"id":"53","start":147.62,"end":149.77,"text":"And that good people is why-","translation":"","kind":"lyric"},{"id":"54","start":149.77,"end":151.97,"text":"He got dolled up and dropped by!","translation":"","kind":"lyric"},{"id":"55","start":151.97,"end":153.05,"text":"With sixty elephants","translation":"","kind":"lyric"},{"id":"56","start":153.05,"end":153.82,"text":"Llamas galore","translation":"","kind":"lyric"},{"id":"57","start":153.82,"end":155.07,"text":"With his bears and lions","translation":"","kind":"lyric"},{"id":"58","start":155.07,"end":156.02,"text":"A brass band and more!","translation":"","kind":"lyric"},{"id":"59","start":156.02,"end":158.09,"text":"With forty fakirs, his cooks and bakers","translation":"","kind":"lyric"},{"id":"60","start":158.09,"end":159.53,"text":"And birds that warble on key!","translation":"","kind":"lyric"},{"id":"61","start":159.53,"end":161.82,"text":"Make way!","translation":"","kind":"lyric"},{"id":"62","start":161.82,"end":167.87,"text":"For Prince Ali!","translation":"","kind":"lyric"}],"candidates":[]}