{"title":"The Next Right Thing","artist":"Frozen","sourceId":"reference:aCFpQik34nm9rXRXztiM","sourceHash":"c9c4279be33a9ec57f2f33d4f868192727d411eddbed1fe6d6edfbd672796b16","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":15.98,"end":18.54,"text":"I've seen dark before","translation":"","kind":"lyric"},{"id":"2","start":18.54,"end":21.48,"text":"But not like this","translation":"","kind":"lyric"},{"id":"3","start":21.48,"end":23.04,"text":"This is cold","translation":"","kind":"lyric"},{"id":"4","start":23.04,"end":24.44,"text":"This is empty","translation":"","kind":"lyric"},{"id":"5","start":24.44,"end":27.29,"text":"This is numb","translation":"","kind":"lyric"},{"id":"6","start":27.29,"end":29.99,"text":"The life I knew is over","translation":"","kind":"lyric"},{"id":"7","start":29.99,"end":32.35,"text":"The lights are out","translation":"","kind":"lyric"},{"id":"8","start":32.35,"end":34.24,"text":"Hello, darkness","translation":"","kind":"lyric"},{"id":"9","start":34.24,"end":37.24,"text":"I'm ready to succumb","translation":"","kind":"lyric"},{"id":"10","start":38.91,"end":41.73,"text":"I follow you around","translation":"","kind":"lyric"},{"id":"11","start":41.73,"end":43.86,"text":"I always have","translation":"","kind":"lyric"},{"id":"12","start":43.86,"end":46.86,"text":"But you've gone to a place I cannot find","translation":"","kind":"lyric"},{"id":"13","start":49.75,"end":52.75,"text":"This grief has a gravity","translation":"","kind":"lyric"},{"id":"14","start":53.55,"end":56.55,"text":"It pulls me down","translation":"","kind":"lyric"},{"id":"15","start":60.1,"end":63.1,"text":"But a tiny voice whispers in my mind","translation":"","kind":"lyric"},{"id":"16","start":68.26,"end":71.26,"text":"\"You are lost, hope is gone","translation":"","kind":"lyric"},{"id":"17","start":73.3,"end":76.3,"text":"But you must go on","translation":"","kind":"lyric"},{"id":"18","start":79.09,"end":82.09,"text":"And do the next right thing\"","translation":"","kind":"lyric"},{"id":"19","start":90.86,"end":93.86,"text":"Can there be a day beyond this night?","translation":"","kind":"lyric"},{"id":"20","start":95.58,"end":98.58,"text":"I don't know anymore what is true","translation":"","kind":"lyric"},{"id":"21","start":100.27000000000001,"end":103.27000000000001,"text":"I can't find my direction, I'm all alone","translation":"","kind":"lyric"},{"id":"22","start":104.92,"end":107.92,"text":"The only star that guided me was you","translation":"","kind":"lyric"},{"id":"23","start":111.42,"end":114.42,"text":"How to rise from the floor","translation":"","kind":"lyric"},{"id":"24","start":115.87,"end":118.87,"text":"When it's not you I'm rising for?","translation":"","kind":"lyric"},{"id":"25","start":120.66,"end":123.66,"text":"Just do the next right thing","translation":"","kind":"lyric"},{"id":"26","start":125.34,"end":128.34,"text":"Take a step, step again","translation":"","kind":"lyric"},{"id":"27","start":129.97,"end":132.97,"text":"It is all that I can to do","translation":"","kind":"lyric"},{"id":"28","start":136.81,"end":139.81,"text":"The next right thing","translation":"","kind":"lyric"},{"id":"29","start":142.26,"end":145.26,"text":"I won't look too far ahead","translation":"","kind":"lyric"},{"id":"30","start":146.57999999999998,"end":149.57999999999998,"text":"It's too much for me to take","translation":"","kind":"lyric"},{"id":"31","start":150.36,"end":153.36,"text":"But break it down to this next breath","translation":"","kind":"lyric"},{"id":"32","start":153.85,"end":156.03,"text":"This next step","translation":"","kind":"lyric"},{"id":"33","start":156.03,"end":159.03,"text":"This next choice is one that I can make","translation":"","kind":"lyric"},{"id":"34","start":162.74,"end":165.74,"text":"So I'll walk through this night","translation":"","kind":"lyric"},{"id":"35","start":166.9,"end":169.9,"text":"Stumbling blindly toward the light","translation":"","kind":"lyric"},{"id":"36","start":172.07999999999998,"end":175.07999999999998,"text":"And do the next right thing","translation":"","kind":"lyric"},{"id":"37","start":177.14,"end":180.14,"text":"And with the dawn, what comes then?","translation":"","kind":"lyric"},{"id":"38","start":181.89,"end":184.89,"text":"When it's clear that everything will never be the same again","translation":"","kind":"lyric"},{"id":"39","start":191.13,"end":194.13,"text":"Then I'll make the choice","translation":"","kind":"lyric"},{"id":"40","start":194.58,"end":197.58,"text":"To hear that voice","translation":"","kind":"lyric"},{"id":"41","start":197.91,"end":200.91,"text":"And do the next right thing","translation":"","kind":"lyric"}],"candidates":[]}