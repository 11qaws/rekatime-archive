{"title":"Ark","artist":"Sound Horizon","sourceId":"reference:0Kuwie6ZpvLDisLoRA0b","sourceHash":"b061bfc3e9a3badae498ccf631c490089848248349261c51908d0d45d49c99ce","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":0.57,"end":1.09,"text":"「彼女こそ","translation":"","kind":"lyric"},{"id":"2","start":1.09,"end":2.56,"text":"私のエリスなのだろうか」","translation":"","kind":"lyric"},{"id":"3","start":2.56,"end":5.5600000000000005,"text":"「箱庭を騙る檻の中で","translation":"","kind":"lyric"},{"id":"4","start":10.59,"end":13.59,"text":"禁断の海馬に手を加えて","translation":"","kind":"lyric"},{"id":"5","start":19.18,"end":22.18,"text":"驕れる無能な創造神にでも","translation":"","kind":"lyric"},{"id":"6","start":26.55,"end":29.55,"text":"成った心算なの」","translation":"","kind":"lyric"},{"id":"7","start":34.18,"end":37.18,"text":"Love wishing to the \"Ark\"","translation":"","kind":"lyric"},{"id":"8","start":37.55,"end":38.33,"text":"崩壊","translation":"","kind":"lyric"},{"id":"9","start":38.33,"end":40.33,"text":"其れは孕み続けた季節","translation":"","kind":"lyric"},{"id":"10","start":40.33,"end":42.19,"text":"二月の雪の日","translation":"","kind":"lyric"},{"id":"11","start":42.19,"end":43.67,"text":"『妹』(Soror)の記憶","translation":"","kind":"lyric"},{"id":"12","start":43.67,"end":46.67,"text":"「我々を楽園へ導ける箱舟は","translation":"","kind":"lyric"},{"id":"13","start":47.65,"end":50.65,"text":"哀れなる魂を大地から解き放つ","translation":"","kind":"lyric"},{"id":"14","start":51.37,"end":54.37,"text":"救いを求める貴女にArkを与えよう」","translation":"","kind":"lyric"},{"id":"15","start":55.16,"end":56.94,"text":"《Arkと呼ばれた物》(それ)は月光を受けて","translation":"","kind":"lyric"},{"id":"16","start":56.94,"end":58.81,"text":"銀色に煌いた","translation":"","kind":"lyric"},{"id":"17","start":58.81,"end":61.81,"text":"想い出まで裏切った","translation":"","kind":"lyric"},{"id":"18","start":62.36,"end":65.36,"text":"冷たい言葉の雨","translation":"","kind":"lyric"},{"id":"19","start":66.31,"end":69.31,"text":"幸せだった二人 永遠に","translation":"","kind":"lyric"},{"id":"20","start":69.97,"end":72.97,"text":"届かなくなる前に","translation":"","kind":"lyric"},{"id":"21","start":74.34,"end":75.69,"text":"「ねぇ... 何故","translation":"","kind":"lyric"},{"id":"22","start":75.69,"end":77.92,"text":"変わってしまったの？","translation":"","kind":"lyric"},{"id":"23","start":77.92,"end":80.92,"text":"あんなにも愛し合っていたのに」","translation":"","kind":"lyric"},{"id":"24","start":82.24,"end":85.24,"text":"涙を微笑み(えみ)に換え詰め寄る","translation":"","kind":"lyric"},{"id":"25","start":85.92,"end":88.92,"text":"《Arkと呼ばれた物》(Knife)を握って","translation":"","kind":"lyric"},{"id":"26","start":89.62,"end":92.62,"text":"愛憎の箱舟(Ark)","translation":"","kind":"lyric"},{"id":"27","start":93.96000000000001,"end":96.96000000000001,"text":"「さぁ 楽園へ還りましょう、お兄様」","translation":"","kind":"lyric"},{"id":"28","start":109.37,"end":109.75,"text":"因果","translation":"","kind":"lyric"},{"id":"29","start":109.75,"end":112.02000000000001,"text":"其れは手繰り寄せた糸","translation":"","kind":"lyric"},{"id":"30","start":112.02000000000001,"end":113.78,"text":"六月の雨の日","translation":"","kind":"lyric"},{"id":"31","start":113.78,"end":115.63,"text":"『兄』(Frater)の記憶","translation":"","kind":"lyric"},{"id":"32","start":115.63,"end":117.39,"text":"信じてたその人に","translation":"","kind":"lyric"},{"id":"33","start":117.39,"end":119.03999999999999,"text":"裏切られた少女","translation":"","kind":"lyric"},{"id":"34","start":119.03999999999999,"end":120.72,"text":"逃げ込んだ楽園は","translation":"","kind":"lyric"},{"id":"35","start":120.72,"end":122.77,"text":"信仰という狂気","translation":"","kind":"lyric"},{"id":"36","start":122.77,"end":124.8,"text":"新しい世界へと","translation":"","kind":"lyric"},{"id":"37","start":124.8,"end":126.61,"text":"羽ばたける自己暗示","translation":"","kind":"lyric"},{"id":"38","start":126.61,"end":128.32,"text":"澄み渡る覚醒は","translation":"","kind":"lyric"},{"id":"39","start":128.32,"end":130.32,"text":"進行という凶器","translation":"","kind":"lyric"},{"id":"40","start":130.32,"end":133.32,"text":"最期の瞬間に廻った","translation":"","kind":"lyric"},{"id":"41","start":133.83,"end":136.83,"text":"歪な愛の記憶","translation":"","kind":"lyric"},{"id":"42","start":137.61,"end":140.61,"text":"脆弱な精神が堪えきれず","translation":"","kind":"lyric"},{"id":"43","start":141.39,"end":144.39,"text":"あの日嘘を吐いた...","translation":"","kind":"lyric"},{"id":"44","start":145.17000000000002,"end":148.17000000000002,"text":"律すれば律する程堕ちる","translation":"","kind":"lyric"},{"id":"45","start":149.37,"end":152.37,"text":"赦されぬ想いに灼かれながら","translation":"","kind":"lyric"},{"id":"46","start":153.64,"end":156.64,"text":"まぐわう傷は深く甘く","translation":"","kind":"lyric"},{"id":"47","start":157.11,"end":160.11,"text":"破滅へ誘う...","translation":"","kind":"lyric"},{"id":"48","start":161.17000000000002,"end":164.17000000000002,"text":"背徳の箱舟(Ark)","translation":"","kind":"lyric"},{"id":"49","start":165.41,"end":168.41,"text":"「さぁ... 楽園へ還りましょう、お兄様...」","translation":"","kind":"lyric"},{"id":"50","start":179.72,"end":181.85,"text":"被験体＃1096","translation":"","kind":"lyric"},{"id":"51","start":181.85,"end":182.84,"text":"通称『妹』(Soror)","translation":"","kind":"lyric"},{"id":"52","start":182.84,"end":185.71,"text":"同じく被験体＃1076","translation":"","kind":"lyric"},{"id":"53","start":185.71,"end":187.46,"text":"通称『兄』(Frater)を殺害","translation":"","kind":"lyric"},{"id":"54","start":187.46,"end":189.19,"text":"＜症例番号(Case Number)12＞","translation":"","kind":"lyric"},{"id":"55","start":189.19,"end":190.93,"text":"過剰投影型依存における","translation":"","kind":"lyric"},{"id":"56","start":190.93,"end":192.77,"text":"袋小路の模型(Model)","translation":"","kind":"lyric"},{"id":"57","start":192.77,"end":193.46,"text":"即ち","translation":"","kind":"lyric"},{"id":"58","start":193.46,"end":194.2,"text":"《虚妄型箱舟依存症候群》(Ark)","translation":"","kind":"lyric"},{"id":"59","start":194.2,"end":197.2,"text":"限りなく","translation":"","kind":"lyric"},{"id":"60","start":197.43,"end":200.43,"text":"同一に近づける","translation":"","kind":"lyric"},{"id":"61","start":20