{"title":"Monster","artist":"Beth Crowley","sourceId":"reference:LbgaWhv6XUi9uFxBEPdo","sourceHash":"ab4788786ae8cad78e0dcaf2d528778b494785085112553bc404c3f22f29d38f","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":4183447,"cues":[{"id":"1","start":17.95,"end":20.77,"text":"I sleep all day, I prowl at night","translation":"","kind":"lyric"},{"id":"2","start":20.77,"end":24.05,"text":"Do anything to feel alive","translation":"","kind":"lyric"},{"id":"3","start":24.05,"end":29.89,"text":"I'm in the end, just what you made me","translation":"","kind":"lyric"},{"id":"4","start":29.89,"end":33.18,"text":"I look the same but I'm not fine","translation":"","kind":"lyric"},{"id":"5","start":33.18,"end":36.23,"text":"The master of my own disguise","translation":"","kind":"lyric"},{"id":"6","start":36.23,"end":42.56,"text":"If you knew the truth, you'd probably hate me","translation":"","kind":"lyric"},{"id":"7","start":42.56,"end":44.6,"text":"I need a fight","translation":"","kind":"lyric"},{"id":"8","start":44.6,"end":47.77,"text":"I've got you in my sights","translation":"","kind":"lyric"},{"id":"9","start":47.77,"end":53.28,"text":"Only one of us will make it out alive","translation":"","kind":"lyric"},{"id":"10","start":53.28,"end":55.51,"text":"I'm turning into a monster","translation":"","kind":"lyric"},{"id":"11","start":55.51,"end":59.57,"text":"You better run and hide","translation":"","kind":"lyric"},{"id":"12","start":59.57,"end":61.6,"text":"Turning into a monster","translation":"","kind":"lyric"},{"id":"13","start":61.6,"end":66.35,"text":"Right before your eyes","translation":"","kind":"lyric"},{"id":"14","start":66.35,"end":69.44,"text":"My tongue is a weapon, and I'm locked and loaded","translation":"","kind":"lyric"},{"id":"15","start":69.44,"end":73.76,"text":"When you least expect it, you won't know it's coming","translation":"","kind":"lyric"},{"id":"16","start":73.76,"end":75.38,"text":"And I'll strike","translation":"","kind":"lyric"},{"id":"17","start":75.38,"end":81.88,"text":"'Cause I am a monster","translation":"","kind":"lyric"},{"id":"18","start":81.88,"end":83.24,"text":"I'm merciless","translation":"","kind":"lyric"},{"id":"19","start":83.24,"end":84.77,"text":"When will you learn?","translation":"","kind":"lyric"},{"id":"20","start":84.77,"end":87.97,"text":"Set fires just to watch them burn","translation":"","kind":"lyric"},{"id":"21","start":87.97,"end":93.97999999999999,"text":"I bet you never saw me coming","translation":"","kind":"lyric"},{"id":"22","start":93.97999999999999,"end":96.93,"text":"Delirium takes over me","translation":"","kind":"lyric"},{"id":"23","start":96.93,"end":100.13,"text":"You're just another casualty","translation":"","kind":"lyric"},{"id":"24","start":100.13,"end":106.18,"text":"I can hear your heartbeat drummin'","translation":"","kind":"lyric"},{"id":"25","start":106.18,"end":108.46000000000001,"text":"I need a fight","translation":"","kind":"lyric"},{"id":"26","start":108.46000000000001,"end":111.42,"text":"I've got you in my sights","translation":"","kind":"lyric"},{"id":"27","start":111.42,"end":116.77000000000001,"text":"Only one of us will make it out alive","translation":"","kind":"lyric"},{"id":"28","start":116.77000000000001,"end":119.22,"text":"I'm turning into a monster","translation":"","kind":"lyric"},{"id":"29","start":119.22,"end":123.06,"text":"You better run and hide","translation":"","kind":"lyric"},{"id":"30","start":123.06,"end":125.2,"text":"Turning into a monster","translation":"","kind":"lyric"},{"id":"31","start":125.2,"end":130.27,"text":"Right before your eyes","translation":"","kind":"lyric"},{"id":"32","start":130.27,"end":133.43,"text":"My tongue is a weapon, and I'm locked and loaded","translation":"","kind":"lyric"},{"id":"33","start":133.43,"end":137.66,"text":"When you least expect it, you won't know it's coming","translation":"","kind":"lyric"},{"id":"34","start":137.66,"end":139.16,"text":"And I'll strike","translation":"","kind":"lyric"},{"id":"35","start":139.16,"end":140.95,"text":"'Cause I am a monster","translation":"","kind":"lyric"},{"id":"36","start":164.81,"end":168.2,"text":"I'm turning into a monster","translation":"","kind":"lyric"},{"id":"37","start":168.2,"end":171.53,"text":"You better run and hide","translation":"","kind":"lyric"},{"id":"38","start":171.53,"end":174.22,"text":"Turning into a monster","translation":"","kind":"lyric"},{"id":"39","start":174.22,"end":178.77,"text":"Right before your eyes","translation":"","kind":"lyric"},{"id":"40","start":178.77,"end":182.02,"text":"My tongue is a weapon, and I'm locked and loaded","translation":"","kind":"lyric"},{"id":"41","start":182.02,"end":186.03,"text":"When you last expect it, you won't know it's coming","translation":"","kind":"lyric"},{"id":"42","start":186.03,"end":187.84,"text":"And I'll strike","translation":"","kind":"lyric"},{"id":"43","start":187.84,"end":193.73,"text":"'Cause I am a monster","translation":"","kind":"lyric"},{"id":"44","start":193.73,"end":196.09,"text":"I'm a monster","translation":"","kind":"lyric"}],"candidates":[]}