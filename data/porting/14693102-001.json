{"originalLanguage":"ja","title":"17살의 노래","artist":"『ユイカ』","date":"2026-08-14","sourceId":"14693102:001","sourceHash":"b419a25b333ebbde2e976cc03cdb08628a87ad935ad5c23cc9c7a8bb482165f7","duration":314.2,"cues":[{"id":"1","start":32.7,"end":38.78,"text":"こんな私の未熟なうたを","translation":"이런 나의 서툰 노래를","kind":"lyric"},{"id":"2","start":38.9,"end":44.36,"text":"聴いてくれてどうも有難うね。","translation":"들어 줘서 정말 고마워","kind":"lyric"},{"id":"3","start":44.86,"end":50.58,"text":"もう少しで私は未熟な大人に","translation":"이제 조금만 있으면 나는 서툰 어른이","kind":"lyric"},{"id":"4","start":50.58,"end":53.48,"text":"なるみたいです。","translation":"되는 모양이야","kind":"lyric"},{"id":"5","start":53.48,"end":56.2,"text":"なんか笑っちゃうね。","translation":"왠지 웃기지","kind":"lyric"},{"id":"6","start":56.9,"end":58.32,"text":"本当はね、","translation":"사실은","kind":"lyric"},{"id":"7","start":58.32,"end":62.3,"text":"もっと前を向けるようなうたを","translation":"좀 더 앞을 볼 수 있는 노래를","kind":"lyric"},{"id":"8","start":63.28,"end":66.18,"text":"書くつもりだったけど、","translation":"쓰려고 했는데","kind":"lyric"},{"id":"9","start":66.32,"end":68.3,"text":"書けなくて。","translation":"쓰지 못했어","kind":"lyric"},{"id":"10","start":68.9,"end":70.34,"text":"私はまだ、","translation":"나는 아직","kind":"lyric"},{"id":"11","start":70.34,"end":74.22,"text":"他の誰かを支えられるほど","translation":"다른 누군가를 떠받칠 만큼","kind":"lyric"},{"id":"12","start":75.04,"end":77.16,"text":"強くなかったみたい。","translation":"강하지 않았나 봐","kind":"lyric"},{"id":"13","start":77.16,"end":83.97,"text":"ごめんね。","translation":"미안해","kind":"lyric"},{"id":"14","start":83.97,"end":84.89,"text":"拝啓、未来の私へ。","translation":"미래의 나에게","kind":"lyric"},{"id":"15","start":84.89,"end":87.25,"text":"今そこで","translation":"지금 그곳에서","kind":"lyric"},{"id":"16","start":87.25,"end":90.56,"text":"どんなことをして","translation":"어떤 일을 하며","kind":"lyric"},{"id":"17","start":90.56,"end":95.86,"text":"生きていますか。","translation":"살아가고 있니","kind":"lyric"},{"id":"18","start":95.86,"end":96.92,"text":"拝啓、今の私へ。","translation":"지금의 나에게","kind":"lyric"},{"id":"19","start":96.92,"end":98.82,"text":"今ここで","translation":"지금 여기서","kind":"lyric"},{"id":"20","start":99.9,"end":102.9,"text":"どんなことをしたら","translation":"무엇을 해야","kind":"lyric"},{"id":"21","start":102.9,"end":106.4,"text":"生きていけるんでしょうか。","translation":"살아갈 수 있을까","kind":"lyric"},{"id":"22","start":117.36,"end":121.66,"text":"“好きだからかっこいい”とか","translation":"좋아하니까 멋지다느니","kind":"lyric"},{"id":"23","start":122.1,"end":123.72,"text":"“そばにいる”とか","translation":"곁에 있다느니","kind":"lyric"},{"id":"24","start":123.86,"end":127.3,"text":"“勝手に盗んだ”とか","translation":"멋대로 훔쳤다느니","kind":"lyric"},{"id":"25","start":127.3,"end":129.36,"text":"書いてた。","translation":"쓰곤 했어","kind":"lyric"},{"id":"26","start":129.36,"end":133.44,"text":"“どうせだったらもうちょっと”","translation":"이왕이면 조금만 더","kind":"lyric"},{"id":"27","start":134.3,"end":135.74,"text":"貴方みたいに","translation":"너처럼","kind":"lyric"},{"id":"28","start":137.02,"end":140.86,"text":"やさしいうたを書けばよかったね。","translation":"다정한 노래를 쓸 걸 그랬지","kind":"lyric"},{"id":"29","start":142.56,"end":143.8,"text":"本当はね、","translation":"사실은","kind":"lyric"},{"id":"30","start":143.8,"end":147.42,"text":"好きなことだけして生きたいの。","translation":"좋아하는 일만 하며 살고 싶어","kind":"lyric"},{"id":"31","start":147.42,"end":149.16,"text":"でもそれは","translation":"하지만 그건","kind":"lyric"},{"id":"32","start":149.16,"end":153.38,"text":"上手な生き方とは言えないから。","translation":"잘 살아가는 법이라 할 수 없으니까","kind":"lyric"},{"id":"33","start":153.38,"end":155.84,"text":"無駄になっても、","translation":"헛일이 되어도","kind":"lyric"},{"id":"34","start":155.84,"end":157.34,"text":"意味がなくても、","translation":"의미가 없어도","kind":"lyric"},{"id":"35","start":157.34,"end":159.32,"text":"今はここから","translation":"지금은 여기서","kind":"lyric"},{"id":"36","start":159.32,"end":163.71,"text":"離れなきゃいけないの。","translation":"떠나야만 해","kind":"lyric"},{"id":"37","start":163.71,"end":166.32,"text":"ごめんね。","translation":"미안해","kind":"lyric"},{"id":"38","start":167.3,"end":169.04,"text":"拝啓、未来の私へ。","translation":"미래의 나에게","kind":"lyric"},{"id":"39","start":169.04,"end":171.7,"text":"今そこで","translation":"지금 그곳에서","kind":"lyric"},{"id":"40","start":171.94,"end":174.82,"text":"どんな大人になって","translation":"어떤 어른이 되어","kind":"lyric"},{"id":"41","start":174.82,"end":177.82,"text":"生きていますか。","translation":"살아가고 있니","kind":"lyric"},{"id":"42","start":179.26,"end":181.08,"text":"拝啓、今の私へ。","translation":"지금의 나에게","kind":"lyric"},{"id":"43","start":181.08,"end":183.88,"text":"今ここで","translation":"지금 여기서","kind":"lyric"},{"id":"44","start":184.02,"end":187.36,"text":"どんな大人になりたいと","translation":"어떤 어른이 되고 싶다고","kind":"lyric"},{"id":"45","start":187.36,"end":189.94,"text":"言えばいいんでしょうか。","translation":"말해야 할까","kind":"lyric"},{"id":"46","start":189.94,"end":191.3,"text":"「さよなら。」","translation":"안녕","kind":"lyric"},{"id":"47","start":191.3,"end":195.78,"text":"は悲しくなるからさ、","translation":"은 슬퍼지니까","kind":"lyric"},{"id":"48","start":196.1,"end":198.38,"text":"「またね。」","translation":"또 보자","kind":"lyric"},{"id":"49","start":198.38,"end":201.12,"text":"って言わせて。","translation":"라고 말하게 해 줘","kind":"lyric"},{"id":"50","start":201.12,"end":204.92,"text":"いつか私が","translation":"언젠가 내가","kind":"lyric"},{"id":"51","start":204.92,"end":207.4,"text":"今みたいな","translation":"지금 같은","kind":"lyric"},{"id":"52","start":207.4,"end":211.22,"text":"うたを書けなくなっても、","translation":"노래를 쓸 수 없게 되어도","kind":"lyric"},{"id":"53","start":211.56,"end":213.86,"text":"怒らないでね。","translation":"화내지 말아 줘","kind":"lyric"},{"id":"54","start":216.88,"end":218.48,"text":"拝啓、過去の私へ。","translation":"과거의 나에게","kind":"lyric"},{"id":"55","start":218.48,"end":220.32,"text":"今の私は","translation":"지금의 나는","kind":"lyric"},{"id":"56","start":221.2,"end":224.76,"text":"ずっと夢見ていたこと","translation":"줄곧 꿈꾸던 일을","kind":"lyric"},{"id":"57","start":224.76,"end":227.32,"text":"叶えてるよ。","translation":"이루고 있어","kind":"lyric"},{"id":"58","start":228.82,"end":230.42,"text":"拝啓、今の私へ。","translation":"지금의 나에게","kind":"lyric"},{"id":"59","start":230.42,"end":232.98,"text":"こんな情けない","translation":"이렇게 한심한","kind":"lyric"},{"id":"60","start":232.98,"end":236.36,"text":"うただって歌えばいいよ","translation":"노래라도 부르면 돼","kind":"lyric"},{"id":"61","start":236.36,"end":239.08,"text":"それが私だから。","translation":"그게 나니까","kind":"lyric"},{"id":"62","start":240.78,"end":242.58,"text":"拝啓、未来の私へ。","translation":"미래의 나에게","kind":"lyric"},{"id":"63","start":242.58,"end":244.94,"text":"今そこは","translation":"지금 그곳에는","kind":"lyric"},{"id":"64","start":244.94,"end":248.26,"text":"どんな綺麗な世界が","translation":"어떤 아름다운 세상이","kind":"lyric"},{"id":"65","start":249.72,"end":251.38,"text":"広がっていますか。","translation":"펼쳐져 있니","kind":"lyric"},{"id":"66","start":252.72,"end":254.5,"text":"拝啓、今の私へ。","translation":"지금의 나에게","kind":"lyric"},{"id":"67","start":254.5,"end":256.5,"text":"今ここが","translation":"지금 이곳이","kind":"lyric"},{"id":"68","start":257.32,"end":260.2,"text":"どんな世界よりも","translation":"어느 세상보다도","kind":"lyric"},{"id":"69","start":260.2,"end":262.96,"text":"幸せでした。","translation":"행복했어","kind":"lyric"},{"id":"70","start":286.88,"end":293.54,"text":"こんな私の未熟なうたを","translation":"이런 나의 서툰 노래를","kind":"lyric"},{"id":"71","start":293.69,"end":296.28,"text":"聴いてくれて","translation":"들어 줘서","kind":"lyric"},{"id":"72","start":296.28,"end":298.86,"text":"どうも有難うね。","translation":"정말 고마워","kind":"lyric"},{"id":"73","start":298.86,"end":305.48,"text":"これから私は未熟な大人に","translation":"이제부터 나는 서툰 어른이 될","kind":"lyric"},{"id":"74","start":305.48,"end":308.58,"text":"なる準備をします。","translation":"준비를 할게","kind":"lyric"},{"id":"75","start":308.58,"end":311.16,"text":"「じゃあ、またね。」","translation":"그럼 또 보자","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}