{"originalLanguage":"ja","title":"귀여워서 미안해","artist":"HoneyWorks","date":"2026-09-04","sourceId":"15033796:004","sourceHash":"725ce1614d955d7973692b0a2e49a429832234966ab0cbc889f0594fc67f1fe6","duration":223.3,"cues":[{"id":"1","start":16.1,"end":19.7,"text":"私が私の事を愛して","translation":"내가 나를 사랑하는 게","kind":"lyric"},{"id":"2","start":19.7,"end":22.84,"text":"何が悪いの？嫉妬でしょうか？","translation":"뭐가 잘못이야 질투라도 해","kind":"lyric"},{"id":"3","start":22.84,"end":25.6200000000008,"text":"痛いだとか変わってるとか","translation":"오글거린다느니 별나다느니","kind":"lyric"},{"id":"4","start":25.700000000000728,"end":28.600000000000364,"text":"届きませんね。そのリプライ","translation":"그런 답글은 닿지도 않네","kind":"lyric"},{"id":"5","start":28.68000000000029,"end":30.640000000000327,"text":"大好きなお洋服","translation":"정말 좋아하는 옷","kind":"lyric"},{"id":"6","start":31.74000000000069,"end":33.68000000000029,"text":"大好きなお化粧で","translation":"정말 좋아하는 화장으로","kind":"lyric"},{"id":"7","start":34.720000000001164,"end":38.9,"text":"お決まりのハーフツイン巻いて","translation":"늘 하던 하프 트윈테일에 컬 넣고","kind":"lyric"},{"id":"8","start":38.94,"end":40.20000000000073,"text":"お出かけしよ","translation":"나가 볼까","kind":"lyric"},{"id":"9","start":40.460000000000946,"end":43.340000000001055,"text":"日傘持って ぼっちだって","translation":"양산을 들고 혼자여도","kind":"lyric"},{"id":"10","start":43.460000000000946,"end":46.36000000000058,"text":"幸せだもん！","translation":"행복한걸","kind":"lyric"},{"id":"11","start":46.88000000000102,"end":49.54,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"12","start":49.54,"end":52.48000000000047,"text":"生まれてきちゃってごめん","translation":"태어나 버려서 미안해","kind":"lyric"},{"id":"13","start":52.88000000000102,"end":55.460000000000946,"text":"Chu！ あざとくてごめん","translation":"츄 앙큼해서 미안해","kind":"lyric"},{"id":"14","start":55.52000000000044,"end":58.24000000000069,"text":"気になっちゃうよね？ごめん","translation":"신경 쓰이지 미안해","kind":"lyric"},{"id":"15","start":58.88000000000102,"end":61.44000000000051,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"16","start":61.54000000000087,"end":64.52000000000044,"text":"努力しちゃっててごめん","translation":"노력해 버려서 미안해","kind":"lyric"},{"id":"17","start":64.88000000000102,"end":67.50000000000091,"text":"Chu！ 尊くてごめん","translation":"츄 존귀해서 미안해","kind":"lyric"},{"id":"18","start":67.52000000000044,"end":70.04000000000087,"text":"女子力高くてごめん","translation":"여자력이 넘쳐서 미안해","kind":"lyric"},{"id":"19","start":70.50000000000091,"end":73.78000000000065,"text":"ムカついちゃうよね？ざまあｗ","translation":"열받지 꼴좋다","kind":"lyric"},{"id":"20","start":85.74000000000069,"end":88.90000000000055,"text":"貴女は貴女の事だけどうぞ","translation":"넌 네 일이나 알아서 해","kind":"lyric"},{"id":"21","start":88.94000000000051,"end":92.10000000000036,"text":"私に干渉しないでください","translation":"나한테 참견하지 말아 줘","kind":"lyric"},{"id":"22","start":92.14000000000033,"end":94.82000000000062,"text":"類は友を呼ぶと言うけど…","translation":"끼리끼리 논다지만","kind":"lyric"},{"id":"23","start":94.88000000000102,"end":97.72000000000116,"text":"届きませんね。その陰口","translation":"그런 험담은 닿지도 않네","kind":"lyric"},{"id":"24","start":97.94000000000051,"end":100.2,"text":"重い厚底ブーツ","translation":"묵직한 통굽 부츠","kind":"lyric"},{"id":"25","start":100.96000000000095,"end":103.00000000000091,"text":"お気に入りのリュックで","translation":"아끼는 배낭을 메고","kind":"lyric"},{"id":"26","start":103.88000000000102,"end":107.98000000000047,"text":"崩せない前髪 くしでといて","translation":"앞머리 흐트러지지 않게 빗고","kind":"lyric"},{"id":"27","start":108.22000000000116,"end":109.54000000000087,"text":"お出かけしよ","translation":"나가 볼까","kind":"lyric"},{"id":"28","start":109.68000000000029,"end":112.46000000000095,"text":"軽い女？ふざけんな","translation":"가벼운 여자라고 웃기지 마","kind":"lyric"},{"id":"29","start":112.76000000000113,"end":115.50000000000091,"text":"重すぎるっつーの！","translation":"너무 무겁다니까","kind":"lyric"},{"id":"30","start":116.16000000000076,"end":118.70000000000073,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"31","start":118.72000000000116,"end":121.84000000000106,"text":"この時代生きてごめん","translation":"이 시대를 살아서 미안해","kind":"lyric"},{"id":"32","start":122.10000000000036,"end":124.70000000000073,"text":"Chu！ 目立っててごめん","translation":"츄 눈에 띄어서 미안해","kind":"lyric"},{"id":"33","start":124.76000000000113,"end":127.70000000000073,"text":"意識しちゃうよね？ごめん","translation":"의식하게 되지 미안해","kind":"lyric"},{"id":"34","start":128.04000000000087,"end":130.7400000000007,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"35","start":130.76000000000113,"end":133.84000000000106,"text":"自分磨きしてごめん","translation":"나를 가꿔서 미안해","kind":"lyric"},{"id":"36","start":134.1200000000008,"end":136.70000000000073,"text":"Chu！ ぶりっ子でごめん","translation":"츄 내숭 떨어서 미안해","kind":"lyric"},{"id":"37","start":136.72000000000116,"end":139.60000000000036,"text":"虜にしちゃってごめん","translation":"푹 빠뜨려서 미안해","kind":"lyric"},{"id":"38","start":139.72000000000116,"end":142.70000000000073,"text":"ムカついちゃうでしょ？ざまあｗ","translation":"열받지 꼴좋다","kind":"lyric"},{"id":"39","start":142.85000000000036,"end":144.15000000000055,"text":"趣味の違い","translation":"취향이 다르다고","kind":"lyric"},{"id":"40","start":144.40000000000055,"end":145.7,"text":"変わり者と","translation":"별종이라고","kind":"lyric"},{"id":"41","start":145.7,"end":148.04000000000087,"text":"バカにされても","translation":"비웃음 받아도","kind":"lyric"},{"id":"42","start":148.84000000000106,"end":150.3000000000011,"text":"曲げたくない","translation":"굽히고 싶지 않아","kind":"lyric"},{"id":"43","start":150.40000000000055,"end":151.66000000000076,"text":"怖くもない","translation":"무섭지도 않아","kind":"lyric"},{"id":"44","start":151.6800000000003,"end":154.0000000000009,"text":"あんたらごとき","translation":"너희 따위","kind":"lyric"},{"id":"45","start":154.70000000000073,"end":157.9,"text":"自分の味方は自分でありたい","translation":"내 편은 내가 되어 주고 싶어","kind":"lyric"},{"id":"46","start":157.94,"end":160.88000000000102,"text":"一番大切にしてあげたい","translation":"나를 가장 소중히 아껴 주고 싶어","kind":"lyric"},{"id":"47","start":160.92000000000098,"end":163.86000000000058,"text":"理不尽な我慢はさせたくない","translation":"억울하게 참게 하고 싶진 않아","kind":"lyric"},{"id":"48","start":163.9400000000005,"end":168.90000000000055,"text":"“それが私”","translation":"그게 바로 나야","kind":"lyric"},{"id":"49","start":179.08000000000084,"end":181.6200000000008,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"50","start":181.7400000000007,"end":184.84000000000106,"text":"生まれてきちゃってごめん","translation":"태어나 버려서 미안해","kind":"lyric"},{"id":"51","start":185.1200000000008,"end":188.64000000000033,"text":"Chu！ あざとくてごめん","translation":"츄 앙큼해서 미안해","kind":"lyric"},{"id":"52","start":189.88000000000102,"end":192.98000000000047,"text":"人生楽しんでごめん","translation":"인생을 즐겨서 미안해","kind":"lyric"},{"id":"53","start":193.36000000000058,"end":195.98000000000047,"text":"Chu！ 可愛くてごめん","translation":"츄 귀여워서 미안해","kind":"lyric"},{"id":"54","start":196.0000000000009,"end":198.96000000000095,"text":"努力しちゃっててごめん","translation":"노력해 버려서 미안해","kind":"lyric"},{"id":"55","start":199.32000000000062,"end":201.90000000000055,"text":"Chu！ 尊くてごめん","translation":"츄 존귀해서 미안해","kind":"lyric"},{"id":"56","start":201.9400000000005,"end":204.88000000000102,"text":"女子力高くてごめん","translation":"여자력이 넘쳐서 미안해","kind":"lyric"},{"id":"57","start":204.98000000000047,"end":208.32000000000062,"text":"ムカついちゃうよね？ざまあｗ","translation":"열받지 꼴좋다","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}