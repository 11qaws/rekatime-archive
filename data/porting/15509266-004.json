{"title":"Mela!","artist":"緑黄色社会","date":"2026-10-03","sourceId":"15509266:004","sourceHash":"6057f9b3a5d714b3bde5f051fd7c702324766a6e8826bd0522602da4af11e0f1","duration":244.9,"cues":[{"id":"1","start":4.461,"end":6.786,"text":"今なんじゃない?","translation":"지금 아니겠어","kind":"lyric"},{"id":"2","start":6.846,"end":7.84,"text":"メラメラとたぎれ","translation":"활활 끓어올라","kind":"lyric"},{"id":"3","start":7.9,"end":11.2,"text":"眠っているだけの正義","translation":"그저 잠들어 있는 정의","kind":"lyric"},{"id":"4","start":11.26,"end":17.26,"text":"こんな僕も君のヒーローになりたいのさ (ooh whoa)","translation":"이런 나도 너의 영웅이 되고 싶어","kind":"lyric"},{"id":"5","start":19.324,"end":21.81,"text":"La la la, la la la","translation":"라라라 라라라","kind":"lyric"},{"id":"6","start":21.87,"end":25.398,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"7","start":25.458,"end":28.894,"text":"La la la, la la la, la la la","translation":"라라라 라라라 라라라","kind":"lyric"},{"id":"8","start":28.954,"end":33.29,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"9","start":33.35,"end":39.3,"text":"かっこいい君には 僕じゃ頼りないのかなんて","translation":"멋진 너에겐 내가 미덥지 않은 걸까","kind":"lyric"},{"id":"10","start":39.36,"end":45.36,"text":"そりゃそうだよな だって今もこうして迷ってる","translation":"그렇겠지 지금도 이렇게 망설이고 있으니","kind":"lyric"},{"id":"11","start":47.588,"end":51.489,"text":"(La la la, la la la) 手を取ってくれないか","translation":"라라라 라라라 내 손을 잡아 주지 않을래","kind":"lyric"},{"id":"12","start":51.549,"end":55.65,"text":"(La la la, la la la) ギブとテイクさ","translation":"라라라 라라라 기브 앤 테이크야","kind":"lyric"},{"id":"13","start":55.71,"end":60.04,"text":"(La la la, la la la) 君が僕のヒーローだったように","translation":"라라라 라라라 네가 나의 영웅이었던 것처럼","kind":"lyric"},{"id":"14","start":60.1,"end":61.526,"text":"今なんじゃない?","translation":"지금 아니겠어","kind":"lyric"},{"id":"15","start":61.586,"end":63.4,"text":"メラメラとたぎる","translation":"활활 끓어올라","kind":"lyric"},{"id":"16","start":63.46,"end":67.02,"text":"こんな僕にも潜む正義が","translation":"이런 내 안에도 숨어 있던 정의가","kind":"lyric"},{"id":"17","start":67.08,"end":70.886,"text":"どうしようもない衝動に駆られて","translation":"어쩔 수 없는 충동에 이끌려","kind":"lyric"},{"id":"18","start":70.946,"end":74.854,"text":"ほら気付けば手を握っている","translation":"봐 정신을 차리면 네 손을 잡고 있어","kind":"lyric"},{"id":"19","start":74.914,"end":76.305,"text":"いったいぜんたい","translation":"대체 어쩌려고","kind":"lyric"},{"id":"20","start":76.365,"end":82.365,"text":"そんなに荷物を背負い込んでどこへ行くの","translation":"그렇게 짐을 짊어지고 어디로 가는 거야","kind":"lyric"},{"id":"21","start":82.6,"end":88.6,"text":"ねえねえ待って僕にちょっと預けてみては?","translation":"있지 잠깐 내게 조금 맡겨 보지 않을래","kind":"lyric"},{"id":"22","start":102.704,"end":105.8,"text":"信じてばかりの僕と","translation":"그저 믿기만 하는 나와","kind":"lyric"},{"id":"23","start":105.86,"end":110.42,"text":"信じることが怖い君と","translation":"믿는 것이 두려운 너","kind":"lyric"},{"id":"24","start":110.48,"end":113.1,"text":"どちらが正しいのかなんて","translation":"어느 쪽이 옳은지는","kind":"lyric"},{"id":"25","start":113.16,"end":116.782,"text":"誰にも分からないさ","translation":"아무도 몰라","kind":"lyric"},{"id":"26","start":116.842,"end":120.505,"text":"(La la la, la la la) 僕らだけの世界","translation":"라라라 라라라 우리만의 세계","kind":"lyric"},{"id":"27","start":120.565,"end":124.01,"text":"(La la la, la la la) ギブとテイクさ","translation":"라라라 라라라 기브 앤 테이크야","kind":"lyric"},{"id":"28","start":124.07,"end":130.07,"text":"(La la la, la la la) 補い合えた暁には同じ夢を見たい","translation":"라라라 라라라 서로 채워 주는 날엔 같은 꿈을 꾸고 싶어","kind":"lyric"},{"id":"29","start":146.41,"end":150.02,"text":"君はかっこいいと苦しめて","translation":"너는 멋지다는 말로 괴롭히고","kind":"lyric"},{"id":"30","start":150.08,"end":152.6,"text":"ひとりぼっちにさせたのは","translation":"홀로 남겨 둔 건","kind":"lyric"},{"id":"31","start":152.66,"end":156.62,"text":"少し僕のせいなんだよな ごめんね","translation":"조금은 내 탓이겠지 미안해","kind":"lyric"},{"id":"32","start":156.68,"end":162.24,"text":"だけど見るべきはリアルだ","translation":"하지만 봐야 할 건 현실이야","kind":"lyric"},{"id":"33","start":162.3,"end":166.46,"text":"今こそ僕が救けるんだ","translation":"이제야말로 내가 구하는 거야","kind":"lyric"},{"id":"34","start":166.52,"end":172.52,"text":"抱えないで信じて頼ってほしいんだ","translation":"혼자 안지 말고 믿고 기대 줬으면 해","kind":"lyric"},{"id":"35","start":177.1,"end":177.888,"text":"今なんじゃない?","translation":"지금 아니겠어","kind":"lyric"},{"id":"36","start":177.948,"end":179.796,"text":"メラメラとたぎる","translation":"활활 끓어올라","kind":"lyric"},{"id":"37","start":179.856,"end":183.235,"text":"こんな僕にも眠る正義が","translation":"이런 내 안에도 잠들어 있던 정의가","kind":"lyric"},{"id":"38","start":183.295,"end":186.703,"text":"どうしようもない衝動に駆られて","translation":"어쩔 수 없는 충동에 이끌려","kind":"lyric"},{"id":"39","start":186.763,"end":190.103,"text":"ほら気付けば手を握っている","translation":"봐 정신을 차리면 네 손을 잡고 있어","kind":"lyric"},{"id":"40","start":190.163,"end":191.544,"text":"ほっておけない","translation":"내버려 둘 수 없어","kind":"lyric"},{"id":"41","start":191.604,"end":196.891,"text":"そんなに荷物を背負い込んでどこへ行くの","translation":"그렇게 짐을 짊어지고 어디로 가는 거야","kind":"lyric"},{"id":"42","start":196.951,"end":202.951,"text":"ほんのちょっと僕にちょっと預けてみては?","translation":"아주 조금 내게 조금 맡겨 보지 않을래","kind":"lyric"},{"id":"43","start":203.819,"end":209.819,"text":"こんな僕も君のヒーローになりたいのさ (ooh whoa)","translation":"이런 나도 너의 영웅이 되고 싶어","kind":"lyric"},{"id":"44","start":211.75,"end":214.195,"text":"La la la, la la la","translation":"라라라 라라라","kind":"lyric"},{"id":"45","start":214.255,"end":217.753,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"46","start":217.813,"end":221.103,"text":"La la la, la la la, la la la","translation":"라라라 라라라 라라라","kind":"lyric"},{"id":"47","start":221.163,"end":225.426,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"48","start":225.486,"end":227.931,"text":"La la la, la la la","translation":"라라라 라라라","kind":"lyric"},{"id":"49","start":227.991,"end":231.708,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"},{"id":"50","start":231.768,"end":234.888,"text":"La la la, la la la, la la la","translation":"라라라 라라라 라라라","kind":"lyric"},{"id":"51","start":234.948,"end":244.9,"text":"La la la la, la la la, la la la","translation":"라라라라 라라라 라라라","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}