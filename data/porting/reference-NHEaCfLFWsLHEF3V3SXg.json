{"title":"Defying Gravity","artist":"WICKED","sourceId":"reference:NHEaCfLFWsLHEF3V3SXg","sourceHash":"693eb072ea47dc8aa457de3f8162f59c367583514cdc85322a7d2476fb9acdbc","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":19876340,"cues":[{"id":"1","start":0.42,"end":3.27,"text":"Elphaba - why couldn't you have just stayed calm for once,","translation":"","kind":"lyric"},{"id":"2","start":3.27,"end":5.51,"text":"instead of flying off the handle!","translation":"","kind":"lyric"},{"id":"3","start":5.51,"end":6.95,"text":"I hope you're happy!","translation":"","kind":"lyric"},{"id":"4","start":6.95,"end":8.68,"text":"I hope you're happy now","translation":"","kind":"lyric"},{"id":"5","start":8.68,"end":10.43,"text":"I hope you're happy how you","translation":"","kind":"lyric"},{"id":"6","start":10.43,"end":11.79,"text":"Hurt your cause forever","translation":"","kind":"lyric"},{"id":"7","start":11.79,"end":13.85,"text":"I hope you think you're clever!","translation":"","kind":"lyric"},{"id":"8","start":13.85,"end":15.56,"text":"I hope you're happy","translation":"","kind":"lyric"},{"id":"9","start":15.56,"end":17.01,"text":"I hope you're happy, too","translation":"","kind":"lyric"},{"id":"10","start":17.01,"end":19.28,"text":"I hope you're proud how you","translation":"","kind":"lyric"},{"id":"11","start":19.28,"end":20.77,"text":"Would grovel in submission","translation":"","kind":"lyric"},{"id":"12","start":20.77,"end":22.99,"text":"To feed your own ambition","translation":"","kind":"lyric"},{"id":"13","start":22.99,"end":27.51,"text":"So though I can't imagine how","translation":"","kind":"lyric"},{"id":"14","start":27.51,"end":35.8,"text":"I hope you're happy right now","translation":"","kind":"lyric"},{"id":"15","start":35.8,"end":41.52,"text":"Elphie, listen to me. Just say you're sorry:","translation":"","kind":"lyric"},{"id":"16","start":41.52,"end":46.79,"text":"You can still be with the Wizard","translation":"","kind":"lyric"},{"id":"17","start":46.79,"end":50.96,"text":"What you've worked and waited for","translation":"","kind":"lyric"},{"id":"18","start":50.96,"end":57.02,"text":"You can have all you ever wanted:","translation":"","kind":"lyric"},{"id":"19","start":57.02,"end":58.43,"text":"I know","translation":"","kind":"lyric"},{"id":"20","start":58.43,"end":61.45,"text":"But I don't want it","translation":"","kind":"lyric"},{"id":"21","start":61.45,"end":73.4,"text":"No - I can't want it","translation":"","kind":"lyric"},{"id":"22","start":73.4,"end":80.71000000000001,"text":"Something has changed within me","translation":"","kind":"lyric"},{"id":"23","start":80.71000000000001,"end":85.14,"text":"Something is not the same","translation":"","kind":"lyric"},{"id":"24","start":85.14,"end":89.2,"text":"I'm through with playing by the rules","translation":"","kind":"lyric"},{"id":"25","start":89.2,"end":92.84,"text":"Of someone else's game","translation":"","kind":"lyric"},{"id":"26","start":92.84,"end":96.52000000000001,"text":"Too late for second-guessing","translation":"","kind":"lyric"},{"id":"27","start":96.52000000000001,"end":101.77000000000001,"text":"Too late to go back to sleep","translation":"","kind":"lyric"},{"id":"28","start":101.77000000000001,"end":104.81,"text":"It's time to trust my instincts","translation":"","kind":"lyric"},{"id":"29","start":104.81,"end":111.03,"text":"Close my eyes and leap!","translation":"","kind":"lyric"},{"id":"30","start":111.03,"end":112.82,"text":"It's time to try","translation":"","kind":"lyric"},{"id":"31","start":112.82,"end":116.43,"text":"Defying gravity","translation":"","kind":"lyric"},{"id":"32","start":116.43,"end":119.00999999999999,"text":"I think I'll try","translation":"","kind":"lyric"},{"id":"33","start":119.00999999999999,"end":122.44,"text":"Defying gravity","translation":"","kind":"lyric"},{"id":"34","start":122.44,"end":125.38,"text":"And you can't pull me down!","translation":"","kind":"lyric"},{"id":"35","start":125.38,"end":127.5,"text":"Can't I make you understand?","translation":"","kind":"lyric"},{"id":"36","start":127.5,"end":130.78,"text":"You're having delusions of grandeur:","translation":"","kind":"lyric"},{"id":"37","start":130.78,"end":132.98,"text":"I'm through accepting limits","translation":"","kind":"lyric"},{"id":"38","start":132.98,"end":136.05,"text":"'cause someone says they're so","translation":"","kind":"lyric"},{"id":"39","start":136.05,"end":138.84,"text":"Some things I cannot change","translation":"","kind":"lyric"},{"id":"40","start":138.84,"end":142.59,"text":"But till I try, I'll never know!","translation":"","kind":"lyric"},{"id":"41","start":142.59,"end":144.74,"text":"Too long I've been afraid of","translation":"","kind":"lyric"},{"id":"42","start":144.74,"end":148.42000000000002,"text":"Losing love I guess I've lost","translation":"","kind":"lyric"},{"id":"43","start":148.42000000000002,"end":149.79,"text":"Well, if that's love","translation":"","kind":"lyric"},{"id":"44","start":149.79,"end":154.75,"text":"It comes at much too high a cost!","translation":"","kind":"lyric"},{"id":"45","start":154.75,"end":156.72,"text":"I'd sooner buy","translation":"","kind":"lyric"},{"id":"46","start":156.72,"end":160.12,"text":"Defying gravity","translation":"","kind":"lyric"},{"id":"47","start":160.12,"end":163.24,"text":"Kiss me goodbye","translation":"","kind":"lyric"},{"id":"48","start":163.24,"end":166.18,"text":"I'm defying gravity","translation":"","kind":"lyric"},{"id":"49","start":166.18,"end":170.04,"text":"And you can't pull me down:","translation":"","kind":"lyric"},{"id":"50","start":170.04,"end":176.68,"text":"(spoken) Glinda, come with me. Think of what we could","translation":"","kind":"lyric"},{"id":"51","start":176.68,"end":178.54,"text":"do, together.","translation":"","kind":"lyric"},{"id":"52","start":178.54,"end":182.04,"text":"Unlimited","translation":"","kind":"lyric"},{"id":"53","start":182.04,"end":187.59,"text":"Together we're unlimited","translation":"","kind":"lyric"},{"id":"54","start":187.59,"end":190.49,"text":"Together we'll be the greatest team","translation":"","kind":"lyric"},{"id":"55","start":190.49,"end":191.95,"text":"There's ever been","translation":"","kind":"lyric"},{"id":"56","start":191.95,"end":193.94,"text":"Glinda -","translation":"","kind":"lyric"},{"id":"57","start":193.94,"end":197.61,"text":"Dreams, the way we planned 'em","translation":"","kind":"lyric"},{"id":"58","start":197.61,"end":201.43,"text":"If we work in tandem","translation":"","kind":"lyric"},{"id":"59","start":201.43,"end":206.16,"text":"There's no fight we cannot win","translation":"","kind":"lyric"},{"id":"60","start":206.16,"end":209.55,"text":"Just you and I","translation":"","kind":"lyric"},{"id":"61","start":209.55,"end":212.95,"text":"Defying gravity","translation":"","kind":"lyric"},{"id":"62","start":212.95,"end":215.6,"text":"With you and I","translation":"","kind":"lyric"},{"id":"63","start":215.6,"end":218.96,"text":"Defying gravity","translation":"","kind":"lyric"},{"id":"64","start":218.96,"end":222.7,"text":"They'll never bring us down!","translation":"","kind":"lyric"},{"id":"65","start":222.7,"end":226.39,"text":"Well? Are you coming?","translation":"","kind":"lyric"},{"id":"66","start":226.39,"end":235.06,"text":"I hope you're happy","translation":"","kind":"lyric"},{"id":"67","start":235.06,"end":239.38,"text":"Now that you're choosing this","translation":"","kind":"lyric"},{"id":"68","start":239.38,"end":240.67,"text":"You too","translation":"","kind":"lyric"},{"id":"69","start":240.67,"end":243.52,"text":"I hope it brings you bliss","translation":"","kind":"lyric"},{"id":"70","start":243.52,"end":245.72,"text":"I really hope you get it","translation":"","kind":"lyric"},{"id":"71","start":245.72,"end":249.37,"text":"And you don't live to regret it","translation":"","kind":"lyric"},{"id":"72","start":249.37,"end":256.36,"text":"I hope you're happy in the end","translation":"","kind":"lyric"},{"id":"73","start":256.36,"end":266.44,"text":"I hope you're happy, my friend:","translation":"","kind":"lyric"},{"id":"74","start":266.44,"end":274.76,"text":"So if you care to find me","translation":"","kind":"lyric"},{"id":"75","start":274.76,"end":277.90999999999997,"text":"Look to the western sky!","translation":"","kind":"lyric"},{"id":"76","start":277.90999999999997,"end":280.86,"text":"As someone told me lately:","translation":"","kind":"lyric"},{"id":"77","start":280.86,"end":286.08,"text":"\"Ev'ryone deserves the chance to fly!\"","translation":"","kind":"lyric"},{"id":"78","start":286.08,"end":288.57,"text":"And if I'm flying solo","translation":"","kind":"lyric"},{"id":"79","start":288.57,"end":291.45,"text":"At least I'm flying free","translation":"","kind":"lyric"},{"id":"80","start":291.45,"end":293.63,"text":"To those who'd ground me","translation":"","kind":"lyric"},{"id":"81","start":293.63,"end":299.14,"text":"Take a message back from me","translation":"","kind":"lyric"},{"id":"82","start":299.14,"end":301.3,"text":"Tell them how I am","translation":"","kind":"lyric"},{"id":"83","start":301.3,"end":304.38,"text":"Defying gravity","translation":"","kind":"lyric"},{"id":"84","start":304.38,"end":307.05,"text":"I'm flying high","translation":"","kind":"lyric"},{"id":"85","start":307.05,"end":310.0,"text":"Defying gravity","translation":"","kind":"lyric"},{"id":"86","start":310.0,"end":314.93,"text":"And soon I'll match them in renown","translation":"","kind":"lyric"},{"id":"87","start":314.93,"end":318.79,"text":"And nobody in all of Oz","translation":"","kind":"lyric"},{"id":"88","start":318.79,"end":321.61,"text":"No Wizard that there is or was","translation":"","kind":"lyric"},{"id":"89","start":321.61,"end":329.06,"text":"Is ever gonna bring me down!","translation":"","kind":"lyric"},{"id":"90","start":329.06,"end":331.65,"text":"I hope you're happy!","translation":"","kind":"lyric"},{"id":"91","start":331.65,"end":334.06,"text":"Look at her, she's wicked!","translation":"","kind":"lyric"},{"id":"92","start":334.06,"end":335.42,"text":"Get her!","translation":"","kind":"lyric"},{"id":"93","start":335.42,"end":337.35,"text":"Bring me down!","translation":"","kind":"lyric"},{"id":"94","start":337.35,"end":338.23,"text":"No one mourns the wicked","translation":"","kind":"lyric"},{"id":"95","start":338.23,"end":342.72,"text":"So we've got to bring her","translation":"","kind":"lyric"},{"id":"96","start":342.72,"end":344.64,"text":"Ahhh!","translation":"","kind":"lyric"},{"id":"97","start":344.64,"end":349.4,"text":"Down!","translation":"","kind":"lyric"}],"candidates":[]}