{"title":"Who Killed U.N.Owen","artist":"Liz Triangle","sourceId":"reference:DgkRdSYg76DiusLPAKLH","sourceHash":"0cbff86b80eba7160c8c8d3c7b1dcc9b5cd9fb2bfb72c29699e38d226d892d8e","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":35667072,"cues":[{"id":"1","start":34.56,"end":38.05,"text":"暗いお城で開かれた","translation":"","kind":"lyric"},{"id":"2","start":38.05,"end":42.03,"text":"一人きりで始まるお茶会","translation":"","kind":"lyric"},{"id":"3","start":42.03,"end":45.55,"text":"籠の中の小鳥さん","translation":"","kind":"lyric"},{"id":"4","start":45.55,"end":49.34,"text":"あなた 私と踊りましょ？","translation":"","kind":"lyric"},{"id":"5","start":49.34,"end":53.0,"text":"(La-la-la-la) 休む事く無く","translation":"","kind":"lyric"},{"id":"6","start":53.0,"end":56.76,"text":"(La-la-la-la) 手を叩く","translation":"","kind":"lyric"},{"id":"7","start":56.76,"end":60.77,"text":"(La-la-la-la-la) 終わる事の無い","translation":"","kind":"lyric"},{"id":"8","start":60.77,"end":64.11,"text":"秘密のカルニバル","translation":"","kind":"lyric"},{"id":"9","start":64.11,"end":68.09,"text":"カゴメよカゴメ お菓子はいかが？","translation":"","kind":"lyric"},{"id":"10","start":68.09,"end":71.65,"text":"赤色と青色の飴","translation":"","kind":"lyric"},{"id":"11","start":71.65,"end":75.31,"text":"お菓子の家に出口はないよ","translation":"","kind":"lyric"},{"id":"12","start":75.31,"end":81.53,"text":"シリアスな声でこう囁く","translation":"","kind":"lyric"},{"id":"13","start":81.53,"end":83.41,"text":"「鏡よ鏡」","translation":"","kind":"lyric"},{"id":"14","start":83.41,"end":87.37,"text":"世界で誰よりも","translation":"","kind":"lyric"},{"id":"15","start":87.37,"end":90.78999999999999,"text":"いたずら好きなのは誰ですか？","translation":"","kind":"lyric"},{"id":"16","start":90.78999999999999,"end":94.78999999999999,"text":"「それはあなたです」と","translation":"","kind":"lyric"},{"id":"17","start":94.78999999999999,"end":96.78999999999999,"text":"映る私が笑う","translation":"","kind":"lyric"},{"id":"18","start":96.78999999999999,"end":100.12,"text":"「私はあなた あなたはだれ？」","translation":"","kind":"lyric"},{"id":"19","start":100.12,"end":103.93,"text":"キラキラと割れるダレカの笑顔","translation":"","kind":"lyric"},{"id":"20","start":103.93,"end":107.68,"text":"「あなたは私 私はだぁれ？」","translation":"","kind":"lyric"},{"id":"21","start":107.68,"end":110.88,"text":"心の刺さる エゴイズム","translation":"","kind":"lyric"},{"id":"22","start":115.95,"end":119.44,"text":"La-la-la-la, la-la-la-la, la-la-la-la","translation":"","kind":"lyric"},{"id":"23","start":119.44,"end":123.3,"text":"誰にも内緒よ la-la-la-la","translation":"","kind":"lyric"},{"id":"24","start":123.3,"end":127.29,"text":"La-la-la-la, la-la-la-la, la-la-la-la","translation":"","kind":"lyric"},{"id":"25","start":127.29,"end":134.12,"text":"始まりのおしまい","translation":"","kind":"lyric"},{"id":"26","start":134.12,"end":138.18,"text":"あなたが残した","translation":"","kind":"lyric"},{"id":"27","start":138.18,"end":141.55,"text":"プレゼントは何処？","translation":"","kind":"lyric"},{"id":"28","start":141.55,"end":145.73,"text":"何処 どこ ドコなの？","translation":"","kind":"lyric"},{"id":"29","start":145.73,"end":149.71,"text":"空っぽの靴下","translation":"","kind":"lyric"},{"id":"30","start":149.71,"end":153.23,"text":"誰が殺し 誰がなる？","translation":"","kind":"lyric"},{"id":"31","start":153.23,"end":157.79,"text":"誰が鳴らすか 鏡の音を？","translation":"","kind":"lyric"},{"id":"32","start":157.79,"end":161.48,"text":"「それは 私よ」","translation":"","kind":"lyric"},{"id":"33","start":161.48,"end":165.95,"text":"ダレカの声が響く","translation":"","kind":"lyric"},{"id":"34","start":165.95,"end":169.74,"text":"円卓を囲むのは","translation":"","kind":"lyric"},{"id":"35","start":169.74,"end":173.61,"text":"可哀想な駒鳥で","translation":"","kind":"lyric"},{"id":"36","start":173.61,"end":177.35,"text":"優しく抱きしめて","translation":"","kind":"lyric"},{"id":"37","start":177.35,"end":179.5,"text":"抱え上げ","translation":"","kind":"lyric"},{"id":"38","start":179.5,"end":181.38,"text":"握り締め","translation":"","kind":"lyric"},{"id":"39","start":181.38,"end":183.26,"text":"零れだす","translation":"","kind":"lyric"},{"id":"40","start":183.26,"end":185.41,"text":"愉悦の笑み","translation":"","kind":"lyric"},{"id":"41","start":218.18,"end":222.14,"text":"中身をくり貫いた","translation":"","kind":"lyric"},{"id":"42","start":222.14,"end":225.88,"text":"カボチャのフェイス","translation":"","kind":"lyric"},{"id":"43","start":225.88,"end":230.02,"text":"マネキンだらけで","translation":"","kind":"lyric"},{"id":"44","start":230.02,"end":233.55,"text":"踊れやしない！","translation":"","kind":"lyric"},{"id":"45","start":233.55,"end":235.36,"text":"あなたと私","translation":"","kind":"lyric"},{"id":"46","start":235.36,"end":237.21,"text":"籠の中","translation":"","kind":"lyric"},{"id":"47","start":237.21,"end":238.75,"text":"あなたも私","translation":"","kind":"lyric"},{"id":"48","start":238.75,"end":241.05,"text":"（チグハグ）","translation":"","kind":"lyric"},{"id":"49","start":241.05,"end":244.83,"text":"ネジが動きを止め","translation":"","kind":"lyric"},{"id":"50","start":244.83,"end":248.78,"text":"踊る事の無いオートマタ","translation":"","kind":"lyric"},{"id":"51","start":248.78,"end":252.24,"text":"虚実に苛まれ","translation":"","kind":"lyric"},{"id":"52","start":252.24,"end":255.99,"text":"そして誰もが消える","translation":"","kind":"lyric"},{"id":"53","start":255.99,"end":258.02,"text":"ヒドイ世界で","translation":"","kind":"lyric"},{"id":"54","start":258.02,"end":261.85,"text":"私と踊りましょ？","translation":"","kind":"lyric"},{"id":"55","start":261.85,"end":265.58,"text":"生きてるふりをしたクックロビン","translation":"","kind":"lyric"},{"id":"56","start":265.58,"end":269.25,"text":"お菓子のお城には","translation":"","kind":"lyric"},{"id":"57","start":269.25,"end":273.13,"text":"壊れた魔女が一人","translation":"","kind":"lyric"},{"id":"58","start":273.13,"end":275.03,"text":"「あなたは私 あなたはだぁれ？」","translation":"","kind":"lyric"},{"id":"59","start":275.03,"end":279.08,"text":"壁にまでかかる 赤い絨毯","translation":"","kind":"lyric"},{"id":"60","start":279.08,"end":282.55,"text":"「私はあなた あなたはだぁれ？」","translation":"","kind":"lyric"},{"id":