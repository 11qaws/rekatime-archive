{"title":"Doki Doki Forever","artist":"Doki Doki Literature Club","sourceId":"reference:9GzUyIwhEEfflS58GqZN","sourceHash":"62c5dc2833e25531177c7b2c7cb20494beebf8269c67c40bf843b14581f065dc","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":34843103,"cues":[{"id":"1","start":13.98,"end":15.05,"text":"Doki Doki!","translation":"","kind":"lyric"},{"id":"2","start":15.05,"end":15.94,"text":"Hey hey!","translation":"","kind":"lyric"},{"id":"3","start":15.94,"end":19.93,"text":"My heart's beating when I'm hanging out with you!","translation":"","kind":"lyric"},{"id":"4","start":19.93,"end":21.74,"text":"Why does my heart ache,","translation":"","kind":"lyric"},{"id":"5","start":21.74,"end":24.19,"text":"When I hear you feel the same way too?","translation":"","kind":"lyric"},{"id":"6","start":24.19,"end":26.17,"text":"(Eheheh)","translation":"","kind":"lyric"},{"id":"7","start":26.17,"end":27.83,"text":"Just like a sundae,","translation":"","kind":"lyric"},{"id":"8","start":27.83,"end":31.48,"text":"It's sweet every time I teach you something new!","translation":"","kind":"lyric"},{"id":"9","start":31.48,"end":32.43,"text":"Is this by chance,","translation":"","kind":"lyric"},{"id":"10","start":32.43,"end":33.57,"text":"Or fate?","translation":"","kind":"lyric"},{"id":"11","start":33.57,"end":35.8,"text":"Whenever it's just me and you?","translation":"","kind":"lyric"},{"id":"12","start":35.8,"end":38.05,"text":"(E-Eh! Don't get the wrong idea!)","translation":"","kind":"lyric"},{"id":"13","start":38.05,"end":43.25,"text":"When we touch, it'll never be enough","translation":"","kind":"lyric"},{"id":"14","start":43.25,"end":49.55,"text":"Is it way too much if you had to choose just one of us?","translation":"","kind":"lyric"},{"id":"15","start":49.55,"end":51.81,"text":"Tell me, tell me, please!","translation":"","kind":"lyric"},{"id":"16","start":51.81,"end":53.14,"text":"Is this what I think,","translation":"","kind":"lyric"},{"id":"17","start":53.14,"end":54.83,"text":"Or is it just me?","translation":"","kind":"lyric"},{"id":"18","start":54.83,"end":57.42,"text":"Don't wake me up from this sweet little dream!","translation":"","kind":"lyric"},{"id":"19","start":57.42,"end":59.64,"text":"Where we'll be together forever","translation":"","kind":"lyric"},{"id":"20","start":59.64,"end":61.49,"text":"We're never gonna be apart!","translation":"","kind":"lyric"},{"id":"21","start":61.49,"end":63.39,"text":"Will it be okay","translation":"","kind":"lyric"},{"id":"22","start":63.39,"end":66.1,"text":"If I express my love for you this way?","translation":"","kind":"lyric"},{"id":"23","start":66.1,"end":69.21000000000001,"text":"No matter what you do or what you say,","translation":"","kind":"lyric"},{"id":"24","start":69.21000000000001,"end":71.12,"text":"We'll be together forever","translation":"","kind":"lyric"},{"id":"25","start":71.12,"end":76.59,"text":"We're never gonna be apart!","translation":"","kind":"lyric"},{"id":"26","start":76.59,"end":80.89,"text":"(We're never gonna be apart)","translation":"","kind":"lyric"},{"id":"27","start":84.77,"end":85.87,"text":"Hey hey","translation":"","kind":"lyric"},{"id":"28","start":85.87,"end":89.55,"text":"When I'm next to you, I don't know what to do","translation":"","kind":"lyric"},{"id":"29","start":89.55,"end":91.5,"text":"Why does it feel so great,","translation":"","kind":"lyric"},{"id":"30","start":91.5,"end":93.63,"text":"When our eyes meet out of the blue?","translation":"","kind":"lyric"},{"id":"31","start":93.63,"end":95.93,"text":"(I-I'm sorry, I said too much!)","translation":"","kind":"lyric"},{"id":"32","start":95.93,"end":96.95,"text":"I really Lͭ̉͡'͓̣O̴̱̳̱ͭ̈́͞ͅṾ̛̤̉̉̓͡ͅȆ̿'̷͇̙—-","translation":"","kind":"lyric"},{"id":"33","start":96.95,"end":101.28,"text":"The way you write even when you don't have a clue!","translation":"","kind":"lyric"},{"id":"34","start":101.28,"end":103.37,"text":"I wanna hear you say:","translation":"","kind":"lyric"},{"id":"35","start":103.37,"end":108.19,"text":"\"This love that I am feeling is true!\"","translation":"","kind":"lyric"},{"id":"36","start":108.19,"end":113.08,"text":"Tasty love, something I want more of!","translation":"","kind":"lyric"},{"id":"37","start":113.08,"end":115.96000000000001,"text":"Will it make the cut,","translation":"","kind":"lyric"},{"id":"38","start":115.96000000000001,"end":119.63,"text":"If you had to choose just one of us?","translation":"","kind":"lyric"},{"id":"39","start":119.63,"end":121.58,"text":"Shall I leave you be?","translation":"","kind":"lyric"},{"id":"40","start":121.58,"end":124.68,"text":"Is it love if I can set you free?","translation":"","kind":"lyric"},{"id":"41","start":124.68,"end":127.12,"text":"But even if it's not reality,","translation":"","kind":"lyric"},{"id":"42","start":127.12,"end":129.19,"text":"Let's be together forever,","translation":"","kind":"lyric"},{"id":"43","start":129.19,"end":131.16,"text":"We're never gonna be apart!","translation":"","kind":"lyric"},{"id":"44","start":131.16,"end":133.28,"text":"How can I convey,","translation":"","kind":"lyric"},{"id":"45","start":133.28,"end":136.27,"text":"My love for you before they fly away?","translation":"","kind":"lyric"},{"id":"46","start":136.27,"end":138.98,"text":"I think about it all day everyday","translation":"","kind":"lyric"},{"id":"47","start":138.98,"end":140.82999999999998,"text":"We'll be together forever,","translation":"","kind":"lyric"},{"id":"48","start":140.82999999999998,"end":142.99,"text":"We're never gonna be apart!","translation":"","kind":"lyric"},{"id":"49","start":142.99,"end":146.01,"text":"One by one they only","translation":"","kind":"lyric"},{"id":"50","start":146.01,"end":148.07999999999998,"text":"Fall apart","translation":"","kind":"lyric"},{"id":"51","start":148.07999999999998,"end":150.5,"text":"Can it be undone?","translation":"","kind":"lyric"},{"id":"52","start":150.5,"end":156.02,"text":"Why can't I just be the one for once?","translation":"","kind":"lyric"},{"id":"53","start":162.32,"end":164.2,"text":"We'll be together forever,","translation":"","kind":"lyric"},{"id":"54","start":164.2,"end":169.02,"text":"We're never gonna be Aͯͮ'̣P͉͐A̿ͫͥ'͊͡R͚͞'͓̦̼'͖T̑'","translation":"","kind":"lyric"},{"id":"55","start":169.02,"end":174.45,"text":"(Forever, forever)","translation":"","kind":"lyric"},{"id":"56","start":174.45,"end":176.1,"text":"Maybe we'll never be together,","translation":"","kind":"lyric"},{"id":"57","start":176.1,"end":179.42000000000002,"text":"But forever you'll be in my heart!","translation":"","kind":"lyric"}],"candidates":[]}