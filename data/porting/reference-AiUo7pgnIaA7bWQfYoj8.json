","kind":"lyric"},{"id":"40","start":114.75,"end":117.16,"text":"どうしようもないこと吐く 白昼夢に","translation":"","kind":"lyric"},{"id":"41","start":117.16,"end":120.31,"text":"今世紀最期のプロポーズをしよう","translation":"","kind":"lyric"},{"id":"42","start":120.31,"end":122.78,"text":"「嫌われちゃったら どうしよう？」","translation":"","kind":"lyric"},{"id":"43","start":122.78,"end":125.87,"text":"とか 考えてんの色々","translation":"","kind":"lyric"},{"id":"44","start":125.87,"end":128.2,"text":"「嫌われちゃったら どうしよう？」","translation":"","kind":"lyric"},{"id":"45","start":128.2,"end":131.11,"text":"とか 考えてんの色々","translation":"","kind":"lyric"},{"id":"46","start":131.11,"end":133.9,"text":"雨が降って 夜を待って","translation":"","kind":"lyric"},{"id":"47","start":133.9,"end":136.63,"text":"風になったあの子","translation":"","kind":"lyric"},{"id":"48","start":136.63,"end":139.19,"text":"幸せって 何だろうね","translation":"","kind":"lyric"},{"id":"49","start":139.19,"end":142.17000000000002,"text":"難しいこと わっかんね！","translation":"","kind":"lyric"},{"id":"50","start":142.17000000000002,"end":144.92000000000002,"text":"雨が降って 夜を待って","translation":"","kind":"lyric"},{"id":"51","start":144.92000000000002,"end":147.53,"text":"星になったあの子","translation":"","kind":"lyric"},{"id":"52","start":147.53,"end":150.05,"text":"幸せって 何だろうね","translation":"","kind":"lyric"},{"id":"53","start":150.05,"end":152.8,"text":"もう君のこと わっかんねえなあ！","translation":"","kind":"lyric"},{"id":"54","start":152.8,"end":155.62,"text":"「嫌われちゃったら どうしよう？」","translation":"","kind":"lyric"},{"id":"55","start":155.62,"end":164.04,"text":"とか 考えてんの色々","translation":"","kind":"lyric"},{"id":"56","start":164.04,"end":166.2,"text":"「嫌われちゃったら どうしよう？」","translation":"","kind":"lyric"},{"id":"57","start":166.2,"end":169.14,"text":"とか 考えてんの色々","translation":"","kind":"lyric"}],"candidates":[]}