{"title":"Speechless","artist":"Aladin","sourceId":"reference:wPXukfI5FRL9HnXAvzcn","sourceHash":"65a49892701477e7575c0de2bfd10569ad856016928a1c50c871f620f1661984","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":5870438,"cues":[{"id":"1","start":8.19,"end":10.05,"text":"Here comes a wave","translation":"","kind":"lyric"},{"id":"2","start":10.05,"end":12.06,"text":"Meant to wash me away","translation":"","kind":"lyric"},{"id":"3","start":12.06,"end":15.61,"text":"A tide that is taking me under","translation":"","kind":"lyric"},{"id":"4","start":15.61,"end":17.48,"text":"Swallowing sand","translation":"","kind":"lyric"},{"id":"5","start":17.48,"end":19.77,"text":"Left with nothing to say","translation":"","kind":"lyric"},{"id":"6","start":19.77,"end":24.39,"text":"My voice drowned out in the thunder","translation":"","kind":"lyric"},{"id":"7","start":24.39,"end":27.41,"text":"But I won't cry","translation":"","kind":"lyric"},{"id":"8","start":27.41,"end":32.1,"text":"And I won't start to crumble","translation":"","kind":"lyric"},{"id":"9","start":32.1,"end":35.02,"text":"Whenever they try","translation":"","kind":"lyric"},{"id":"10","start":35.02,"end":39.59,"text":"To shut me or cut me down","translation":"","kind":"lyric"},{"id":"11","start":39.59,"end":42.86,"text":"I won't be silenced","translation":"","kind":"lyric"},{"id":"12","start":42.86,"end":46.62,"text":"You can't keep me quiet","translation":"","kind":"lyric"},{"id":"13","start":46.62,"end":50.03,"text":"Won't tremble when you try it","translation":"","kind":"lyric"},{"id":"14","start":50.03,"end":55.95,"text":"All I know is I won't go speechless","translation":"","kind":"lyric"},{"id":"15","start":55.95,"end":58.5,"text":"'Cause I'll breathe","translation":"","kind":"lyric"},{"id":"16","start":58.5,"end":62.01,"text":"When they try to suffocate me","translation":"","kind":"lyric"},{"id":"17","start":62.01,"end":65.54,"text":"Don't you underestimate me","translation":"","kind":"lyric"},{"id":"18","start":65.54,"end":71.6,"text":"'Cause I know that I won't go speechless","translation":"","kind":"lyric"},{"id":"19","start":71.6,"end":73.74,"text":"Written in stone","translation":"","kind":"lyric"},{"id":"20","start":73.74,"end":75.72,"text":"Every rule, every word","translation":"","kind":"lyric"},{"id":"21","start":75.72,"end":79.37,"text":"Centuries old and unbending","translation":"","kind":"lyric"},{"id":"22","start":79.37,"end":81.11,"text":"Stay in your place","translation":"","kind":"lyric"},{"id":"23","start":81.11,"end":83.33,"text":"Better seen and not heard","translation":"","kind":"lyric"},{"id":"24","start":83.33,"end":87.02,"text":"But now that story is ending","translation":"","kind":"lyric"},{"id":"25","start":87.02,"end":89.13,"text":"'Cause I","translation":"","kind":"lyric"},{"id":"26","start":89.13,"end":93.50999999999999,"text":"I cannot start to crumble","translation":"","kind":"lyric"},{"id":"27","start":93.50999999999999,"end":96.14,"text":"So come on and try","translation":"","kind":"lyric"},{"id":"28","start":96.14,"end":101.18,"text":"Try to shut me and cut me down","translation":"","kind":"lyric"},{"id":"29","start":101.18,"end":104.3,"text":"I won't be silenced","translation":"","kind":"lyric"},{"id":"30","start":104.3,"end":107.97999999999999,"text":"You can't keep me quiet","translation":"","kind":"lyric"},{"id":"31","start":107.97999999999999,"end":111.47999999999999,"text":"Won't tremble when you try it","translation":"","kind":"lyric"},{"id":"32","start":111.47999999999999,"end":115.65,"text":"All I know is I won't go speechless","translation":"","kind":"lyric"},{"id":"33","start":115.65,"end":117.34,"text":"Speechless","translation":"","kind":"lyric"},{"id":"34","start":117.34,"end":119.69,"text":"Let the storm in","translation":"","kind":"lyric"},{"id":"35","start":119.69,"end":123.14,"text":"I cannot be broken","translation":"","kind":"lyric"},{"id":"36","start":123.14,"end":126.51,"text":"No, I won't live unspoken","translation":"","kind":"lyric"},{"id":"37","start":126.51,"end":132.0,"text":"'Cause I know that I won't go speechless","translation":"","kind":"lyric"},{"id":"38","start":132.0,"end":135.55,"text":"Try to lock me in this cage","translation":"","kind":"lyric"},{"id":"39","start":135.55,"end":140.12,"text":"I won't just lay me down and die","translation":"","kind":"lyric"},{"id":"40","start":140.12,"end":143.13,"text":"I will take these broken wings","translation":"","kind":"lyric"},{"id":"41","start":143.13,"end":147.74,"text":"And watch me burn across the sky","translation":"","kind":"lyric"},{"id":"42","start":147.74,"end":151.07999999999998,"text":"Hear the echoes saying I","translation":"","kind":"lyric"},{"id":"43","start":151.07999999999998,"end":155.65,"text":"Won't be silenced","translation":"","kind":"lyric"},{"id":"44","start":155.65,"end":160.79,"text":"Though you want to see me tremble when you try it","translation":"","kind":"lyric"},{"id":"45","start":160.79,"end":165.04,"text":"All I know is I won't go speechless","translation":"","kind":"lyric"},{"id":"46","start":165.04,"end":166.94,"text":"Speechless","translation":"","kind":"lyric"},{"id":"47","start":166.94,"end":169.19,"text":"'Cause I'll breathe","translation":"","kind":"lyric"},{"id":"48","start":169.19,"end":172.59,"text":"When they try to suffocate me","translation":"","kind":"lyric"},{"id":"49","start":172.59,"end":176.05,"text":"Don't you underestimate me","translation":"","kind":"lyric"},{"id":"50","start":176.05,"end":180.14,"text":"'Cause I know that I won't go speechless","translation":"","kind":"lyric"},{"id":"51","start":180.14,"end":184.01,"text":"All I know is I won't go speechless","translation":"","kind":"lyric"},{"id":"52","start":184.01,"end":186.31,"text":"Speechless","translation":"","kind":"lyric"}],"candidates":[]}