{"title":"점묘의 노래","artist":"Mrs. GREEN APPLE","date":"2026-08-04","sourceId":"14524675:061","sourceHash":"2cb2f550c8b7877ca2c067d19db56d21f43d3d68d1ec6a2589cca22e1f321476","duration":309.09999999999854,"cues":[{"id":"1","start":31.590982,"end":37.485,"text":"貴方の声で解れてゆく","translation":"그대 목소리에 서서히 풀려 가","kind":"lyric"},{"id":"2","start":37.931008,"end":43.865,"text":"忘れたくないと心が云う","translation":"잊고 싶지 않다고 마음이 말해","kind":"lyric"},{"id":"3","start":44.521034,"end":50.285,"text":"思い出ばっか増えてゆく","translation":"추억만 늘어만 가","kind":"lyric"},{"id":"4","start":50.77106,"end":56.197691,"text":"ずっと側に居たい","translation":"줄곧 곁에 머물고 싶어","kind":"lyric"},{"id":"5","start":56.521083,"end":61.905,"text":"泣き虫でもいいかな","translation":"울보여도 괜찮을까","kind":"lyric"},{"id":"6","start":62.931108,"end":68.335,"text":"強がらないでいいよ","translation":"센 척하지 않아도 돼","kind":"lyric"},{"id":"7","start":69.341134,"end":75.415,"text":"限りある恋だとしても","translation":"끝이 있는 사랑이라 해도","kind":"lyric"},{"id":"8","start":75.63116,"end":80.215,"text":"出逢えて幸せです","translation":"그대를 만나 행복해요","kind":"lyric"},{"id":"9","start":81.691184,"end":85.341827,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"10","start":85.391199,"end":87.765,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"11","start":88.09121,"end":94.065,"text":"続いて欲しいと願っている","translation":"이어지기를 바라고 있어","kind":"lyric"},{"id":"12","start":94.261234,"end":100.855,"text":"手を取ることは出来ずとも","translation":"손을 잡지는 못하더라도","kind":"lyric"},{"id":"13","start":101.161262,"end":106.855,"text":"私は貴方を好いている","translation":"나는 그대를 마음에 품고 있어","kind":"lyric"},{"id":"14","start":108.03129,"end":114.085,"text":"貴方の夢で心安らぐ","translation":"그대가 나오는 꿈에 마음이 놓여","kind":"lyric"},{"id":"15","start":114.541316,"end":120.595,"text":"目覚めたくないと僕は云う","translation":"깨어나고 싶지 않다고 나는 말해","kind":"lyric"},{"id":"16","start":120.741341,"end":126.825,"text":"思い出ばっか増えてゆく","translation":"추억만 늘어만 가","kind":"lyric"},{"id":"17","start":127.021366,"end":133.533324,"text":"明日も側に居たい","translation":"내일도 곁에 머물고 싶어","kind":"lyric"},{"id":"18","start":145.771442,"end":148.575,"text":"どこまでも","translation":"어디까지고","kind":"lyric"},{"id":"19","start":148.781454,"end":151.765,"text":"どこまでも","translation":"어디까지고","kind":"lyric"},{"id":"20","start":151.901466,"end":158.345,"text":"鈍感な僕を叱って欲しい","translation":"무딘 나를 나무라 줬으면 해","kind":"lyric"},{"id":"21","start":158.541493,"end":164.461454,"text":"当たり前が壊れることに","translation":"당연하던 것이 무너지는 걸","kind":"lyric"},{"id":"22","start":164.601517,"end":170.324147,"text":"気づけないくらいに子供だけど","translation":"알아차리지 못할 만큼 어리지만","kind":"lyric"},{"id":"23","start":170.371541,"end":177.241568,"text":"ちゃんと僕は貴方を好いている","translation":"그래도 나는 그대를 진심으로 좋아해","kind":"lyric"},{"id":"24","start":177.261568,"end":190.581481,"text":"私の (僕の) 時間が止まればいいのに","translation":"우리 둘의 시간이 멈추면 좋을 텐데","kind":"lyric"},{"id":"25","start":202.771671,"end":206.115,"text":"ほらまた期待をしてしまう","translation":"봐 또 기대하고 말아","kind":"lyric"},{"id":"26","start":206.271685,"end":208.911696,"text":"グッと堪えてみるからさ","translation":"꾹 눌러 참아 볼 테니까","kind":"lyric"},{"id":"27","start":208.931696,"end":210.609018,"text":"もし溢れ出したら","translation":"만일 넘쳐 버린다면","kind":"lyric"},{"id":"28","start":210.801703,"end":215.765,"text":"瞳をちゃんと見てよ 見てよ 見て","translation":"내 눈을 제대로 바라봐 바라봐 봐","kind":"lyric"},{"id":"29","start":216.031724,"end":221.162357,"text":"貴方の影だけ伸びてゆく","translation":"그대 그림자만 길어져 가","kind":"lyric"},{"id":"30","start":221.301745,"end":226.345,"text":"消えてしまわないで","translation":"제발 사라지지 마","kind":"lyric"},{"id":"31","start":226.521766,"end":231.225,"text":"ずっと この思いは変わらない","translation":"줄곧 이 마음은 변하지 않아","kind":"lyric"},{"id":"32","start":231.331786,"end":233.865,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"33","start":234.041797,"end":237.025,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"34","start":237.141809,"end":243.357768,"text":"続いて欲しいと願っている","translation":"이어지기를 바라고 있어","kind":"lyric"},{"id":"35","start":243.411834,"end":250.075,"text":"手を取ることは出来ずとも","translation":"손을 잡지는 못하더라도","kind":"lyric"},{"id":"36","start":250.261862,"end":255.984491,"text":"過ぎていく現在に抱きしめられている","translation":"흘러가는 지금에 품 안겨 있어","kind":"lyric"},{"id":"37","start":256.281886,"end":262.585,"text":"私の (僕の)","translation":"우리 둘의","kind":"lyric"},{"id":"38","start":262.961913,"end":269.085,"text":"時間が止まればいいのに","translation":"시간이 멈추면 좋을 텐데","kind":"lyric"},{"id":"39","start":269.391939,"end":275.607898,"text":"今日を噛み締めていよう","translation":"오늘을 마음 깊이 새기자","kind":"lyric"},{"id":"40","start":275.671964,"end":277.955,"text":"終わるな","translation":"끝나지 마","kind":"lyric"},{"id":"41","start":278.151974,"end":282.394613,"text":"夏よ、終わるな","translation":"여름아 끝나지 마","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}