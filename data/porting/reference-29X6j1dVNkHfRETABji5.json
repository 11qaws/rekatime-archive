{"title":"All Is Found","artist":"Frozen","sourceId":"reference:29X6j1dVNkHfRETABji5","sourceHash":"5563d3c7b91df7553810fca31b0326b8a2ab3f4af6953587cbbd4044607d83ab","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":11.88,"end":14.88,"text":"Where the north wind meets the sea","translation":"","kind":"lyric"},{"id":"2","start":18.17,"end":21.17,"text":"There's a river full of memory","translation":"","kind":"lyric"},{"id":"3","start":24.24,"end":27.24,"text":"Sleep, my darling, safe and sound","translation":"","kind":"lyric"},{"id":"4","start":28.96,"end":31.96,"text":"For in this river all is found","translation":"","kind":"lyric"},{"id":"5","start":33.95,"end":36.95,"text":"All is found","translation":"","kind":"lyric"},{"id":"6","start":38.44,"end":41.44,"text":"When all is lost, then all is found","translation":"","kind":"lyric"},{"id":"7","start":43.4,"end":46.4,"text":"In her waters, deep and true","translation":"","kind":"lyric"},{"id":"8","start":49.66,"end":52.66,"text":"Lie the answers and a path for you","translation":"","kind":"lyric"},{"id":"9","start":55.81,"end":58.81,"text":"Dive down deep into her sound","translation":"","kind":"lyric"},{"id":"10","start":60.67,"end":63.67,"text":"But not too far or you'll be drowned","translation":"","kind":"lyric"},{"id":"11","start":66.13,"end":69.13,"text":"She will sing to those who'll hear","translation":"","kind":"lyric"},{"id":"12","start":71.68,"end":74.68,"text":"And in her song, all magic flows","translation":"","kind":"lyric"},{"id":"13","start":78.81,"end":81.81,"text":"Can you brave what you most fear?","translation":"","kind":"lyric"},{"id":"14","start":84.34,"end":87.34,"text":"Can you face what the river knows?","translation":"","kind":"lyric"},{"id":"15","start":112.62,"end":115.62,"text":"Until the river's finally crossed","translation":"","kind":"lyric"},{"id":"16","start":118.31,"end":121.31,"text":"You'll never feel the solid ground","translation":"","kind":"lyric"},{"id":"17","start":125.36,"end":128.36,"text":"You had to get a little lost","translation":"","kind":"lyric"},{"id":"18","start":130.97,"end":133.97,"text":"On your way to being found","translation":"","kind":"lyric"},{"id":"19","start":140.35,"end":143.35,"text":"Where the north wind meets the sea","translation":"","kind":"lyric"},{"id":"20","start":146.62,"end":149.62,"text":"There's a mother full of memory","translation":"","kind":"lyric"},{"id":"21","start":152.87,"end":155.87,"text":"Come, my darling, homeward-bound","translation":"","kind":"lyric"},{"id":"22","start":157.52,"end":160.52,"text":"Where all is lost, then all is found","translation":"","kind":"lyric"},{"id":"23","start":165.69,"end":168.69,"text":"All is found","translation":"","kind":"lyric"},{"id":"24","start":168.82999999999998,"end":171.82999999999998,"text":"All is found","translation":"","kind":"lyric"}],"candidates":[]}