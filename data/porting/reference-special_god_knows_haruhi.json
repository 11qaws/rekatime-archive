{"title":"God knows...","artist":"Aya Hirano","sourceId":"reference:special_god_knows_haruhi","sourceHash":"e442cbc3f056795b157177d02acae67408cd17b2e895059b3526225709254ab9","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":37320045,"cues":[{"id":"1","start":27.0,"end":34.0,"text":"渇いた心で駆け抜ける","translation":"","kind":"lyric"},{"id":"2","start":34.0,"end":40.0,"text":"ごめんね何もできなくて","translation":"","kind":"lyric"},{"id":"3","start":40.0,"end":47.0,"text":"痛みを分かち合うことさえ","translation":"","kind":"lyric"},{"id":"4","start":47.0,"end":53.0,"text":"あなたは許してくれない","translation":"","kind":"lyric"},{"id":"5","start":53.0,"end":59.0,"text":"無垢に生きるため振り向かず","translation":"","kind":"lyric"},{"id":"6","start":59.0,"end":63.0,"text":"背中向けて 去ってしまう","translation":"","kind":"lyric"},{"id":"7","start":63.0,"end":65.0,"text":"On the lonely rail","translation":"","kind":"lyric"},{"id":"8","start":65.0,"end":68.0,"text":"私ついていくよ","translation":"","kind":"lyric"},{"id":"9","start":68.0,"end":73.0,"text":"どんな辛い世界の闇の中でさえ","translation":"","kind":"lyric"},{"id":"10","start":73.0,"end":78.0,"text":"きっとあなたは輝いて","translation":"","kind":"lyric"},{"id":"11","start":78.0,"end":80.0,"text":"超える未来の果て","translation":"","kind":"lyric"},{"id":"12","start":80.0,"end":86.0,"text":"弱さ故に魂こわされぬように","translation":"","kind":"lyric"},{"id":"13","start":86.0,"end":88.0,"text":"my way 重なるよ","translation":"","kind":"lyric"},{"id":"14","start":88.0,"end":121.0,"text":"いまふたりに god bless…","translation":"","kind":"lyric"},{"id":"15","start":121.0,"end":127.0,"text":"届けて熱くなる想いは","translation":"","kind":"lyric"},{"id":"16","start":127.0,"end":134.0,"text":"現実溶かしてさまよう","translation":"","kind":"lyric"},{"id":"17","start":134.0,"end":140.0,"text":"会いたい気持ちに理由はない","translation":"","kind":"lyric"},{"id":"18","start":140.0,"end":146.0,"text":"あなたへあふれだす lovin' you","translation":"","kind":"lyric"},{"id":"19","start":146.0,"end":152.0,"text":"せめて美しい夢だけを","translation":"","kind":"lyric"},{"id":"20","start":152.0,"end":155.0,"text":"描きながら 追いかけよう","translation":"","kind":"lyric"},{"id":"21","start":155.0,"end":158.0,"text":"For your lonely heart","translation":"","kind":"lyric"},{"id":"22","start":158.0,"end":162.0,"text":"やめて嘘はあなたらしくないよ","translation":"","kind":"lyric"},{"id":"23","start":162.0,"end":167.0,"text":"目を見てこれからのことを話そう","translation":"","kind":"lyric"},{"id":"24","start":167.0,"end":171.0,"text":"私が覚悟してる","translation":"","kind":"lyric"},{"id":"25","start":171.0,"end":173.0,"text":"暗い未来だって","translation":"","kind":"lyric"},{"id":"26","start":173.0,"end":178.0,"text":"強くなって運命変えられるかもね","translation":"","kind":"lyric"},{"id":"27","start":178.0,"end":183.0,"text":"My wish かなえたいのに","translation":"","kind":"lyric"},{"id":"28","start":183.0,"end":188.0,"text":"すべては god knows…","translation":"","kind":"lyric"},{"id":"29","start":188.0,"end":193.0,"text":"あなたがいて 私がいて","translation":"","kind":"lyric"},{"id":"30","start":193.0,"end":201.0,"text":"ほかの人は消えてしまった","translation":"","kind":"lyric"},{"id":"31","start":201.0,"end":209.0,"text":"淡い夢の美しさを描きながら","translation":"","kind":"lyric"},{"id":"32","start":209.0,"end":213.0,"text":"傷跡なぞる","translation":"","kind":"lyric"},{"id":"33","start":213.0,"end":218.0,"text":"だから私ついていくよ","translation":"","kind":"lyric"},{"id":"34","start":218.0,"end":223.0,"text":"どんな辛い世界の闇の中でさえ","translation":"","kind":"lyric"},{"id":"35","start":223.0,"end":228.0,"text":"きっとあなたは輝いて","translation":"","kind":"lyric"},{"id":"36","start":228.0,"end":231.0,"text":"超える未来の果て","translation":"","kind":"lyric"},{"id":"37","start":231.0,"end":236.0,"text":"弱さ故に魂こわされぬように","translation":"","kind":"lyric"},{"id":"38","start":236.0,"end":239.0,"text":"My way 重なるよ","translation":"","kind":"lyric"},{"id":"39","start":239.0,"end":246.0,"text":"いまふたりに god bless…","translation":"","kind":"lyric"}],"candidates":[]}