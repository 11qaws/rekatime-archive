{"title":"Queen of Mean","artist":"Descendants","sourceId":"reference:TPzvpBt2P6EgmcIVzh55","sourceHash":"d352dca9efdd2717c45fd9c60b535cbe9e61414e64b6cfb1f9ee8e33c38b8510","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":5.4,"end":8.33,"text":"I'm so tired of pretending","translation":"","kind":"lyric"},{"id":"2","start":8.33,"end":11.13,"text":"Where's my happy ending?","translation":"","kind":"lyric"},{"id":"3","start":11.13,"end":13.94,"text":"I followed all the rules, I drew inside the lines","translation":"","kind":"lyric"},{"id":"4","start":13.94,"end":16.56,"text":"I never asked for anything that wasn't mine","translation":"","kind":"lyric"},{"id":"5","start":16.56,"end":19.5,"text":"I waited patiently for my time, but when it finally came","translation":"","kind":"lyric"},{"id":"6","start":19.5,"end":21.21,"text":"He called her name","translation":"","kind":"lyric"},{"id":"7","start":21.21,"end":23.21,"text":"And now I feel this overwhelming pain","translation":"","kind":"lyric"},{"id":"8","start":23.21,"end":24.69,"text":"I mean it's in my veins","translation":"","kind":"lyric"},{"id":"9","start":24.69,"end":26.04,"text":"I mean it's in my brain","translation":"","kind":"lyric"},{"id":"10","start":26.04,"end":28.76,"text":"My thoughts are running in a circle like a toy train","translation":"","kind":"lyric"},{"id":"11","start":28.76,"end":31.52,"text":"I'm kinda like a perfect picture with a broken frame","translation":"","kind":"lyric"},{"id":"12","start":31.52,"end":34.29,"text":"I know exactly who to blame","translation":"","kind":"lyric"},{"id":"13","start":34.29,"end":37.29,"text":"I never thought of myself as mean","translation":"","kind":"lyric"},{"id":"14","start":39.81,"end":42.81,"text":"I always thought that I'd be the queen","translation":"","kind":"lyric"},{"id":"15","start":43.31,"end":45.22,"text":"And there's no in between","translation":"","kind":"lyric"},{"id":"16","start":45.22,"end":47.02,"text":"'Cause if I can't have that","translation":"","kind":"lyric"},{"id":"17","start":47.02,"end":50.02,"text":"Then I would be the leader of the dark and the bad","translation":"","kind":"lyric"},{"id":"18","start":50.1,"end":51.62,"text":"Now there's a devil on my shoulder","translation":"","kind":"lyric"},{"id":"19","start":51.62,"end":53.78,"text":"Where the angels used to be","translation":"","kind":"lyric"},{"id":"20","start":53.78,"end":56.78,"text":"And it's calling me the queen","translation":"","kind":"lyric"},{"id":"21","start":57.94,"end":60.5,"text":"Being nice was my pastime","translation":"","kind":"lyric"},{"id":"22","start":60.5,"end":63.34,"text":"But I've been hurt for the last time","translation":"","kind":"lyric"},{"id":"23","start":63.34,"end":66.28,"text":"And I won't ever let another person take advantage of me","translation":"","kind":"lyric"},{"id":"24","start":66.28,"end":69.08,"text":"The anger burns my skin, third-degree","translation":"","kind":"lyric"},{"id":"25","start":69.08,"end":71.71000000000001,"text":"Now my blood's boiling hotter than a fiery sea","translation":"","kind":"lyric"},{"id":"26","start":71.71000000000001,"end":73.59,"text":"There's nobody getting close to me","translation":"","kind":"lyric"},{"id":"27","start":73.59,"end":75.83,"text":"They're gonna bow to the Evil Queen","translation":"","kind":"lyric"},{"id":"28","start":75.83,"end":77.35,"text":"Your nightmare's my dream","translation":"","kind":"lyric"},{"id":"29","start":77.35,"end":80.35,"text":"Just wait until they fall to my wicked schemes","translation":"","kind":"lyric"},{"id":"30","start":81.19,"end":84.19,"text":"I never thought of myself as mean","translation":"","kind":"lyric"},{"id":"31","start":86.59,"end":89.59,"text":"I always thought that I'd be the queen","translation":"","kind":"lyric"},{"id":"32","start":90.23,"end":92.14,"text":"And there's no in between","translation":"","kind":"lyric"},{"id":"33","start":92.14,"end":93.9,"text":"'Cause if I can't have that","translation":"","kind":"lyric"},{"id":"34","start":93.9,"end":96.9,"text":"Then I would be the leader of the dark and the bad","translation":"","kind":"lyric"},{"id":"35","start":97.1,"end":98.55,"text":"Now there's a devil on my shoulder","translation":"","kind":"lyric"},{"id":"36","start":98.55,"end":100.52000000000001,"text":"Where the angels used to be","translation":"","kind":"lyric"},{"id":"37","start":100.52000000000001,"end":103.52000000000001,"text":"And he's calling me the queen of mean","translation":"","kind":"lyric"},{"id":"38","start":103.68,"end":106.31,"text":"(Calling me, calling me) The queen of mean","translation":"","kind":"lyric"},{"id":"39","start":106.31,"end":109.03,"text":"(Calling me, calling me)","translation":"","kind":"lyric"},{"id":"40","start":109.03,"end":112.03,"text":"(Calling me, calling me) The queen of mean","translation":"","kind":"lyric"},{"id":"41","start":113.28,"end":116.24000000000001,"text":"Something's pulling me, it's so magnetic","translation":"","kind":"lyric"},{"id":"42","start":116.24000000000001,"end":118.83,"text":"My body is moving, unsure where I'm headed","translation":"","kind":"lyric"},{"id":"43","start":118.83,"end":121.4,"text":"All of my senses have left me defenseless","translation":"","kind":"lyric"},{"id":"44","start":121.4,"end":124.19,"text":"This darkness around me is promising vengeance","translation":"","kind":"lyric"},{"id":"45","start":124.19,"end":126.91,"text":"The price that I'm willing to pay is expensive","translation":"","kind":"lyric"},{"id":"46","start":126.91,"end":129.63,"text":"There's nothing to lose when you're lonely and friendless","translation":"","kind":"lyric"},{"id":"47","start":129.63,"end":132.51,"text":"So my only interest is showing this princess","translation":"","kind":"lyric"},{"id":"48","start":132.51,"end":135.51,"text":"That I am the queen and my reign will be endless!","translation":"","kind":"lyric"},{"id":"49","start":137.03,"end":139.95,"text":"I want what I deserve","translation":"","kind":"lyric"},{"id":"50","start":139.95,"end":142.55,"text":"I wanna rule the world","translation":"","kind":"lyric"},{"id":"51","start":142.55,"end":145.55,"text":"Sit back and watch them learn","translation":"","kind":"lyric"},{"id":"52","start":146.22,"end":149.22,"text":"It's finally my turn","translation":"","kind":"lyric"},{"id":"53","start":150.67000000000002,"end":153.67000000000002,"text":"If they want a villain for a queen","translation":"","kind":"lyric"},{"id":"54","start":155.6,"end":158.6,"text":"I'm gonna be one like they've never seen","translation":"","kind":"lyric"},{"id":"55","start":159.25,"end":161.48,"text":"I'll show them what it means","translation":"","kind":"lyric"},{"id":"56","start":161.48,"end":163.0,"text":"Now that I am there","translation":"","kind":"lyric"},{"id":"57","start":163.0,"end":166.0,"text":"I will be the ruler of the dark and the bad","translation":"","kind":"lyric"},{"id":"58","start":166.04,"end":167.72,"text":"'Cause the devil's on my shoulder","translation":"","kind":"lyric"},{"id":"59","start":167.72,"end":169.48,"text":"Where the angels used to be","translation":"","kind":"lyric"},{"id":"60","start":169.48,"end":172.48,"text":"And he's calling me the queen of mean","translation":"","kind":"lyric"},{"id":"61","start":172.76,"end":175.46,"text":"(Calling me, calling me)","translation":"","kind":"lyric"},{"id":"62","start":175.46,"end":178.25,"text":"(Calling me, calling me) The queen of mean","translation":"","kind":"lyric"},{"id":"63","start":178.25,"end":181.25,"text":"(Calling me, calling me)","translation":"","kind":"lyric"},{"id":"64","start":181.25,"end":184.25,"text":"I want what I deserve!","translation":"","kind":"lyric"}],"candidates":[]}