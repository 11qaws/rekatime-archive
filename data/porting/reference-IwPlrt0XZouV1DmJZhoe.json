{"title":"Honey I'm Home","artist":"GHOST","sourceId":"reference:IwPlrt0XZouV1DmJZhoe","sourceHash":"5ec355325a0e81ac9547fd0949587e6c269725016b0602fba49a88356503e5cb","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":35.88,"end":38.88,"text":"Father said that this world isn't for me","translation":"","kind":"lyric"},{"id":"2","start":39.61,"end":42.61,"text":"I tried to pray for a new reality","translation":"","kind":"lyric"},{"id":"3","start":43.66,"end":46.66,"text":"So, come to me, we can change night into day","translation":"","kind":"lyric"},{"id":"4","start":47.85,"end":50.85,"text":"A tied-up moth seemed to know a different way","translation":"","kind":"lyric"},{"id":"5","start":51.96,"end":53.62,"text":"(Don't remember it, don't return to it)","translation":"","kind":"lyric"},{"id":"6","start":53.62,"end":56.62,"text":"Oh, father tore out the umbilical cord","translation":"","kind":"lyric"},{"id":"7","start":57.75,"end":60.75,"text":"There's nothing left in the bottle keeping me scored","translation":"","kind":"lyric"},{"id":"8","start":61.53,"end":64.52,"text":"We'll abandon the scenery","translation":"","kind":"lyric"},{"id":"9","start":64.52,"end":67.52,"text":"In the (don't remember it, don't return to it)","translation":"","kind":"lyric"},{"id":"10","start":67.94,"end":70.2,"text":"Rearview mirror","translation":"","kind":"lyric"},{"id":"11","start":70.2,"end":71.9,"text":"A petty line of white noise","translation":"","kind":"lyric"},{"id":"12","start":71.9,"end":74.21000000000001,"text":"Pack up your bags, and throw out the toys","translation":"","kind":"lyric"},{"id":"13","start":74.21000000000001,"end":75.82,"text":"Three strikes and, \"Honey, I'm home!\"","translation":"","kind":"lyric"},{"id":"14","start":75.82,"end":78.23,"text":"Three voices come from the gramophone","translation":"","kind":"lyric"},{"id":"15","start":78.23,"end":79.89,"text":"A vivisection of me","translation":"","kind":"lyric"},{"id":"16","start":79.89,"end":81.98,"text":"Yielded the start of a mystery","translation":"","kind":"lyric"},{"id":"17","start":81.98,"end":84.07,"text":"Say, \"Hello! Honey, I'm home!\"","translation":"","kind":"lyric"},{"id":"18","start":84.07,"end":87.07,"text":"Three voices come from the gramophone","translation":"","kind":"lyric"},{"id":"19","start":101.85,"end":104.85,"text":"God returned with the moth chained to his hand","translation":"","kind":"lyric"},{"id":"20","start":105.7,"end":108.7,"text":"\"There's so many things that you'll never understand\"","translation":"","kind":"lyric"},{"id":"21","start":109.63,"end":112.63,"text":"\"So, come to me, we can change night into day\"","translation":"","kind":"lyric"},{"id":"22","start":113.64,"end":116.64,"text":"\"You'll hold my hand, so you'll never go astray\"","translation":"","kind":"lyric"},{"id":"23","start":118.06,"end":121.06,"text":"God devoured that of father","translation":"","kind":"lyric"},{"id":"24","start":125.59,"end":128.59,"text":"A spider preaching, with poison on its lips","translation":"","kind":"lyric"},{"id":"25","start":129.78,"end":132.78,"text":"\"To get out of here is to promise me a kiss\"","translation":"","kind":"lyric"},{"id":"26","start":133.41,"end":136.41,"text":"The abandonment of scenery","translation":"","kind":"lyric"},{"id":"27","start":136.5,"end":139.5,"text":"In the","translation":"","kind":"lyric"},{"id":"28","start":139.96,"end":142.04,"text":"Mind of mother","translation":"","kind":"lyric"},{"id":"29","start":142.04,"end":144.09,"text":"(Don't remember it, don't return to it)","translation":"","kind":"lyric"},{"id":"30","start":144.09,"end":146.19,"text":"(So, with advice of the dead)","translation":"","kind":"lyric"},{"id":"31","start":146.19,"end":148.32999999999998,"text":"(And a halo over my head)","translation":"","kind":"lyric"},{"id":"32","start":148.32999999999998,"end":149.8,"text":"At last, \"Honey, I'm home!\"","translation":"","kind":"lyric"},{"id":"33","start":149.8,"end":152.46,"text":"Three voices come, all alone","translation":"","kind":"lyric"},{"id":"34","start":152.46,"end":154.09,"text":"A vivisection of me","translation":"","kind":"lyric"},{"id":"35","start":154.09,"end":155.87,"text":"Done by God, for all to see","translation":"","kind":"lyric"},{"id":"36","start":155.87,"end":158.09,"text":"Say, \"Hello! Honey, I'm home!\"","translation":"","kind":"lyric"},{"id":"37","start":158.09,"end":160.24,"text":"Three voices come all alone","translation":"","kind":"lyric"},{"id":"38","start":160.24,"end":162.1,"text":"(Duh-duh-duh, duh-duh-duh)","translation":"","kind":"lyric"},{"id":"39","start":162.1,"end":164.31,"text":"(Duh-duh-duh, duh-duh-duh)","translation":"","kind":"lyric"},{"id":"40","start":164.31,"end":166.09,"text":"A vivisection of me","translation":"","kind":"lyric"},{"id":"41","start":166.09,"end":168.11,"text":"Done by God, for all to see","translation":"","kind":"lyric"},{"id":"42","start":168.11,"end":170.02,"text":"(Duh-duh-duh, duh-duh-duh)","translation":"","kind":"lyric"},{"id":"43","start":170.02,"end":172.2,"text":"(Duh-duh-duh, duh-duh-duh)","translation":"","kind":"lyric"},{"id":"44","start":172.2,"end":173.93,"text":"A vivisection of me","translation":"","kind":"lyric"},{"id":"45","start":173.93,"end":176.93,"text":"Done by God, for all to see","translation":"","kind":"lyric"}],"candidates":[]}