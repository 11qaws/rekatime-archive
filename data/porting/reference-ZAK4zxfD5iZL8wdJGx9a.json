{"title":"아이돌","artist":"YOASOBI","sourceId":"reference:ZAK4zxfD5iZL8wdJGx9a","sourceHash":"594b28df32ac7263b9e6c3137f3597edf5428e356ef98e200af9c0416cfc3a61","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":36763278,"cues":[{"id":"1","start":0.88,"end":3.78,"text":"無敵の笑顔で荒らすメディア","translation":"","kind":"lyric"},{"id":"2","start":3.78,"end":6.4,"text":"知りたいその秘密ミステリアス","translation":"","kind":"lyric"},{"id":"3","start":6.4,"end":8.83,"text":"抜けてるとこさえ彼女のエリア","translation":"","kind":"lyric"},{"id":"4","start":8.83,"end":12.07,"text":"完璧で嘘つきな君は","translation":"","kind":"lyric"},{"id":"5","start":12.07,"end":15.16,"text":"天才的なアイドル様","translation":"","kind":"lyric"},{"id":"6","start":15.16,"end":17.86,"text":"(Oh, my savior, oh, my saving grace)","translation":"","kind":"lyric"},{"id":"7","start":17.86,"end":19.21,"text":"今日何食べた？","translation":"","kind":"lyric"},{"id":"8","start":19.21,"end":20.64,"text":"好きな本は？","translation":"","kind":"lyric"},{"id":"9","start":20.64,"end":23.32,"text":"遊びに行くならどこに行くの？","translation":"","kind":"lyric"},{"id":"10","start":23.32,"end":24.87,"text":"何も食べてない","translation":"","kind":"lyric"},{"id":"11","start":24.87,"end":26.31,"text":"それは内緒","translation":"","kind":"lyric"},{"id":"12","start":26.31,"end":29.15,"text":"何を聞かれても のらりくらり","translation":"","kind":"lyric"},{"id":"13","start":29.15,"end":30.38,"text":"そう 淡々と","translation":"","kind":"lyric"},{"id":"14","start":30.38,"end":31.83,"text":"だけど燦々と","translation":"","kind":"lyric"},{"id":"15","start":31.83,"end":34.59,"text":"見えそうで見えない秘密は蜜の味","translation":"","kind":"lyric"},{"id":"16","start":34.59,"end":36.25,"text":"あれもないないない","translation":"","kind":"lyric"},{"id":"17","start":36.25,"end":37.66,"text":"これもないないない","translation":"","kind":"lyric"},{"id":"18","start":37.66,"end":38.81,"text":"好きなタイプは？","translation":"","kind":"lyric"},{"id":"19","start":38.81,"end":39.78,"text":"相手は？","translation":"","kind":"lyric"},{"id":"20","start":39.78,"end":40.87,"text":"さあ 答えて","translation":"","kind":"lyric"},{"id":"21","start":40.87,"end":46.29,"text":"「誰かを好きになることなんて私分からなくてさ」","translation":"","kind":"lyric"},{"id":"22","start":46.29,"end":49.41,"text":"嘘か本当か知り得ない","translation":"","kind":"lyric"},{"id":"23","start":49.41,"end":52.9,"text":"そんな言葉にまた一人堕ちる","translation":"","kind":"lyric"},{"id":"24","start":52.9,"end":55.12,"text":"また好きにさせる","translation":"","kind":"lyric"},{"id":"25","start":55.12,"end":57.99,"text":"誰もが目を奪われてく","translation":"","kind":"lyric"},{"id":"26","start":57.99,"end":61.06,"text":"君は完璧で究極のアイドル","translation":"","kind":"lyric"},{"id":"27","start":61.06,"end":63.52,"text":"金輪際現れない","translation":"","kind":"lyric"},{"id":"28","start":63.52,"end":67.43,"text":"一番星の生まれ変わり あぁ","translation":"","kind":"lyric"},{"id":"29","start":67.43,"end":68.95,"text":"その笑顔で","translation":"","kind":"lyric"},{"id":"30","start":68.95,"end":70.41,"text":"愛してるで","translation":"","kind":"lyric"},{"id":"31","start":70.41,"end":72.82,"text":"誰も彼も虜にしていく","translation":"","kind":"lyric"},{"id":"32","start":72.82,"end":74.75,"text":"その瞳が","translation":"","kind":"lyric"},{"id":"33","start":74.75,"end":75.9,"text":"その言葉が","translation":"","kind":"lyric"},{"id":"34","start":75.9,"end":78.64,"text":"嘘でも それは完全なアイ","translation":"","kind":"lyric"},{"id":"35","start":78.64,"end":81.52,"text":"はいはい あの子は特別です","translation":"","kind":"lyric"},{"id":"36","start":81.52,"end":84.07,"text":"我々はハナからおまけです","translation":"","kind":"lyric"},{"id":"37","start":84.07,"end":87.51,"text":"お星さまの引き立て役Bです","translation":"","kind":"lyric"},{"id":"38","start":87.51,"end":90.23,"text":"全てがあの子のお陰なわけない","translation":"","kind":"lyric"},{"id":"39","start":90.23,"end":90.82,"text":"洒落臭い","translation":"","kind":"lyric"},{"id":"40","start":90.82,"end":92.93,"text":"妬み 嫉妬なんてないわけがない","translation":"","kind":"lyric"},{"id":"41","start":92.93,"end":93.92,"text":"これはネタじゃない","translation":"","kind":"lyric"},{"id":"42","start":93.92,"end":95.25,"text":"からこそ許せない","translation":"","kind":"lyric"},{"id":"43","start":95.25,"end":97.47999999999999,"text":"完璧じゃない君じゃ許せない","translation":"","kind":"lyric"},{"id":"44","start":97.47999999999999,"end":98.3,"text":"自分を許せない","translation":"","kind":"lyric"},{"id":"45","start":98.3,"end":101.08,"text":"誰よりも強い君以外は認めない","translation":"","kind":"lyric"},{"id":"46","start":101.08,"end":103.78,"text":"誰もが信じ崇めてる","translation":"","kind":"lyric"},{"id":"47","start":103.78,"end":107.35,"text":"まさに最強で無敵のアイドル","translation":"","kind":"lyric"},{"id":"48","start":107.35,"end":109.74000000000001,"text":"弱点なんて見当たらない","translation":"","kind":"lyric"},{"id":"49","start":109.74000000000001,"end":112.89,"text":"一番星を宿してる","translation":"","kind":"lyric"},{"id":"50","start":112.89,"end":115.84,"text":"弱いとこなんて見せちゃダメダメ","translation":"","kind":"lyric"},{"id":"51","start":115.84,"end":118.81,"text":"知りたくないとこは見せずに","translation":"","kind":"lyric"},{"id":"52","start":118.81,"end":121.79,"text":"唯一無二じゃなくちゃイヤイヤ","translation":"","kind":"lyric"},{"id":"53","start":121.79,"end":125.35,"text":"それこそ本物のアイ","translation":"","kind":"lyric"},{"id":"54","start":125.35,"end":128.22,"text":"得意の笑顔で沸かすメディア","translation":"","kind":"lyric"},{"id":"55","start":128.22,"end":131.02,"text":"隠しきる この秘密だけは","translation":"","kind":"lyric"},{"id":"56","start":131.02,"end":134.54,"text":"愛してるって嘘で積むキャリア","translation":"","kind":"lyric"},{"id":"57","start":134.54,"end":137.49,"text":"これこそ私なりの愛だ","translation":"","kind":"lyric"},{"id":"58","start":137.49,"end":140.94,"text":"流れる汗も綺麗なアクア","translation":"","kind":"lyric"},{"id":"59","start":140.94,"end":143.99,"text":"ルビーを隠したこの瞼","translation":"","kind":"lyric"},{"id":"60","start":143.99,"end":147.34,"text":"歌い 踊り 舞う私はマリア","translation":"","kind":"lyric"},{"id":"61","start":147.34,"end":151.45,"text":"そう 嘘はとびきりの愛だ","translation":"","kind":"lyric"},{"id":"62","start":151.45,"end":154.49,"text":"誰かに愛されたことも","translation":"","kind":"lyric"},{"id":"63","start":154.49,"end":157.99,"text":"誰かのこと愛したこともない","translation":"","kind":"lyric"},{"id":"64","start":157.99,"end":163.75,"text":"そんな私の嘘がいつか本当になること","translation":"","kind":"lyric"},{"id":"65","start":163.75,"end":165.14,"text":"（信じてる）","translation":"","kind":"lyric"},{"id":"66","start":165.14,"end":167.71,"text":"いつかきっと全部手に入れる","translation":"","kind":"lyric"},{"id":"67","start":167.71,"end":171.03,"text":"私はそう 欲張りなアイドル","translation":"","kind":"lyric"},{"id":"68","start":171.03,"end":173.66,"text":"等身大でみんなのこと","translation":"","kind":"lyric"},{"id":"69","start":173.66,"end":176.65,"text":"ちゃんと愛したいから","translation":"","kind":"lyric"},{"id":"70","start":176.65,"end":178.85,"text":"今日も嘘をつくの","translation":"","kind":"lyric"},{"id":"71","start":178.85,"end":183.0,"text":"この言葉がいつか本当になる日を願って","translation":"","kind":"lyric"},{"id":"72","start":183.0,"end":188.56,"text":"それでもまだ君と君にだけは言えずにいたけど","translation":"","kind":"lyric"},{"id":"73","start":188.56,"end":190.5,"text":"あぁ やっと言えた","translation":"","kind":"lyric"},{"id":"74","start":190.5,"end":192.89,"text":"これは絶対嘘じゃない","translation":"","kind":"lyric"},{"id":"75","start":192.89,"end":195.84,"text":"愛してる","translation":"","kind":"lyric"},{"id":"76","start":206.86,"end":209.78,"text":"(Oh, my savior, my true savior, my saving grace)","translation":"","kind":"lyric"}],"candidates":[]}