{"title":"나는 최강","artist":"Ado","date":"2026-07-29","sourceId":"ZFMg5irJJU8:013","sourceHash":"ce8c627967f3d9f0a0659c2f8f90f989c42d4fd37586eb6a65e91e5ba549957c","duration":256.66,"cues":[{"id":"1","start":7.27,"end":9.81,"text":"さぁ 怖くはない","translation":"자 두렵지 않아","kind":"lyric"},{"id":"2","start":9.81,"end":12.35,"text":"不安はない","translation":"불안하지 않아","kind":"lyric"},{"id":"3","start":12.35,"end":17.15,"text":"私の夢は みんなの願い","translation":"나의 꿈은 모두의 소원","kind":"lyric"},{"id":"4","start":17.15,"end":22.53,"text":"歌唄えば ココロ晴れる","translation":"노래하면 마음이 맑아져","kind":"lyric"},{"id":"5","start":22.53,"end":27.22,"text":"大丈夫よ 私は最強","translation":"괜찮아 나는 최강","kind":"lyric"},{"id":"6","start":36.77,"end":39.31,"text":"私の声が","translation":"나의 목소리가","kind":"lyric"},{"id":"7","start":39.31,"end":42.4,"text":"小鳥を空へ運ぶ","translation":"작은 새를 하늘로 데려가","kind":"lyric"},{"id":"8","start":42.71,"end":46.61,"text":"靡いた服も踊り子みたいでさ","translation":"나부끼는 옷도 무용수처럼 춤춰","kind":"lyric"},{"id":"9","start":46.61,"end":49.37,"text":"あなたの声が","translation":"너의 목소리가","kind":"lyric"},{"id":"10","start":49.37,"end":52.5,"text":"私を奮い立たせる","translation":"나를 북돋아 줘","kind":"lyric"},{"id":"11","start":52.87,"end":57.29,"text":"トゲが刺さってしまったなら ほらほらおいで","translation":"가시에 찔렸다면 자 이리 와","kind":"lyric"},{"id":"12","start":57.29,"end":61.83,"text":"見たことない 新しい景色","translation":"본 적 없는 새로운 풍경","kind":"lyric"},{"id":"13","start":61.83,"end":64.73,"text":"絶対に観れるの","translation":"반드시 볼 수 있어","kind":"lyric"},{"id":"14","start":64.73,"end":66.37,"text":"なぜならば","translation":"왜냐하면","kind":"lyric"},{"id":"15","start":66.37,"end":69.14,"text":"生きてるんだ今日も","translation":"오늘도 살아 있으니까","kind":"lyric"},{"id":"16","start":69.2,"end":72.85,"text":"さぁ、握る手と手","translation":"자 맞잡은 손과 손","kind":"lyric"},{"id":"17","start":73.44,"end":74.98,"text":"ヒカリの方へ","translation":"빛이 있는 곳으로","kind":"lyric"},{"id":"18","start":74.98,"end":79.64,"text":"みんなの夢は 私の幸せ","translation":"모두의 꿈은 나의 행복","kind":"lyric"},{"id":"19","start":79.64,"end":84.9,"text":"あぁ、きっとどこにもない アナタしか持ってない","translation":"아아 분명 어디에도 없는 오직 너만 가진","kind":"lyric"},{"id":"20","start":84.9,"end":90.45,"text":"その温もりで 私は最強","translation":"그 온기로 나는 최강","kind":"lyric"},{"id":"21","start":101.02,"end":101.6,"text":"回り道でも","translation":"돌아가는 길이어도","kind":"lyric"},{"id":"22","start":101.6,"end":104.77,"text":"私が歩けば正解","translation":"내가 걸으면 정답","kind":"lyric"},{"id":"23","start":105.0,"end":107.05,"text":"わかっているけど","translation":"알고 있지만","kind":"lyric"},{"id":"24","start":107.3,"end":109.58,"text":"引くに引けなくてさ","translation":"이제 물러설 수 없어서","kind":"lyric"},{"id":"25","start":109.58,"end":113.01,"text":"無理はちょっとしてでも","translation":"조금 무리해서라도","kind":"lyric"},{"id":"26","start":113.62,"end":115.94,"text":"花に水はあげたいわ","translation":"꽃에 물을 주고 싶어","kind":"lyric"},{"id":"27","start":115.94,"end":120.36,"text":"そうやっぱ したいことしなきゃ","translation":"그래 역시 하고 싶은 걸 해야 해","kind":"lyric"},{"id":"28","start":120.36,"end":126.5,"text":"腐るでしょう？ 期待には応えるの","translation":"썩어 버리잖아 기대에는 답할게","kind":"lyric"},{"id":"29","start":130.77,"end":135.51,"text":"いつか来るだろう 素晴らしき時代","translation":"언젠가 오겠지 멋진 시대","kind":"lyric"},{"id":"30","start":135.51,"end":140.4,"text":"今はただ待ってる 誰かをね","translation":"지금은 그저 누군가를 기다리고 있어","kind":"lyric"},{"id":"31","start":142.33,"end":145.46,"text":"繰り返してる 傷ましい苦味","translation":"되풀이되는 아픈 쓴맛","kind":"lyric"},{"id":"32","start":145.65,"end":150.27,"text":"火を灯す準備は出来てるの？","translation":"불을 밝힐 준비는 됐어","kind":"lyric"},{"id":"33","start":150.27,"end":151.84,"text":"いざ行かん 最高峰","translation":"자 가자 최고봉으로","kind":"lyric"},{"id":"34","start":152.67,"end":156.13,"text":"さぁ、怖くはない？","translation":"자 두렵지 않아","kind":"lyric"},{"id":"35","start":156.13,"end":158.59,"text":"不安はない？","translation":"불안하지 않아","kind":"lyric"},{"id":"36","start":158.59,"end":164.06,"text":"私の思いは 皆んなには重い？","translation":"나의 마음은 모두에게 무거워","kind":"lyric"},{"id":"37","start":166.55,"end":168.79,"text":"歌唄えば 霧も晴れる","translation":"노래하면 안개도 걷혀","kind":"lyric"},{"id":"38","start":168.79,"end":173.58,"text":"見事なまでに 私は最恐","translation":"놀라울 만큼 나는 가장 두려운 존재","kind":"lyric"},{"id":"39","start":192.03,"end":196.68,"text":"さぁ、握る手と手","translation":"자 맞잡은 손과 손","kind":"lyric"},{"id":"40","start":197.19,"end":198.73,"text":"ヒカリの方へ","translation":"빛이 있는 곳으로","kind":"lyric"},{"id":"41","start":198.73,"end":203.41,"text":"みんなの夢は 私の願い","translation":"모두의 꿈은 나의 소원","kind":"lyric"},{"id":"42","start":203.41,"end":209.04,"text":"きっとどこにもない アナタしか持ってない","translation":"분명 어디에도 없는 오직 너만 가진","kind":"lyric"},{"id":"43","start":209.93,"end":212.83,"text":"その弱さが 照らすの","translation":"그 약함이 비추는","kind":"lyric"},{"id":"44","start":212.83,"end":216.51,"text":"最愛の日々","translation":"가장 사랑하는 나날","kind":"lyric"},{"id":"45","start":216.51,"end":219.12,"text":"忘れぬ誓い","translation":"잊지 않을 맹세","kind":"lyric"},{"id":"46","start":219.33,"end":222.28,"text":"いつかの夢が 私の心臓","translation":"언젠가의 꿈이 나의 심장","kind":"lyric"},{"id":"47","start":224.29,"end":229.02,"text":"何度でも 何度でも 言うわ","translation":"몇 번이고 몇 번이고 말할게","kind":"lyric"},{"id":"48","start":231.37,"end":234.16,"text":"「私は最強」","translation":"나는 최강","kind":"lyric"},{"id":"49","start":237.33,"end":239.26,"text":"「アナタと最強」","translation":"너와 함께 최강","kind":"lyric"},{"id":"50","start":244.03,"end":247.58,"text":"最強になりたい","translation":"최강이 되고 싶어","kind":"lyric"},{"id":"51","start":252.35,"end":253.9,"text":"「アナタと最強」","translation":"너와 함께 최강","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}