{"title":"Tot Musica","artist":"Ado","date":"2026-09-06","sourceId":"15069207:013","sourceHash":"a81ce4f23871c8dd7b6fecf4e3b6b1b50c7c121b348e4b1c10dd7be65abf55d0","duration":193.1,"cues":[{"id":"1","start":5.627,"end":12.762,"text":"ᚷᚨᚺ ᛉᚨᚾ ᛏᚨᚲ ᚷᚨᚺ ᛉᚨᚾ ᛏᚨᛏ ᛏᚨᛏ ᛒᚱᚨᚲ","translation":"가 잔 타크 가 잔 탓 탓 브라크","kind":"lyric"},{"id":"2","start":12.762,"end":20.15,"text":"ᚷᚨᚺ ᛉᚨᚾ ᛏᚨᚲ ᚷᚨᚺ ᛉᚨᚾ ᛏᚨᛏ ᛏᚨᛏ ᛒᚱᚨᚲ","translation":"가 잔 타크 가 잔 탓 탓 브라크","kind":"lyric"},{"id":"3","start":21.247,"end":27.591,"text":"雨打つ心 彷徨う何処","translation":"비에 얻어맞는 마음은 어디를 헤매나","kind":"lyric"},{"id":"4","start":27.591,"end":30.983,"text":"枯れ果てず湧く願いと涙","translation":"마르지 않고 솟는 소원과 눈물","kind":"lyric"},{"id":"5","start":30.983,"end":35.836,"text":"解き放つ 呪を紡ぐ言の葉","translation":"해방하라 저주를 엮는 말들을","kind":"lyric"},{"id":"6","start":35.836,"end":37.367,"text":"ᛗᛁᛖ ᚾᛖᚷ ᛟᚾ ᚷᛁᛖᚲ ᚷᛁᛖᚲ","translation":"미에 네그 온 기에크 기에크","kind":"lyric"},{"id":"7","start":37.367,"end":39.909,"text":"ᚾᚨᚺ ᛈᚺᚨᛋ ᛏᛖᛉᛉᛖ ᛚᚨᚺ","translation":"나 파스 테제 라","kind":"lyric"},{"id":"8","start":39.909,"end":43.181,"text":"Wow-hey-wow","translation":"워 헤이 워","kind":"lyric"},{"id":"9","start":43.181,"end":46.593,"text":"死をも転がす救いの讃歌","translation":"죽음마저 뒤엎는 구원의 찬가","kind":"lyric"},{"id":"10","start":46.593,"end":49.424,"text":"求められたる救世主","translation":"갈구해 온 구세주","kind":"lyric"},{"id":"11","start":49.424,"end":56.889,"text":"祈りの間で惑う","translation":"기도 사이에서 헤매","kind":"lyric"},{"id":"12","start":56.889,"end":63.623,"text":"唯 海の凪ぐ未来を乞う","translation":"오직 바다가 잔잔해질 미래를 빌어","kind":"lyric"},{"id":"13","start":63.623,"end":67.175,"text":"その傲岸無礼な慟哭を","translation":"그 오만불손한 통곡을","kind":"lyric"},{"id":"14","start":67.175,"end":71.068,"text":"惰性なき愁いには忘却を","translation":"타성 없는 슬픔에는 망각을","kind":"lyric"},{"id":"15","start":71.068,"end":74.39,"text":"さあ 混沌の時代には終止符を","translation":"자 혼돈의 시대에 종지부를","kind":"lyric"},{"id":"16","start":74.39,"end":78.703,"text":"いざ無礙に blah blah blah!","translation":"자 거침없이 blah blah blah","kind":"lyric"},{"id":"17","start":78.703,"end":82.705,"text":"無条件 絶対 激昂なら singing the song","translation":"무조건 절대 격앙이라면 singing the song","kind":"lyric"},{"id":"18","start":82.705,"end":86.477,"text":"如何せん罵詈雑言でも singing the song","translation":"아무리 온갖 욕설이어도 singing the song","kind":"lyric"},{"id":"19","start":86.477,"end":90.009,"text":"有象無象の Big Bang 慈しみ深く","translation":"온갖 군상의 Big Bang 자비롭게","kind":"lyric"},{"id":"20","start":90.009,"end":95.68,"text":"怒れ 集え 謳え 破滅の譜を","translation":"분노하라 모여라 노래하라 파멸의 악보를","kind":"lyric"},{"id":"21","start":98.215,"end":100.026,"text":"ᛗᛁᛖ ᚾᛖᚷ ᛟᚾ ᚷᛁᛖᚲ ᚷᛁᛖᚲ","translation":"미에 네그 온 기에크 기에크","kind":"lyric"},{"id":"22","start":100.026,"end":102.677,"text":"ᚾᚨᚺ ᛈᚺᚨᛋ ᛏᛖᛉᛉᛖ ᛚᚨᚺ","translation":"나 파스 테제 라","kind":"lyric"},{"id":"23","start":102.677,"end":105.579,"text":"Wow-hey-wow","translation":"워 헤이 워","kind":"lyric"},{"id":"24","start":105.579,"end":109.131,"text":"誓い立てし自由 手にして謳歌","translation":"맹세해 세운 자유를 손에 넣고 구가해","kind":"lyric"},{"id":"25","start":109.131,"end":112.213,"text":"平伏されたる救世主","translation":"모두가 엎드린 구세주","kind":"lyric"},{"id":"26","start":112.213,"end":119.478,"text":"逃亡の果て望む希望","translation":"도피의 끝에 바라는 희망","kind":"lyric"},{"id":"27","start":119.478,"end":126.132,"text":"忘れじの灯火を纏う","translation":"잊지 못할 등불을 두르고","kind":"lyric"},{"id":"28","start":126.132,"end":129.984,"text":"その身が尽きるまで奏でよ","translation":"그 몸이 다할 때까지 연주하라","kind":"lyric"},{"id":"29","start":129.984,"end":133.526,"text":"夢見うつつ崇めよ","translation":"꿈과 현실 사이 숭배하라","kind":"lyric"},{"id":"30","start":133.526,"end":137.068,"text":"全てを照らし出す光を","translation":"모든 것을 비추는 빛을","kind":"lyric"},{"id":"31","start":137.068,"end":140.841,"text":"いざ無礙に blah blah blah!","translation":"자 거침없이 blah blah blah","kind":"lyric"},{"id":"32","start":140.841,"end":144.603,"text":"その傲岸無礼な慟哭を","translation":"그 오만불손한 통곡을","kind":"lyric"},{"id":"33","start":144.603,"end":148.446,"text":"残響激励すら忘却を","translation":"울려 퍼진 격려마저 망각을","kind":"lyric"},{"id":"34","start":148.446,"end":151.938,"text":"さあ 混沌の時代には終止符を","translation":"자 혼돈의 시대에 종지부를","kind":"lyric"},{"id":"35","start":151.938,"end":156.19,"text":"いざ無礙に blah blah blah!","translation":"자 거침없이 blah blah blah","kind":"lyric"},{"id":"36","start":156.19,"end":159.973,"text":"無条件 絶対 激昂なら singing the song","translation":"무조건 절대 격앙이라면 singing the song","kind":"lyric"},{"id":"37","start":159.973,"end":163.615,"text":"如何せん罵詈雑言でも singing the song","translation":"아무리 온갖 욕설이어도 singing the song","kind":"lyric"},{"id":"38","start":163.615,"end":167.407,"text":"有象無象の Big Bang 慈しみ深く","translation":"온갖 군상의 Big Bang 자비롭게","kind":"lyric"},{"id":"39","start":167.407,"end":173.861,"text":"怒れ 集え 謳え 破滅の譜を","translation":"분노하라 모여라 노래하라 파멸의 악보를","kind":"lyric"},{"id":"40","start":173.861,"end":179.114,"text":"Oh-oh-oh, ah-ah","translation":"오 오 오 아 아","kind":"lyric"},{"id":"41","start":179.114,"end":186.829,"text":"ᚷᚨᚺ ᛉᚨᚾ ᛏᚨᚲ ᚷᚨᚺ ᛉᚨᚾ ᛏᚨᛏ ᛏᚨᛏ ᛒᚱᚨᚲ","translation":"가 잔 타크 가 잔 탓 탓 브라크","kind":"lyric"},{"id":"42","start":186.829,"end":190.3,"text":"ᚷᚨᚺ ᛉᚨᚾ ᛏᚨᚲ ᚷᚨᚺ ᛉᚨᚾ ᛏᚨᛏ ᛏᚨᛏ ᛒᚱᚨᚲ","translation":"가 잔 타크 가 잔 탓 탓 브라크","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}