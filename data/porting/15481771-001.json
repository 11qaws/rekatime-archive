{"title":"댄스홀","artist":"Mrs. GREEN APPLE","date":"2026-10-02","sourceId":"15481771:001","sourceHash":"012d78c171a80d0c52a6a7bc53a0771a1c708f2f8a47b9a7884335b6a3129de8","duration":194.4,"cues":[{"id":"1","start":5.236,"end":7.11,"text":"いつだって大丈夫","translation":"언제나 괜찮아","kind":"lyric"},{"id":"2","start":7.17,"end":9.501,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"3","start":9.561,"end":13.973,"text":"君が居るから愛を知ることがまた出来る","translation":"네가 있기에 다시 사랑을 알 수 있어","kind":"lyric"},{"id":"4","start":14.033,"end":20.033,"text":"「大好き」を歌える","translation":"사랑해를 노래할 수 있어","kind":"lyric"},{"id":"5","start":32.303,"end":36.414,"text":"知らぬ間に誰かいる","translation":"어느새 곁에 누군가 있고","kind":"lyric"},{"id":"6","start":36.474,"end":39.64,"text":"それに甘えすぎてる","translation":"그에게 너무 기대고 있어","kind":"lyric"},{"id":"7","start":40.132,"end":45.237,"text":"何処かできっと僕の事を","translation":"어딘가엔 분명 나를","kind":"lyric"},{"id":"8","start":45.297,"end":48.34,"text":"恨んでる人がいる","translation":"원망하는 사람도 있어","kind":"lyric"},{"id":"9","start":49.377,"end":54.151,"text":"溜息を吐いて吸って吸って吐かれては","translation":"한숨을 내쉬고 들이쉬고 또 내쉬다 보면","kind":"lyric"},{"id":"10","start":54.211,"end":59.206,"text":"幸せを見逃しちゃうけど","translation":"행복을 놓쳐버리겠지만","kind":"lyric"},{"id":"11","start":59.266,"end":61.86,"text":"きっと結構ありがち","translation":"분명 꽤 흔한 일이야","kind":"lyric"},{"id":"12","start":62.85,"end":65.35,"text":"足元にあるもの","translation":"발밑에 있는 것들","kind":"lyric"},{"id":"13","start":65.41,"end":68.29,"text":"いつだって大丈夫","translation":"언제나 괜찮아","kind":"lyric"},{"id":"14","start":68.35,"end":70.89,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"15","start":70.95,"end":75.27,"text":"君が居るから愛を知ることがまた出来る","translation":"네가 있기에 다시 사랑을 알 수 있어","kind":"lyric"},{"id":"16","start":75.33,"end":77.43,"text":"今日もほら陽が昇る","translation":"오늘도 봐 해가 떠올라","kind":"lyric"},{"id":"17","start":77.49,"end":79.63,"text":"時代が周るダンスホール","translation":"시대가 돌아가는 댄스홀","kind":"lyric"},{"id":"18","start":79.69,"end":81.97,"text":"悲しいことは尽き無いけど","translation":"슬픈 일은 끝이 없지만","kind":"lyric"},{"id":"19","start":82.03,"end":88.03,"text":"幸せを数えてみる","translation":"행복을 세어 봐","kind":"lyric"},{"id":"20","start":90.32,"end":91.76,"text":"夢を追う君がいる","translation":"꿈을 좇는 네가 있어","kind":"lyric"},{"id":"21","start":91.82,"end":97.82,"text":"でもたまに自信を無くして見える","translation":"하지만 가끔 자신을 잃은 듯 보여","kind":"lyric"},{"id":"22","start":98.62,"end":100.6,"text":"誰かになんと言われようとも","translation":"누가 뭐라 하든","kind":"lyric"},{"id":"23","start":101.1,"end":105.04,"text":"君はそのままがいい","translation":"너는 지금 그대로가 좋아","kind":"lyric"},{"id":"24","start":105.94,"end":110.04,"text":"メンタルも成長痛を起こすでしょう","translation":"마음도 성장통을 앓겠지","kind":"lyric"},{"id":"25","start":110.04,"end":115.81,"text":"「無理をせず自分らしくいて」","translation":"무리 말고 너답게 있어","kind":"lyric"},{"id":"26","start":115.87,"end":118.59,"text":"それが出来たら悩んでないよ","translation":"그게 되면 고민도 안 하지","kind":"lyric"},{"id":"27","start":118.65,"end":123.41,"text":"まぁ明日こそ笑おう","translation":"그래 내일은 꼭 웃자","kind":"lyric"},{"id":"28","start":123.47,"end":124.97,"text":"結局は大丈夫","translation":"결국은 괜찮아","kind":"lyric"},{"id":"29","start":125.03,"end":127.61,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"30","start":127.67,"end":132.155,"text":"君の隣で愛を精一杯に探したい","translation":"네 곁에서 사랑을 온 힘 다해 찾고 싶어","kind":"lyric"},{"id":"31","start":132.215,"end":134.437,"text":"今日もまた怒られる","translation":"오늘도 또 혼나고","kind":"lyric"},{"id":"32","start":134.497,"end":136.406,"text":"気持ちの穴がポンっと増える","translation":"마음의 구멍이 퐁 하고 하나 더 늘어","kind":"lyric"},{"id":"33","start":136.466,"end":142.466,"text":"不器用だけど笑ってもらえるように笑う","translation":"서툴지만 웃게 해주려고 웃어","kind":"lyric"},{"id":"34","start":152.76,"end":154.936,"text":"いつだって大丈夫","translation":"언제나 괜찮아","kind":"lyric"},{"id":"35","start":155.0,"end":157.18,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"36","start":157.237,"end":161.445,"text":"楽しんだもん勝ちだ ダンスホール","translation":"즐기는 사람이 이겨 댄스홀","kind":"lyric"},{"id":"37","start":161.502,"end":163.197,"text":"また陽が昇る","translation":"다시 해가 떠올라","kind":"lyric"},{"id":"38","start":163.254,"end":165.663,"text":"時代が周るダンスホール","translation":"시대가 돌아가는 댄스홀","kind":"lyric"},{"id":"39","start":165.72,"end":169.91,"text":"足が疲れても踊る","translation":"발이 지쳐도 춤춰","kind":"lyric"},{"id":"40","start":169.97,"end":173.96,"text":"結局は大丈夫","translation":"결국은 괜찮아","kind":"lyric"},{"id":"41","start":174.02,"end":176.054,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"42","start":176.12,"end":178.8,"text":"あなたが主役のダンスホール","translation":"네가 주인공인 댄스홀","kind":"lyric"},{"id":"43","start":178.8,"end":183.6,"text":"You know? その笑顔が僕だけの太陽","translation":"알아 그 미소는 나만의 태양","kind":"lyric"},{"id":"44","start":183.6,"end":187.52,"text":"君が笑える為のダンスホール","translation":"네가 웃기 위한 댄스홀","kind":"lyric"},{"id":"45","start":187.52,"end":189.39,"text":"この愛を歌い続ける","translation":"이 사랑을 계속 노래할게","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}