{"title":"INSANE","artist":"Hazbin Hotel","sourceId":"reference:6y9uSV6pppClOompITss","sourceHash":"dc439c6c365fd2c33660bd52c4362c4456f906506951b7222188c2a2628eb98e","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":34640666,"cues":[{"id":"1","start":2.51,"end":3.55,"text":"Dearly beloved!","translation":"","kind":"lyric"},{"id":"2","start":3.55,"end":4.64,"text":"For your entertainment","translation":"","kind":"lyric"},{"id":"3","start":4.64,"end":8.29,"text":"It's my pleasure to introduce to you hell's latest arrival","translation":"","kind":"lyric"},{"id":"4","start":8.29,"end":11.15,"text":"The equal-opportunity killer, Alastor!","translation":"","kind":"lyric"},{"id":"5","start":11.15,"end":13.59,"text":"Hello, it's nice to meet you","translation":"","kind":"lyric"},{"id":"6","start":13.59,"end":15.82,"text":"Oh, can you tell me where I am?","translation":"","kind":"lyric"},{"id":"7","start":15.82,"end":17.38,"text":"I don't know how I got here","translation":"","kind":"lyric"},{"id":"8","start":17.38,"end":20.33,"text":"But I, I think I'm starting to understand","translation":"","kind":"lyric"},{"id":"9","start":20.33,"end":22.68,"text":"I don't belong among the angels","translation":"","kind":"lyric"},{"id":"10","start":22.68,"end":24.85,"text":"And baby, that's just fine with me","translation":"","kind":"lyric"},{"id":"11","start":24.85,"end":26.93,"text":"The things I did up there were high school","translation":"","kind":"lyric"},{"id":"12","start":26.93,"end":29.47,"text":"But now I'm going for my degree","translation":"","kind":"lyric"},{"id":"13","start":29.47,"end":29.77,"text":"Hey","translation":"","kind":"lyric"},{"id":"14","start":29.77,"end":31.95,"text":"Sorry, but you just got in my way","translation":"","kind":"lyric"},{"id":"15","start":31.95,"end":34.26,"text":"I promise honey, I can feel your pain","translation":"","kind":"lyric"},{"id":"16","start":34.26,"end":37.07,"text":"And maybe I enjoy it just a little bit","translation":"","kind":"lyric"},{"id":"17","start":37.07,"end":39.05,"text":"Does that make me insane?","translation":"","kind":"lyric"},{"id":"18","start":39.05,"end":41.36,"text":"Haven't been the same since I expired","translation":"","kind":"lyric"},{"id":"19","start":41.36,"end":43.42,"text":"Doesn't mean that I plan to retire","translation":"","kind":"lyric"},{"id":"20","start":43.42,"end":49.28,"text":"And now I have the power to bathe all of you in entertaining fire","translation":"","kind":"lyric"},{"id":"21","start":66.09,"end":68.53,"text":"Wait a minute, do I know you?","translation":"","kind":"lyric"},{"id":"22","start":68.53,"end":70.55,"text":"Weren't you an old pal of mine?","translation":"","kind":"lyric"},{"id":"23","start":70.55,"end":72.74,"text":"Departed from us far to early","translation":"","kind":"lyric"},{"id":"24","start":72.74,"end":75.28,"text":"But now we're meeting a second time","translation":"","kind":"lyric"},{"id":"25","start":75.28,"end":77.53,"text":"We used to have such fun together","translation":"","kind":"lyric"},{"id":"26","start":77.53,"end":79.83,"text":"And maybe you have what I need","translation":"","kind":"lyric"},{"id":"27","start":79.83,"end":81.85,"text":"But first I have one tiny question","translation":"","kind":"lyric"},{"id":"28","start":81.85,"end":86.3,"text":"Tell me, do you demons bleed?","translation":"","kind":"lyric"},{"id":"29","start":86.3,"end":86.98,"text":"Hey","translation":"","kind":"lyric"},{"id":"30","start":86.98,"end":89.17,"text":"Sorry, but you just got in my way","translation":"","kind":"lyric"},{"id":"31","start":89.17,"end":91.52,"text":"I promise honey, I can feel your pain","translation":"","kind":"lyric"},{"id":"32","start":91.52,"end":94.22999999999999,"text":"And maybe I enjoy it just a little bit","translation":"","kind":"lyric"},{"id":"33","s