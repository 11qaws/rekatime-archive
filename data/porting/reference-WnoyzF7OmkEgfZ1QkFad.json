"kind":"lyric"},{"id":"19","start":108.44,"end":113.95,"text":"僅かに開け放して","translation":"","kind":"lyric"},{"id":"20","start":113.95,"end":119.44,"text":"ただひとつ そうただひとつ","translation":"","kind":"lyric"},{"id":"21","start":119.44,"end":125.51,"text":"語り得ぬ声で叫ぶ","translation":"","kind":"lyric"},{"id":"22","start":125.51,"end":128.46,"text":"生まれ変わったとして","translation":"","kind":"lyric"},{"id":"23","start":128.46,"end":131.18,"text":"思い出せなくたって","translation":"","kind":"lyric"},{"id":"24","start":131.18,"end":135.62,"text":"見つけてみせるだろう","translation":"","kind":"lyric"},{"id":"25","start":135.62,"end":138.49,"text":"あなたの姿","translation":"","kind":"lyric"},{"id":"26","start":138.49,"end":143.95,"text":"全てを燃やして月を見ていた","translation":"","kind":"lyric"},{"id":"27","start":143.95,"end":149.41,"text":"誰かがそれを憐れむとしても","translation":"","kind":"lyric"},{"id":"28","start":149.41,"end":155.24,"text":"あなたがいれば幸せだったんだ","translation":"","kind":"lyric"},{"id":"29","start":155.24,"end":161.91,"text":"およそ正しくなどなかったとしても","translation":"","kind":"lyric"},{"id":"30","start":161.91,"end":166.07999999999998,"text":"消えたりしない","translation":"","kind":"lyric"},{"id":"31","start":166.07999999999998,"end":168.89,"text":"名前を呼んで","translation":"","kind":"lyric"},{"id":"32","start":168.89,"end":171.6,"text":"もう一度だけ","translation":"","kind":"lyric"},{"id":"33","start":171.6,"end":177.09,"text":"優しく包むその柔い声で","translation":"","kind":"lyric"},{"id":"34","start":177.09,"end":182.23,"text":"月を頼りに掴んだ枝が","translation":"","kind":"lyric"},{"id":"35","start":182.23,"end":187.84,"text":"あなただった","translation":"","kind":"lyric"},{"id":"36","start":187.84,"end":193.68,"text":"あなただった","translation":"","kind":"lyric"},{"id":"37","start":193.68,"end":199.06,"text":"何かを求めて月を見ていた","translation":"","kind":"lyric"},{"id":"38","start":199.06,"end":204.84,"text":"嵐に怯えるわたしの前に","translation":"","kind":"lyric"},{"id":"39","start":204.84,"end":210.5,"text":"現れたのがあなたでよかった","translation":"","kind":"lyric"},{"id":"40","start":210.5,"end":216