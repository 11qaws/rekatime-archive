{"originalLanguage":"ja","title":"again","artist":"YUI","date":"2026-08-04","sourceId":"14524675:052","sourceHash":"5540a1d2e9605787adb059f815ff5344e79ed2da631f1af24028020c39268224","duration":264.32,"cues":[{"id":"1","start":24.323,"end":30.866,"text":"夢の続き 追いかけていたはずなのに","translation":"꿈의 다음 장을 뒤쫓고 있었어야 했는데","kind":"lyric"},{"id":"2","start":30.946,"end":37.028,"text":"曲がりくねった 細い道 人に躓く","translation":"굽이진 좁은 길에서 사람들에게 걸려 넘어져","kind":"lyric"},{"id":"3","start":37.108,"end":38.711,"text":"あの頃にみたいにって","translation":"그때처럼 돌아가고 싶다는","kind":"lyric"},{"id":"4","start":38.791,"end":40.474,"text":"戻りたい訳じゃないの","translation":"뜻은 아니야","kind":"lyric"},{"id":"5","start":40.554,"end":43.981,"text":"なくしてきた空を 探してる","translation":"잃어버린 하늘을 찾고 있어","kind":"lyric"},{"id":"6","start":44.061,"end":45.684,"text":"分かってくれます様に","translation":"부디 알아주기를","kind":"lyric"},{"id":"7","start":45.764,"end":47.347,"text":"犠牲になった様な","translation":"희생이라도 당한 듯한","kind":"lyric"},{"id":"8","start":47.428,"end":50.734,"text":"悲しい顔は やめてよ","translation":"슬픈 표정은 그만 지어","kind":"lyric"},{"id":"9","start":50.814,"end":52.528,"text":"罪の最後は涙じゃないよ","translation":"죄의 끝은 눈물이 아니야","kind":"lyric"},{"id":"10","start":52.608,"end":54.321,"text":"ずっと苦しく背負ってくんだ","translation":"계속 괴롭게 짊어지고 가는 거야","kind":"lyric"},{"id":"11","start":54.401,"end":55.954,"text":"出口見えない感情迷路に","translation":"출구도 보이지 않는 감정의 미로에서","kind":"lyric"},{"id":"12","start":56.034,"end":57.748,"text":"誰を待ってるの","translation":"누구를 기다리고 있어","kind":"lyric"},{"id":"13","start":57.828,"end":59.361,"text":"白いノートに綴った様に","translation":"하얀 공책에 적어 내려가듯","kind":"lyric"},{"id":"14","start":59.441,"end":61.164,"text":"もっと素直に吐き出したいよ","translation":"좀 더 솔직하게 모두 토해 내고 싶어","kind":"lyric"},{"id":"15","start":61.244,"end":62.857,"text":"何から逃れたいんだ","translation":"무엇으로부터 달아나고 싶은 거야","kind":"lyric"},{"id":"16","start":62.938,"end":64.521,"text":"現実ってやつか","translation":"현실이라는 것인가","kind":"lyric"},{"id":"17","start":64.601,"end":67.757,"text":"何の為に生きてるんだって","translation":"무엇을 위해 살아가는지","kind":"lyric"},{"id":"18","start":67.837,"end":69.47,"text":"忘れちゃいそうな","translation":"잊어버릴 것 같은","kind":"lyric"},{"id":"19","start":69.55,"end":71.244,"text":"夜の真ん中","translation":"한밤중","kind":"lyric"},{"id":"20","start":71.324,"end":76.283,"text":"無難になんてやってらんないから","translation":"무난하게만 살 수는 없으니까","kind":"lyric"},{"id":"21","start":76.364,"end":78.127,"text":"帰る場所もないの","translation":"돌아갈 곳도 없어","kind":"lyric"},{"id":"22","start":78.207,"end":81.544,"text":"この想いを消してしまうには","translation":"이 마음을 지워 버리기에는","kind":"lyric"},{"id":"23","start":81.624,"end":84.93,"text":"まだ人生長いでしょ (I'm on the way)","translation":"아직 인생이 길잖아 나는 가는 중이야","kind":"lyric"},{"id":"24","start":85.01,"end":86.653,"text":"懐かしくなる","translation":"언젠가 그리워질","kind":"lyric"},{"id":"25","start":86.734,"end":89.94,"text":"こんな痛みも歓迎じゃん","translation":"이런 아픔도 환영이야","kind":"lyric"},{"id":"26","start":96.743,"end":100.45,"text":"謝らなくちゃいけないよね","translation":"사과해야겠지","kind":"lyric"},{"id":"27","start":100.53,"end":103.356,"text":"ああ ごめんね","translation":"아아 미안해","kind":"lyric"},{"id":"28","start":103.436,"end":105.51,"text":"うまく言えなくて","translation":"말을 잘하지 못해서","kind":"lyric"},{"id":"29","start":105.59,"end":109.468,"text":"心配かけたままだったね","translation":"계속 걱정하게 두었네","kind":"lyric"},{"id":"30","start":109.548,"end":110.98,"text":"あの日抱えた全部","translation":"그날 품었던 모든 것","kind":"lyric"},{"id":"31","start":111.061,"end":112.704,"text":"明日抱える全部","translation":"내일 짊어질 모든 것","kind":"lyric"},{"id":"32","start":112.784,"end":116.221,"text":"順番つけたりはしないから","translation":"어느 쪽이 먼저인지 따지지는 않을 테니까","kind":"lyric"},{"id":"33","start":116.301,"end":117.844,"text":"分かってくれます様に","translation":"부디 알아주기를","kind":"lyric"},{"id":"34","start":117.924,"end":119.497,"text":"そっと目を閉じたんだ","translation":"살며시 눈을 감았어","kind":"lyric"},{"id":"35","start":119.577,"end":123.104,"text":"見たくないものまで見えんだもん","translation":"보고 싶지 않은 것까지 보이니까","kind":"lyric"},{"id":"36","start":123.184,"end":124.837,"text":"いらない噂にちょっと","translation":"쓸데없는 소문은 잠깐","kind":"lyric"},{"id":"37","start":124.917,"end":126.551,"text":"初めて聞く発言どっち","translation":"처음 듣는 말은 어느 쪽이 진짜야","kind":"lyric"},{"id":"38","start":126.631,"end":128.174,"text":"向かい合ったら友達だって","translation":"마주 보고 나면 친구라는","kind":"lyric"},{"id":"39","start":128.254,"end":130.017,"text":"嘘はやめてね","translation":"거짓말은 하지 마","kind":"lyric"},{"id":"40","start":130.097,"end":131.65,"text":"深いハートが苛立つ様に","translation":"마음 깊은 곳이 짜증을 내듯","kind":"lyric"},{"id":"41","start":131.731,"end":133.474,"text":"体ん中燃えているんだ","translation":"몸 안에서 불타고 있어","kind":"lyric"},{"id":"42","start":133.554,"end":135.047,"text":"本当は期待してんの","translation":"사실은 기대하고 있어","kind":"lyric"},{"id":"43","start":135.127,"end":136.65,"text":"現実ってやつか","translation":"현실이라는 것인가","kind":"lyric"},{"id":"44","start":136.73,"end":139.957,"text":"何の為に生きてるんだって","translation":"무엇을 위해 살아가는지","kind":"lyric"},{"id":"45","start":140.037,"end":141.66,"text":"叫びたくなるよ","translation":"외치고 싶어져","kind":"lyric"},{"id":"46","start":141.74,"end":143.403,"text":"聞こえていますか","translation":"들리고 있나요","kind":"lyric"},{"id":"47","start":143.483,"end":148.473,"text":"無難になんてやってらんないから","translation":"무난하게만 살 수는 없으니까","kind":"lyric"},{"id":"48","start":148.553,"end":150.276,"text":"帰る場所もないの","translation":"돌아갈 곳도 없어","kind":"lyric"},{"id":"49","start":150.357,"end":153.653,"text":"優しさにはいつも感謝してる","translation":"다정한 마음에는 언제나 감사해","kind":"lyric"},{"id":"50","start":153.733,"end":157.11,"text":"だから強くなりたい (I'm on the way)","translation":"그러니 강해지고 싶어 나는 가는 중이야","kind":"lyric"},{"id":"51","start":157.19,"end":158.833,"text":"進む為に","translation":"앞으로 나아가기 위해","kind":"lyric"},{"id":"52","start":158.913,"end":160.646,"text":"敵も味方も歓迎じゃん","translation":"적도 편도 모두 환영이야","kind":"lyric"},{"id":"53","start":160.727,"end":167.54,"text":"どうやって次のドア開けるんだっけ 考えてる","translation":"다음 문을 어떻게 열었더라 생각하고 있어","kind":"lyric"},{"id":"54","start":167.62,"end":174.423,"text":"もう引き返せない物語始まってるんだ","translation":"이제 돌아갈 수 없는 이야기가 시작됐어","kind":"lyric"},{"id":"55","start":174.503,"end":181.407,"text":"目を覚ませ 目を覚ませ","translation":"눈을 떠 눈을 떠","kind":"lyric"},{"id":"56","start":195.003,"end":198.42,"text":"この想いを消してしまうには","translation":"이 마음을 지워 버리기에는","kind":"lyric"},{"id":"57","start":198.5,"end":201.846,"text":"まだ人生長いでしょ","translation":"아직 인생이 길잖아","kind":"lyric"},{"id":"58","start":201.926,"end":207.116,"text":"やり残してることやり直してみたいから","translation":"미처 하지 못한 일을 다시 해 보고 싶으니까","kind":"lyric"},{"id":"59","start":207.196,"end":208.98,"text":"もう一度行こうか","translation":"한 번 더 가 볼까","kind":"lyric"},{"id":"60","start":209.06,"end":212.116,"text":"叶えるために生きてるんだって","translation":"이루기 위해 살아간다고","kind":"lyric"},{"id":"61","start":212.196,"end":213.919,"text":"叫びたくなるよ","translation":"외치고 싶어져","kind":"lyric"},{"id":"62","start":214.0,"end":215.623,"text":"聞こえていますか","translation":"들리고 있나요","kind":"lyric"},{"id":"63","start":215.703,"end":220.713,"text":"無難になんてやってらんないから","translation":"무난하게만 살 수는 없으니까","kind":"lyric"},{"id":"64","start":220.793,"end":222.666,"text":"帰る場所もないの","translation":"돌아갈 곳도 없어","kind":"lyric"},{"id":"65","start":222.747,"end":225.963,"text":"優しさにはいつも感謝してる","translation":"다정한 마음에는 언제나 감사해","kind":"lyric"},{"id":"66","start":226.043,"end":229.259,"text":"だから強くなりたい (I'm on the way)","translation":"그러니 강해지고 싶어 나는 가는 중이야","kind":"lyric"},{"id":"67","start":229.339,"end":230.982,"text":"懐かしくなる","translation":"언젠가 그리워질","kind":"lyric"},{"id":"68","start":231.063,"end":233.046,"text":"こんな痛みも歓迎じゃん","translation":"이런 아픔도 환영이야","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}