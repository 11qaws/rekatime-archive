slation":"","kind":"lyric"},{"id":"18","start":48.6,"end":51.41,"text":"勝手にしてくださーい","translation":"","kind":"lyric"},{"id":"19","start":51.41,"end":54.33,"text":"Ui, Ui, Ui つかまえてみて","translation":"","kind":"lyric"},{"id":"20","start":54.33,"end":56.93,"text":"ココロ追いかけっこ 続けましょ","translation":"","kind":"lyric"},{"id":"21","start":56.93,"end":59.79,"text":"可愛いトコあるかもね","translation":"","kind":"lyric"},{"id":"22","start":59.79,"end":62.69,"text":"それはそれでやっぱお友達","translation":"","kind":"lyric"},{"id":"23","start":62.69,"end":64.77,"text":"（キャッチャー・イン・ザ・うい Na-Na-Na）","translation":"","kind":"lyric"},{"id":"24","start":64.77,"end":65.85,"text":"英才教育","translation":"","kind":"lyric"},{"id":"25","start":65.85,"end":67.41,"text":"（キャッチャー・イン・ザ・うい Na-Na-Na）","translation":"","kind":"lyric"},{"id":"26","start":67.41,"end":68.74,"text":"ちょっと過激に","translation":"","kind":"lyric"},{"id":"27","start":68.74,"end":73.15,"text":"刺激的な関係性 求む Crazy","translation":"","kind":"lyric"},{"id":"28","start":73.15,"end":74.67,"text":"つかずはなれず","translation":"","kind":"lyric"},{"id":"29","start":74.67,"end":76.96000000000001,"text":"愛を込めて I hate you","translation":"","kind":"lyric"},{"id":"30","start":83.09,"end":87.19,"text":"うい、夢に見るよ 新婚旅行","translation":"","kind":"lyric"},{"id":"31","start":87.19,"end":91.9,"text":"そっか それなら 空き缶はお前らだね","translation":"","kind":"lyric"},{"id":"32","start":91.9,"end":94.28999999999999,"text":"しっかりくくるね","translation":"","kind":"lyric"},{"id":"33","start":94.28999999999999,"end":97.25999999999999,"text":"(Non-Non) お前と結婚してませーん","translation":"","kind":"lyric"},{"id":"34","start":97.25999999999999,"end":100.34,"text":"(Non-Non) 皆さんのママじゃありませーん","translation":"","kind":"lyric"},{"id":"35","start":100.34,"end":102.99000000000001,"text":"(Non-Non) 言いすぎた？ごめんね？","translation":"","kind":"lyric"},{"id":"36","start":102.99000000000001,"end":105.6,"text":"もしかして効いちゃいました？","translation":"","kind":"lyric"},{"id":"37","start":105.6,"end":107.44,"text":"越えたら聖戦！","translation":"","kind":"lyric"},{"id":"38","start":107.44,"end":108.7,"text":"（おさがりくださーい）","translation":"","kind":"lyric"},{"id":"39","start":108.7,"end":110.37,"text":"ここから先はー？","translation":"","kind":"lyric"},{"id":"40","start":110.37,"end":111.69,"text":"（絶対領域！）","translation":"","kind":"lyric"},{"id":"41","start":111.69,"end":114.28,"text":"うわキツ嘘でしょ ねぇおじさん","translation":"","kind":"lyric"},{"id":"42","start":114.28,"end":117.19,"text":"それとっくに死語ですよ？","translation":"","kind":"lyric"},{"id":"43","start":117.19,"end":119.75,"text":"うい うい うい麦畑でね","translation":"","kind":"lyric"},{"id":"44","start":119.75,"end":122.8,"text":"君と日なたぼっこ 眠りましょ","translation":"","kind":"lyric"},{"id":"45","start":122.8,"end":125.51,"text":"仲良い 良い 良いとかよしてよね","translation":"","kind":"lyric"},{"id":"46","start":125.51,"end":128.5,"text":"夢は夢でやっぱお断り","translation":"","kind":"lyric"},{"id":"47","start":128.5,"end":130.62,"text":"（キャッチャー・イン・ザ・うい Na-Na-Na）","translation":"","kind":"lyric"},{"id":"48","start":130.62,"end":131.42,"text":"メッセージ帝国","translation":"","kind":"lyric"},{"id":"49","start":131.42,"end":133.3,"text":"（キャッチャー・イン・ザ・うい Na-Na-Na）","translation":"","kind":"lyric"},{"id":"50","start":133.3,"end":134.83,"text":"パスタ茹でてる","translation":"","kind":"lyric"},{"id":"51","start":134.83,"end":138.76,"text":"家庭的将来設計 煙に巻いて","translation":"","kind":"lyric"},{"id":"52","start":138.76,"end":140.31,"text":"寝ても覚めても","translation":"","kind":"lyric"},{"id":"53","start":140.31,"end":143.03,"text":"相変わらず サイッテーね","translation":"","kind":"lyric"},{"id":"54","start":143.03,"end":144.32,"text":"（大好き！）言わないが？","translation":"","kind":"lyric"},{"id":"55","start":144.32,"end":145.65,"text":"（大っ嫌い！）効かないが？","translation":"","kind":"lyric"},{"id":"56","start":145.65,"end":147.22,"text":"（愛してる？）してないが？","translation":"","kind":"lyric"},{"id":"57","start":147.22,"end":148.56,"text":"（今日ヒマ？）行かないが？","translation":"","kind":"lyric"},{"id":"58","start":148.56,"end":149.81,"text":"お前の愛はシャボン玉","translation":"","kind":"lyric"},{"id":"59","start":