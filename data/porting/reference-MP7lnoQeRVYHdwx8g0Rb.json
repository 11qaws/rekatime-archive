{"title":"Magnet","artist":"유성","sourceId":"reference:MP7lnoQeRVYHdwx8g0Rb","sourceHash":"9637bafa0914687edcea6d3f1b9fb69bd8d6a9d638ab977e64adb9280c17102d","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":31.25,"end":34.25,"text":"か細い火が 心の端に灯る","translation":"","kind":"lyric"},{"id":"2","start":35.72,"end":38.72,"text":"いつの間にか 燃え広がる熱情","translation":"","kind":"lyric"},{"id":"3","start":40.26,"end":43.26,"text":"私の蝶 不規則に飛び回り","translation":"","kind":"lyric"},{"id":"4","start":44.78,"end":47.78,"text":"あなたの手に 鱗粉を付けた","translation":"","kind":"lyric"},{"id":"5","start":49.16,"end":52.16,"text":"絡み合う指 ほどいて","translation":"","kind":"lyric"},{"id":"6","start":53.49,"end":56.49,"text":"唇から 舌へと","translation":"","kind":"lyric"},{"id":"7","start":57.97,"end":60.97,"text":"許されない事ならば","translation":"","kind":"lyric"},{"id":"8","start":61.76,"end":64.75999999999999,"text":"尚更 燃え上がるの","translation":"","kind":"lyric"},{"id":"9","start":66.59,"end":69.59,"text":"抱き寄せて欲しい 確かめて欲しい","translation":"","kind":"lyric"},{"id":"10","start":70.45,"end":73.45,"text":"間違いなど無いんだと 思わせて","translation":"","kind":"lyric"},{"id":"11","start":75.82,"end":78.82,"text":"キスをして 塗り替えて欲しい","translation":"","kind":"lyric"},{"id":"12","start":79.42,"end":82.42,"text":"魅惑の時に 酔いしれ 溺れていたいの","translation":"","kind":"lyric"},{"id":"13","start":93.49000000000001,"end":96.49000000000001,"text":"束縛して もっと必要として","translation":"","kind":"lyric"},{"id":"14","start":98.07,"end":101.07,"text":"愛しいなら 執着を見せつけて","translation":"","kind":"lyric"},{"id":"15","start":102.55,"end":105.55,"text":"「おかしい」のが たまらなく 好きになる","translation":"","kind":"lyric"},{"id":"16","start":106.97,"end":109.97,"text":"行けるトコまで 行けばいいよ","translation":"","kind":"lyric"},{"id":"17","start":111.15,"end":114.15,"text":"迷い込んだ心なら","translation":"","kind":"lyric"},{"id":"18","start":115.35,"end":118.35,"text":"簡単に 融けてゆく","translation":"","kind":"lyric"},{"id":"19","start":120.21,"end":123.21,"text":"優しさなんて 感じる暇など 無い位に","translation":"","kind":"lyric"},{"id":"20","start":128.96,"end":131.96,"text":"繰り返したのは あの夢じゃなくて","translation":"","kind":"lyric"},{"id":"21","start":132.72,"end":135.72,"text":"紛れも無い 現実の私達","translation":"","kind":"lyric"},{"id":"22","start":137.87,"end":140.87,"text":"触れてから 戻れないと知る","translation":"","kind":"lyric"},{"id":"23","start":141.74,"end":144.74,"text":"それでいいの 誰よりも 大切な あなた","translation":"","kind":"lyric"},{"id":"24","start":164.68,"end":167.68,"text":"夜明けが来ると 不安で","translation":"","kind":"lyric"},{"id":"25","start":168.72,"end":171.72,"text":"泣いてしまう 私に","translation":"","kind":"lyric"},{"id":"26","start":173.54,"end":176.54,"text":"「大丈夫」と囁いた","translation":"","kind":"lyric"},{"id":"27","start":177.12,"end":180.12,"text":"あなたも 泣いていたの？","translation":"","kind":"lyric"},{"id":"28","start":182.51,"end":185.51,"text":"抱き寄せて欲しい 確かめて欲しい","translation":"","kind":"lyric"},{"id":"29","start":186.76,"end":189.76,"text":"間違いなど無いんだと 思わせて","translation":"","kind":"lyric"},{"id":"30","start":191.86,"end":194.86,"text":"キスをして 塗り替えて欲しい","translation":"","kind":"lyric"},{"id":"31","start":195.45,"end":198.45,"text":"魅惑の時に 酔いしれ 溺れたい","translation":"","kind":"lyric"},{"id":"32","start":200.71,"end":203.71,"text":"引き寄せて マグネットのように","translation":"","kind":"lyric"},{"id":"33","start":204.68,"end":207.68,"text":"例え いつか離れても 巡り会う","translation":"","kind":"lyric"},{"id":"34","start":209.63,"end":212.63,"text":"触れていて 戻れなくていい","translation":"","kind":"lyric"},{"id":"35","start":213.4,"end":216.4,"text":"それでいいの 誰よりも 大切な あなた","translation":"","kind":"lyric"}],"candidates":[]}