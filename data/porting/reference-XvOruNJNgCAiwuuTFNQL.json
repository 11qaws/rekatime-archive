{"title":"발묘","artist":"나나호시 관현악단","sourceId":"reference:XvOruNJNgCAiwuuTFNQL","sourceHash":"5f402cb9c3405a01a703c207cb8485214e6421cd05d87b282021c7502b1f79fa","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":34060179,"cues":[{"id":"1","start":14.26,"end":17.82,"text":"忘れられぬものだけが美しくはないのでしょう","translation":"","kind":"lyric"},{"id":"2","start":17.82,"end":21.33,"text":"忘れることばかりが美しくはないでしょう","translation":"","kind":"lyric"},{"id":"3","start":21.33,"end":24.75,"text":"悲しいことばかりが人生ではないのでしょう","translation":"","kind":"lyric"},{"id":"4","start":24.75,"end":27.9,"text":"さりとて喜びとは比べ往くでしょう","translation":"","kind":"lyric"},{"id":"5","start":27.9,"end":31.91,"text":"船よ 船よ 荒波の中で","translation":"","kind":"lyric"},{"id":"6","start":31.91,"end":34.84,"text":"流されずいられたでしょう","translation":"","kind":"lyric"},{"id":"7","start":34.84,"end":39.91,"text":"水底に根差すあなたと穿った少女時代","translation":"","kind":"lyric"},{"id":"8","start":39.91,"end":44.24,"text":"さよならする頃 強いられるのは","translation":"","kind":"lyric"},{"id":"9","start":44.24,"end":45.02,"text":"抜錨","translation":"","kind":"lyric"},{"id":"10","start":45.02,"end":46.67,"text":"傷の数を数えて","translation":"","kind":"lyric"},{"id":"11","start":46.67,"end":48.61,"text":"痛みの数 指を折る","translation":"","kind":"lyric"},{"id":"12","start":48.61,"end":50.23,"text":"一つあまり 小指は","translation":"","kind":"lyric"},{"id":"13","start":50.23,"end":52.12,"text":"愛しさのぶんね","translation":"","kind":"lyric"},{"id":"14","start":52.12,"end":53.83,"text":"辛いこともありましょう","translation":"","kind":"lyric"},{"id":"15","start":53.83,"end":55.41,"text":"あなたの所為もありましょう","translation":"","kind":"lyric"},{"id":"16","start":55.41,"end":60.94,"text":"それでも赤い糸 結わえているのでしょう","translation":"","kind":"lyric"},{"id":"17","start":72.44,"end":76.08,"text":"底知れぬものだけに怯えるのではないでしょう","translation":"","kind":"lyric"},{"id":"18","start":76.08,"end":79.6,"text":"届かぬものばかりが妬ましくはないでしょう","translation":"","kind":"lyric"},{"id":"19","start":79.6,"end":82.98,"text":"優しいことばかりが優しさではないのでしょう","translation":"","kind":"lyric"},{"id":"20","start":82.98,"end":86.38,"text":"さりとて赤裸々ではこそばゆいでしょう","translation":"","kind":"lyric"},{"id":"21","start":86.38,"end":89.95,"text":"羽よ 羽よ 人並みを望み","translation":"","kind":"lyric"},{"id":"22","start":89.95,"end":93.34,"text":"人波に拒まれては","translation":"","kind":"lyric"},{"id":"23","start":93.34,"end":97.28999999999999,"text":"皆そこを目指すまだ葛藤があった少女時代","translation":"","kind":"lyric"},{"id":"24","start":97.28999999999999,"end":102.44,"text":"無辜でいた頃を遠ざけるのは","translation":"","kind":"lyric"},{"id":"25","start":102.44,"end":103.41,"text":"熱病","translation":"","kind":"lyric"},{"id":"26","start":103.41,"end":105.09,"text":"髪の長さ揃えて","translation":"","kind":"lyric"},{"id":"27","start":105.09,"end":106.85,"text":"爪の先を塗り直す","translation":"","kind":"lyric"},{"id":"28","start":106.85,"end":108.52000000000001,"text":"あどけない唇も","translation":"","kind":"lyric"},{"id":"29","start":108.52000000000001,"end":110.22,"text":"色めき立つのね","translation":"","kind":"lyric"},{"id":"30","start":110.22,"end":112.14,"text":"叶うこともありましょう","translation":"","kind":"lyric"},{"id":"31","start":112.14,"end":113.88,"text":"叶わぬ人もおりましょう","translation":"","kind":"lyric"},{"id":"32","start":113.88,"end":115.53999999999999,"text":"それゆえ慰めずには","translation":"","kind":"lyric"},{"id":"33","start":115.53999999999999,"end":118.58,"text":"いられないのでしょう","translation":"","kind":"lyric"},{"id":"34","start":118.58,"end":120.14,"text":"羽よ 花よ","translation":"","kind":"lyric"},{"id":"35","start":120.14,"end":125.19,"text":"水面に散って","translation":"","kind":"lyric"},{"id":"36","start":151.54,"end":153.2,"text":"傷の数を数えて","translation":"","kind":"lyric"},{"id":"37","start":153.2,"end":154.79,"text":"痛みの数 指を折る","translation":"","kind":"lyric"},{"id":"38","start":154.79,"end":156.35,"text":"一つあまり小指は","translation":"","kind":"lyric"},{"id":"39","start":156.35,"end":158.24,"text":"愛しさのぶんね","translation":"","kind":"lyric"},{"id":"40","start":158.24,"end":160.11,"text":"悔やむこともありましょう","translation":"","kind":"lyric"},{"id":"41","start":160.11,"end":161.82999999999998,"text":"わたしの所為もありましょう","translation":"","kind":"lyric"},{"id":"42","start":161.82999999999998,"end":165.16,"text":"いつかは赤い糸 断ち切るのでしょう","translation":"","kind":"lyric"},{"id":"43","start":165.16,"end":166.65,"text":"花びらにささやきを","translation":"","kind":"lyric"},{"id":"44","start":166.65,"end":168.55,"text":"哀れみから口づけを","translation":"","kind":"lyric"},{"id":"45","start":168.55,"end":172.0,"text":"懐かしんではじめて 過ぎ行くのでしょう","translation":"","kind":"lyric"},{"id":"46","start":172.0,"end":173.66,"text":"惑うこともありましょう","translation":"","kind":"lyric"},{"id":"47","start":173.66,"end":175.5,"text":"誰かの所為じゃないでしょう","translation":"","kind":"lyric"},{"id":"48","start":175.5,"end":177.29,"text":"難しいものですね","translation":"","kind":"lyric"},{"id":"49","start":177.29,"end":181.46,"text":"愛するということは","translation":"","kind":"lyric"}],"candidates":[]}