{"title":"FRIENDS","artist":"Anne-Marie","sourceId":"reference:uO72oHaEclQMA04ywWyr","sourceHash":"0207c876c7b88fc8659e133a48bbe298ec5a471f35160f3178194643744aaf7f","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":33391935,"cues":[{"id":"1","start":10.01,"end":12.43,"text":"You say you love me, I say you crazy","translation":"","kind":"lyric"},{"id":"2","start":12.43,"end":14.8,"text":"We're nothing more than friends","translation":"","kind":"lyric"},{"id":"3","start":14.8,"end":17.43,"text":"You're not my lover, more like a brother","translation":"","kind":"lyric"},{"id":"4","start":17.43,"end":20.23,"text":"I known you since we were like ten, yeah","translation":"","kind":"lyric"},{"id":"5","start":20.23,"end":22.34,"text":"Don't mess it up, talking that shit","translation":"","kind":"lyric"},{"id":"6","start":22.34,"end":24.94,"text":"Only gonna push me away, that's it!","translation":"","kind":"lyric"},{"id":"7","start":24.94,"end":27.51,"text":"When you say you love me, that make me crazy","translation":"","kind":"lyric"},{"id":"8","start":27.51,"end":29.36,"text":"Here we go again","translation":"","kind":"lyric"},{"id":"9","start":29.36,"end":34.28,"text":"Don't go look at me with that look in your eye","translation":"","kind":"lyric"},{"id":"10","start":34.28,"end":39.16,"text":"You really ain't going away without a fight","translation":"","kind":"lyric"},{"id":"11","start":39.16,"end":44.19,"text":"You can't be reasoned with, I'm done being polite","translation":"","kind":"lyric"},{"id":"12","start":44.19,"end":49.17,"text":"I've told you one, two, three, four, five, six thousand times","translation":"","kind":"lyric"},{"id":"13","start":49.17,"end":51.75,"text":"Haven't I made it obvious?","translation":"","kind":"lyric"},{"id":"14","start":51.75,"end":54.08,"text":"Haven't I made it clear?","translation":"","kind":"lyric"},{"id":"15","start":54.08,"end":56.44,"text":"Want me to spell it out for you?","translation":"","kind":"lyric"},{"id":"16","start":56.44,"end":59.12,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"17","start":59.12,"end":61.62,"text":"Haven't I made it obvious?","translation":"","kind":"lyric"},{"id":"18","start":61.62,"end":64.59,"text":"Haven't I made it clear?","translation":"","kind":"lyric"},{"id":"19","start":64.59,"end":66.67,"text":"Want me to spell it out for you?","translation":"","kind":"lyric"},{"id":"20","start":66.67,"end":68.84,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"21","start":68.84,"end":70.87,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"22","start":70.87,"end":73.05,"text":"Have you got no shame? You looking insane","translation":"","kind":"lyric"},{"id":"23","start":73.05,"end":75.34,"text":"Turning up at my door","translation":"","kind":"lyric"},{"id":"24","start":75.34,"end":78.01,"text":"It's two in the morning, the rain is pouring","translation":"","kind":"lyric"},{"id":"25","start":78.01,"end":80.26,"text":"Haven't we been here before?","translation":"","kind":"lyric"},{"id":"26","start":80.26,"end":82.91,"text":"Don't mess it up, talking that shit","translation":"","kind":"lyric"},{"id":"27","start":82.91,"end":85.47,"text":"Only gonna push me away, that's it!","translation":"","kind":"lyric"},{"id":"28","start":85.47,"end":88.03,"text":"Have you got no shame? You looking insane","translation":"","kind":"lyric"},{"id":"29","start":88.03,"end":89.78,"text":"Here we go again","translation":"","kind":"lyric"},{"id":"30","start":89.78,"end":94.50999999999999,"text":"So, don't go look at me with that look in your eye","translation":"","kind":"lyric"},{"id":"31","start":94.50999999999999,"end":99.74000000000001,"text":"You really ain't going away without a fight","translation":"","kind":"lyric"},{"id":"32","start":99.74000000000001,"end":104.62,"text":"You can't be reasoned with, I'm done being polite","translation":"","kind":"lyric"},{"id":"33","start":104.62,"end":109.71000000000001,"text":"I've told you one, two, three, four, five, six thousand times","translation":"","kind":"lyric"},{"id":"34","start":109.71000000000001,"end":112.66,"text":"Haven't I made it obvious? (haven't I made it?)","translation":"","kind":"lyric"},{"id":"35","start":112.66,"end":114.96000000000001,"text":"Haven't I made it clear? (haven't I made it clear?)","translation":"","kind":"lyric"},{"id":"36","start":114.96000000000001,"end":116.95,"text":"Want me to spell it out for you?","translation":"","kind":"lyric"},{"id":"37","start":116.95,"end":119.81,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"38","start":119.81,"end":121.87,"text":"Haven't I made it obvious?","translation":"","kind":"lyric"},{"id":"39","start":121.87,"end":124.82,"text":"Haven't I made it clear? (haven't I?)","translation":"","kind":"lyric"},{"id":"40","start":124.82,"end":127.39,"text":"Want me to spell it out for you? (to spell it out for you?)","translation":"","kind":"lyric"},{"id":"41","start":127.39,"end":129.44,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"42","start":129.44,"end":131.52,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"43","start":131.52,"end":133.67,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"44","start":133.67,"end":136.3,"text":"That's how you fu*king spell \"friends\"","translation":"","kind":"lyric"},{"id":"45","start":136.3,"end":138.7,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"46","start":138.7,"end":141.31,"text":"Get that shit inside your head","translation":"","kind":"lyric"},{"id":"47","start":141.31,"end":146.02,"text":"No, no, yeah, uh, ah","translation":"","kind":"lyric"},{"id":"48","start":146.02,"end":148.52,"text":"F-R-I-E-N-D-S","translation":"","kind":"lyric"},{"id":"49","start":148.52,"end":150.5,"text":"\"We're just friends\"","translation