{"title":"재출생","artist":"MARETU feat. 初音ミク","date":"2026-08-16","sourceId":"14728071:010","sourceHash":"f79d4ea011fffd0f83b080a5a6883d3ce97799180f1e7d06580c3879a41c5b5f","duration":247.56,"cues":[{"id":"1","start":18.86,"end":21.7,"text":"見え透いた嘘 信じ切ったりして","translation":"뻔한 거짓을 완전히 믿곤 해서","kind":"lyric"},{"id":"2","start":21.7,"end":23.44,"text":"気付いたこと 気付いたこと","translation":"깨달은 것 깨달은 것","kind":"lyric"},{"id":"3","start":23.5,"end":26.54,"text":"もう立ち止まるには遅いということ","translation":"이제 멈추기엔 늦었다는 것","kind":"lyric"},{"id":"4","start":26.72,"end":29.18,"text":"黒ずんだ心 放っておいたりして","translation":"검게 물든 마음을 버려두곤 해서","kind":"lyric"},{"id":"5","start":29.24,"end":30.98,"text":"分かったこと 分かったこと","translation":"알게 된 것 알게 된 것","kind":"lyric"},{"id":"6","start":31.04,"end":34.16,"text":"もう立ち直るには遅いということ","translation":"이제 다시 일어서기엔 늦었다는 것","kind":"lyric"},{"id":"7","start":35.0,"end":36.26,"text":"ああ、そんな奴の子に生まれて","translation":"아 그런 자의 아이로 태어나","kind":"lyric"},{"id":"8","start":36.32,"end":38.06,"text":"惨めを真面目に蔑まれて","translation":"비참함을 진지하게 업신여김당하고","kind":"lyric"},{"id":"9","start":38.12,"end":40.6,"text":"分かってることは否認の失敗と","translation":"알고 있는 건 부정의 실패와","kind":"lyric"},{"id":"10","start":40.66,"end":42.17,"text":"形骸化した愛よ","translation":"껍데기만 남은 사랑","kind":"lyric"},{"id":"11","start":42.2,"end":43.71,"text":"おぼこ娘のおとめさび","translation":"철부지 소녀의 수줍은 맵시","kind":"lyric"},{"id":"12","start":43.8,"end":45.62,"text":"役立たないものと覚えたり","translation":"쓸모없는 것으로 외우곤 해서","kind":"lyric"},{"id":"13","start":45.68,"end":48.12,"text":"残った役目は奴隷の再生成","translation":"남은 역할은 노예의 재생산","kind":"lyric"},{"id":"14","start":48.18,"end":49.34,"text":"それだけが生命","translation":"그것만이 생명","kind":"lyric"},{"id":"15","start":49.4,"end":51.38,"text":"この輪廻転生を仕舞えよ","translation":"이 윤회전생을 끝내","kind":"lyric"},{"id":"16","start":51.38,"end":53.18,"text":"いざぶち壊したれよこの世と","translation":"자 이 세상과 함께 부수어 버려","kind":"lyric"},{"id":"17","start":53.18,"end":53.9,"text":"心と","translation":"마음과","kind":"lyric"},{"id":"18","start":53.9,"end":54.58,"text":"体と","translation":"몸과","kind":"lyric"},{"id":"19","start":54.58,"end":56.64,"text":"これまでの無数の安寧を","translation":"지금까지의 수없는 안녕을","kind":"lyric"},{"id":"20","start":56.7,"end":58.78,"text":"はびこった偶像を見捨てよ","translation":"번진 우상을 버려","kind":"lyric"},{"id":"21","start":58.84,"end":60.7,"text":"絡まった現状を見切れよ","translation":"엉킨 현실을 가려 내","kind":"lyric"},{"id":"22","start":60.7,"end":61.42,"text":"冷たく","translation":"차갑게","kind":"lyric"},{"id":"23","start":61.42,"end":61.98,"text":"正しく","translation":"올바르게","kind":"lyric"},{"id":"24","start":62.06,"end":64.44,"text":"切り取れよ、歪んだ迎合を","translation":"왜곡된 영합을 베어 내","kind":"lyric"},{"id":"25","start":67.62,"end":70.46,"text":"残念に 生まれ損なったあなたには","translation":"안타깝게도 태어나기를 그르친 너에게는","kind":"lyric"},{"id":"26","start":70.46,"end":71.98,"text":"どう足掻いても","translation":"아무리 버둥거려도","kind":"lyric"},{"id":"27","start":71.98,"end":74.2,"text":"見るも無残な生き先しか","translation":"보기에도 참혹한 삶의 끝자락만","kind":"lyric"},{"id":"28","start":74.2,"end":76.2,"text":"残っていないから。","translation":"남아 있으니까","kind":"lyric"},{"id":"29","start":76.26,"end":78.78,"text":"いっそのこと、涙は枯らして","translation":"차라리 눈물은 말려 버리고","kind":"lyric"},{"id":"30","start":78.84,"end":82.34,"text":"潔く諦めようぜ","translation":"깔끔하게 포기하자","kind":"lyric"},{"id":"31","start":82.68,"end":86.08,"text":"そうして幸せになろうぜ","translation":"그렇게 행복해지자","kind":"lyric"},{"id":"32","start":94.64,"end":96.6,"text":"見え透いた嘘 貪ったりして","translation":"뻔한 거짓을 탐하곤 해서","kind":"lyric"},{"id":"33","start":96.66,"end":98.44,"text":"気付いたこと 気付いたこと","translation":"깨달은 것 깨달은 것","kind":"lyric"},{"id":"34","start":98.5,"end":101.58,"text":"もう夢の終わりが近いということ","translation":"이제 꿈의 끝이 가깝다는 것","kind":"lyric"},{"id":"35","start":102.5,"end":104.16,"text":"黒ずんだ言葉 言い放ったりして","translation":"검게 물든 말을 내뱉곤 해서","kind":"lyric"},{"id":"36","start":104.22,"end":105.98,"text":"分かったこと 分かったこと","translation":"알게 된 것 알게 된 것","kind":"lyric"},{"id":"37","start":105.98,"end":109.14,"text":"もう罪の咎めは近いということ","translation":"이제 죄의 벌이 가깝다는 것","kind":"lyric"},{"id":"38","start":109.5,"end":111.22,"text":"そんな無様なカタチに生まれて","translation":"그런 처량한 모습으로 태어나","kind":"lyric"},{"id":"39","start":111.28,"end":113.44,"text":"自分に向く吐き気に追われて","translation":"자신을 향한 구역질에 쫓기고","kind":"lyric"},{"id":"40","start":113.5,"end":116.14,"text":"分かってることは否認の失敗と","translation":"알고 있는 건 부정의 실패와","kind":"lyric"},{"id":"41","start":116.2,"end":117.08,"text":"機能不全の愛よ","translation":"기능을 잃은 사랑","kind":"lyric"},{"id":"42","start":117.14,"end":118.8,"text":"おぼこ娘のおとめさび","translation":"철부지 소녀의 수줍은 맵시","kind":"lyric"},{"id":"43","start":118.8,"end":120.76,"text":"げに下らんものと見付けたり","translation":"참으로 하찮은 것으로 발견하곤 해서","kind":"lyric"},{"id":"44","start":120.76,"end":123.42,"text":"叶えて進ぜよう、まだ見ぬ君の","translation":"아직 보지 못한 너의 소원을 이루어 주리라","kind":"lyric"},{"id":"45","start":123.48,"end":124.2,"text":"「産まれたくない」を","translation":"태어나고 싶지 않아를","kind":"lyric"},{"id":"46","start":124.2,"end":126.32,"text":"この輪廻転生を仕舞えよ","translation":"이 윤회전생을 끝내","kind":"lyric"},{"id":"47","start":126.38,"end":128.2,"text":"いざぶち壊したれよこの世と","translation":"자 이 세상과 함께 부수어 버려","kind":"lyric"},{"id":"48","start":128.2,"end":128.92,"text":"心と","translation":"마음과","kind":"lyric"},{"id":"49","start":128.92,"end":129.6,"text":"体と","translation":"몸과","kind":"lyric"},{"id":"50","start":129.6,"end":131.86,"text":"これまでの無数の安寧を","translation":"지금까지의 수없는 안녕을","kind":"lyric"},{"id":"51","start":132.94,"end":133.86,"text":"この森羅万象を逃れよ","translation":"이 삼라만상에서 벗어나","kind":"lyric"},{"id":"52","start":133.86,"end":135.3,"text":"入り組んだ感情を躱せよ","translation":"복잡하게 얽힌 감정을 피해","kind":"lyric"},{"id":"53","start":135.74,"end":136.42,"text":"この手に","translation":"이 손에","kind":"lyric"},{"id":"54","start":136.48,"end":137.08,"text":"この目に","translation":"이 눈에","kind":"lyric"},{"id":"55","start":137.14,"end":138.78,"text":"刻まれた無数の重態を","translation":"새겨진 수없는 중태를","kind":"lyric"},{"id":"56","start":153.96,"end":154.8,"text":"度重なる","translation":"거듭되는","kind":"lyric"},{"id":"57","start":154.8,"end":156.68,"text":"自問自答、危険思想","translation":"자문자답과 위험한 사상","kind":"lyric"},{"id":"58","start":156.74,"end":158.28,"text":"大体喰らい尽くした愛の本性","translation":"대개 다 잡아먹은 사랑의 본성","kind":"lyric"},{"id":"59","start":158.34,"end":162.08,"text":"今に見てろよと切った啖呵の純然かつ不格好な敗走","translation":"두고 보라며 내뱉은 큰소리의 순수하면서도 볼품없는 패주","kind":"lyric"},{"id":"60","start":162.14,"end":164.14,"text":"「生きてる間だけが全てだ」って","translation":"살아 있는 동안만이 전부라고","kind":"lyric"},{"id":"61","start":164.14,"end":166.18,"text":"信じきってる純な妄想誕生！","translation":"철석같이 믿는 순수한 망상 탄생","kind":"lyric"},{"id":"62","start":166.28,"end":169.22,"text":"と、奴隷の再生産、それだけの生命","translation":"그리고 노예의 재생산 그것뿐인 생명","kind":"lyric"},{"id":"63","start":169.8,"end":173.4,"text":"繋いでは切って安全を自ら失っていく妙な快感","translation":"이었다 끊으며 안전을 스스로 잃어 가는 묘한 쾌감","kind":"lyric"},{"id":"64","start":173.4,"end":177.08,"text":"湿っぽい言葉ぶちまけてやって密室に湧く次の犠牲者","translation":"음울한 말을 퍼부어 주고 밀실에 솟아나는 다음 희생자","kind":"lyric"},{"id":"65","start":177.14,"end":179.22,"text":"こんな気持も味わえる時点で","translation":"이런 기분까지 맛본 시점에서","kind":"lyric"},{"id":"66","start":179.22,"end":181.16,"text":"解っているだろう この世のこと","translation":"알고 있잖아 이 세상을","kind":"lyric"},{"id":"67","start":181.22,"end":182.86,"text":"こんな痛みも味わえる時点で","translation":"이런 고통까지 맛본 시점에서","kind":"lyric"},{"id":"68","start":182.86,"end":184.74,"text":"解っているだろう その後のこと","translation":"알고 있잖아 그 다음을","kind":"lyric"},{"id":"69","start":187.54,"end":190.58,"text":"笑えないことばかりだったよな、","translation":"웃을 수 없는 일뿐이었지","kind":"lyric"},{"id":"70","start":190.64,"end":192.18,"text":"いつからか","translation":"언젠가부터","kind":"lyric"},{"id":"71","start":192.24,"end":194.46,"text":"積り積もった思い出に","translation":"쌓이고 쌓인 추억에","kind":"lyric"},{"id":"72","start":194.46,"end":195.88,"text":"クラっとくるわ!","translation":"어질해져","kind":"lyric"},{"id":"73","start":195.88,"end":198.84,"text":"両の視界を濡らして濡らして","translation":"두 눈앞을 적시고 또 적셔","kind":"lyric"},{"id":"74","start":198.84,"end":201.82,"text":"終わったあれと別れようぜ","translation":"끝난 그것과 헤어지자","kind":"lyric"},{"id":"75","start":202.74,"end":205.46,"text":"完全に 生まれ損なったあなたには","translation":"완전히 태어나기를 그르친 너에게는","kind":"lyric"},{"id":"76","start":205.52,"end":207.02,"text":"どう もがいても","translation":"아무리 버둥거려도","kind":"lyric"},{"id":"77","start":207.02,"end":209.34,"text":"見るも無残な生き先しか","translation":"보기에도 참혹한 삶의 끝자락만","kind":"lyric"},{"id":"78","start":209.34,"end":210.68,"text":"選べないから。","translation":"고를 수 있으니까","kind":"lyric"},{"id":"79","start":210.74,"end":213.66,"text":"いっそのこと、涙は枯らして","translation":"차라리 눈물은 말려 버리고","kind":"lyric"},{"id":"80","start":213.72,"end":217.28,"text":"ためらわずに 旅立とうか","translation":"망설이지 말고 떠나 볼까","kind":"lyric"},{"id":"81","start":217.34,"end":221.06,"text":"もう一度 産まれ直そうか","translation":"한 번 더 다시 태어날까","kind":"lyric"},{"id":"82","start":221.34,"end":224.8,"text":"そうして幸せになろうぜ","translation":"그렇게 행복해지자","kind":"lyric"},{"id":"83","start":225.28,"end":228.24,"text":"君は何も悪くないぜ (多分)","translation":"너는 아무 잘못도 없어 (아마도)","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}