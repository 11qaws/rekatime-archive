{"originalLanguage":"ja","title":"괴물","artist":"YOASOBI","date":"2026-07-20","sourceId":"UBCB2e0Aik4:025","sourceHash":"d665d4bc692e1cfcecb0addd3b2ac6d2ba28df3388c1f3e28ccb3636a009b797","duration":210.67,"cues":[{"id":"1","start":5.46,"end":8.68,"text":"あぁ素晴らしき世界に今日も乾杯","translation":"아아 멋진 세상에 오늘도 건배","kind":"lyric"},{"id":"2","start":8.68,"end":11.46,"text":"街に飛び交う笑い声も","translation":"거리에 오가는 웃음소리도","kind":"lyric"},{"id":"3","start":11.46,"end":15.42,"text":"見て見ぬフリしてるだけの作りもんさ","translation":"못 본 척할 뿐인 가짜야","kind":"lyric"},{"id":"4","start":15.56,"end":16.94,"text":"気が触れそうだ","translation":"정신이 나갈 것 같아","kind":"lyric"},{"id":"5","start":16.94,"end":20.23,"text":"クラクラするほどの良い匂いが","translation":"어질어질할 만큼 좋은 냄새가","kind":"lyric"},{"id":"6","start":20.23,"end":22.11,"text":"ツンと刺した鼻の奥","translation":"코끝 깊숙이 찔러 와","kind":"lyric"},{"id":"7","start":22.11,"end":24.33,"text":"目を覚ます本能のまま","translation":"깨어나는 본능 그대로","kind":"lyric"},{"id":"8","start":24.33,"end":26.33,"text":"今日は誰の番だ？","translation":"오늘은 누구 차례야","kind":"lyric"},{"id":"9","start":26.33,"end":30.86,"text":"この世界で何が出来るのか","translation":"이 세상에서 무엇을 할 수 있을까","kind":"lyric"},{"id":"10","start":30.86,"end":33.66,"text":"僕には何が出来るのか","translation":"나는 무엇을 할 수 있을까","kind":"lyric"},{"id":"11","start":33.66,"end":36.44,"text":"ただその真っ黒な目から","translation":"그저 그 새까만 눈에서","kind":"lyric"},{"id":"12","start":36.44,"end":39.46,"text":"涙溢れ落ちないように","translation":"눈물이 흘러내리지 않도록","kind":"lyric"},{"id":"13","start":39.46,"end":42.7,"text":"あぁ願う未来に何度でもずっと","translation":"아아 바라는 미래에 몇 번이고 계속","kind":"lyric"},{"id":"14","start":42.7,"end":44.02,"text":"喰らいつく","translation":"물고 늘어져","kind":"lyric"},{"id":"15","start":44.02,"end":47.84,"text":"この間違いだらけの世界の中","translation":"이 잘못투성이 세상 속에서","kind":"lyric"},{"id":"16","start":47.84,"end":51.14,"text":"君には笑ってほしいから","translation":"네가 웃어 주길 바라니까","kind":"lyric"},{"id":"17","start":51.14,"end":53.56,"text":"もう誰も傷付けない","translation":"이제 누구도 상처 입히지 않아","kind":"lyric"},{"id":"18","start":53.56,"end":56.18,"text":"強く強くなりたいんだよ","translation":"강하게 강하게 되고 싶어","kind":"lyric"},{"id":"19","start":56.18,"end":60.16,"text":"僕が僕でいられるように","translation":"내가 나로 있을 수 있도록","kind":"lyric"},{"id":"20","start":68.05,"end":70.83,"text":"素晴らしき世界は今日も安泰","translation":"멋진 세상은 오늘도 평안해","kind":"lyric"},{"id":"21","start":70.83,"end":73.81,"text":"街に渦巻く悪い話も","translation":"거리에 소용돌이치는 나쁜 이야기도","kind":"lyric"},{"id":"22","start":73.91,"end":77.51,"text":"知らない知らないフリして目を逸らした","translation":"몰라 모르는 척 눈을 돌렸어","kind":"lyric"},{"id":"23","start":78.61,"end":79.79,"text":"正気の沙汰じゃないな","translation":"정상적인 짓이 아니네","kind":"lyric"},{"id":"24","start":79.79,"end":81.97,"text":"真面目に着飾った行進","translation":"진지하게 차려입은 행진","kind":"lyric"},{"id":"25","start":81.97,"end":85.25,"text":"鳴らす足音が弾む行き先は","translation":"울리는 발소리가 들뜬 채 향하는 곳은","kind":"lyric"},{"id":"26","start":85.25,"end":88.45,"text":"消えない消えない味が染み付いている","translation":"사라지지 않는 맛이 배어 있는","kind":"lyric"},{"id":"27","start":88.45,"end":90.91,"text":"裏側の世界","translation":"이면의 세계","kind":"lyric"},{"id":"28","start":102.8,"end":104.24,"text":"清く正しく生きること","translation":"맑고 올바르게 사는 것","kind":"lyric"},{"id":"29","start":104.24,"end":107.1,"text":"誰も悲しませずに生きること","translation":"아무도 슬프게 하지 않고 사는 것","kind":"lyric"},{"id":"30","start":107.1,"end":109.86,"text":"はみ出さず真っ直ぐに生きること","translation":"벗어나지 않고 똑바로 사는 것","kind":"lyric"},{"id":"31","start":109.86,"end":112.74,"text":"それが間違わないで生きること？","translation":"그게 틀리지 않게 사는 것일까","kind":"lyric"},{"id":"32","start":112.74,"end":115.56,"text":"ありのまま生きることが正義か","translation":"있는 그대로 사는 것이 정의인가","kind":"lyric"},{"id":"33","start":115.56,"end":118.46,"text":"騙し騙し生きるのは正義か","translation":"속이고 속이며 사는 것이 정의인가","kind":"lyric"},{"id":"34","start":118.46,"end":121.26,"text":"僕の在るべき姿とはなんだ","translation":"내가 있어야 할 모습은 무엇이야","kind":"lyric"},{"id":"35","start":121.26,"end":123.68,"text":"本当の僕は何者なんだ","translation":"진짜 나는 누구야","kind":"lyric"},{"id":"36","start":123.68,"end":125.56,"text":"教えてくれよ","translation":"알려 줘","kind":"lyric"},{"id":"37","start":128.72,"end":131.38,"text":"教えてくれよ","translation":"알려 줘","kind":"lyric"},{"id":"38","start":134.78,"end":135.96,"text":"今日も","translation":"오늘도","kind":"lyric"},{"id":"39","start":135.96,"end":138.44,"text":"答えのない世界の中で","translation":"답 없는 세상 속에서","kind":"lyric"},{"id":"40","start":138.44,"end":140.26,"text":"願ってるんだよ","translation":"바라고 있어","kind":"lyric"},{"id":"41","start":140.26,"end":141.84,"text":"不器用だけれど","translation":"서툴지만","kind":"lyric"},{"id":"42","start":141.84,"end":145.14,"text":"いつまでも君とただ","translation":"언제까지나 너와 그저","kind":"lyric"},{"id":"43","start":145.14,"end":147.14,"text":"笑っていたいから","translation":"함께 웃고 싶으니까","kind":"lyric"},{"id":"44","start":147.14,"end":149.52,"text":"あぁ跳ねる心臓が","translation":"아아 뛰는 심장이","kind":"lyric"},{"id":"45","start":149.52,"end":152.12,"text":"体揺らし叫ぶんだよ","translation":"몸을 흔들며 외쳐","kind":"lyric"},{"id":"46","start":152.12,"end":154.61,"text":"今こそ動き出せ","translation":"지금이야 움직여","kind":"lyric"},{"id":"47","start":154.61,"end":158.51,"text":"あぁ弱い自分を何度でもずっと","translation":"아아 나약한 자신을 몇 번이고 계속","kind":"lyric"},{"id":"48","start":158.51,"end":159.77,"text":"喰らい尽くす","translation":"모조리 먹어 치워","kind":"lyric"},{"id":"49","start":159.77,"end":163.43,"text":"この間違いだらけの世界の中","translation":"이 잘못투성이 세상 속에서","kind":"lyric"},{"id":"50","start":163.63,"end":166.88,"text":"君には笑ってほしいから","translation":"네가 웃어 주길 바라니까","kind":"lyric"},{"id":"51","start":166.88,"end":169.3,"text":"もう誰も泣かないよう","translation":"이제 누구도 울지 않도록","kind":"lyric"},{"id":"52","start":169.3,"end":172.0,"text":"強く強くなりたいんだよ","translation":"강하게 강하게 되고 싶어","kind":"lyric"},{"id":"53","start":172.0,"end":176.06,"text":"僕が僕でいられるように","translation":"내가 나로 있을 수 있도록","kind":"lyric"},{"id":"54","start":185.95,"end":189.12,"text":"ただ君を守るそのために","translation":"오직 너를 지키기 위해","kind":"lyric"},{"id":"55","start":189.12,"end":191.7,"text":"走る走る走るんだよ","translation":"달려 달려 달리는 거야","kind":"lyric"},{"id":"56","start":191.7,"end":195.52,"text":"僕の中の僕を超える","translation":"내 안의 나를 넘어서","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}