{"title":"Darkside","artist":"Alan Walker","sourceId":"reference:Jh4Ob1amjxyv8BnI0Gj3","sourceHash":"bd0140304fc9d565384b2b54b42393bcc6ebe5f0fdbf90f6f35bb04ab6207d26","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":34543085,"cues":[{"id":"1","start":13.77,"end":16.42,"text":"We're not in love","translation":"","kind":"lyric"},{"id":"2","start":16.42,"end":19.41,"text":"We share no stories","translation":"","kind":"lyric"},{"id":"3","start":19.41,"end":24.91,"text":"Just something in your eyes","translation":"","kind":"lyric"},{"id":"4","start":24.91,"end":27.94,"text":"Don't be afraid","translation":"","kind":"lyric"},{"id":"5","start":27.94,"end":30.76,"text":"The shadows know me","translation":"","kind":"lyric"},{"id":"6","start":30.76,"end":36.23,"text":"Let's leave the world behind","translation":"","kind":"lyric"},{"id":"7","start":36.23,"end":38.62,"text":"Take me through the night","translation":"","kind":"lyric"},{"id":"8","start":38.62,"end":42.43,"text":"Fall into the darkside","translation":"","kind":"lyric"},{"id":"9","start":42.43,"end":44.41,"text":"We don't need the light","translation":"","kind":"lyric"},{"id":"10","start":44.41,"end":47.87,"text":"We'll live on the darkside","translation":"","kind":"lyric"},{"id":"11","start":47.87,"end":50.52,"text":"I see it, let's feel it","translation":"","kind":"lyric"},{"id":"12","start":50.52,"end":53.23,"text":"While we're still young and fearless","translation":"","kind":"lyric"},{"id":"13","start":53.23,"end":55.53,"text":"Let go of the light","translation":"","kind":"lyric"},{"id":"14","start":55.53,"end":61.38,"text":"Fall into the darkside","translation":"","kind":"lyric"},{"id":"15","start":61.38,"end":66.35,"text":"Fall into the darkside","translation":"","kind":"lyric"},{"id":"16","start":66.35,"end":71.73,"text":"Give into the dark