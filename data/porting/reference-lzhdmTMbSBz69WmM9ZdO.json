{"title":"Stardust","artist":"Sound Horizon","sourceId":"reference:lzhdmTMbSBz69WmM9ZdO","sourceHash":"cd7e8e474ed2f61953ce7743793b57b0c88ad6a55094aa8c1641706effeda058","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":0.35,"end":2.01,"text":"「彼女こそ","translation":"","kind":"lyric"},{"id":"2","start":2.01,"end":5.01,"text":"私のエリスなのだろうか」","translation":"","kind":"lyric"},{"id":"3","start":5.61,"end":8.61,"text":"お揃いね私達","translation":"","kind":"lyric"},{"id":"4","start":8.84,"end":10.9,"text":"これでお揃いね","translation":"","kind":"lyric"},{"id":"5","start":10.9,"end":13.74,"text":"あぁ幸せ","translation":"","kind":"lyric"},{"id":"6","start":13.74,"end":16.740000000000002,"text":"Hm...","translation":"","kind":"lyric"},{"id":"7","start":19.32,"end":22.32,"text":"StarDust","translation":"","kind":"lyric"},{"id":"8","start":38.17,"end":40.11,"text":"女は物言わぬ","translation":"","kind":"lyric"},{"id":"9","start":40.11,"end":42.23,"text":"可愛いだけの《お人形》(Doll)じゃないわ","translation":"","kind":"lyric"},{"id":"10","start":42.23,"end":44.02,"text":"愛しい貴方","translation":"","kind":"lyric"},{"id":"11","start":44.02,"end":45.83,"text":"解って？","translation":"","kind":"lyric"},{"id":"12","start":45.83,"end":47.91,"text":"ちっぽけな自尊心","translation":"","kind":"lyric"},{"id":"13","start":47.91,"end":50.14,"text":"満たす為の道具じゃないわ","translation":"","kind":"lyric"},{"id":"14","start":50.14,"end":51.78,"text":"月夜の《別人格》(Another)","translation":"","kind":"lyric"},{"id":"15","start":51.78,"end":53.8,"text":"は勝手？","translation":"","kind":"lyric"},{"id":"16","start":53.8,"end":55.78,"text":"首を絞めれば","translation":"","kind":"lyric"},{"id":"17","start":55.78,"end":57.68,"text":"締まるに決まってるじゃない","translation":"","kind":"lyric"},{"id":"18","start":57.68,"end":59.35,"text":"月(Luna)が貴方を","translation":"","kind":"lyric"},{"id":"19","start":59.35,"end":61.64,"text":"狂わせたの？","translation":"","kind":"lyric"},{"id":"20","start":61.64,"end":63.59,"text":"だってしょうがないじゃない","translation":"","kind":"lyric"},{"id":"21","start":63.59,"end":65.44,"text":"愛してしまったんだもの","translation":"","kind":"lyric"},{"id":"22","start":65.44,"end":66.92,"text":"星(Stella)が私を","translation":"","kind":"lyric"},{"id":"23","start":66.92,"end":69.6,"text":"狂わせたのは何故？","translation":"","kind":"lyric"},{"id":"24","start":69.6,"end":70.35,"text":"真っ赤な衣装(Dress)","translation":"","kind":"lyric"},{"id":"25","start":70.35,"end":71.42,"text":"真っ赤な洋靴(Heel)","translation":"","kind":"lyric"},{"id":"26","start":71.42,"end":72.22,"text":"真っ赤な口紅(Rouge)","translation":"","kind":"lyric"},{"id":"27","start":72.22,"end":73.44,"text":"真っ赤な薔薇(Rose)","translation":"","kind":"lyric"},{"id":"28","start":73.44,"end":75.38,"text":"すれ違う男達","translation":"","kind":"lyric"},{"id":"29","start":75.38,"end":77.24,"text":"誰もが振り返る","translation":"","kind":"lyric"},{"id":"30","start":77.24,"end":79.28,"text":"左手には花束","translation":"","kind":"lyric"},{"id":"31","start":79.28,"end":81.14,"text":"右手には約束を","translation":"","kind":"lyric"},{"id":"32","start":81.14,"end":83.03999999999999,"text":"疾りだした衝動は","translation":"","kind":"lyric"},{"id":"33","start":83.03999999999999,"end":84.99,"text":"もう止まらない","translation":"","kind":"lyric"},{"id":"34","start":84.99,"end":87.99,"text":"お揃いね私達","translation":"","kind":"lyric"},{"id":"35","start":88.09,"end":90.25,"text":"これでお揃いね","translation":"","kind":"lyric"},{"id":"36","start":90.25,"end":92.84,"text":"あぁ幸せ","translation":"","kind":"lyric"},{"id":"37","start":92.84,"end":95.81,"text":"貴方の白い衣装(Shirt)も","translation":"","kind":"lyric"},{"id":"38","start":95.81,"end":98.81,"text":"今は鮮やかな深紅(Scarlet)","translation":"","kind":"lyric"},{"id":"39","start":100.53,"end":103.53,"text":"お揃いね私達","translation":"","kind":"lyric"},{"id":"40","start":103.66,"end":105.85,"text":"これでお揃いね","translation":"","kind":"lyric"},{"id":"41","start":105.85,"end":108.25,"text":"あぁ幸せ","translation":"","kind":"lyric"},{"id":"42","start":108.25,"end":110.9,"text":"「フフ、屑でも構わないわ、","translation":"","kind":"lyric"},{"id":"43","start":110.9,"end":112.66,"text":"いつか星になれるなら、","translation":"","kind":"lyric"},{"id":"44","start":112.66,"end":113.7,"text":"輝いてる？","translation":"","kind":"lyric"},{"id":"45","start":113.7,"end":115.89,"text":"ねぇ 私輝いてる？」","translation":"","kind":"lyric"},{"id":"46","start":115.89,"end":117.75999999999999,"text":"「綺麗な星空ね」","translation":"","kind":"lyric"},{"id":"47","start":117.75999999999999,"end":119.88,"text":"それは艶やかな女のため息","translation":"","kind":"lyric"},{"id":"48","start":119.88,"end":121.57,"text":"「君の方が綺麗だよ」","translation":"","kind":"lyric"},{"id":"49","start":121.57,"end":123.82,"text":"それは甘い男の囁き","translation":"","kind":"lyric"},{"id":"50","start":123.82,"end":125.92,"text":"夜空を見上げる恋人達","translation":"","kind":"lyric"},{"id":"51","start":125.92,"end":127.57,"text":"ありふれた風景","translation":"","kind":"lyric"},{"id":"52","start":127.57,"end":129.56,"text":"繰り返される恋模様","translation":"","kind":"lyric"},{"id":"53","start":129.56,"end":131.45,"text":"ほんの些細なこと","translation":"","kind":"lyric"},{"id":"54","start":131.45,"end":133.36,"text":"そんな気紛れなひと時を","translation":"","kind":"lyric"},{"id":"55","start":133.36,"end":135.32,"text":"永遠だと信じたりして","translation":"","kind":"lyric"},{"id":"56","start":135.32,"end":136.96,"text":"そんな不確かなものを","translation":"","kind":"lyric"},{"id":"57","start":136.96,"end":139.18,"text":"運命だと信じたりして","translation":"","kind":"lyric"},{"id":"58","start":139.18,"end":139.96,"text":"泣いたり","translation":"","kind":"lyric"},{"id":"59","start":139.96,"end":140.75,"text":"笑ったり","translation":"","kind":"lyric"},{"id":"60","start":140.75,"end":141.63,"text":"愛したり","translation":"","kind":"lyric"},{"id":"61","start":141.63,"end":143.04,"text":"憎んだりして","translation":"","kind":"lyric"},{"id":"62","start":143.04,"end":144.1,"text":"その束の間","translation":"","kind":"lyric"},{"id":"63","start":144.1,"end":145.28,"text":"遥か過去の光に","translation":"","kind":"lyric"},{"id":"64","start":145.28,"end":147.04,"text":"想いを馳せたりして","translation":"","kind":"lyric"},{"id":"65","start":147.04,"end":148.19,"text":"あの星々はもう","translation":"","kind":"lyric"},{"id":"66","start":148.19,"end":150.23,"text":"滅んでしまっているのだろうか？","translation":"","kind":"lyric"},{"id":"67","start":150.23,"end":151.68,"text":"それとも今もまだ","translation":"","kind":"lyric"},{"id":"68","start":151.68,"end":154.62,"text":"滅びに向かって輝き続けているのだろうか？","translation":"","kind":"lyric"},{"id":"69","start":154.62,"end":157.62,"text":"光年という名の途方もない尺度の前では","translation":"","kind":"lyric"},{"id":"70","start":157.86,"end":159.16,"text":"人の一生など","translation":"","kind":"lyric"},{"id":"71","start":159.16,"end":162.16,"text":"刹那の幻に過ぎないのかも知れない","translation":"","kind":"lyric"},{"id":"72","start":162.56,"end":164.52,"text":"そんな些細なこと","translation":"","kind":"lyric"},{"id":"73","start":164.52,"end":166.55,"text":"されど偶然とはいえ","translation":"","kind":"lyric"},{"id":"74","start":166.55,"end":167.23,"text":"嗚呼","translation":"","kind":"lyric"},{"id":"75","start":167.23,"end":168.12,"text":"偶然とはいえ","translation":"","kind":"lyric"},{"id":"76","start":168.12,"end":170.24,"text":"彼女は見てしまった","translation":"","kind":"lyric"},{"id":"77","start":170.24,"end":171.5,"text":"お揃いの白い服を着て","translation":"","kind":"lyric"},{"id":"78","start":171.5,"end":173.9,"text":"幸せそうに寄り添い歩く","translation":"","kind":"lyric"},{"id":"79","start":173.9,"end":175.01,"text":"彼と","translation":"","kind":"lyric"},{"id":"80","start":175.01,"end":177.92000000000002,"text":"見知らぬ女の姿を","translation":"","kind":"lyric"},{"id":"81","start":177.92000000000002,"end":180.92000000000002,"text":"お揃いね私達","translation":"","kind":"lyric"},{"id":"82","start":181.03,"end":183.19,"text":"これでお揃いね","translation":"","kind":"lyric"},{"id":"83","start":183.19,"end":185.68,"text":"あぁ幸せ","translation":"","kind":"lyric"},{"id":"84","start":185.68,"end":188.68,"text":"貴方の白い衣装(Shirt)も","translation":"","kind":"lyric"},{"id":"85","start":188.77,"end":191.35,"text":"今は","translation":"","kind":"lyric"},{"id":"86","start":191.35,"end":192.5,"text":"「何故？","translation":"","kind":"lyric"},{"id":"87","start":192.5,"end":193.93,"text":"何故なの！？","translation":"","kind":"lyric"},{"id":"88","start":193.93,"end":195.84,"text":"何故なのよぉ！！」","translation":"","kind":"lyric"},{"id":"89","start":195.84,"end":198.84,"text":"酸素に触れた赤は","translation":"","kind":"lyric"},{"id":"90","start":198.96,"end":201.96,"text":"やがて黒に近づき示す","translation":"","kind":"lyric"},{"id":"91","start":203.59,"end":206.18,"text":"二人はもう永遠に","translation":"","kind":"lyric"},{"id":"92","start":206.18,"end":208.1,"text":"一つには","translation":"","kind":"lyric"},{"id":"93","start":208.1,"end":211.1,"text":"なれないという事実を","translation":"","kind":"lyric"},{"id":"94","start":211.19,"end":214.19,"text":"凍てついた銀瑠璃の星々","translation":"","kind":"lyric"},{"id":"95","start":214.96,"end":217.96,"text":"燃上がる滅びの煌きよ","translation":"","kind":"lyric"},{"id":"96","start":218.84,"end":221.84,"text":"失くした楽園の夢を見る","translation":"","kind":"lyric"},{"id":"97","start":222.69,"end":225.69,"text":"私を導け《星屑の幻灯》(The Light of StarDust)","translation":"","kind":"lyric"},{"id":"98","start":227.19,"end":229.03,"text":"想い出を過去の光として","translation":"","kind":"lyric"},{"id":"99","start":229.03,"end":230.7,"text":"埋葬出来ない限り","translation":"","kind":"lyric"},{"id":"100","start":230.7,"end":231.86,"text":"孤独な亡霊は","translation":"","kind":"lyric"},{"id":"101","start":231.86,"end":234.39,"text":"荒野を彷徨い続けるだろう","translation":"","kind":"lyric"},{"id":"102","start":234.39,"end":236.37,"text":"女の手は悲しい程に短く","translation":"","kind":"lyric"},{"id":"103","start":236.37,"end":238.49,"text":"星屑には届かない","translation":"","kind":"lyric"},{"id":"104","start":238.49,"end":238.94,"text":"嗚呼","translation":"","kind":"lyric"},{"id":"105","start":238.94,"end":241.0,"text":"その手を握り返したのは","translation":"","kind":"lyric"},{"id":"106","start":241.0,"end":244.0,"text":"『仮面の男』だった","translation":"","kind":"lyric"}],"candidates":[]}