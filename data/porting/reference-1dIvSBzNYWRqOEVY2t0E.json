"","kind":"lyric"},{"id":"19","start":64.96,"end":66.73,"text":"夜の真ん中","translation":"","kind":"lyric"},{"id":"20","start":66.73,"end":71.76,"text":"無難になんてやってらんないから","translation":"","kind":"lyric"},{"id":"21","start":71.76,"end":73.6,"text":"帰る場所もないの","translation":"","kind":"lyric"},{"id":"22","start":73.6,"end":77.01,"text":"この想いを消してしまうには","translation":"","kind":"lyric"},{"id":"23","start":77.01,"end":80.39,"text":"まだ人生長いでしょ (I'm on the way)","translation":"","kind":"lyric"},{"id":"24","start":80.39,"end":82.11,"text":"懐かしくなる","translation":"","kind":"lyric"},{"id":"25","start":82.11,"end":85.39,"text":"こんな痛みも歓迎じゃん","translation":"","kind":"lyric"},{"id":"26","start":85.39,"end":92.1,"text":"​","translation":"","kind":"lyric"},{"id":"27","start":92.1,"end":95.88,"text":"謝らなくちゃいけないよね","translation":"","kind":"lyric"},{"id":"28","start":95.88,"end":98.78,"text":"ああ ごめんね","translation":"","kind":"lyric"},{"id":"29","start":98.78,"end":100.93,"text":"うまく言えなくて","translation":"","kind":"lyric"},{"id":"30","start":100.93,"end":104.88,"text":"心配かけたままだったね","translation":"","kind":"lyric"},{"id":"31","start":104.88,"end":106.39,"text":"あの日抱えた全部","translation":"","kind":"lyric"},{"id":"32","start":106.39,"end":108.11,"text":"明日抱える全部","translation":"","kind":"lyric"},{"id":"33","start":108.11,"end":111.62,"text":"順番つけたりはしないから","translation":"","kind":"lyric"},{"id":"34","start":111.62,"end":113.24000000000001,"text":"分かってくれます様に","translation":"","kind":"lyric"},{"id":"35","start":113.24000000000001,"end":114.89,"text":"そっと目を閉じたんだ","translation":"","kind":"lyric"},{"id":"36","start":114.89,"end":118.49000000000001,"text":"見たくないものまで見えんだもん","translation":"","kind":"lyric"},{"id":"37","start":118.49000000000001,"end":120.22,"text":"いらない噂にちょっと","translation":"","kind":"lyric"},{"id":"38","start":120.22,"end":121.93,"text":"初めて聞く発言どっち","translation":"","kind":"lyric"},{"id":"39","start":121.93,"end":123.55,"text":"向かい合ったら友達だって","translation":"","kind":"lyric"},{"id":"40","start":