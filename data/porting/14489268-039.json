{"originalLanguage":"ja","title":"Magia","artist":"Kalafina","date":"2026-08-01","sourceId":"14489268:039","sourceHash":"244ba6e5a81e0335de8b91ef4985494aa8e3935d73a2b86ec000a9effcca8e6c","duration":314.7999999999993,"cues":[{"id":"1","start":21.405541,"end":26.925604,"text":"いつか君が瞳に灯す愛の光が","translation":"언젠가 네 눈동자에 밝혀질 사랑의 빛이","kind":"lyric"},{"id":"2","start":26.945604,"end":29.095629,"text":"時を超えて","translation":"시간을 넘어","kind":"lyric"},{"id":"3","start":29.115629,"end":32.875,"text":"滅び急ぐ世界の夢を","translation":"멸망으로 치닫는 세계의 꿈을","kind":"lyric"},{"id":"4","start":33.075674,"end":36.785717,"text":"確かに一つ壊すだろう","translation":"분명 하나 부수겠지","kind":"lyric"},{"id":"5","start":36.805717,"end":39.345,"text":"躊躇いを飲み干して","translation":"망설임을 모두 삼키고","kind":"lyric"},{"id":"6","start":39.605749,"end":43.24579,"text":"君が望むモノは何?","translation":"네가 바라는 건 뭐야","kind":"lyric"},{"id":"7","start":43.26579,"end":48.415849,"text":"こんな欲深い憧れの行方に","translation":"이토록 욕심 많은 동경의 행방에","kind":"lyric"},{"id":"8","start":48.435849,"end":54.135996,"text":"儚い明日はあるの?","translation":"덧없는 내일은 있을까","kind":"lyric"},{"id":"9","start":54.175915,"end":57.615,"text":"子供の頃夢に見てた","translation":"어릴 적 꿈에서 보았던","kind":"lyric"},{"id":"10","start":57.865957,"end":61.395,"text":"古の魔法のように","translation":"태고의 마법처럼","kind":"lyric"},{"id":"11","start":61.616,"end":65.135,"text":"闇さえ砕く力で","translation":"어둠마저 부수는 힘으로","kind":"lyric"},{"id":"12","start":65.466044,"end":69.366089,"text":"微笑む君に会いたい","translation":"미소 짓는 널 만나고 싶어","kind":"lyric"},{"id":"13","start":69.386089,"end":73.276133,"text":"怯えるこの手の中には","translation":"두려워하는 이 손안에는","kind":"lyric"},{"id":"14","start":73.296133,"end":77.056176,"text":"手折られた花の勇気","translation":"꺾인 꽃의 용기","kind":"lyric"},{"id":"15","start":77.076176,"end":80.91622,"text":"想いだけが頼る全て","translation":"마음만이 의지할 전부","kind":"lyric"},{"id":"16","start":80.93622,"end":84.716264,"text":"光を呼び覚ます","translation":"빛을 일깨우는","kind":"lyric"},{"id":"17","start":84.736264,"end":94.396512,"text":"願い","translation":"소원","kind":"lyric"},{"id":"18","start":94.436375,"end":98.145,"text":"いつか君も誰かの為に","translation":"언젠가 너도 누군가를 위해","kind":"lyric"},{"id":"19","start":98.40642,"end":101.986461,"text":"強い力を望むのだろう","translation":"강한 힘을 바라게 되겠지","kind":"lyric"},{"id":"20","start":102.006461,"end":106.086566,"text":"愛が胸を捉えた夜に","translation":"사랑이 가슴을 붙잡은 밤에","kind":"lyric"},{"id":"21","start":106.176509,"end":109.656598,"text":"未知の言葉が生まれて来る","translation":"미지의 말이 태어나","kind":"lyric"},{"id":"22","start":109.686549,"end":112.275,"text":"迷わずに行けるなら","translation":"망설임 없이 갈 수 있다면","kind":"lyric"},{"id":"23","start":112.486581,"end":115.745,"text":"心が砕けてもいいわ","translation":"마음이 부서져도 좋아","kind":"lyric"},{"id":"24","start":116.066622,"end":120.26673,"text":"いつも目の前の哀しみに","translation":"언제나 눈앞의 슬픔에","kind":"lyric"},{"id":"25","start":120.31667,"end":123.006701,"text":"立ち向かう為の","translation":"맞서기 위한","kind":"lyric"},{"id":"26","start":123.026701,"end":126.685,"text":"呪文が欲しい","translation":"주문이 필요해","kind":"lyric"},{"id":"27","start":126.946746,"end":130.76679,"text":"君はまだ夢見る記憶","translation":"너는 아직 꿈꾸는 기억","kind":"lyric"},{"id":"28","start":130.78679,"end":134.385,"text":"私は眠らない明日","translation":"나는 잠들지 않는 내일","kind":"lyric"},{"id":"29","start":134.646834,"end":138.546934,"text":"二人が出会う奇跡を","translation":"둘이 만나는 기적을","kind":"lyric"},{"id":"30","start":138.616879,"end":142.386922,"text":"勝ち取る為に進むわ","translation":"쟁취하기 위해 나아갈게","kind":"lyric"},{"id":"31","start":142.406922,"end":146.18702,"text":"怯えるこの手の中には","translation":"두려워하는 이 손안에는","kind":"lyric"},{"id":"32","start":146.216966,"end":150.09701,"text":"手折られた花の刃","translation":"꺾인 꽃의 칼날","kind":"lyric"},{"id":"33","start":150.11701,"end":153.837106,"text":"想いだけが生きる全て","translation":"마음만이 살아가는 전부","kind":"lyric"},{"id":"34","start":153.877053,"end":157.717152,"text":"心に振りかざす","translation":"마음에 휘두르는","kind":"lyric"},{"id":"35","start":157.757098,"end":163.205,"text":"願い","translation":"소원","kind":"lyric"},{"id":"36","start":218.877796,"end":226.617995,"text":"囚われた太陽の輝く","translation":"갇힌 태양이 빛나는","kind":"lyric"},{"id":"37","start":226.647884,"end":233.905,"text":"不思議の国の本が好きだった頃","translation":"이상한 나라의 책을 좋아하던 시절","kind":"lyric"},{"id":"38","start":234.16797,"end":237.995,"text":"願いはきっと叶うと","translation":"소원은 꼭 이뤄진다고","kind":"lyric"},{"id":"39","start":238.178016,"end":240.868047,"text":"教えるお伽噺を","translation":"가르쳐 준 동화를","kind":"lyric"},{"id":"40","start":240.888047,"end":249.888278,"text":"信じた (光と影の中)","translation":"빛과 그림자 속에서 믿었어","kind":"lyric"},{"id":"41","start":257.388235,"end":261.408339,"text":"静かに咲き乱れていた","translation":"조용히 흐드러져 피던","kind":"lyric"},{"id":"42","start":261.458282,"end":264.87837,"text":"古の魔法優しく","translation":"태고의 마법이 다정히","kind":"lyric"},{"id":"43","start":264.908321,"end":269.108429,"text":"世界を変える力が","translation":"세상을 바꿀 힘이","kind":"lyric"},{"id":"44","start":269.13837,"end":272.558457,"text":"その手にあると囁く","translation":"그 손에 있다고 속삭여","kind":"lyric"},{"id":"45","start":272.808411,"end":276.415,"text":"終わらない夢を見よう","translation":"끝나지 않는 꿈을 꾸자","kind":"lyric"},{"id":"46","start":276.638455,"end":280.598501,"text":"君と行く時の中で","translation":"너와 가는 시간 속에서","kind":"lyric"},{"id":"47","start":280.618501,"end":284.458599,"text":"想いだけが生きる全て","translation":"마음만이 살아가는 전부","kind":"lyric"},{"id":"48","start":284.498545,"end":288.278642,"text":"命を作るのは","translation":"생명을 만드는 건","kind":"lyric"},{"id":"49","start":288.328589,"end":296.145,"text":"願い","translation":"소원","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}