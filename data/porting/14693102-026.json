{"originalLanguage":"ja","title":"물거품","artist":"ヨルシカ","date":"2026-08-14","sourceId":"14693102:026","sourceHash":"2f2393ecdc8c8ec8ad7d46df357772eb3a6fda8d2ce121354b77e3a61f081b4a","duration":291.32,"cues":[{"id":"1","start":71.267,"end":74.337,"text":"あぁどうしようもないほどに","translation":"아아 어쩔 도리가 없을 만큼","kind":"lyric"},{"id":"2","start":74.397,"end":77.66,"text":"私に蠢く獣","translation":"내 안에서 꿈틀대는 짐승","kind":"lyric"},{"id":"3","start":77.72,"end":83.72,"text":"水面浮かんで浮かんでは消える あぶく","translation":"수면에 떠올랐다 사라지는 물거품","kind":"lyric"},{"id":"4","start":88.95,"end":91.55,"text":"あぁどうしようもなく悲しい","translation":"아아 어쩔 도리 없이 슬퍼","kind":"lyric"},{"id":"5","start":91.61,"end":97.23,"text":"私を動かす獣","translation":"나를 움직이는 짐승","kind":"lyric"},{"id":"6","start":97.29,"end":99.67,"text":"トートロジー握った手のあぶく","translation":"동어반복을 움켜쥔 손의 물거품","kind":"lyric"},{"id":"7","start":99.73,"end":103.17,"text":"過ぎ去る雲を思うより","translation":"흘러가는 구름을 생각하기보다","kind":"lyric"},{"id":"8","start":103.23,"end":107.57,"text":"遥かへ遠吠え","translation":"아득한 곳으로 울부짖어","kind":"lyric"},{"id":"9","start":107.63,"end":109.01,"text":"息継ぐ暇もないほど","translation":"숨 돌릴 틈도 없을 만큼","kind":"lyric"},{"id":"10","start":109.07,"end":112.972,"text":"苦しいあれで","translation":"괴로운 그것으로","kind":"lyric"},{"id":"11","start":113.032,"end":115.829,"text":"悠々悠々夢を焼け","translation":"유유히 유유히 꿈을 불태워","kind":"lyric"},{"id":"12","start":115.889,"end":119.615,"text":"魂の白い白い色で","translation":"영혼의 새하얀 빛깔로","kind":"lyric"},{"id":"13","start":119.675,"end":124.939,"text":"喜びの火に火をつけたいだけ","translation":"기쁨의 불에 불을 붙이고 싶을 뿐","kind":"lyric"},{"id":"14","start":124.999,"end":127.92,"text":"想像は少しの泡銭","translation":"상상은 조금의 뜬돈","kind":"lyric"},{"id":"15","start":127.98,"end":131.675,"text":"冷めない言葉の両手で","translation":"식지 않는 말의 두 손으로","kind":"lyric"},{"id":"16","start":131.735,"end":136.968,"text":"燃え尽きないものを数えて","translation":"다 타지 않는 것들을 세어","kind":"lyric"},{"id":"17","start":137.028,"end":143.028,"text":"掬いたいだけ","translation":"건져 올리고 싶을 뿐","kind":"lyric"},{"id":"18","start":149.985,"end":153.0,"text":"さぁ 銘々ご覧遊べ","translation":"자 각자 마음껏 구경해","kind":"lyric"},{"id":"19","start":153.06,"end":156.6,"text":"私の乾いた獣","translation":"나의 메마른 짐승","kind":"lyric"},{"id":"20","start":156.66,"end":158.46,"text":"ふつふつ怒った音を鳴らして","translation":"부글부글 성난 소리를 울리며","kind":"lyric"},{"id":"21","start":158.52,"end":163.18,"text":"あぁろうそくの火を消して","translation":"아아 촛불을 꺼 버리고","kind":"lyric"},{"id":"22","start":163.24,"end":165.62,"text":"私に残ったものは","translation":"내게 남은 것은","kind":"lyric"},{"id":"23","start":165.68,"end":170.14,"text":"滑稽なペダンチスムだけ","translation":"우스운 현학뿐","kind":"lyric"},{"id":"24","start":170.2,"end":174.87,"text":"過ぎ去る雲にどうして","translation":"흘러가는 구름에 어째서","kind":"lyric"},{"id":"25","start":174.93,"end":177.61,"text":"私は遠吠え","translation":"나는 울부짖어","kind":"lyric"},{"id":"26","start":177.67,"end":180.63,"text":"悲しむ暇もないほど","translation":"슬퍼할 틈도 없을 만큼","kind":"lyric"},{"id":"27","start":180.69,"end":186.08,"text":"悲しいあれで","translation":"슬픈 그것으로","kind":"lyric"},{"id":"28","start":186.14,"end":187.24,"text":"想想想像で一つだけ","translation":"상상 상상 상상으로 하나만","kind":"lyric"},{"id":"29","start":187.3,"end":190.923,"text":"寂しい私に太陽を","translation":"외로운 나에게 태양을","kind":"lyric"},{"id":"30","start":190.983,"end":195.994,"text":"喜びに火を、火をつけておくれ","translation":"기쁨에 불을 불을 붙여 줘","kind":"lyric"},{"id":"31","start":196.054,"end":198.939,"text":"焦燥も少しの泡銭","translation":"초조함도 조금의 뜬돈","kind":"lyric"},{"id":"32","start":198.999,"end":202.553,"text":"苦しい私の両手で","translation":"괴로운 나의 두 손으로","kind":"lyric"},{"id":"33","start":202.613,"end":207.744,"text":"燃え尽きないものを数えて","translation":"다 타지 않는 것들을 세어","kind":"lyric"},{"id":"34","start":207.804,"end":213.804,"text":"摘みたいだけ","translation":"따고 싶을 뿐","kind":"lyric"},{"id":"35","start":220.691,"end":223.965,"text":"半信半疑の満身創痍で尚","translation":"반신반의하며 만신창이인 채로도","kind":"lyric"},{"id":"36","start":224.025,"end":225.961,"text":"太陽が欲しい","translation":"태양을 원해","kind":"lyric"},{"id":"37","start":226.021,"end":229.036,"text":"だからもっと私に火をつけて","translation":"그러니 내게 더 불을 붙여","kind":"lyric"},{"id":"38","start":229.096,"end":232.36,"text":"吐き出して","translation":"토해 내","kind":"lyric"},{"id":"39","start":232.42,"end":237.42,"text":"超能力でも創作物でも現実逃避でもいい","translation":"초능력이든 창작물이든 현실 도피든 좋아","kind":"lyric"},{"id":"40","start":237.48,"end":240.9,"text":"もっと私に火をつけて","translation":"내게 더 불을 붙여","kind":"lyric"},{"id":"41","start":240.96,"end":246.96,"text":"私を震わせて","translation":"나를 떨게 해","kind":"lyric"},{"id":"42","start":255.373,"end":258.11,"text":"夕夕夕夕夕、目を焼け","translation":"저녁 저녁 저녁 저녁 저녁 눈을 태워","kind":"lyric"},{"id":"43","start":258.17,"end":260.95,"text":"魂の白い白い色で","translation":"영혼의 새하얀 빛깔로","kind":"lyric"},{"id":"44","start":261.01,"end":266.698,"text":"喜びの火に火をつけたいだけ","translation":"기쁨의 불에 불을 붙이고 싶을 뿐","kind":"lyric"},{"id":"45","start":266.758,"end":269.88,"text":"想像の頭上の上を行け","translation":"상상의 머리 위보다 더 높이 가","kind":"lyric"},{"id":"46","start":269.94,"end":273.0,"text":"冷めない言葉の両手で","translation":"식지 않는 말의 두 손으로","kind":"lyric"},{"id":"47","start":273.06,"end":278.78,"text":"燃え尽きたものも全て","translation":"다 타 버린 것까지 모두","kind":"lyric"},{"id":"48","start":278.84,"end":284.84,"text":"掬いたいだけ","translation":"건져 올리고 싶을 뿐","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}