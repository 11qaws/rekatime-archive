{"title":"Master of the Hellish Yard","artist":"mothy","sourceId":"reference:4AIiDI6eszuHYrvOYR1y","sourceHash":"61c62b9d4edf41fa457eb0a42482bc61b424b364243cb4c6b34e2b156b0d3e85","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":10.04,"end":13.04,"text":"私の 目の前 四角い黒箱","translation":"","kind":"lyric"},{"id":"2","start":18.37,"end":21.37,"text":"黒箱 真ん中 小さな鍵穴","translation":"","kind":"lyric"},{"id":"3","start":26.66,"end":29.66,"text":"鍵穴 差し込む 黄金の鍵","translation":"","kind":"lyric"},{"id":"4","start":34.8,"end":37.8,"text":"その鍵 あるのは 私の掌の中","translation":"","kind":"lyric"},{"id":"5","start":53.73,"end":56.73,"text":"血に飢えた狼達","translation":"","kind":"lyric"},{"id":"6","start":56.77,"end":59.67,"text":"骨と皮の亡者達","translation":"","kind":"lyric"},{"id":"7","start":59.67,"end":62.67,"text":"赤い空を舞いし鳥は","translation":"","kind":"lyric"},{"id":"8","start":62.96,"end":65.96000000000001,"text":"耳をつんざく奇声放つ","translation":"","kind":"lyric"},{"id":"9","start":67.77,"end":70.61,"text":"ああ 私は気づいてしまった","translation":"","kind":"lyric"},{"id":"10","start":70.61,"end":73.61,"text":"自分の今いるこの場所が","translation":"","kind":"lyric"},{"id":"11","start":73.88,"end":76.88,"text":"紛れもない地獄そのものであることを","translation":"","kind":"lyric"},{"id":"12","start":81.63,"end":84.63,"text":"Ma Ma Ma Ma Ma Ma Ma Ma","translation":"","kind":"lyric"},{"id":"13","start":84.81,"end":87.81,"text":"Ma Ma Ma Ma Ma Ma Ma Ma Ma","translation":"","kind":"lyric"},{"id":"14","start":88.08,"end":90.96000000000001,"text":"我は冥界の主","translation":"","kind":"lyric"},{"id":"15","start":90.96000000000001,"end":93.96000000000001,"text":"地獄を滅ぼす者","translation":"","kind":"lyric"},{"id":"16","start":94.22,"end":97.22,"text":"存在してはいけなかったこの場所","translation":"","kind":"lyric"},{"id":"17","start":100.6,"end":103.6,"text":"全てを無へと帰す時が来たの","translation":"","kind":"lyric"},{"id":"18","start":117.55,"end":120.51,"text":"罪は七つに分かれ","translation":"","kind":"lyric"},{"id":"19","start":120.51,"end":123.51,"text":"緩やかに地獄を生んだ","translation":"","kind":"lyric"},{"id":"20","start":123.78,"end":126.61,"text":"それを消し去ることが","translation":"","kind":"lyric"},{"id":"21","start":126.61,"end":129.61,"text":"私に与えられた使命","translation":"","kind":"lyric"},{"id":"22","start":131.46,"end":134.46,"text":"黄金の鍵を差し込めば","translation":"","kind":"lyric"},{"id":"23","start":134.69,"end":137.69,"text":"全ての物語は終わる","translation":"","kind":"lyric"},{"id":"24","start":137.89,"end":140.18,"text":"森へと放つ最後の『少年』","translation":"","kind":"lyric"},{"id":"25","start":140.18,"end":143.18,"text":"その名は『罰』","translation":"","kind":"lyric"},{"id":"26","start":145.41,"end":148.41,"text":"Ma Ma Ma Ma Ma Ma Ma Ma","translation":"","kind":"lyric"},{"id":"27","start":148.74,"end":151.74,"text":"Ma Ma Ma Ma Ma Ma Ma Ma Ma","translation":"","kind":"lyric"},{"id":"28","start":151.92000000000002,"end":154.81,"text":"今や我は死なり","translation":"","kind":"lyric"},{"id":"29","start":154.81,"end":157.81,"text":"全てを滅ぼす者","translation":"","kind":"lyric"},{"id":"30","start":158.07999999999998,"end":161.07999999999998,"text":"存在してはいけなかったこの場所","translation":"","kind":"lyric"},{"id":"31","start":164.5,"end":167.5,"text":"血塗られた地獄『エヴィリオス』よ 消えろ","translation":"","kind":"lyric"},{"id":"32","start":184.85,"end":187.75,"text":"独裁者となった暗殺者","translation":"","kind":"lyric"},{"id":"33","start":187.75,"end":190.75,"text":"彼女が「罰」を放った時","translation":"","kind":"lyric"},{"id":"34","start":190.96,"end":192.46,"text":"誰かが言った","translation":"","kind":"lyric"},{"id":"35","start":192.46,"end":195.46,"text":"「これで我々は皆⋯","translation":"","kind":"lyric"},{"id":"36","start":196.38,"end":198.72,"text":"くそったれだ」","translation":"","kind":"lyric"},{"id":"37","start":198.72,"end":201.72,"text":"Ma Ma Ma Ma Ma Ma Ma Ma","translation":"","kind":"lyric"},{"id":"38","start":201.73,"end":204.73,"text":"Ma Ma Ma Ma Ma Ma Ma Ma Ma","translation":"","kind":"lyric"},