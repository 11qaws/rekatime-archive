{"originalLanguage":"en","title":"Drunken Sailor","artist":"Nathan Evans","date":"2026-07-14","sourceId":"YzJm-mk52WM:013","sourceHash":"cb6e70fd1a8772d99b53609bf5a3855d53f184ebce007cd4f214da6a5ce38632","duration":138.0,"cues":[{"id":"1","start":5.0,"end":6.9,"text":"What will we do with a drunken sailor?","translation":"술 취한 선원을 어쩌면 좋나","kind":"lyric"},{"id":"2","start":6.9,"end":8.82,"text":"What will we do with a drunken sailor?","translation":"술 취한 선원을 어쩌면 좋나","kind":"lyric"},{"id":"3","start":8.82,"end":10.84,"text":"What will we do with a drunken sailor?","translation":"술 취한 선원을 어쩌면 좋나","kind":"lyric"},{"id":"4","start":10.84,"end":12.36,"text":"Early in the morning","translation":"이른 아침에","kind":"lyric"},{"id":"5","start":12.38,"end":15.12,"text":"Way hey and up she rises","translation":"웨이 헤이 끌어올려라","kind":"lyric"},{"id":"6","start":15.12,"end":17.28,"text":"Way hey and up she rises","translation":"웨이 헤이 끌어올려라","kind":"lyric"},{"id":"7","start":17.28,"end":19.32,"text":"Way hey and up she rises","translation":"웨이 헤이 끌어올려라","kind":"lyric"},{"id":"8","start":19.32,"end":21.28,"text":"Early in the morning","translation":"이른 아침에","kind":"lyric"},{"id":"9","start":21.78,"end":23.98,"text":"Shave his belly with a rusty razor","translation":"녹슨 면도칼로 배를 밀어라","kind":"lyric"},{"id":"10","start":24.0,"end":26.06,"text":"Shave his belly with a rusty razor","translation":"녹슨 면도칼로 배를 밀어라","kind":"lyric"},{"id":"11","start":26.06,"end":28.22,"text":"Shave his belly with a rusty razor","translation":"녹슨 면도칼로 배를 밀어라","kind":"lyric"},{"id":"12","start":28.26,"end":30.32,"text":"Early in the morning","translation":"이른 아침에","kind":"lyric"},{"id":"13","start":30.34,"end":32.68,"text":"Way hey and up she rises","translation":"웨이 헤이 끌어올려라","kind":"lyric"},{"id":"14","start":32.84,"end":34.76,"text":"Way hey and up she rises","translation":"웨이 헤이 끌어올려라","kind":"lyric"},{"id":"15","start":34.76,"end":36.76,"text":"Way hey and up she rises","translation":"웨이 헤이 끌어올려라","kind":"lyric"}