{"title":"추형공포증","artist":"나루미야","sourceId":"reference:ns3b4cQMZlZec6KAgKV7","sourceHash":"7733432145fc7d07a2859cc67be209091b806b73791f9ab97c949c3912aed2a1","performanceStatus":"no_performance_record","timingMethod":"reference_lyric_character_matching","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":1.09,"end":6.42,"text":"つまり顔面失敗作の僕だから 一生報われないのです!","translation":"","kind":"lyric"},{"id":"2","start":16.97,"end":22.37,"text":"「結局努力する子が1番」 なんて戯言にはだまされない","translation":"","kind":"lyric"},{"id":"3","start":22.37,"end":24.83,"text":"少女漫画の最後笑うのは","translation":"","kind":"lyric"},{"id":"4","start":24.83,"end":27.96,"text":"綺麗な顔したヒロインだから","translation":"","kind":"lyric"},{"id":"5","start":27.96,"end":30.53,"text":"鏡もカメラも自傷道具","translation":"","kind":"lyric"},{"id":"6","start":30.53,"end":33.02,"text":"画面の中で笑うあの子に","translation":"","kind":"lyric"},{"id":"7","start":33.02,"end":35.64,"text":"ただ醜い妬みが渦巻いて","translation":"","kind":"lyric"},{"id":"8","start":35.64,"end":38.5,"text":"性格まで腐ったの","translation":"","kind":"lyric"},{"id":"9","start":38.5,"end":40.8,"text":"おまじないをかけて神様!","translation":"","kind":"lyric"},{"id":"10","start":40.8,"end":43.61,"text":"華やかで残酷な魔法をね","translation":"","kind":"lyric"},{"id":"11","start":43.61,"end":46.13,"text":"魘された夜も溶かせたのなら","translation":"","kind":"lyric"},{"id":"12","start":46.13,"end":49.23,"text":"それはなんと素敵な夢物語","translation":"","kind":"lyric"},{"id":"13","start":49.23,"end":51.69,"text":"肌伝うもの感じながら","translation":"","kind":"lyric"},{"id":"14","start":51.69,"end":54.49,"text":"あいまいな意識を手放した日","translation":"","kind":"lyric"},{"id":"15","start":54.49,"end":56.88,"text":"あの人が傷口に顔寄せて","translation":"","kind":"lyric"},{"id":"16","start":56.88,"end":59.66,"text":"そっと塞いでくれる夢を見た。","translation":"","kind":"lyric"},{"id":"17","start":59.66,"end":64.94,"text":"鏡見て病んで心ギリギリ の今","translation":"","kind":"lyric"},{"id":"18","start":62.41,"end":64.94,"text":"可愛いあの子はいきいき!","translation":"","kind":"lyric"},{"id":"19","start":64.94,"end":73.01,"text":"つまり顔面失敗作の僕だから 一生報われないのです! 一生救われないのです","translation":"","kind":"lyric"},{"id":"20","start":83.59,"end":86.28,"text":"ママに貰ったこの体さえも","translation":"","kind":"lyric"},{"id":"21","start":86.28,"end":88.81,"text":"愛せないのは親不孝ですか","translation":"","kind":"lyric"},{"id":"22","start":88.81,"end":91.99,"text":"運が良かったキミには分からないね","translation":"","kind":"lyric"},{"id":"23","start":91.99,"end":94.56,"text":"分かりたくもないよね(笑)","translation":"","kind":"lyric"},{"id":"24","start":94.56,"end":97.14,"text":"お金も時間も惜しまないで","translation":"","kind":"lyric"},{"id":"25","start":97.14,"end":99.99000000000001,"text":"どんな努力を積み重ねても","translation":"","kind":"lyric"},{"id":"26","start":99.99000000000001,"end":102.47,"text":"「加工だ」 「メイクだ」 「整形」 とか。","translation":"","kind":"lyric"},{"id":"27","start":102.47,"end":105.28999999999999,"text":"元良くなきゃ叩かれる始末","translation":"","kind":"lyric"},{"id":"28","start":105.28999999999999,"end":107.57,"text":"おまじないをかけて神様","translation":"","kind":"lyric"},{"id":"29","start":107.57,"end":110.4,"text":"華やかで残酷な魔法をね","translation":"","kind":"lyric"},{"id":"30","start":110.4,"end":112.95,"text":"魘された夜も溶かせたのなら","translation":"","kind":"lyric"},{"id":"31","start":112.95,"end":115.71000000000001,"text":"それはなんと素敵な・・・!!!","translation":"","kind":"lyric"},{"id":"32","start":115.71000000000001,"end":118.32,"text":"肌伝うもの感じながら","translation":"","kind":"lyric"},{"id":"33","start":118.32,"end":120.99,"text":"あいまいな意識を手放した日","translation":"","kind":"lyric"},{"id":"34","start":120.99,"end":123.51,"text":"あの人が傷口に顔寄せて","translation":"","kind":"lyric"},{"id":"35","start":123.51,"end":126.33,"text":"そっと塞いでくれる夢を見た","translation":"","kind":"lyric"},{"id":"36","start":126.33,"end":131.73,"text":"鏡見て病んで心ギリギリ の今","translation":"","kind":"lyric"},{"id":"37","start":128.81,"end":131.73,"text":"可愛いあの子はいきいき!","translation":"","kind":"lyric"},{"id":"38","start":131.73,"end":137.31,"text":"つまり顔面失敗作の僕だから 一生報われないのです!","translation":"","kind":"lyric"},{"id":"39","start":137.31,"end":139.62,"text":"来世に希望を見出し","translation":"","kind":"lyric"},{"id":"40","start":139.62,"end":142.22,"text":"されど妄想の中引きこもり","translation":"","kind":"lyric"},{"id":"41","start":142.22,"end":145.36,"text":"晴れて人間失格!堕ちた僕だから","translation":"","kind":"lyric"},{"id":"42","start":145.36,"end":150.57,"text":"一生報われないのです 一生救われないのです","translation":"","kind":"lyric"}],"candidates":[]}