{"title":"Master of the Heavenly yard","artist":"mothy","sourceId":"reference:Z8QvRDQOGU1XB9Ijj6P0","sourceHash":"bedace9593fb76342f6b5c7680aceb050fbbe04970cb0b2d1b2141af878c8b3b","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":1.5,"end":4.5,"text":"1. エピローグ","translation":"","kind":"lyric"},{"id":"2","start":35.07,"end":38.07,"text":"僕らはいつでも 間違いだらけだった","translation":"","kind":"lyric"},{"id":"3","start":41.88,"end":44.88,"text":"この千年の時で","translation":"","kind":"lyric"},{"id":"4","start":48.16,"end":51.16,"text":"「もしも」の願いが 叶うことはもうない","translation":"","kind":"lyric"},{"id":"5","start":54.9,"end":57.9,"text":"罰は下された","translation":"","kind":"lyric"},{"id":"6","start":61.37,"end":64.37,"text":"幾億の魂達よ","translation":"","kind":"lyric"},{"id":"7","start":67.76,"end":70.76,"text":"幾億の悪意達よ","translation":"","kind":"lyric"},{"id":"8","start":74.48,"end":77.48,"text":"不幸な結末は誰かのせいなのか？","translation":"","kind":"lyric"},{"id":"9","start":81.05,"end":84.05,"text":"そう考えてる奴等は皆「くそったれ」さ","translation":"","kind":"lyric"},{"id":"10","start":89.12,"end":92.12,"text":"僕らは結局何かを残したのか？","translation":"","kind":"lyric"},{"id":"11","start":95.92,"end":98.92,"text":"この千年の旅で","translation":"","kind":"lyric"},{"id":"12","start":102.38,"end":105.38,"text":"答えはきっと いつまでも出ないから","translation":"","kind":"lyric"},{"id":"13","start":109.07,"end":112.07,"text":"君に会いに行くよ","translation":"","kind":"lyric"},{"id":"14","start":148.94,"end":151.94,"text":"2. 大罪狩り","translation":"","kind":"lyric"},{"id":"15","start":188.34,"end":191.06,"text":"滅びた世界の中心","translation":"","kind":"lyric"},{"id":"16","start":191.06,"end":193.95,"text":"荒野に浮かぶ映画館","translation":"","kind":"lyric"},{"id":"17","start":193.95,"end":196.95,"text":"死せる魂が集いて","translation":"","kind":"lyric"},{"id":"18","start":197.24,"end":200.24,"text":"黒き箱を崇めている","translation":"","kind":"lyric"},{"id":"19","start":200.3,"end":203.26,"text":"館の主 庭師の男","translation":"","kind":"lyric"},{"id":"20","start":203.26,"end":206.01,"text":"魂達に指令を下す","translation":"","kind":"lyric"},{"id":"21","start":206.01,"end":209.01,"text":"世界を救う為には","translation":"","kind":"lyric"},{"id":"22","start":209.27,"end":212.27,"text":"為さねばならぬ事がある","translation":"","kind":"lyric"},{"id":"23","start":212.32999999999998,"end":215.32999999999998,"text":"悪魔に魅入られた魂を滅ぼせ","translation":"","kind":"lyric"},{"id":"24","start":217.98,"end":220.98,"text":"全ての元凶「大罪契約者」を殺せ","translation":"","kind":"lyric"},{"id":"25","start":224.21,"end":227.21,"text":"動き出す魂の従者","translation":"","kind":"lyric"},{"id":"26","start":229.84,"end":232.84,"text":"「大罪狩り」が今 始まった","translation":"","kind":"lyric"},{"id":"27","start":236.07,"end":239.07,"text":"3. 王女の旅立ち","translation":"","kind":"lyric"},{"id":"28","start":253.52,"end":256.52,"text":"王女の前には眠りこける家臣達 それは誰かからの「gift」","translation":"","kind":"lyric"},{"id":"29","start":265.62,"end":268.62,"text":"彼女を守れる者はもういない 迫りくる庭師の軍勢","translation":"","kind":"lyric"},{"id":"30","start":277.86,"end":280.86,"text":"白き馬に乗って現われた修道女","translation":"","kind":"lyric"},{"id":"31","start":284.06,"end":287.06,"text":"王女を助け出し 新たな旅へ","translation":"","kind":"lyric"},{"id":"32","start":290.06,"end":293.06,"text":"もう待っているだけなのはたくさんなの","translation":"","kind":"lyric"},{"id":"33","start":295.31,"end":298.31,"text":"守られてばかりは嫌だ","translation":"","kind":"lyric"},{"id":"34","start":301.67,"end":304.67,"text":"自分自身で全てを成し遂げたら","translation":"","kind":"lyric"},{"id":"35","start":307.52,"end":310.52,"text":"胸を張って君に会いに行くよ","translation":"","kind":"lyric"},{"id":"36","start":313.93,"end":316.93,"text":"4.英雄たち","translation":"","kind":"lyric"},{"id":"37","start":332.99,"end":335.99,"text":"「悪とは一体何なのか？」","translation":"","kind":"lyric"},{"id":"38","start":337.53,"end":340.53,"text":"七つの罪 背負いし者","translation":"","kind":"lyric"},{"id":"39","start":344.92,"end":347.92,"text":"世界と共に滅んだはず","translation":"","kind":"lyric"},{"id":"40","start":349.57,"end":352.57,"text":"されども まだ 生きている","translation":"","kind":"lyric"},{"id":"41","start":355.89,"end":358.8,"text":"罪は決して許されぬのか？","translation":"","kind":"lyric"},{"id":"42","start":358.8,"end":361.8,"text":"声をあげる者がいた","translation":"","kind":"lyric"},{"id":"43","start":362.11,"end":365.02,"text":"庭師の野望を止めるため","translation":"","kind":"lyric"},{"id":"44","start":365.02,"end":368.02,"text":"英雄も平民も幻の剣をとる","translation":"","kind":"lyric"},{"id":"45","start":370.92,"end":373.92,"text":"正義も悪も全てを唄に変えよう","translation":"","kind":"lyric"},{"id":"46","start":376.5,"end":379.5,"text":"罰はすでに下されたのだから","translation":"","kind":"lyric"},{"id":"47","start":382.79,"end":385.79,"text":"過ちを二度と繰り返さぬよう","translation":"","kind":"lyric"},{"id":"48","start":388.56,"end":391.56,"text":"今こそ我々は戦おう","translation":"","kind":"lyric"},{"id":"49","start":395.28,"end":398.28,"text":"5. BLACKBOX","translation":"","kind":"lyric"},{"id":"50","start":425.56,"end":428.56,"text":"禁じられた黒き箱（今開かれる）","translation":"","kind":"lyric"},{"id":"51","start":431.34,"end":434.34,"text":"その力は神の浄化（あるいは初期化）","translation":"","kind":"lyric"},{"id":"52","start":437.31,"end":440.31,"text":"人の魂など所詮は","translation":"","kind":"lyric"},{"id":"53","start":440.57,"end":443.31,"text":"データの一部に過ぎない","translation":"","kind":"lyric"},{"id":"54","start":443.31,"end":446.31,"text":"黒き箱のぜんまいは廻り","translation":"","kind":"lyric"},{"id":"55","start":446.32,"end":449.32,"text":"全てを溶かし尽くしてゆく","translation":"","kind":"lyric"},{"id":"56","start":449.64,"end":452.64,"text":"その渦に逆らう事は出来ぬ","translation":"","kind":"lyric"},{"id":"57","start":452.74,"end":455.61,"text":"あれは神の定めしプログラム","translation":"","kind":"lyric"},{"id":"58","start":455.61,"end":458.55,"text":"それを止めることができるのも","translation":"","kind":"lyric"},{"id":"59","start":458.55,"end":461.55,"text":"神以外にはいないのだから","translation":"","kind":"lyric"},{"id":"60","start":466.88,"end":469.88,"text":"この世でたった一人だけ","translation":"","kind":"lyric"},{"id":"61","start":470.03,"end":472.86,"text":"生き続けていた","translation":"","kind":"lyric"},{"id":"62","start":472.86,"end":475.86,"text":"彼女の銃から放たれた","translation":"","kind":"lyric"},{"id":"63","start":476.15,"end":478.99,"text":"金色の銃弾","translation":"","kind":"lyric"},{"id":"64","start":478.99,"end":481.99,"text":"空に舞う黒き花火を見つめ続けながら","translation":"","kind":"lyric"},{"id":"65","start":485.32,"end":488.32,"text":"誰の事を想うのか","translation":"","kind":"lyric"},{"id":"66","start":491.36,"end":494.36,"text":"古き神々の時代が終わりを告げ","translation":"","kind":"lyric"},{"id":"67","start":496.47,"end":499.47,"text":"そして また時が動き出す","translation":"","kind":"lyric"},{"id":"68","start":531.0,"end":534.0,"text":"6. Not Eve","translation":"","kind":"lyric"},{"id":"69","start":548.25,"end":551.25,"text":"これは終焉の物語","translation":"","kind":"lyric"},{"id":"70","start":552.66,"end":555.66,"text":"何から語りましょうか？","translation":"","kind":"lyric"},{"id":"71","start":557.2,"end":560.2,"text":"私の名前は 私の名前は","translation":"","kind":"lyric"},{"id":"72","start":566.07,"end":569.07,"text":"私の名前は 私の名前は ……誰？","translation":"","kind":"lyric"},{"id":"73","start":583.46,"end":586.46,"text":"7. 狂想の終わり","translation":"","kind":"lyric"},{"id":"74","start":598.43,"end":601.43,"text":"辿りついた映画館王女にとってそこは","translation":"","kind":"lyric"},{"id":"75","start":602.31,"end":605.31,"text":"黒幕の住む場所そしてかつての故郷","translation":"","kind":"lyric"},{"id":"76","start":606.17,"end":609.17,"text":"庭師などしょせん傀儡真に倒すべき敵は","translation":"","kind":"lyric"},{"id":"77","start":609.95,"end":612.95,"text":"人形に宿りし者箱庭の少女","translation":"","kind":"lyric"},{"id":"78","start":613.62,"end":616.62,"text":"嗚呼、歯車よ、何故に お前は彼女を守るのか？","translation":"","kind":"lyric"},{"id":"79","start":617.2,"end":620.2,"text":"その女はお前の 想い人ではないというのに","translation":"","kind":"lyric"},{"id":"80","start":620.95,"end":623.95,"text":"邪魔するというなら温情などかけぬぞ","translation":"","kind":"lyric"},{"id":"81","start":624.82,"end":627.82,"text":"我は傲慢な王女悪ノ娘なのだから","translation":"","kind":"lyric"},{"id":"82","start":628.48,"end":631.48,"text":"ついにその時はやって来た 終りを告げる鐘がなる","translation":"","kind":"lyric"},{"id":"83","start":632.21,"end":635.21,"text":"あれは心音の時計塔 罪を刻む針","translation":"","kind":"lyric"},{"id":"84","start":636.06,"end":639.06,"text":"いかなる者であろうとも 私に逆らうなら","translation":"","kind":"lyric"},{"id":"85","start":639.78,"end":642.78,"text":"粛清してしまえ「さぁ、ひざまずきなさい！」","translation":"","kind":"lyric"},{"id":"86","start":647.33,"end":648.29,"text":"8. 再会","translation":"","kind":"lyric"},{"id":"87","start":648.29,"end":651.29,"text":"僕らはいつでも 間違いだらけだった","translation":"","kind":"lyric"},{"id":"88","start":654.87,"end":657.87,"text":"この千年の時で","translation":"","kind":"lyric"},{"id":"89","start":661.5,"end":664.5,"text":"君にずっと会いたいと思ってた","translation":"","kind":"lyric"},{"id":"90","start":667.93,"end":670.93,"text":"そう 君の名は（エムエイ）","translation":"","kind":"lyric"},{"id":"91","start":689.77,"end":692.77,"text":"9. 純粋なる悪","translation":"","kind":"lyric"},{"id":"92","start":708.01,"end":711.01,"text":"王女を探し求めた少年 その姉の中に彼女はいた","translation":"","kind":"lyric"},{"id":"93","start":713.91,"end":716.91,"text":"真の純粋な存在 目指して 七つの悪魔 取り込んだ魔女","translation":"","kind":"lyric"},{"id":"94","start":720.08,"end":723.08,"text":"消滅の直前 人形は 魔女の意思を蘇らせた","translation":"","kind":"lyric"},{"id":"95","start":726.1,"end":729.1,"text":"黒き箱に飲み込まれながら 庭師は最後にこう叫んだ","translation":"","kind":"lyric"},{"id":"96","start":731.75,"end":734.75,"text":"世界を救いたくばその娘を殺せ","translation":"","kind":"lyric"},{"id":"97","start":737.75,"end":740.75,"text":"魔女と同化した悪ノ娘を殺せ","translation":"","kind":"lyric"},{"id":"98","start":743.65,"end":746.65,"text":"迫られる最後の決断","translation":"","kind":"lyric"},{"id":"99","start":749.65,"end":752.65,"text":"少年よ どちらを選ぶのか","translation":"","kind":"lyric"},{"id":"100","start":755.99,"end":758.99,"text":"10. 少年の選択","translation":"","kind":"lyric"},{"id":"101","start":779.48,"end":782.48,"text":"「悪とは一体何なのか？」誰かの言葉","translation":"","kind":"lyric"},{"id":"102","start":786.82,"end":789.82,"text":"人は誰しも欲深いもの","translation":"","kind":"lyric"},{"id":"103","start":792.92,"end":795.92,"text":"僕だってそれは同じだから","translation":"","kind":"lyric"},{"id":"104","start":798.83,"end":801.83,"text":"君と世界 どちらも、手に入れる！","translation":"","kind":"lyric"},{"id":"105","start":803.6,"end":803.78,"text":"11. Re_birthday Truth","translation":"","kind":"lyric"},{"id":"106","start":803.78,"end":806.78,"text":"強き決意が気まぐれな 奇跡をもたらした 君の手から落ちた小さな小瓶","translation":"","kind":"lyric"},{"id":"107","start":809.93,"end":812.93,"text":"書かれていたメッセージ「必ず助けなさい！」君らしいやと小さく笑う","translation":"","kind":"lyric"},{"id":"108","start":815.8,"end":818.8,"text":"大丈夫僕は君を 絶対に守るから 世界はもはや僕らの敵じゃない","translation":"","kind":"lyric"},{"id":"109","start":821.82,"end":824.82,"text":"さぁ、共に手を取り前に進もう 新たな世界と君の為に","translation":"","kind":"lyric"},{"id":"110","start":828.53,"end":831.53,"text":"ほら、空を見てごらん","translation":"","kind":"lyric"},{"id":"111","start":832.08,"end":835.08,"text":"世界は 月に映る鏡","translation":"","kind":"lyric"},{"id":"112","start":836.57,"end":839.57,"text":"その先で こちらを見ている","translation":"","kind":"lyric"},{"id":"113","start":841.15,"end":844.15,"text":"貴方が今目を覚ます時","translation":"","kind":"lyric"},{"id":"114","start":908.4,"end":911.4,"text":"12. プロローグ","translation":"","kind":"lyric"}],"candidates":[]}