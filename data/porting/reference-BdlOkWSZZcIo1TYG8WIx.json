{"title":"Warrior","artist":"Beth Crowley","sourceId":"reference:BdlOkWSZZcIo1TYG8WIx","sourceHash":"871335f134ba83bd835cd165349a4422aebf8202865a66958175db1ecc981a97","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":13.92,"end":16.61,"text":"You fascinated me","translation":"","kind":"lyric"},{"id":"2","start":16.61,"end":19.61,"text":"Cloaked in shadows and secrecy","translation":"","kind":"lyric"},{"id":"3","start":21.24,"end":24.24,"text":"The beauty of a broken angel","translation":"","kind":"lyric"},{"id":"4","start":28.45,"end":30.6,"text":"I ventured carefully","translation":"","kind":"lyric"},{"id":"5","start":30.6,"end":33.6,"text":"Afraid of what you thought I'd be","translation":"","kind":"lyric"},{"id":"6","start":35.43,"end":38.43,"text":"But pretty soon, I was entangled","translation":"","kind":"lyric"},{"id":"7","start":41.33,"end":44.33,"text":"You take me by the hand","translation":"","kind":"lyric"},{"id":"8","start":48.05,"end":51.05,"text":"I question who I am","translation":"","kind":"lyric"},{"id":"9","start":54.72,"end":56.37,"text":"Teach me how to fight","translation":"","kind":"lyric"},{"id":"10","start":56.37,"end":58.2,"text":"I'll show you how to win","translation":"","kind":"lyric"},{"id":"11","start":58.2,"end":59.9,"text":"You're my mortal flaw","translation":"","kind":"lyric"},{"id":"12","start":59.9,"end":61.75,"text":"And I'm your fatal sin","translation":"","kind":"lyric"},{"id":"13","start":61.75,"end":63.38,"text":"Let me feel the sting","translation":"","kind":"lyric"},{"id":"14","start":63.38,"end":64.19,"text":"The pain","translation":"","kind":"lyric"},{"id":"15","start":64.19,"end":65.06,"text":"The burn","translation":"","kind":"lyric"},{"id":"16","start":65.06,"end":65.84,"text":"Under my skin","translation":"","kind":"lyric"},{"id":"17","start":65.84,"end":68.84,"text":"Put me to the test","translation":"","kind":"lyric"},{"id":"18","start":70.44,"end":72.53999999999999,"text":"I'll prove that I'm strong","translation":"","kind":"lyric"},{"id":"19","start":72.53999999999999,"end":73.85,"text":"Won't let myself believe","translation":"","kind":"lyric"},{"id":"20","start":73.85,"end":76.08,"text":"That what we feel is wrong","translation":"","kind":"lyric"},{"id":"21","start":76.08,"end":77.03999999999999,"text":"I finally see what","translation":"","kind":"lyric"},{"id":"22","start":77.03999999999999,"end":79.22,"text":"You knew was inside me","translation":"","kind":"lyric"},{"id":"23","start":79.22,"end":82.22,"text":"All along","translation":"","kind":"lyric"},{"id":"24","start":83.28,"end":86.28,"text":"That behind this soft exterior","translation":"","kind":"lyric"},{"id":"25","start":89.72,"end":92.72,"text":"Lies a warrior","translation":"","kind":"lyric"},{"id":"26","start":106.82,"end":109.24000000000001,"text":"My memory refused","translation":"","kind":"lyric"},{"id":"27","start":109.24000000000001,"end":112.24000000000001,"text":"To separate the lies from truth","translation":"","kind":"lyric"},{"id":"28","start":113.86,"end":115.78,"text":"And search the past","translation":"","kind":"lyric"},{"id":"29","start":115.78,"end":118.78,"text":"My mind created","translation":"","kind":"lyric"},{"id":"30","start":120.59,"end":123.59,"text":"I kept on pushing through","translation":"","kind":"lyric"},{"id":"31","start":124.08,"end":127.08,"text":"Standing resolute which you","translation":"","kind":"lyric"},{"id":"32","start":127.82,"end":129.92,"text":"In equal measure","translation":"","kind":"lyric"},{"id":"33","start":129.92,"end":132.92,"text":"Loved and hated","translation":"","kind":"lyric"},{"id":"34","start":133.99,"end":136.99,"text":"You take me by the hand","translation":"","kind":"lyric"},{"id":"35","start":140.98,"end":143.98,"text":"I'm seeing who I am","translation":"","kind":"lyric"},{"id":"36","start":147