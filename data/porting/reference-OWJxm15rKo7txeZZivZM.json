{"title":"닌자의 권유","artist":"마후마후","sourceId":"reference:OWJxm15rKo7txeZZivZM","sourceHash":"a7316e2889cea0551b0668d6614fec7d15d1b3682f827d572bf2866a96a7ff1b","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":25.13,"end":28.13,"text":"どれだけ歩めども 道はなく","translation":"","kind":"lyric"},{"id":"2","start":32.8,"end":35.8,"text":"彷徨うは千里先","translation":"","kind":"lyric"},{"id":"3","start":38.48,"end":41.48,"text":"それが人の世だと 笑う君だったんだ","translation":"","kind":"lyric"},{"id":"4","start":45.04,"end":48.04,"text":"然れど散りゆく定め","translation":"","kind":"lyric"},{"id":"5","start":50.97,"end":53.97,"text":"この一世を例えるなら","translation":"","kind":"lyric"},{"id":"6","start":54.63,"end":57.63,"text":"止まず 頻る 遣らずの雨","translation":"","kind":"lyric"},{"id":"7","start":57.95,"end":60.82,"text":"消える夜鳥に夢花火","translation":"","kind":"lyric"},{"id":"8","start":60.82,"end":63.82,"text":"水面に映る月を求めて","translation":"","kind":"lyric"},{"id":"9","start":66.86,"end":69.86,"text":"悔やむことは もうやめた","translation":"","kind":"lyric"},{"id":"10","start":70.85,"end":73.85,"text":"忍び偲べ 心隠して","translation":"","kind":"lyric"},{"id":"11","start":73.86,"end":76.86,"text":"踊り踊る世界を回せ","translation":"","kind":"lyric"},{"id":"12","start":77.28999999999999,"end":79.72,"text":"鏡越しに隠していた","translation":"","kind":"lyric"},{"id":"13","start":79.72,"end":82.72,"text":"ボクが泣きじゃくっている間に","translation":"","kind":"lyric"},{"id":"14","start":83.08,"end":86.08,"text":"先見えぬ夜に紛れましょう","translation":"","kind":"lyric"},{"id":"15","start":86.16,"end":89.16,"text":"悟られぬよう口を噤みましょう","translation":"","kind":"lyric"},{"id":"16","start":89.28,"end":92.28,"text":"最愛も 恋情も 朋友も 友情も","translation":"","kind":"lyric"},{"id":"17","start":92.53999999999999,"end":95.53999999999999,"text":"手に掛ける覚悟はあるか?","translation":"","kind":"lyric"},{"id":"18","start":95.75,"end":98.22,"text":"暗がりの向こうに潜む忍者になって","translation":"","kind":"lyric"},{"id":"19","start":98.22,"end":101.22,"text":"あの日の夢まで 切り捨ての免罪符","translation":"","kind":"lyric"},{"id":"20","start":113.6,"end":116.6,"text":"誰そ彼時までは身を隠して","translation":"","kind":"lyric"},{"id":"21","start":119.78,"end":122.78,"text":"その陰に今日を置く","translation":"","kind":"lyric"},{"id":"22","start":125.96,"end":128.95999999999998,"text":"二世も契れぬまま 彷徨えるボクは","translation":"","kind":"lyric"},{"id":"23","start":131.95,"end":134.95,"text":"ひどく醜い「手の目」","translation":"","kind":"lyric"},{"id":"24","start":138.95,"end":141.95,"text":"徒花のその姿に 心惹かれても","translation":"","kind":"lyric"},{"id":"25","start":144.88,"end":147.88,"text":"現世だって朧月","translation":"","kind":"lyric"},{"id":"26","start":148.1,"end":151.1,"text":"何もかもを閉ざした矢先に","translation":"","kind":"lyric"},{"id":"27","start":153.73,"end":156.73,"text":"君に恋するという報い","translation":"","kind":"lyric"},{"id":"28","start":158.2,"end":161.05,"text":"片恋の行く先を知りたい","translation":"","kind":"lyric"},{"id":"29","start":161.05,"end":164.05,"text":"その手負いの心を救いたい","translation":"","kind":"lyric"},{"id":"30","start":164.15,"end":166.88,"text":"返り血の装束じゃ","translation":"","kind":"lyric"},{"id":"31","start":166.88,"end":169.88,"text":"何を望もうと値打ちない","translation":"","kind":"lyric"},{"id":"32","start":170.01,"end":173.01,"text":"書き違えた「辛せ」の行方","translation":"","kind":"lyric"},{"id":"33","start":173.41,"end":176.41,"text":"読み違えた為体が所衣","translation":"","kind":"lyric"},{"id":"34","start":176.8,"end":179.8,"text":"生涯は滑稽な 憂愁の証明か","translation":"","kind":"lyric"},{"id":"35","start":179.86,"end":182.81,"text":"未だ十字架を背負いこんで","translation":"","kind":"lyric"},{"id":"36","start":182.81,"end":185.52,"text":"鵜の真似をしていちゃ それが千慮の一失","translation":"","kind":"lyric"},{"id":"37","start":185.52,"end":188.52,"text":"覚悟もないなら 御帰りになって頂戴","translation":"","kind":"lyric"},{"id":"38","start":213.71,"end":216.71,"text":"いつか物心で捨てた心根","translation":"","kind":"lyric"},{"id":"39","start":217.07999999999998,"end":220.07999999999998,"text":"わかり合えるなんて夢のまた夢","translation":"","kind":"lyric"},{"id":"40","start":220.24,"end":223.24,"text":"破れ果てた友の骸に","translation":"","kind":"lyric"},{"id":"41","start":223.91,"end":226.91,"text":"今日も立っている","translation":"","kind":"lyric"},{"id":"42","start":229.69,"end":232.61,"text":"お別れです","translation":"","kind":"lyric"},{"id":"43","start":232.61,"end":235.61,"text":"忍び偲べ 心隠して","translation":"","kind":"lyric"},{"id":"44","start":235.82999999999998,"end":238.82999999999998,"text":"踊り踊る世界を回せ","translation":"","kind":"lyric"},{"id":"45","start":238.96,"end":241.9,"text":"鏡越しに涙した","translation":"","kind":"lyric"},{"id":"46","start":241.9,"end":244.9,"text":"君は誰だっけ ボクは誰?","translation":"","kind":"lyric"},{"id":"47","start":244.91,"end":247.91,"text":"空になった心なら捨てたんだ","translation":"","kind":"lyric"},{"id":"48","start":248.61,"end":251.17,"text":"優しくしないでよ","translation":"","kind":"lyric"},{"id":"49","start":251.17,"end":254.17,"text":"この小さな覆面も 塗り固めた強がりも","translation":"","kind":"lyric"},{"id":"50","start":254.52,"end":257.47,"text":"剥がれ落ちて泣いてしまう","translation":"","kind":"lyric"},{"id":"51","start":257.47,"end":260.29,"text":"暗がりの向こうに潜む忍者になって","translation":"","kind":"lyric"},{"id":"52","start":260.29,"end":263.29,"text":"あの日の夢まで 切り捨ての免罪符","translation":"","kind":"lyric"}],"candidates":[]}