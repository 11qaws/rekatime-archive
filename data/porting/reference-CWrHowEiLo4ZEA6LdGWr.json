{"title":"점묘의 노래","artist":"Mrs. GREEN APPLE","sourceId":"reference:CWrHowEiLo4ZEA6LdGWr","sourceHash":"9f677b0629a326d87cdb17db13835e12d4f861cce40d2ede580aedb5738082a5","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":36441416,"cues":[{"id":"1","start":26.79,"end":33.13,"text":"貴方の声で解れてゆく","translation":"","kind":"lyric"},{"id":"2","start":33.13,"end":39.72,"text":"忘れたくないと心が云う","translation":"","kind":"lyric"},{"id":"3","start":39.72,"end":45.97,"text":"思い出ばっか増えてゆく","translation":"","kind":"lyric"},{"id":"4","start":45.97,"end":51.72,"text":"ずっと側に居たい","translation":"","kind":"lyric"},{"id":"5","start":51.72,"end":58.13,"text":"泣き虫でもいいかな","translation":"","kind":"lyric"},{"id":"6","start":58.13,"end":64.54,"text":"強がらないでいいよ","translation":"","kind":"lyric"},{"id":"7","start":64.54,"end":70.83,"text":"限りある恋だとしても","translation":"","kind":"lyric"},{"id":"8","start":70.83,"end":76.89,"text":"出逢えて幸せです","translation":"","kind":"lyric"},{"id":"9","start":76.89,"end":80.59,"text":"いつまでも","translation":"","kind":"lyric"},{"id":"10","start":80.59,"end":83.28999999999999,"text":"いつまでも","translation":"","kind":"lyric"},{"id":"11","start":83.28999999999999,"end":89.46000000000001,"text":"続いて欲しいと願っている","translation":"","kind":"lyric"},{"id":"12","start":89.46000000000001,"end":96.36,"text":"手を取ることは出来ずとも","translation":"","kind":"lyric"},{"id":"13","start":96.36,"end":103.22999999999999,"text":"私は貴方を好いている","translation":"","kind":"lyric"},{"id":"14","start":103.22999999999999,"end":109.74000000000001,"text":"貴方の夢で心安らぐ","translation":"","kind":"lyric"},{"id":"15","start":109.74000000000001,"end":115.94,"text":"目覚めたくないと僕は云う","translation":"","kind":"lyric"},{"id":"16","start":115.94,"end":122.22,"text":"思い出ばっか増えてゆく","translation":"","kind":"lyric"},{"id":"17","start":122.22,"end":129.6,"text":"明日も側に居たい","translation":"","kind":"lyric"},{"id":"18","start":140.97,"end":143.98,"text":"どこまでも","translation":"","kind":"lyric"},{"id":"19","start":143.98,"end":147.1,"text":"どこまでも","translation":"","kind":"lyric"},{"id":"20","start":147.1,"end":153.74,"text":"鈍感な僕を叱って欲しい","translation":"","kind":"lyric"},{"id":"21","start":153.74,"end":159.8,"text":"当たり前が壊れることに","translation":"","kind":"lyric"},{"id":"22","start":159.8,"end":165.57,"text":"気づけないくらいに子供だけど","translation":"","kind":"lyric"},{"id":"23","start":165.57,"end":172.46,"text":"ちゃんと僕は貴方を好いている","translation":"","kind":"lyric"},{"id":"24","start":172.46,"end":186.28,"text":"私の (僕の) 時間が止まればいいのに","translation":"","kind":"lyric"},{"id":"25","start":197.97,"end":201.47,"text":"ほらまた期待をしてしまう","translation":"","kind":"lyric"},{"id":"26","start":201.47,"end":204.13,"text":"グッと堪えてみるからさ","translation":"","kind":"lyric"},{"id":"27","start":204.13,"end":206.0,"text":"もし溢れ出したら","translation":"","kind":"lyric"},{"id":"28","start":206.0,"end":211.23,"text":"瞳をちゃんと見てよ 見てよ 見て","translation":"","kind":"lyric"},{"id":"29","start":211.23,"end":216.5,"text":"貴方の影だけ伸びてゆく","translation":"","kind":"lyric"},{"id":"30","start":216.5,"end":221.72,"text":"消えてしまわないで","translation":"","kind":"lyric"},{"id":"31","start":221.72,"end":226.53,"text":"ずっと この思いは変わらない","translation":"","kind":"lyric"},{"id":"32","start":226.53,"end":229.24,"text":"いつまでも","translation":"","kind":"lyric"},{"id":"33","start":229.24,"end":232.34,"text":"いつまでも","translation":"","kind":"lyric"},{"id":"34","start":232.34,"end":238.61,"text":"続いて欲しいと願っている","translation":"","kind":"lyric"},{"id":"35","start":238.61,"end":245.46,"text":"手を取ることは出来ずとも","translation":"","kind":"lyric"},{"id":"36","start":245.46,"end":251.48,"text":"過ぎていく現在に抱きしめられている","translation":"","kind":"lyric"},{"id":"37","start":251.48,"end":258.16,"text":"私の (僕の)","translation":"","kind":"lyric"},{"id":"38","start":258.16,"end":264.59,"text":"時間が止まればいいのに","translation":"","kind":"lyric"},{"id":"39","start":264.59,"end":270.