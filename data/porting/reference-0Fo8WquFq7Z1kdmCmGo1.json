slation":"","kind":"lyric"},{"id":"18","start":78.93,"end":81.93,"text":"あなたは今どんな感じ?","translation":"","kind":"lyric"},{"id":"19","start":89.88,"end":92.15,"text":"「パスコード毎回入力面倒だね」","translation":"","kind":"lyric"},{"id":"20","start":92.15,"end":95.15,"text":"「GPS追跡アプリ 便利だね」","translation":"","kind":"lyric"},{"id":"21","start":95.78999999999999,"end":98.77000000000001,"text":"「今夜は満月が綺麗だね」","translation":"","kind":"lyric"},{"id":"22","start":98.77000000000001,"end":101.77000000000001,"text":"ねぇねぇねぇ 話を聞いてよ","translation":"","kind":"lyric"},{"id":"23","start":102.49000000000001,"end":104.07,"text":"わかってないけど「わかります」","translation":"","kind":"lyric"},{"id":"24","start":104.07,"end":105.78999999999999,"text":"良く知らないけど「ああ それね」","translation":"","kind":"lyric"},{"id":"25","start":105.78999999999999,"end":107.49000000000001,"text":"すべっているけど「すべらんなあ」","translation":"","kind":"lyric"},{"id":"26","start":107.49000000000001,"end":109.46000000000001,"text":"ほんとは悲しいけど「いぇいいぇい」","translation":"","kind":"lyric"},{"id":"27","start":109.46000000000001,"end":110.62,"text":"他愛ない嘘 他愛ない嘘","translation":"","kind":"lyric"},{"id":"28","start":110.62,"end":112.34,"text":"他愛ない嘘 ついてるよ","translation":"","kind":"lyric"},{"id":"29","start":112.34,"end":115.34,"text":"こっちを振り向いて欲しいから!","translation":"","kind":"lyric"},{"id":"30","start":115.61,"end":118.61,"text":"ねぇねぇねぇ ハートマーク消して 照れ隠しのテンションです","translation":"","kind":"lyric"},{"id":"31","start":122.17,"end":125.17,"text":"ドキドキに蓋をして向かい合う度 他言語を使ってる感じ","translation":"","kind":"lyric"},{"id":"32","start":128.77,"end":131.77,"text":"ねぇねぇねぇ 端役の八等星 不器用なりに夢を見て","translation":"","kind":"lyric"},{"id":"33","start":135.42,"end":138.42,"text":"心の奥深くで迷子の恋 他人事みたいな感じ","translation":"","kind":"lyric"},{"id":"34","start":141.98,"end":144.55,"text":"近いのに遠のいてる感じ","translation":"","kind":"lyric"},{"id":"35","start":144.55,"end":147.55,"text":"かまってちゃんって なんで? 身勝手だって なんで?","translation":"","kind":"lyric"},{"id":"36","start":148.61,"end":151.61,"text":"悩んでしまって 不安で 黙って 泡になっちゃう アローン アローン","translation":"","kind":"lyric"},{"id":"37","start":152.18,"end":155.12,"text":"すれ違う双方の ねぇねぇねぇねぇ","translation":"","kind":"lyric"},{"id":"38","start":155.12,"end":158.12,"text":"無関心も 安心も 紙一重さ","translation":"","kind":"lyric"},{"id":"39","start":158.6,"end":161.6,"text":"ねぇねぇねぇ ＠君へ 一方通行のメンションです","translation":"","kind":"lyric"},{"id":"40","start":164.47,"end":167.47,"text":"夜明けまで二人 喋っているのに ひとりごとみたいな感じ","translation":"","kind":"lyric"},{"id":"41","start":171.49,"end":174.49,"text":"ねぇねぇねぇ 臆病な劣等生 ぼくたちは未経験です","translation":"","kind":"lyric"},{"id":"42","start":178.1,"end":181.1,"text":"世界中 「好き」で溢れてるのに ひとりきりみたいな感じ","translation":"","kind":"lyric"},{"id":"43","start":184.56,"end":187.56,"text":"あなたは今どんな感じ?","translation":"","kind":"lyric"},{"id":"44","start":187.84,"end":190.84,"text":"二人とも大好きな感じ?","translation":"","kind":"lyric"},{"id":"45","start":201.07,"end":204.07,"text":"片方を選べない感じ?","translation":"","kind":"lyric"}],"candidates":[]}