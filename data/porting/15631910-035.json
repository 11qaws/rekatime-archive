{"title":"댄스홀","artist":"Mrs. GREEN APPLE","date":"2026-10-11","sourceId":"15631910:035","sourceHash":"bae3e72e23327ea8a743bf77c3d0bd3e48ab37e29c10b7bdfe86d445060f26bc","duration":203.5,"cues":[{"id":"1","start":5.102355,"end":7.080854,"text":"いつだって大丈夫","translation":"언제나 괜찮아","kind":"lyric"},{"id":"2","start":7.132236,"end":9.492096,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"3","start":9.512096,"end":13.852313,"text":"君が居るから愛を知ることがまた出来る","translation":"네가 있기에 다시 사랑을 알 수 있어","kind":"lyric"},{"id":"4","start":13.961834,"end":16.722313,"text":"「大好き」を歌える","translation":"사랑해를 노래할 수 있어","kind":"lyric"},{"id":"5","start":32.140765,"end":35.052313,"text":"知らぬ間に誰かいる","translation":"어느새 곁에 누군가 있고","kind":"lyric"},{"id":"6","start":36.290521,"end":39.906398,"text":"それに甘えすぎてる","translation":"그에게 너무 기대고 있어","kind":"lyric"},{"id":"7","start":39.930306,"end":44.97889,"text":"何処かできっと僕の事を","translation":"어딘가엔 분명 나를","kind":"lyric"},{"id":"8","start":45.070004,"end":49.095226,"text":"恨んでる人がいる","translation":"원망하는 사람도 있어","kind":"lyric"},{"id":"9","start":49.129765,"end":53.70078,"text":"溜息を吐いて吸って吸って吐かれては","translation":"한숨을 내쉬고 들이쉬고 또 내쉬다 보면","kind":"lyric"},{"id":"10","start":53.939482,"end":58.742313,"text":"幸せを見逃しちゃうけど","translation":"행복을 놓쳐버리겠지만","kind":"lyric"},{"id":"11","start":58.969186,"end":62.312168,"text":"きっと結構ありがち","translation":"분명 꽤 흔한 일이야","kind":"lyric"},{"id":"12","start":62.428983,"end":66.438746,"text":"足元にあるもの","translation":"발밑에 있는 것들","kind":"lyric"},{"id":"13","start":66.458746,"end":68.232573,"text":"いつだって大丈夫","translation":"언제나 괜찮아","kind":"lyric"},{"id":"14","start":68.308637,"end":70.287136,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"15","start":70.308519,"end":74.743086,"text":"君が居るから愛を知ることがまた出来る","translation":"네가 있기에 다시 사랑을 알 수 있어","kind":"lyric"},{"id":"16","start":74.808255,"end":76.786754,"text":"今日もほら陽が昇る","translation":"오늘도 봐 해가 떠올라","kind":"lyric"},{"id":"17","start":76.828136,"end":79.011307,"text":"時代が周るダンスホール","translation":"시대가 돌아가는 댄스홀","kind":"lyric"},{"id":"18","start":79.038006,"end":81.677849,"text":"悲しいことは尽き無いけど","translation":"슬픈 일은 끝이 없지만","kind":"lyric"},{"id":"19","start":81.697849,"end":84.312313,"text":"幸せを数えてみる","translation":"행복을 세어 봐","kind":"lyric"},{"id":"20","start":88.727436,"end":92.407218,"text":"夢を追う君がいる","translation":"꿈을 좇는 네가 있어","kind":"lyric"},{"id":"21","start":92.427218,"end":96.588889,"text":"でもたまに自信を無くして見える","translation":"하지만 가끔 자신을 잃은 듯 보여","kind":"lyric"},{"id":"22","start":96.636971,"end":100.292313,"text":"誰かになんと言われようとも","translation":"누가 뭐라 하든","kind":"lyric"},{"id":"23","start":100.986715,"end":104.312313,"text":"君はそのままがいい","translation":"너는 지금 그대로가 좋아","kind":"lyric"},{"id":"24","start":105.386456,"end":110.616147,"text":"メンタルも成長痛を起こすでしょう","translation":"마음도 성장통을 앓겠지","kind":"lyric"},{"id":"25","start":110.636147,"end":115.275386,"text":"「無理をせず自分らしくいて」","translation":"무리 말고 너답게 있어","kind":"lyric"},{"id":"26","start":115.415866,"end":118.755668,"text":"それが出来たら悩んでないよ","translation":"그게 되면 고민도 안 하지","kind":"lyric"},{"id":"27","start":118.775668,"end":121.872313,"text":"まぁ明日こそ笑おう","translation":"그래 내일은 꼭 웃자","kind":"lyric"},{"id":"28","start":123.025418,"end":124.935693,"text":"結局は大丈夫","translation":"결국은 괜찮아","kind":"lyric"},{"id":"29","start":124.975304,"end":127.090251,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"30","start":127.115178,"end":131.48152,"text":"君の隣で愛を精一杯に探したい","translation":"네 곁에서 사랑을 온 힘 다해 찾고 싶어","kind":"lyric"},{"id":"31","start":131.554916,"end":133.669864,"text":"今日もまた怒られる","translation":"오늘도 또 혼나고","kind":"lyric"},{"id":"32","start":133.824783,"end":135.735058,"text":"気持ちの穴がポンっと増える","translation":"마음의 구멍이 퐁 하고 하나 더 늘어","kind":"lyric"},{"id":"33","start":135.784668,"end":141.012313,"text":"不器用だけど笑ってもらえるように笑う","translation":"서툴지만 웃게 해주려고 웃어","kind":"lyric"},{"id":"34","start":160.013242,"end":162.059965,"text":"いつだって大丈夫","translation":"언제나 괜찮아","kind":"lyric"},{"id":"35","start":162.113119,"end":164.332313,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"36","start":164.462981,"end":168.897547,"text":"楽しんだもん勝ちだ ダンスホール","translation":"즐기는 사람이 이겨 댄스홀","kind":"lyric"},{"id":"37","start":168.942717,"end":170.762609,"text":"また陽が昇る","translation":"다시 해가 떠올라","kind":"lyric"},{"id":"38","start":170.782609,"end":173.306901,"text":"時代が周るダンスホール","translation":"시대가 돌아가는 댄스홀","kind":"lyric"},{"id":"39","start":173.372456,"end":177.452313,"text":"足が疲れても踊る","translation":"발이 지쳐도 춤춰","kind":"lyric"},{"id":"40","start":177.622206,"end":181.647429,"text":"結局は大丈夫","translation":"결국은 괜찮아","kind":"lyric"},{"id":"41","start":181.671968,"end":183.561856,"text":"この世界はダンスホール","translation":"이 세상은 댄스홀","kind":"lyric"},{"id":"42","start":183.581856,"end":186.172313,"text":"あなたが主役のダンスホール","translation":"네가 주인공인 댄스홀","kind":"lyric"},{"id":"43","start":186.391691,"end":191.440274,"text":"You know? その笑顔が僕だけの太陽","translation":"알아 그 미소는 나만의 태양","kind":"lyric"},{"id":"44","start":191.481391,"end":194.902313,"text":"君が笑える為のダンスホール","translation":"네가 웃기 위한 댄스홀","kind":"lyric"},{"id":"45","start":195.141176,"end":198.21126,"text":"この愛を歌い続ける","translation":"이 사랑을 계속 노래할게","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}