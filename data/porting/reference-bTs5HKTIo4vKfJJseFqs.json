{"title":"호시아이","artist":"레프티 몬스터","sourceId":"reference:bTs5HKTIo4vKfJJseFqs","sourceHash":"d890857653c81cfaa13bc260dc4f3b021a4b2135f12c8b3607d418cce8319269","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":36729314,"cues":[{"id":"1","start":0.93,"end":6.83,"text":"会いに行くよ今 星を辿って","translation":"","kind":"lyric"},{"id":"2","start":6.83,"end":12.68,"text":"夜の闇に沈む君の街まで","translation":"","kind":"lyric"},{"id":"3","start":12.68,"end":18.46,"text":"誰にも内緒で 連れて行くのさ","translation":"","kind":"lyric"},{"id":"4","start":18.46,"end":24.32,"text":"二人だけの世界 君の手を引いて","translation":"","kind":"lyric"},{"id":"5","start":24.32,"end":36.27,"text":"さあ","translation":"","kind":"lyric"},{"id":"6","start":36.27,"end":42.02,"text":"君と僕を繋ぐ 最終列車が","translation":"","kind":"lyric"},{"id":"7","start":42.02,"end":47.96,"text":"昨日と今日の間を通り過ぎてく","translation":"","kind":"lyric"},{"id":"8","start":47.96,"end":53.6,"text":"窓の外流れる見慣れぬ景色に","translation":"","kind":"lyric"},{"id":"9","start":53.6,"end":59.77,"text":"胸騒ぎ何度も眺める時計","translation":"","kind":"lyric"},{"id":"10","start":59.77,"end":65.13,"text":"指折り数えて","translation":"","kind":"lyric"},{"id":"11","start":65.13,"end":70.96000000000001,"text":"この夜を待ってたんだ ああ","translation":"","kind":"lyric"},{"id":"12","start":70.96000000000001,"end":76.66,"text":"会いに行くよ今 星を辿って","translation":"","kind":"lyric"},{"id":"13","start":76.66,"end":82.31,"text":"夜の闇に沈む君の街まで","translation":"","kind":"lyric"},{"id":"14","start":82.31,"end":88.39,"text":"見上げた夜空に浮かぶ月だけ","translation":"","kind":"lyric"},{"id":"15","start":88.39,"end":118.13,"text":"二人の星合を知っているのは","translation":"","kind":"lyric"},{"id":"16","start":118.13,"end":123.52,"text":"降り立ったホームに夏草の匂い","translation":"","kind":"lyric"},{"id":"17","start":123.52,"end":129.37,"text":"胸いっぱい吸い込み 小走り向かう","translation":"","kind":"lyric"},{"id":"18","start":129.37,"end":135.22,"text":"待合室で 待ってくれていた君の","translation":"","kind":"lyric"},{"id":"19","start":135.22,"end":140.73,"text":"はにかんだ笑顔、零れた涙","translation":"","kind":"lyric"},{"id":"20","start":140.73,"end":146.54,"text":"話したい事は 山ほどあるのに","translation":"","kind":"lyric"},{"id":"21","start":146.54,"end":152.13,"text":"君に触れたとたん 飛んでいったんだ","translation":"","kind":"lyric"},{"id":"22","start":152.13,"end":158.19,"text":"言葉は要らない 高鳴る鼓動が","translation":"","kind":"lyric"},{"id":"23","start":158.19,"end":179.39,"text":"変わらない気持ちを伝えてくれたから","translation":"","kind":"lyric"},{"id":"24","start":179.39,"end":184.29,"text":"夜が明けたら","translation":"","kind":"lyric"},{"id":"25","start":184.29,"end":191.46,"text":"また僕らはなればなれなの","translation":"","kind":"lyric"},{"id":"26","start":191.46,"end":197.36,"text":"世界が二人を引き離そうとして","translation":"","kind":"lyric"},{"id":"27","start":197.36,"end":203.03,"text":"遠く暗い空に 君を隠しても","translation":"","kind":"lyric"},{"id":"28","start":203.03,"end":208.94,"text":"重なる思いが導いてくれるはず","translation":"","kind":"lyric"},{"id":"29","start":208.94,"end":214.84,"text":"星の河渡ってきっと何度でも","translation":"","kind":"lyric"},{"id":"30","start":214.84,"end":220.62,"text":"会いに行くよ だから涙を拭いて","translation":"","kind":"lyric"},{"id":"31","start":220.62,"end":226.47,"text":"何度生まれ変わっても君の元へと","translation":"","kind":"lyric"},{"id":"32","start":226.47,"end":232.28,"text":"見上げた夜空に浮かぶ月だけ","translation":"","kind":"lyric"},{"id":"33","start":232.28,"end":238.0,"text":"二人の星合を知っているのは","translation":"","kind":"lyric"},{"id":"34","start":238.0,"end":262.14,"text":"ねえ","translation":"","kind":"lyric"},{"id":"35","start":262.14,"end":267.6,"text":"窓から差し込む光の粒が","translation":"","kind":"lyric"},{"id":"36","start":267.6,"end":273.77,"text":"誰も居ないシートにこぼれた","translation":"","kind":"lyric"}],"candidates":[]}