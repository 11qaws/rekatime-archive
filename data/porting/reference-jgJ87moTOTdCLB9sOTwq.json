{"title":"에일리언 에일리언","artist":"나유탄 성인","sourceId":"reference:jgJ87moTOTdCLB9sOTwq","sourceHash":"e71b5535388c2278e6eec6a3e468bb3c0e6131b9f673450eef0a8b727200d532","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":21874864,"cues":[{"id":"1","start":18.09,"end":21.45,"text":"ゆれる街灯 篠突く雨","translation":"","kind":"lyric"},{"id":"2","start":21.45,"end":24.7,"text":"振れる感情 感覚のテレパス","translation":"","kind":"lyric"},{"id":"3","start":24.7,"end":27.91,"text":"迷子のふたりはコンタクト","translation":"","kind":"lyric"},{"id":"4","start":27.91,"end":32.78,"text":"ココロは恋を知りました","translation":"","kind":"lyric"},{"id":"5","start":37.59,"end":40.72,"text":"タイトロープ ツギハギの制服","translation":"","kind":"lyric"},{"id":"6","start":40.72,"end":43.62,"text":"重度のディスコミュニケーション","translation":"","kind":"lyric"},{"id":"7","start":43.62,"end":46.9,"text":"眼光 赤色にキラキラ","translation":"","kind":"lyric"},{"id":"8","start":46.9,"end":52.05,"text":"ナニカが起こる胸騒ぎ","translation":"","kind":"lyric"},{"id":"9","start":56.23,"end":59.35,"text":"エイリアン わたしエイリアン","translation":"","kind":"lyric"},{"id":"10","start":59.35,"end":62.51,"text":"あなたの心を惑わせる","translation":"","kind":"lyric"},{"id":"11","start":62.51,"end":65.73,"text":"交ざりあう宇宙の引力で","translation":"","kind":"lyric"},{"id":"12","start":65.73,"end":68.83,"text":"感じてる気持ちはトキメキ","translation":"","kind":"lyric"},{"id":"13","start":68.83,"end":72.26,"text":"エイリアン あなたのエイリアン","translation":"","kind":"lyric"},{"id":"14","start":72.26,"end":75.43,"text":"引きあう心は逃れられない","translation":"","kind":"lyric"},{"id":"15","start":75.43,"end":78.66,"text":"あなたに未体験あげる","translation":"","kind":"lyric"},{"id":"16","start":78.66,"end":90.43,"text":"異世界の果てまで トキメキ スキ","translation":"","kind":"lyric"},{"id":"17","start":94.0,"end":97.4,"text":"点灯と消灯を 繰り返している蛍光灯","translation":"","kind":"lyric"},{"id":"18","start":97.4,"end":100.46000000000001,"text":"超常な混沌が 静かにあなたを蝕んだ","translation":"","kind":"lyric"},{"id":"19","start":100.46000000000001,"end":103.68,"text":"並行な信号は 特異点に因り交わった","translation":"","kind":"lyric"},{"id":"20","start":103.68,"end":106.8,"text":"創造現実盲信症 感応性本能","translation":"","kind":"lyric"},{"id":"21","start":106.8,"end":110.06,"text":"シンドローム ひとりきり夜な夜な","translation":"","kind":"lyric"},{"id":"22","start":110.06,"end":113.35,"text":"空想 描くまるでグリモワ","translation":"","kind":"lyric"},{"id":"23","start":113.35,"end":116.05,"text":"サーチライト 避ける浮遊機","translation":"","kind":"lyric"},{"id":"24","start":116.05,"end":123.26,"text":"「まだあなたは全てを知りたい？」","translation":"","kind":"lyric"},{"id":"25","start":125.64,"end":128.94,"text":"エイリアン わたしエイリアン","translation":"","kind":"lyric"},{"id":"26","start":128.94,"end":131.79,"text":"あなたの心を惑わせる","translation":"","kind":"lyric"},{"id":"27","start":131.79,"end":138.35,"text":"瞳に映らない引力に 気づいてよわたしは","translation":"","kind":"lyric"},{"id":"28","start":138.35,"end":141.51,"text":"エイリアン あなたのエイリアン","translation":"","kind":"lyric"},{"id":"29","start":141.51,"end":144.48,"text":"触れあえば傷は二度と消えない","translation":"","kind":"lyric"},{"id":"30","start":144.48,"end":147.63,"text":"降りそそぐ無数の隕石も","translation":"","kind":"lyric"},{"id":"31","start":147.63,"end":150.92000000000002,"text":"ときめく心には 届かない！","translation":"","kind":"lyric"},{"id":"32","start":150.92000000000002,"end":154.15,"text":"エイリアン ふたりはエイリアン","translation":"","kind":"lyric"},{"id":"33","start":154.15,"end":157.36,"text":"高鳴る気持ちが抑えられない！","translation":"","kind":"lyric"},{"id":"34","start":157.36,"end":160.57999999999998,"text":"あなたは未確認生命体","translation":"","kind":"lyric"},{"id":"35","start":160.57999999999998,"end":163.92000000000002,"text":"異世界の果てまであなたが 好き","translation":"","kind":"lyric"}],"candidates":[]}