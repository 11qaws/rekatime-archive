{"originalLanguage":"ja","title":"세븐틴","artist":"YOASOBI","date":"2026-09-04","sourceId":"15033796:001","sourceHash":"616f5849b10b54070e5ff1ca81250917a0cea4135219673cf432eec1d90cbe41","duration":205.89999999999964,"cues":[{"id":"1","start":32.141455,"end":33.693582,"text":"鏡写しかのような","translation":"거울에 비친 듯","kind":"lyric"},{"id":"2","start":33.851513,"end":35.403641,"text":"瓜二つの世界に","translation":"꼭 닮은 두 세계에","kind":"lyric"},{"id":"3","start":35.521571,"end":38.518782,"text":"それぞれ生まれた二人の私","translation":"저마다 태어난 두 명의 나","kind":"lyric"},{"id":"4","start":38.571675,"end":40.551976,"text":"在るべき場所が違ったか","translation":"있어야 할 곳이 달랐던 걸까","kind":"lyric"},{"id":"5","start":40.691748,"end":42.297397,"text":"神様が間違ったか","translation":"신이 잘못한 걸까","kind":"lyric"},{"id":"6","start":42.381806,"end":46.005,"text":"同じ姿形中身は真反対","translation":"같은 모습과 형태 속은 정반대","kind":"lyric"},{"id":"7","start":52.742161,"end":54.294288,"text":"違和感はどうやら","translation":"위화감은 아무래도","kind":"lyric"},{"id":"8","start":54.342216,"end":55.947865,"text":"ずっと前に育ってた","translation":"아주 오래전부터 자라 있었어","kind":"lyric"},{"id":"9","start":56.042274,"end":59.093007,"text":"パパもママも大事に思ってる","translation":"아빠도 엄마도 소중히 여겨","kind":"lyric"},{"id":"10","start":59.182382,"end":61.109161,"text":"だけど私はどうやら","translation":"하지만 나는 아무래도","kind":"lyric"},{"id":"11","start":61.222451,"end":62.881622,"text":"此処じゃ私じゃないから","translation":"여기선 내가 아니니까","kind":"lyric"},{"id":"12","start":62.92251,"end":66.133808,"text":"赤は赤に黒は黒に戻るの","translation":"빨강은 빨강으로 검정은 검정으로 돌아가","kind":"lyric"},{"id":"13","start":66.212622,"end":69.423921,"text":"次元を隔てた向こう側の世界じゃ","translation":"차원을 사이에 둔 저편 세계에선","kind":"lyric"},{"id":"14","start":69.882748,"end":72.965,"text":"今日だって残酷な悪魔が鳴いている","translation":"오늘도 잔혹한 악마가 울고 있어","kind":"lyric"},{"id":"15","start":73.552874,"end":76.603607,"text":"あっちの私は怖がりで泣き虫なの","translation":"저쪽의 나는 겁 많고 울보야","kind":"lyric"},{"id":"16","start":76.752984,"end":80.205,"text":"見て見ぬ振りできないから","translation":"못 본 척할 수 없으니까","kind":"lyric"},{"id":"17","start":81.493146,"end":82.081884,"text":"これじゃ","translation":"이래선","kind":"lyric"},{"id":"18","start":82.113167,"end":84.685,"text":"ハッピーエンドとはいかない","translation":"해피 엔드가 될 수 없어","kind":"lyric"},{"id":"19","start":84.893263,"end":88.015,"text":"それじゃ救いに行くね世界","translation":"그럼 구하러 갈게 세계를","kind":"lyric"},{"id":"20","start":88.273378,"end":92.073415,"text":"こんな乱暴な私を許して","translation":"이렇게 난폭한 나를 용서해","kind":"lyric"},{"id":"21","start":92.133511,"end":95.045,"text":"きっとやり遂げるから","translation":"반드시 해낼 테니까","kind":"lyric"},{"id":"22","start":95.223617,"end":98.385,"text":"これはバッドエンドなんかじゃない","translation":"이건 배드 엔드 따위가 아니야","kind":"lyric"},{"id":"23","start":98.593732,"end":101.845,"text":"どこに居たとしても私は","translation":"어디에 있더라도 나는","kind":"lyric"},{"id":"24","start":101.953847,"end":106.235578,"text":"そう世界で一人のオリジナル","translation":"그래 이 세상에 하나뿐인 오리지널","kind":"lyric"},{"id":"25","start":106.273995,"end":111.565,"text":"誇らしく思ってくれたら嬉しいな","translation":"자랑스럽게 여겨 준다면 기쁠 거야","kind":"lyric"},{"id":"26","start":117.584383,"end":119.774459,"text":"境界の線で切り分けた","translation":"경계선으로 갈라놓은","kind":"lyric"},{"id":"27","start":119.794459,"end":121.560673,"text":"こちら側の世界じゃ","translation":"이쪽 세계에선","kind":"lyric"},{"id":"28","start":121.634522,"end":124.155,"text":"今日だって呑気な天使があくびする","translation":"오늘도 태평한 천사가 하품해","kind":"lyric"},{"id":"29","start":125.08464,"end":126.797332,"text":"気付いてしまった悪は","translation":"알아 버린 악은","kind":"lyric"},{"id":"30","start":126.824699,"end":128.376827,"text":"見逃せないから","translation":"눈감아 줄 수 없으니까","kind":"lyric"},{"id":"31","start":128.454755,"end":132.16,"text":"帰り道を交換しよう","translation":"돌아갈 길을 바꾸자","kind":"lyric"},{"id":"32","start":133.194918,"end":136.138608,"text":"私が希望になるの","translation":"내가 희망이 될게","kind":"lyric"},{"id":"33","start":136.215021,"end":139.800971,"text":"お別れは少し寂しいけれど","translation":"이별은 조금 쓸쓸하지만","kind":"lyric"},{"id":"34","start":140.025152,"end":143.645277,"text":"いつか目尻に作った傷も","translation":"언젠가 눈가에 생긴 상처도","kind":"lyric"},{"id":"35","start":143.665277,"end":149.375,"text":"理不尽に立ち向かった証だから","translation":"부조리에 맞선 증거니까","kind":"lyric"},{"id":"36","start":150.345505,"end":153.635,"text":"いつかハッピーエンドになるまで","translation":"언젠가 해피 엔드가 될 때까지","kind":"lyric"},{"id":"37","start":153.725621,"end":157.015,"text":"世界を相手に戦うの","translation":"세계를 상대로 싸울 거야","kind":"lyric"},{"id":"38","start":157.145739,"end":160.571123,"text":"こんな乱暴な私をずっと","translation":"이렇게 난폭한 나를 줄곧","kind":"lyric"},{"id":"39","start":160.815864,"end":163.855,"text":"愛してくれてありがとう","translation":"사랑해 줘서 고마워","kind":"lyric"},{"id":"40","start":164.085976,"end":167.365,"text":"これはバッドエンドなんかじゃない","translation":"이건 배드 엔드 따위가 아니야","kind":"lyric"},{"id":"41","start":167.456092,"end":170.720912,"text":"どこに居たとしても私は","translation":"어디에 있더라도 나는","kind":"lyric"},{"id":"42","start":170.90621,"end":174.973855,"text":"あなたの唯一無二のオリジナル","translation":"너만의 둘도 없는 오리지널","kind":"lyric"},{"id":"43","start":175.186357,"end":177.795,"text":"誇らしく生きるよ","translation":"자랑스럽게 살아갈게","kind":"lyric"},{"id":"44","start":177.946451,"end":180.635,"text":"さあ在るべき場所に帰ろう","translation":"자 이제 있어야 할 곳으로 돌아가자","kind":"lyric"},{"id":"45","start":180.746547,"end":183.5,"text":"さよならを告げたセブンティーン","translation":"작별을 고한 세븐틴","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}