lyric"},{"id":"18","start":53.88,"end":55.44,"text":"勝手にしてくださーい","translation":"마음대로 하세요","kind":"lyric"},{"id":"19","start":55.44,"end":60.18,"text":"Ui, Ui, Ui つかまえてみて","translation":"우이 우이 우이 잡아 봐","kind":"lyric"},{"id":"20","start":60.18,"end":62.04,"text":"ココロ追いかけっこ 続けましょ","translation":"마음의 술래잡기 계속해요","kind":"lyric"},{"id":"21","start":62.04,"end":64.9,"text":"可愛いトコあるかもね","translation":"귀여운 구석이 있을지도","kind":"lyric"},{"id":"22","start":64.9,"end":67.82,"text":"それはそれでやっぱお友達","translation":"그래도 역시 친구 사이","kind":"lyric"},{"id":"23","start":67.82,"end":69.802,"text":"（キャッチャー・イン・ザ・うい Na-Na-Na）","translation":"캐처 인 더 우이 나나나","kind":"lyric"},{"id":"24","start":69.802,"end":70.832,"text":"英才教育","translation":"영재 교육","kind":"lyric"},{"id":"25","start":70.832,"end":72.34,"text":"（キャッチャー・イン・ザ・うい Na-Na-Na）","translation":"캐처 인 더 우이 나나나","kind":"lyric"},{"id":"26","start":72.34,"end":74.06,"text":"ちょっと過激に","translation":"조금 과격하게","kind":"lyric"},{"id":"27","start":74.06,"end":77.62,"text":"刺激的な関係性 求む Crazy","translation":"자극적인 관계를 원해 크레이지","kind":"lyric"},{"id":"28","start":77.62,"end":79.64,"text":"つかずはなれず","translation":"붙지도 떨어지지도 않고","kind":"lyric"},{"id":"29","start":79.64,"end":82.42,"text":"愛を込めて I hate you","translation":"사랑을 담아 너희가 싫어","kind":"lyric"},{"id":"30","start":88.18,"end":91.96,"text":"うい、夢に見るよ 新婚旅行","translation":"우이 꿈에서 봐 신혼여행","kind":"lyric"},{"id":"31","start":91.96,"end":96.48,"text":"そっか それなら 空き缶はお前らだね","translation":"그렇구나 그럼 빈 깡통은 너희들이네","kind":"lyric"},{"id":"32","start":96.48,"end":99.42,"text":"しっかりくくるね","translation":"단단히 묶어 둘게","kind":"lyric"},{"id":"33","start":100.42,"end":103.02,"text":"(Non-Non) お前と結婚してませーん","translation":"논논 너랑 결혼 안 했어요","kind":"lyric"},{"id":"34","start":103.74,"end":106.02,"text":"(Non-Non) 皆さんのママじゃありませーん","translation":"논논 여러분 엄마가 아니에요","kind":"lyric"},{"id":"35","start":106.02,"end":108.06,"text":"(Non-Non) 言いすぎた？ごめんね？","translation":"논논 너무 말했나 미안해","kind":"lyric"},{"id":"36","start":108.06,"end":110.86,"text":"もしかして効い