{"title":"타상연화","artist":"DAOKO × 米津玄師","date":"2026-09-04","sourceId":"15033796:013","sourceHash":"64365b7bb6ff5f6ec526e2095da91e896a65fd7108a6080ff4133f940a3246c9","duration":103.2,"cues":[{"id":"1","start":31.602,"end":33.068,"text":"何度でも","translation":"몇 번이라도","kind":"lyric"},{"id":"2","start":33.088,"end":36.328,"text":"言葉にして君を呼ぶよ","translation":"말로 전하며 너를 부를게","kind":"lyric"},{"id":"3","start":36.478549,"end":38.759,"text":"波間を選び もう一度","translation":"파도 사이를 골라 다시 한번","kind":"lyric"},{"id":"4","start":38.812,"end":44.812,"text":"もう二度と悲しまずに済むように","translation":"두 번 다시 슬퍼하지 않아도 되도록","kind":"lyric"},{"id":"5","start":58.049887,"end":60.7,"text":"ハッと息を呑めば","translation":"문득 숨을 삼키면","kind":"lyric"},{"id":"6","start":60.743,"end":63.01,"text":"消えちゃいそうな光が","translation":"사라질 듯한 빛이","kind":"lyric"},{"id":"7","start":63.030567,"end":66.581,"text":"きっとまだ胸に住んでいた","translation":"분명 아직 가슴속에 살아 있었어","kind":"lyric"},{"id":"8","start":66.641,"end":70.451,"text":"手を伸ばせば触れた","translation":"손을 뻗으면 닿았던","kind":"lyric"},{"id":"9","start":70.542,"end":73.796,"text":"あったかい未来は","translation":"따스한 미래는","kind":"lyric"},{"id":"10","start":73.816,"end":79.717,"text":"ひそかに二人を見ていた","translation":"남몰래 우리 둘을 바라봤어","kind":"lyric"},{"id":"11","start":79.737,"end":81.607,"text":"パッと花火が","translation":"팟 하고 불꽃이","kind":"lyric"},{"id":"12","start":81.78068,"end":84.419,"text":"夜に咲いた","translation":"밤에 피었어","kind":"lyric"},{"id":"13","start":84.439,"end":86.879,"text":"夜に咲いて","translation":"밤에 피어나","kind":"lyric"},{"id":"14","start":86.9239,"end":89.261,"text":"静かに消えた","translation":"조용히 사라졌어","kind":"lyric"},{"id":"15","start":89.280726,"end":94.253,"text":"離れないで","translation":"떠나지 말아 줘","kind":"lyric"},{"id":"16","start":94.273,"end":94.933,"text":"もう少しだけ","translation":"조금만 더","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}