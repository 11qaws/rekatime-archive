{"title":"Victim","artist":"Mili","sourceId":"reference:24D9PDz2zWFn0r9wz0BK","sourceHash":"d6fa549881ff6b03c07154b33e19285aa034ddc71c4733cc03395697aa6ce4d8","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":34069820,"cues":[{"id":"1","start":12.81,"end":18.57,"text":"Isn't it funny","translation":"","kind":"lyric"},{"id":"2","start":18.57,"end":25.12,"text":"We worship a moon that stole its light from the sun","translation":"","kind":"lyric"},{"id":"3","start":25.12,"end":28.09,"text":"Hear that?","translation":"","kind":"lyric"},{"id":"4","start":28.09,"end":31.23,"text":"Believers, they speak","translation":"","kind":"lyric"},{"id":"5","start":31.23,"end":34.02,"text":"Oink Oink","translation":"","kind":"lyric"},{"id":"6","start":34.02,"end":39.67,"text":"Like how I was so naive","translation":"","kind":"lyric"},{"id":"7","start":39.67,"end":45.99,"text":"When will it be my turn, my turn","translation":"","kind":"lyric"},{"id":"8","start":45.99,"end":52.2,"text":"I'm not just some tragic victim","translation":"","kind":"lyric"},{"id":"9","start":52.2,"end":58.31,"text":"But when will I learn, will I learn","translation":"","kind":"lyric"},{"id":"10","start":58.31,"end":69.55,"text":"How many bridges do I have to burn","translation":"","kind":"lyric"},{"id":"11","start":91.82,"end":97.62,"text":"Isn't it pretty","translation":"","kind":"lyric"},{"id":"12","start":97.62,"end":104.3,"text":"All my life, all my poetry leaving me","translation":"","kind":"lyric"},{"id":"13","start":104.3,"end":110.39,"text":"And the angel sing surrounding me put me to sleep","translation":"","kind":"lyric"},{"id":"14","start":110.39,"end":113.56,"text":"Then it dawned on me that all I wanted was","translation":"","kind":"lyric"},{"id":"15","start":113.56,"end":124.56,"text":"An approval that you're never willing to give","translation":"","kind":"lyric"},{"id":"16","start":124.56,"end":132.64,"text":"Hate to admit I've done it all for you","translation":"","kind":"lyric"},{"id":"17","start":132.64,"end":138.62,"text":"I am a wolf, I'm a crow, I'm a bat a butterfly in disguise","translation":"","kind":"lyric"},{"id":"18","start":138.62,"end":148.97,"text":"I'm in the air, in the sea, in the moment I'm in you, in me","translation":"","kind":"lyric"},{"id":"19","start":148.97,"end":155.41,"text":"When will it be my turn, my turn","translation":"","kind":"lyric"},{"id":"20","start":155.41,"end":161.52,"text":"I'm not just some tragic victim","translation":"","kind":"lyric"},{"id":"21","start":161.52,"end":167.54,"text":"But when will I learn, will I learn","translation":"","kind":"lyric"},{"id":"22","start":167.54,"end":175.04,"text":"It's just me in this world I'm alone I'm complete","translation":"","kind":"lyric"},{"id":"23","start":175.04,"end":181.51,"text":"Still waiting for my turn, my turn","translation":"","kind":"lyric"},{"id":"24","start":181.51,"end":187.85,"text":"Even though I'm outnumbered","translation":"","kind":"lyric"},{"id":"25","start":187.85,"end":194.08,"text":"Now, you have me torn, you have me torn","translation":"","kind":"lyric"},{"id":"26","start":194.08,"end":211.93,"text":"Can't remember who I was before","translation":"","kind":"lyric"}],"candidates":[]}