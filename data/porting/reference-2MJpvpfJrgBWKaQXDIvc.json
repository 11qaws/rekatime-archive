{"title":"Let it Go","artist":"Frozen","sourceId":"reference:2MJpvpfJrgBWKaQXDIvc","sourceHash":"db285d51ce02df45c791f75638fc4af490c43517f762142e954ed0d7df15848d","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":37329807,"cues":[{"id":"1","start":8.09,"end":21.03,"text":"The snow glows white on the mountain tonight","translation":"","kind":"lyric"},{"id":"2","start":21.03,"end":22.07,"text":"Not a footprint to be seen","translation":"","kind":"lyric"},{"id":"3","start":22.07,"end":25.06,"text":"A kingdom of isolation,","translation":"","kind":"lyric"},{"id":"4","start":25.06,"end":28.05,"text":"And it looks like I'm the queen.","translation":"","kind":"lyric"},{"id":"5","start":28.05,"end":35.03,"text":"The wind is howling like this swirling storm inside","translation":"","kind":"lyric"},{"id":"6","start":35.03,"end":42.05,"text":"Couldn't keep it in, heaven knows I tried","translation":"","kind":"lyric"},{"id":"7","start":42.05,"end":46.04,"text":"Don't let them in, don't let them see","translation":"","kind":"lyric"},{"id":"8","start":46.04,"end":49.0,"text":"Be the good girl you always have to be","translation":"","kind":"lyric"},{"id":"9","start":49.0,"end":55.06,"text":"Conceal, don't feel, don't let them know","translation":"","kind":"lyric"},{"id":"10","start":55.06,"end":59.07,"text":"Well, now they know","translation":"","kind":"lyric"},{"id":"11","start":59.07,"end":62.01,"text":"Let it go, let it go","translation":"","kind":"lyric"},{"id":"12","start":62.01,"end":66.08,"text":"Can't hold it back anymore","translation":"","kind":"lyric"},{"id":"13","start":66.08,"end":69.05,"text":"Let it go, let it go","translation":"","kind":"lyric"},{"id":"14","start":69.05,"end":74.01,"text":"Turn away and slam the door","translation":"","kind":"lyric"},{"id":"15","start":74.01,"end":76.03,"text":"I don't care","translation":"","kind":"lyric"},{"id":"16","start":76.03,"end":80.01,"text":"What they're going to say","translation":"","kind":"lyric"},{"id":"17","start":80.01,"end":84.07,"text":"Let the storm rage on,","translation":"","kind":"lyric"},{"id":"18","start":84.07,"end":88.51,"text":"The cold never bothered me anyway","translation":"","kind":"lyric"},{"id":"19","start":92.09,"end":94.09,"text":"It's funny how some distance","translation":"","kind":"lyric"},{"id":"20","start":94.09,"end":98.09,"text":"Makes everything seem small","translation":"","kind":"lyric"},{"id":"21","start":98.09,"end":101.02000000000001,"text":"And the fears that once controlled me","translation":"","kind":"lyric"},{"id":"22","start":101.02000000000001,"end":105.03,"text":"Can't get to me at all","translation":"","kind":"lyric"},{"id":"23","start":105.03,"end":109.08,"text":"It's time to see what I can do","translation":"","kind":"lyric"},{"id":"24","start":109.08,"end":113.05,"text":"To test the limits and break through","translation":"","kind":"lyric"},{"id":"25","start":113.05,"end":117.03999999999999,"text":"No right, no wrong, no rules for me","translation":"","kind":"lyric"},{"id":"26","start":117.03999999999999,"end":120.0,"text":"I'm free","translation":"","kind":"lyric"},{"id":"27","start":120.0,"end":124.09,"text":"Let it go, let it go","translation":"","kind":"lyric"},{"id":"28","start":124.09,"end":127.02,"text":"I am one with the wind and sky","translation":"","kind":"lyric"},{"id":"29","start":127.02,"end":131.08,"text":"Let it go, let it go","translation":"","kind":"lyric"},{"id":"30","start":131.08,"end":135.05,"text":"You'll never see me cry","translation":"","kind":"lyric"},{"id":"31","start":135.05,"end":138.02,"text":"Here I stand","translation":"","kind":"lyric"},{"id":"32","start":138.02,"end":143.01,"text":"And here I'll stay","translation":"","kind":"lyric"},{"id":"33","start":143.01,"end":148.01,"text":"Let the storm rage on","translation":"","kind":"lyric"},{"id":"34","start":153.02,"end":160.09,"text":"My power flurries through the air into the ground","translation":"","kind":"lyric"},{"id":"35","start":160.09,"end":167.07,"text":"My soul is spiraling in frozen fractals all around","translation":"","kind":"lyric"},{"id":"36","start":167.07,"end":173.05,"text":"And one thought crystallizes like an icy blast","translation":"","kind":"lyric"},{"id":"37","start":173.05,"end":177.04,"text":"I'm never going back,","translation":"","kind":"lyric"},{"id":"38","start":177.04,"end":182.01,"text":"The past is in the past","translation":"","kind":"lyric"},{"id":"39","start":182.01,"end":185.05,"text":"Let it go, let it go","translation":"","kind":"lyric"},{"id":"40","start":185.05,"end":189.0,"text":"And I'll rise like the break of dawn","translation":"","kind":"lyric"},{"id":"41","start":189.0,"end":192.08,"text":"Let it go, let it go","translation":"","kind":"lyric"},{"id":"42","start":192.08,"end":196.06,"text":"That perfect girl is gone","translation":"","kind":"lyric"},{"id":"43","start":196.06,"end":199.07999999999998,"text":"Here I stand","translation":"","kind":"lyric"},{"id":"44","start":199.07999999999998,"end":205.04,"text":"In the light of day","translation":"","kind":"lyric"},{"id":"45","start":205.04,"end":210.07999999999998,"text":"Let the storm rage on,","translation":"","kind":"lyric"},{"id":"46","start":210.07999999999998,"end":212.62,"text":"The cold never bothered me anyway","translation":"","kind":"lyric"}],"candidates":[]}