{"title":"BAD APPLE!!!","artist":"Masayoshi Minoshima","date":"2026-09-07","sourceId":"15084319:006","sourceHash":"d80a8ddd6cc3c4bf4af69e187acd3be8fc82f3ac98a4adc2a999c2cbc9bbc685","duration":263.9,"cues":[{"id":"1","start":74.152925,"end":80.12367300000001,"text":"流れてく時の中ででも 気だるさが ほらグルグル廻って","translation":"흐르는 시간 속에서도 나른함이 봐 빙글빙글 맴돌아","kind":"lyric"},{"id":"2","start":80.143673,"end":84.283673,"text":"私から 離れる心も","translation":"나에게서 멀어지는 마음도","kind":"lyric"},{"id":"3","start":84.369705,"end":86.289705,"text":"見えないわ そう知らない","translation":"보이지 않아 그래 모르겠어","kind":"lyric"},{"id":"4","start":86.331791,"end":90.051791,"text":"自分から 動くこともなく","translation":"스스로 움직이지도 못한 채","kind":"lyric"},{"id":"5","start":90.209524,"end":93.62952399999999,"text":"時の隙間に 流され続けて","translation":"시간의 틈새에 계속 떠밀려","kind":"lyric"},{"id":"6","start":93.704127,"end":97.12412699999999,"text":"知らないわ 周りのことなど","translation":"주변 일 따윈 모르겠어","kind":"lyric"},{"id":"7","start":97.18712,"end":98.479048,"text":"私は私 それだけ","translation":"나는 나 그뿐이야","kind":"lyric"},{"id":"8","start":98.499048,"end":103.29904799999998,"text":"夢 見てる なにも見てない","translation":"꿈을 꾸고 있어 아무것도 보지 않아","kind":"lyric"},{"id":"9","start":103.491338,"end":106.931111,"text":"語るも無駄な 自分の言葉","translation":"말해 봐야 헛된 내 말","kind":"lyric"},{"id":"10","start":106.951111,"end":110.39111100000001,"text":"悲しむなんて 疲れるだけよ","translation":"슬퍼해 봐야 지칠 뿐이야","kind":"lyric"},{"id":"11","start":110.538594,"end":113.89859399999999,"text":"何も感じず 過ごせばいいの","translation":"아무 감정 없이 지내면 돼","kind":"lyric"},{"id":"12","start":113.975147,"end":117.37514700000003,"text":"戸惑う言葉 与えられても","translation":"당황스러운 말을 들어도","kind":"lyric"},{"id":"13","start":117.434921,"end":120.654104,"text":"自分の心 ただ上の空","translation":"내 마음은 그저 위의 하늘","kind":"lyric"},{"id":"14","start":120.674104,"end":124.254104,"text":"もし 私から 動くのならば","translation":"만약 내가 움직인다면","kind":"lyric"},{"id":"15","start":124.412517,"end":126.636517,"text":"すべて変えるのなら 黒にする","translation":"모든 걸 바꾼다면 검게 할래","kind":"lyric"},{"id":"16","start":126.839002,"end":129.036508,"text":"こんな自分に 未来はあるの？","translation":"이런 나에게 미래는 있을까","kind":"lyric"},{"id":"17","start":129.056508,"end":131.27350800000002,"text":"こんな世界に 私はいるの？","translation":"이런 세상에 나는 있을까","kind":"lyric"},{"id":"18","start":131.343673,"end":134.72967300000002,"text":"今切ないの？ 今 悲しいの","translation":"지금 애달프니 지금 슬프니","kind":"lyric"},{"id":"19","start":134.803447,"end":138.26944699999999,"text":"自分の事も わからないまま","translation":"나 자신도 모른 채","kind":"lyric"},{"id":"20","start":138.49542,"end":141.946803,"text":"歩むことさえ 疲れるだけよ","translation":"걷는 것조차 지칠 뿐이야","kind":"lyric"},{"id":"21","start":141.966803,"end":145.232426,"text":"人のことなど 知りもしないわ","translation":"남들 일 따윈 알 바 아니야","kind":"lyric"},{"id":"22","start":145.252426,"end":148.57842599999998,"text":"こんな私も 変われるのなら","translation":"이런 나도 변할 수 있다면","kind":"lyric"},{"id":"23","start":148.70059,"end":154.70059,"text":"もし変われるのなら 白になる","translation":"변할 수 있다면 하얘질래","kind":"lyric"},{"id":"24","start":173.720091,"end":177.62426299999998,"text":"流れてく 時の中ででも 気だるさがほら","translation":"흐르는 시간 속에서도 나른함이 봐","kind":"lyric"},{"id":"25","start":177.644263,"end":181.680263,"text":"グルグル廻って 私から 離れる心も","translation":"빙글빙글 맴돌아 나에게서 멀어지는 마음도","kind":"lyric"},{"id":"26","start":181.777415,"end":183.916871,"text":"見えないわ そう 知らない","translation":"보이지 않아 그래 모르겠어","kind":"lyric"},{"id":"27","start":183.936871,"end":187.396871,"text":"自分から 動くこともなく","translation":"스스로 움직이지도 못한 채","kind":"lyric"},{"id":"28","start":187.617234,"end":190.99723400000002,"text":"時の隙間に 流され続けて","translation":"시간의 틈새에 계속 떠밀려","kind":"lyric"},{"id":"29","start":191.100227,"end":194.540227,"text":"知らないわ 周りのことなど","translation":"주변 일 따윈 모르겠어","kind":"lyric"},{"id":"30","start":194.58322,"end":199.59034,"text":"私は私 それだけ","translation":"나는 나 그뿐이야","kind":"lyric"},{"id":"31","start":199.61034,"end":200.75034,"text":"夢 見てる なにも見てない","translation":"꿈을 꾸고 있어 아무것도 보지 않아","kind":"lyric"},{"id":"32","start":200.887438,"end":204.338821,"text":"語るも無駄な 自分の言葉","translation":"말해 봐야 헛된 내 말","kind":"lyric"},{"id":"33","start":204.358821,"end":207.75882099999998,"text":"悲しむなんて 疲れるだけよ","translation":"슬퍼해 봐야 지칠 뿐이야","kind":"lyric"},{"id":"34","start":207.888254,"end":211.30825399999998,"text":"何も感じず 過ごせばいいの","translation":"아무 감정 없이 지내면 돼","kind":"lyric"},{"id":"35","start":211.394467,"end":214.78779999999998,"text":"戸惑う言葉 与えられても","translation":"당황스러운 말을 들어도","kind":"lyric"},{"id":"36","start":214.8078,"end":218.12779999999998,"text":"自分の心 ただ上の空","translation":"내 마음은 그저 위의 하늘","kind":"lyric"},{"id":"37","start":218.302404,"end":220.441859,"text":"もし私から 動くのならば","translation":"만약 내가 움직인다면","kind":"lyric"},{"id":"38","start":220.461859,"end":223.007859,"text":"すべて変えるのなら 黒にする","translation":"모든 걸 바꾼다면 검게 할래","kind":"lyric"},{"id":"39","start":223.097324,"end":225.37332400000003,"text":"無駄な時間に 未来はあるの？","translation":"헛된 시간에 미래는 있을까","kind":"lyric"},{"id":"40","start":225.45415,"end":227.72915,"text":"こんな所に 私は居るの？","translation":"이런 곳에 나는 있을까","kind":"lyric"},{"id":"41","start":227.869025,"end":231.94734699999998,"text":"私のことを 言いたいならば","translation":"내 얘길 하고 싶다면","kind":"lyric"},{"id":"42","start":231.967347,"end":235.165347,"text":"言葉にするのなら 「ろくでなし」","translation":"말로 한다면 쓸모없는 놈","kind":"lyric"},{"id":"43","start":235.31102,"end":238.29802000000004,"text":"こんな所に 私はいるの？","translation":"이런 곳에 나는 있을까","kind":"lyric"},{"id":"44","start":238.376054,"end":241.389054,"text":"こんな時間に 私はいるの？","translation":"이런 시간에 나는 있을까","kind":"lyric"},{"id":"45","start":241.568798,"end":244.346803,"text":"こんな私も 変われるのなら","translation":"이런 나도 변할 수 있다면","kind":"lyric"},{"id":"46","start":244.366803,"end":247.51280300000005,"text":"もし変われるのなら 白になる","translation":"변할 수 있다면 하얘질래","kind":"lyric"},{"id":"47","start":247.698866,"end":250.65102,"text":"今 夢見てる なにも見てない","translation":"지금 꿈을 꾸고 있어 아무것도 보지 않아","kind":"lyric"},{"id":"48","start":250.67102,"end":253.63202,"text":"語るも無駄な 自分の言葉","translation":"말해 봐야 헛된 내 말","kind":"lyric"},{"id":"49","start":253.736054,"end":256.6610540000000