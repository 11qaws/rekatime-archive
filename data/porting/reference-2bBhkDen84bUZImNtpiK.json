{"title":"Into the Unknown","artist":"Frozen","sourceId":"reference:2bBhkDen84bUZImNtpiK","sourceHash":"8af2a66cfac1477ace6f011897590a44d8fd3b8a0c49e0d41b07b27262f204bc","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":0.96,"end":3.96,"text":"Ah-ah, oh-oh-oh","translation":"","kind":"lyric"},{"id":"2","start":4.6,"end":7.6,"text":"Ah-ah, oh-oh-oh-oh-oh-oh","translation":"","kind":"lyric"},{"id":"3","start":7.89,"end":10.89,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"4","start":11.75,"end":14.75,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"5","start":15.78,"end":18.78,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"6","start":21.39,"end":24.39,"text":"Ah-ah, ah-ah-ah","translation":"","kind":"lyric"},{"id":"7","start":24.45,"end":27.45,"text":"I can hear you but I won't","translation":"","kind":"lyric"},{"id":"8","start":28.14,"end":30.34,"text":"Some look for trouble","translation":"","kind":"lyric"},{"id":"9","start":30.34,"end":32.74,"text":"While others don't","translation":"","kind":"lyric"},{"id":"10","start":32.74,"end":34.84,"text":"There's a thousand reasons","translation":"","kind":"lyric"},{"id":"11","start":34.84,"end":36.98,"text":"I should go about my day","translation":"","kind":"lyric"},{"id":"12","start":36.98,"end":39.04,"text":"And ignore your whispers","translation":"","kind":"lyric"},{"id":"13","start":39.04,"end":42.04,"text":"Which I wish would go away, oh-oh-oh","translation":"","kind":"lyric"},{"id":"14","start":43.31,"end":46.31,"text":"Ooh-oh-oh","translation":"","kind":"lyric"},{"id":"15","start":48.77,"end":50.92,"text":"You're not a voice","translation":"","kind":"lyric"},{"id":"16","start":50.92,"end":53.12,"text":"You're just a ringing in my ear","translation":"","kind":"lyric"},{"id":"17","start":53.12,"end":55.44,"text":"And if I heard you, which I don't","translation":"","kind":"lyric"},{"id":"18","start":55.44,"end":57.56,"text":"I'm spoken for I fear","translation":"","kind":"lyric"},{"id":"19","start":57.56,"end":60.56,"text":"Everyone I've ever loved is here within these walls","translation":"","kind":"lyric"},{"id":"20","start":61.57,"end":64.57,"text":"I'm sorry, secret siren, but I'm blocking out your calls","translation":"","kind":"lyric"},{"id":"21","start":65.89,"end":68.89,"text":"I've had my adventure, I don't need something new","translation":"","kind":"lyric"},{"id":"22","start":69.68,"end":72.68,"text":"I'm afraid of what I'm risking if I follow you","translation":"","kind":"lyric"},{"id":"23","start":73.12,"end":76.12,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"24","start":77.22,"end":80.22,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"25","start":81.38,"end":84.38,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"26","start":86.98,"end":89.98,"text":"Ah-ah, ah-ah-ah","translation":"","kind":"lyric"},{"id":"27","start":90.8,"end":93.8,"text":"Ah-ah, ah-ah-ah-oh-oh","translation":"","kind":"lyric"},{"id":"28","start":94.1,"end":97.1,"text":"What do you want? 'Cause you've been keeping me awake","translation":"","kind":"lyric"},{"id":"29","start":98.36,"end":101.36,"text":"Are you here to distract me so I make a big mistake?","translation":"","kind":"lyric"},{"id":"30","start":102.43,"end":105.43,"text":"Or are you someone out there who's a little bit like me?","translation":"","kind":"lyric"},{"id":"31","start":106.46000000000001,"end":109.46000000000001,"text":"Who knows deep down I'm not where I'm meant to be?","translation":"","kind":"lyric"},{"id":"32","start":110.62,"end":113.62,"text":"Every day's a little harder as I feel your power grow","translation":"","kind":"lyric"},{"id":"33","start":114.85,"end":117.85,"text":"Don't you know there's part of me that longs to go","translation":"","kind":"lyric"},{"id":"34","start":120.55,"end":123.55,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"35","start":124.58,"end":127.58,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"36","start":128.67,"end":131.67,"text":"Into the unknown","translation":"","kind":"lyric"},{"id":"37","start":132.36,"end":134.17,"text":"Ah-ah, ah-ah-ah","translation":"","kind":"lyric"},{"id":"38","start":134.17,"end":135.96,"text":"Ah-ah, ah-ah-ah","translation":"","kind":"lyric"},{"id":"39","start":135.96,"end":137.43,"text":"Oh-oh-oh","translation":"","kind":"lyric"},{"id":"40","start":137.43,"end":138.51,"text":"Are you out there?","translation":"","kind":"lyric"},{"id":"41","start":138.51,"end":139.55,"text":"Do you know me?","translation":"","kind":"lyric"},{"id":"42","start":139.55,"end":140.54,"text":"Can you feel me?","translation":"","kind":"lyric"},{"id":"43","start":140.54,"end":143.54,"text":"Can you show me?","translation":"","kind":"lyric"},{"id":"44","start":143.57999999999998,"end":146.57999999999998,"text":"Ah-ah-ah-ah (oh-oh-oh-oh)","translation":"","kind":"lyric"},{"id":"45","start":147.25,"end":150.25,"text":"Ah-ah-ah-ah (oh-oh-oh-oh)","translation":"","kind":"lyric"},{"id":"46","start":150.29,"end":152.22,"text":"Ah-ah-ah-ah","translation":"","kind":"lyric"},{"id":"47","start":152.22,"end":154.38,"text":"Ah-ah-ah-ah","translation":"","kind":"lyric"},{"id":"48","start":154.38,"end":156.32999999999998,"text":"Ah-ah-ah-ah","translation":"","kind":"lyric"},{"id":"49","start":156.32999999999998,"end":159.32999999999998,"text":"Ah-ah-ah-ah","translation":"","kind":"lyric"},{"id":"50","start":160.39,"end":162.55,"text":"Where are you going?","translation":"","kind":"lyric"},{"id":"51","start":162.55,"end":164.53,"text":"Don't leave me alone","translation":"","kind":"lyric"},{"id":"52","start":164.53,"end":167.53,"text":"How do I follow you","translation":"","kind":"lyric"},{"id":"53","start":169.67000000000002,"end":172.67000000000002,"text":"Into the unknown?","translation":"","kind":"lyric"},{"id":"54","start":181.27,"end":184.27,"text":"Whoo!","translation":"","kind":"lyric"}],"candidates":[]}