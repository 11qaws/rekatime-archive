{"title":"윤회전생","artist":"마후마후","sourceId":"reference:9eUDbdo0m9PGkwrpg8SA","sourceHash":"0b95675064efb7231d7850a67b62c2edc7e167c42bcec7a0c279a98abe927ad2","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":21.35,"end":23.57,"text":"もしもボクが神様だったら","translation":"","kind":"lyric"},{"id":"2","start":23.57,"end":26.3,"text":"人生とかいう名の分が悪い博打","translation":"","kind":"lyric"},{"id":"3","start":26.3,"end":28.2,"text":"疾うに とっくに廃止して","translation":"","kind":"lyric"},{"id":"4","start":28.2,"end":31.2,"text":"燃えるゴミの日にまとめてぽいっだ","translation":"","kind":"lyric"},{"id":"5","start":31.31,"end":33.4,"text":"同じ阿呆でも踊らにゃ損損","translation":"","kind":"lyric"},{"id":"6","start":33.4,"end":36.1,"text":"顔窺っているばっかで徒然 呼応して","translation":"","kind":"lyric"},{"id":"7","start":36.1,"end":38.51,"text":"怨嗟 連鎖 で道も狭に","translation":"","kind":"lyric"},{"id":"8","start":38.51,"end":40.9,"text":"誰にもなれない 誰でもないまま","translation":"","kind":"lyric"},{"id":"9","start":40.9,"end":43.9,"text":"きっと一生シット 嫉妬して また隣の芝","translation":"","kind":"lyric"},{"id":"10","start":45.34,"end":48.34,"text":"在り来りも良く言えば大衆性","translation":"","kind":"lyric"},{"id":"11","start":48.43,"end":50.61,"text":"右倣って小猫が鳴いた","translation":"","kind":"lyric"},{"id":"12","start":50.61,"end":53.61,"text":"「翼が無けりゃ 空を降らしてくれりゃいい」","translation":"","kind":"lyric"},{"id":"13","start":55.58,"end":57.81,"text":"世界中 誰も神頼みで","translation":"","kind":"lyric"},{"id":"14","start":57.81,"end":60.18,"text":"未来も何も見いだせない","translation":"","kind":"lyric"},{"id":"15","start":60.18,"end":62.76,"text":"荒縄で吊れるような","translation":"","kind":"lyric"},{"id":"16","start":62.76,"end":65.15,"text":"命に答えはない","translation":"","kind":"lyric"},{"id":"17","start":65.15,"end":67.53,"text":"この世に手早くお別れして","translation":"","kind":"lyric"},{"id":"18","start":67.53,"end":70.03,"text":"電波に乗って夢の夢","translation":"","kind":"lyric"},{"id":"19","start":70.03,"end":73.03,"text":"ボクはボクは生まれ変わる","translation":"","kind":"lyric"},{"id":"20","start":76.45,"end":79.45,"text":"輪廻転生","translation":"","kind":"lyric"},{"id":"21","start":96.7,"end":99.7,"text":"あの世ってやつは居心地いいようだ","translation":"","kind":"lyric"},{"id":"22","start":101.53999999999999,"end":104.53999999999999,"text":"誰もここには帰らないもんな","translation":"","kind":"lyric"},{"id":"23","start":106.5,"end":109.5,"text":"彼の言葉を借りるならこうだ","translation":"","kind":"lyric"},{"id":"24","start":111.34,"end":114.34,"text":"どんな笑顔でボクを手招いているんだい","translation":"","kind":"lyric"},{"id":"25","start":117.28999999999999,"end":119.31,"text":"過食症 不登校 自傷癖","translation":"","kind":"lyric"},{"id":"26","start":119.31,"end":121.32,"text":"子供の頃の夢","translation":"","kind":"lyric"},{"id":"27","start":121.32,"end":124.27,"text":"売女 ヒス パラノイアはII-V","translation":"","kind":"lyric"},{"id":"28","start":124.27,"end":127.27,"text":"処刑台 殺人の正当性","translation":"","kind":"lyric"},{"id":"29","start":127.28,"end":130.28,"text":"もう何もかも耳を塞いでしまいたいな","translation":"","kind":"lyric"},{"id":"30","start":131.14,"end":132.91,"text":"教えておくれ","translation":"","kind":"lyric"},{"id":"31","start":132.91,"end":135.89,"text":"今日日の世の神様の作りかたを","translation":"","kind":"lyric"},{"id":"32","start":135.89,"end":137.48,"text":"教えておくれ","translation":"","kind":"lyric"},{"id":"33","start":137.48,"end":140.48,"text":"人は人を裁いていいのだろう?","translation":"","kind":"lyric"},{"id":"34","start":140.92000000000002,"end":143.57999999999998,"text":"どれだけ泥が泥を捏ねたって","translation":"","kind":"lyric"},{"id":"35","start":143.57999999999998,"end":145.86,"text":"泥以外作れやしない","translation":"","kind":"lyric"},{"id":"36","start":145.86,"end":148.86,"text":"君も君も生まれ変われ","translation":"","kind":"lyric"},{"id":"37","start":152.26,"end":155.26,"text":"輪廻転生","translation":"","kind":"lyric"},{"id":"38","start":163.43,"end":165.74,"text":"排他 掃いた明後日の斎場","translation":"","kind":"lyric"},{"id":"39","start":165.74,"end":168.23,"text":"擦った揉んだで愛の欠乏症","translation":"","kind":"lyric"},{"id":"40","start":168.23,"end":170.49,"text":"この未来に答えも正解も","translation":"","kind":"lyric"},{"id":"41","start":170.49,"end":173.49,"text":"そんなもんは望んじゃいないってんだ","translation":"","kind":"lyric"},{"id":"42","start":183.15,"end":185.09,"text":"ああ もうやめた","translation":"","kind":"lyric"},{"id":"43","start":185.09,"end":188.09,"text":"全て失くしてしまえばいい","translation":"","kind":"lyric"},{"id":"44","start":188.09,"end":191.09,"text":"世界中 誰も神頼みで","translation":"","kind":"lyric"},{"id":"45","start":192.47,"end":194.84,"text":"未来も何も見いだせない","translation":"","kind":"lyric"},{"id":"46","start":194.84,"end":197.15,"text":"等しい幸せなど","translation":"","kind":"lyric"},{"id":"47","start":197.15,"end":199.82,"text":"ゆめゆめ願いやしない","translation":"","kind":"lyric"},{"id":"48","start":199.82,"end":202.45,"text":"この世に終わりをつけておいて","translation":"","kind":"lyric"},{"id":"49","start":202.45,"end":204.56,"text":"終えるななんて何様だ","translation":"","kind":"lyric"},{"id":"50","start":204.56,"end":207.56,"text":"全て全て生まれ変われ","translation":"","kind":"lyric"},{"id":"51","start":210.93,"end":213.93,"text":"輪廻転生","translation":"","kind":"lyric"}],"candidates":[]}