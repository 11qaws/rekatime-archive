{"title":"불꽃","artist":"Sound Horizon","date":"2026-07-20","sourceId":"UBCB2e0Aik4:028","sourceHash":"346914b7246333c8365e54308e866a396bf86f3fb7d0d749398c5251c1989055","duration":339.1,"cues":[{"id":"1","start":29.13,"end":31.73,"text":"幾許かの平和と呼ばれる光","translation":"몇 번의 평화라 불리는 빛","kind":"lyric"},{"id":"2","start":32.23,"end":32.93,"text":"其の影には","translation":"그 그림자에는","kind":"lyric"},{"id":"3","start":32.93,"end":35.53,"text":"常に悲惨な争いがあった","translation":"언제나 비참한 싸움이 있었어","kind":"lyric"},{"id":"4","start":36.75,"end":38.25,"text":"葬列に参列する者は 皆","translation":"장례 행렬에 선 이들은 모두","kind":"lyric"},{"id":"5","start":38.25,"end":40.29,"text":"一様に口数も少なく","translation":"하나같이 말수가 적고","kind":"lyric"},{"id":"6","start":40.29,"end":43.49,"text":"雨に濡れながらも歩み続けるより","translation":"비에 젖어도 계속 걸어가는 것 말고","kind":"lyric"},{"id":"7","start":43.71,"end":44.71,"text":"他にはないのだ","translation":"달리 할 수 없었어","kind":"lyric"},{"id":"8","start":45.97,"end":49.27,"text":"瞳(め)を閉じて暗闇(やみ)に","translation":"눈을 감고 어둠 속에","kind":"lyric"},{"id":"9","start":50.15,"end":53.67,"text":"吐息を重ねる","translation":"한숨을 포개","kind":"lyric"},{"id":"10","start":55.07,"end":59.71,"text":"そっと触れた温かな光は","translation":"살며시 닿은 따스한 빛은","kind":"lyric"},{"id":"11","start":59.71,"end":62.23,"text":"小さな鼓動","translation":"작은 고동","kind":"lyric"},{"id":"12","start":64.11,"end":68.53,"text":"否定接続詞(メ)で綴じた書物(かみ)が","translation":"부정 접속사로 엮은 책이","kind":"lyric"},{"id":"13","start":69.09,"end":72.05,"text":"歴史を操る","translation":"역사를 움직여","kind":"lyric"},{"id":"14","start":73.342,"end":78.01,"text":"そっと振れた灼かな光は","translation":"살며시 흔들린 작열하는 빛은","kind":"lyric"},{"id":"15","start":78.01,"end":79.87,"text":"誰かの『焔』","translation":"누군가의 불꽃","kind":"lyric"},{"id":"16","start":82.339,"end":85.955,"text":"気付けば道程(みちのり)は","translation":"깨닫고 보니 여정은","kind":"lyric"},{"id":"17","start":85.97,"end":90.59,"text":"常に苦難と共に0101(あ)った","translation":"언제나 고난과 함께였어","kind":"lyric"},{"id":"18","start":90.59,"end":93.43,"text":"耐えられぬ","translation":"견딜 수 없는","kind":"lyric"},{"id":"19","start":93.85,"end":95.65,"text":"痛みなど","translation":"아픔 따윈","kind":"lyric"},{"id":"20","start":96.05,"end":97.164,"text":"何一つ","translation":"하나도","kind":"lyric"},{"id":"21","start":97.164,"end":100.679,"text":"訪れないものさ","translation":"찾아오지 않는 거야","kind":"lyric"},{"id":"22","start":100.739,"end":105.302,"text":"歓びに咽ぶ白い朝","translation":"기쁨에 목메는 하얀 아침","kind":"lyric"},{"id":"23","start":105.362,"end":109.744,"text":"哀しみに嘆く黒い夜","translation":"슬픔에 탄식하는 검은 밤","kind":"lyric"},{"id":"24","start":109.804,"end":113.742,"text":"我等が歩んだ此の日々を","translation":"우리가 걸어온 이 나날을","kind":"lyric"},{"id":"25","start":113.92,"end":116.66,"text":"生まれる者に繋ごう","translation":"태어날 이에게 잇자","kind":"lyric"},{"id":"26","start":119.16,"end":123.627,"text":"瞳に映した蒼い空","translation":"눈에 비친 푸른 하늘","kind":"lyric"},{"id":"27","start":123.687,"end":127.966,"text":"涙を溶かした碧い海","translation":"눈물을 녹인 푸른 바다","kind":"lyric"},{"id":"28","start":128.026,"end":131.71,"text":"我等が愛した此の世界(ばしょ)を","translation":"우리가 사랑한 이 세계를","kind":"lyric"},{"id":"29","start":131.71,"end":135.45,"text":"愛しい者に遺そう","translation":"사랑하는 이에게 남기자","kind":"lyric"},{"id":"30","start":173.4,"end":177.9,"text":"嗚呼 朝と夜 は繰り返す","translation":"아아 아침과 밤은 되풀이돼","kind":"lyric"},{"id":"31","start":178.58,"end":182.46,"text":"煌めく砂が零れても","translation":"반짝이는 모래가 흘러내려도","kind":"lyric"},{"id":"32","start":183.69,"end":187.03,"text":"嗚呼 朝と夜 は繰り返す","translation":"아아 아침과 밤은 되풀이돼","kind":"lyric"},{"id":"33","start":187.49,"end":190.87,"text":"愛した花が枯れても","translation":"사랑했던 꽃이 시들어도","kind":"lyric"},{"id":"34","start":193.23,"end":196.39,"text":"嗚呼 朝と夜 は繰り返す","translation":"아아 아침과 밤은 되풀이돼","kind":"lyric"},{"id":"35","start":197.307,"end":201.711,"text":"契った指が離れても","translation":"맹세한 손가락이 떨어져도","kind":"lyric"},{"id":"36","start":201.771,"end":205.981,"text":"嗚呼 朝と夜 を繰り返し","translation":"아아 아침과 밤을 되풀이하며","kind":"lyric"},{"id":"37","start":207.11,"end":208.75,"text":"《生命》(ひと)は廻り続ける","translation":"생명은 계속 돌아가","kind":"lyric"},{"id":"38","start":210.777,"end":213.693,"text":"美しい『焔』を見た","translation":"아름다운 불꽃을 보았어","kind":"lyric"},{"id":"39","start":213.753,"end":219.46,"text":"死を抱く暗闇の地平に","translation":"죽음을 품은 어둠의 지평에","kind":"lyric"},{"id":"40","start":219.52,"end":223.199,"text":"憎しみ廻る世界に","translation":"증오가 도는 세계에","kind":"lyric"},{"id":"41","start":223.259,"end":229.259,"text":"幾つかの『愛の詩』を灯そう","translation":"몇 편의 사랑의 시를 밝혀 두자","kind":"lyric"},{"id":"42","start":229.9,"end":231.78,"text":"何れ程夜が永くとも","translation":"밤이 아무리 길어도","kind":"lyric"},{"id":"43","start":231.78,"end":233.4,"text":"何れ朝は訪れる","translation":"아침은 반드시 찾아와","kind":"lyric"},{"id":"44","start":234.06,"end":237.06,"text":"独りで寂しくないように","translation":"홀로 외롭지 않도록","kind":"lyric"},{"id":"45","start":238.313,"end":242.781,"text":"《双児の 人形(ラ プウペ)》を傍らに","translation":"쌍둥이 인형을 곁에 두고","kind":"lyric"},{"id":"46","start":242.841,"end":246.17,"text":"小さな棺の揺り籠で","translation":"작은 관의 요람에서","kind":"lyric"},{"id":"47","start":246.23,"end":251.858,"text":"目覚めぬ君を送ろう","translation":"깨어나지 않는 너를 보내자","kind":"lyric"},{"id":"48","start":251.918,"end":254.821,"text":"歓びに揺れたのは","translation":"기쁨에 흔들린 것은","kind":"lyric"},{"id":"49","start":254.881,"end":256.76,"text":"《紫色の花》(ヴィオレット)","translation":"보랏빛 꽃","kind":"lyric"},{"id":"50","start":256.82,"end":259.106,"text":"哀しみに濡れたのは","translation":"슬픔에 젖은 것은","kind":"lyric"},{"id":"51","start":259.166,"end":260.53,"text":"《水色の花》(オルタンシア)","translation":"물빛 꽃","kind":"lyric"},{"id":"52","start":260.59,"end":264.24,"text":"誰かが綴った此の詩を","translation":"누군가가 엮은 이 시를","kind":"lyric"},{"id":"53","start":264.24,"end":267.96,"text":"生まれぬ君に贈ろう","translation":"태어나지 못한 너에게 바치자","kind":"lyric"},{"id":"54","start":272.65,"end":273.21,"text":"歴史が書を創るのか","translation":"역사가 책을 만드는 걸까","kind":"lyric"},{"id":"55","start":273.21,"end":274.51,"text":"書が歴史を創るのか","translation":"책이 역사를 만드는 걸까","kind":"lyric"},{"id":"56","start":274.51,"end":276.77,"text":"永遠を生きられない以上","translation":"영원을 살 수 없는 이상","kind":"lyric"},{"id":"57","start":276.77,"end":277.75,"text":"全てを識る由もなく","translation":"모든 걸 알 길도 없어","kind":"lyric"},{"id":"58","start":279.29,"end":280.95,"text":"朝と夜の地平を廻る","translation":"아침과 밤의 지평을 도는","kind":"lyric"},{"id":"59","start":280.95,"end":282.01,"text":"『第五の旅路』","translation":"다섯 번째 여정","kind":"lyric"},{"id":"60","start":282.28,"end":284.0,"text":"離れた者が","translation":"떠나간 이들이","kind":"lyric"},{"id":"61","start":284.36,"end":284.68,"text":"再び繋がる日は","translation":"다시 이어지는 날은","kind":"lyric"},{"id":"62","start":284.68,"end":286.54,"text":"訪れるのだろうか？","translation":"찾아올까","kind":"lyric"},{"id":"63","start":306.597,"end":308.347,"text":"懐かしき調べ","translation":"그리운 선율","kind":"lyric"},{"id":"64","start":309.24,"end":310.96,"text":"其れは誰の唇か","translation":"그건 누구의 입술일까","kind":"lyric"},{"id":"65","start":311.44,"end":311.66,"text":"嗚呼","translation":"아아","kind":"lyric"},{"id":"66","start":311.82,"end":313.68,"text":"《物語》(ロマン)を詩うのは","translation":"이야기를 노래하는 건","kind":"lyric"},{"id":"67","start":332.66,"end":335.02,"text":"「其処にロマンは在るのかしら？」","translation":"그곳에 이야기는 있을까","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}