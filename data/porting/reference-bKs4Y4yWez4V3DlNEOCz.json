{"title":"아름답고 잔혹한 세계","artist":"마이크 스기야마, 이시즈카 레이","sourceId":"reference:bKs4Y4yWez4V3DlNEOCz","sourceHash":"53117eee36404f3baaca187128e3a98a70277697f77f42ff52569d2c6163ad1b","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":15.49,"end":18.490000000000002,"text":"その夢は こころの居場所","translation":"","kind":"lyric"},{"id":"2","start":20.31,"end":23.31,"text":"生命より 壊れやすきもの","translation":"","kind":"lyric"},{"id":"3","start":26.5,"end":29.5,"text":"何度でも 捨てては見つけ","translation":"","kind":"lyric"},{"id":"4","start":31.02,"end":34.019999999999996,"text":"安らかに さぁ眠れ","translation":"","kind":"lyric"},{"id":"5","start":37.89,"end":40.89,"text":"脈打つ衝動に 願いは犯され","translation":"","kind":"lyric"},{"id":"6","start":49.16,"end":52.16,"text":"忘れてしまうほど","translation":"","kind":"lyric"},{"id":"7","start":53.82,"end":56.82,"text":"また想い出すよ","translation":"","kind":"lyric"},{"id":"8","start":59.33,"end":62.33,"text":"この 美しき残酷な世界では","translation":"","kind":"lyric"},{"id":"9","start":65.25,"end":67.9,"text":"まだ生きていること","translation":"","kind":"lyric"},{"id":"10","start":67.9,"end":70.61,"text":"「何故」と問うばかりで","translation":"","kind":"lyric"},{"id":"11","start":70.61,"end":73.61,"text":"嗚呼ボクたちは この強さ 弱さで","translation":"","kind":"lyric"},{"id":"12","start":76.34,"end":79.34,"text":"何を護るのだろう もう理性など","translation":"","kind":"lyric"},{"id":"13","start":81.9,"end":84.9,"text":"無いならば","translation":"","kind":"lyric"},{"id":"14","start":108.53999999999999,"end":111.53999999999999,"text":"あの空は 切ないのだろう","translation":"","kind":"lyric"},{"id":"15","start":113.42,"end":116.42,"text":"舞い上がる 灰と蜃気楼","translation":"","kind":"lyric"},{"id":"16","start":119.87,"end":122.87,"text":"温かい 言葉に凍え","translation":"","kind":"lyric"},{"id":"17","start":124.31,"end":127.31,"text":"人知れず さぁ眠れ","translation":"","kind":"lyric"},{"id":"18","start":131.13,"end":134.13,"text":"ねばつく幻想に 嘆きは隠され","translation":"","kind":"lyric"},{"id":"19","start":142.42000000000002,"end":145.42000000000002,"text":"千切ってしまうほど","translation":"","kind":"lyric"},{"id":"20","start":147.03,"end":150.03,"text":"また絡みつくよ","translation":"","kind":"lyric"},{"id":"21","start":152.41,"end":155.41,"text":"この 美しき残酷な世界では","translation":"","kind":"lyric"},{"id":"22","start":158.54,"end":161.18,"text":"ただ死んでゆくこと","translation":"","kind":"lyric"},{"id":"23","start":161.18,"end":163.7,"text":"「待て」と乞うばかりで","translation":"","kind":"lyric"},{"id":"24","start":163.7,"end":166.7,"text":"嗚呼ボクたちは 風見鶏 飛べずに","translation":"","kind":"lyric"},{"id":"25","start":169.48,"end":172.48,"text":"真実は嘘より 綺麗かどうか","translation":"","kind":"lyric"},{"id":"26","start":175.18,"end":178.18,"text":"分からない","translation":"","kind":"lyric"},{"id":"27","start":221.65,"end":224.65,"text":"もしもボクら歌ならば","translation":"","kind":"lyric"},{"id":"28","start":227.04,"end":230.04,"text":"あの風に 帆を上げ","translation":"","kind":"lyric"},{"id":"29","start":231.99,"end":234.99,"text":"迷わずにただ 誰かの元へ","translation":"","kind":"lyric"},{"id":"30","start":237.54,"end":240.54,"text":"希望 届けに行くのに","translation":"","kind":"lyric"},{"id":"31","start":248.41,"end":251.41,"text":"この 美しき残酷な世界では","translation":"","kind":"lyric"},{"id":"32","start":254.59,"end":256.95,"text":"まだ生きていること","translation":"","kind":"lyric"},{"id":"33","start":256.95,"end":259.92,"text":"「何故」と問うばかりで","translation":"","kind":"lyric"},{"id":"34","start":259.92,"end":262.92,"text":"嗚呼ボクたちは この強さ 弱さで","translation":"","kind":"lyric"},{"id":"35","start":265.42,"end":268.42,"text":"何を護るのだろう もう理性など","translation":"","kind":"lyric"},{"id":"36","start":271.05,"end":274.05,"text":"無いならば","translation":"","kind":"lyric"}],"candidates":[]}