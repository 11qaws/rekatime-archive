kind":"lyric"},{"id":"17","start":62.805833,"end":64.735,"text":"私だけ見て","translation":"나만 봐줘","kind":"lyric"},{"id":"18","start":65.175833,"end":70.575,"text":"旦那様こんなに夢中よんー全部好き！","translation":"서방님 이렇게 푹 빠졌어 전부 좋아","kind":"lyric"},{"id":"19","start":71.365833,"end":74.165,"text":"ほっぺデレデレ 尻尾プンプン","translation":"볼은 헤실헤실 꼬리는 씩씩","kind":"lyric"},{"id":"20","start":74.525833,"end":76.395,"text":"どんな時でも","translation":"어느 때라도","kind":"lyric"},{"id":"21","start":77.515833,"end":79.275,"text":"側にいさせて","translation":"곁에 있게 해줘","kind":"lyric"},{"id":"22","start":82.445833,"end":85.673287,"text":"わたし 妻なので 妻なので","translation":"나 아내니까 아내니까","kind":"lyric"},{"id":"23","start":85.705833,"end":88.555833,"text":"そうよ 妻ですの 妻ですの","translation":"그래요 아내랍니다 아내랍니다","kind":"lyric"},{"id":"24","start":88.575833,"end":91.185,"text":"もっと 妻として 妻として","translation":"더욱 아내로서 아내로서","kind":"lyric"},{"id":"25","start":91.445833,"end":94.135,"text":"あなた 笑顔にしてみせる","translation":"당신을 웃게 해 보일게","kind":"lyric"},{"id":"26","start":95.135833,"end":100.755,"text":"だからちょっと愛が重くてもいいでしょ？","translation":"그러니 사랑이 조금 무거워도 괜찮지","kind":"lyric"},{"id":"27","start":100.945833,"end":104.082373,"text":"何でもしちゃうの","translation":"뭐든 해 버릴 거야","kind":"lyric"},{"id":"28","start":104.115833,"end":109.885,"text":"あなた（あなた）あなた（あなた）だけよ","translation":"당신 당신 당신 당신뿐이야","kind":"lyric"},{"id":"29","start":110.395833,"end":115.675,"text":"誰にでも優しくしないで 拗ねちゃうかもよ","translation":"누구에게나 다정하게 굴지 마 삐질지도 몰라","kind":"lyric"},{"id":"30","start":116.475833,"end":119.365,"text":"胸がチクチク お耳垂れちゃう","translation":"가슴이 콕콕 귀가 축 처져","kind":"lyric"},{"id":"31","start":119.465833,"end":121.515,"text":"もっと構って","translation":"좀 더 신경 써줘","kind":"lyric"},{"id":"32","start":121.835833,"end":127.375,"text":"だけどそのお人好しさえも 結局ね 好き！","translation":"하지만 그 상냥함마저도 결국은 좋아","kind":"lyric"},{"id":"33","start":127.975833,"end":130.976002,"text":"やっぱキュンキュン お耳ピコピコ","translation":"역시 두근두근 귀가 쫑긋쫑긋","kind":"lyric"},{"id":"34","start":131.125833,"end":133.365,"text":"そのままでいて","translation":"그대로 있어줘","kind":"lyric"},{"id":"35","start":133.605833,"end":138.995,"text":"誓います 一生一緒よんーずっと好き！","translation":"맹세할게 평생 함께야 계속 좋아","kind":"lyric"},{"id":"36","start":139.685833,"end":142.555,"text":"何があっても どんな場所でも","translation":"무슨 일이 있어도 어느 곳에 있어도","kind":"lyric"},{"id":"37","start":142.915833,"end":144.805,"text":"側にいさせて","translation":"곁에 있게 해줘","kind":"lyric"},{"id":"38","start":145.375833,"end":151.285256,"text":"たまにはゆっくりデートしましょ","translation":"가끔은 느긋하게 데이트해요","kind":"lyric"},{"id":"39","start":151.505833,"end":154.205,"text":"ココロふにゃふにゃ不意にドキドキ","translation":"마음이 흐물흐물 문득 두근두근","kind":"lyric"},{"id":"40","start":154.345833,"end":156.525,"text":"あなたがいれば","translation":"당신이 있으면","kind":"lyric"},{"id":"41","start":157.275833,"end":159.395,"text":"いつも幸せ","translation":"언제나 행복해","kind":"lyric"},{"id":"42","start":159.885833,"end":160.56769,"text":"「ぎゅっ！」","translation":"꼬옥","kind":"lyric"},{"id":"43","start":160.635833,"end":163.265,"text":"ラブラブ・ラブソング","translation":"러브러브 러브송","kind":"lyric"},{"id":"44","start":163.575833,"end":166.212345,"text":"ラブラブ・ラブソング","translation":"러브러브 러브송","kind":"lyric"},{"id":"45","start":166.375833,"end":169.925,"text":"ラブラブ・ラブソング","translation":"러브러브 러브송","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}