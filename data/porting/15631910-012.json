{"title":"점묘의 노래","artist":"Mrs. GREEN APPLE","date":"2026-10-11","sourceId":"15631910:012","sourceHash":"480e7e512bc5d655bb505ab2b46f8fd267d428dc9d836de4e0b61a28a838612a","duration":311.0,"cues":[{"id":"1","start":31.543208,"end":37.542313,"text":"貴方の声で解れてゆく","translation":"그대 목소리에 서서히 풀려 가","kind":"lyric"},{"id":"2","start":37.883361,"end":43.852313,"text":"忘れたくないと心が云う","translation":"잊고 싶지 않다고 마음이 말해","kind":"lyric"},{"id":"3","start":44.47352,"end":50.302313,"text":"思い出ばっか増えてゆく","translation":"추억만 늘어만 가","kind":"lyric"},{"id":"4","start":50.72367,"end":56.152313,"text":"ずっと側に居たい","translation":"줄곧 곁에 머물고 싶어","kind":"lyric"},{"id":"5","start":56.473809,"end":61.182313,"text":"泣き虫でもいいかな","translation":"울보여도 괜찮을까","kind":"lyric"},{"id":"6","start":62.883964,"end":68.112313,"text":"強がらないでいいよ","translation":"센 척하지 않아도 돼","kind":"lyric"},{"id":"7","start":69.294118,"end":75.422313,"text":"限りある恋だとしても","translation":"끝이 있는 사랑이라 해도","kind":"lyric"},{"id":"8","start":75.58427,"end":80.102313,"text":"出逢えて幸せです","translation":"그대를 만나 행복해요","kind":"lyric"},{"id":"9","start":81.644416,"end":85.294928,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"10","start":85.344506,"end":87.792313,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"11","start":88.044571,"end":94.072313,"text":"続いて欲しいと願っている","translation":"이어지기를 바라고 있어","kind":"lyric"},{"id":"12","start":94.21472,"end":100.792313,"text":"手を取ることは出来ずとも","translation":"손을 잡지는 못하더라도","kind":"lyric"},{"id":"13","start":101.114886,"end":106.902313,"text":"私は貴方を好いている","translation":"나는 그대를 마음에 품고 있어","kind":"lyric"},{"id":"14","start":107.985052,"end":114.112313,"text":"貴方の夢で心安らぐ","translation":"그대가 나오는 꿈에 마음이 놓여","kind":"lyric"},{"id":"15","start":114.495209,"end":120.552313,"text":"目覚めたくないと僕は云う","translation":"깨어나고 싶지 않다고 나는 말해","kind":"lyric"},{"id":"16","start":120.695358,"end":126.732313,"text":"思い出ばっか増えてゆく","translation":"추억만 늘어만 가","kind":"lyric"},{"id":"17","start":126.97551,"end":133.487233,"text":"明日も側に居たい","translation":"내일도 곁에 머물고 싶어","kind":"lyric"},{"id":"18","start":145.725962,"end":148.592313,"text":"どこまでも","translation":"어디까지고","kind":"lyric"},{"id":"19","start":148.736035,"end":151.742313,"text":"どこまでも","translation":"어디까지고","kind":"lyric"},{"id":"20","start":151.85611,"end":158.262313,"text":"鈍感な僕を叱って欲しい","translation":"무딘 나를 나무라 줬으면 해","kind":"lyric"},{"id":"21","start":158.49627,"end":164.362313,"text":"当たり前が壊れることに","translation":"당연하던 것이 무너지는 걸","kind":"lyric"},{"id":"22","start":164.556416,"end":170.27884,"text":"気づけないくらいに子供だけど","translation":"알아차리지 못할 만큼 어리지만","kind":"lyric"},{"id":"23","start":170.326556,"end":177.196722,"text":"ちゃんと僕は貴方を好いている","translation":"그래도 나는 그대를 진심으로 좋아해","kind":"lyric"},{"id":"24","start":177.216722,"end":190.472313,"text":"私の (僕の) 時間が止まればいいのに","translation":"우리 둘의 시간이 멈추면 좋을 텐데","kind":"lyric"},{"id":"25","start":202.727337,"end":206.180524,"text":"ほらまた期待をしてしまう","translation":"봐 또 기대하고 말아","kind":"lyric"},{"id":"26","start":206.227422,"end":208.792313,"text":"グッと堪えてみるからさ","translation":"꾹 눌러 참아 볼 테니까","kind":"lyric"},{"id":"27","start":208.887486,"end":210.564748,"text":"もし溢れ出したら","translation":"만일 넘쳐 버린다면","kind":"lyric"},{"id":"28","start":210.757531,"end":215.772313,"text":"瞳をちゃんと見てよ 見てよ 見て","translation":"내 눈을 제대로 바라봐 바라봐 봐","kind":"lyric"},{"id":"29","start":215.987657,"end":221.118106,"text":"貴方の影だけ伸びてゆく","translation":"그대 그림자만 길어져 가","kind":"lyric"},{"id":"30","start":221.257784,"end":226.45791,"text":"消えてしまわないで","translation":"제발 사라지지 마","kind":"lyric"},{"id":"31","start":226.47791,"end":231.268026,"text":"ずっと この思いは変わらない","translation":"줄곧 이 마음은 변하지 않아","kind":"lyric"},{"id":"32","start":231.288026,"end":233.951913,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"33","start":233.998092,"end":236.992313,"text":"いつまでも","translation":"언제까지고","kind":"lyric"},{"id":"34","start":237.098166,"end":243.222313,"text":"続いて欲しいと願っている","translation":"이어지기를 바라고 있어","kind":"lyric"},{"id":"35","start":243.368318,"end":249.992313,"text":"手を取ることは出来ずとも","translation":"손을 잡지는 못하더라도","kind":"lyric"},{"id":"36","start":250.218483,"end":255.822313,"text":"過ぎていく現在に抱きしめられている","translation":"흘러가는 지금에 품 안겨 있어","kind":"lyric"},{"id":"37","start":256.238628,"end":262.582313,"text":"私の (僕の)","translation":"우리 둘의","kind":"lyric"},{"id":"38","start":262.918789,"end":269.002313,"text":"時間が止まればいいのに","translation":"시간이 멈추면 좋을 텐데","kind":"lyric"},{"id":"39","start":269.348944,"end":275.532313,"text":"今日を噛み締めていよう","translation":"오늘을 마음 깊이 새기자","kind":"lyric"},{"id":"40","start":275.629096,"end":277.942313,"text":"終わるな","translation":"끝나지 마","kind":"lyric"},{"id":"41","start":278.109156,"end":282.351642,"text":"夏よ、終わるな","translation":"여름아 끝나지 마","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}