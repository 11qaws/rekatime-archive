{"title":"End of the World","artist":"Beth Crowley","sourceId":"reference:mQFyUQGoQ5LYdJjBQ5Af","sourceHash":"25a6d382bf90bf36743e2b330e326ec38aa9e466831002d62ecb017aa7268496","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":16.19,"end":19.19,"text":"There's a tension in the air","translation":"","kind":"lyric"},{"id":"2","start":19.36,"end":22.36,"text":"I can almost taste it","translation":"","kind":"lyric"},{"id":"3","start":22.85,"end":25.85,"text":"And I guess I should be scared","translation":"","kind":"lyric"},{"id":"4","start":26.04,"end":29.04,"text":"To know I'll have to face it","translation":"","kind":"lyric"},{"id":"5","start":29.85,"end":32.85,"text":"In this twisted truth or dare","translation":"","kind":"lyric"},{"id":"6","start":33.31,"end":36.31,"text":"That never changes","translation":"","kind":"lyric"},{"id":"7","start":36.88,"end":39.88,"text":"But I'm not playing anymore","translation":"","kind":"lyric"},{"id":"8","start":42.14,"end":44.79,"text":"It's the end of the world","translation":"","kind":"lyric"},{"id":"9","start":44.79,"end":47.79,"text":"What's the point of running?","translation":"","kind":"lyric"},{"id":"10","start":49.13,"end":51.89,"text":"The end of the world","translation":"","kind":"lyric"},{"id":"11","start":51.89,"end":54.89,"text":"So why do I feel nothing?","translation":"","kind":"lyric"},{"id":"12","start":55.51,"end":56.47,"text":"Nothing","translation":"","kind":"lyric"},{"id":"13","start":56.47,"end":59.47,"text":"The end of the world","translation":"","kind":"lyric"},{"id":"14","start":60.76,"end":63.66,"text":"But I'm not going down like this","translation":"","kind":"lyric"},{"id":"15","start":63.66,"end":66.66,"text":"The end of the world","translation":"","kind":"lyric"},{"id":"16","start":68.02,"end":71.02,"text":"Show me what happens next","translation":"","kind":"lyric"},{"id":"17","start":71.25,"end":74.25,"text":"What happens next?","translation":"","kind":"lyric"},{"id":"18","start":76.53999999999999,"end":79.53999999999999,"text":"It doesn't matter where I go","translation":"","kind":"lyric"},{"id":"19","start":80.03,"end":83.03,"text":"The shadows always find me","translation":"","kind":"lyric"},{"id":"20","start":83.55,"end":86.55,"text":"They settle deep into my bones","translation":"","kind":"lyric"},{"id":"21","start":87.3,"end":90.3,"text":"And I'm so tired of fighting","translation":"","kind":"lyric"},{"id":"22","start":90.81,"end":93.81,"text":"Satisfied with being numb","translation":"","kind":"lyric"},{"id":"23","start":94.31,"end":97.31,"text":"I keep lying","translation":"","kind":"lyric"},{"id":"24","start":97.82,"end":100.82,"text":"But there's no denying who I am","translation":"","kind":"lyric"},{"id":"25","start":103.03,"end":106.03,"text":"It's the end of the world","translation":"","kind":"lyric"},{"id":"26","start":106.28999999999999,"end":109.28999999999999,"text":"What's the point of running?","translation":"","kind":"lyric"},{"id":"27","start":110.38,"end":112.67,"text":"The end of the world","translation":"","kind":"lyric"},{"id":"28","start":112.67,"end":115.67,"text":"So why do I feel nothing?","translation":"","kind":"lyric"},{"id":"29","start":116.35,"end":117.2,"text":"Nothing","translation":"","kind":"lyric"},{"id":"30","start":117.2,"end":120.2,"text":"The end of the world","translation":"","kind":"lyric"},{"id":"31","start":120.84,"end":123.84,"text":"But I'm not going down like this","translation":"","kind":"lyric"},{"id":"32","start":124.54,"end":127.54,"text":"The end of the world","translation":"","kind":"lyric"},{"id":"33","start":128.46,"end":131.46,"text":"Show me what happens next","translation":"","kind":"lyric"},{"id":"34","start":131.9,"end":134.9,"text":"What happens next?","translation":"","kind":"lyric"},{"id":"35","start":136.57999999999998,"end":139.5799999999999