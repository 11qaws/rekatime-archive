{"title":"엘의 그림책【마녀와 라프렌체】","artist":"Sound Horizon","sourceId":"reference:fSNb8JC59UJogkd3evJp","sourceHash":"54276afb41acdbc7f958ed90e2f5b841cbe66bbe288a855ae81e18797c5bbfd7","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":0.16,"end":1.61,"text":"如何にして","translation":"","kind":"lyric"},{"id":"2","start":1.61,"end":4.61,"text":"楽園の扉は開かれたのか","translation":"","kind":"lyric"},{"id":"3","start":12.27,"end":15.27,"text":"鬱蒼と茂る暗緑の樹々","translation":"","kind":"lyric"},{"id":"4","start":15.58,"end":18.41,"text":"不気味な鳥の鳴き声","translation":"","kind":"lyric"},{"id":"5","start":18.41,"end":20.98,"text":"ある人里離れた森に","translation":"","kind":"lyric"},{"id":"6","start":20.98,"end":23.98,"text":"その赤ん坊は捨てられていた","translation":"","kind":"lyric"},{"id":"7","start":24.1,"end":26.15,"text":"幸か... 不幸か...","translation":"","kind":"lyric"},{"id":"8","start":26.15,"end":28.14,"text":"人目を憚るように捨てられていた","translation":"","kind":"lyric"},{"id":"9","start":28.14,"end":30.26,"text":"その子を拾ったのは","translation":"","kind":"lyric"},{"id":"10","start":30.26,"end":33.260000000000005,"text":"王国を追われた隻眼の魔女","translation":"","kind":"lyric"},{"id":"11","start":33.28,"end":36.28,"text":"《深紅の魔女と謳われた》オルドローズ","translation":"","kind":"lyric"},{"id":"12","start":36.48,"end":39.48,"text":"銀色の髪に 緋色の瞳","translation":"","kind":"lyric"},{"id":"13","start":39.65,"end":42.17,"text":"雪のように白い肌","translation":"","kind":"lyric"},{"id":"14","start":42.17,"end":44.68,"text":"拾われた赤ん坊は いつしか","translation":"","kind":"lyric"},{"id":"15","start":44.68,"end":47.68,"text":"背筋が凍る程美しい娘へと育った...","translation":"","kind":"lyric"},{"id":"16","start":49.19,"end":51.73,"text":"流転こそ万物の基本","translation":"","kind":"lyric"},{"id":"17","start":51.73,"end":54.73,"text":"流れる以上時もまた然り","translation":"","kind":"lyric"},{"id":"18","start":55.03,"end":57.78,"text":"二つの楽園を巡る物語は","translation":"","kind":"lyric"},{"id":"19","start":57.78,"end":60.78,"text":"人知れず幕を開ける...","translation":"","kind":"lyric"},{"id":"20","start":63.57,"end":64.83,"text":"「ラフレンツェや...","translation":"","kind":"lyric"},{"id":"21","start":64.83,"end":67.07,"text":"忘れてはいけないよ...」","translation":"","kind":"lyric"},{"id":"22","start":67.07,"end":69.53,"text":"銀色の髪を","translation":"","kind":"lyric"},{"id":"23","start":69.53,"end":72.36,"text":"風になびかせて","translation":"","kind":"lyric"},{"id":"24","start":72.36,"end":75.01,"text":"祈るラフレンツェ","translation":"","kind":"lyric"},{"id":"25","start":75.01,"end":78.01,"text":"死者の為に","translation":"","kind":"lyric"},{"id":"26","start":78.08,"end":80.84,"text":"小さな唇が","translation":"","kind":"lyric"},{"id":"27","start":80.84,"end":83.57,"text":"奏でる鎮魂歌 (レクイエム)","translation":"","kind":"lyric"},{"id":"28","start":83.57,"end":86.16,"text":"歌えラフレンツェ","translation":"","kind":"lyric"},{"id":"29","start":86.16,"end":89.16,"text":"永遠に響け","translation":"","kind":"lyric"},{"id":"30","start":89.51,"end":92.51,"text":"時を喰らう大蛇 (セルペンス)","translation":"","kind":"lyric"},{"id":"31","start":92.6,"end":95.6,"text":"灼けた鎖の追走曲","translation":"","kind":"lyric"},{"id":"32","start":95.83,"end":98.82,"text":"狂い咲いた曼珠沙華 (リコリス)","translation":"","kind":"lyric"},{"id":"33","start":98.82,"end":101.82,"text":"還れない楽園","translation":"","kind":"lyric"},{"id":"34","start":102.38,"end":105.32,"text":"蝋燭が消えれば","translation":"","kind":"lyric"},{"id":"35","start":105.32,"end":108.32,"text":"渡れない川がある","translation":"","kind":"lyric"},{"id":"36","start":108.53,"end":111.53,"text":"始まりも忘れて","translation":"","kind":"lyric"},{"id":"37","start":111.53999999999999,"end":114.53999999999999,"text":"終わらない虚空を抱く...","translation":"","kind":"lyric"},{"id":"38","start":118.53,"end":121.1,"text":"「―――オノレ ラフレンツェ」","translation":"","kind":"lyric"},{"id":"39","start":121.1,"end":124.1,"text":"悲痛な叫びの不響和音","translation":"","kind":"lyric"},{"id":"40","start":127.39,"end":129.7,"text":"「―――ニクキ ラフレンツェ」","translation":"","k