:"","kind":"lyric"},{"id":"63","start":207.14,"end":208.84,"text":"破らせてはいけないよ...」","translation":"","kind":"lyric"},{"id":"64","start":208.84,"end":210.81,"text":"祖母が居なくなって","translation":"","kind":"lyric"},{"id":"65","start":210.81,"end":213.17000000000002,"text":"唇を閉ざした","translation":"","kind":"lyric"},{"id":"66","start":213.17000000000002,"end":214.68,"text":"吹き抜ける風","translation":"","kind":"lyric"},{"id":"67","start":214.68,"end":217.37,"text":"寂しさと孤独と知った","translation":"","kind":"lyric"},{"id":"68","start":217.37,"end":219.69,"text":"彼が訪れて","translation":"","kind":"lyric"},{"id":"69","start":219.69,"end":221.67000000000002,"text":"唇を開いた","translation":"","kind":"lyric"},{"id":"70","start":221.67000000000002,"end":223.36,"text":"嬉しくなって","translation":"","kind":"lyric"},{"id":"71","start":223.36,"end":225.68,"text":"誓いも忘れていった","translation":"","kind":"lyric"},{"id":"72","start":225.68,"end":226.15,"text":"―――それは","translation":"","kind":"lyric"},{"id":"73","start":226.15,"end":228.12,"text":"手と手が触れ合った","translation":"","kind":"lyric"},{"id":"74","start":228.12,"end":230.32,"text":"瞬間の魔法","translation":"","kind":"lyric"},{"id":"75","start":230.32,"end":231.99,"text":"高鳴る鼓動","translation":"","kind":"lyric"},{"id":"76","start":231.99,"end":234.67000000000002,"text":"小さな銀鈴を鳴らす","translation":"","kind":"lyric"},{"id":"77","start":234.67000000000002,"end":236.65,"text":"瞳と瞳見つめ合った","translation":"","kind":"lyric"},{"id":"78","start":236.65,"end":238.97,"text":"瞬間の魔法","translation":"","kind":"lyric"},{"id":"79","start":238.97,"end":240.36,"text":"禁断の焔","translation":"","kind":"lyric"},{"id":"80","start":240.36,"end":242.95,"text":"少女は恋を知った","translation":"","kind":"lyric"},{"id":"81","start":242.95,"end":245.11,"text":"一つ奪えば","translation":"","kind":"lyric"},{"id":"82","start":245.11,"end":247.16,"text":"十が欲しくなり","translation":"","kind":"lyric"},{"id":"83","start":247.16,"end":248.62,"text":"十を奪えば","translation":"","kind":"lyric"},{"id":"84","start":248.62,"end":251.37,"text":"百が欲しくなる","translation":"","kind":"lyric"},{"id":"85","start":251.37,"end":254.37,"text":"その焔は彼の全てを","translation":"","kind":"lyric"},{"id":"86","start":255.63,"end":257.69,"text":"灼き尽くすまで","translation":"","kind":"lyric"},{"id":"87","start":257.69,"end":260.69,"text":"消えはしない","translation":"","kind":"lyric"},{"id":"88","start":260.92,"end":262.55,"text":"「ラフレンツェや...","translation":"","kind":"lyric"},{"id":"89","start":262.55,"end":264.53,"text":"忘れてはいけないよ...」","translation":"","kind":"lyric"},{"id":"90","start":264.53,"end":266.52,"text":"愛欲に","translation":"","kind":"lyric"},{"id":"91","start":266.52,"end":268.96,"text":"咽ぶラフレンツェ","translation":"","kind":"lyric"},{"id":"92","start":268.96,"end":271.96,"text":"純潔の花を散らして","translation":"","kind":"lyric"},{"id":"93","start":272.96,"end":274.95,"text":"愛憎も","translation":"","kind":"lyric"},{"id":"94","start":274.95,"end":277.51,"text":"知らぬラフレンツェ","translation":"","kind":"lyric"},{"id":"95","start":277.51,"end":280.51,"text":"漆黒の焔を抱いて","translation":"","kind":"lyric"},{"id":"96","start":281.57,"end":283.52,"text":"彼は手探りで","translation":"","kind":"lyric"},{"id":"97","start":283.52,"end":285.1,"text":"闇に繋がれた","translation":"","kind":"lyric"},{"id":"98","start":285.1,"end":288.1,"text":"獣の檻を外して","translation":"","kind":"lyric"},{"id":"99","start":290.24,"end":292.22,"text":"少女の","translation":"","kind":"lyric"},{"id":"100","start":292.22,"end":294.58,"text":"胎内に繋がれた","translation":"","kind":"lyric"},{"id":"101","start":294.58,"end":297.58,"text":"冥府の底へ堕りてゆく","translation":"","kind":"lyric"},{"id":"102","start":299.39,"end":301.21,"text":"近づいて来る足音","translation":"","kind":"lyric"},{"id":"103","start":301.21,"end":302.32,"text":"やがて彼が","translation":"","kind":"lyric"},{"id":"104","start":302.32,"end":304.22,"text":"乙女の手を引いて","translation":"","kind":"lyric"},{"id":"105","start":304.22,"end":307.03,"text":"暗闇の階段を駆け上がって来る","translation":"","kind":"lyric"},{"id":"106","start":307.03,"end":308.0,"text":"けれど少女は","translation":"","kind":"lyric"},{"id":"107","start":308.0,"end":309.4,"text":"裏切りの代償として","translation":"","kind":"lyric"},{"id":"108","start":309.4,"end":311.57,"text":"残酷な呪いを歌った","translation":"","kind":"lyric"},{"id":"109","start":311.57,"end":313.07,"text":"嗚呼","translation":"","kind":"lyric"},{"id":"110","start":313.07,"end":314.05,"text":"もう直ぐ彼は","translation":"","kind":"lyric"},{"id":"111","start":314.05,"end":317.05,"text":"彼は振り返ってしまうだろう","translation":"","kind":"lyric"},{"id":"112","start":318.22,"end":321.22,"text":"『魔女がラフレンツェを生んだのか","translation":"","kind":"lyric"},{"id":"113","start":322.08,"end":325.01,"text":"ラフレンツェが魔女を生んだのか","translation":"","kind":"lyric"},{"id":"114","start":325.01,"end":328.01,"text":"物語はページの外側に』","translation":"","kind":"lyric"},{"id":"115","start":344.13,"end":345.34000000000003,"text":"『斯くして","translation":"","kind":"lyric"},{"id":"116","start":345.34000000000003,"end":348.34000000000003,"text":"楽園の扉は開かれた』","translation":"","kind":"lyric"}],"candidates":[]}