{"originalLanguage":"ja","title":"Who Killed U.N.Owen","artist":"Liz Triangle","date":"2026-09-10","sourceId":"15134820:006","sourceHash":"fdc14c90839237d9146738abf4ed55c92b107e7ab94d8d6797039c1acfd77947","duration":325.7999999999993,"cues":[{"id":"1","start":38.989816,"end":42.365,"text":"暗いお城で開かれた","translation":"어두운 성에서 열린","kind":"lyric"},{"id":"2","start":42.479839,"end":46.135,"text":"一人きりで始まるお茶会","translation":"혼자 시작하는 다과회","kind":"lyric"},{"id":"3","start":46.449866,"end":49.835,"text":"籠の中の小鳥さん","translation":"새장 속 작은 새야","kind":"lyric"},{"id":"4","start":49.989889,"end":53.225,"text":"あなた 私と踊りましょ？","translation":"나와 함께 춤출래","kind":"lyric"},{"id":"5","start":53.739914,"end":57.385,"text":"(La-la-la-la) 休む事く無く","translation":"라라라라 쉬지 않고","kind":"lyric"},{"id":"6","start":57.519939,"end":60.975,"text":"(La-la-la-la) 手を叩く","translation":"라라라라 손뼉을 쳐","kind":"lyric"},{"id":"7","start":61.199963,"end":64.965,"text":"(La-la-la-la-la) 終わる事の無い","translation":"라라라라라 끝나지 않는","kind":"lyric"},{"id":"8","start":65.21999,"end":68.335,"text":"秘密のカルニバル","translation":"비밀의 카니발","kind":"lyric"},{"id":"9","start":68.580012,"end":72.355,"text":"カゴメよカゴメ お菓子はいかが？","translation":"카고메야 카고메 과자는 어떠니","kind":"lyric"},{"id":"10","start":72.530039,"end":76.013003,"text":"赤色と青色の飴","translation":"빨간 사탕과 파란 사탕","kind":"lyric"},{"id":"11","start":76.060062,"end":79.60206,"text":"お菓子の家に出口はないよ","translation":"과자 집에는 출구가 없어","kind":"lyric"},{"id":"12","start":79.790087,"end":85.275,"text":"シリアスな声でこう囁く","translation":"진지한 목소리로 이렇게 속삭여","kind":"lyric"},{"id":"13","start":86.000128,"end":87.771127,"text":"「鏡よ鏡」","translation":"거울아 거울아","kind":"lyric"},{"id":"14","start":87.85014,"end":91.545,"text":"世界で誰よりも","translation":"세상 누구보다","kind":"lyric"},{"id":"15","start":91.790166,"end":95.055,"text":"いたずら好きなのは誰ですか？","translation":"장난을 좋아하는 사람은 누구니","kind":"lyric"},{"id":"16","start":95.190189,"end":99.14542,"text":"「それはあなたです」と","translation":"그건 바로 너라고","kind":"lyric"},{"id":"17","start":99.170215,"end":101.177348,"text":"映る私が笑う","translation":"거울에 비친 내가 웃어","kind":"lyric"},{"id":"18","start":101.220229,"end":104.560251,"text":"「私はあなた あなたはだれ？」","translation":"나는 너 너는 누구니","kind":"lyric"},{"id":"19","start":104.580251,"end":108.275,"text":"キラキラと割れるダレカの笑顔","translation":"반짝이며 산산이 깨지는 누군가의 미소","kind":"lyric"},{"id":"20","start":108.430277,"end":112.031308,"text":"「あなたは私 私はだぁれ？」","translation":"너는 나 나는 누구니","kind":"lyric"},{"id":"21","start":112.060301,"end":115.995,"text":"心の刺さる エゴイズム","translation":"마음을 찌르는 이기주의","kind":"lyric"},{"id":"22","start":120.380356,"end":123.825,"text":"La-la-la-la, la-la-la-la, la-la-la-la","translation":"라라라라 라라라라 라라라라","kind":"lyric"},{"id":"23","start":123.920379,"end":126.990111,"text":"誰にも内緒よ la-la-la-la","translation":"누구에게도 비밀이야 라라라라","kind":"lyric"},{"id":"24","start":127.790405,"end":131.62757,"text":"La-la-la-la, la-la-la-la, la-la-la-la","translation":"라라라라 라라라라 라라라라","kind":"lyric"},{"id":"25","start":131.670431,"end":135.085,"text":"始まりのおしまい","translation":"시작의 끝","kind":"lyric"},{"id":"26","start":138.570477,"end":142.407641,"text":"あなたが残した","translation":"네가 남긴","kind":"lyric"},{"id":"27","start":142.620503,"end":145.875,"text":"プレゼントは何処？","translation":"선물은 어디에 있어","kind":"lyric"},{"id":"28","start":145.990526,"end":150.180554,"text":"何処 どこ ドコなの？","translation":"어디 어디 어디 있는 거야","kind":"lyric"},{"id":"29","start":150.200554,"end":154.19058,"text":"空っぽの靴下","translation":"텅 빈 양말","kind":"lyric"},{"id":"30","start":154.21058,"end":157.634512,"text":"誰が殺し 誰がなる？","translation":"누가 죽이고 누가 되는 걸까","kind":"lyric"},{"id":"31","start":157.670603,"end":162.130633,"text":"誰が鳴らすか 鏡の音を？","translation":"거울 소리를 울리는 건 누구일까","kind":"lyric"},{"id":"32","start":162.150633,"end":165.235,"text":"「それは 私よ」","translation":"그건 나야","kind":"lyric"},{"id":"33","start":165.860658,"end":170.015,"text":"ダレカの声が響く","translation":"누군가의 목소리가 울려 퍼져","kind":"lyric"},{"id":"34","start":170.380688,"end":174.158819,"text":"円卓を囲むのは","translation":"원탁을 둘러싼 것은","kind":"lyric"},{"id":"35","start":174.200713,"end":177.919811,"text":"可哀想な駒鳥で","translation":"가엾은 울새들","kind":"lyric"},{"id":"36","start":178.060739,"end":181.543703,"text":"優しく抱きしめて","translation":"다정하게 끌어안고","kind":"lyric"},{"id":"37","start":181.760763,"end":183.825,"text":"抱え上げ","translation":"들어 올리고","kind":"lyric"},{"id":"38","start":183.970778,"end":185.485,"text":"握り締め","translation":"꽉 움켜쥐면","kind":"lyric"},{"id":"39","start":185.75079,"end":187.425,"text":"零れだす","translation":"흘러넘치는","kind":"lyric"},{"id":"40","start":187.710803,"end":190.145,"text":"愉悦の笑み","translation":"환희의 미소","kind":"lyric"},{"id":"41","start":222.561034,"end":226.516265,"text":"中身をくり貫いた","translation":"속을 도려낸","kind":"lyric"},{"id":"42","start":226.57106,"end":229.975,"text":"カボチャのフェイス","translation":"호박 얼굴","kind":"lyric"},{"id":"43","start":230.271085,"end":234.501113,"text":"マネキンだらけで","translation":"마네킹투성이라","kind":"lyric"},{"id":"44","start":234.521113,"end":237.645,"text":"踊れやしない！","translation":"춤출 수도 없어","kind":"lyric"},{"id":"45","start":237.991136,"end":239.715,"text":"あなたと私","translation":"너와 나","kind":"lyric"},{"id":"46","start":239.831148,"end":241.602147,"text":"籠の中","translation":"새장 안에서","kind":"lyric"},{"id":"47","start":241.681161,"end":243.156993,"text":"あなたも私","translation":"너도 나도","kind":"lyric"},{"id":"48","start":243.231171,"end":245.165,"text":"（チグハグ）","translation":"서로 뒤죽박죽","kind":"lyric"},{"id":"49","start":245.511186,"end":249.289317,"text":"ネジが動きを止め","translation":"태엽이 움직임을 멈추고","kind":"lyric"},{"id":"50","start":249.321211,"end":252.505,"text":"踊る事の無いオートマタ","translation":"더는 춤추지 않는 오토마타","kind":"lyric"},{"id":"51","start":253.221237,"end":256.375,"text":"虚実に苛まれ","translation":"진실과 거짓에 시달리다","kind":"lyric"},{"id":"52","start":256.64126,"end":260.351285,"text":"そして誰もが消える","translation":"마침내 모두가 사라져","kind":"lyric"},{"id":"53","start":260.371285,"end":262.491299,"text":"ヒドイ世界で","translation":"끔찍한 세상에서","kind":"lyric"},{"id":"54","start":262.511299,"end":266.135,"text":"私と踊りましょ？","translation":"나와 함께 춤출래","kind":"lyric"},{"id":"55","start":266.311324,"end":269.695,"text":"生きてるふりをしたクックロビン","translation":"살아 있는 척한 쿡 로빈","kind":"lyric"},{"id":"56","start":270.001348,"end":273.60238,"text":"お菓子のお城には","translation":"과자 성에는","kind":"lyric"},{"id":"57","start":273.651373,"end":277.429504,"text":"壊れた魔女が一人","translation":"망가진 마녀가 하나","kind":"lyric"},{"id":"58","start":277.581399,"end":279.285,"text":"「あなたは私 あなたはだぁれ？」","translation":"너는 나 너는 누구니","kind":"lyric"},{"id":"59","start":279.461411,"end":283.416642,"text":"壁にまでかかる 赤い絨毯","translation":"벽에까지 걸쳐진 붉은 융단","kind":"lyric"},{"id":"60","start":283.511438,"end":286.931461,"text":"「私はあなた あなたはだぁれ？」","translation":"나는 너 너는 누구니","kind":"lyric"},{"id":"61","start":286.951461,"end":290.325,"text":"人形遊び ツマラナイ","translation":"인형 놀이는 재미없어","kind":"lyric"},{"id":"62","start":291.091488,"end":294.435,"text":"「私は私 あなたはだぁれ？」","translation":"나는 나 너는 누구니","kind":"lyric"},{"id":"63","start":294.531511,"end":298.604809,"text":"月夜に輝く ジャックランタン","translation":"달밤에 빛나는 잭오랜턴","kind":"lyric"},{"id":"64","start":298.771539,"end":301.782238,"text":"「私は私 あなたは邪魔」","translation":"나는 나 너는 방해돼","kind":"lyric"},{"id":"65","start":302.131562,"end":305.535,"text":"お次のお相手は 誰かしら","translation":"다음 상대는 누구일까","kind":"lyric"},{"id":"66","start":306.001587,"end":309.995,"text":"「踊りましょう？」","translation":"함께 춤출래","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}