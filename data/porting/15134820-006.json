{"title":"Who Killed U.N.Owen","artist":"Liz Triangle","date":"2026-09-10","sourceId":"15134820:006","sourceHash":"77b0e34be801fa81b95e95a97f777da6e619051eb9817f03e69f4db0ec083c08","duration":334.1,"cues":[{"id":"1","start":49.695312,"end":53.125313,"text":"暗いお城で開かれた","translation":"어두운 성에서 열린","kind":"lyric"},{"id":"2","start":53.185312,"end":57.102312,"text":"一人きりで始まるお茶会","translation":"혼자 시작하는 다과회","kind":"lyric"},{"id":"3","start":57.162312,"end":60.629312,"text":"籠の中の小鳥さん","translation":"새장 속 작은 새야","kind":"lyric"},{"id":"4","start":60.689312,"end":64.405312,"text":"あなた 私と踊りましょ？","translation":"나와 함께 춤출래","kind":"lyric"},{"id":"5","start":64.465312,"end":68.105312,"text":"(La-la-la-la) 休む事く無く","translation":"라라라라 쉬지 않고","kind":"lyric"},{"id":"6","start":68.165312,"end":71.839312,"text":"(La-la-la-la) 手を叩く","translation":"라라라라 손뼉을 쳐","kind":"lyric"},{"id":"7","start":71.899312,"end":75.852312,"text":"(La-la-la-la-la) 終わる事の無い","translation":"라라라라라 끝나지 않는","kind":"lyric"},{"id":"8","start":75.912312,"end":79.199312,"text":"秘密のカルニバル","translation":"비밀의 카니발","kind":"lyric"},{"id":"9","start":79.259312,"end":83.169312,"text":"カゴメよカゴメ お菓子はいかが？","translation":"카고메야 카고메 과자는 어떠니","kind":"lyric"},{"id":"10","start":83.229312,"end":86.719313,"text":"赤色と青色の飴","translation":"빨간 사탕과 파란 사탕","kind":"lyric"},{"id":"11","start":86.779313,"end":90.402312,"text":"お菓子の家に出口はないよ","translation":"과자 집에는 출구가 없어","kind":"lyric"},{"id":"12","start":90.462312,"end":96.619312,"text":"シリアスな声でこう囁く","translation":"진지한 목소리로 이렇게 속삭여","kind":"lyric"},{"id":"13","start":96.679312,"end":98.489312,"text":"「鏡よ鏡」","translation":"거울아 거울아","kind":"lyric"},{"id":"14","start":98.549312,"end":102.442312,"text":"世界で誰よりも","translation":"세상 누구보다","kind":"lyric"},{"id":"15","start":102.502313,"end":105.855312,"text":"いたずら好きなのは誰ですか？","translation":"장난을 좋아하는 사람은 누구니","kind":"lyric"},{"id":"16","start":105.915312,"end":109.849312,"text":"「それはあなたです」と","translation":"그건 바로 너라고","kind":"lyric"},{"id":"17","start":109.909312,"end":111.865313,"text":"映る私が笑う","translation":"거울에 비친 내가 웃어","kind":"lyric"},{"id":"18","start":111.925312,"end":115.205312,"text":"「私はあなた あなたはだれ？」","translation":"나는 너 너는 누구니","kind":"lyric"},{"id":"19","start":115.265312,"end":119.029313,"text":"キラキラと割れるダレカの笑顔","translation":"반짝이며 산산이 깨지는 누군가의 미소","kind":"lyric"},{"id":"20","start":119.089312,"end":122.739312,"text":"「あなたは私 私はだぁれ？」","translation":"너는 나 나는 누구니","kind":"lyric"},{"id":"21","start":122.799312,"end":125.959312,"text":"心の刺さる エゴイズム","translation":"마음을 찌르는 이기주의","kind":"lyric"},{"id":"22","start":131.085313,"end":134.532313,"text":"La-la-la-la, la-la-la-la, la-la-la-la","translation":"라라라라 라라라라 라라라라","kind":"lyric"},{"id":"23","start":134.592313,"end":138.395313,"text":"誰にも内緒よ la-la-la-la","translation":"누구에게도 비밀이야 라라라라","kind":"lyric"},{"id":"24","start":138.455313,"end":142.349313,"text":"La-la-la-la, la-la-la-la, la-la-la-la","translation":"라라라라 라라라라 라라라라","kind":"lyric"},{"id":"25","start":142.409312,"end":149.202313,"text":"始まりのおしまい","translation":"시작의 끝","kind":"lyric"},{"id":"26","start":149.262313,"end":153.259313,"text":"あなたが残した","translation":"네가 남긴","kind":"lyric"},{"id":"27","start":153.319313,"end":156.629312,"text":"プレゼントは何処？","translation":"선물은 어디에 있어","kind":"lyric"},{"id":"28","start":156.689312,"end":160.819313,"text":"何処 どこ ドコなの？","translation":"어디 어디 어디 있는 거야","kind":"lyric"},{"id":"29","start":160.879312,"end":164.809313,"text":"空っぽの靴下","translation":"텅 빈 양말","kind":"lyric"},{"id":"30","start":164.869313,"end":168.309313,"text":"誰が殺し 誰がなる？","translation":"누가 죽이고 누가 되는 걸까","kind":"lyric"},{"id":"31","start":168.369313,"end":172.842313,"text":"誰が鳴らすか 鏡の音を？","translation":"거울 소리를 울리는 건 누구일까","kind":"lyric"},{"id":"32","start":172.902313,"end":176.539313,"text":"「それは 私よ」","translation":"그건 나야","kind":"lyric"},{"id":"33","start":176.599313,"end":181.025313,"text":"ダレカの声が響く","translation":"누군가의 목소리가 울려 퍼져","kind":"lyric"},{"id":"34","start":181.085313,"end":184.825313,"text":"円卓を囲むのは","translation":"원탁을 둘러싼 것은","kind":"lyric"},{"id":"35","start":184.885312,"end":188.692313,"text":"可哀想な駒鳥で","translation":"가엾은 울새들","kind":"lyric"},{"id":"36","start":188.752313,"end":192.419313,"text":"優しく抱きしめて","translation":"다정하게 끌어안고","kind":"lyric"},{"id":"37","start":192.479313,"end":194.589313,"text":"抱え上げ","translation":"들어 올리고","kind":"lyric"},{"id":"38","start":194.649313,"end":196.435313,"text":"握り締め","translation":"꽉 움켜쥐면","kind":"lyric"},{"id":"39","start":196.495313,"end":198.342313,"text":"零れだす","translation":"흘러넘치는","kind":"lyric"},{"id":"40","start":198.402313,"end":200.489313,"text":"愉悦の笑み","translation":"환희의 미소","kind":"lyric"},{"id":"41","start":233.299313,"end":237.215313,"text":"中身をくり貫いた","translation":"속을 도려낸","kind":"lyric"},{"id":"42","start":237.275313,"end":240.942313,"text":"カボチャのフェイス","translation":"호박 얼굴","kind":"lyric"},{"id":"43","start":241.002313,"end":245.119313,"text":"マネキンだらけで","translation":"마네킹투성이라","kind":"lyric"},{"id":"44","start":245.179313,"end":248.629312,"text":"踊れやしない！","translation":"춤출 수도 없어","kind":"lyric"},{"id":"45","start":248.689312,"end":250.449313,"text":"あなたと私","translation":"너와 나","kind":"lyric"},{"id":"46","start":250.509313,"end":252.299313,"text":"籠の中","translation":"새장 안에서","kind":"lyric"},{"id":"47","start":252.359313,"end":253.842313,"text":"あなたも私","translation":"너도 나도","kind":"lyric"},{"id":"48","start":253.902313,"end":256.135312,"text":"（チグハグ）","translation":"서로 뒤죽박죽","kind":"lyric"},{"id":"49","start":256.195312,"end":259.925312,"text":"ネジが動きを止め","translation":"태엽이 움직임을 멈추고","kind":"lyric"},{"id":"50","start":259.985312,"end":263.859312,"text":"踊る事の無いオートマタ","translation":"더는 춤추지 않는 오토마타","kind":"lyric"},{"id":"51","start":263.919312,"end":267.305312,"text":"虚実に苛まれ","translation":"진실과 거짓에 시달리다","kind":"lyric"},{"id":"52","start":267.365312,"end":271.049312,"text":"そして誰もが消える","translation":"마침내 모두가 사라져","kind":"lyric"},{"id":"53","start":271.109312,"end":273.115312,"text":"ヒドイ世界で","translation":"끔찍한 세상에서","kind":"lyric"},{"id":"54","start":273.175312,"end":276.935313,"text":"私と踊りましょ？","translation":"나와 함께 춤출래","kind":"lyric"},{"id":"55","start":276.995312,"end":280.652312,"text":"生きてるふりをしたクックロビン","translation":"살아 있는 척한 쿡 로빈","kind":"lyric"},{"id":"56","start":280.712312,"end":284.315313,"text":"お菓子のお城には","translation":"과자 성에는","kind":"lyric"},{"id":"57","start":284.375313,"end":288.212312,"text":"壊れた魔女が一人","translation":"망가진 마녀가 하나","kind":"lyric"},{"id":"58","start":288.272312,"end":290.105312,"text":"「あなたは私 あなたはだぁれ？」","translation":"너는 나 너는 누구니","kind":"lyric"},{"id":"59","start":290.165312,"end":294.155312,"text":"壁にまでかかる 赤い絨毯","translation":"벽에까지 걸쳐진 붉은 융단","kind":"lyric"},{"id":"60","start":294.215312,"end":297.615312,"text":"「私はあなた あなたはだぁれ？」","translation":"나는 너 너는 누구니","kind":"lyric"},{"id":"61","start":297.675312,"end":301.729312,"text":"人形遊び ツマラナイ","translation":"인형 놀이는 재미없어","kind":"lyric"},{"id":"62","start":301.789312,"end":305.162312,"text":"「私は私 あなたはだぁれ？」","translation":"나는 나 너는 누구니","kind":"lyric"},{"id":"63","start":305.222312,"end":309.402312,"text":"月夜に輝く ジャックランタン","translation":"달밤에 빛나는 잭오랜턴","kind":"lyric"},{"id":"64","start":309.462312,"end":312.715312,"text":"「私は私 あなたは邪魔」","translation":"나는 나 너는 방해돼","kind":"lyric"},{"id":"65","start":312.775312,"end":316.612312,"text":"お次のお相手は 誰かしら","translation":"다음 상대는 누구일까","kind":"lyric"},{"id":"66","start":316.672312,"end":321.425312,"text":"「踊りましょう？」","translation":"함께 춤출래","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}