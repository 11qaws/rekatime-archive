{"title":"귀신의 우스갯소리","artist":"피노키오","sourceId":"reference:vZ0yVJQ7lAlvzKj3u2vk","sourceHash":"bed7c0e5d37cc7b83b4b756881ee575d440d1141b94e3ea829d8a5ae320fe2e9","performanceStatus":"no_performance_record","timingMethod":"reference_lyric_character_matching","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":20.14,"end":23.16,"text":"それ 本気でやってんの","translation":"","kind":"lyric"},{"id":"2","start":20.14,"end":23.16,"text":"ねぇ おばけを舐めてんの","translation":"","kind":"lyric"},{"id":"3","start":23.16,"end":26.55,"text":"また 枕元立ってんの","translation":"","kind":"lyric"},{"id":"4","start":23.16,"end":26.55,"text":"もう 何回やってんの","translation":"","kind":"lyric"},{"id":"5","start":26.55,"end":28.19,"text":"「ほら、怖がれ」という態度","translation":"","kind":"lyric"},{"id":"6","start":28.19,"end":29.82,"text":"「怖がって欲しい」という展望","translation":"","kind":"lyric"},{"id":"7","start":29.82,"end":31.76,"text":"あなたはどっちかな 知らん","translation":"","kind":"lyric"},{"id":"8","start":31.76,"end":33.37,"text":"神はおっしゃる どっちでもいい","translation":"","kind":"lyric"},{"id":"9","start":33.37,"end":34.95,"text":"心霊写真は ウケねらい","translation":"","kind":"lyric"},{"id":"10","start":34.95,"end":36.46,"text":"誰でもわかる ウケねらい","translation":"","kind":"lyric"},{"id":"11","start":36.46,"end":38.1,"text":"渋い呪いも ウケねらい","translation":"","kind":"lyric"},{"id":"12","start":38.1,"end":39.87,"text":"玄人に向けた ウケねらい","translation":"","kind":"lyric"},{"id":"13","start":39.87,"end":41.53,"text":"てっとりばやく 恐怖与えたい","translation":"","kind":"lyric"},{"id":"14","start":41.53,"end":43.1,"text":"日進月歩 恐怖磨きたい","translation":"","kind":"lyric"},{"id":"15","start":43.1,"end":44.67,"text":"よそはよそ うちはうち","translation":"","kind":"lyric"},{"id":"16","start":44.67,"end":46.35,"text":"鬼は外から 福は内","translation":"","kind":"lyric"},{"id":"17","start":46.35,"end":49.62,"text":"自分がない 自分がないから 浮かばれない","translation":"","kind":"lyric"},{"id":"18","start":49.62,"end":52.8,"text":"持論がある 持論があるから 報われたい","translation":"","kind":"lyric"},{"id":"19","start":52.8,"end":58.91,"text":"流行りに乗ってるけど 好きでやってんの ねえ","translation":"","kind":"lyric"},{"id":"20","start":55.95,"end":58.91,"text":"それとも 魂売って 自分殺してんの","translation":"","kind":"lyric"},{"id":"21","start":58.91,"end":62.17,"text":"ひゅ～どろろ ひゅ～どろろ","translation":"","kind":"lyric"},{"id":"22","start":62.17,"end":65.21,"text":"滑ってるのに みんなは称賛","translation":"","kind":"lyric"},{"id":"23","start":65.21,"end":68.76,"text":"日々労働を のち法要を","translation":"","kind":"lyric"},{"id":"24","start":68.76,"end":84.98,"text":"続けます 私の好きな ウケねらいを","translation":"","kind":"lyric"},{"id":"25","start":84.98,"end":88.19,"text":"じんわり火が灯る ローソク吹き消し","translation":"","kind":"lyric"},{"id":"26","start":88.19,"end":91.57,"text":"大音量のラップ音で すべてが台無し","translation":"","kind":"lyric"},{"id":"27","start":91.57,"end":93.0,"text":"ありがち? いや スタンダード","translation":"","kind":"lyric"},{"id":"28","start":93.0,"end":94.63,"text":"斬新? いや 出オチ","translation":"","kind":"lyric"},{"id":"29","start":94.63,"end":97.91,"text":"心霊スポットのレビュー 怨念の考察","translation":"","kind":"lyric"},{"id":"30","start":97.91,"end":99.61,"text":"その方法は 受け入れない","translation":"","kind":"lyric"},{"id":"31","start":99.61,"end":101.47999999999999,"text":"胡散臭いから 受け入れない","translation":"","kind":"lyric"},{"id":"32","start":101.47999999999999,"end":103.0,"text":"その発想は 受け入れたい","translation":"","kind":"lyric"},{"id":"33","start":103.0,"end":104.65,"text":"不器用だけど 受け入れたい","translation":"","kind":"lyric"},{"id":"34","start":104.65,"end":106.35,"text":"効率よく テキトーに化けたい","translation":"","kind":"lyric"},{"id":"35","start":106.35,"end":107.95,"text":"損するけど ディテール詰めたい","translation":"","kind":"lyric"},{"id":"36","start":107.95,"end":109.55,"text":"よそはよそ うちはうち","translation":"","kind":"lyric"},{"id":"37","start":109.55,"end":111.28,"text":"大体が 絵に描いた餅","translation":"","kind":"lyric"},{"id":"38","start":111.28,"end":114.32,"text":"事件がない 事件がないから リアルじゃない","translation":"","kind":"lyric"},{"id":"39","start":114.32,"end":117.62,"text":"危険がある 危険があるから みんなは期待","translation":"","kind":"lyric"},{"id":"40","start":117.62,"end":123.78,"text":"悪霊のイッてる感じ わざと出してんの ねえ","translation":"","kind":"lyric"},{"id":"41","start":120.63,"end":123.78,"text":"それとも根っから 天才でぶっとんでんの","translation":"","kind":"lyric"},{"id":"42","start":123.78,"end":127.13,"text":"ひゅ～どろろ ひゅ～どろろ","translation":"","kind":"lyric"},{"id":"43","start":127.13,"end":130.2,"text":"嗤ってたのに あえなく降参","translation":"","kind":"lyric"},{"id":"44","start":130.2,"end":133.62,"text":"意気揚々と 死後 ひょうひょうと","translation":"","kind":"lyric"},{"id":"45","start":133.62,"end":150.03,"text":"わかってるのに やめられぬ ウケねらいよ","translation":"","kind":"lyric"},{"id":"46","start":150.03,"end":153.38,"text":"生前から引いてばっかりの はずれくじ (はずれくじ)","translation":"","kind":"lyric"},{"id":"47","start":153.38,"end":156.57,"text":"好きだったおばけはどっか行って 神隠し (神隠し)","translation":"","kind":"lyric"},{"id":"48","start":156.57,"end":158.95,"text":"やったもん勝ちの許せるラインが ぼやけだし","translation":"","kind":"lyric"},{"id":"49","start":158.95,"end":163.03,"text":"大嫌いなオカルトをみんなが好きでも そういうもんだし","translation":"","kind":"lyric"},{"id":"50","start":163.03,"end":166.27,"text":"自分がない 自分がないから 浮かばれない","translation":"","kind":"lyric"},{"id":"51","start":166.27,"end":169.46,"text":"持論がある 持論があるから 報われたい","translation":"","kind":"lyric"},{"id":"52","start":169.46,"end":176.93,"text":"流行りに乗ってるけど 好きでやってんの ねえ","translation":"","kind":"lyric"},{"id":"53","start":172.75,"end":176.93,"text":"それとも 魂売って 自分殺してんの","translation":"","kind":"lyric"},{"id":"54","start":176.93,"end":180.55,"text":"ひゅ～どろろ ひゅ～どろろ","translation":"","kind":"lyric"},{"id":"55","start":180.55,"end":183.54,"text":"滑ってるのに みんなは称賛","translation":"","kind":"lyric"},{"id":"56","start":183.54,"end":186.9,"text":"ひゅ～どろろ ひゅ～どろろ","translation":"","kind":"lyric"},{"id":"57","start":186.9,"end":190.06,"text":"嗤ってたのに あえなく降参","translation":"","kind":"lyric"},{"id":"58","start":190.06,"end":193.47,"text":"ひゅ～どろろ ひゅ～どろろ","translation":"","kind":"lyric"},{"id":"59","start":193.47,"end":196.61,"text":"日々労働を のち法要を","translation":"","kind":"lyric"},{"id":"60","start":196.61,"end":200.18,"text":"意気揚々と 死後 ひょうひょうと","translation":"","kind":"lyric"},{"id":"61","start":200.18,"end":222.35,"text":"続けます私の好きなウケねらいを","translation":"","kind":"lyric"},{"id":"62","start":222.35,"end":225.11,"text":"ばぁ～～","translation":"","kind":"lyric"}],"candidates":[]}