{"title":"HAMELN","artist":"하츠키 유라","sourceId":"reference:ppfawuu3KRf4KoUnC7R5","sourceHash":"738af8d191a2842230bd9ed37f2da99e4317e2c8aafff30d0a705a5ac801c3be","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":null,"cues":[{"id":"1","start":7.71,"end":11.06,"text":"軽やかに響く笛が","translation":"","kind":"lyric"},{"id":"2","start":11.06,"end":14.92,"text":"窓の外の闇に浮かぶ","translation":"","kind":"lyric"},{"id":"3","start":14.92,"end":18.82,"text":"どうか連れ去って行って","translation":"","kind":"lyric"},{"id":"4","start":18.82,"end":22.32,"text":"冥府への道でも構わない","translation":"","kind":"lyric"},{"id":"5","start":22.32,"end":25.93,"text":"冷たいこの部屋の中","translation":"","kind":"lyric"},{"id":"6","start":25.93,"end":29.68,"text":"拭えない孤毒　死が香りだす","translation":"","kind":"lyric"},{"id":"7","start":29.68,"end":33.09,"text":"二つ目の星は語る","translation":"","kind":"lyric"},{"id":"8","start":33.09,"end":40.66,"text":"「光望めば目が眩む…」","translation":"","kind":"lyric"},{"id":"9","start":40.66,"end":44.22,"text":"ハーメルンが奏でる魅惑の音色が","translation":"","kind":"lyric"},{"id":"10","start":44.22,"end":48.06,"text":"私の理性を乱し快楽へ誘う","translation":"","kind":"lyric"},{"id":"11","start":48.06,"end":51.63,"text":"刻まれた爪痕に歪んだとしても","translation":"","kind":"lyric"},{"id":"12","start":51.63,"end":83.26,"text":"恍惚の中で愚かな生贄となる","translation":"","kind":"lyric"},{"id":"13","start":83.26,"end":86.87,"text":"薔薇のアーチを抜けたら","translation":"","kind":"lyric"},{"id":"14","start":86.87,"end":90.62,"text":"小高い丘　灯る炎","translation":"","kind":"lyric"},{"id":"15","start":90.62,"end":94.12,"text":"傷ついた足に触れて","translation":"","kind":"lyric"},{"id":"16","start":94.12,"end":98.03,"text":"口付けた場所から溢れる火","translation":"","kind":"lyric"},{"id":"17","start":98.03,"end":101.63,"text":"遠のく意識の中","translation":"","kind":"lyric"},{"id":"18","start":101.63,"end":105.43,"text":"拭えない熱に　支配されて行く","translation":"","kind":"lyric"},{"id":"19","start":105.43,"end":108.6,"text":"双子の月は語る","translation":"","kind":"lyric"},{"id":"20","start":108.6,"end":116.21000000000001,"text":"「諍えぬ魔はそばにある…」","translation":"","kind":"lyric"},{"id":"21","start":116.21000000000001,"end":119.92,"text":"ハーメルンが奏でる哀婉の音色が","translation":"","kind":"lyric"},{"id":"22","start":119.92,"end":123.72,"text":"優しい不安を纏い　闇を漂う","translation":"","kind":"lyric"},{"id":"23","start":123.72,"end":127.33,"text":"切り裂かれた肌から零れる雫を","translation":"","kind":"lyric"},{"id":"24","start":127.33,"end":146.19,"text":"金色の瞳　絡む指　悪魔が踊る","translation":"","kind":"lyric"},{"id":"25","start":146.19,"end":149.34,"text":"冷たいこの夜の中","translation":"","kind":"lyric"},{"id":"26","start":149.34,"end":153.36,"text":"拭えない孤毒　死が溢れ出す","translation":"","kind":"lyric"},{"id":"27","start":153.36,"end":156.76,"text":"囁いた貴方の声","translation":"","kind":"lyric"},{"id":"28","start":156.76,"end":164.32999999999998,"text":"「光望めば闇を呼ぶ…」","translation":"","kind":"lyric"},{"id":"29","start":164.32999999999998,"end":167.93,"text":"ハーメルンが奏でる魅惑の音色が","translation":"","kind":"lyric"},{"id":"30","start":167.93,"end":171.78,"text":"私の理性を乱し熱を与える","translation":"","kind":"lyric"},{"id":"31","start":171.78,"end":175.32999999999998,"text":"刻まれた刻印が痛んだとしても","translation":"","kind":"lyric"},{"id":"32","start":175.32999999999998,"end":179.18,"text":"恍惚の中で愚かな生贄となる","translation":"","kind":"lyric"},{"id":"33","start":179.18,"end":182.48,"text":"ハーメルンが奏でる哀婉の音色が","translation":"","kind":"lyric"},{"id":"34","start":182.48,"end":186.58,"text":"優しい不安を纏い　闇を漂う","translation":"","kind":"lyric"},{"id":"35","start":186.58,"end":190.04,"text":"咲いた薔薇　ベルベットの声を捧げて","translation":"","kind":"lyric"},{"id":"36","start":190.04,"end":213.5013125,"text":"金色の瞳　跳ねる指　私は踊る","translation":"","kind":"lyric"}],"candidates":[]}