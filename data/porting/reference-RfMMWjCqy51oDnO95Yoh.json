{"title":"Magia","artist":"Kalafina","sourceId":"reference:RfMMWjCqy51oDnO95Yoh","sourceHash":"7d41db684c214d27f0fd4cb62ef1f18a35305d0e1f16f370d7a0d58f79299684","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":34890176,"cues":[{"id":"1","start":18.36,"end":23.9,"text":"いつか君が瞳に灯す愛の光が","translation":"","kind":"lyric"},{"id":"2","start":23.9,"end":26.07,"text":"時を超えて","translation":"","kind":"lyric"},{"id":"3","start":26.07,"end":30.03,"text":"滅び急ぐ世界の夢を","translation":"","kind":"lyric"},{"id":"4","start":30.03,"end":33.76,"text":"確かに一つ壊すだろう","translation":"","kind":"lyric"},{"id":"5","start":33.76,"end":36.56,"text":"躊躇いを飲み干して","translation":"","kind":"lyric"},{"id":"6","start":36.56,"end":40.22,"text":"君が望むモノは何?","translation":"","kind":"lyric"},{"id":"7","start":40.22,"end":45.39,"text":"こんな欲深い憧れの行方に","translation":"","kind":"lyric"},{"id":"8","start":45.39,"end":51.13,"text":"儚い明日はあるの?","translation":"","kind":"lyric"},{"id":"9","start":51.13,"end":54.82,"text":"子供の頃夢に見てた","translation":"","kind":"lyric"},{"id":"10","start":54.82,"end":58.57,"text":"古の魔法のように","translation":"","kind":"lyric"},{"id":"11","start":58.57,"end":62.42,"text":"闇さえ砕く力で","translation":"","kind":"lyric"},{"id":"12","start":62.42,"end":66.34,"text":"微笑む君に会いたい","translation":"","kind":"lyric"},{"id":"13","start":66.34,"end":70.25,"text":"怯えるこの手の中には","translation":"","kind":"lyric"},{"id":"14","start":70.25,"end":74.03,"text":"手折られた花の勇気","translation":"","kind":"lyric"},{"id":"15","start":74.03,"end":77.89,"text":"想いだけが頼る全て","translation":"","kind":"lyric"},{"id":"16","start":77.89,"end":81.69,"text":"光を呼び覚ます","translation":"","kind":"lyric"},{"id":"17","start":81.69,"end":85.58,"text":"願い","translation":"","kind":"lyric"},{"id":"18","start":91.39,"end":95.36,"text":"いつか君も誰かの為に","translation":"","kind":"lyric"},{"id":"19","start":95.36,"end":98.96000000000001,"text":"強い力を望むのだろう","translation":"","kind":"lyric"},{"id":"20","start":98.96000000000001,"end":103.13,"text":"愛が胸を捉えた夜に","translation":"","kind":"lyric"},{"id":"21","start":103.13,"end":106.64,"text":"未知の言葉が生まれて来る","translation":"","kind":"lyric"},{"id":"22","start":106.64,"end":109.44,"text":"迷わずに行けるなら","translation":"","kind":"lyric"},{"id":"23","start":109.44,"end":113.02000000000001,"text":"心が砕けてもいいわ","translation":"","kind":"lyric"},{"id":"24","start":113.02000000000001,"end":117.27000000000001,"text":"いつも目の前の哀しみに","translation":"","kind":"lyric"},{"id":"25","start":117.27000000000001,"end":119.97999999999999,"text":"立ち向かう為の","translation":"","kind":"lyric"},{"id":"26","start":119.97999999999999,"end":123.9,"text":"呪文が欲しい","translation":"","kind":"lyric"},{"id":"27","start":123.9,"end":127.74,"text":"君はまだ夢見る記憶","translation":"","kind":"lyric"},{"id":"28","start":127.74,"end":131.6,"text":"私は眠らない明日","translation":"","kind":"lyric"},{"id":"29","start":131.6,"end":135.57,"text":"二人が出会う奇跡を","translation":"","kind":"lyric"},{"id":"30","start":135.57,"end":139.36,"text":"勝ち取る為に進むわ","translation":"","kind":"lyric"},{"id":"31","start":139.36,"end":143.17000000000002,"text":"怯えるこの手の中には","translation":"","kind":"lyric"},{"id":"32","start":143.17000000000002,"end":147.07,"text":"手折られた花の刃","translation":"","kind":"lyric"},{"id":"33","start":147.07,"end":150.82999999999998,"text":"想いだけが生きる全て","translation":"","kind":"lyric"},{"id":"34","start":150.82999999999998,"end":154.71,"text":"心に振りかざす","translation":"","kind":"lyric"},{"id":"35","start":154.71,"end":158.1,"text":"願い","translation":"","kind":"lyric"},{"id":"36","start":215.82999999999998,"end":221.32,"text":"囚われた太陽の輝く","translation":"","kind":"lyric"},{"id":"37","start":223.6,"end":231.12,"text":"不思議の国の本が好きだった頃","translation":"","kind":"lyric"},{"id":"38","start":231.12,"end":235.13,"text":"願いはきっと叶うと","translation":"","kind":"lyric"},{"id":"39","start":235.13,"end":237.84,"text":"教えるお伽噺を","translation":"","kind":"lyric"},{"id":"40","start":237.84,"end":246.46,"text":"信じた (光と影の中)","translation":"","kind":"lyric"},{"id":"41","start":254.34,"end":258.41,"text":"静かに咲き乱れていた","translation":"","kind":"lyric"},{"id":"42","start":258.41,"end":261.86,"text":"古の魔法優しく","translation":"","kind":"lyric"},{"id":"43","start":261.86,"end":266.09,"text":"世界を変える力が","translation":"","kind":"lyric"},{"id":"44","start":266.09,"end":269.76,"text":"その手にあると囁く","translation":"","kind":"lyric"},{"id":"45","start":269.76,"end":273.59000000000003,"text":"終わらない夢を見よう","translation":"","kind":"lyric"},{"id":"46","start":273.59000000000003,"end":277.57,"text":"君と行く時の中で","translation":"","kind":"lyric"},{"id":"47","start":277.57,"end":281.45,"text":"想いだけが生きる全て","translation":"","kind":"lyric"},{"id":"48","start":281.45,"end":285.28,"text":"命を作るのは","translation":"","kind":"lyric"},{"id":"49","start":285.28,"end":289.25,"text":"願い","translation":"","kind":"lyric"}],"candidates":[]}