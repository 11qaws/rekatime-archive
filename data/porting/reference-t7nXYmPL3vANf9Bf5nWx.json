{"title":"단죄 야마자나두!","artist":"IOSYS","sourceId":"reference:t7nXYmPL3vANf9Bf5nWx","sourceHash":"94b2e939fe67d21200e5208c9007760ef816ccb9dfe86b14ee0ea482c9e10bcb","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":35201849,"cues":[{"id":"1","start":2.06,"end":7.77,"text":"犯罪都市... 幻想郷... 堕落し荒廃した正義を真の姿に戻せるのは","translation":"","kind":"lyric"},{"id":"2","start":7.77,"end":11.27,"text":"法の番人である私しかいないのだわ！","translation":"","kind":"lyric"},{"id":"3","start":11.27,"end":13.84,"text":"開廷 罪状を突きつけて","translation":"","kind":"lyric"},{"id":"4","start":13.84,"end":16.67,"text":"推定 鑑定の結果暫定","translation":"","kind":"lyric"},{"id":"5","start":16.67,"end":19.57,"text":"前提 有罪とにかく有罪","translation":"","kind":"lyric"},{"id":"6","start":19.57,"end":22.56,"text":"白黒はっきりつけ断罪！","translation":"","kind":"lyric"},{"id":"7","start":44.08,"end":49.83,"text":"霊夢！貧乏紅白巫女 実は千客万来中","translation":"","kind":"lyric"},{"id":"8","start":49.83,"end":54.93,"text":"東方ブームは衰えずどこが貧乏だこの詐欺女！","translation":"","kind":"lyric"},{"id":"9","start":54.93,"end":60.68,"text":"萃香！酔っぱげロリータ幼女オニ 実は粘着ストーカー","translation":"","kind":"lyric"},{"id":"10","start":60.68,"end":66.16,"text":"1億年と2週間前からどこでもお前を見つめてる！","translation":"","kind":"lyric"},{"id":"11","start":66.16,"end":68.93,"text":"早苗！調子こいてる清純気取りのウブな巫女","translation":"","kind":"lyric"},{"id":"12","start":68.93,"end":71.57,"text":"実は残酷コジュウトメ","translation":"","kind":"lyric"},{"id":"13","start":71.57,"end":74.62,"text":"魔理沙！この盗っ人借りパク乗りパクパックパク！","translation":"","kind":"lyric"},{"id":"14","start":74.62,"end":76.77,"text":"あの子の心もパックパク","translation":"","kind":"lyric"},{"id":"15","start":76.77,"end":80.0,"text":"チルノ！バカバカバカバカバカバカバカバーカバカ！","translation":"","kind":"lyric"},{"id":"16","start":80.0,"end":82.47,"text":"地獄に行くにも値せず","translation":"","kind":"lyric"},{"id":"17","start":82.47,"end":84.93,"text":"フラン！そのうーうー言うのをやめなさい！","translation":"","kind":"lyric"},{"id":"18","start":84.93,"end":88.06,"text":"やめなさい！やめなさい！やめないと殺すわよ！キーッ！","translation":"","kind":"lyric"},{"id":"19","start":88.06,"end":93.36,"text":"断罪！断罪！断罪！断罪！","translation":"","kind":"lyric"},{"id":"20","start":93.36,"end":97.00999999999999,"text":"判決！懲役3時のオヤツ禁止3年！","translation":"","kind":"lyric"},{"id":"21","start":97.00999999999999,"end":99.28999999999999,"text":"ただし バナナとキノコはオヤツに含まれない！","translation":"","kind":"lyric"},{"id":"22","start":99.28999999999999,"end":104.63,"text":"ハッキリさせる白と黒 罪と罰","translation":"","kind":"lyric"},{"id":"23","start":104.63,"end":110.32,"text":"灰色なんてあり得ないの","translation":"","kind":"lyric"},{"id":"24","start":110.32,"end":115.47,"text":"いい加減 曖昧は大嫌い","translation":"","kind":"lyric"},{"id":"25","start":115.47,"end":120.82,"text":"和解なんてさせないわよ","translation":"","kind":"lyric"},{"id":"26","start":120.82,"end":126.73,"text":"幽々子！悲劇の亡霊少女 実はバキューム大食らい","translation":"","kind":"lyric"},{"id":"27","start":126.73,"end":131.85,"text":"カレーは飲み物なんかじゃないから霞でも食べて自重なさい","translation":"","kind":"lyric"},{"id":"28","start":131.85,"end":137.63,"text":"紫！スキマに漂う犯罪臭 怪しい裏金贈収賄","translation":"","kind":"lyric"},{"id":"29","start":137.63,"end":142.8,"text":"神隠し金隠しは遊びのレベルでやめておけ","translation":"","kind":"lyric"},{"id":"30","start":142.8,"end":145.8,"text":"お空！メルトダウンただ漏れフュージョン危険物","translation":"","kind":"lyric"},{"id":"31","start":145.8,"end":148.29,"text":"被害は甚大無限大","translation":"","kind":"lyric"},{"id":"32","start":148.29,"end":151.36,"text":"小町！お前は部下だ 部下だろその上に","translation":"","kind":"lyric"},{"id":"33","start":151.36,"end":154.06,"text":"乳デカいくせに仕事サボってんじゃねええええええ！","translation":"","kind":"lyric"},{"id":"34","start":154.06,"end":159.23,"text":"中国！えーりん！慧音！藍！","translation":"","kind":"lyric"},{"id":"35","start":159.23,"end":164.74,"text":"神奈子！勇儀！レティ！幽香！","translation":"","kind":"lyric"},{"id":"36","start":164.74,"end":170.24,"text":"断罪！断罪！断罪！断罪！","translation":"","kind":"lyric"},{"id":"37","start":170.24,"end":174.22,"text":"判決！懲役その胸よこせ300グラムずつ！","translation":"","kind":"lyric"},{"id":"38","start":174.22,"end":175.97,"text":"お前らそんだけあるんだからちょっとくらいいいだろー！","translation":"","kind":"lyric"},{"id":"39","start":175.97,"end":181.38,"text":"強制捜査 取調べ強引に","translation":"","kind":"lyric"},{"id":"40","start":181.38,"end":187.2,"text":"証拠なんて後でいいの","translation":"","kind":"lyric"},{"id":"41","start":187.2,"end":192.34,"text":"ストレスのはけ口は裁判で","translation":"","kind":"lyric"},{"id":"42","start":192.34,"end":196.53,"text":"逆転なんてさせないわよ","translation":"","kind":"lyric"},{"id":"43","start":214.3,"end":220.37,"text":"絶対断罪アルマゲドン！ 私の判決に異議なんて認めないわー","translation":"","kind":"lyric"}],"candidates":[]}