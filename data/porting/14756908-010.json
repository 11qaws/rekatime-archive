{"title":"Speechless","artist":"Naomi Scott","date":"2026-08-18","sourceId":"14756908:010","sourceHash":"b660e29d9f19f104588d59ce09d98e46a4cfaa9d1cd411abe9072e135ccc4ac6","duration":126.41,"cues":[{"id":"1","start":14.16,"end":14.88,"text":"Here comes a wave","translation":"파도가 밀려와","kind":"lyric"},{"id":"2","start":14.92,"end":16.77,"text":"Meant to wash me away","translation":"날 쓸어 가려 해","kind":"lyric"},{"id":"3","start":17.76,"end":19.81,"text":"A tide that is taking me under","translation":"날 삼켜 버릴 거센 물결","kind":"lyric"},{"id":"4","start":20.94,"end":22.09,"text":"Swallowing sand","translation":"모래를 삼키고","kind":"lyric"},{"id":"5","start":22.85,"end":24.7,"text":"Left with nothing to say","translation":"아무 말도 못 한 채","kind":"lyric"},{"id":"6","start":24.74,"end":28.12,"text":"My voice drowned out in the thunder","translation":"천둥에 내 목소린 잠겨","kind":"lyric"},{"id":"7","start":28.16,"end":31.54,"text":"But I won't cry","translation":"하지만 난 울지 않아","kind":"lyric"},{"id":"8","start":32.92,"end":35.99,"text":"And I won't start to crumble","translation":"그리고 무너지지 않아","kind":"lyric"},{"id":"9","start":36.14,"end":39.12,"text":"Whenever they try","translation":"그들이 언제나","kind":"lyric"},{"id":"10","start":39.16,"end":43.67,"text":"To shut me or cut me down","translation":"날 막고 꺾으려 해도","kind":"lyric"},{"id":"11","start":44.81,"end":46.12,"text":"I won't be silenced","translation":"난 침묵하지 않아","kind":"lyric"},{"id":"12","start":47.23,"end":50.9,"text":"You can't keep me quiet","translation":"날 잠재울 수 없어","kind":"lyric"},{"id":"13","start":52.58,"end":55.33,"text":"Won't tremble when you try it","translation":"네가 해 봐도 떨지 않아","kind":"lyric"},{"id":"14","start":55.37,"end":58.84,"text":"All I know is I won't go speechless","translation":"내가 아는 건 난 침묵하지 않는단 것","kind":"lyric"},{"id":"15","start":61.19,"end":63.448,"text":"'Cause I'll breathe","translation":"난 숨을 쉴 테니","kind":"lyric"},{"id":"16","start":64.21,"end":64.97,"text":"When they try to suffocate me","translation":"날 질식시키려 해도","kind":"lyric"},{"id":"17","start":67.15,"end":70.58,"text":"Don't you underestimate me","translation":"나를 얕보지 마","kind":"lyric"},{"id":"18","start":70.66,"end":74.16,"text":"'Cause I know that I won't go speechless","translation":"난 침묵하지 않을 걸 아니까","kind":"lyric"},{"id":"19","start":76.2,"end":77.77,"text":"Written in stone","translation":"돌에 새겨진","kind":"lyric"},{"id":"20","start":79.95,"end":80.9,"text":"Every rule, every word","translation":"모든 규칙 모든 말","kind":"lyric"},{"id":"21","start":80.94,"end":84.16,"text":"Centuries old and unbending","translation":"수백 년 묵어 굽히지 않아","kind":"lyric"},{"id":"22","start":84.2,"end":86.5,"text":"Stay in your place","translation":"네 자릴 지켜","kind":"lyric"},{"id":"23","start":87.49,"end":88.43,"text":"Better seen and not heard","translation":"보이되 말은 하지 마","kind":"lyric"},{"id":"24","start":88.47,"end":91.29,"text":"But now that story is ending","translation":"하지만 이제 그 이야긴 끝나","kind":"lyric"},{"id":"25","start":91.33,"end":93.8,"text":"'Cause I","translation":"왜냐면 난","kind":"lyric"},{"id":"26","start":93.93,"end":97.2,"text":"I cannot start to crumble","translation":"난 무너지지 않아","kind":"lyric"},{"id":"27","start":99.4,"end":100.74,"text":"So come on and try","translation":"그러니 어디 해 봐","kind":"lyric"},{"id":"28","start":101.03,"end":104.69,"text":"Try to shut me and cut me down","translation":"날 막고 꺾어 보려 해","kind":"lyric"},{"id":"29","start":106.51,"end":109.533,"text":"I won't be silenced","translation":"난 침묵하지 않아","kind":"lyric"},{"id":"30","start":109.88,"end":112.2,"text":"You can't keep me quiet","translation":"날 잠재울 수 없어","kind":"lyric"},{"id":"31","start":112.67,"end":116.05,"text":"Won't tremble when you try it","translation":"네가 해 봐도 떨지 않아","kind":"lyric"},{"id":"32","start":116.09,"end":120.17,"text":"All I know is I won't go speechless","translation":"내가 아는 건 난 침묵하지 않는단 것","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}