{"title":"이 실없이 멋진 세계는 날 위해 있어","artist":"n.k","sourceId":"reference:Liq3fMoy7EC6PXmT0G3G","sourceHash":"f26e29c73d444a9090b05af552db0ac489e1c4a9e201b6c8fc2108a2cfad94fa","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":37692487,"cues":[{"id":"1","start":0.88,"end":4.09,"text":"このふざけた素晴らしき世界","translation":"","kind":"lyric"},{"id":"2","start":4.09,"end":7.21,"text":"君に会う為に生きる","translation":"","kind":"lyric"},{"id":"3","start":7.21,"end":10.41,"text":"今宵は夜が明けるまで咲かそう","translation":"","kind":"lyric"},{"id":"4","start":10.41,"end":13.43,"text":"ぐるぐる目を回して","translation":"","kind":"lyric"},{"id":"5","start":13.43,"end":16.43,"text":"このくそったれで美しい世界","translation":"","kind":"lyric"},{"id":"6","start":16.43,"end":19.91,"text":"真っ直ぐ見て突き進め","translation":"","kind":"lyric"},{"id":"7","start":19.91,"end":22.99,"text":"踊れや踊れアホになりましょう","translation":"","kind":"lyric"},{"id":"8","start":22.99,"end":25.37,"text":"みんな叫べヤンヤイ","translation":"","kind":"lyric"},{"id":"9","start":25.37,"end":29.47,"text":"もう、ダメになりそ はいｯ","translation":"","kind":"lyric"},{"id":"10","start":29.47,"end":45.54,"text":"ヤンヤヤンヤヤイヤ","translation":"","kind":"lyric"},{"id":"11","start":45.54,"end":48.81,"text":"嘘つき男の虚言癖","translation":"","kind":"lyric"},{"id":"12","start":48.81,"end":52.08,"text":"世の中ではそれも正義？","translation":"","kind":"lyric"},{"id":"13","start":52.08,"end":55.01,"text":"あれよあれよと今日も終わる","translation":"","kind":"lyric"},{"id":"14","start":55.01,"end":57.72,"text":"昼はなに食べたっけ...","translation":"","kind":"lyric"},{"id":"15","start":57.72,"end":64.55,"text":"犬も猫も木に登る","translation":"","kind":"lyric"},{"id":"16","start":64.55,"end":68.34,"text":"あくせくしたって何も","translation":"","kind":"lyric"},{"id":"17","start":68.34,"end":72.01,"text":"始まりはしやせんぜ","translation":"","kind":"lyric"},{"id":"18","start":72.01,"end":75.26,"text":"このふざけた素晴らしき世界","translation":"","kind":"lyric"},{"id":"19","start":75.26,"end":78.28999999999999,"text":"僕は家に引き篭もる","translation":"","kind":"lyric"},{"id":"20","start":78.28999999999999,"end":81.53,"text":"ガンガン飛ばすデジタル地球","translation":"","kind":"lyric"},{"id":"21","start":81.53,"end":84.16,"text":"わくわく未来はそこ","translation":"","kind":"lyric"},{"id":"22","start":84.16,"end":87.65,"text":"このくそったれで美しい世界","translation":"","kind":"lyric"},{"id":"23","start":87.65,"end":90.89,"text":"愉快にはしゃぐだけです","translation":"","kind":"lyric"},{"id":"24","start":90.89,"end":93.92,"text":"二人が出会う事が運命？","translation":"","kind":"lyric"},{"id":"25","start":93.92,"end":97.57,"text":"それなら悪くないね","translation":"","kind":"lyric"},{"id":"26","start":97.57,"end":110.67,"text":"ヤンヤヤンヤヤイヤ","translation":"","kind":"lyric"},{"id":"27","start":110.67,"end":111.55,"text":"ハイ⇈","translation":"","kind":"lyric"},{"id":"28","start":111.55,"end":113.97,"text":"病み女の妄想癖","translation":"","kind":"lyric"},{"id":"29","start":113.97,"end":116.9,"text":"世の中ではまだイケるかも？","translation":"","kind":"lyric"},{"id":"30","start":116.9,"end":119.87,"text":"そんなことばかり考えて","translation":"","kind":"lyric"},{"id":"31","start":119.87,"end":123.03,"text":"あぁ、遅刻しそう","translation":"","kind":"lyric"},{"id":"32","start":123.03,"end":129.5,"text":"じじばばも熱を上げる","translation":"","kind":"lyric"},{"id":"33","start":129.5,"end":131.28,"text":"働けど働けど","translation":"","kind":"lyric"},{"id":"34","start":131.28,"end":136.46,"text":"ホントにこれで良いの？","translation":"","kind":"lyric"},{"id":"35","start":136.46,"end":139.82999999999998,"text":"このふざけた素晴らしき世界","translation":"","kind":"lyric"},{"id":"36","start":139.82999999999998,"end":143.0,"text":"腐ったりんごにもなる","translation":"","kind":"lyric"},{"id":"37","start":143.0,"end":146.26,"text":"そんなに悲観することもないか","translation":"","kind":"lyric"},{"id":"38","start":146.26,"end":149.22,"text":"そこそこに生きてるし","translation":"","kind":"lyric"},{"id":"39","start":149.22,"end":152.48,"text":"このくそったれで美しい世界","translation":"","kind":"lyric"},{"id":"40","start":152.48,"end":155.62,"text":"友達ってどう作るの？","translation":"","kind":"lyric"},{"id":"41","start":155.62,"end":158.86,"text":"君がいれば問題ないか","translation":"","kind":"lyric"},{"id":"42","start":158.86,"end":173.19,"text":"...君って何処にいるの？","translation":"","kind":"lyric"},{"id":"43","start":173.19,"end":177.29,"text":"もうひっちゃかめっちゃか人混みにまみれて","translation":"","kind":"lyric"},{"id":"44","start":177.29,"end":180.18,"text":"流されてるだけに気づかないままで","translation":"","kind":"lyric"},{"id":"45","start":180.18,"end":186.11,"text":"不完全で完全な 人間（ヒト）ってそうでしょうよ","translation":"","kind":"lyric"},{"id":"46","start":186.11,"end":189.13,"text":"ほらこんなにこんなに息を切らしてるよ","translation":"","kind":"lyric"},{"id":"47","start":189.13,"end":192.91,"text":"でもセーブもロードも全く見当たらず","translation":"","kind":"lyric"},{"id":"48","start":192.91,"end":201.22,"text":"これが僕の油断で魅惑な人生さ","translation":"","kind":"lyric"},{"id":"49","start":201.22,"end":205.39,"text":"このふざけた素晴らしき世界","translation":"","kind":"lyric"},{"id":"50","start":205.39,"end":208.5,"text":"君に会うために生きる","translation":"","kind":"lyric"},{"id":"51","start":208.5,"end":211.86,"text":"今宵は夜が明けるまで咲かそう","translation":"","kind":"lyric"},{"id":"52","start":211.86,"end":213.66,"text":"ぐるぐる目を回して","translation":"","kind":"lyric"},{"id":"53","start":213.66,"end":217.16,"text":"このくそったれで美しい世界","translation":"","kind":"lyric"},{"id":"54","start":217.16,"end":220.65,"text":"愉快にはしゃぐだけです","translation":"","kind":"lyric"},{"id":"55","start":220.65,"end":223.89,"text":"他人に言うべきことじゃないが","translation":"","kind":"lyric"},{"id":"56","start":223.89,"end":226.53,"text":"お前ら愛してるぜ","translation":"","kind":"lyric"},{"id":"57","start":226.53,"end":249.03,"text":"ヤンヤヤンヤヤイヤ","translation":"","kind":"lyric"},{"id":"58","start":249.03,"end":262.13,"text":"HIGH！","translation":"","kind":"lyric"}],"candidates":[]}