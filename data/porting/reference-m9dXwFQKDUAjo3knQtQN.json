{"title":"Wellerman","artist":"Nathan Evans","sourceId":"reference:m9dXwFQKDUAjo3knQtQN","sourceHash":"021be221d6e1c728e78af210858f329eaccf8bcebca8b215d8bf87e479f663e2","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":2.56,"end":5.25,"text":"There once was a ship that put to sea","translation":"","kind":"lyric"},{"id":"2","start":5.25,"end":7.83,"text":"The name of the ship was the Billy of Tea","translation":"","kind":"lyric"},{"id":"3","start":7.83,"end":10.19,"text":"The winds blew up, her bow dipped down","translation":"","kind":"lyric"},{"id":"4","start":10.19,"end":12.84,"text":"O blow, my bully boys, blow (huh)","translation":"","kind":"lyric"},{"id":"5","start":12.84,"end":15.29,"text":"Soon may the Wellerman come","translation":"","kind":"lyric"},{"id":"6","start":15.29,"end":17.72,"text":"To bring us sugar and tea and rum","translation":"","kind":"lyric"},{"id":"7","start":17.72,"end":20.14,"text":"One day, when the tonguin' is done","translation":"","kind":"lyric"},{"id":"8","start":20.14,"end":22.78,"text":"We'll take our leave and go","translation":"","kind":"lyric"},{"id":"9","start":22.78,"end":25.25,"text":"She had not been two weeks from shore","translation":"","kind":"lyric"},{"id":"10","start":25.25,"end":27.83,"text":"When down on her, a right whale bore","translation":"","kind":"lyric"},{"id":"11","start":27.83,"end":30.33,"text":"The captain called all hands and swore","translation":"","kind":"lyric"},{"id":"12","start":30.33,"end":32.78,"text":"He'd take that whale in tow (huh)","translation":"","kind":"lyric"},{"id":"13","start":32.78,"end":35.35,"text":"Soon may the Wellerman come","translation":"","kind":"lyric"},{"id":"14","start":35.35,"end":37.75,"text":"To bring us sugar and tea and rum","translation":"","kind":"lyric"},{"id":"15","start":37.75,"end":40.28,"text":"One day, when the tonguin' is done","translation":"","kind":"lyric"},{"id":"16","start":40.28,"end":43.22,"text":"We'll take our leave and go","translation":"","kind":"lyric"},{"id":"17","start":43.22,"end":46.11,"text":"Da-da, da-da-da-da","translation":"","kind":"lyric"},{"id":"18","start":46.11,"end":48.41,"text":"Da-da-da-da, da-da-da-da-da","translation":"","kind":"lyric"},{"id":"19","start":48.41,"end":50.54,"text":"Da-da, da-da-da-da","translation":"","kind":"lyric"},{"id":"20","start":50.54,"end":52.76,"text":"Da-da-da-da-da-da","translation":"","kind":"lyric"},{"id":"21","start":52.76,"end":55.22,"text":"Before the boat had hit the water","translation":"","kind":"lyric"},{"id":"22","start":55.22,"end":57.82,"text":"The whale's tail came up and caught her","translation":"","kind":"lyric"},{"id":"23","start":57.82,"end":60.43,"text":"All hands to the side, harpooned and fought her","translation":"","kind":"lyric"},{"id":"24","start":60.43,"end":62.71,"text":"When she dived down low (huh)","translation":"","kind":"lyric"},{"id":"25","start":62.71,"end":65.27,"text":"Soon may the Wellerman come","translation":"","kind":"lyric"},{"id":"26","start":65.27,"end":67.83,"text":"To bring us sugar and tea and rum","translation":"","kind":"lyric"},{"id":"27","start":67.83,"end":70.03,"text":"One day, when the tonguin' is done","translation":"","kind":"lyric"},{"id":"28","start":70.03,"end":72.93,"text":"We'll take our leave and go","translation":"","kind":"lyric"},{"id":"29","start":72.93,"end":75.18,"text":"No line was cut, no whale was freed","translation":"","kind":"lyric"},{"id":"30","start":75.18,"end":77.75,"text":"The captain's mind was not on greed","translation":"","kind":"lyric"},{"id":"31","start":77.75,"end":80.09,"text":"And he belonged to the whaleman's creed","translation":"","kind":"lyric"},{"id":"32","start":80.09,"end":82.84,"text":"She took the ship in tow (huh)","translation":"","kind":"lyric"},{"id":"33","start":82.84,"end":85.28999999999999,"text":"Soon may the Wellerman come","translation":"","kind":"lyric"},{"id":"34","start":85.28999999999999,"end":87.77,"text":"To bring us sugar and tea and rum","translation":"","kind":"lyric"},{"id":"35","start":87.77,"end":90.08,"text":"One day, when the tonguin' is done","translation":"","kind":"lyric"},{"id":"36","start":90.08,"end":92.78,"text":"We'll take our leave and go","translation":"","kind":"lyric"},{"id":"37","start":92.78,"end":95.1,"text":"Da-da, da-da-da-da","translation":"","kind":"lyric"},{"id":"38","start":95.1,"end":97.83,"text":"Da-da-da-da, da-da-da-da-da","translation":"","kind":"lyric"},{"id":"39","start":97.83,"end":100.27000000000001,"text":"Da-da, da-da-da-da","translation":"","kind":"lyric"},{"id":"40","start":100.27000000000001,"end":102.75999999999999,"text":"Da-da-da-da-da-da","translation":"","kind":"lyric"},{"id":"41","start":102.75999999999999,"end":105.25999999999999,"text":"For 40 days, or even more","translation":"","kind":"lyric"},{"id":"42","start":105.25999999999999,"end":107.91,"text":"The line went slack, then tight once more","translation":"","kind":"lyric"},{"id":"43","start":107.91,"end":110.24000000000001,"text":"All boats were lost, there were only four","translation":"","kind":"lyric"},{"id":"44","start":110.24000000000001,"end":112.72,"text":"But still that whale did go (huh)","translation":"","kind":"lyric"},{"id":"45","start":112.72,"end":115.47,"text":"Soon may the Wellerman come","translation":"","kind":"lyric"},{"id":"46","start":115.47,"end":117.71000000000001,"text":"To bring us sugar and tea and rum","translation":"","kind":"lyric"},{"id":"47","start":117.71000000000001,"end":120.05,"text":"One day, when the tonguin' is done","translation":"","kind":"lyric"},{"id":"48","start":120.05,"end":122.78,"text":"We'll take our leave and go","translation":"","kind":"lyric"},{"id":"49","start":122.78,"end":125.33,"text":"As far as I've heard, the fight's still on","translation":"","kind":"lyric"},{"id":"50","start":125.33,"end":127.89,"text":"The line's not cut and the whale's not gone","translation":"","kind":"lyric"},{"id":"51","start":127.89,"end":130.25,"text":"The Wellerman makes his regular call","translation":"","kind":"lyric"},{"id":"52","start":130.25,"end":132.86,"text":"To encourage the captain, crew, and all (huh)","translation":"","kind":"lyric"},{"id":"53","start":132.86,"end":135.11,"text":"Soon may the Wellerman come","translation":"","kind":"lyric"},{"id":"54","start":135.11,"end":137.69,"text":"To bring us sugar and tea and rum","translation":"","kind":"lyric"},{"id":"55","start":137.69,"end":140.07,"text":"One day, when the tonguin' is done","translation":"","kind":"lyric"},{"id":"56","start":140.07,"end":142.89,"text":"We'll take our leave and go","translation":"","kind":"lyric"},{"id":"57","start":142.89,"end":145.42000000000002,"text":"Soon may the Wellerman come","translation":"","kind":"lyric"},{"id":"58","start":145.42000000000002,"end":148.0,"text":"To bring us sugar and tea and rum","translation":"","kind":"lyric"},{"id":"59","start":148.0,"end":150.12,"text":"One day, when the tonguin' is done","translation":"","kind":"lyric"},{"id":"60","start":150.12,"end":153.12,"text":"We'll take our leave and go","translation":"","kind":"lyric"}],"candidates":[]}