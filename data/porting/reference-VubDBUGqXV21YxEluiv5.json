{"title":"망가진 인형의 행진","artist":"소녀이론관측소","sourceId":"reference:VubDBUGqXV21YxEluiv5","sourceHash":"b7ace7ac0e006d54df2603fbe7da3b691c6e7a1483f49fb8db59e2ae41270315","performanceStatus":"no_performance_record","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","cues":[{"id":"1","start":22.18,"end":25.18,"text":"暗い部屋の中 彼女は独り","translation":"","kind":"lyric"},{"id":"2","start":29.28,"end":32.28,"text":"玩具に囲まれ 人形遊び","translation":"","kind":"lyric"},{"id":"3","start":36.56,"end":39.56,"text":"服を着せ替えて 散らして投げて","translation":"","kind":"lyric"},{"id":"4","start":43.94,"end":46.94,"text":"バラバラにして 中も見てみましょう","translation":"","kind":"lyric"},{"id":"5","start":50.89,"end":53.89,"text":"微笑みの中に悪魔は宿る","translation":"","kind":"lyric"},{"id":"6","start":54.64,"end":57.64,"text":"鼻歌の調べに耳を澄ませ","translation":"","kind":"lyric"},{"id":"7","start":58.11,"end":60.39,"text":"ラララン ラン ラン ラン ラン ラン ラン","translation":"","kind":"lyric"},{"id":"8","start":60.39,"end":61.75,"text":"声がして","translation":"","kind":"lyric"},{"id":"9","start":61.75,"end":64.75,"text":"その後は悲鳴だけ響く","translation":"","kind":"lyric"},{"id":"10","start":65.82,"end":68.82,"text":"おままごとしましょう？","translation":"","kind":"lyric"},{"id":"11","start":69.02,"end":72.02,"text":"遊びのお相手は可愛らしいお人形","translation":"","kind":"lyric"},{"id":"12","start":72.84,"end":75.84,"text":"腕が千切れちゃった","translation":"","kind":"lyric"},{"id":"13","start":76.49,"end":79.49,"text":"部屋が汚れちゃう 赤い綿散らして","translation":"","kind":"lyric"},{"id":"14","start":80.24,"end":83.24,"text":"糸で縫い直せばまだ遊べるかな？","translation":"","kind":"lyric"},{"id":"15","start":85.58,"end":87.64,"text":"継接ぎのお人形","translation":"","kind":"lyric"},{"id":"16","start":87.64,"end":90.64,"text":"次は何しましょう","translation":"","kind":"lyric"},{"id":"17","start":90.74,"end":93.74,"text":"可愛い声で鳴く私の玩具","translation":"","kind":"lyric"},{"id":"18","start":96.78999999999999,"end":99.78999999999999,"text":"とあるお屋敷のそのまた奥に","translation":"","kind":"lyric"},{"id":"19","start":103.89,"end":106.89,"text":"誰も知らない秘密の花園","translation":"","kind":"lyric"},{"id":"20","start":111.15,"end":114.15,"text":"並ぶ人形は皆傷だらけ","translation":"","kind":"lyric"},{"id":"21","start":118.44,"end":121.44,"text":"それを眺める恍惚の少女","translation":"","kind":"lyric"},{"id":"22","start":125.81,"end":128.81,"text":"迷い混込めば二度とは戻れない","translation":"","kind":"lyric"},{"id":"23","start":129.33,"end":132.33,"text":"荊に囲まれた乙女の城","translation":"","kind":"lyric"},{"id":"24","start":132.86,"end":134.86,"text":"ララランランランランランラン","translation":"","kind":"lyric"},{"id":"25","start":134.86,"end":136.55,"text":"振り向けば","translation":"","kind":"lyric"},{"id":"26","start":136.55,"end":139.55,"text":"無邪気さと狂気の笑みが浮かぶ","translation":"","kind":"lyric"},{"id":"27","start":140.3,"end":143.3,"text":"ご挨拶しましょう","translation":"","kind":"lyric"},{"id":"28","start":143.56,"end":145.6,"text":"まずは握手かしら？","translation":"","kind":"lyric"},{"id":"29","start":145.6,"end":147.69,"text":"新しいお人形","translation":"","kind":"lyric"},{"id":"30","start":147.69,"end":150.69,"text":"傷だらけになれば","translation":"","kind":"lyric"},{"id":"31","start":151.36,"end":152.88,"text":"直してあげるわ","translation":"","kind":"lyric"},{"id":"32","start":152.88,"end":155.18,"text":"肌色のフェルトで","translation":"","kind":"lyric"},{"id":"33","start":155.18,"end":158.18,"text":"どうして何もかも","translation":"","kind":"lyric"},{"id":"34","start":158.62,"end":161.62,"text":"私が触れたら勝手に壊れちゃう！","translation":"","kind":"lyric"},{"id":"35","start":162.22,"end":165.22,"text":"もっと頑丈な玩具が欲しいのよ","translation":"","kind":"lyric"},{"id":"36","start":167.57,"end":170.57,"text":"探してきてね","translation":"","kind":"lyric"},{"id":"37","start":200.36,"end":203.36,"text":"おままごとしましょう？","translation":"","kind":"lyric"},{"id":"38","start":203.64,"end":206.64,"text":"遊びのお相手は可愛らしいお人形","translation":"","kind":"lyric"},{"id":"39","start":207.66,"end":210.66,"text":"頭が取れちゃった","translation":"","kind":"lyric"},{"id":"40","start":211.11,"end":214.11,"text":"お掃除しなくちゃ 真っ赤に染まる部屋","translation":"","kind":"lyric"},{"id":"41","start":215.06,"end":218.06,"text":"私 悪くないわ","translation":"","kind":"lyric"},{"id":"42","start":218.48,"end":221.48,"text":"すぐに壊れちゃう貴女がいけないの！","translation":"","kind":"lyric"},{"id":"43","start":222.16,"end":225.16,"text":"怯える瞳が","translation":"","kind":"lyric"},{"id":"44","start":225.35,"end":228.35,"text":"愛しく思えるの 声を聴かせて","translation":"","kind":"lyric"}],"candidates":[]}