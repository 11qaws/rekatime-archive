{"title":"창성의 아쿠에리온","artist":"칸노 요코","sourceId":"reference:BUKZqdLPtx8JHK1yx0oN","sourceHash":"addf43915eb2247e05a1721834a5f4d19b62e92939933f8620b5249661a1534d","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":14705669,"cues":[{"id":"1","start":7.75,"end":14.43,"text":"世界の始まりの日 生命の樹の下で","translation":"","kind":"lyric"},{"id":"2","start":14.43,"end":19.14,"text":"くじらたちの声の遠い残響","translation":"","kind":"lyric"},{"id":"3","start":19.14,"end":20.5,"text":"二人で聞いた","translation":"","kind":"lyric"},{"id":"4","start":20.5,"end":23.58,"text":"失くしたものすべて","translation":"","kind":"lyric"},{"id":"5","start":23.58,"end":27.24,"text":"愛したものすべて","translation":"","kind":"lyric"},{"id":"6","start":27.24,"end":30.09,"text":"この手に抱きしめて","translation":"","kind":"lyric"},{"id":"7","start":30.09,"end":33.73,"text":"現在は何処を彷徨い行くの","translation":"","kind":"lyric"},{"id":"8","start":33.73,"end":40.18,"text":"答えの潜む琥珀の太陽","translation":"","kind":"lyric"},{"id":"9","start":40.18,"end":46.31,"text":"出会わなければ 殺戮の天使でいられた","translation":"","kind":"lyric"},{"id":"10","start":46.31,"end":52.06,"text":"不死なる瞬き持つ魂","translation":"","kind":"lyric"},{"id":"11","start":52.06,"end":55.75,"text":"傷つかないで 僕の羽根","translation":"","kind":"lyric"},{"id":"12","start":55.75,"end":62.46,"text":"この気持ち知るため生まれてきた","translation":"","kind":"lyric"},{"id":"13","start":62.46,"end":68.72,"text":"一万年と二千年前から愛してる","translation":"","kind":"lyric"},{"id":"14","start":68.72,"end":75.05,"text":"八千年過ぎた頃からもっと恋しくなった","translation":"","kind":"lyric"},{"id":"15","start":75.05,"end":81.23,"text":"一億と二千年あとも愛してる","translation":"","kind":"lyric"},{"id":"16","start":81.23,"end":90.64,"text":"君を知ったその日から僕の地獄に音楽は絶えない","translation":"","kind":"lyric"},{"id":"17","start":94.02000000000001,"end":106.14,"text":"Wow oh wow oh","translation":"","kind":"lyric"},{"id":"18","start":106.14,"end":112.5,"text":"世界が終わる前に 生命が終わる前に","translation":"","kind":"lyric"},{"id":"19","start":112.5,"end":119.6,"text":"眠る嘆きほどいて 君の薫り抱きしめたいよ","translation":"","kind":"lyric"},{"id":"20","start":119.6,"end":125.81,"text":"耳すませた海神の記憶","translation":"","kind":"lyric"},{"id":"21","start":125.81,"end":132.02,"text":"失意にのまれ立ち尽くす麗しき月","translation":"","kind":"lyric"},{"id":"22","start":132.02,"end":137.93,"text":"よみがえれ 永遠に涸れぬ光","translation":"","kind":"lyric"},{"id":"23","start":137.93,"end":141.39,"text":"汚されないで 君の夢","translation":"","kind":"lyric"},{"id":"24","start":141.39,"end":148.07999999999998,"text":"祈り宿しながら生まれてきた","translation":"","kind":"lyric"},{"id":"25","start":148.07999999999998,"end":154.67000000000002,"text":"一万年と二千年前から愛してる","translation":"","kind":"lyric"},{"id":"26","start":154.67000000000002,"end":160.65,"text":"八千年過ぎた頃からもっと恋しくなった","translation":"","kind":"lyric"},{"id":"27","start":160.65,"end":167.0,"text":"一億と二千年あとも愛してる","translation":"","kind":"lyric"},{"id":"28","start":167.0,"end":175.43,"text":"君を知ったその日から僕の地獄に音楽は絶えない","translation":"","kind":"lyric"},{"id":"29","start":179.63,"end":183.14,"text":"君がくり返し大人になって","translation":"","kind":"lyric"},{"id":"30","start":183.14,"end":186.26,"text":"何度も何度も遠くへ行って","translation":"","kind":"lyric"},{"id":"31","start":186.26,"end":195.49,"text":"見守る僕が眠れない僕がくしゃくしゃになったとしても","translation":"","kind":"lyric"},{"id":"32","start":195.49,"end":202.18,"text":"Wowow oh wowow","translation":"","kind":"lyric"},{"id":"33","start":202.18,"end":208.5,"text":"君の名を歌うために","translation":"","kind":"lyric"},{"id":"34","start":208.5,"end":214.99,"text":"一万年と二千年前から愛してる","translation":"","kind":"lyric"},{"id":"35","start":214.99,"end":221.16,"text":"八千年過ぎた頃からもっと恋しくなった","translation":"","kind":"lyric"},{"id":"36","start":221.16,"end":227.44,"text":"一億と二千年あとも愛してる","translation":"","kind":"lyric"},{"id":"37","start":227.44,"end":234.19,"text":"君を知ったその日から","translation":"","kind":"lyric"},{"id":"38","start":234.19,"end":240.29,"text":"一万年と二千年前から愛してる","translation":"","kind":"lyric"},{"id":"39","start":240.29,"end":246.63,"text":"八千年過ぎた頃からもっと恋しくなった","translation":"","kind":"lyric"},{"id":"40","start":246.63,"end":252.8,"text":"一億と二千年たっても愛してる","translation":"","kind":"lyric"},{"id":"41","start":252.8,"end":268.26,"text":"君を知ったその日から僕の地獄に音楽は絶えない","translation":"","kind":"lyric"}],"candidates":[]}