{"title":"ECHO","artist":"Crusher","sourceId":"reference:Ll8SDmfkJLqlHaOr0WY4","sourceHash":"49704b61f6788c67433ca167a4d005276010c0c880d4675c9964f9a2dd87eb68","performanceStatus":"reference_timing","timingMethod":"reference_lrc_unverified","reviewStatus":"draft","cue_timing_confirmed":false,"timingWarning":"(주의) 노래와 함께 타이밍 검증되지 않았음","referenceProvider":"LRCLIB","referenceId":33593109,"cues":[{"id":"1","start":6.28,"end":10.11,"text":"The clock stopped ticking forever ago","translation":"","kind":"lyric"},{"id":"2","start":10.11,"end":12.27,"text":"How long have I been up?","translation":"","kind":"lyric"},{"id":"3","start":12.27,"end":13.4,"text":"I don't know","translation":"","kind":"lyric"},{"id":"4","start":13.4,"end":16.95,"text":"I can't get a grip, but I can't let go","translation":"","kind":"lyric"},{"id":"5","start":16.95,"end":20.44,"text":"There wasn't anything to hold on to though","translation":"","kind":"lyric"},{"id":"6","start":20.44,"end":24.15,"text":"Why can't I see, why can't I see","translation":"","kind":"lyric"},{"id":"7","start":24.15,"end":27.47,"text":"All the colors that you see?","translation":"","kind":"lyric"},{"id":"8","start":27.47,"end":31.07,"text":"Please can I be, please can I be","translation":"","kind":"lyric"},{"id":"9","start":31.07,"end":33.94,"text":"Colorful and free? Yeah","translation":"","kind":"lyric"},{"id":"10","start":33.94,"end":35.87,"text":"What the hell's going on?","translation":"","kind":"lyric"},{"id":"11","start":35.87,"end":37.67,"text":"Can someone tell me please","translation":"","kind":"lyric"},{"id":"12","start":37.67,"end":40.99,"text":"Why I'm switching faster than the channels on TV?","translation":"","kind":"lyric"},{"id":"13","start":40.99,"end":42.53,"text":"I'm black, then I'm white","translation":"","kind":"lyric"},{"id":"14","start":42.53,"end":44.23,"text":"No, something isn't right","translation":"","kind":"lyric"},{"id":"15","start":44.23,"end":47.78,"text":"My enemy's invisible, I don't know