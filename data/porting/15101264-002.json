{"originalLanguage":"ko","title":"야생화","artist":"박효신","date":"2026-09-08","sourceId":"15101264:002","sourceHash":"c0a6ff639d3bcee4b14c45f9245a056b1921408a9d909b22e3425acc06f082e7","duration":336.5,"cues":[{"id":"1","start":19.03,"end":24.951,"text":"하얗게 피어난 얼음 꽃 하나가","translation":"","kind":"lyric"},{"id":"2","start":32.46,"end":38.417,"text":"달가운 바람에 얼굴을 내밀어","translation":"","kind":"lyric"},{"id":"3","start":43.96,"end":49.841,"text":"아무 말 못했던 이름도 몰랐던","translation":"","kind":"lyric"},{"id":"4","start":55.14,"end":61.159,"text":"지나간 날들에 눈물이 흘러","translation":"","kind":"lyric"},{"id":"5","start":66.03,"end":72.173,"text":"차가운 바람에 숨어 있다","translation":"","kind":"lyric"},{"id":"6","start":72.51,"end":78.15,"text":"한줄기 햇살에 몸 녹이다","translation":"","kind":"lyric"},{"id":"7","start":78.19,"end":84.333,"text":"그렇게 너는 또 한번 내게 온다","translation":"","kind":"lyric"},{"id":"8","start":88.21,"end":94.209,"text":"좋았던 기억만","translation":"","kind":"lyric"},{"id":"9","start":94.81,"end":100.94,"text":"그리운 마음만","translation":"","kind":"lyric"},{"id":"10","start":100.98,"end":106.143,"text":"니가 떠나간 그 길 위에","translation":"","kind":"lyric"},{"id":"11","start":106.25,"end":111.86,"text":"이렇게 남아 서있다","translation":"","kind":"lyric"},{"id":"12","start":111.9,"end":117.32,"text":"잊혀질 만큼만","translation":"","kind":"lyric"},{"id":"13","start":117.36,"end":123.427,"text":"괜찮을 만큼만","translation":"","kind":"lyric"},{"id":"14","start":123.85,"end":129.765,"text":"눈물 머금고 기다린 떨림 끝에","translation":"","kind":"lyric"},{"id":"15","start":130.65,"end":136.799,"text":"다시 나를 피우리라","translation":"","kind":"lyric"},{"id":"16","start":140.52,"end":146.506,"text":"사랑은 피고 또 지는 타버리는 불꽃","translation":"","kind":"lyric"},{"id":"17","start":151.24,"end":157.383,"text":"빗물에 젖을까 두 눈을 감는다","translation":"","kind":"lyric"},{"id":"18","start":162.04,"end":167.979,"text":"어리고 작았던 나의 맘에","translation":"","kind":"lyric"},{"id":"19","start":168.07,"end":173.97,"text":"눈부시게 빛나던 추억 속에","translation":"","kind":"lyric"},{"id":"20","start":174.01,"end":180.093,"text":"그렇게 너를 또 한번 불러본다","translation":"","kind":"lyric"},{"id":"21","start":184.07,"end":189.927,"text":"좋았던 기억만","translation":"","kind":"lyric"},{"id":"22","start":190.27,"end":196.23,"text":"그리운 마음만","translation":"","kind":"lyric"},{"id":"23","start":196.27,"end":201.366,"text":"니가 떠나간 그 길 위에","translation":"","kind":"lyric"},{"id":"24","start":201.57,"end":207.03,"text":"이렇게 남아 서있다","translation":"","kind":"lyric"},{"id":"25","start":207.07,"end":212.527,"text":"잊혀질 만큼만","translation":"","kind":"lyric"},{"id":"26","start":212.61,"end":218.48,"text":"괜찮을 만큼만","translation":"","kind":"lyric"},{"id":"27","start":218.52,"end":224.588,"text":"눈물 머금고 기다린 떨림 끝에","translation":"","kind":"lyric"},{"id":"28","start":225.5,"end":231.421,"text":"다시 나는","translation":"","kind":"lyric"},{"id":"29","start":232.72,"end":237.28,"text":"메말라가는 땅 위에","translation":"","kind":"lyric"},{"id":"30","start":237.46,"end":243.34,"text":"온몸이 타 들어가고","translation":"","kind":"lyric"},{"id":"31","start":244.25,"end":247.588,"text":"내 손끝에 남은","translation":"","kind":"lyric"},{"id":"32","start":247.7,"end":253.648,"text":"너의 향기 흩어져 날아가","translation":"","kind":"lyric"},{"id":"33","start":266.07,"end":270.92,"text":"멀어져 가는 너의 손을","translation":"","kind":"lyric"},{"id":"34","start":270.96,"end":276.14,"text":"붙잡지 못해 아프다","translation":"","kind":"lyric"},{"id":"35","start":276.18,"end":281.64,"text":"살아갈 만큼만","translation":"","kind":"lyric"},{"id":"36","start":281.68,"end":287.61,"text":"미워했던 만큼만","translation":"","kind":"lyric"},{"id":"37","start":287.65,"end":292.578,"text":"먼 훗날 너를 데려다 줄","translation":"","kind":"lyric"},{"id":"38","start":292.68,"end":298.638,"text":"그 봄이 오면 그날에 나 피우리라","translation":"","kind":"lyric"}],"candidates":[],"reviewStatus":"draft"}